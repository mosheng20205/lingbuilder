          "isEnabled": true,
          "visibility": "Visible",
          "properties": {},
          "events": {},
          "fontFamily": "Microsoft YaHei UI",
          "fontBold": false,
          "fontItalic": false,
          "fontUnderline": false
        }
      ],
      "titleBarBackground": "#2D2D30",
