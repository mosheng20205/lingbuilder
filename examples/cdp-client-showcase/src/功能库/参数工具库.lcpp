// 参数工具库：控件输入的健壮解析（去空白、空串默认值、整数/小数/逻辑解析）与
// JSON 常用字段提取、任务输出路径组装、输出目录准备。
// 红线自觉：库内只做纯逻辑，不调用任何需要事件处理器的命令；字符串与注释不出现 & 标识符形态。
功能库 参数工具库
公开:
  文本型 去空白(文本型 内容)
      返回(文本_删首尾空白(内容))
  结束

  文本型 取文本输入(文本型 内容, 文本型 默认值)
      局部 文本型 已修剪 = 参数工具库.去空白(内容)
      如果 (已修剪 == "")
          返回(默认值)
      如果结束
      返回(已修剪)
  结束

  整数型 取整数输入(文本型 内容, 整数型 默认值)
      局部 文本型 已修剪 = 参数工具库.去空白(内容)
      如果 (已修剪 == "")
          返回(默认值)
      如果结束
      返回(到整数(已修剪))
  结束

  小数型 取小数输入(文本型 内容, 小数型 默认值)
      局部 文本型 已修剪 = 参数工具库.去空白(内容)
      如果 (已修剪 == "")
          返回(默认值)
      如果结束
      返回(到小数(已修剪))
  结束

  逻辑型 取逻辑输入(文本型 内容, 逻辑型 默认值)
      局部 文本型 已修剪 = 文本_转小写(参数工具库.去空白(内容))
      如果 (已修剪 == "")
          返回(默认值)
      如果结束
      如果 (已修剪 == "真")
          返回(真)
      如果结束
      如果 (已修剪 == "1")
          返回(真)
      如果结束
      如果 (已修剪 == "是")
          返回(真)
      如果结束
      如果 (已修剪 == "假")
          返回(假)
      如果结束
      如果 (已修剪 == "0")
          返回(假)
      如果结束
      如果 (已修剪 == "否")
          返回(假)
      如果结束
      返回(默认值)
  结束

  文本型 截断文本(文本型 内容, 整数型 最大长度)
      如果 (文本_取长度(内容) <= 最大长度)
          返回(内容)
      如果结束
      返回(文本_取左边(内容, 最大长度) + "…")
  结束

  // 从返回 JSON 里提取顶层字符串/数字字段做人类可读摘要；仅做简单提取，不处理嵌套转义的复杂场景。
  文本型 JSON取字段(文本型 JSON文本, 文本型 字段名)
      局部 文本型 字段值 = ""
      @ {
      @     std::wstring 源文本(JSON文本);
      @     std::wstring 键文本 = L"\"" + std::wstring(字段名) + L"\":";
      @     size_t 键位 = 源文本.find(键文本);
      @     if (键位 == std::wstring::npos) {
      @         键文本 = L"\"" + std::wstring(字段名) + L"\" :";
      @         键位 = 源文本.find(键文本);
      @     }
      @     if (键位 != std::wstring::npos) {
      @         size_t 值位 = 键位 + 键文本.size();
      @         while (值位 < 源文本.size() && (源文本[值位] == L' ' || 源文本[值位] == L'\t')) 值位++;
      @         if (值位 < 源文本.size()) {
      @             if (源文本[值位] == L'"') {
      @                 size_t 结束位 = 值位 + 1;
      @                 while (结束位 < 源文本.size()) {
      @                     if (源文本[结束位] == L'\\') { 结束位 += 2; continue; }
      @                     if (源文本[结束位] == L'"') break;
      @                     结束位++;
      @                 }
      @                 if (结束位 <= 源文本.size()) 字段值 = 源文本.substr(值位 + 1, 结束位 - 值位 - 1);
      @             } else {
      @                 size_t 结束位 = 值位;
      @                 while (结束位 < 源文本.size() && 源文本[结束位] != L',' && 源文本[结束位] != L'}' && 源文本[结束位] != L']') 结束位++;
      @                 字段值 = 源文本.substr(值位, 结束位 - 值位);
      @             }
      @         }
      @     }
      @ }
      返回(参数工具库.去空白(字段值))
  结束

  // 任务/截图等输出文件路径：目录前缀为空用 output，结尾补正斜杠后拼固定文件名。
  文本型 任务路径(文本型 目录前缀, 文本型 文件名)
      局部 文本型 前缀文本 = 参数工具库.取文本输入(目录前缀, "output")
      如果 (文本_结尾为(前缀文本, "/") == 假)
          前缀文本 = 前缀文本 + "/"
      如果结束
      返回(前缀文本 + 文件名)
  结束

  // 创建 exe 工作目录下的 output 与 output/frames，并写入一个上传样例文件（供设置元素文件演示用）。
  逻辑型 确保输出目录()
      @ std::wstring 目录路径 = L"output";
      @ DWORD 目录属性 = GetFileAttributesW(目录路径.c_str());
      @ if (目录属性 != INVALID_FILE_ATTRIBUTES && (目录属性 & FILE_ATTRIBUTE_DIRECTORY)) return true;
      @ if (!CreateDirectoryW(目录路径.c_str(), nullptr)) return false;
      @ CreateDirectoryW(L"output\\frames", nullptr);
      @ FILE* 上传样例 = nullptr;
      @ if (_wfopen_s(&上传样例, L"output\\上传样例.txt", L"w, ccs=UTF-8") == 0 && 上传样例) { fwprintf(上传样例, L"LingBuilder CDP 上传样例"); fclose(上传样例); }
      @ return true;
  结束
结束功能库
