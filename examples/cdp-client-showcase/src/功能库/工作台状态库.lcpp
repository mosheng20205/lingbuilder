// 工作台状态库：当前连接/当前页面/当前元素等取值写值、两个列表框与句柄平行数组的同步维护。
// 只做同步操作；记录/移除后自动刷新列表并回写工作台状态行。
功能库 工作台状态库
公开:
  逻辑型 连接可用()
      如果 (当前连接 == 0)
          返回(假)
      如果结束
      返回(CDP_是否已连接(当前连接))
  结束

  逻辑型 页面可用()
      如果 (当前页面 == 0)
          返回(假)
      如果结束
      返回(真)
  结束

  逻辑型 元素可用()
      如果 (当前元素 == 0)
          返回(假)
      如果结束
      返回(真)
  结束

  // 带提示的前置检查：窗口事件处理器在异步命令调用前用它做守卫（3 行范式）。
  逻辑型 要求连接()
      如果 (当前连接 == 0)
          结果格式化库.写日志("[提示] 请先在 01 页签启动或连接浏览器。")
          返回(假)
      如果结束
      返回(真)
  结束

  逻辑型 要求页面()
      如果 (当前页面 == 0)
          结果格式化库.写日志("[提示] 请先在 01 页签新建或附加页面。")
          返回(假)
      如果结束
      返回(真)
  结束

  逻辑型 要求元素()
      如果 (当前元素 == 0)
          结果格式化库.写日志("[提示] 请先在 01/03 页签查询元素设置「当前元素」。")
          返回(假)
      如果结束
      返回(真)
  结束

  逻辑型 要求会话()
      如果 (最新会话 == 0)
          结果格式化库.写日志("[提示] 还没有会话句柄：先在 08 页签「附加目标」。")
          返回(假)
      如果结束
      返回(真)
  结束

  逻辑型 要求调用帧()
      如果 (最新调用帧 == 0)
          结果格式化库.写日志("[提示] 还没有调用帧：先在 09 页签「暂停调试」。")
          返回(假)
      如果结束
      返回(真)
  结束

  逻辑型 要求断点()
      如果 (最新断点 == 0)
          结果格式化库.写日志("[提示] 还没有断点句柄：先在 09 页签「设置断点」。")
          返回(假)
      如果结束
      返回(真)
  结束

  逻辑型 要求任务()
      如果 (最新任务 == 0)
          结果格式化库.写日志("[提示] 还没有任务：先在 11 页签启动长任务。")
          返回(假)
      如果结束
      返回(真)
  结束

  逻辑型 要求回放()
      如果 (最新回放 == 0)
          结果格式化库.写日志("[提示] 还没有回放：先在 13 页签「加载回放」。")
          返回(假)
      如果结束
      返回(真)
  结束

  // 新连接就绪：追加进列表并设为当前连接（列表行序与连接表严格一致）。
  空 记录连接(CDP连接 句柄)
      数组_加入成员(连接表, 句柄)
      控件_添加项目(连接列表, 结果格式化库.连接摘要(句柄))
      控件_设置选择项(连接列表, 数组_取成员数(连接表) - 1)
      当前连接 = 句柄
      工作台状态库.更新工作台状态()
  结束

  // 新页面就绪：追加进列表并设为当前页面。
  空 记录页面(CDP页面 句柄)
      数组_加入成员(页面表, 句柄)
      控件_添加项目(页面列表, 结果格式化库.页面摘要(句柄))
      控件_设置选择项(页面列表, 数组_取成员数(页面表) - 1)
      当前页面 = 句柄
      工作台状态库.更新工作台状态()
  结束

  空 移除连接(CDP连接 句柄)
      局部 整数型 序号 = 数组_查找(连接表, 句柄)
      如果 (序号 >= 0)
          数组_删除成员(连接表, 序号)
      如果结束
      如果 (数组_取成员数(连接表) > 0)
          当前连接 = 数组_取成员(连接表, 0)
      如果结束
      工作台状态库.重建连接列表()
      如果 (数组_取成员数(连接表) > 0)
          控件_设置选择项(连接列表, 0)
      如果结束
  结束

  空 移除页面(CDP页面 句柄)
      局部 整数型 序号 = 数组_查找(页面表, 句柄)
      如果 (序号 >= 0)
          数组_删除成员(页面表, 序号)
      如果结束
      如果 (数组_取成员数(页面表) > 0)
          当前页面 = 数组_取成员(页面表, 0)
      如果结束
      工作台状态库.重建页面列表()
      如果 (数组_取成员数(页面表) > 0)
          控件_设置选择项(页面列表, 0)
      如果结束
  结束

  空 重建连接列表()
      控件_清空项目(连接列表)
      局部 整数型 总数 = 数组_取成员数(连接表)
      局部 整数型 序号 = 0
      计次循环首 (总数, 序号)
          控件_添加项目(连接列表, 结果格式化库.连接摘要(数组_取成员(连接表, 序号 - 1)))
      计次循环尾
      工作台状态库.更新工作台状态()
  结束

  空 重建页面列表()
      控件_清空项目(页面列表)
      局部 整数型 总数 = 数组_取成员数(页面表)
      局部 整数型 序号 = 0
      计次循环首 (总数, 序号)
          控件_添加项目(页面列表, 结果格式化库.页面摘要(数组_取成员(页面表, 序号 - 1)))
      计次循环尾
      工作台状态库.更新工作台状态()
  结束

  空 清空工作台()
      数组_清空(连接表)
      数组_清空(页面表)
      工作台状态库.重建连接列表()
      工作台状态库.重建页面列表()
  结束

  // 列表点选生效：按选中索引从平行数组取句柄设为当前。
  空 应用连接选择()
      局部 整数型 序号 = 控件_取选择项(连接列表)
      如果 (序号 >= 0)
          如果 (序号 < 数组_取成员数(连接表))
              当前连接 = 数组_取成员(连接表, 序号)
              结果格式化库.写日志("[工作台] 当前连接 = " + 结果格式化库.连接摘要(当前连接))
          如果结束
      如果结束
      工作台状态库.更新工作台状态()
  结束

  空 应用页面选择()
      局部 整数型 序号 = 控件_取选择项(页面列表)
      如果 (序号 >= 0)
          如果 (序号 < 数组_取成员数(页面表))
              当前页面 = 数组_取成员(页面表, 序号)
              结果格式化库.写日志("[工作台] 当前页面 = " + 结果格式化库.页面摘要(当前页面))
          如果结束
      如果结束
      工作台状态库.更新工作台状态()
  结束

  空 设置当前元素(CDP元素 句柄, 文本型 选择器)
      当前元素 = 句柄
      当前元素选择器 = 选择器
      工作台状态库.更新工作台状态()
  结束

  空 更新工作台状态()
      局部 文本型 元素文本 = "（未设置）"
      局部 文本型 连接文本 = "（无）"
      局部 文本型 页面文本 = "（无）"
      如果 (当前元素 != 0)
          元素文本 = 当前元素选择器
      如果结束
      如果 (当前连接 != 0)
          连接文本 = 结果格式化库.连接摘要(当前连接)
      如果结束
      如果 (当前页面 != 0)
          页面文本 = 结果格式化库.页面摘要(当前页面)
      如果结束
      控件_设置文本(当前元素标签, "当前元素：" + 元素文本 + "　当前连接：" + 连接文本 + "　当前页面：" + 页面文本)
  结束
结束功能库
