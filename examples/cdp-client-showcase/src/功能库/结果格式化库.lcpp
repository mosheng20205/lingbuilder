// 结果格式化库：日志写入、每页签「最近结果」写入、事件快照转可读文本、
// 事件回调体的统一落点（读快照、写日志/结果框、维护状态全局）。
// 只消费同步命令与事件快照（一次一取），不出现也不传递事件处理器。
功能库 结果格式化库
公开:
  空 写日志(文本型 内容)
      控件_设置文本(运行日志, 控件_取文本(运行日志) + 内容 + "\n")
  结束

  空 写结果(整数型 页码, 文本型 内容)
      如果 (页码 == 1)
          控件_设置文本(结果01, 内容)
      如果结束
      如果 (页码 == 2)
          控件_设置文本(结果02, 内容)
      如果结束
      如果 (页码 == 3)
          控件_设置文本(结果03, 内容)
      如果结束
      如果 (页码 == 4)
          控件_设置文本(结果04, 内容)
      如果结束
      如果 (页码 == 5)
          控件_设置文本(结果05, 内容)
      如果结束
      如果 (页码 == 6)
          控件_设置文本(结果06, 内容)
      如果结束
      如果 (页码 == 7)
          控件_设置文本(结果07, 内容)
      如果结束
      如果 (页码 == 8)
          控件_设置文本(结果08, 内容)
      如果结束
      如果 (页码 == 9)
          控件_设置文本(结果09, 内容)
      如果结束
      如果 (页码 == 10)
          控件_设置文本(结果10, 内容)
      如果结束
      如果 (页码 == 11)
          控件_设置文本(结果11, 内容)
      如果结束
      如果 (页码 == 12)
          控件_设置文本(结果12, 内容)
      如果结束
      如果 (页码 == 13)
          控件_设置文本(结果13, 内容)
      如果结束
      如果 (页码 == 14)
          控件_设置文本(结果14, 内容)
      如果结束
  结束

  // 异步命令完成/失败事件的统一落点：把事件快照整理成「类型：文本（错误）」写进对应页签的结果框。
  空 完成结果(整数型 页码)
      局部 文本型 事件类型 = CDP_取当前事件类型()
      局部 文本型 事件文本 = CDP_取当前事件文本()
      局部 文本型 错误文本 = CDP_取当前错误()
      局部 文本型 显示文本 = ""
      如果 (事件类型 == "命令失败")
          显示文本 = "失败：" + 错误文本
      否则
          如果 (错误文本 != "")
              显示文本 = 事件类型 + "：" + 事件文本 + "（" + 错误文本 + "）"
          否则
              显示文本 = 事件类型 + "：" + 事件文本
          如果结束
      如果结束
      结果格式化库.写结果(页码, 显示文本)
      结果格式化库.写日志("[完成] " + 参数工具库.截断文本(显示文本, 160))
  结束

  文本型 连接摘要(CDP连接 句柄)
      局部 文本型 状态文本 = CDP_取连接状态(句柄)
      局部 文本型 版本文本 = CDP_取浏览器版本(句柄)
      返回("#" + 到文本(句柄) + " " + 状态文本 + " " + 参数工具库.JSON取字段(版本文本, "Browser"))
  结束

  文本型 页面摘要(CDP页面 句柄)
      局部 文本型 网址文本 = CDP_取页面网址(句柄)
      返回("#" + 到文本(句柄) + " " + 参数工具库.截断文本(网址文本, 78))
  结束

  文本型 任务状态行(CDP任务 句柄)
      局部 文本型 状态文本 = CDP_取任务状态(句柄)
      局部 整数型 进度值 = CDP_取任务进度(句柄)
      局部 文本型 路径文本 = CDP_取任务结果路径(句柄)
      返回("状态=" + 状态文本 + " 进度=" + 到文本(进度值) + "% 输出=" + 路径文本)
  结束

  // ===== 事件回调体（窗口事件处理器一行委托到这里） =====
  空 连接事件行()
      局部 文本型 类型文本 = CDP_取当前事件类型()
      局部 文本型 内容文本 = CDP_取当前事件文本()
      结果格式化库.写日志("[连接事件] " + 类型文本 + " " + 内容文本)
  结束

  空 网络事件行()
      局部 文本型 类型文本 = CDP_取当前事件类型()
      局部 文本型 方法文本 = CDP_取当前网络方法()
      局部 文本型 网址文本 = CDP_取当前网络网址()
      局部 整数型 状态值 = CDP_取当前网络状态()
      结果格式化库.写日志("[网络] " + 类型文本 + " " + 方法文本 + " " + 网址文本 + " 状态=" + 到文本(状态值))
      如果 (类型文本 == "网络响应")
          最新请求编号 = CDP_取当前网络编号()
      如果结束
  结束

  空 下载事件行()
      局部 文本型 类型文本 = CDP_取当前事件类型()
      局部 文本型 文件名文本 = CDP_取当前下载文件名()
      如果 (类型文本 == "下载进度")
          局部 整数型 进度值 = 0
          进度值 = CDP_取当前下载进度()
          结果格式化库.写日志("[下载] " + 文件名文本 + " 进度=" + 到文本(进度值) + "%")
      否则
          结果格式化库.写日志("[下载] " + 类型文本 + " " + 文件名文本)
      如果结束
  结束

  空 对话框事件行()
      局部 文本型 类型文本 = CDP_取当前对话框类型()
      局部 文本型 消息文本 = CDP_取当前对话框消息()
      结果格式化库.写日志("[对话框] 类型=" + 类型文本 + " 消息=" + 消息文本)
      结果格式化库.写结果(7, "对话框 " + 类型文本 + "：" + 消息文本)
      如果 (控件_取勾选(自动应答开关))
          局部 逻辑型 接受值 = 假
          接受值 = 控件_取勾选(对话框接受开关)
          局部 文本型 提示文本 = 控件_取文本(提示文本输入)
          CDP_应答对话框(当前页面, 接受值, 提示文本)
          结果格式化库.写日志("[对话框] 已自动应答（接受=" + 到文本(接受值) + "）。")
      如果结束
  结束

  空 控制台事件行()
      局部 文本型 级别文本 = CDP_取当前事件详情()
      局部 文本型 内容文本 = CDP_取当前事件文本()
      结果格式化库.写日志("[控制台] [" + 级别文本 + "] " + 内容文本)
  结束

  空 页面异常行()
      局部 文本型 内容文本 = CDP_取当前事件文本()
      结果格式化库.写日志("[页面异常] " + 内容文本)
  结束

  空 页面事件行()
      局部 文本型 类型文本 = CDP_取当前事件类型()
      局部 文本型 内容文本 = CDP_取当前事件文本()
      结果格式化库.写日志("[页面事件] " + 类型文本 + " " + 内容文本)
  结束

  空 拦截事件行()
      局部 文本型 方法文本 = CDP_取当前网络方法()
      局部 文本型 网址文本 = CDP_取当前网络网址()
      局部 CDP拦截 事件拦截
      事件拦截 = CDP_取当前拦截()
      最新拦截 = 事件拦截
      控件_设置文本(拦截句柄标签, "最新拦截：" + 到文本(最新拦截) + " " + 方法文本 + " " + 参数工具库.截断文本(网址文本, 60))
      结果格式化库.写日志("[拦截] " + 方法文本 + " " + 网址文本)
      结果格式化库.写结果(6, "被拦截：" + 方法文本 + " " + 网址文本)
  结束

  空 录制事件行()
      局部 文本型 类型文本 = CDP_取当前事件类型()
      结果格式化库.写日志("[录制事件] " + 类型文本)
  结束

  空 任务事件行()
      局部 文本型 类型文本 = CDP_取当前事件类型()
      局部 CDP任务 事件任务
      事件任务 = CDP_取当前任务()
      如果 (类型文本 == "任务已开始")
          结果格式化库.写日志("[任务] 任务=" + 到文本(事件任务) + " 已开始。")
          返回()
      如果结束
      如果 (类型文本 == "任务失败")
          局部 文本型 失败原因 = CDP_取当前错误()
          结果格式化库.写日志("[任务] 任务=" + 到文本(事件任务) + " 失败：" + 失败原因)
          结果格式化库.写结果(11, "任务失败：" + 失败原因)
          返回()
      如果结束
      局部 文本型 内容文本 = CDP_取当前事件文本()
      最新任务 = 事件任务
      结果格式化库.写日志("[任务] 任务=" + 到文本(事件任务) + " 完成，输出=" + 内容文本)
      结果格式化库.写结果(11, "任务完成，输出文件=" + 内容文本)
  结束

  空 串流帧行()
      已收帧数 = 已收帧数 + 1
      局部 文本型 帧路径文本 = CDP_取当前事件文本()
      控件_设置文本(串流计数标签, "已收帧数：" + 到文本(已收帧数))
      结果格式化库.写日志("[串流帧] " + 帧路径文本)
      结果格式化库.写结果(12, "最新帧：" + 帧路径文本)
      局部 整数型 自动停值 = 参数工具库.取整数输入(控件_取文本(自动停帧输入), 0)
      如果 (自动停值 > 0)
          如果 (已收帧数 >= 自动停值)
              CDP_停止串流(当前页面)
              结果格式化库.写日志("[串流] 已达自动停帧数，串流已停止。")
          如果结束
      如果结束
  结束
结束功能库
