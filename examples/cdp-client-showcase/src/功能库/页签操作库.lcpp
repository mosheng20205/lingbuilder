// 页签操作库：01-07 页签同步命令的操作落点（守卫、读参数、调用命令、写日志与结果框）。
// 只调用同步命令；带事件处理器的命令由窗口主文件调用。输入框值一律由窗口侧读好传参，库内不重复解析 UI。
功能库 页签操作库
公开:
  // ===== 01 工作台 =====
  空 工具启动()
      局部 逻辑型 目录已建 = 假
      目录已建 = 参数工具库.确保输出目录()
      如果 (目录已建)
          结果格式化库.写日志("[启动] 输出目录已就绪（output\\，截图/串流帧/任务/录制文件都写在这里）。")
      否则
          结果格式化库.写日志("[启动] 输出目录创建失败，产物可能无法落盘。")
      如果结束
      结果格式化库.写日志("CDP 浏览器自动化工具就绪（lingbuilder.cdp.client 3.1，161 条命令 / 14 个页签）。")
      结果格式化库.写日志("窗口打开时自动启动无头浏览器；也可在「01 工作台」填调试端口连接已有 Edge/Chrome。")
      结果格式化库.写日志("连接/页面列表点选即设为当前；每页底部「最近结果」保存最近一次命令输出，可直接复制。")
  结束

  逻辑型 断开当前连接()
      如果 (当前连接 == 0)
          结果格式化库.写日志("[提示] 没有当前连接。")
          返回(假)
      如果结束
      如果 (CDP_断开连接(当前连接))
          结果格式化库.写日志("[连接] 已断开当前连接。")
          工作台状态库.移除连接(当前连接)
          返回(真)
      如果结束
      结果格式化库.写日志("[连接] 断开失败：" + CDP_取最后错误())
      返回(假)
  结束

  逻辑型 停止当前浏览器()
      如果 (当前连接 == 0)
          结果格式化库.写日志("[提示] 没有当前连接。")
          返回(假)
      如果结束
      如果 (CDP_停止浏览器(当前连接))
          结果格式化库.写日志("[停止] 无头浏览器已回收（外部连接请改用断开）。")
          工作台状态库.移除连接(当前连接)
          返回(真)
      如果结束
      结果格式化库.写日志("[停止] 停止失败：" + CDP_取最后错误())
      返回(假)
  结束

  空 停止全部浏览器()
      局部 整数型 回收数量 = CDP_停止全部浏览器()
      结果格式化库.写日志("[停止] 已回收 " + 到文本(回收数量) + " 个无头浏览器。")
      工作台状态库.清空工作台()
  结束

  空 连接状态查询()
      局部 整数型 连接数量 = CDP_取连接数量()
      结果格式化库.写日志("[状态] 并存连接数量=" + 到文本(连接数量))
      如果 (当前连接 == 0)
          结果格式化库.写结果(1, "尚无当前连接；并存连接数量=" + 到文本(连接数量))
          返回()
      如果结束
      局部 逻辑型 在线 = 假
      在线 = CDP_是否已连接(当前连接)
      局部 文本型 状态文本 = CDP_取连接状态(当前连接)
      局部 整数型 页面数量 = CDP_取页面数量(当前连接)
      结果格式化库.写日志("[状态] 当前连接 已连接=" + 到文本(在线) + " 状态=" + 状态文本 + " 页面会话数=" + 到文本(页面数量))
      结果格式化库.写日志("[状态] 多连接说明：每个句柄独立 WebSocket 与会话，可同时管理多个浏览器，分别操作、单独回收。")
      结果格式化库.写结果(1, "连接数量=" + 到文本(连接数量) + " 当前连接状态=" + 状态文本 + " 页面会话数=" + 到文本(页面数量))
  结束

  空 设置命令超时()
      如果 (当前连接 == 0)
          结果格式化库.写日志("[提示] 没有当前连接。")
          返回()
      如果结束
      局部 整数型 超时毫秒值 = 参数工具库.取整数输入(控件_取文本(超时毫秒输入), 45000)
      如果 (CDP_设置命令超时(当前连接, 超时毫秒值))
          结果格式化库.写日志("[超时] 命令超时已设为 " + 到文本(超时毫秒值) + "ms（导航/就绪等待自动用两倍）。")
          结果格式化库.写结果(1, "命令超时=" + 到文本(超时毫秒值) + "ms")
      否则
          结果格式化库.写日志("[超时] 设置失败：" + CDP_取最后错误())
      如果结束
  结束

  逻辑型 查询元素(文本型 选择器文本)
      如果 (工作台状态库.页面可用() == 假)
          结果格式化库.写日志("[提示] 请先新建或附加页面。")
          返回(假)
      如果结束
      局部 文本型 有效选择器 = 参数工具库.取文本输入(选择器文本, "")
      如果 (有效选择器 == "")
          结果格式化库.写日志("[提示] 请填写元素选择器。")
          返回(假)
      如果结束
      局部 CDP元素 查到的元素
      查到的元素 = CDP_查询元素(当前页面, 有效选择器)
      如果 (查到的元素 == 0)
          结果格式化库.写日志("[元素] 查询失败：" + CDP_取最后错误())
          返回(假)
      如果结束
      工作台状态库.设置当前元素(查到的元素, 有效选择器)
      结果格式化库.写日志("[元素] 当前元素已设为 " + 有效选择器)
      返回(真)
  结束

  // ===== 02 页面与导航 =====
  空 停止页面加载()
      如果 (工作台状态库.页面可用() == 假)
          返回()
      如果结束
      如果 (CDP_停止加载(当前页面))
          结果格式化库.写日志("[导航] 已请求停止加载。")
          结果格式化库.写结果(2, "已请求停止加载")
      否则
          结果格式化库.写日志("[导航] 停止加载失败：" + CDP_取最后错误())
      如果结束
  结束

  空 读取页面网址()
      如果 (工作台状态库.页面可用() == 假)
          返回()
      如果结束
      局部 文本型 网址文本 = CDP_取页面网址(当前页面)
      结果格式化库.写结果(2, 网址文本)
      结果格式化库.写日志("[页面] 当前网址=" + 网址文本)
  结束

  空 调整窗口边界()
      如果 (工作台状态库.页面可用() == 假)
          返回()
      如果结束
      局部 整数型 左值 = 参数工具库.取整数输入(控件_取文本(边界左), 100)
      局部 整数型 上值 = 参数工具库.取整数输入(控件_取文本(边界上), 60)
      局部 整数型 宽值 = 参数工具库.取整数输入(控件_取文本(边界宽), 1280)
      局部 整数型 高值 = 参数工具库.取整数输入(控件_取文本(边界高), 720)
      如果 (CDP_设置窗口边界(当前页面, 左值, 上值, 宽值, 高值))
          结果格式化库.写日志("[窗口] 已请求调整窗口为 左" + 到文本(左值) + " 上" + 到文本(上值) + " 宽" + 到文本(宽值) + " 高" + 到文本(高值))
          结果格式化库.写结果(2, "已设置窗口边界：左" + 到文本(左值) + " 上" + 到文本(上值) + " 宽" + 到文本(宽值) + " 高" + 到文本(高值))
      否则
          结果格式化库.写日志("[窗口] 设置失败：" + CDP_取最后错误())
          结果格式化库.写结果(2, "设置窗口边界失败：" + CDP_取最后错误())
      如果结束
  结束

  空 激活当前页面()
      如果 (工作台状态库.页面可用() == 假)
          返回()
      如果结束
      如果 (CDP_激活页面(当前页面))
          结果格式化库.写日志("[页面] 当前页面已激活为浏览器活动标签。")
          结果格式化库.写结果(2, "已激活当前页面")
      否则
          结果格式化库.写日志("[页面] 激活失败：" + CDP_取最后错误())
      如果结束
  结束

  空 关闭当前页面()
      如果 (工作台状态库.页面可用() == 假)
          返回()
      如果结束
      如果 (CDP_关闭页面(当前页面))
          结果格式化库.写日志("[页面] 已关闭当前页面。")
          工作台状态库.移除页面(当前页面)
      否则
          结果格式化库.写日志("[页面] 关闭失败：" + CDP_取最后错误())
      如果结束
  结束

  // ===== 03 脚本与元素 =====
  空 高亮当前元素()
      如果 (工作台状态库.元素可用() == 假)
          返回()
      如果结束
      如果 (CDP_高亮元素(当前元素, ""))
          结果格式化库.写日志("[元素] 已高亮当前元素。")
      否则
          结果格式化库.写日志("[元素] 高亮失败：" + CDP_取最后错误())
      如果结束
  结束

  空 隐藏元素高亮()
      如果 (工作台状态库.页面可用() == 假)
          返回()
      如果结束
      如果 (CDP_隐藏高亮(当前页面))
          结果格式化库.写日志("[元素] 已隐藏高亮。")
      否则
          结果格式化库.写日志("[元素] 隐藏高亮失败：" + CDP_取最后错误())
      如果结束
  结束

  // ===== 04 输入仿真 =====
  空 鼠标移动()
      如果 (工作台状态库.页面可用() == 假)
          返回()
      如果结束
      局部 整数型 横值 = 参数工具库.取整数输入(控件_取文本(横坐标输入), 300)
      局部 整数型 纵值 = 参数工具库.取整数输入(控件_取文本(纵坐标输入), 300)
      CDP_鼠标移动(当前页面, 横值, 纵值)
      结果格式化库.写日志("[鼠标] 已移动到 " + 到文本(横值) + "," + 到文本(纵值))
      结果格式化库.写结果(4, "鼠标移动 " + 到文本(横值) + "," + 到文本(纵值))
  结束

  空 鼠标单击()
      如果 (工作台状态库.页面可用() == 假)
          返回()
      如果结束
      局部 整数型 横值 = 参数工具库.取整数输入(控件_取文本(横坐标输入), 300)
      局部 整数型 纵值 = 参数工具库.取整数输入(控件_取文本(纵坐标输入), 300)
      局部 整数型 按钮值 = 参数工具库.取整数输入(控件_取文本(鼠标按钮输入), 0)
      局部 整数型 次数值 = 参数工具库.取整数输入(控件_取文本(点击次数输入), 1)
      如果 (CDP_鼠标单击(当前页面, 横值, 纵值, 按钮值, 次数值))
          结果格式化库.写日志("[鼠标] 单击完成。")
          结果格式化库.写结果(4, "鼠标单击 " + 到文本(横值) + "," + 到文本(纵值) + " 按钮" + 到文本(按钮值) + " 次数" + 到文本(次数值))
      否则
          结果格式化库.写日志("[鼠标] 单击失败：" + CDP_取最后错误())
      如果结束
  结束

  空 鼠标按下()
      如果 (工作台状态库.页面可用() == 假)
          返回()
      如果结束
      局部 整数型 横值 = 参数工具库.取整数输入(控件_取文本(横坐标输入), 300)
      局部 整数型 纵值 = 参数工具库.取整数输入(控件_取文本(纵坐标输入), 300)
      局部 整数型 按钮值 = 参数工具库.取整数输入(控件_取文本(鼠标按钮输入), 0)
      CDP_鼠标按下(当前页面, 横值, 纵值, 按钮值)
      结果格式化库.写日志("[鼠标] 已按下（与释放配合拖拽）。")
      结果格式化库.写结果(4, "鼠标按下 " + 到文本(横值) + "," + 到文本(纵值))
  结束

  空 鼠标释放()
      如果 (工作台状态库.页面可用() == 假)
          返回()
      如果结束
      局部 整数型 横值 = 参数工具库.取整数输入(控件_取文本(横坐标输入), 300)
      局部 整数型 纵值 = 参数工具库.取整数输入(控件_取文本(纵坐标输入), 300)
      局部 整数型 按钮值 = 参数工具库.取整数输入(控件_取文本(鼠标按钮输入), 0)
      CDP_鼠标释放(当前页面, 横值, 纵值, 按钮值)
      结果格式化库.写日志("[鼠标] 已释放。")
      结果格式化库.写结果(4, "鼠标释放 " + 到文本(横值) + "," + 到文本(纵值))
  结束

  空 鼠标滚轮()
      如果 (工作台状态库.页面可用() == 假)
          返回()
      如果结束
      局部 整数型 横值 = 参数工具库.取整数输入(控件_取文本(横坐标输入), 300)
      局部 整数型 纵值 = 参数工具库.取整数输入(控件_取文本(纵坐标输入), 300)
      局部 整数型 纵向值 = 参数工具库.取整数输入(控件_取文本(滚轮纵向输入), 120)
      CDP_鼠标滚轮(当前页面, 横值, 纵值, 0, 纵向值)
      结果格式化库.写日志("[鼠标] 滚轮纵向增量 " + 到文本(纵向值) + " 已派发。")
      结果格式化库.写结果(4, "鼠标滚轮 纵向" + 到文本(纵向值))
  结束

  空 鼠标拖拽()
      如果 (工作台状态库.页面可用() == 假)
          返回()
      如果结束
      局部 整数型 横值 = 参数工具库.取整数输入(控件_取文本(横坐标输入), 60)
      局部 整数型 纵值 = 参数工具库.取整数输入(控件_取文本(纵坐标输入), 250)
      局部 整数型 终横值 = 参数工具库.取整数输入(控件_取文本(终点横坐标输入), 420)
      局部 整数型 终纵值 = 参数工具库.取整数输入(控件_取文本(终点纵坐标输入), 250)
      局部 整数型 步数值 = 参数工具库.取整数输入(控件_取文本(拖拽步数输入), 10)
      如果 (CDP_鼠标拖拽(当前页面, 横值, 纵值, 终横值, 终纵值, 步数值))
          结果格式化库.写日志("[鼠标] 拖拽完成。")
          结果格式化库.写结果(4, "鼠标拖拽 " + 到文本(横值) + "," + 到文本(纵值) + " 到 " + 到文本(终横值) + "," + 到文本(终纵值))
      否则
          结果格式化库.写日志("[鼠标] 拖拽失败：" + CDP_取最后错误())
      如果结束
  结束

  空 按键操作()
      如果 (工作台状态库.页面可用() == 假)
          返回()
      如果结束
      局部 文本型 键名文本 = 参数工具库.取文本输入(控件_取文本(键名输入), "Enter")
      如果 (CDP_按键(当前页面, 键名文本))
          结果格式化库.写日志("[键盘] 已按键 " + 键名文本)
          结果格式化库.写结果(4, "按键 " + 键名文本)
      否则
          结果格式化库.写日志("[键盘] 按键失败：" + CDP_取最后错误())
      如果结束
  结束

  空 组合键操作()
      如果 (工作台状态库.页面可用() == 假)
          返回()
      如果结束
      局部 文本型 修饰键文本 = 参数工具库.取文本输入(控件_取文本(修饰键输入), "Ctrl")
      局部 文本型 键名文本 = 参数工具库.取文本输入(控件_取文本(键名输入), "a")
      如果 (CDP_组合键(当前页面, 修饰键文本, 键名文本))
          结果格式化库.写日志("[键盘] 组合键 " + 修饰键文本 + " + " + 键名文本 + " 已派发。")
          结果格式化库.写结果(4, "组合键 " + 修饰键文本 + "+" + 键名文本)
      否则
          结果格式化库.写日志("[键盘] 组合键失败：" + CDP_取最后错误())
      如果结束
  结束

  空 插入文本操作()
      如果 (工作台状态库.页面可用() == 假)
          返回()
      如果结束
      局部 文本型 内容文本 = 控件_取文本(插入文本输入)
      如果 (CDP_插入文本(当前页面, 内容文本))
          结果格式化库.写日志("[键盘] 已向焦点元素插入文本（headless 下可能不更新输入框值，可靠输入用 03 页签）。")
          结果格式化库.写结果(4, "插入文本：" + 内容文本)
      否则
          结果格式化库.写日志("[键盘] 插入失败：" + CDP_取最后错误())
      如果结束
  结束

  空 设置视口()
      如果 (工作台状态库.页面可用() == 假)
          返回()
      如果结束
      局部 整数型 宽值 = 参数工具库.取整数输入(控件_取文本(视口宽输入), 1280)
      局部 整数型 高值 = 参数工具库.取整数输入(控件_取文本(视口高输入), 720)
      如果 (CDP_设置视口(当前页面, 宽值, 高值))
          结果格式化库.写日志("[仿真] 视口已设为 " + 到文本(宽值) + "x" + 到文本(高值))
          结果格式化库.写结果(4, "视口 " + 到文本(宽值) + "x" + 到文本(高值))
      否则
          结果格式化库.写日志("[仿真] 设置失败：" + CDP_取最后错误())
      如果结束
  结束

  空 设置用户代理()
      如果 (工作台状态库.页面可用() == 假)
          返回()
      如果结束
      局部 文本型 代理文本 = 参数工具库.取文本输入(控件_取文本(用户代理输入), "")
      如果 (代理文本 == "")
          结果格式化库.写日志("[提示] 请填写 UserAgent。")
          返回()
      如果结束
      如果 (CDP_设置UserAgent(当前页面, 代理文本))
          结果格式化库.写日志("[仿真] UserAgent 已覆盖。")
          结果格式化库.写结果(4, "UserAgent=" + 代理文本)
      否则
          结果格式化库.写日志("[仿真] 设置失败：" + CDP_取最后错误())
      如果结束
  结束

  空 设置地理位置()
      如果 (工作台状态库.页面可用() == 假)
          返回()
      如果结束
      局部 小数型 纬度值 = 参数工具库.取小数输入(控件_取文本(纬度输入), 31.23)
      局部 小数型 经度值 = 参数工具库.取小数输入(控件_取文本(经度输入), 121.47)
      如果 (CDP_设置地理位置(当前页面, 纬度值, 经度值))
          结果格式化库.写日志("[仿真] 地理位置已覆盖。")
          结果格式化库.写结果(4, "地理位置 " + 到文本(纬度值) + "," + 到文本(经度值))
      否则
          结果格式化库.写日志("[仿真] 设置失败：" + CDP_取最后错误())
      如果结束
  结束

  空 设置时区()
      如果 (工作台状态库.页面可用() == 假)
