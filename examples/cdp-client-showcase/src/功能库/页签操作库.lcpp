      如果结束
  结束

  空 重置仿真()
      如果 (工作台状态库.页面可用() == 假)
          返回()
      如果结束
      如果 (CDP_重置仿真(当前页面))
          暗色开启 = 假
          触摸开启 = 假
          结果格式化库.写日志("[仿真] 视口/UA/地理位置/时区等覆盖已全部重置。")
          结果格式化库.写结果(4, "仿真已重置")
      否则
          结果格式化库.写日志("[仿真] 重置失败：" + CDP_取最后错误())
      如果结束
  结束

  空 派发触摸()
      如果 (工作台状态库.页面可用() == 假)
          返回()
      如果结束
      局部 文本型 触点文本 = 参数工具库.取文本输入(控件_取文本(触点JSON输入), "")
      如果 (触点文本 == "")
          结果格式化库.写日志("[提示] 请填写触点 JSON，如 [{\"x\":300,\"y\":300}]。")
          返回()
      如果结束
      如果 (触摸开启 == 假)
          CDP_设置触摸(当前页面, 真)
          触摸开启 = 真
          结果格式化库.写日志("[仿真] 已自动开启触摸仿真。")
      如果结束
      CDP_派发触摸(当前页面, "touchStart", 触点文本)
      CDP_派发触摸(当前页面, "touchEnd", "[]")
      结果格式化库.写日志("[触摸] 已派发 touchStart/touchEnd，触点=" + 触点文本)
      结果格式化库.写结果(4, "触摸事件已派发：" + 触点文本)
