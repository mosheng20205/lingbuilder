      如果 (CDP_设置下载目录(当前连接, 目录文本, 真))
          结果格式化库.写日志("[下载] 下载已允许，目录=" + 目录文本)
          结果格式化库.写结果(5, "下载目录=" + 目录文本 + "（允许）")
      否则
          结果格式化库.写日志("[下载] 设置失败：" + CDP_取最后错误())
      如果结束
  结束

