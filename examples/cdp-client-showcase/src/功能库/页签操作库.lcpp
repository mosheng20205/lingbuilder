      如果 (工作台状态库.页面可用() == 假)
          返回()
      如果结束
      如果 (离线开启)
          离线开启 = 假
      否则
          离线开启 = 真
      如果结束
      如果 (CDP_设置离线(当前页面, 离线开启))
          结果格式化库.写日志("[网络] 离线模拟=" + 到文本(离线开启))
          结果格式化库.写结果(5, "离线模拟 " + 到文本(离线开启))
      否则
          结果格式化库.写日志("[网络] 设置失败：" + CDP_取最后错误())
      如果结束
  结束

  空 设置限速()
      如果 (工作台状态库.页面可用() == 假)
          返回()
      如果结束
      局部 整数型 延迟值 = 参数工具库.取整数输入(控件_取文本(限速延迟输入), 200)
      局部 长整数型 下行值 = 参数工具库.取整数输入(控件_取文本(下行速率输入), 65536)
      局部 长整数型 上行值 = 参数工具库.取整数输入(控件_取文本(上行速率输入), 16384)
      如果 (CDP_设置限速(当前页面, 延迟值, 下行值, 上行值))
          结果格式化库.写日志("[网络] 限速已应用：延迟" + 到文本(延迟值) + "ms 下行" + 到文本(下行值) + "B/s 上行" + 到文本(上行值) + "B/s")
          结果格式化库.写结果(5, "限速 延迟=" + 到文本(延迟值) + "ms 下行=" + 到文本(下行值) + "B/s 上行=" + 到文本(上行值) + "B/s")
      否则
          结果格式化库.写日志("[网络] 设置失败：" + CDP_取最后错误())
      如果结束
  结束

