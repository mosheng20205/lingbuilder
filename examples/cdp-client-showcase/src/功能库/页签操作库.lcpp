          结果格式化库.写结果(4, "暗色模式 " + 到文本(暗色开启))
      否则
          结果格式化库.写日志("[仿真] 设置失败：" + CDP_取最后错误())
      如果结束
  结束

  空 设置CPU节流()
      如果 (工作台状态库.页面可用() == 假)
          返回()
      如果结束
      局部 整数型 倍率值 = 参数工具库.取整数输入(控件_取文本(倍率输入), 2)
      如果 (CDP_设置CPU节流(当前页面, 倍率值))
          结果格式化库.写日志("[仿真] CPU 节流倍率=" + 到文本(倍率值))
          结果格式化库.写结果(4, "CPU 节流 " + 到文本(倍率值) + " 倍")
      否则
