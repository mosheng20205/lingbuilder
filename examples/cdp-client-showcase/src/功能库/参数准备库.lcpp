// 参数准备库：窗口事件处理器调用带事件处理器的异步命令前的参数准备与动作结果反馈。
// 每个准备函数完成「前置守卫 + 读输入框 + 校验 + 写入操作参数暂存全局」，失败时已写中文提示并返回假；
// 成功后窗口侧用 操作参数一/二/三 与 操作整数一/二 调用异步命令（按红线，带处理器的调用点留在窗口主文件）。
功能库 参数准备库
公开:
  文本型 读必填(文本型 控件值, 文本型 提示)
      局部 文本型 已修剪 = 参数工具库.去空白(控件值)
      如果 (已修剪 == "")
          结果格式化库.写日志("[提示] " + 提示)
      如果结束
      返回(已修剪)
  结束

  // ===== 01 工作台 =====
  逻辑型 准备新建页面()
      如果 (工作台状态库.要求连接() == 假)
          返回(假)
      如果结束
      操作参数一 = 参数工具库.取文本输入(控件_取文本(新页面网址), "about:blank")
      自建页面中 = 真
      返回(真)
  结束

  逻辑型 准备附加页面()
      如果 (工作台状态库.要求连接() == 假)
          返回(假)
      如果结束
      操作参数一 = 参数准备库.读必填(控件_取文本(新页面网址), "附加页面需要填写网址（支持前缀匹配）。")
      如果 (操作参数一 == "")
          返回(假)
      如果结束
      返回(真)
  结束

  逻辑型 准备连接地址()
      操作参数一 = 参数工具库.取文本输入(控件_取文本(地址输入), "http://127.0.0.1:9222")
      结果格式化库.写日志("[连接] 正在连接 " + 操作参数一 + " ...")
      返回(真)
  结束

  逻辑型 准备远程地址()
      操作参数一 = 参数工具库.取文本输入(控件_取文本(地址输入), "http://127.0.0.1:9222")
      结果格式化库.写日志("[连接] 连接远程（仅受信网络）：" + 操作参数一)
      返回(真)
  结束

  // ===== 02 页面与导航 =====
  逻辑型 准备打开网址()
      如果 (工作台状态库.要求页面() == 假)
          返回(假)
      如果结束
      操作参数一 = 参数准备库.读必填(控件_取文本(网址输入), "请填写网址。")
      如果 (操作参数一 == "")
          返回(假)
      如果结束
      返回(真)
  结束

  逻辑型 准备等待加载()
      如果 (工作台状态库.要求页面() == 假)
          返回(假)
      如果结束
      操作整数一 = 参数工具库.取整数输入(控件_取文本(等待类型输入), 1)
      操作整数二 = 参数工具库.取整数输入(控件_取文本(等待超时输入), 15)
      结果格式化库.写日志("[导航] 等待加载事件类型=" + 到文本(操作整数一) + " 超时=" + 到文本(操作整数二) + " 秒。")
      返回(真)
  结束

  逻辑型 准备截图参数()
      如果 (工作台状态库.要求页面() == 假)
          返回(假)
      如果结束
      操作参数一 = 参数工具库.取文本输入(控件_取文本(截图路径), "output/页面截图.png")
      返回(真)
  结束

  逻辑型 准备PDF参数()
      如果 (工作台状态库.要求页面() == 假)
          返回(假)
      如果结束
      操作参数一 = 参数工具库.任务路径(参数工具库.取文本输入(控件_取文本(截图路径), "output"), "页面.pdf")
      返回(真)
  结束

  // ===== 03 脚本与元素 =====
  逻辑型 准备执行脚本()
      如果 (工作台状态库.要求页面() == 假)
          返回(假)
      如果结束
      操作参数一 = 参数工具库.取文本输入(控件_取文本(脚本输入), "document.title")
      返回(真)
  结束

  逻辑型 准备输入文本参数()
      如果 (工作台状态库.要求元素() == 假)
          返回(假)
      如果结束
      操作参数一 = 控件_取文本(输入内容)
      返回(真)
  结束

  逻辑型 准备属性名参数()
      如果 (工作台状态库.要求元素() == 假)
          返回(假)
      如果结束
      操作参数一 = 参数准备库.读必填(控件_取文本(属性名输入), "请填写属性名，如 href。")
      如果 (操作参数一 == "")
          返回(假)
      如果结束
      返回(真)
  结束

  逻辑型 准备数量选择器参数()
      如果 (工作台状态库.要求页面() == 假)
          返回(假)
      如果结束
      操作参数一 = 参数准备库.读必填(控件_取文本(元素选择器), "请填写选择器。")
      如果 (操作参数一 == "")
          返回(假)
      如果结束
      返回(真)
  结束

  逻辑型 准备元素文件参数()
      如果 (工作台状态库.要求元素() == 假)
          返回(假)
      如果结束
      操作参数一 = 参数工具库.取文本输入(控件_取文本(文件路径输入), "output/上传样例.txt")
      返回(真)
  结束

  逻辑型 准备元素截图参数()
      如果 (工作台状态库.要求元素() == 假)
          返回(假)
      如果结束
      操作参数一 = 参数工具库.任务路径(参数工具库.取文本输入(控件_取文本(文件路径输入), "output"), "元素截图.png")
      返回(真)
  结束

  逻辑型 准备调用函数参数()
      如果 (工作台状态库.要求元素() == 假)
          返回(假)
      如果结束
      操作参数一 = 参数工具库.取文本输入(控件_取文本(函数代码输入), "function(x){ return x.tagName }")
      返回(真)
  结束

  // ===== 05 网络与 Cookie =====
  逻辑型 准备响应体参数()
      如果 (工作台状态库.要求页面() == 假)
          返回(假)
      如果结束
      操作参数一 = 参数工具库.取文本输入(控件_取文本(请求编号输入), 最新请求编号)
      如果 (操作参数一 == "")
          结果格式化库.写日志("[提示] 没有可用的请求编号：先绑定网络事件并等一次响应，或直接填写编号。")
          返回(假)
      如果结束
      返回(真)
  结束

  逻辑型 准备置Cookie参数()
      如果 (工作台状态库.要求连接() == 假)
          返回(假)
      如果结束
      操作参数一 = 参数准备库.读必填(控件_取文本(Cookie名称), "Cookie 名称不能为空。")
      如果 (操作参数一 == "")
          返回(假)
      如果结束
      操作参数二 = 控件_取文本(Cookie值)
      操作参数三 = 参数准备库.读必填(控件_取文本(Cookie网址), "Cookie 网址不能为空（需含协议与路径，如 https://www.baidu.com/）。")
      如果 (操作参数三 == "")
          返回(假)
      如果结束
      返回(真)
  结束

  逻辑型 准备取Cookie参数()
      如果 (工作台状态库.要求连接() == 假)
          返回(假)
      如果结束
      操作参数一 = 参数准备库.读必填(控件_取文本(Cookie网址), "请填写要读取 Cookie 的网址。")
      如果 (操作参数一 == "")
          返回(假)
      如果结束
      返回(真)
  结束

  逻辑型 准备删Cookie参数()
      如果 (工作台状态库.要求连接() == 假)
          返回(假)
      如果结束
      操作参数一 = 参数准备库.读必填(控件_取文本(Cookie名称), "删除 Cookie 需要名称。")
      如果 (操作参数一 == "")
          返回(假)
      如果结束
      操作参数二 = 参数准备库.读必填(控件_取文本(Cookie网址), "删除 Cookie 需要网址。")
      如果 (操作参数二 == "")
          返回(假)
      如果结束
      返回(真)
  结束

  // ===== 06 请求拦截 =====
  逻辑型 准备拦截模式()
      如果 (工作台状态库.要求页面() == 假)
          返回(假)
      如果结束
      操作参数一 = 参数准备库.读必填(控件_取文本(拦截模式输入), "请填写拦截的 URL 模式，如 *://api.example.com/*。")
      如果 (操作参数一 == "")
          返回(假)
      如果结束
      返回(真)
  结束

  空 报告拦截开始(逻辑型 成功, 文本型 模式文本)
      如果 (成功)
          结果格式化库.写日志("[拦截] 已开启拦截 " + 模式文本 + "；被拦截请求会记录为「最新拦截」。")
          返回()
      如果结束
      结果格式化库.写日志("[拦截] 开启失败：" + CDP_取最后错误())
  结束

  // ===== 绑定类动作的统一反馈 =====
  空 报告绑定(逻辑型 成功, 文本型 名称)
      如果 (成功)
          结果格式化库.写日志("[监听] " + 名称 + " 已绑定。")
          返回()
      如果结束
      结果格式化库.写日志("[监听] " + 名称 + " 绑定失败：" + CDP_取最后错误())
  结束

  // ===== 08 目标与绑定 =====
  逻辑型 准备会话脚本参数()
      如果 (工作台状态库.要求会话() == 假)
          返回(假)
      如果结束
      操作参数一 = 参数工具库.取文本输入(控件_取文本(会话脚本输入), "document.title")
      返回(真)
  结束

  逻辑型 准备绑定名参数()
      如果 (工作台状态库.要求页面() == 假)
          返回(假)
      如果结束
      操作参数一 = 参数准备库.读必填(控件_取文本(绑定名称输入), "请填写绑定名称。")
      如果 (操作参数一 == "")
          返回(假)
      如果结束
      返回(真)
  结束

  // ===== 09 调试器 =====
  逻辑型 准备帧脚本参数()
      如果 (工作台状态库.要求调用帧() == 假)
          返回(假)
      如果结束
      操作参数一 = 参数工具库.取文本输入(控件_取文本(帧脚本输入), "1+1")
      返回(真)
  结束

  逻辑型 准备作用域参数()
      如果 (工作台状态库.要求调用帧() == 假)
          返回(假)
      如果结束
      操作整数一 = 参数工具库.取整数输入(控件_取文本(作用域索引输入), 0)
      操作整数二 = 参数工具库.取整数输入(控件_取文本(变量数量输入), 20)
      返回(真)
  结束

  逻辑型 准备单步参数()
      如果 (工作台状态库.要求页面() == 假)
          返回(假)
      如果结束
      操作整数一 = 参数工具库.取整数输入(控件_取文本(单步类型输入), 0)
      返回(真)
  结束

  逻辑型 准备断点参数()
      如果 (工作台状态库.要求页面() == 假)
          返回(假)
      如果结束
      操作参数一 = 参数准备库.读必填(控件_取文本(断点网址输入), "请填写断点脚本 URL 匹配文本。")
      如果 (操作参数一 == "")
          返回(假)
      如果结束
      操作整数一 = 参数工具库.取整数输入(控件_取文本(断点行输入), 1)
      操作整数二 = 参数工具库.取整数输入(控件_取文本(断点列输入), 1)
      操作参数二 = 控件_取文本(断点条件输入)
      返回(真)
  结束

  // ===== 10 指标与存储 =====
  逻辑型 准备存储来源参数()
      如果 (工作台状态库.要求连接() == 假)
          返回(假)
      如果结束
      操作参数一 = 参数准备库.读必填(控件_取文本(指标来源输入), "请填写 origin（如 https://www.baidu.com）。")
      如果 (操作参数一 == "")
          返回(假)
      如果结束
      返回(真)
  结束

  逻辑型 准备清理来源()
      如果 (工作台状态库.要求连接() == 假)
          返回(假)
      如果结束
      操作参数一 = 参数准备库.读必填(控件_取文本(指标来源输入), "请填写要清理的 origin。")
      如果 (操作参数一 == "")
          返回(假)
      如果结束
      如果 (控件_取勾选(已确认清理开关) == 假)
          结果格式化库.写日志("[提示] 清理来源数据是破坏性操作，请先勾选「已确认清理」。")
          返回(假)
      如果结束
      操作参数二 = 参数工具库.取文本输入(控件_取文本(存储类型输入), "cookies")
      返回(真)
  结束

  // ===== 14 证书安全 =====
  逻辑型 准备证书接管参数()
      如果 (工作台状态库.要求连接() == 假)
          返回(假)
      如果结束
      操作参数一 = 参数准备库.读必填(控件_取文本(白名单输入), "请填写 exact origin 白名单（无通配符）。")
      如果 (操作参数一 == "")
          返回(假)
      如果结束
      操作整数一 = 参数工具库.取整数输入(控件_取文本(有效秒数输入), 30)
      返回(真)
  结束
结束功能库
