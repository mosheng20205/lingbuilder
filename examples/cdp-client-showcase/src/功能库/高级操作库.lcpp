// 高级操作库：08-14 页签（目标会话/调试器/指标存储/性能任务/串流/录制回放/证书安全）同步命令的操作落点。
// 只调用同步命令；带事件处理器的命令由窗口主文件调用。
功能库 高级操作库
公开:
  // ===== 08 目标与绑定 =====
  空 目标事件行()
      局部 CDP目标 事件目标
      事件目标 = CDP_取当前目标()
      最新目标 = 事件目标
      局部 文本型 描述文本 = CDP_取目标JSON(最新目标)
      局部 文本型 类型文本 = CDP_取当前事件类型()
      结果格式化库.写日志("[目标] " + 类型文本 + " " + 参数工具库.截断文本(描述文本, 200))
  结束

  空 绑定调用行()
      局部 文本型 载荷文本 = CDP_取当前事件文本()
      局部 CDP绑定 事件绑定
      事件绑定 = CDP_取当前绑定()
      最新绑定 = 事件绑定
      结果格式化库.写日志("[绑定调用] 载荷=" + 载荷文本 + " 绑定句柄=" + 到文本(最新绑定))
      结果格式化库.写结果(8, "绑定调用载荷：" + 载荷文本)
  结束

  逻辑型 附加目标前置()
      如果 (最新目标 == 0)
          结果格式化库.写日志("[提示] 还没有目标句柄：先绑定目标事件，等待目标出现（或新建页面）后再附加。")
          返回(假)
      如果结束
      返回(真)
  结束

  空 附加目标收尾(CDP会话 新会话)
      如果 (新会话 != 0)
          最新会话 = 新会话
          局部 文本型 会话文本 = CDP_取会话JSON(最新会话)
          结果格式化库.写日志("[会话] 目标已自动附加（同步返回会话），可直接执行会话脚本。")
          结果格式化库.写结果(8, "同步附加会话：" + 会话文本)
          返回()
      如果结束
      结果格式化库.写日志("[会话] 已提交异步附加，结果经事件通知。")
  结束

  空 目标已附加行()
      局部 文本型 类型文本 = CDP_取当前事件类型()
      如果 (类型文本 == "命令失败")
          局部 文本型 错误文本 = CDP_取当前错误()
          结果格式化库.写日志("[会话] 附加失败：" + 错误文本)
          返回()
      如果结束
      局部 CDP会话 事件会话
      事件会话 = CDP_取当前会话()
      最新会话 = 事件会话
      结果格式化库.完成结果(8)
  结束

  空 枚举目标操作()
      如果 (当前连接 == 0)
          返回()
      如果结束
      局部 文本型 类型文本 = 控件_取文本(目标类型输入)
      局部 文本型 汇总文本 = CDP_枚举目标JSON(当前连接, 类型文本)
      结果格式化库.写结果(8, 汇总文本)
      结果格式化库.写日志("[目标] 枚举目标完成（JSON 已进「最近结果」）。")
  结束

  空 取最新目标JSON()
      如果 (最新目标 == 0)
          结果格式化库.写日志("[提示] 还没有目标句柄。")
          返回()
      如果结束
      局部 文本型 汇总文本 = CDP_取目标JSON(最新目标)
      结果格式化库.写结果(8, 汇总文本)
  结束

  空 分离当前会话()
      如果 (最新会话 == 0)
          返回()
      如果结束
      如果 (CDP_分离会话(最新会话))
          结果格式化库.写日志("[会话] 已分离会话。")
          结果格式化库.写结果(8, "会话已分离")
      否则
          结果格式化库.写日志("[会话] 分离失败：" + CDP_取最后错误())
      如果结束
  结束

  空 取最新会话JSON()
      如果 (最新会话 == 0)
          返回()
      如果结束
      局部 文本型 汇总文本 = CDP_取会话JSON(最新会话)
      结果格式化库.写结果(8, 汇总文本)
  结束

  空 枚举页面帧()
      如果 (工作台状态库.页面可用() == 假)
          返回()
      如果结束
      局部 文本型 汇总文本 = CDP_枚举帧JSON(当前页面)
      结果格式化库.写结果(8, 汇总文本)
      结果格式化库.写日志("[帧] 页面 Frame 列表已进「最近结果」。")
  结束

  空 移除当前页面绑定()
      如果 (最新绑定 == 0)
          返回()
      如果结束
      如果 (CDP_移除页面绑定(最新绑定))
          结果格式化库.写日志("[绑定] 已移除最新页面绑定。")
          结果格式化库.写结果(8, "页面绑定已移除")
      否则
          结果格式化库.写日志("[绑定] 移除失败：" + CDP_取最后错误())
      如果结束
  结束

  空 取当前帧操作()
      局部 CDP帧 事件帧
      事件帧 = CDP_取当前帧()
      结果格式化库.写结果(8, "当前帧句柄=" + 到文本(事件帧) + "（仅 Frame 事件期间有效）")
  结束

  空 取当前绑定操作()
      局部 CDP绑定 事件绑定
      事件绑定 = CDP_取当前绑定()
      结果格式化库.写结果(8, "当前绑定句柄=" + 到文本(事件绑定) + "（仅绑定事件期间有效）")
  结束

  空 取当前会话操作()
      局部 CDP会话 事件会话
      事件会话 = CDP_取当前会话()
      结果格式化库.写结果(8, "当前会话句柄=" + 到文本(事件会话) + "（仅会话相关事件期间有效）")
  结束

  空 取当前目标操作()
      局部 CDP目标 事件目标
      事件目标 = CDP_取当前目标()
      结果格式化库.写结果(8, "当前目标句柄=" + 到文本(事件目标) + "（仅目标事件期间有效）")
  结束

  // ===== 09 调试器 =====
  空 调试事件行()
      局部 文本型 类型文本 = CDP_取当前事件类型()
      如果 (类型文本 == "断点已解析")
          局部 文本型 解析文本 = CDP_取当前事件文本()
          结果格式化库.写日志("[调试] 断点已解析：" + 解析文本)
          返回()
      如果结束
      如果 (类型文本 == "调试已恢复")
          结果格式化库.写日志("[调试] 已恢复。")
          返回()
      如果结束
      局部 整数型 帧数量 = CDP_取当前调用帧数量()
      局部 CDP调用帧 事件帧
      事件帧 = CDP_取当前调用帧(0)
      最新调用帧 = 事件帧
      局部 文本型 帧文本 = CDP_取调用帧JSON(最新调用帧)
      结果格式化库.写日志("[调试] 暂停：调用帧数=" + 到文本(帧数量) + "（帧0 已记录为最新调用帧）")
      结果格式化库.写结果(9, "帧0：" + 帧文本)
  结束

  空 取调用帧数量()
      局部 整数型 帧数量 = CDP_取当前调用帧数量()
      结果格式化库.写结果(9, "当前暂停调用帧数=" + 到文本(帧数量))
      结果格式化库.写日志("[调试] 调用帧数=" + 到文本(帧数量))
  结束

  空 取当前调用帧操作()
      局部 整数型 索引值 = 参数工具库.取整数输入(控件_取文本(帧索引输入), 0)
      局部 CDP调用帧 帧句柄
      帧句柄 = CDP_取当前调用帧(索引值)
      如果 (帧句柄 == 0)
          结果格式化库.写日志("[调试] 取调用帧失败（未暂停或索引越界）。")
          返回()
      如果结束
      最新调用帧 = 帧句柄
      结果格式化库.写结果(9, "最新调用帧已设为帧" + 到文本(索引值))
  结束

  空 取最新调用帧JSON()
      如果 (最新调用帧 == 0)
          结果格式化库.写日志("[提示] 还没有调用帧：先暂停调试。")
          返回()
      如果结束
      局部 文本型 帧文本 = CDP_取调用帧JSON(最新调用帧)
      结果格式化库.写结果(9, 帧文本)
  结束

  空 取当前断点操作()
      局部 CDP断点 事件断点
      事件断点 = CDP_取当前断点()
      结果格式化库.写结果(9, "当前断点句柄=" + 到文本(事件断点))
  结束

  // ===== 11 性能任务（查询） =====
  文本型 任务输出路径(文本型 文件名)
      返回(参数工具库.任务路径(参数工具库.取文本输入(控件_取文本(任务路径输入), "output"), 文件名))
  结束

  空 记录新任务(CDP任务 新任务, 文本型 任务名称)
      如果 (新任务 == 0)
          结果格式化库.写日志("[任务] " + 任务名称 + " 启动失败：" + CDP_取最后错误())
          返回()
      如果结束
      最新任务 = 新任务
      结果格式化库.写日志("[任务] " + 任务名称 + " 已开始（任务=" + 到文本(最新任务) + "）。")
      结果格式化库.写结果(11, 任务名称 + "已开始，任务=" + 到文本(最新任务))
  结束

  空 任务状态查询()
      如果 (最新任务 == 0)
          结果格式化库.写日志("[提示] 还没有任务。")
          返回()
      如果结束
      局部 文本型 状态行 = 结果格式化库.任务状态行(最新任务)
      结果格式化库.写结果(11, 状态行)
      结果格式化库.写日志("[任务] " + 状态行)
  结束

  空 任务进度查询()
      如果 (最新任务 == 0)
          返回()
      如果结束
      局部 整数型 进度值 = CDP_取任务进度(最新任务)
      结果格式化库.写结果(11, "任务进度=" + 到文本(进度值) + "%")
      结果格式化库.写日志("[任务] 进度=" + 到文本(进度值) + "%")
  结束

  空 任务路径查询()
      如果 (最新任务 == 0)
          返回()
      如果结束
      局部 文本型 路径文本 = CDP_取任务结果路径(最新任务)
      结果格式化库.写结果(11, "输出路径=" + 路径文本)
      结果格式化库.写日志("[任务] 输出路径=" + 路径文本)
  结束

  空 取当前任务操作()
      局部 CDP任务 事件任务
      事件任务 = CDP_取当前任务()
      结果格式化库.写结果(11, "当前任务句柄=" + 到文本(事件任务) + "（仅任务事件期间有效）")
  结束

  // ===== 12 画面串流 =====
  空 停止串流操作()
      如果 (工作台状态库.页面可用() == 假)
          返回()
      如果结束
      如果 (CDP_停止串流(当前页面))
          结果格式化库.写日志("[串流] 已停止（共收帧 " + 到文本(已收帧数) + "）。")
          结果格式化库.写结果(12, "串流已停止，共收帧 " + 到文本(已收帧数))
      否则
          结果格式化库.写日志("[串流] 停止失败：" + CDP_取最后错误())
      如果结束
  结束

  // ===== 13 录制回放 =====
  空 记录自定义步骤()
      如果 (最新录制 == 0)
          结果格式化库.写日志("[提示] 还没有进行中的录制。")
          返回()
      如果结束
      局部 文本型 类型文本 = 参数工具库.取文本输入(控件_取文本(步骤类型输入), "备注")
      局部 文本型 数据文本 = 控件_取文本(步骤JSON输入)
      如果 (CDP_记录步骤(最新录制, 类型文本, 数据文本))
          结果格式化库.写日志("[录制] 已补充自定义步骤：" + 类型文本)
          结果格式化库.写结果(13, "已记录步骤：" + 类型文本)
      否则
          结果格式化库.写日志("[录制] 记录失败：" + CDP_取最后错误())
      如果结束
  结束

  空 停止当前录制()
      如果 (最新录制 == 0)
          返回()
      如果结束
      如果 (CDP_停止录制(最新录制))
          局部 文本型 状态文本 = CDP_取录制状态(最新录制)
          结果格式化库.写日志("[录制] 已停止（状态=" + 状态文本 + "），文件已落盘。")
          结果格式化库.写结果(13, "录制已停止，状态=" + 状态文本)
      否则
          结果格式化库.写日志("[录制] 停止失败：" + CDP_取最后错误())
      如果结束
  结束

  空 录制状态查询()
      如果 (最新录制 == 0)
          返回()
      如果结束
      局部 文本型 状态文本 = CDP_取录制状态(最新录制)
      结果格式化库.写结果(13, "录制状态=" + 状态文本)
      结果格式化库.写日志("[录制] 状态=" + 状态文本)
  结束

  空 加载回放文件()
      如果 (当前连接 == 0)
          返回()
      如果结束
      局部 文本型 路径文本 = 参数工具库.取文本输入(控件_取文本(录制文件输入), "output/操作录制.json")
      局部 CDP回放 新回放
      新回放 = CDP_加载回放(当前连接, 路径文本)
      如果 (新回放 == 0)
          结果格式化库.写日志("[回放] 加载失败：" + CDP_取最后错误())
          返回()
      如果结束
      最新回放 = 新回放
      局部 文本型 状态文本 = CDP_取回放状态(最新回放)
      结果格式化库.写日志("[回放] 已加载（状态=" + 状态文本 + "），可对当前页面执行回放。")
      结果格式化库.写结果(13, "回放已加载，状态=" + 状态文本)
  结束

  空 停止当前回放()
      如果 (最新回放 == 0)
          返回()
      如果结束
      如果 (CDP_停止回放(最新回放))
          结果格式化库.写日志("[回放] 已请求停止（当前步骤完成后不再继续）。")
          结果格式化库.写结果(13, "已请求停止回放")
      否则
          结果格式化库.写日志("[回放] 停止返回假（回放未在执行中属正常）。")
      如果结束
  结束

  空 回放状态查询()
      如果 (最新回放 == 0)
          返回()
      如果结束
      局部 文本型 状态文本 = CDP_取回放状态(最新回放)
      结果格式化库.写结果(13, "回放状态=" + 状态文本)
      结果格式化库.写日志("[回放] 状态=" + 状态文本)
  结束

  空 取当前回放操作()
      局部 CDP回放 事件回放
      事件回放 = CDP_取当前回放()
      结果格式化库.写结果(13, "当前回放句柄=" + 到文本(事件回放))
  结束

  // ===== 11 性能任务（启动准备） =====
  逻辑型 准备堆快照()
      如果 (工作台状态库.要求页面() == 假)
          返回(假)
      如果结束
      操作参数一 = 高级操作库.任务输出路径("heap.heapsnapshot")
      返回(真)
  结束

  逻辑型 准备追踪()
      如果 (工作台状态库.要求页面() == 假)
          返回(假)
      如果结束
      操作参数一 = 控件_取文本(追踪类别输入)
      操作参数二 = 高级操作库.任务输出路径("trace.json")
      返回(真)
  结束

  逻辑型 准备CPU分析()
      如果 (工作台状态库.要求页面() == 假)
          返回(假)
      如果结束
      操作参数一 = 高级操作库.任务输出路径("cpu-profile.json")
      返回(真)
  结束

  逻辑型 准备覆盖率()
      如果 (工作台状态库.要求页面() == 假)
          返回(假)
      如果结束
      操作参数一 = 高级操作库.任务输出路径("coverage.json")
      返回(真)
  结束

  // ===== 12 画面串流 =====
  逻辑型 准备串流()
      如果 (工作台状态库.要求页面() == 假)
          返回(假)
      如果结束
      操作参数一 = 参数工具库.取文本输入(控件_取文本(串流目录输入), "output/frames")
      操作参数二 = 控件_取文本(串流参数输入)
      已收帧数 = 0
      控件_设置文本(串流计数标签, "已收帧数：0")
      返回(真)
  结束

  空 报告串流开始(逻辑型 成功, 文本型 目录文本)
      如果 (成功)
          结果格式化库.写日志("[串流] 串流已启动，帧写入 " + 目录文本)
          结果格式化库.写结果(12, "串流已启动，输出目录=" + 目录文本)
          返回()
      如果结束
      结果格式化库.写日志("[串流] 启动失败：" + CDP_取最后错误())
      结果格式化库.写结果(12, "串流启动失败：" + CDP_取最后错误())
  结束

  // ===== 13 录制回放 =====
  逻辑型 准备录制()
      如果 (工作台状态库.要求页面() == 假)
          返回(假)
      如果结束
      操作参数一 = 参数工具库.取文本输入(控件_取文本(录制文件输入), "output/操作录制.json")
      返回(真)
  结束

  空 记录新录制(CDP录制 新录制, 文本型 路径文本)
      如果 (新录制 == 0)
          结果格式化库.写日志("[录制] 启动失败：" + CDP_取最后错误())
          返回()
      如果结束
      最新录制 = 新录制
      结果格式化库.写日志("[录制] 录制已开始：之后的模块命令（点击/输入/导航等）会自动采集为结构化步骤。")
      结果格式化库.写结果(13, "录制已开始，文件=" + 路径文本)
  结束

  空 记录新绑定(CDP绑定 新绑定, 文本型 名称文本)
      如果 (新绑定 == 0)
          结果格式化库.写日志("[绑定] 安装失败：" + CDP_取最后错误())
          返回()
      如果结束
      最新绑定 = 新绑定
      结果格式化库.写日志("[绑定] 已安装页面绑定 " + 名称文本 + "，页面可调用 window." + 名称文本 + "(...)。")
      结果格式化库.写结果(8, "页面绑定已安装：" + 名称文本 + " 句柄=" + 到文本(最新绑定))
  结束

  逻辑型 准备执行回放()
      如果 (工作台状态库.要求回放() == 假)
          返回(假)
      如果结束
      如果 (工作台状态库.要求页面() == 假)
          返回(假)
      如果结束
      返回(真)
  结束

  // ===== 14 证书安全 =====
  空 裁决最新证书错误()
      如果 (最新证书错误 == 0)
          结果格式化库.写日志("[提示] 还没有待裁决的证书错误。")
          返回()
      如果结束
      局部 逻辑型 允许值 = 假
      允许值 = 控件_取勾选(允许继续开关)
      如果 (CDP_裁决证书错误(最新证书错误, 允许值))
          结果格式化库.写日志("[证书] 已裁决（允许=" + 到文本(允许值) + "）。")
          结果格式化库.写结果(14, "已裁决证书错误（允许=" + 到文本(允许值) + "）")
      否则
          结果格式化库.写日志("[证书] 裁决失败：" + CDP_取最后错误())
      如果结束
  结束

  空 关闭证书接管()
      如果 (当前连接 == 0)
          返回()
      如果结束
      如果 (CDP_关闭证书错误接管(当前连接))
          结果格式化库.写日志("[证书] 已关闭接管，恢复浏览器默认证书校验。")
          结果格式化库.写结果(14, "证书错误接管已关闭")
      否则
          结果格式化库.写日志("[证书] 关闭失败：" + CDP_取最后错误())
      如果结束
  结束

  空 取当前证书错误操作()
      局部 CDP证书错误 事件错误
      事件错误 = CDP_取当前证书错误()
      结果格式化库.写结果(14, "当前证书错误句柄=" + 到文本(事件错误) + "（仅证书错误事件期间有效）")
  结束
结束功能库
