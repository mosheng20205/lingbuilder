类 MainWindow
    // CDP 浏览器自动化工具（lingbuilder.cdp.client 3.1 全命令交互）
    // 本文件是事件处理器与调度层：同步操作在 页签操作库/高级操作库，事件快照整理在 结果格式化库，
    // 异步命令前置准备在 参数准备库（经 操作参数一~四/操作整数一/二 暂存），纯逻辑在 参数工具库/工作台状态库。
    // 带 &处理器 的异步命令调用点全部留在本文件（功能库红线）。
    事件 _MainWindow_创建完毕()
        页签操作库.工具启动()
        浏览器 = CDP_启动浏览器("{\"额外参数\":\"--no-proxy-server\"}", &无头就绪)
        如果 (浏览器 == 0)
            结果格式化库.写日志("[启动] 失败：" + CDP_取最后错误())
        如果结束
    结束
    // ===== 连接级事件 =====
    事件 无头就绪()
        如果 (CDP_取当前事件类型() == "已就绪")
            浏览器 = CDP_取当前连接()
            当前连接 = 浏览器
            CDP_绑定连接事件(浏览器, &连接事件处理)
            CDP_绑定新页面事件(浏览器, &新页面出现)
            工作台状态库.记录连接(浏览器)
            结果格式化库.写日志("[连接] 无头浏览器已就绪：" + CDP_取浏览器版本(浏览器))
        否则
            结果格式化库.写日志("[连接] 连接失败：" + CDP_取当前错误())
        如果结束
    结束
    事件 连接事件处理()
        结果格式化库.连接事件行()
    结束
    事件 新页面出现()
        局部 文本型 网址文本 = CDP_取当前事件文本()
        如果 (自建页面中)
            返回()
        如果结束
        结果格式化库.写日志("[新页面] 出现：" + 网址文本)
        如果 (控件_取勾选(弹窗布防开关))
            局部 CDP页面 弹窗页面
            弹窗页面 = CDP_附加页面(当前连接, 网址文本, &页面就绪A)
            结果格式化库.写日志("[新页面] 弹窗布防已开启，自动附加该页面进列表。")
        如果结束
    结束
    事件 页面就绪A()
        如果 (CDP_取当前事件类型() == "页面就绪")
            页面A = CDP_取当前页面()
            当前页面 = 页面A
            自建页面中 = 假
            CDP_激活页面(页面A)
            工作台状态库.记录页面(页面A)
            结果格式化库.写日志("[页面] 页面就绪：" + CDP_取页面网址(页面A))
        否则
            结果格式化库.写日志("[页面] 新建/附加失败：" + CDP_取当前事件详情() + " | " + CDP_取当前事件文本())
        如果结束
    结束
    // ===== 01 工作台 =====
    事件 _连接列表_选择项被改变()
        工作台状态库.应用连接选择()
    结束
    事件 _页面列表_选择项被改变()
        工作台状态库.应用页面选择()
    结束
    事件 _新建页面_被单击()
        如果 (参数准备库.准备新建页面() == 假)
            返回()
        如果结束
        局部 CDP页面 新页面
        新页面 = CDP_新建页面(当前连接, 操作参数一, &页面就绪A)
    结束
    事件 _附加页面_被单击()
        如果 (参数准备库.准备附加页面() == 假)
            返回()
        如果结束
        局部 CDP页面 新页面
        新页面 = CDP_附加页面(当前连接, 操作参数一, &页面就绪A)
    结束
    事件 _关闭选中页面_被单击()
        页签操作库.关闭当前页面()
    结束
    事件 _刷新页面列表_被单击()
        工作台状态库.重建页面列表()
        结果格式化库.写日志("[工作台] 页面列表已刷新。")
    结束
    事件 _启动无头浏览器_被单击()
        结果格式化库.写日志("[连接] 正在启动无头浏览器（自动查找 Edge/Chrome）...")
        浏览器 = CDP_启动浏览器("{\"额外参数\":\"--no-proxy-server\"}", &无头就绪)
    结束
    事件 _连接输入地址_被单击()
        如果 (参数准备库.准备连接地址() == 假)
            返回()
        如果结束
        局部 CDP连接 新连接
        新连接 = CDP_连接(操作参数一, &无头就绪)
    结束
    事件 _连接远程_被单击()
        如果 (参数准备库.准备远程地址() == 假)
            返回()
        如果结束
        局部 CDP连接 新连接
        新连接 = CDP_连接远程(操作参数一, &无头就绪)
    结束
    事件 _断开当前连接_被单击()
        页签操作库.断开当前连接()
    结束
    事件 _停止当前浏览器_被单击()
        页签操作库.停止当前浏览器()
    结束
    事件 _停止全部浏览器_被单击()
        页签操作库.停止全部浏览器()
    结束
    事件 _连接状态查询_被单击()
        页签操作库.连接状态查询()
    结束
    事件 _设置命令超时_被单击()
        页签操作库.设置命令超时()
    结束
    事件 _查询元素_被单击()
        页签操作库.查询元素(控件_取文本(选择器输入))
    结束
    事件 _查询元素03_被单击()
        页签操作库.查询元素(控件_取文本(元素选择器))
    结束
    // ===== 02 页面与导航 =====
    事件 _打开网址_被单击()
        如果 (参数准备库.准备打开网址() == 假)
            返回()
        如果结束
        CDP_打开网址(当前页面, 操作参数一, &完成02)
    结束
    事件 _刷新页面_被单击()
        如果 (工作台状态库.要求页面() == 假)
            返回()
        如果结束
        CDP_刷新页面(当前页面, &完成02)
    结束
    事件 _后退页面_被单击()
        如果 (工作台状态库.要求页面() == 假)
            返回()
        如果结束
        CDP_后退页面(当前页面, &完成02)
    结束
    事件 _前进页面_被单击()
        如果 (工作台状态库.要求页面() == 假)
            返回()
        如果结束
        CDP_前进页面(当前页面, &完成02)
    结束
    事件 _停止加载_被单击()
        页签操作库.停止页面加载()
    结束
    事件 _等待加载_被单击()
        如果 (参数准备库.准备等待加载() == 假)
            返回()
        如果结束
        CDP_等待加载(当前页面, 操作整数一, 操作整数二, &完成02)
    结束
    事件 _取页面网址_被单击()
        页签操作库.读取页面网址()
    结束
    事件 _取页面标题_被单击()
        如果 (工作台状态库.要求页面() == 假)
            返回()
        如果结束
        CDP_取页面标题(当前页面, &完成02)
    结束
    事件 _取页面HTML_被单击()
        如果 (工作台状态库.要求页面() == 假)
            返回()
        如果结束
        CDP_取页面HTML(当前页面, &完成02)
    结束
    事件 _取窗口边界_被单击()
        如果 (工作台状态库.要求页面() == 假)
            返回()
        如果结束
        CDP_取窗口边界(当前页面, &完成02)
    结束
    事件 _设置窗口边界_被单击()
        页签操作库.调整窗口边界()
    结束
    事件 _页面截图_被单击()
        如果 (参数准备库.准备截图参数() == 假)
            返回()
        如果结束
        CDP_截图(当前页面, 操作参数一, 控件_取勾选(整页截图开关), &完成02)
    结束
    事件 _打印PDF_被单击()
        如果 (参数准备库.准备PDF参数() == 假)
            返回()
        如果结束
        CDP_打印PDF(当前页面, 操作参数一, &完成02)
    结束
    事件 _激活页面_被单击()
        页签操作库.激活当前页面()
    结束
    事件 _关闭页面_被单击()
        页签操作库.关闭当前页面()
    结束
    // ===== 03 脚本与元素 =====
    事件 _执行脚本_被单击()
        如果 (参数准备库.准备执行脚本() == 假)
            返回()
        如果结束
        CDP_执行脚本(当前页面, 操作参数一, &完成03)
    结束
    事件 _点击元素_被单击()
        如果 (工作台状态库.要求元素() == 假)
            返回()
        如果结束
        CDP_点击元素(当前元素, &完成03)
    结束
    事件 _输入文本到元素_被单击()
        如果 (参数准备库.准备输入文本参数() == 假)
            返回()
        如果结束
        CDP_输入文本(当前元素, 操作参数一, &完成03)
    结束
    事件 _取元素文本_被单击()
        如果 (工作台状态库.要求元素() == 假)
            返回()
        如果结束
        CDP_取元素文本(当前元素, &完成03)
    结束
    事件 _取元素属性_被单击()
        如果 (参数准备库.准备属性名参数() == 假)
            返回()
        如果结束
        CDP_取元素属性(当前元素, 操作参数一, &完成03)
    结束
    事件 _取元素数量_被单击()
        如果 (参数准备库.准备数量选择器参数() == 假)
            返回()
        如果结束
        CDP_取元素数量(当前页面, 操作参数一, &完成03)
    结束
    事件 _设置元素文件_被单击()
        如果 (参数准备库.准备元素文件参数() == 假)
            返回()
        如果结束
        CDP_设置元素文件(当前元素, 操作参数一, &完成03)
    结束
    事件 _截图元素_被单击()
        如果 (参数准备库.准备元素截图参数() == 假)
            返回()
        如果结束
        CDP_截图元素(当前元素, 操作参数一, &完成03)
    结束
    事件 _调用函数_被单击()
        如果 (参数准备库.准备调用函数参数() == 假)
            返回()
        如果结束
        CDP_调用函数(当前元素, 操作参数一, &完成03)
    结束
    事件 _高亮元素_被单击()
        页签操作库.高亮当前元素()
    结束
    事件 _隐藏高亮_被单击()
        页签操作库.隐藏元素高亮()
    结束
    // ===== 04 输入仿真 =====
    事件 _鼠标移动_被单击()
        页签操作库.鼠标移动()
    结束
    事件 _鼠标单击_被单击()
        页签操作库.鼠标单击()
    结束
    事件 _鼠标按下_被单击()
        页签操作库.鼠标按下()
    结束
    事件 _鼠标释放_被单击()
        页签操作库.鼠标释放()
    结束
    事件 _鼠标滚轮_被单击()
        页签操作库.鼠标滚轮()
    结束
    事件 _鼠标拖拽_被单击()
        页签操作库.鼠标拖拽()
    结束
    事件 _按键_被单击()
        页签操作库.按键操作()
    结束
    事件 _组合键_被单击()
        页签操作库.组合键操作()
    结束
    事件 _插入文本_被单击()
        页签操作库.插入文本操作()
    结束
    事件 _设置视口_被单击()
        页签操作库.设置视口()
    结束
    事件 _设置用户代理_被单击()
        页签操作库.设置用户代理()
    结束
    事件 _设置地理位置_被单击()
        页签操作库.设置地理位置()
    结束
    事件 _设置时区_被单击()
        页签操作库.设置时区()
    结束
    事件 _设置语言_被单击()
        页签操作库.设置语言()
    结束
    事件 _设置暗色模式_被单击()
        页签操作库.设置暗色模式()
    结束
    事件 _设置CPU节流_被单击()
        页签操作库.设置CPU节流()
    结束
    事件 _设置触摸_被单击()
        页签操作库.设置触摸()
    结束
    事件 _重置仿真_被单击()
        页签操作库.重置仿真()
    结束
    事件 _派发触摸_被单击()
        页签操作库.派发触摸()
    结束
    // ===== 05 网络与 Cookie =====
    事件 _绑定网络事件_被单击()
        如果 (工作台状态库.要求页面() == 假)
            返回()
        如果结束
        参数准备库.报告绑定(CDP_绑定网络事件(当前页面, &网络事件处理), "网络事件")
    结束
    事件 _取网络响应体_被单击()
        如果 (参数准备库.准备响应体参数() == 假)
            返回()
        如果结束
        CDP_取网络响应体(当前页面, 操作参数一, &完成05)
    结束
    事件 _绑定下载事件_被单击()
        如果 (工作台状态库.要求连接() == 假)
            返回()
        如果结束
        参数准备库.报告绑定(CDP_绑定下载事件(当前连接, &下载事件处理), "下载事件")
    结束
    事件 _设置下载目录_被单击()
        页签操作库.设置下载目录()
    结束
    事件 _置Cookie_被单击()
        如果 (参数准备库.准备置Cookie参数() == 假)
            返回()
        如果结束
        CDP_置Cookie(当前连接, 操作参数一, 操作参数二, 操作参数三, &完成05)
    结束
    事件 _取Cookie_被单击()
        如果 (参数准备库.准备取Cookie参数() == 假)
            返回()
        如果结束
        CDP_取Cookie(当前连接, 操作参数一, &完成05)
    结束
    事件 _删除Cookie_被单击()
        如果 (参数准备库.准备删Cookie参数() == 假)
            返回()
        如果结束
        CDP_删除Cookie(当前连接, 操作参数一, 操作参数二, &完成05)
    结束
    事件 _清空缓存_被单击()
        如果 (工作台状态库.要求连接() == 假)
            返回()
        如果结束
        CDP_清空缓存(当前连接, &完成05)
    结束
    事件 _清空Cookie_被单击()
        如果 (工作台状态库.要求连接() == 假)
            返回()
        如果结束
        CDP_清空Cookie(当前连接, &完成05)
    结束
    事件 _设置离线_被单击()
        页签操作库.设置离线()
    结束
    事件 _设置限速_被单击()
        页签操作库.设置限速()
    结束
    事件 _禁用缓存_被单击()
        页签操作库.禁用缓存()
    结束
    // ===== 06 请求拦截 =====
    事件 _拦截开始_被单击()
        如果 (参数准备库.准备拦截模式() == 假)
            返回()
        如果结束
        参数准备库.报告拦截开始(CDP_拦截开始(当前页面, 操作参数一, &拦截事件处理), 操作参数一)
    结束
    事件 _拦截停止_被单击()
        页签操作库.停止拦截()
    结束
    事件 _拦截继续_被单击()
        页签操作库.继续放行拦截()
    结束
    事件 _拦截改写_被单击()
        页签操作库.改写拦截()
    结束
    事件 _模拟响应_被单击()
        页签操作库.模拟拦截响应()
    结束
    事件 _拦截终止_被单击()
        页签操作库.终止拦截()
    结束
    事件 _应答认证_被单击()
        页签操作库.应答拦截认证()
    结束
    事件 _取拦截请求体_被单击()
        如果 (页签操作库.拦截可用提示() == 假)
            返回()
        如果结束
        CDP_取拦截请求体(最新拦截, &完成06)
    结束
    // ===== 07 对话框与监听 =====
    事件 _绑定对话框事件_被单击()
        如果 (工作台状态库.要求页面() == 假)
            返回()
        如果结束
        参数准备库.报告绑定(CDP_绑定对话框事件(当前页面, &对话框事件处理), "对话框事件")
    结束
    事件 _应答对话框_被单击()
        页签操作库.应答当前对话框()
    结束
    事件 _绑定控制台事件_被单击()
        如果 (工作台状态库.要求页面() == 假)
            返回()
        如果结束
        参数准备库.报告绑定(CDP_绑定控制台事件(当前页面, &控制台消息处理), "控制台事件")
    结束
    事件 _绑定页面异常_被单击()
        如果 (工作台状态库.要求页面() == 假)
            返回()
        如果结束
        参数准备库.报告绑定(CDP_绑定页面异常(当前页面, &页面异常处理), "页面异常")
    结束
    事件 _绑定页面事件_被单击()
        如果 (工作台状态库.要求页面() == 假)
            返回()
        如果结束
        参数准备库.报告绑定(CDP_绑定页面事件(当前页面, &页面事件处理), "页面事件")
    结束
    事件 _绑定连接事件_被单击()
        如果 (工作台状态库.要求连接() == 假)
            返回()
        如果结束
        参数准备库.报告绑定(CDP_绑定连接事件(当前连接, &连接事件处理), "连接事件")
    结束
    // ===== 08 目标与绑定 =====
    事件 _设置自动附加_被单击()
        如果 (工作台状态库.要求连接() == 假)
            返回()
        如果结束
        CDP_设置自动附加(当前连接, 真, 假, &完成08)
    结束
    事件 _绑定目标事件_被单击()
        如果 (工作台状态库.要求连接() == 假)
            返回()
        如果结束
        参数准备库.报告绑定(CDP_绑定目标事件(当前连接, &目标事件处理), "目标事件")
    结束
    事件 _枚举目标JSON_被单击()
        高级操作库.枚举目标操作()
    结束
    事件 _附加目标_被单击()
        如果 (高级操作库.附加目标前置() == 假)
            返回()
        如果结束
        局部 CDP会话 新会话
        新会话 = CDP_附加目标(最新目标, &目标已附加)
        高级操作库.附加目标收尾(新会话)
    结束
    事件 目标已附加()
        高级操作库.目标已附加行()
    结束
