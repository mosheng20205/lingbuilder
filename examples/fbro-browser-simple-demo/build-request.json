{
  "project": {
    "schemaVersion": 2,
    "id": "fbro-browser-simple-demo",
    "name": "FBro 浏览器简单示例",
    "windows": [
      {
        "id": "main-window",
        "fileName": "FBro浏览器简单窗体.xml",
        "className": "FBro浏览器简单窗体",
        "title": "FBro 浏览器简单示例",
        "width": 960,
        "height": 680,
        "background": "#111827",
        "description": "创建一个 FBro 浏览器并采集网页标题与地址。",
        "events": {
          "Loaded": "_FBro浏览器简单窗体_创建完毕"
        },
        "controls": [
          {
            "id": "browser-1",
            "type": "FBroBrowser",
            "name": "浏览器1",
            "content": "",
            "x": 10,
            "y": 10,
            "width": 920,
            "height": 620,
            "background": "#FFFFFF",
            "foreground": "#000000",
            "isEnabled": true,
            "visibility": "Visible",
            "properties": {
              "processMode": "in-process",
              "url": "about:blank",
              "cacheDir": ".fbro/cache",
              "enableJs": true,
              "enableDevTools": true,
              "loadImages": true,
              "enableWebGL": true,
              "muteAudio": true,
              "proxyMode": "system"
            },
            "events": {
              "加载状态改变": "浏览器1_加载状态改变"
            }
          }
        ],
        "resources": []
      }
    ]
  },
  "activeWindowId": "main-window",
  "lingCppSourceFilePath": "src/FBro浏览器简单窗体.lcpp",
  "run": false,
  "approved": true
}
