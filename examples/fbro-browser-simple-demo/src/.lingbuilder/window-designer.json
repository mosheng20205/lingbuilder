{
  "schemaVersion": 2,
  "id": "fbro-browser-simple-demo",
  "name": "FBro 浏览器简单示例",
  "resources": [],
  "windows": [
    {
      "id": "main-window",
      "fileName": "FBro浏览器简单窗体.xml",
      "className": "FBro浏览器简单窗体",
      "title": "FBro 浏览器简单示例",
      "width": 960,
      "height": 680,
      "background": "#111827",
      "description": "创建一个 FBro 浏览器并采集网页标题与地址。",
      "designerBackend": "win32",
      "events": {
        "Loaded": "_FBro浏览器简单窗体_创建完毕"
      },
      "controls": [
        {
          "id": "browser-1",
          "type": "FBroBrowser",
          "name": "浏览器1",
          "content": "",
          "x": 10,
          "y": 10,
          "width": 920,
          "height": 620,
          "background": "#FFFFFF",
          "foreground": "#000000",
          "isEnabled": true,
          "visibility": "Visible",
          "properties": {
            "processMode": "in-process",
            "url": "https://baidu.com",
            "cacheDir": ".fbro/cache",
            "enableJs": true,
            "enableDevTools": true,
            "loadImages": true,
            "enableWebGL": true,
            "muteAudio": true,
            "proxyMode": "system"
          },
          "events": {
            "fbro.event.fbrohsinitevent.onloadingstatechange.93bb302cc72b": "浏览器1_加载状态改变"
          },
          "fontFamily": "Microsoft YaHei UI",
          "fontSize": 12,
          "fontBold": false,
          "fontItalic": false,
          "fontUnderline": false
        }
      ],
      "titleBarBackground": "#2D2D30",
      "titleBarForeground": "#CBD5E1",
      "menuBackground": "#ffffff",
      "menuForeground": "#000000",
      "menuFontFamily": "Microsoft YaHei UI",
      "menuFontSize": 11,
      "menuFontBold": false,
      "menuFontItalic": false,
      "menuFontUnderline": false,
      "cornerStyle": "rounded",
      "iconStyle": "lingbuilder",
      "borderStyle": "normal-resizable",
      "borderlessDraggable": false,
      "resizable": true,
      "maximizable": true,
      "windowFrame": {
        "preset": "system",
        "flags": 0,
        "resizeBorder": {
          "left": 6,
          "top": 6,
          "right": 6,
          "bottom": 6
        },
        "cornerRadius": 10
      }
    }
  ]
}