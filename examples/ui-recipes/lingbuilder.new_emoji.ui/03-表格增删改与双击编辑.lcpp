// 配方：表格（NE表格）列定义、行增删改与双击编辑
// 适用：订单/账号/资料列表这类需要行键与单元格编辑的界面。
// 要点：列与行都用「制表符分隔的 key=value」协议；追加行要给稳定 key；
//      跨事件操作用 通过标记文本获取NE表格 重新取引用，行数用 NE_EU_GetTableRowCount 读回。
包 表格增删改演示
使用 new_emoji原生界面库

类 演示窗口 : 窗口
公开
  整数型 订单序号 = 2
  逻辑型 双击编辑已开启 = 真

  事件 创建完毕()
    局部 NE表格 订单表格 = 控件_创建NE表格(当前窗口, 24, 60, 840, 360, "订单表格", "订单表格", 1)
    NE表格_设置列(订单表格, "title=订单编号\tkey=id\twidth=180\ntitle=客户\tkey=customer\twidth=240\ntitle=金额\tkey=amount\twidth=140")
    NE表格_设置行数据(订单表格, "c0=SO-001\tc1=灵码科技\tc2=1280.00")
    NE表格_添加行(订单表格, "c0=SO-002\tc1=云上商店\tc2=640.50")
    NE_EU_SetTableDoubleClickEdit(当前窗口, 订单表格, 1)
    局部 NE文本 统计 = 控件_创建NE文本(当前窗口, 24, 500, 620, 26, "共 2 行", "统计", 3)
    局部 NE按钮 追加按钮 = 控件_创建NE按钮(当前窗口, 24, 440, 160, 44, "➕ 追加一行", "追加", 11)
    局部 NE按钮 删除按钮 = 控件_创建NE按钮(当前窗口, 204, 440, 160, 44, "🗑 删除末行", "删除", 12)
    局部 NE按钮 清空按钮 = 控件_创建NE按钮(当前窗口, 384, 440, 160, 44, "🧹 清空", "清空", 13)
    局部 NE按钮 编辑按钮 = 控件_创建NE按钮(当前窗口, 564, 440, 200, 44, "✏️ 开/关双击编辑", "开关编辑", 14)
    NE_EU_SetButtonVariant(当前窗口, 追加按钮, 1)
    NE_EU_SetButtonVariant(当前窗口, 删除按钮, 3)
    NE_EU_SetButtonVariant(当前窗口, 清空按钮, 5)
    NE_EU_SetButtonVariant(当前窗口, 编辑按钮, 2)
    NE表格_绑定单元格编辑(订单表格, &单元格编辑完成)
    NE按钮_绑定被点击(追加按钮, &追加被点击)
    NE按钮_绑定被点击(删除按钮, &删除被点击)
    NE按钮_绑定被点击(清空按钮, &清空被点击)
    NE按钮_绑定被点击(编辑按钮, &开关编辑被点击)
  结束

  事件 追加被点击()
    局部 NE表格 订单表格 = 通过标记文本获取NE表格("订单表格")
    订单序号 = 订单序号 + 1
    NE表格_添加行(订单表格, "key=SO-00" + 到文本(订单序号) + "\tc0=追加行\tc1=新客户\tc2=99.90")
    局部 整数型 当前行数 = NE_EU_GetTableRowCount(当前窗口, 订单表格)
    局部 NE文本 统计 = 通过标记文本获取NE文本("统计")
    控件_设置文本(统计, "共 " + 到文本(当前行数) + " 行")
  结束

  事件 删除被点击()
    局部 NE表格 订单表格 = 通过标记文本获取NE表格("订单表格")
    局部 整数型 末行 = NE_EU_GetTableRowCount(当前窗口, 订单表格) - 1
    如果 (末行 >= 0)
      NE_EU_DeleteTableRow(当前窗口, 订单表格, 末行)
    如果结束
    局部 NE文本 统计 = 通过标记文本获取NE文本("统计")
    控件_设置文本(统计, "已删除末行")
  结束

  事件 清空被点击()
    局部 NE表格 订单表格 = 通过标记文本获取NE表格("订单表格")
    NE_EU_ClearTableRows(当前窗口, 订单表格)
    局部 NE文本 统计 = 通过标记文本获取NE文本("统计")
    控件_设置文本(统计, "共 0 行")
  结束

  事件 开关编辑被点击()
    局部 NE表格 订单表格 = 通过标记文本获取NE表格("订单表格")
    如果 (双击编辑已开启)
      双击编辑已开启 = 假
      NE_EU_SetTableDoubleClickEdit(当前窗口, 订单表格, 0)
    否则
      双击编辑已开启 = 真
      NE_EU_SetTableDoubleClickEdit(当前窗口, 订单表格, 1)
    如果结束
  结束

  事件 单元格编辑完成(整数型 行号, 整数型 列号, 整数型 动作, 文本型 文本)
    调试输出("单元格编辑", 行号, 列号, 动作, 文本)
  结束
结束类
