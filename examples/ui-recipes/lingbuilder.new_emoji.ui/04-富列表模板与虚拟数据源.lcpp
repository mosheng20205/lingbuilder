// 配方：富列表（NE富列表）模板 + 条目 + 选中 + 虚拟数据源
// 适用：需要自定义行内布局的任务列表、会话列表、商品卡列表。
// 要点：模板与条目的 JSON 用中文引号 “ ” 包裹整串（避免与内部英文双引号冲突）；
//      十万行级列表必须走 绑定虚拟数据源 + 设置虚拟行数据，禁止逐条 添加行。
包 富列表演示
使用 new_emoji原生界面库

类 演示窗口 : 窗口
公开
  事件 创建完毕()
    局部 NE富列表 任务列表 = 控件_创建NE富列表(当前窗口, 24, 60, 560, 420, "任务列表", "任务列表", 1)
    局部 整数型 模板结果 = NE富列表_设置模板(任务列表, “{"template":{"rowHeight":64,"nodes":[{"id":"name","type":"text","x":18,"y":10,"w":400,"h":24,"field":"name","size":15,"weight":600,"role":"primary"},{"id":"desc","type":"text","x":18,"y":34,"w":420,"h":18,"field":"desc","size":12,"role":"secondary"},{"id":"badge","type":"badge","x":470,"y":20,"w":80,"h":24,"field":"state","badgeType":2}]}}”)
    局部 整数型 条目结果 = NE富列表_设置条目(任务列表, “{"items":[{"key":"task-1","data":{"name":"🛠️ 编译 LingBuilder","desc":"MSVC 全部通过","state":"进行中"}},{"key":"task-2","data":{"name":"📦 发布安装包","desc":"在线模式打包","state":"排队"}},{"key":"task-3","data":{"name":"🌐 官网同步","desc":"命令查找页","state":"完成"}}]}”)
    调试输出("模板结果", 模板结果, "条目结果", 条目结果)
    NE富列表_设置选中键(任务列表, “["task-1"]”)
    NE富列表_绑定选择变化(任务列表, &选中变化)
    NE富列表_绑定项目点击(任务列表, &项目被点击)
    局部 NE按钮 虚拟按钮 = 控件_创建NE按钮(当前窗口, 610, 60, 260, 44, "切换十万行虚拟列表", "虚拟", 11)
    局部 NE按钮 更新按钮 = 控件_创建NE按钮(当前窗口, 610, 124, 260, 44, "更新首个条目", "更新", 12)
    NE按钮_绑定被点击(虚拟按钮, &虚拟被点击)
    NE按钮_绑定被点击(更新按钮, &更新被点击)
  结束

  事件 选中变化(文本型 选中键列表)
    调试输出("选中 " + 选中键列表)
  结束

  事件 项目被点击(文本型 事件数据)
    调试输出("项目点击 " + 事件数据)
  结束

  事件 虚拟被点击()
    局部 NE富列表 任务列表 = 通过标记文本获取NE富列表("任务列表")
    NE_EU_SetRichListVirtualItemCount(当前窗口, 任务列表, 100000)
    NE富列表_绑定虚拟数据源(任务列表, &虚拟数据源)
  结束

  事件 虚拟数据源(整数型 行号)
    NE富列表_设置虚拟行数据(“{"key":"virtual-row","data":{"name":"🧪 虚拟条目","desc":"按行号回填","state":"虚拟"}}”)
  结束

  事件 更新被点击()
    局部 NE富列表 任务列表 = 通过标记文本获取NE富列表("任务列表")
    NE富列表_更新条目(任务列表, "task-1", “{"key":"task-1","data":{"name":"编译 LingBuilder（已完成）","desc":"MSVC 全部通过","state":"完成"}}”)
  结束
结束类
