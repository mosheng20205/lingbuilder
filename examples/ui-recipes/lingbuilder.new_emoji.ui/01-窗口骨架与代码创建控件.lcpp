// 配方：new_emoji 窗口骨架 + 代码创建控件 + 标记文本查找
// 适用：整窗界面都在 .lcpp 里用 控件_创建NE* 创建，不写设计器布局。
// 项目模型要求：窗口 designerBackend="new-emoji"、controls=[]、events={"Loaded":"创建完毕"}；
//              显示与消息循环由生成器负责，源码里禁止调用 NE_运行消息循环。
// 要点：创建控件必须给「标记文本」；局部变量不跨事件存活，其他事件里用 通过标记文本获取NE* 重新取引用。
包 窗口骨架演示
使用 new_emoji原生界面库

类 演示窗口 : 窗口
公开
  整数型 计数 = 0

  事件 创建完毕()
    局部 NE文本 标题 = 控件_创建NE文本(当前窗口, 24, 24, 620, 30, "🧩 new_emoji 窗口骨架", "标题", 1)
    局部 NE文本 状态 = 控件_创建NE文本(当前窗口, 24, 260, 620, 26, "点击下方按钮累加计数", "状态", 2)
    局部 NE按钮 累加按钮 = 控件_创建NE按钮(当前窗口, 24, 150, 180, 44, "➕ 计数加一", "累加", 11)
    局部 NE按钮 重置按钮 = 控件_创建NE按钮(当前窗口, 224, 150, 180, 44, "♻️ 归零", "重置", 12)
    NE_EU_SetButtonVariant(当前窗口, 累加按钮, 1)
    NE_EU_SetButtonVariant(当前窗口, 重置按钮, 5)
    NE按钮_绑定被点击(累加按钮, &累加被点击)
    NE按钮_绑定被点击(重置按钮, &重置被点击)
    控件_设置可见(重置按钮, 假)
  结束

  事件 累加被点击()
    计数 = 计数 + 1
    局部 NE文本 状态 = 通过标记文本获取NE文本("状态")
    控件_设置文本(状态, "已点击 " + 到文本(计数) + " 次")
    局部 NE按钮 重置按钮 = 通过标记文本获取NE按钮("重置")
    控件_设置可见(重置按钮, 真)
  结束

  事件 重置被点击()
    计数 = 0
    局部 NE文本 状态 = 通过标记文本获取NE文本("状态")
    控件_设置文本(状态, "已归零")
    局部 NE按钮 重置按钮 = 通过标记文本获取NE按钮("重置")
    控件_设置可见(重置按钮, 假)
  结束
结束类
