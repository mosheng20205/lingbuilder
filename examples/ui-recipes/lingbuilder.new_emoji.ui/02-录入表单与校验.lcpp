// 配方：录入表单（输入框 + 选择器 + 数字输入框 + 复选框）与提交校验
// 适用：需要用户录入并回填结果的信息卡/设置面板。
// 要点：读取统一走通用命令 控件_取文本 / 控件_取数值 / 控件_取选择项 / 控件_取勾选；
//      选择器选项用竖线分隔；消息框结果处理器参数必须写显式中文类型。
包 表单录入演示
使用 new_emoji原生界面库

类 演示窗口 : 窗口
公开
  事件 创建完毕()
    局部 NE文本 姓名标签 = 控件_创建NE文本(当前窗口, 24, 30, 110, 28, "姓名", "姓名标签", 1)
    局部 NE输入框 姓名输入 = 控件_创建NE输入框(当前窗口, 150, 26, 280, 40, "", "姓名输入", 2)
    局部 NE选择器 城市选择 = 控件_创建NE选择器(当前窗口, 150, 78, 280, 40, "选择城市", "城市选择", 3)
    NE选择器_设置选项(城市选择, "杭州 🌸|上海 🏙️|北京 🏛️")
    控件_设置选择项(城市选择, 0)
    局部 NE数字输入框 数量输入 = 控件_创建NE数字输入框(当前窗口, 150, 130, 280, 40, "1", "数量输入", 4)
    局部 NE复选框 加急勾选 = 控件_创建NE复选框(当前窗口, 150, 182, 220, 34, "需要加急", "加急勾选", 5)
    控件_设置勾选(加急勾选, 真)
    局部 NE按钮 提交按钮 = 控件_创建NE按钮(当前窗口, 150, 228, 180, 44, "✅ 提交", "提交", 11)
    局部 NE文本 结果 = 控件_创建NE文本(当前窗口, 150, 292, 520, 28, "等待提交", "结果", 6)
    NE按钮_绑定被点击(提交按钮, &提交被点击)
  结束

  事件 提交被点击()
    局部 NE输入框 姓名输入 = 通过标记文本获取NE输入框("姓名输入")
    局部 NE数字输入框 数量输入 = 通过标记文本获取NE数字输入框("数量输入")
    局部 NE选择器 城市选择 = 通过标记文本获取NE选择器("城市选择")
    局部 NE复选框 加急勾选 = 通过标记文本获取NE复选框("加急勾选")
    局部 NE文本 结果 = 通过标记文本获取NE文本("结果")
    局部 文本型 姓名 = 控件_取文本(姓名输入)
    局部 整数型 数量 = 控件_取数值(数量输入)
    局部 整数型 城市序号 = 控件_取选择项(城市选择)
    局部 逻辑型 加急 = 控件_取勾选(加急勾选)
    如果 (数量 <= 0)
      控件_设置文本(结果, "⚠️ 数量必须大于 0")
    否则
      控件_设置文本(结果, "已提交：" + 姓名 + " 数量 " + 到文本(数量) + " 城市序号 " + 到文本(城市序号))
      NE_显示消息框(当前窗口, "提交完成", "加急：" + 到文本(加急), "知道了", &消息框已关闭)
    如果结束
  结束

  事件 消息框已关闭(整数型 结果编号, 整数型 结果值)
    调试输出("消息框关闭", 结果编号, 结果值)
  结束
结束类
