包 缓冲队列正则演示
使用 Win32窗口基础模块
使用 通用控件模块
使用 多线程模块
使用 正则表达式模块
使用 缓冲区模块
使用 数组操作模块
使用 字节与十六进制模块

类 缓冲区演示窗口 : 窗口
公开
  事件 _缓冲区演示窗口_创建完毕()
    控件_设置文本(状态标签, "正在执行标准库验证…")
    局部 长整数型 缓冲 = 缓冲区_创建(64)
    局部 线程队列 队列 = 队列_创建(10)
    局部 线程队列 队列二 = 队列_创建(4)
    局部 长整数型 数值回读 = 0
    局部 文本型 文本回读 = ""
    局部 长整数型 剩余字节 = 0
    局部 文本型 全部匹配 = ""
    局部 文本型 分组值 = ""
    局部 整数型 匹配位置 = 0
    局部 文本型 出队值 = ""
    局部 逻辑型 出队有效 = 假
    局部 整数型 队列剩余 = 0
    局部 文本型 有效说明 = "无效"
    局部 文本型 汇总 = ""
    局部 长整数型 报告 = 0
    局部 文本型 分片[]
    局部 整数型 分段数 = 0
    局部 文本型 分片一 = ""
    局部 整数型 倒找位 = 0
    局部 文本型 替换结果 = ""
    局部 文本型 删空结果 = ""
    局部 文本型 半角结果 = ""
    局部 文本型 重复结果 = ""
    局部 文本型 插入结果 = ""
    局部 长整数型 整数回读 = 0
    局部 字节集 原始数据 = 字节集_十六进制解码("00AA0BAA0C")
    局部 字节集 寻找目标 = 字节集_十六进制解码("AA")
    局部 整数型 寻找位 = 0
    局部 整数型 寻找位二 = 0
    局部 字节集 替换数据 = 字节集_十六进制解码("FF")
    局部 整数型 替换字节 = 0
    局部 字节集 插入数据 = 字节集_十六进制解码("EE")
    局部 整数型 插入字节 = 0
    局部 字节集 删除数据 = 字节集_十六进制解码("")
    局部 整数型 删除字节 = 0
    局部 字节集 出队字节 = 字节集_十六进制解码("")
    局部 长整数型 字节一位 = 0
    局部 字节集 目标竖线 = 字节集_十六进制解码("7C")
    局部 整数型 缓冲寻找位 = 0
    局部 文本型 汇总二 = ""

    缓冲区_写整数(缓冲, 20260913, 8, 假)
    缓冲区_写文本(缓冲, "|灵码|缓冲区验证")
    缓冲区_重置读取(缓冲)
    数值回读 = 缓冲区_读整数(缓冲, 8, 假)
    文本回读 = 缓冲区_读文本(缓冲, -1)
    剩余字节 = 缓冲区_取剩余(缓冲)

    全部匹配 = 正则_取所有匹配("a1b22c333", "[0-9]+", ",")
    分组值 = 正则_取分组("2026-09-13", "([0-9]+)-([0-9]+)-([0-9]+)", 2)
    匹配位置 = 正则_取匹配位置("a1b22c333", "[0-9]+", 1)

    队列_入队(队列, "第一条", 0)
    队列_入队(队列, "第二条", 0)
    出队值 = 队列_出队(队列, 100)
    出队有效 = 队列_上次出队是否成功()
    队列剩余 = 队列_取长度(队列)
    队列_销毁(队列)

    分段数 = 文本_分割("a,b,c", ",", 分片)
    分片一 = 数组_取成员(分片, 1)
    倒找位 = 文本_倒找("aXbXcX", "X")
    替换结果 = 文本_替换子文本("aXbXcX", "X", "-", 0, 2)
    删空结果 = 文本_删全部空白(" a b ")
    半角结果 = 文本_到半角("ＡＢＣ１２３")
    重复结果 = 文本_重复("ab", 3)
    插入结果 = 文本_插入("acd", 1, "b")

    队列_入队整数(队列二, 20260913, 0)
    整数回读 = 队列_出队整数(队列二, 100)
    队列_入队字节集(队列二, 原始数据, 0)
    出队字节 = 队列_出队字节集(队列二, 100)
    字节一位 = 字节集_取字节(出队字节, 1)
    队列_销毁(队列二)

    寻找位 = 字节集_寻找(原始数据, 寻找目标, 0)
    寻找位二 = 字节集_寻找(原始数据, 寻找目标, 2)
    替换数据 = 字节集_替换(原始数据, 寻找目标, 替换数据, 0)
    替换字节 = 字节集_取字节(替换数据, 1)
    插入数据 = 字节集_插入(原始数据, 0, 插入数据)
    插入字节 = 字节集_取字节(插入数据, 0)
    删除数据 = 字节集_删除(原始数据, 0, 2)
    删除字节 = 字节集_取字节(删除数据, 0)
    缓冲寻找位 = 缓冲区_寻找(缓冲, 目标竖线, 0)

    如果 (出队有效)
      有效说明 = "有效"
    如果结束

    汇总 = 格式化文本("数值回读={} 文本回读={} 剩余={} | 正则全部={} 分组={} 位置={} | 出队={} 有效={} 剩余={}", 数值回读, 文本回读, 剩余字节, 全部匹配, 分组值, 匹配位置, 出队值, 有效说明, 队列剩余)
    汇总二 = 格式化文本("分段={} 分片一={} 倒找={} 替换={} 删空={} 半角={} 重复={} 插入={} | 整数回读={} 字节一={} 寻找={} 寻找二={} 替换字节={} 插入字节={} 删除字节={} 缓冲寻找={}", 分段数, 分片一, 倒找位, 替换结果, 删空结果, 半角结果, 重复结果, 插入结果, 整数回读, 字节一位, 寻找位, 寻找位二, 替换字节, 插入字节, 删除字节, 缓冲寻找位)
    控件_设置文本(结果标签, 汇总二)
    控件_添加项目(结果列表, 汇总)
    控件_添加项目(结果列表, 汇总二)

    报告 = 缓冲区_创建(0)
    缓冲区_写文本(报告, 汇总)
    缓冲区_写文本(报告, "@@")
    缓冲区_写文本(报告, 汇总二)
    缓冲区_保存文件(报告, "verification-report.txt")
    缓冲区_销毁(缓冲)
    缓冲区_销毁(报告)
  结束
结束类
