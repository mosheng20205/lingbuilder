包 EdgeView读取响应演示
使用 Win32窗口基础模块
使用 EdgeView浏览器模块
使用 字节与十六进制模块
使用 JSON数据模块

类 MainWindow : 公开 窗口
私有:
    长整数型 当前请求句柄 = 0
    长整数型 当前响应句柄 = 0
    文本型 当前请求句柄文本 = ""
    文本型 当前响应句柄文本 = ""
    文本型 当前响应地址 = ""
    整数型 当前状态码 = 0
    文本型 当前原因 = ""

公开:
    构造()
    结束

    事件 _MainWindow_创建完毕()
        局部 整数型 请求绑定结果 = 0
        局部 整数型 响应绑定结果 = 0
        请求绑定结果 = EdgeView_绑定控件事件(演示浏览器, "Web资源请求", &提供演示响应)
        响应绑定结果 = EdgeView_绑定控件事件(演示浏览器, "Web资源响应收到", &收到Web资源响应)
        如果 (请求绑定结果 == 1 && 响应绑定结果 == 1)
            控件_设置文本(运行状态, "事件已绑定，正在生成并读取本地 JSON 响应...")
            开始读取演示()
        否则
            控件_设置文本(运行状态, "事件绑定失败：读取响应正文需要 WebView2 Runtime 150 或更高版本。")
        如果结束
    结束

    空 开始读取演示()
        控件_设置文本(响应元数据, "等待 Web资源响应收到 事件...")
        控件_设置文本(响应正文, "等待 EdgeView资源_读响应正文异步...")
        如果 (EdgeView导航_请求(演示浏览器, "https://demo.lingbuilder.local/api/response", "GET", "Cache-Control: no-store", "") == 0)
            控件_设置文本(运行状态, "发起导航失败，请确认 EdgeView 控件已经创建。")
        如果结束
    结束

    事件 _重新读取按钮_被单击()
        控件_设置文本(运行状态, "正在重新请求并读取响应...")
        开始读取演示()
    结束

    // 仅作为离线、可重复的响应源；正文读取发生在另一个响应事件处理器中。
    事件 提供演示响应()
        局部 文本型 地址 = ""
        局部 长整数型 请求事件句柄 = 0
        地址 = EdgeView事件_取字段(演示浏览器, "uri")
        如果 (地址 == "https://demo.lingbuilder.local/api/response")
            请求事件句柄 = 到整数(EdgeView事件_取字段(演示浏览器, "requestHandle"))
            EdgeView资源_设置事件响应文本(演示浏览器, 200, "OK", "Content-Type: application/json; charset=utf-8\r\nCache-Control: no-store", "{\"message\":\"LingBuilder 已读取响应正文\",\"source\":\"Web资源响应收到\",\"language\":\"中文\",\"ok\":true}")
            如果 (请求事件句柄 != 0)
                EdgeView对象_释放(请求事件句柄)
            如果结束
        如果结束
    结束

    事件 收到Web资源响应()
        局部 长整数型 正文任务ID = 0
        当前响应地址 = EdgeView事件_取字段(演示浏览器, "uri")
        如果 (当前响应地址 == "https://demo.lingbuilder.local/api/response")
            当前请求句柄文本 = EdgeView事件_取字段(演示浏览器, "requestHandle")
            当前响应句柄文本 = EdgeView事件_取字段(演示浏览器, "responseHandle")
            当前状态码 = 到整数(EdgeView事件_取字段(演示浏览器, "statusCode"))
            当前原因 = EdgeView事件_取字段(演示浏览器, "reason")
            当前请求句柄 = 到整数(当前请求句柄文本)
            当前响应句柄 = 到整数(当前响应句柄文本)

            控件_设置文本(响应元数据, 格式化文本("requestHandle={}\r\nresponseHandle={}\r\nURL={}\r\n状态码={}\r\n原因={}", 当前请求句柄文本, 当前响应句柄文本, 当前响应地址, 当前状态码, 当前原因))
            控件_设置文本(运行状态, "已取得响应元数据，正在异步读取正文流...")
            正文任务ID = EdgeView资源_读响应正文异步(演示浏览器, 当前响应句柄, 1048576, &响应正文读取完成)
            如果 (正文任务ID == 0)
                控件_设置文本(运行状态, "正文读取任务创建失败。该接口需要 WebView2 Runtime 150 或更高版本。")
                释放响应句柄()
            如果结束
        如果结束
    结束

    事件 响应正文读取完成()
        局部 长整数型 任务ID = 0
        局部 整数型 任务状态 = 0
        局部 整数型 正文字节数 = 0
        局部 文本型 任务结果 = ""
        局部 文本型 正文字节数文本 = ""
        局部 文本型 正文十六进制 = ""
        局部 文本型 解码正文 = ""
        任务ID = EdgeView任务_取当前任务ID()
        任务状态 = EdgeView任务_取状态(任务ID)
        如果 (任务状态 != 1)
            控件_设置文本(响应正文, EdgeView任务_取错误(任务ID))
            控件_设置文本(运行状态, "正文读取失败，错误信息已显示。")
        否则
            任务结果 = EdgeView任务_取结果(任务ID)
            正文字节数文本 = JSON_取文本(任务结果, "byteCount")
            正文字节数 = 到整数(正文字节数文本)
            正文十六进制 = JSON_取文本(任务结果, "hex")
            解码正文 = 字节_十六进制转文本(正文十六进制)
            控件_设置文本(响应正文, 解码正文)
            控件_设置文本(运行状态, 格式化文本("读取完成：HTTP {} {}，正文 {} 字节；内容={}", 当前状态码, 当前原因, 正文字节数, 解码正文))
            调试输出(格式化文本("[EdgeView读取响应] requestHandle={} responseHandle={} URL={} status={} reason={} body={}", 当前请求句柄文本, 当前响应句柄文本, 当前响应地址, 当前状态码, 当前原因, 解码正文))
        如果结束
        EdgeView任务_释放(任务ID)
        释放响应句柄()
    结束

    空 释放响应句柄()
        如果 (当前响应句柄 != 0)
            EdgeView对象_释放(当前响应句柄)
            当前响应句柄 = 0
        如果结束
        如果 (当前请求句柄 != 0)
            EdgeView对象_释放(当前请求句柄)
            当前请求句柄 = 0
        如果结束
    结束
结束类
