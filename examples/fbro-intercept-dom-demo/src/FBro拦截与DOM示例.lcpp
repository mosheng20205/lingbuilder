包 FBro拦截与DOM示例
使用 Win32窗口基础模块
使用 FBro指纹浏览器模块
使用 FBro事件模块
使用 FBro会话模块
使用 FBro高级网络模块
使用 FBro自动化模块
使用 FBro受管对象模块


类 FBro拦截与DOM窗体 : 窗口
  事件 _FBro拦截与DOM窗体_创建完毕()
    FBro_绑定事件(浏览器1, "浏览器创建完成", &浏览器1_创建完成)
    FBro_绑定事件(浏览器1, "加载完成", &浏览器1_加载完成)
    FBro_绑定事件(浏览器1, "加载失败", &浏览器1_加载失败)
    FBro_绑定事件(浏览器1, "初始化WebSocket客户端创建", &钩子_客户端创建)
    FBro_绑定事件(浏览器1, "初始化WebSocket客户端连接", &钩子_客户端连接)
    FBro_绑定事件(浏览器1, "初始化WebSocket客户端发送", &钩子_客户端发送)
    FBro_绑定事件(浏览器1, "初始化WebSocket客户端消息", &钩子_客户端消息)
    FBro_绑定事件(浏览器1, "本地服务器WebSocket已连接", &服务器WS已连接)
    FBro_绑定事件(浏览器1, "本地服务器WebSocket消息到达", &服务器WS消息)
    调试输出("TEST 事件绑定完成")
  结束

  事件 浏览器1_创建完成()
    如果 (已配置服务器 == 假)
      已配置服务器 = 真
      服务器句柄 = FBro服务器_创建(浏览器1, "127.0.0.1", 8899, 16)
      调试输出("TEST 服务器句柄=" + 到文本(服务器句柄))
      FBro_导航(浏览器1, "data:text/html;charset=utf-8,%3Chtml%3E%3Chead%3E%3Ctitle%3Elbtest%3C%2Ftitle%3E%3C%2Fhead%3E%3Cbody%3E%3Cinput%20id%3D%22t1%22%20value%3D%22abc%22%3E%3Cp%20id%3D%22p1%22%3Ehello%20world%3C%2Fp%3E%3C%2Fbody%3E%3C%2Fhtml%3E")
    如果结束
  结束

  事件 浏览器1_加载失败()
    调试输出("TEST 加载失败：" + FBro_取地址(浏览器1))
  结束

  事件 浏览器1_加载完成()
    局部 文本型 当前地址 = ""
    当前地址 = FBro_取地址(浏览器1)
    测试阶段 = 测试阶段 + 1
    调试输出("TEST 加载完成 阶段" + 到文本(测试阶段) + "：" + 当前地址)
    如果 (测试阶段 == 2)
      跑DOM与上下文测试()
      FBro_导航(浏览器1, "https://www.qvdv.net/tools/qvdv-websocket.html")
    如果结束
    如果 (测试阶段 == 3)
      跑WS注入()
    如果结束
  结束

  空 跑DOM与上下文测试()
    局部 长整数型 主框架 = 0
    局部 整数型 赋值结果 = 0
    局部 文本型 回读值 = ""
    局部 长整数型 快照 = 0
    局部 长整数型 快照2 = 0
    局部 文本型 属性值 = ""
    局部 长整数型 源码缓冲 = 0
    局部 文本型 源码文本 = ""
    局部 长整数型 文本缓冲 = 0
    局部 文本型 可见文本 = ""
    局部 长整数型 上下文 = 0
    主框架 = FBro框架_取主框架(浏览器1)
    调试输出("TEST ========== 阶段A 填表回归 ==========")
    赋值结果 = FBro填表_赋值(主框架, "#t1", 0, "lingbuilder")
    调试输出("TEST 填表赋值返回=" + 到文本(赋值结果))
    回读值 = FBro填表_取值(主框架, "#t1", 0)
    如果 (回读值 != "")
      调试输出("TEST-PASS 填表取值回读=" + 回读值)
    如果结束
    如果 (回读值 == "")
      调试输出("TEST-FAIL 填表回读为空")
    如果结束
    调试输出("TEST ========== 阶段B 取源码取文本 ==========")
    源码缓冲 = FBro框架_取源码(主框架)
    源码文本 = FBro缓冲_转文本(源码缓冲)
    如果 (源码文本 != "")
      调试输出("TEST-PASS 取源码=" + 源码文本)
    如果结束
    如果 (源码文本 == "")
      调试输出("TEST-FAIL 取源码为空")
    如果结束
    文本缓冲 = FBro框架_取文本(主框架)
    可见文本 = FBro缓冲_转文本(文本缓冲)
    如果 (可见文本 != "")
      调试输出("TEST-PASS 取文本=" + 可见文本)
    如果结束
    如果 (可见文本 == "")
      调试输出("TEST-FAIL 取文本为空")
    如果结束
    调试输出("TEST ========== 阶段C DOM遍历 ==========")
    快照 = FBro框架_遍历DOM(主框架, 0, 200)
    调试输出("TEST 遍历快照句柄=" + 到文本(快照))
    如果 (快照 > 0)
      调试输出("TEST-PASS DOM快照标题=" + FBro遍历_取标题(快照))
      调试输出("TEST DOM节点总数=" + 到文本(FBro遍历_取节点数(快照)))
      调试输出("TEST-PASS 首节点名称=" + FBro遍历_取节点名称(快照, 0))
      调试输出("TEST BODY属性个数=" + 到文本(FBro遍历_取节点属性数(快照, 0)))
    如果结束
    如果 (快照 == 0)
      调试输出("TEST-FAIL DOM遍历返回空快照")
    如果结束
    调试输出("TEST ========== 阶段D 按路径写回 ==========")
    局部 整数型 写回结果 = 0
    写回结果 = FBro遍历_按路径设属性(主框架, "[]", "data-lb", "ok")
    调试输出("TEST 按路径设属性返回=" + 到文本(写回结果))
    如果 (写回结果 == 1)
      快照2 = FBro框架_遍历DOM(主框架, 0, 200)
      属性值 = FBro遍历_取节点属性(快照2, 0, "data-lb")
      如果 (属性值 == "ok")
        调试输出("TEST-PASS 按路径写回回读一致")
      如果结束
      如果 (属性值 != "ok")
        调试输出("TEST-FAIL 写回回读=" + 属性值)
      如果结束
    如果结束
    调试输出("TEST ========== 阶段E 独立上下文 ==========")
    上下文 = FBro会话_创建上下文("{\"cachePath\":\"TestData\",\"persistSessionCookies\":true}")
    调试输出("TEST 上下文句柄=" + 到文本(上下文))
    如果 (上下文 > 0)
      调试输出("TEST-PASS 创建上下文")
    如果结束
    如果 (上下文 == 0)
      调试输出("TEST-FAIL 创建上下文返回0")
    如果结束
    调试输出("TEST 使用上下文重建=" + 到文本(FBro会话_使用上下文重建(浏览器1, 上下文)))
  结束

  空 跑WS注入()
    局部 长整数型 主框架 = 0
    主框架 = FBro框架_取主框架(浏览器1)
    调试输出("TEST ========== 阶段F WS服务器回环+拦截触发 ==========")
    FBro框架_执行JS(主框架, "eval(atob('dmFyIGxid3M9bmV3IFdlYlNvY2tldCgnd3NzOi8vd3d3LnF2ZHYubmV0L1dlYnNvY2tldCcpO2xid3Mub25vcGVuPWZ1bmN0aW9uKCl7bGJ3cy5zZW5kKCdoZWxsby1mcm9tLWxiJyk7fTs='))", "test", 0)
    FBro框架_执行JS(主框架, "eval(atob('dmFyIGxid3MyPW5ldyBXZWJTb2NrZXQoJ3dzOi8vMTI3LjAuMC4xOjg4OTkvbGJ0ZXN0Jyk7bGJ3czIub25tZXNzYWdlPWZ1bmN0aW9uKGUpe2xid3MyLnNlbmQoJ2JhY2s6JytlLmRhdGEpO307'))", "test", 0)
    调试输出("TEST 已注入两条页面WS连接脚本")
  结束

  事件 钩子_客户端创建()
    局部 文本型 客户端句柄 = ""
    客户端句柄 = FBro_取事件字段(浏览器1, "websocket")
    调试输出("TEST-PASS 拦截到WS客户端创建，句柄=" + 客户端句柄)
  结束

  事件 钩子_客户端连接()
    局部 文本型 客户端句柄 = ""
    局部 文本型 连接地址 = ""
    客户端句柄 = FBro_取事件字段(浏览器1, "websocket")
    连接地址 = FBroWS客户端_取地址(1)
    调试输出("TEST-PASS 拦截到WS连接：" + 连接地址)
    FBroWS客户端_发送文本(1, "direct-send")
  结束

  事件 钩子_客户端发送()
    局部 文本型 数据缓冲 = ""
    数据缓冲 = FBro_取事件字段(浏览器1, "data")
    调试输出("TEST 拦截到页面WS发送，数据缓冲=" + 数据缓冲)
    FBro_设置事件响应JSON(浏览器1, "{\"data\":\"dGFtcGVyZWQtYnktbGI=\",\"size\":14}")
    调试输出("TEST-PASS 已篡改发送数据为 tampered-by-lb")
  结束

  事件 钩子_客户端消息()
    局部 文本型 数据缓冲 = ""
    局部 长整数型 缓冲句柄 = 0
    局部 文本型 消息原文 = ""
    数据缓冲 = FBro_取事件字段(浏览器1, "data")
    缓冲句柄 = 到整数(数据缓冲)
    消息原文 = FBro缓冲_转文本(缓冲句柄)
    局部 文本型 数据大小 = FBro_取事件字段(浏览器1, "size")
    调试输出("TEST 拦截到WS接收消息 size=" + 数据大小 + " 内容=" + 消息原文)
    如果 (消息原文 == "tampered-by-lb")
      调试输出("TEST-PASS 篡改写回全链路验证")
    如果结束
    如果 (消息原文 == "direct-send")
      调试输出("TEST-PASS WS客户端_发送文本直达")
    如果结束
  结束

  事件 服务器WS已连接()
    调试输出("TEST-PASS 服务器WS连接，连接ID=" + FBro_取事件字段(浏览器1, "connectionId"))
    FBro服务器_发送WebSocket文本(服务器句柄, 1, "echo-test")
  结束

  事件 服务器WS消息()
    局部 文本型 消息原文 = ""
    消息原文 = FBro_取事件字段(浏览器1, "text")
    调试输出("TEST 服务器收到WS消息：" + 消息原文)
    如果 (消息原文 == "back:echo-test")
      调试输出("TEST-PASS 服务器WS文本回环")
    如果结束
  结束
结束类
