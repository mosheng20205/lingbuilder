{
  "project": {
    "schemaVersion": 2,
    "id": "fbro-intercept-dom-demo",
    "name": "FBro 拦截与 DOM 遍历示例",
    "windows": [
      {
        "id": "main-window",
        "fileName": "FBro拦截与DOM窗体.xml",
        "className": "FBro拦截与DOM窗体",
        "title": "FBro 拦截与 DOM 遍历示例",
        "width": 1280,
        "height": 800,
        "background": "#111827",
        "description": "演示 WebSocket 拦截闭环、内嵌服务器、DOM 遍历快照与独立 RequestContext。",
        "events": {
          "Loaded": "_FBro拦截与DOM窗体_创建完毕"
        },
        "controls": [
          {
            "id": "browser-1",
            "type": "FBroBrowser",
            "name": "浏览器1",
            "content": "",
            "x": 20,
            "y": 20,
            "width": 1240,
            "height": 740,
            "background": "#FFFFFF",
            "foreground": "#000000",
            "isEnabled": true,
            "visibility": "Visible",
            "properties": {
              "processMode": "in-process",
              "url": "about:blank",
              "enableJs": true,
              "enableDevTools": true,
              "loadImages": true,
              "enableWebGL": true,
              "muteAudio": true,
              "proxyMode": "system",
              "fingerprintProfile": "{\"enableWebsocketClientHook\":true}"
            },
            "events": {
              "加载完成": "浏览器1_加载完成"
            }
          }
        ]
      }
    ]
  },
  "run": false,
  "approved": true
}
