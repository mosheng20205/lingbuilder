{
  "schemaVersion": 2,
  "id": "dll-module-demo",
  "name": "DLL模块演示",
  "windows": [
    {
      "id": "dll-demo-window",
      "fileName": "DllDemo.xml",
      "className": "演示窗口",
      "title": "演示数学 DLL 调用",
      "width": 520,
      "height": 220,
      "background": "#1E1E24",
      "description": "调用演示数学 DLL 模块的三条中文命令，把结果写入窗口标签并落盘验证。",
      "events": {
        "Loaded": "_演示窗口_创建完毕"
      },
      "controls": [
        {
          "id": "result-label",
          "type": "Label",
          "name": "结果标签",
          "content": "就绪：等待调用演示数学 DLL",
          "x": 20,
          "y": 40,
          "width": 470,
          "height": 30,
          "fontSize": 14,
          "background": "transparent",
          "foreground": "#4FC3F7",
          "isEnabled": true,
          "visibility": "Visible",
          "fontFamily": "Microsoft YaHei UI",
          "fontBold": false,
          "fontItalic": false,
          "fontUnderline": false,
          "properties": {
            "staticStyle": "text",
            "textAlign": "left",
            "imageSource": "",
            "toolTip": "",
            "toolTipDelay": 500
          }
        }
      ],
      "titleBarBackground": "#2D2D30",
      "titleBarForeground": "#CBD5E1",
      "menuBackground": "#ffffff",
      "menuForeground": "#000000",
      "menuFontFamily": "Microsoft YaHei UI",
      "menuFontSize": 11,
      "menuFontBold": false,
      "menuFontItalic": false,
      "menuFontUnderline": false,
      "cornerStyle": "rounded",
      "iconStyle": "lingbuilder",
      "borderStyle": "normal-resizable",
      "borderlessDraggable": false,
      "resizable": true,
      "maximizable": true,
      "windowFrame": {
        "preset": "system",
        "flags": 0,
        "resizeBorder": {
          "left": 6,
          "top": 6,
          "right": 6,
          "bottom": 6
        },
        "cornerRadius": 10
      }
    }
  ],
  "resources": []
}