包 CEF3CLI测试
使用 Win32窗口基础模块
使用 CEF3浏览器模块

类 CEF3测试窗体 : 窗口
公开
  构造()
  结束

  事件 _CEF3测试窗体_创建完毕()
    CEF3_绑定事件("浏览器1", "加载完成", &浏览器1_加载完成)
    CEF3_绑定事件("浏览器1", "加载状态改变", &浏览器1_加载状态改变)
    CEF3_绑定事件("浏览器2", "加载完成", &浏览器2_加载完成)
    CEF3_绑定事件("浏览器1", "标题被改变", &浏览器1_标题改变)
    CEF3_绑定事件("浏览器1", "控制台消息", &浏览器1_控制台消息)
    CEF3_绑定事件("浏览器1", "新窗口打开前", &浏览器1_新窗口打开前)
    CEF3_导航("浏览器1", "https://www.baidu.com")
    CEF3_导航("浏览器2", "https://www.bing.com")
    调试输出("两个 CEF3 浏览器已开始导航")
  结束

  事件 浏览器1_加载完成()
    @ 调试输出((L"事件回调：浏览器1加载完成 地址=" + CEF3_取地址(L"浏览器1")).c_str());
  结束

  事件 浏览器1_加载状态改变()
    如果 (CEF3_是否加载中("浏览器1") == 0)
      调试输出("JavaScript document.title JSON：", CEF3_执行JS("浏览器1", "document.title"))
    如果结束
  结束

  事件 浏览器2_加载完成()
    @ 调试输出((L"事件回调：浏览器2加载完成 地址=" + CEF3_取地址(L"浏览器2")).c_str());
  结束

  事件 浏览器1_标题改变()
    @ 调试输出((L"事件回调：浏览器1标题=" + CEF3_取标题(L"浏览器1")).c_str());
  结束

  事件 浏览器1_控制台消息()
    调试输出("CEF 控制台：", CEF3_取事件字段("浏览器1", "message"))
  结束

  事件 浏览器1_新窗口打开前()
    调试输出("已拦截新窗口：", CEF3_取事件字段("浏览器1", "url"))
    CEF3_设置事件结果("浏览器1", 2)
  结束
结束类
