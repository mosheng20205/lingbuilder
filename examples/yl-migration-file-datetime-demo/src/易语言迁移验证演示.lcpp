包 易语言迁移验证演示
使用 Win32窗口基础模块
使用 通用控件模块
使用 文件目录模块
使用 文本处理模块
使用 日期时间模块
使用 数学与随机模块
使用 字节与十六进制模块
使用 数组操作模块

类 易语言迁移演示窗口 : 窗口
公开
  事件 _易语言迁移演示窗口_创建完毕()
    控件_设置文本(状态标签, "正在执行易语言迁移命令族验证…")

    局部 文本型 报告文件 = "yl-verification-report.txt"
    局部 文本型 数据文件 = "yl-demo-data.txt"
    局部 文本型 二进制文件 = "yl-demo-data2.bin"

    局部 文件号 报告
    报告 = 文件_打开(报告文件, 4, 1)

    局部 文本型 汇报 = ""
    局部 文本型 文本二 = ""
    局部 整数型 标记 = 0
    局部 文件号 号
    局部 长整数型 数值一 = 0
    局部 文本型 文本一 = ""
    局部 逻辑型 布尔一 = 假
    局部 字节集 数据块 = 字节集_从文本("")

    文件_写入文本(数据文件, "")
    号 = 文件_打开(数据文件, 6, 1)
    汇报 = 格式化文本("A打开={}", 号)
    文件_写文本行(报告, 汇报)

    布尔一 = 文件_写文本行(号, "第一行内容A")
    标记 = 0
    如果 (布尔一)
      标记 = 1
    如果结束
    汇报 = 格式化文本("A写文本行={}", 标记)
    文件_写文本行(报告, 汇报)

    布尔一 = 文件_写文本行(号, "第二行内容B")
    标记 = 0
    如果 (布尔一)
      标记 = 1
    如果结束
    汇报 = 格式化文本("A写文本行二={}", 标记)
    文件_写文本行(报告, 汇报)

    数值一 = 文件_取长度(号)
    汇报 = 格式化文本("A取长度={}", 数值一)
    文件_写文本行(报告, 汇报)

    布尔一 = 文件_移到文件首(号)
    文本一 = 文件_读入一行(号)
    汇报 = 格式化文本("A读入一行={}", 文本一)
    文件_写文本行(报告, 汇报)

    标记 = 1
    布尔一 = 文件_是否在文件尾(号)
    如果 (布尔一)
      标记 = 0
    如果结束
    汇报 = 格式化文本("A未到尾={}", 标记)
    文件_写文本行(报告, 汇报)

    数值一 = 文件_取读写位置(号)
    汇报 = 格式化文本("A读一行后位置={}", 数值一)
    文件_写文本行(报告, 汇报)

    文本一 = 文件_读入文本(号, -1)
    数值一 = 字节_UTF8长度(文本一)
    汇报 = 格式化文本("A余读长度={}", 数值一)
    文件_写文本行(报告, 汇报)

    标记 = 0
    布尔一 = 文件_是否在文件尾(号)
    如果 (布尔一)
      标记 = 1
    如果结束
    汇报 = 格式化文本("A已到尾={}", 标记)
    文件_写文本行(报告, 汇报)

    数值一 = 文件_取读写位置(号)
    汇报 = 格式化文本("A读写位置={}", 数值一)
    文件_写文本行(报告, 汇报)

    布尔一 = 文件_移动读写位置(号, 0, 1)
    文本一 = 文件_读入文本(号, 9)
    汇报 = 格式化文本("A读入定长={}", 文本一)
    文件_写文本行(报告, 汇报)

    布尔一 = 文件_移动读写位置(号, 0, 1)
    布尔一 = 文件_插入文本(号, "头插-")
    标记 = 0
    如果 (布尔一)
      标记 = 1
    如果结束
    汇报 = 格式化文本("A插入文本={}", 标记)
    文件_写文本行(报告, 汇报)

    数值一 = 文件_取读写位置(号)
    汇报 = 格式化文本("A插入后位置={}", 数值一)
    文件_写文本行(报告, 汇报)

    数值一 = 文件_取长度(号)
    汇报 = 格式化文本("A插入后长度={}", 数值一)
    文件_写文本行(报告, 汇报)

    布尔一 = 文件_移到文件首(号)
    文本一 = 文件_读入一行(号)
    汇报 = 格式化文本("A插入后首行={}", 文本一)
    文件_写文本行(报告, 汇报)

    布尔一 = 文件_移动读写位置(号, 0, 1)
    布尔一 = 文件_删除数据(号, 7)
    标记 = 0
    如果 (布尔一)
      标记 = 1
    如果结束
    汇报 = 格式化文本("A删除数据={}", 标记)
    文件_写文本行(报告, 汇报)

    数值一 = 文件_取长度(号)
    汇报 = 格式化文本("A删除后长度={}", 数值一)
    文件_写文本行(报告, 汇报)

    数值一 = 文件_取读写位置(号)
    汇报 = 格式化文本("A删除后位置={}", 数值一)
    文件_写文本行(报告, 汇报)

    布尔一 = 文件_插入文本行(号, "零")
    数值一 = 文件_取长度(号)
    汇报 = 格式化文本("A插入行后长度={}", 数值一)
    文件_写文本行(报告, 汇报)

    布尔一 = 文件_移到文件首(号)
    文本一 = 文件_读入一行(号)
    汇报 = 格式化文本("A插入行后首行={}", 文本一)
    文件_写文本行(报告, 汇报)

    布尔一 = 文件_移动读写位置(号, 0, 1)
    布尔一 = 文件_删除数据(号, 5)
    标记 = 0
    如果 (布尔一)
      标记 = 1
    如果结束
    汇报 = 格式化文本("A删除行数据={}", 标记)
    文件_写文本行(报告, 汇报)

    数值一 = 文件_取长度(号)
    汇报 = 格式化文本("A删除行后长度={}", 数值一)
    文件_写文本行(报告, 汇报)

    文本一 = 文件_读入一行(号)
    汇报 = 格式化文本("A删除行后首行={}", 文本一)
    文件_写文本行(报告, 汇报)

    布尔一 = 文件_移到文件首(号)
    数据块 = 文件_读入字节集(号, 3)
    汇报 = 格式化文本("A读入字节集={} 一={}", 字节集_取字节(数据块, 0), 字节集_取字节(数据块, 1))
    文件_写文本行(报告, 汇报)

    布尔一 = 文件_锁定(号, 0, 16, 0)
    标记 = 0
    如果 (布尔一)
      标记 = 1
    如果结束
    汇报 = 格式化文本("A锁定={}", 标记)
    文件_写文本行(报告, 汇报)

    布尔一 = 文件_解锁(号, 0, 16)
    标记 = 0
    如果 (布尔一)
      标记 = 1
    如果结束
    汇报 = 格式化文本("A解锁={}", 标记)
    文件_写文本行(报告, 汇报)

    文件_关闭(号)

    局部 文件号 号二
    局部 文件号 号三
    局部 文件号 号四
    局部 文件号 号五
    数据块 = 字节集_从文本("BIN数据")
    号二 = 文件_打开(二进制文件, 4, 1)
    布尔一 = 文件_写出字节集(号二, 数据块)
    标记 = 0
    如果 (布尔一)
      标记 = 1
    如果结束
    汇报 = 格式化文本("A写出字节集={}", 标记)
    文件_写文本行(报告, 汇报)
    文件_关闭(号二)

    号三 = 文件_打开(二进制文件, 1, 1)
    数据块 = 文件_读入字节集(号三, 2)
    数值一 = 文件_取长度(号三)
    汇报 = 格式化文本("A二进制长度={} 首字节={}", 数值一, 字节集_取字节(数据块, 0))
    文件_写文本行(报告, 汇报)
    文件_关闭(号三)

    号四 = 文件_打开(二进制文件, 4, 1)
    布尔一 = 文件_写出数据(号四, 12345, -9000000000, 2.5, 真, "混合值")
    标记 = 0
    如果 (布尔一)
      标记 = 1
    如果结束
    汇报 = 格式化文本("A写出数据={}", 标记)
    文件_写文本行(报告, 汇报)
    文件_关闭(号四)

    号五 = 文件_打开(二进制文件, 1, 1)
    局部 整数型 整数读回 = 0
    局部 长整数型 长整数读回 = 0
    局部 小数型 小数读回 = 0
    局部 逻辑型 逻辑读回 = 假
    局部 文本型 文本读回 = ""
    布尔一 = 文件_读入数据(号五, 整数读回, 长整数读回, 小数读回, 逻辑读回, 文本读回)
    标记 = 0
    如果 (布尔一)
      标记 = 1
    如果结束
    汇报 = 格式化文本("A读入数据={} 整数={} 长整数={}", 标记, 整数读回, 长整数读回)
    文件_写文本行(报告, 汇报)
    标记 = 0
    如果 (逻辑读回)
      标记 = 1
    如果结束
    汇报 = 格式化文本("A读入数据逻辑={} 小数十倍={} 文本={}", 标记, 数学_绝对取整(小数读回 * 10 + 0.5), 文本读回)
    文件_写文本行(报告, 汇报)
    标记 = 0
    布尔一 = 文件_是否在文件尾(号五)
    如果 (布尔一)
      标记 = 1
    如果结束
    汇报 = 格式化文本("A数据已到尾={}", 标记)
    文件_写文本行(报告, 汇报)
    文件_关闭(号五)

    目录_创建("演示子目录/嵌套")
    文件_写入文本("演示子目录/一.txt", "甲")
    文件_写入文本("演示子目录/二.log", "乙")
    文件_写入文本("演示子目录/嵌套/三.txt", "丙")
    局部 文本型 名单[]
    局部 文本型 名单二[]
    局部 整数型 命中 = 0
    命中 = 文件_枚举("演示子目录", "*.txt", 真, 名单)
    汇报 = 格式化文本("A枚举递归={} 一={} 二={}", 命中, 数组_取成员(名单, 0), 数组_取成员(名单, 1))
    文件_写文本行(报告, 汇报)
    命中 = 文件_枚举("演示子目录", "*.txt", 假, 名单)
    汇报 = 格式化文本("A枚举单层={} 一={}", 命中, 数组_取成员(名单, 0))
    文件_写文本行(报告, 汇报)
    命中 = 目录_枚举("演示子目录", 真, 名单二)
    汇报 = 格式化文本("A目录枚举={} 一={}", 命中, 数组_取成员(名单二, 0))
    文件_写文本行(报告, 汇报)

    局部 文本型 左边值 = ""
    左边值 = 文本_取左边("LingBuilder", 4)
    汇报 = 格式化文本("B取左边={}", 左边值)
    文件_写文本行(报告, 汇报)
    文本一 = 文本_取右边("LingBuilder", 6)
    汇报 = 格式化文本("B取右边={}", 文本一)
    文件_写文本行(报告, 汇报)
    文本一 = 文本_码点转字符(20320)
    汇报 = 格式化文本("B码点转字符={}", 文本一)
    文件_写文本行(报告, 汇报)
    数值一 = 文本_取码点("你好", 1)
    汇报 = 格式化文本("B取码点={}", 数值一)
    文件_写文本行(报告, 汇报)
    文本一 = 文本_删首空白("  内容  ")
    文本二 = 文本_删尾空白("  内容  ")
    汇报 = 格式化文本("B删首={}", 文本一)
    文件_写文本行(报告, 汇报)
    汇报 = 格式化文本("B删尾={}", 文本二)
    文件_写文本行(报告, 汇报)

    局部 日期时间 指定值
    局部 整数型 年份 = 0
    指定值 = 时间_指定(2026, 9, 16, 8, 30, 5)
    年份 = 时间_取年份(指定值)
    数值一 = 时间_取月份(指定值)
    汇报 = 格式化文本("C指定 年={} 月={} 日={} 星期={} 时={} 分={} 秒={}", 年份, 数值一, 时间_取日(指定值), 时间_取星期几(指定值), 时间_取小时(指定值), 时间_取分钟(指定值), 时间_取秒(指定值))
    文件_写文本行(报告, 汇报)
    汇报 = 格式化文本("C二月天数={} 闰年二月={}", 时间_取某月天数(2026, 2), 时间_取某月天数(2024, 2))
    文件_写文本行(报告, 汇报)

    局部 日期时间 增减值
    增减值 = 时间_增减(指定值, 3, 1)
    汇报 = 格式化文本("C加一月 月={} 日={}", 时间_取月份(增减值), 时间_取日(增减值))
    文件_写文本行(报告, 汇报)
    局部 日期时间 指定值二
    指定值二 = 时间_指定(2026, 1, 31, 0, 0, 0)
    增减值 = 时间_增减(指定值二, 3, 1)
    汇报 = 格式化文本("C一月三十一加一月 月={} 日={}", 时间_取月份(增减值), 时间_取日(增减值))
    文件_写文本行(报告, 汇报)

    局部 日期时间 早期
    局部 日期时间 晚期
    早期 = 时间_指定(2026, 9, 15, 0, 0, 0)
    晚期 = 时间_指定(2026, 9, 16, 0, 0, 0)
    局部 小数型 间隔日 = 0
    局部 小数型 间隔秒 = 0
    间隔日 = 时间_取间隔(晚期, 早期, 5)
    间隔秒 = 时间_取间隔(晚期, 早期, 8)
    汇报 = 格式化文本("C间隔日={} 间隔秒={}", 数学_绝对取整(间隔日 + 0.5), 数学_绝对取整(间隔秒 + 0.5))
    文件_写文本行(报告, 汇报)

    局部 日期时间 解析值
    解析值 = 时间_从文本("2026-09-16 12:30:25")
    汇报 = 格式化文本("C解析 时={} 分={} 秒={}", 时间_取小时(解析值), 时间_取分钟(解析值), 时间_取秒(解析值))
    文件_写文本行(报告, 汇报)
    解析值 = 时间_从文本("20260916123025")
    汇报 = 格式化文本("C紧凑解析 年={} 分={}", 时间_取年份(解析值), 时间_取分钟(解析值))
    文件_写文本行(报告, 汇报)
    局部 日期时间 解析失败
    解析失败 = 时间_从文本("乱七乱八")
    汇报 = 格式化文本("C解析失败值={}", 解析失败)
    文件_写文本行(报告, 汇报)

    文本一 = 时间_到文本(指定值, 0)
    汇报 = 格式化文本("C到文本={}", 文本一)
    文件_写文本行(报告, 汇报)
    局部 日期时间 日期值
    局部 日期时间 时间值
    日期值 = 时间_取日期(指定值)
    时间值 = 时间_取时间(指定值)
    汇报 = 格式化文本("C取日期时={} 取时间年={}", 时间_取小时(日期值), 时间_取年份(时间值))
    文件_写文本行(报告, 汇报)

    局部 日期时间 现在
    现在 = 时间_取现行()
    汇报 = 格式化文本("C现行 年={} 月={}", 时间_取年份(现在), 时间_取月份(现在))
    文件_写文本行(报告, 汇报)

    局部 整数型 取整值 = 0
    取整值 = 数学_取整(-7.8)
    数值一 = 数学_绝对取整(-7.8)
    汇报 = 格式化文本("D取整={} 绝对取整={}", 取整值, 数值一)
    文件_写文本行(报告, 汇报)
    局部 小数型 舍入值 = 0
    舍入值 = 数学_四舍五入(1056.65, 0)
    数值一 = 数学_绝对取整(舍入值 + 0.5)
    舍入值 = 数学_四舍五入(1056.65, 1)
    汇报 = 格式化文本("D舍入整={} 舍入一位={}", 数值一, 数学_绝对取整(舍入值 * 10 + 0.5))
    文件_写文本行(报告, 汇报)
    数值一 = 数学_取符号(-3.2)
    汇报 = 格式化文本("D符号={}", 数值一)
    文件_写文本行(报告, 汇报)
    汇报 = 格式化文本("D正弦千={} 余弦千={} 正切百={}", 数学_绝对取整(数学_正弦(1) * 1000), 数学_绝对取整(数学_余弦(1) * 1000), 数学_绝对取整(数学_正切(1) * 100))
    文件_写文本行(报告, 汇报)
    汇报 = 格式化文本("D反正切百万={} 对数一百={} 反对数十万={}", 数学_绝对取整(数学_反正切(1) * 1000000), 数学_绝对取整(数学_自然对数(1) * 100), 数学_绝对取整(数学_反对数(1) * 100000))
    文件_写文本行(报告, 汇报)
    数学_置随机种子(7)
    数值一 = 数学_随机整数(1, 10)
    汇报 = 格式化文本("D随机={}", 数值一)
    文件_写文本行(报告, 汇报)

    数据块 = 字节集_从文本("AB")
    数值一 = 字节集_长度(数据块)
    局部 字节集 重复块 = 字节集_从文本("")
    重复块 = 字节集_重复(3, 数据块)
    汇报 = 格式化文本("D从文本长={} 重复长={} 首字节={}", 数值一, 字节集_长度(重复块), 字节集_取字节(数据块, 0))
    文件_写文本行(报告, 汇报)
    局部 字节集 分割源 = 字节集_从文本("aXbXc")
    局部 字节集 分隔块 = 字节集_从文本("X")
    局部 字节集 分段[]
    局部 整数型 分段数 = 0
    分段数 = 字节集_分割(分割源, 分隔块, 分段, 0)
    汇报 = 格式化文本("D分段={} 段一首={} 段二首={}", 分段数, 字节集_取字节(数组_取成员(分段, 0), 0), 字节集_取字节(数组_取成员(分段, 1), 0))
    文件_写文本行(报告, 汇报)
    文本一 = 数值_到十六进制文本(255)
    文本二 = 数值_到十六进制文本(-1)
    汇报 = 格式化文本("D十六进制={} 负数={}", 文本一, 文本二)
    文件_写文本行(报告, 汇报)
    文本一 = 数值_到八进制文本(8)
    数值一 = 数值_十六进制解析("0xFF")
    汇报 = 格式化文本("D八进制={} 十六解析={} 八解析={}", 文本一, 数值一, 数值_八进制解析("10"))
    文件_写文本行(报告, 汇报)

    文件_写文本行(报告, "DONE")
    文件_关闭全部()
    控件_设置文本(状态标签, "验证完成：yl-verification-report.txt 已生成")
    控件_添加项目(结果列表, "文件流/枚举/文本/时间/数学/字节集 命令族已全部执行")
  结束
结束类
