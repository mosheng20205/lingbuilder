包 定时任务演示
使用 Win32窗口基础模块
使用 定时任务模块
使用 文件目录模块
使用 文本处理模块

类 定时任务演示窗口 : 窗口
公开
  事件 _定时任务演示窗口_创建完毕()
    局部 逻辑型 校验 = cron_定时_校验表达式("*/2 * * * * *")
    局部 逻辑型 坏表达式 = cron_定时_校验表达式("99 * * * *")
    局部 文本型 错误 = cron_定时_取表达式错误("61 * * * *")
    局部 文本型 说明 = cron_定时_表达式说明("0 2 * * *")
    文件_追加文本("cron-report.txt", 格式化文本("校验={};", 到文本(校验)))
    文件_追加文本("cron-report.txt", 格式化文本("坏表达式={};", 到文本(坏表达式)))
    文件_追加文本("cron-report.txt", 格式化文本("错误含61={};", 到文本(文本_寻找(错误, "61") > 0)))
    文件_追加文本("cron-report.txt", 格式化文本("说明={};", 说明))

    局部 定时任务 任务A
    任务A = cron_定时_启动("*/2 * * * * *", &到点写探针)
    文件_追加文本("cron-report.txt", 格式化文本("任务A={};", 到文本(任务A > 0)))
    局部 定时任务 任务B
    任务B = cron_定时_提交线程("*/5 * * * * *", &后台工作, &后台完成)
    文件_追加文本("cron-report.txt", 格式化文本("任务B={};", 到文本(任务B > 0)))
    文件_追加文本("cron-report.txt", 格式化文本("状态A={};", cron_定时_取状态(任务A)))
    文件_追加文本("cron-report.txt", 格式化文本("下次A={};", cron_定时_下次触发时间(任务A)))
    文件_追加文本("cron-report.txt", 格式化文本("数量={};", 到文本(cron_定时_取任务数量() >= 2)))

    局部 逻辑型 表添加 = cron_定时_表添加("*/3 * * * * *", "echo B>>cron-probe-b.txt", "命令探针", "cron-demo-table.txt")
    文件_追加文本("cron-report.txt", 格式化文本("表添加={};", 到文本(表添加)))
    局部 文本型 表内容 = cron_定时_表读取("cron-demo-table.txt")
    文件_追加文本("cron-report.txt", 格式化文本("表含表达式={};", 到文本(文本_寻找(表内容, "*/3 * * * * *") > 0)))
    局部 整数型 载入 = cron_定时_表载入运行("cron-demo-table.txt")
    文件_追加文本("cron-report.txt", 格式化文本("载入={};", 到文本(载入)))

    局部 逻辑型 守护 = cron_定时_守护启动()
    文件_追加文本("cron-report.txt", 格式化文本("守护={};", 到文本(守护)))
    文件_追加文本("cron-report.txt", 格式化文本("守护重复={};", 到文本(cron_定时_守护启动())))
    局部 逻辑型 守护停 = cron_定时_守护停止()
    局部 逻辑型 守护复启 = cron_定时_守护启动()
    文件_追加文本("cron-report.txt", 格式化文本("守护停复启={}{};", 到文本(守护停), 到文本(守护复启)))

    局部 逻辑型 配置 = cron_定时_邮件配置("127.0.0.1", 125, "user", "pass", "to@example.com")
    文件_追加文本("cron-report.txt", 格式化文本("配置={};", 到文本(配置)))
    局部 逻辑型 测试 = cron_定时_邮件测试()
    局部 文本型 测试错误 = cron_定时_取错误()
    文件_追加文本("cron-report.txt", 格式化文本("测试拒绝={};", 到文本(!测试)))
    文件_追加文本("cron-report.txt", 格式化文本("测试错误有={};", 到文本(文本_寻找(测试错误, "SMTP") >= 0)))

    局部 逻辑型 自启 = cron_定时_开机自启(真)
    局部 逻辑型 自启在 = cron_定时_是否开机自启()
    局部 逻辑型 关自启 = cron_定时_开机自启(假)
    局部 逻辑型 自启没了 = !cron_定时_是否开机自启()
    文件_追加文本("cron-report.txt", 格式化文本("自启={}{}{}{};", 到文本(自启), 到文本(自启在), 到文本(关自启), 到文本(自启没了)))
  结束

  空 到点写探针(定时任务 任务)
    文件_追加文本("cron-probe-a.txt", 格式化文本("A={};", 到文本(任务)))
  结束

  空 后台工作()
    文件_追加文本("cron-probe-w.txt", "W;")
  结束

  空 后台完成(定时任务 任务)
    文件_追加文本("cron-probe-c.txt", 格式化文本("C={};", 到文本(任务)))
  结束
结束类
