包 多线程操作组件示例
使用 Win32窗口基础模块
使用 多线程模块
使用 通用控件模块

类 多线程演示窗口 : 窗口
公开
  线程任务 延时任务
  线程任务 求和任务
  线程任务 批量任务
  逻辑型 批量运行中 = 假
  整数型 批量条数 = 20000

  事件 _多线程演示窗口_创建完毕()
    控件_设置文本(状态标签, "就绪：依次点四个按钮，看后台任务如何不卡界面")
    控件_设置文本(进度标签, "进度：等待启动")
    控件_添加项目(日志列表, "多线程模块 2.0 演示已就绪。")
  结束

  事件 _提交后台按钮_被单击()
    延时任务 = 线程_提交(&延时工作, 4000)
    控件_设置文本(状态标签, "已提交后台任务：现在拖动窗口、点其它按钮都不卡")
    控件_添加项目(日志列表, 格式化文本("线程_提交 已返回，任务={}", 延时任务))
  结束

  事件 _提交完成按钮_被单击()
    求和任务 = 线程_提交完成(&累加工作, &累加完成, 1000)
    控件_设置文本(状态标签, "后台累加 1000 项中：结果由完成处理器带回界面")
  结束

  事件 _批量任务按钮_被单击()
    批量任务 = 线程_提交进度(&批量工作, &批量进度, &批量完成, 批量条数)
    批量运行中 = 真
    控件_设置文本(状态标签, "批量任务运行中：进度按 80ms 合并刷新界面")
  结束

  事件 _请求取消按钮_被单击()
    如果 (批量运行中)
      线程_请求取消(批量任务)
      控件_设置文本(状态标签, "已发出取消请求，等待工作处理器协作停下")
    否则
      控件_设置文本(状态标签, "当前没有运行中的批量任务")
    如果结束
  结束

  事件 _清空列表按钮_被单击()
    控件_清空项目(任务列表)
    控件_清空项目(日志列表)
    控件_设置文本(状态标签, "已清空，可重新启动任务")
    控件_设置文本(进度标签, "进度：等待启动")
    控件_添加项目(日志列表, 格式化文本("已清理完成任务记录：{} 条", 线程_清理已完成()))
  结束

  事件 _退出按钮_被单击()
    线程_等待全部超时(3000, 延时任务, 求和任务, 批量任务)
    结束()
  结束

  空 延时工作(整数型 毫秒)
    线程_协作等待(毫秒)
  结束

  整数型 累加工作(整数型 项数)
    局部 整数型 合计 = 0
    局部 整数型 索引 = 0
    计次循环首 (项数, 索引)
      合计 = 合计 + 索引
    计次循环尾 ()
    线程_协作等待(1200)
    返回 合计
  结束

  空 批量工作(整数型 总条数)
    局部 整数型 步数 = 100
    局部 整数型 索引 = 0
    判断循环首 (索引 < 步数)
      索引 = 索引 + 1
      如果 (线程_是否请求取消(0))
        跳出循环
      如果结束
      线程_报告进度(索引, 格式化文本("已模拟处理 {} / {} 条", 总条数 * 索引 / 步数, 总条数))
      如果 (线程_协作等待(56) == 假)
        跳出循环
      如果结束
    判断循环尾 ()
  结束

  空 批量进度(线程任务 任务, 整数型 百分比, 文本型 说明)
    控件_设置文本(进度标签, 格式化文本("进度 {}% - {}", 百分比, 说明))
  结束

  空 累加完成(线程任务 任务, 整数型 结果)
    列表视图_添加行(任务列表, 列表视图_创建行("后台累加 1000 项", "默认池", 结果, 线程_取状态名称(任务)))
    控件_设置文本(状态标签, 格式化文本("完成处理器已在界面线程写入：合计={}", 结果))
    控件_添加项目(日志列表, 格式化文本("任务={}，状态={}", 任务, 线程_取状态名称(任务)))
  结束

  空 批量完成(线程任务 任务)
    批量运行中 = 假
    列表视图_添加行(任务列表, 列表视图_创建行("批量任务 20000 条", "默认池", 线程_取进度(任务), 线程_取状态名称(任务)))
    控件_设置文本(进度标签, 格式化文本("进度 {}% - {}", 线程_取进度(任务), 线程_取状态名称(任务)))
    控件_设置文本(状态标签, 格式化文本("批量任务结束：{}", 线程_取状态名称(任务)))
  结束
结束类
