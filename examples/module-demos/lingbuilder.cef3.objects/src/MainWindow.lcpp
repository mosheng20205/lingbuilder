包 CEF3受管对象模块完整演示
使用 Win32窗口基础模块
使用 CEF3受管对象模块

// 本项目由模块清单自动生成；每条 binding 命令都在下方具有真实调用语句。
// 为避免误删文件、启动进程、访问网络或操作设备，必须先勾选“允许实际执行”才会进入命令调用区。
类 MainWindow : 公开 窗口
    事件 _MainWindow_创建完毕()
        控件_设置选择项(命令分组选项卡, 0)
        控件_设置文本(演示状态, "CEF3受管对象模块：183 条命令，默认处于安全预览模式。")
        调试输出("已加载模块演示：lingbuilder.cef3.objects")
    结束

    事件 _运行第01组_被单击()
        控件_设置文本(演示状态, "命令 1–19：CEF3任务_取状态 至 CEF3值_是否有效；源码内含完整签名、参数、返回值与调用。")
        如果 (控件_取勾选(允许实际执行))
            // 命令ID：CEF3任务_取状态
            // [1] CEF3任务_取状态(任务ID)
            // 功能：取得异步任务状态。
            // 参数：任务ID:longLong；返回：int；可见性：advanced
            CEF3任务_取状态(1)
            // 命令ID：CEF3任务_取结果
            // [2] CEF3任务_取结果(任务ID)
            // 功能：取得异步任务UTF-16结果。
            // 参数：任务ID:longLong；返回：wideString；可见性：advanced
            CEF3任务_取结果(1)
            // 命令ID：CEF3任务_取错误
            // [3] CEF3任务_取错误(任务ID)
            // 功能：取得异步任务中文错误。
            // 参数：任务ID:longLong；返回：wideString；可见性：advanced
            CEF3任务_取错误(1)
            // 命令ID：CEF3任务_取消
            // [4] CEF3任务_取消(任务ID)
            // 功能：取消尚未完成的任务。
            // 参数：任务ID:longLong；返回：int；可见性：advanced
            CEF3任务_取消(1)
            // 命令ID：CEF3任务_释放
            // [5] CEF3任务_释放(任务ID)
            // 功能：释放异步任务及其结果。
            // 参数：任务ID:longLong；返回：int；可见性：advanced
            CEF3任务_释放(1)
            // 命令ID：CEF3缓冲_从十六进制
            // [6] CEF3缓冲_从十六进制(十六进制)
            // 功能：从偶数长度十六进制文本创建 Bridge 受管缓冲并返回类型化句柄。
            // 参数：十六进制:wideString；返回：longLong；可见性：advanced
            CEF3缓冲_从十六进制("演示参数1")
            // 命令ID：CEF3缓冲_复制
            // [7] CEF3缓冲_复制(缓冲句柄)
            // 功能：复制受管二进制缓冲并返回独立句柄。
            // 参数：缓冲句柄:longLong；返回：longLong；可见性：advanced
            CEF3缓冲_复制(1)
            // 命令ID：CEF3缓冲_是否有效
            // [8] CEF3缓冲_是否有效(缓冲句柄)
            // 功能：判断受管缓冲句柄是否有效。
            // 参数：缓冲句柄:longLong；返回：int；可见性：advanced
            CEF3缓冲_是否有效(1)
            // 命令ID：CEF3缓冲_是否被拥有
            // [9] CEF3缓冲_是否被拥有(缓冲句柄)
            // 功能：Bridge缓冲始终独立拥有，合法句柄返回0。
            // 参数：缓冲句柄:longLong；返回：int；可见性：advanced
            CEF3缓冲_是否被拥有(1)
            // 命令ID：CEF3缓冲_是否同一对象
            // [10] CEF3缓冲_是否同一对象(缓冲句柄, 另一缓冲句柄)
            // 功能：判断两个受管句柄是否引用同一缓冲。
            // 参数：缓冲句柄:longLong，另一缓冲句柄:longLong；返回：int；可见性：advanced
            CEF3缓冲_是否同一对象(1, 1)
            // 命令ID：CEF3缓冲_是否相等
            // [11] CEF3缓冲_是否相等(缓冲句柄, 另一缓冲句柄)
            // 功能：逐字节比较两个受管缓冲。
            // 参数：缓冲句柄:longLong，另一缓冲句柄:longLong；返回：int；可见性：advanced
            CEF3缓冲_是否相等(1, 1)
            // 命令ID：CEF3缓冲_从文件
            // [12] CEF3缓冲_从文件(路径)
            // 功能：从允许文件根目录内读取文件并创建受管缓冲；越界路径返回0。
            // 参数：路径:wideString；返回：longLong；可见性：advanced
            CEF3缓冲_从文件("module-demo-temp.txt")
            // 命令ID：CEF3缓冲_取大小
            // [13] CEF3缓冲_取大小(缓冲句柄)
            // 功能：返回受管缓冲字节数，无效或类型错误返回-1。
            // 参数：缓冲句柄:longLong；返回：longLong；可见性：advanced
            CEF3缓冲_取大小(1)
            // 命令ID：CEF3缓冲_到十六进制
            // [14] CEF3缓冲_到十六进制(缓冲句柄)
            // 功能：把受管缓冲转换为小写十六进制文本。
            // 参数：缓冲句柄:longLong；返回：wideString；可见性：advanced
            CEF3缓冲_到十六进制(1)
            // 命令ID：CEF3缓冲_保存文件
            // [15] CEF3缓冲_保存文件(缓冲句柄, 路径)
            // 功能：把受管缓冲写入允许文件根目录；拒绝目录穿越和任意路径写入。
            // 参数：缓冲句柄:longLong，路径:wideString；返回：int；可见性：advanced
            CEF3缓冲_保存文件(1, "module-demo-temp.txt")
            // 命令ID：CEF3缓冲_释放
            // [16] CEF3缓冲_释放(缓冲句柄)
            // 功能：释放受管缓冲；重复释放返回稳定错误码。
            // 参数：缓冲句柄:longLong；返回：int；可见性：advanced
            CEF3缓冲_释放(1)
            // 命令ID：CEF3值_创建
            // [17] CEF3值_创建()
            // 功能：创建独立拥有的CEF值对象并返回类型化受管句柄。
            // 参数：无；返回：longLong；可见性：advanced
            CEF3值_创建()
            // 命令ID：CEF3值_复制
            // [18] CEF3值_复制(值句柄)
            // 功能：深复制CEF值并返回独立受管句柄。
            // 参数：值句柄:longLong；返回：longLong；可见性：advanced
            CEF3值_复制(1)
            // 命令ID：CEF3值_是否有效
            // [19] CEF3值_是否有效(值句柄)
            // 功能：判断CEF值当前是否有效。
            // 参数：值句柄:longLong；返回：int；可见性：advanced
            CEF3值_是否有效(1)
        如果结束
        调试输出("已查看 命令 1–19：CEF3任务_取状态 至 CEF3值_是否有效；勾选允许实际执行后会使用演示参数调用。")
    结束

    事件 _运行第02组_被单击()
        控件_设置文本(演示状态, "命令 20–38：CEF3值_是否被拥有 至 CEF3值_取字典；源码内含完整签名、参数、返回值与调用。")
        如果 (控件_取勾选(允许实际执行))
            // 命令ID：CEF3值_是否被拥有
            // [20] CEF3值_是否被拥有(值句柄)
            // 功能：判断CEF值是否被其它CEF对象拥有。
            // 参数：值句柄:longLong；返回：int；可见性：advanced
            CEF3值_是否被拥有(1)
            // 命令ID：CEF3值_是否只读
            // [21] CEF3值_是否只读(值句柄)
            // 功能：判断CEF值是否只读。
            // 参数：值句柄:longLong；返回：int；可见性：advanced
            CEF3值_是否只读(1)
            // 命令ID：CEF3值_是否同一对象
            // [22] CEF3值_是否同一对象(值句柄, 另一值句柄)
            // 功能：判断两个句柄是否引用同一CEF值对象。
            // 参数：值句柄:longLong，另一值句柄:longLong；返回：int；可见性：advanced
            CEF3值_是否同一对象(1, 1)
            // 命令ID：CEF3值_是否相等
            // [23] CEF3值_是否相等(值句柄, 另一值句柄)
            // 功能：深度比较两个CEF值的内容。
            // 参数：值句柄:longLong，另一值句柄:longLong；返回：int；可见性：advanced
            CEF3值_是否相等(1, 1)
            // 命令ID：CEF3值_取类型
            // [24] CEF3值_取类型(值句柄)
            // 功能：取得CEF值类型枚举。
            // 参数：值句柄:longLong；返回：int；可见性：advanced
            CEF3值_取类型(1)
            // 命令ID：CEF3值_设为空
            // [25] CEF3值_设为空(值句柄)
            // 功能：把CEF值设为空。
            // 参数：值句柄:longLong；返回：int；可见性：advanced
            CEF3值_设为空(1)
            // 命令ID：CEF3值_设逻辑
            // [26] CEF3值_设逻辑(值句柄, 值)
            // 功能：设置CEF逻辑值。
            // 参数：值句柄:longLong，值:bool；返回：int；可见性：advanced
            CEF3值_设逻辑(1, 真)
            // 命令ID：CEF3值_设整数
            // [27] CEF3值_设整数(值句柄, 值)
            // 功能：设置CEF整数值。
            // 参数：值句柄:longLong，值:int；返回：int；可见性：advanced
            CEF3值_设整数(1, 1)
            // 命令ID：CEF3值_设小数
            // [28] CEF3值_设小数(值句柄, 值)
            // 功能：设置CEF双精度值。
            // 参数：值句柄:longLong，值:double；返回：int；可见性：advanced
            CEF3值_设小数(1, 1.0)
            // 命令ID：CEF3值_设文本
            // [29] CEF3值_设文本(值句柄, 值)
            // 功能：设置UTF-16文本值。
            // 参数：值句柄:longLong，值:wideString；返回：int；可见性：advanced
            CEF3值_设文本(1, "演示参数2")
            // 命令ID：CEF3值_设缓冲
            // [30] CEF3值_设缓冲(值句柄, 缓冲句柄)
            // 功能：复制受管缓冲并设置为CEF二进制值。
            // 参数：值句柄:longLong，缓冲句柄:longLong；返回：int；可见性：advanced
            CEF3值_设缓冲(1, 1)
            // 命令ID：CEF3值_设字典
            // [31] CEF3值_设字典(值句柄, 字典句柄)
            // 功能：深复制字典并设置为CEF字典值。
            // 参数：值句柄:longLong，字典句柄:longLong；返回：int；可见性：advanced
            CEF3值_设字典(1, 1)
            // 命令ID：CEF3值_设列表
            // [32] CEF3值_设列表(值句柄, 列表句柄)
            // 功能：深复制列表并设置为CEF列表值。
            // 参数：值句柄:longLong，列表句柄:longLong；返回：int；可见性：advanced
            CEF3值_设列表(1, 1)
            // 命令ID：CEF3值_取逻辑
            // [33] CEF3值_取逻辑(值句柄)
            // 功能：取得CEF逻辑值，类型不匹配时返回稳定负错误码。
            // 参数：值句柄:longLong；返回：int；可见性：advanced
            CEF3值_取逻辑(1)
            // 命令ID：CEF3值_取整数
            // [34] CEF3值_取整数(值句柄)
            // 功能：取得CEF整数值。
            // 参数：值句柄:longLong；返回：int；可见性：advanced
            CEF3值_取整数(1)
            // 命令ID：CEF3值_取小数
            // [35] CEF3值_取小数(值句柄)
            // 功能：取得CEF双精度值。
            // 参数：值句柄:longLong；返回：double；可见性：advanced
            CEF3值_取小数(1)
            // 命令ID：CEF3值_取文本
            // [36] CEF3值_取文本(值句柄)
            // 功能：取得CEF UTF-16文本值。
            // 参数：值句柄:longLong；返回：wideString；可见性：advanced
            CEF3值_取文本(1)
            // 命令ID：CEF3值_取缓冲
            // [37] CEF3值_取缓冲(值句柄)
            // 功能：复制CEF二进制值并返回独立受管缓冲句柄。
            // 参数：值句柄:longLong；返回：longLong；可见性：advanced
            CEF3值_取缓冲(1)
            // 命令ID：CEF3值_取字典
            // [38] CEF3值_取字典(值句柄)
            // 功能：深复制CEF字典值并返回独立受管字典句柄。
            // 参数：值句柄:longLong；返回：longLong；可见性：advanced
            CEF3值_取字典(1)
        如果结束
        调试输出("已查看 命令 20–38：CEF3值_是否被拥有 至 CEF3值_取字典；勾选允许实际执行后会使用演示参数调用。")
    结束

    事件 _运行第03组_被单击()
        控件_设置文本(演示状态, "命令 39–57：CEF3值_取列表 至 CEF3字典_到JSON；源码内含完整签名、参数、返回值与调用。")
        如果 (控件_取勾选(允许实际执行))
            // 命令ID：CEF3值_取列表
            // [39] CEF3值_取列表(值句柄)
            // 功能：深复制CEF列表值并返回独立受管列表句柄。
            // 参数：值句柄:longLong；返回：longLong；可见性：advanced
            CEF3值_取列表(1)
            // 命令ID：CEF3值_到JSON
            // [40] CEF3值_到JSON(值句柄)
            // 功能：把CEF值安全序列化为JSON。
            // 参数：值句柄:longLong；返回：wideString；可见性：advanced
            CEF3值_到JSON(1)
            // 命令ID：CEF3值_释放
            // [41] CEF3值_释放(值句柄)
            // 功能：释放CEF值受管句柄。
            // 参数：值句柄:longLong；返回：int；可见性：advanced
            CEF3值_释放(1)
            // 命令ID：CEF3字典_创建
            // [42] CEF3字典_创建()
            // 功能：创建CEF字典受管句柄。
            // 参数：无；返回：longLong；可见性：advanced
            CEF3字典_创建()
            // 命令ID：CEF3字典_复制
            // [43] CEF3字典_复制(字典句柄, 排除空子项)
            // 功能：深复制CEF字典，可选择排除空子对象。
            // 参数：字典句柄:longLong，排除空子项:bool；返回：longLong；可见性：advanced
            CEF3字典_复制(1, 真)
            // 命令ID：CEF3字典_是否有效
            // [44] CEF3字典_是否有效(字典句柄)
            // 功能：判断CEF字典当前是否有效。
            // 参数：字典句柄:longLong；返回：int；可见性：advanced
            CEF3字典_是否有效(1)
            // 命令ID：CEF3字典_是否被拥有
            // [45] CEF3字典_是否被拥有(字典句柄)
            // 功能：判断CEF字典是否被其它CEF对象拥有。
            // 参数：字典句柄:longLong；返回：int；可见性：advanced
            CEF3字典_是否被拥有(1)
            // 命令ID：CEF3字典_是否只读
            // [46] CEF3字典_是否只读(字典句柄)
            // 功能：判断CEF字典是否只读。
            // 参数：字典句柄:longLong；返回：int；可见性：advanced
            CEF3字典_是否只读(1)
            // 命令ID：CEF3字典_是否同一对象
            // [47] CEF3字典_是否同一对象(字典句柄, 另一字典句柄)
            // 功能：判断两个句柄是否引用同一CEF字典。
            // 参数：字典句柄:longLong，另一字典句柄:longLong；返回：int；可见性：advanced
            CEF3字典_是否同一对象(1, 1)
            // 命令ID：CEF3字典_是否相等
            // [48] CEF3字典_是否相等(字典句柄, 另一字典句柄)
            // 功能：深度比较两个CEF字典的内容。
            // 参数：字典句柄:longLong，另一字典句柄:longLong；返回：int；可见性：advanced
            CEF3字典_是否相等(1, 1)
            // 命令ID：CEF3字典_取数量
            // [49] CEF3字典_取数量(字典句柄)
            // 功能：取得字典键数量。
            // 参数：字典句柄:longLong；返回：longLong；可见性：advanced
            CEF3字典_取数量(1)
            // 命令ID：CEF3字典_是否存在
            // [50] CEF3字典_是否存在(字典句柄, 键)
            // 功能：判断字典键是否存在。
            // 参数：字典句柄:longLong，键:wideString；返回：int；可见性：advanced
            CEF3字典_是否存在(1, "演示参数2")
            // 命令ID：CEF3字典_取键列表
            // [51] CEF3字典_取键列表(字典句柄)
            // 功能：以JSON数组返回全部字典键。
            // 参数：字典句柄:longLong；返回：wideString；可见性：advanced
            CEF3字典_取键列表(1)
            // 命令ID：CEF3字典_取类型
            // [52] CEF3字典_取类型(字典句柄, 键)
            // 功能：取得指定键的CEF值类型。
            // 参数：字典句柄:longLong，键:wideString；返回：int；可见性：advanced
            CEF3字典_取类型(1, "演示参数2")
            // 命令ID：CEF3字典_设值
            // [53] CEF3字典_设值(字典句柄, 键, 值句柄)
            // 功能：深复制值并写入字典，避免跨所有权边界悬空。
            // 参数：字典句柄:longLong，键:wideString，值句柄:longLong；返回：int；可见性：advanced
            CEF3字典_设值(1, "演示参数2", 1)
            // 命令ID：CEF3字典_取值
            // [54] CEF3字典_取值(字典句柄, 键)
            // 功能：返回字典值的独立深复制受管句柄。
            // 参数：字典句柄:longLong，键:wideString；返回：longLong；可见性：advanced
            CEF3字典_取值(1, "演示参数2")
            // 命令ID：CEF3字典_删除
            // [55] CEF3字典_删除(字典句柄, 键)
            // 功能：删除指定字典键。
            // 参数：字典句柄:longLong，键:wideString；返回：int；可见性：advanced
            CEF3字典_删除(1, "演示参数2")
            // 命令ID：CEF3字典_清空
            // [56] CEF3字典_清空(字典句柄)
            // 功能：清空CEF字典。
            // 参数：字典句柄:longLong；返回：int；可见性：advanced
            CEF3字典_清空(1)
            // 命令ID：CEF3字典_到JSON
