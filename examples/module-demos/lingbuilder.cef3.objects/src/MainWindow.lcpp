            // 功能：取得重定向前的原始URL。
            // 参数：导航项句柄:longLong；返回：wideString；可见性：advanced
            CEF3导航项_取原始地址(1)
            // 命令ID：CEF3导航项_取标题
            // [154] CEF3导航项_取标题(导航项句柄)
            // 功能：取得导航项页面标题。
            // 参数：导航项句柄:longLong；返回：wideString；可见性：advanced
            CEF3导航项_取标题(1)
            // 命令ID：CEF3导航项_取跳转类型
            // [155] CEF3导航项_取跳转类型(导航项句柄)
            // 功能：取得导航跳转类型枚举。
            // 参数：导航项句柄:longLong；返回：int；可见性：advanced
            CEF3导航项_取跳转类型(1)
            // 命令ID：CEF3导航项_是否含提交数据
            // [156] CEF3导航项_是否含提交数据(导航项句柄)
            // 功能：判断本次导航是否包含POST数据。
            // 参数：导航项句柄:longLong；返回：int；可见性：advanced
            CEF3导航项_是否含提交数据(1)
            // 命令ID：CEF3导航项_取完成时间
            // [157] CEF3导航项_取完成时间(导航项句柄)
            // 功能：取得最后成功完成导航的Unix秒时间，未完成时为0。
            // 参数：导航项句柄:longLong；返回：double；可见性：advanced
            CEF3导航项_取完成时间(1)
            // 命令ID：CEF3导航项_取HTTP状态码
            // [158] CEF3导航项_取HTTP状态码(导航项句柄)
            // 功能：取得最后成功导航响应的HTTP状态码。
            // 参数：导航项句柄:longLong；返回：int；可见性：advanced
            CEF3导航项_取HTTP状态码(1)
            // 命令ID：CEF3导航项_释放
            // [159] CEF3导航项_释放(导航项句柄)
            // 功能：释放导航项快照受管句柄。
            // 参数：导航项句柄:longLong；返回：int；可见性：advanced
            CEF3导航项_释放(1)
            // 命令ID：CEF3证书_取当前
            // [160] CEF3证书_取当前(控件名)
            // 功能：在CEF UI线程读取当前可见导航项的TLS证书并返回不可变受管快照。
            // 参数：控件名:controlRef；返回：longLong；可见性：advanced
            CEF3证书_取当前(演示CefBrowser控件)
            // 命令ID：CEF3证书_是否安全连接
            // [161] CEF3证书_是否安全连接(证书句柄)
            // 功能：判断证书快照对应导航是否为安全TLS连接。
            // 参数：证书句柄:longLong；返回：int；可见性：advanced
            CEF3证书_是否安全连接(1)
            // 命令ID：CEF3证书_取证书状态
            // [162] CEF3证书_取证书状态(证书句柄)
            // 功能：取得证书验证问题位掩码。
            // 参数：证书句柄:longLong；返回：longLong；可见性：advanced
            CEF3证书_取证书状态(1)
            // 命令ID：CEF3证书_取SSL版本
            // [163] CEF3证书_取SSL版本(证书句柄)
            // 功能：取得TLS连接版本枚举。
            // 参数：证书句柄:longLong；返回：int；可见性：advanced
            CEF3证书_取SSL版本(1)
            // 命令ID：CEF3证书_取内容状态
            // [164] CEF3证书_取内容状态(证书句柄)
            // 功能：取得页面安全内容状态位掩码。
            // 参数：证书句柄:longLong；返回：longLong；可见性：advanced
            CEF3证书_取内容状态(1)
            // 命令ID：CEF3证书_取主体
            // [165] CEF3证书_取主体(证书句柄)
            // 功能：取得证书主体受管快照句柄。
            // 参数：证书句柄:longLong；返回：longLong；可见性：advanced
            CEF3证书_取主体(1)
            // 命令ID：CEF3证书_取颁发者
            // [166] CEF3证书_取颁发者(证书句柄)
            // 功能：取得证书颁发者受管快照句柄。
            // 参数：证书句柄:longLong；返回：longLong；可见性：advanced
            CEF3证书_取颁发者(1)
            // 命令ID：CEF3证书_取序列号缓冲
            // [167] CEF3证书_取序列号缓冲(证书句柄)
            // 功能：复制证书DER序列号并返回受管缓冲。
            // 参数：证书句柄:longLong；返回：longLong；可见性：advanced
            CEF3证书_取序列号缓冲(1)
            // 命令ID：CEF3证书_取DER缓冲
            // [168] CEF3证书_取DER缓冲(证书句柄)
            // 功能：复制DER编码证书并返回受管缓冲。
            // 参数：证书句柄:longLong；返回：longLong；可见性：advanced
            CEF3证书_取DER缓冲(1)
            // 命令ID：CEF3证书_取PEM缓冲
            // [169] CEF3证书_取PEM缓冲(证书句柄)
            // 功能：复制PEM编码证书并返回受管缓冲。
            // 参数：证书句柄:longLong；返回：longLong；可见性：advanced
            CEF3证书_取PEM缓冲(1)
            // 命令ID：CEF3证书_取生效时间
            // [170] CEF3证书_取生效时间(证书句柄)
            // 功能：取得证书生效Unix秒时间。
            // 参数：证书句柄:longLong；返回：longLong；可见性：advanced
            CEF3证书_取生效时间(1)
            // 命令ID：CEF3证书_取失效时间
            // [171] CEF3证书_取失效时间(证书句柄)
            // 功能：取得证书失效Unix秒时间。
            // 参数：证书句柄:longLong；返回：longLong；可见性：advanced
            CEF3证书_取失效时间(1)
        如果结束
        调试输出("已查看 命令 153–171：CEF3导航项_取原始地址 至 CEF3证书_取失效时间；勾选允许实际执行后会使用演示参数调用。")
    结束

    事件 _运行第10组_被单击()
        控件_设置文本(演示状态, "命令 172–183：CEF3证书_取颁发链数量 至 CEF3证书主体_释放；源码内含完整签名、参数、返回值与调用。")
        如果 (控件_取勾选(允许实际执行))
            // 命令ID：CEF3证书_取颁发链数量
            // [172] CEF3证书_取颁发链数量(证书句柄)
            // 功能：取得证书颁发链项目数量。
            // 参数：证书句柄:longLong；返回：longLong；可见性：advanced
            CEF3证书_取颁发链数量(1)
            // 命令ID：CEF3证书_取DER颁发链项
            // [173] CEF3证书_取DER颁发链项(证书句柄, 索引)
            // 功能：复制指定DER颁发链项并返回受管缓冲。
            // 参数：证书句柄:longLong，索引:longLong；返回：longLong；可见性：advanced
            CEF3证书_取DER颁发链项(1, 1)
            // 命令ID：CEF3证书_取PEM颁发链项
            // [174] CEF3证书_取PEM颁发链项(证书句柄, 索引)
            // 功能：复制指定PEM颁发链项并返回受管缓冲。
            // 参数：证书句柄:longLong，索引:longLong；返回：longLong；可见性：advanced
            CEF3证书_取PEM颁发链项(1, 1)
            // 命令ID：CEF3证书_释放
            // [175] CEF3证书_释放(证书句柄)
            // 功能：释放证书受管快照。
            // 参数：证书句柄:longLong；返回：int；可见性：advanced
            CEF3证书_释放(1)
            // 命令ID：CEF3证书主体_取显示名
            // [176] CEF3证书主体_取显示名(主体句柄)
            // 功能：取得证书主体显示名。
            // 参数：主体句柄:longLong；返回：wideString；可见性：advanced
            CEF3证书主体_取显示名(1)
            // 命令ID：CEF3证书主体_取通用名
            // [177] CEF3证书主体_取通用名(主体句柄)
            // 功能：取得证书主体通用名。
            // 参数：主体句柄:longLong；返回：wideString；可见性：advanced
            CEF3证书主体_取通用名(1)
            // 命令ID：CEF3证书主体_取地区名
            // [178] CEF3证书主体_取地区名(主体句柄)
            // 功能：取得证书主体地区名。
            // 参数：主体句柄:longLong；返回：wideString；可见性：advanced
            CEF3证书主体_取地区名(1)
            // 命令ID：CEF3证书主体_取省州名
            // [179] CEF3证书主体_取省州名(主体句柄)
            // 功能：取得证书主体省或州名。
            // 参数：主体句柄:longLong；返回：wideString；可见性：advanced
            CEF3证书主体_取省州名(1)
            // 命令ID：CEF3证书主体_取国家名
            // [180] CEF3证书主体_取国家名(主体句柄)
            // 功能：取得证书主体国家名。
            // 参数：主体句柄:longLong；返回：wideString；可见性：advanced
            CEF3证书主体_取国家名(1)
            // 命令ID：CEF3证书主体_取组织JSON
            // [181] CEF3证书主体_取组织JSON(主体句柄)
            // 功能：取得组织名称UTF-16 JSON数组。
            // 参数：主体句柄:longLong；返回：wideString；可见性：advanced
            CEF3证书主体_取组织JSON(1)
            // 命令ID：CEF3证书主体_取组织单位JSON
            // [182] CEF3证书主体_取组织单位JSON(主体句柄)
            // 功能：取得组织单位名称UTF-16 JSON数组。
            // 参数：主体句柄:longLong；返回：wideString；可见性：advanced
            CEF3证书主体_取组织单位JSON(1)
            // 命令ID：CEF3证书主体_释放
            // [183] CEF3证书主体_释放(主体句柄)
            // 功能：释放证书主体受管快照。
            // 参数：主体句柄:longLong；返回：int；可见性：advanced
            CEF3证书主体_释放(1)
        如果结束
        调试输出("已查看 命令 172–183：CEF3证书_取颁发链数量 至 CEF3证书主体_释放；勾选允许实际执行后会使用演示参数调用。")
    结束

结束类
