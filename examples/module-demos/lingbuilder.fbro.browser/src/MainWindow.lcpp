            // 参数：名称:wideString；返回：bool；可见性：default
            浏览器管理器_重命名当前("演示参数1")
            // 命令ID：浏览器管理器_删除当前
            // [98] 浏览器管理器_删除当前(清除数据)
            // 功能：删除当前实例并可选二次确认清除受管 Profile；始终保留至少一个实例。
            // 参数：清除数据:bool；返回：wideString；可见性：default
            浏览器管理器_删除当前(真)
            // 命令ID：浏览器管理器_导航
            // [99] 浏览器管理器_导航(地址)
            // 功能：让当前独立 Host 导航并持久化最后地址，不限制协议；chrome://extensions/ 在嵌入式 Alloy 模式中显示 LingBuilder 的真实扩展检查页。
            // 参数：地址:wideString；返回：bool；可见性：default
            浏览器管理器_导航("https://example.com")
            // 命令ID：浏览器管理器_后退
            // [100] 浏览器管理器_后退()
            // 功能：当前实例后退。
            // 参数：无；返回：bool；可见性：default
            浏览器管理器_后退()
            // 命令ID：浏览器管理器_前进
            // [101] 浏览器管理器_前进()
            // 功能：当前实例前进。
            // 参数：无；返回：bool；可见性：default
            浏览器管理器_前进()
            // 命令ID：浏览器管理器_刷新
            // [102] 浏览器管理器_刷新()
            // 功能：刷新当前实例。
            // 参数：无；返回：bool；可见性：default
            浏览器管理器_刷新()
            // 命令ID：浏览器管理器_停止
            // [103] 浏览器管理器_停止()
            // 功能：停止当前实例加载。
            // 参数：无；返回：bool；可见性：default
            浏览器管理器_停止()
            // 命令ID：浏览器管理器_强制刷新
            // [104] 浏览器管理器_强制刷新()
            // 功能：忽略缓存刷新当前实例。
            // 参数：无；返回：bool；可见性：default
            浏览器管理器_强制刷新()
            // 命令ID：浏览器管理器_打开当前缓存目录
            // [105] 浏览器管理器_打开当前缓存目录()
            // 功能：打开通过规范路径和重解析点边界校验的当前 Profile。
            // 参数：无；返回：bool；可见性：default
            浏览器管理器_打开当前缓存目录()
            // 命令ID：浏览器管理器_打开当前下载目录
            // [106] 浏览器管理器_打开当前下载目录()
            // 功能：验证最近下载目录真实存在后，在 Windows 文件资源管理器中打开。
            // 参数：无；返回：bool；可见性：default
            浏览器管理器_打开当前下载目录()
            // 命令ID：浏览器管理器_清理当前缓存
            // [107] 浏览器管理器_清理当前缓存(包含Cookie)
            // 功能：调用当前 FBro Host 清理真实缓存；包含 Cookie 时同时清理登录和插件存储。
            // 参数：包含Cookie:bool；返回：bool；可见性：default
            浏览器管理器_清理当前缓存(真)
            // 命令ID：浏览器管理器_导出Cookie
            // [108] 浏览器管理器_导出Cookie(文件, 全部网站)
            // 功能：预览数量和敏感信息警告后，从当前 Host 的 CookieManager 原子导出结构化 JSON。
            // 参数：文件:wideString，全部网站:bool；返回：wideString；可见性：default
            浏览器管理器_导出Cookie("module-demo-temp.txt", 真)
            // 命令ID：浏览器管理器_导入Cookie
            // [109] 浏览器管理器_导入Cookie(文件, 覆盖冲突)
            // 功能：预览有效、无效、过期、域名和冲突统计后写入当前 Host，并刷新页面。
            // 参数：文件:wideString，覆盖冲突:bool；返回：wideString；可见性：default
            浏览器管理器_导入Cookie("module-demo-temp.txt", 真)
            // 命令ID：浏览器管理器_取当前稳定ID
            // [110] 浏览器管理器_取当前稳定ID()
            // 功能：返回当前实例稳定 ID。
            // 参数：无；返回：wideString；可见性：default
            浏览器管理器_取当前稳定ID()
            // 命令ID：浏览器管理器_取当前名称
            // [111] 浏览器管理器_取当前名称()
            // 功能：返回当前实例显示名称。
            // 参数：无；返回：wideString；可见性：default
            浏览器管理器_取当前名称()
            // 命令ID：浏览器管理器_取当前地址
            // [112] 浏览器管理器_取当前地址()
            // 功能：返回当前实例最后地址。
            // 参数：无；返回：wideString；可见性：default
            浏览器管理器_取当前地址()
            // 命令ID：浏览器管理器_取当前插件状态
            // [113] 浏览器管理器_取当前插件状态()
            // 功能：返回当前实例扩展登记及豆包页面 DOM 生效检查状态。
            // 参数：无；返回：wideString；可见性：default
            浏览器管理器_取当前插件状态()
            // 命令ID：浏览器管理器_取当前插件错误
            // [114] 浏览器管理器_取当前插件错误()
            // 功能：返回当前实例插件清单或加载错误。
            // 参数：无；返回：wideString；可见性：default
            浏览器管理器_取当前插件错误()
        如果结束
        调试输出("已查看 命令 96–114：浏览器管理器_切换索引 至 浏览器管理器_取当前插件错误；勾选允许实际执行后会使用演示参数调用。")
    结束

    事件 _运行第07组_被单击()
        控件_设置文本(演示状态, "命令 115–133：浏览器管理器_取当前下载状态 至 FBro_区域后退；源码内含完整签名、参数、返回值与调用。")
        如果 (控件_取勾选(允许实际执行))
