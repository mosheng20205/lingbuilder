包 FBro指纹浏览器模块完整演示
使用 Win32窗口基础模块
使用 FBro指纹浏览器模块

// 本项目由模块清单自动生成；每条 binding 命令都在下方具有真实调用语句。
// 为避免误删文件、启动进程、访问网络或操作设备，必须先勾选“允许实际执行”才会进入命令调用区。
类 MainWindow : 公开 窗口
    事件 _MainWindow_创建完毕()
        控件_设置选择项(命令分组选项卡, 0)
        控件_设置文本(演示状态, "FBro指纹浏览器模块：42 条命令，默认处于安全预览模式。")
        调试输出("已加载模块演示：lingbuilder.fbro.browser")
    结束

    事件 _运行第01组_被单击()
        控件_设置文本(演示状态, "命令 1–14：FBro_创建 至 FBro_是否静音；源码内含完整签名、参数、返回值与调用。")
        如果 (控件_取勾选(允许实际执行))
            // 命令ID：FBro_创建
            // [1] FBro_创建(控件名)
            // 功能：使用设计器属性创建指定 FBro 浏览器；空控件名创建当前窗口全部 FBro 控件。
            // 参数：控件名:controlRef；返回：int；可见性：default
            FBro_创建(演示FBroBrowser控件)
            // 命令ID：FBro_打开谷歌原生UI浏览器
            // [2] FBro_打开谷歌原生UI浏览器(控件名, 地址)
            // 功能：基于指定内嵌 FBro 实例的会话创建 Chrome Runtime 独立顶层浏览器；不接收或复用 LingBuilder 窗口句柄。
            // 参数：控件名:controlRef，地址:wideString；返回：int；可见性：default
            FBro_打开谷歌原生UI浏览器(演示FBroBrowser控件, "https://example.com")
            // 命令ID：FBro_关闭
            // [3] FBro_关闭(控件名)
            // 功能：关闭指定 FBro 浏览器并释放实例。
            // 参数：控件名:controlRef；返回：void；可见性：default
            FBro_关闭(演示FBroBrowser控件)
            // 命令ID：FBro_导航
            // [4] FBro_导航(控件名, 地址)
            // 功能：让指定 FBro 浏览器导航到目标地址。
            // 参数：控件名:controlRef，地址:wideString；返回：int；可见性：default
            FBro_导航(演示FBroBrowser控件, "https://example.com")
            // 命令ID：FBro_刷新
            // [5] FBro_刷新(控件名)
            // 功能：刷新指定 FBro 浏览器。
            // 参数：控件名:controlRef；返回：void；可见性：default
            FBro_刷新(演示FBroBrowser控件)
            // 命令ID：FBro_后退
            // [6] FBro_后退(控件名)
            // 功能：浏览器可以后退时返回上一页。
            // 参数：控件名:controlRef；返回：int；可见性：default
            FBro_后退(演示FBroBrowser控件)
            // 命令ID：FBro_前进
            // [7] FBro_前进(控件名)
            // 功能：浏览器可以前进时进入下一页。
            // 参数：控件名:controlRef；返回：int；可见性：default
            FBro_前进(演示FBroBrowser控件)
            // 命令ID：FBro_停止
            // [8] FBro_停止(控件名)
            // 功能：停止指定浏览器当前导航。
            // 参数：控件名:controlRef；返回：void；可见性：default
            FBro_停止(演示FBroBrowser控件)
            // 命令ID：FBro_是否可后退
            // [9] FBro_是否可后退(控件名)
            // 功能：返回指定浏览器当前是否存在可后退的历史记录。
            // 参数：控件名:controlRef；返回：int；可见性：default
            FBro_是否可后退(演示FBroBrowser控件)
            // 命令ID：FBro_是否可前进
            // [10] FBro_是否可前进(控件名)
            // 功能：返回指定浏览器当前是否存在可前进的历史记录。
            // 参数：控件名:controlRef；返回：int；可见性：default
            FBro_是否可前进(演示FBroBrowser控件)
            // 命令ID：FBro_是否加载中
            // [11] FBro_是否加载中(控件名)
            // 功能：返回指定浏览器是否正在加载页面。
            // 参数：控件名:controlRef；返回：int；可见性：default
            FBro_是否加载中(演示FBroBrowser控件)
            // 命令ID：FBro_取缩放级别
            // [12] FBro_取缩放级别(控件名)
            // 功能：读取浏览器宿主当前缩放级别。
            // 参数：控件名:controlRef；返回：double；可见性：default
            FBro_取缩放级别(演示FBroBrowser控件)
            // 命令ID：FBro_设置缩放级别
            // [13] FBro_设置缩放级别(控件名, 级别)
            // 功能：设置浏览器宿主缩放级别。
            // 参数：控件名:controlRef，级别:double；返回：int；可见性：default
            FBro_设置缩放级别(演示FBroBrowser控件, 1.0)
            // 命令ID：FBro_是否静音
            // [14] FBro_是否静音(控件名)
            // 功能：返回指定浏览器是否已静音。
            // 参数：控件名:controlRef；返回：int；可见性：default
            FBro_是否静音(演示FBroBrowser控件)
        如果结束
        调试输出("已查看 命令 1–14：FBro_创建 至 FBro_是否静音；勾选允许实际执行后会使用演示参数调用。")
    结束

    事件 _运行第02组_被单击()
        控件_设置文本(演示状态, "命令 15–28：FBro_设置静音 至 FBro_是否有视图；源码内含完整签名、参数、返回值与调用。")
        如果 (控件_取勾选(允许实际执行))
            // 命令ID：FBro_设置静音
            // [15] FBro_设置静音(控件名, 是否静音)
            // 功能：设置指定浏览器的音频静音状态。
            // 参数：控件名:controlRef，是否静音:bool；返回：int；可见性：default
            FBro_设置静音(演示FBroBrowser控件, 真)
            // 命令ID：FBro_设置焦点
            // [16] FBro_设置焦点(控件名, 是否聚焦)
            // 功能：向浏览器宿主发送焦点状态。
            // 参数：控件名:controlRef，是否聚焦:bool；返回：int；可见性：default
            FBro_设置焦点(演示FBroBrowser控件, 真)
            // 命令ID：FBro_查找
            // [17] FBro_查找(控件名, 文本, 向前, 区分大小写, 查找下一个)
            // 功能：在当前页面中查找文本。
            // 参数：控件名:controlRef，文本:wideString，向前:bool，区分大小写:bool，查找下一个:bool；返回：int；可见性：default
            FBro_查找(演示FBroBrowser控件, "演示参数2", 真, 真, 真)
            // 命令ID：FBro_停止查找
            // [18] FBro_停止查找(控件名, 清除选择)
            // 功能：停止页面查找并可选清除当前选择。
            // 参数：控件名:controlRef，清除选择:bool；返回：int；可见性：default
            FBro_停止查找(演示FBroBrowser控件, 真)
            // 命令ID：FBro_是否打开开发者工具
            // [19] FBro_是否打开开发者工具(控件名)
            // 功能：返回指定浏览器是否已有 DevTools 实例。
            // 参数：控件名:controlRef；返回：int；可见性：default
            FBro_是否打开开发者工具(演示FBroBrowser控件)
            // 命令ID：FBro_关闭开发者工具
            // [20] FBro_关闭开发者工具(控件名)
            // 功能：关闭指定浏览器的 DevTools。
            // 参数：控件名:controlRef；返回：int；可见性：default
            FBro_关闭开发者工具(演示FBroBrowser控件)
            // 命令ID：FBro_强制刷新
            // [21] FBro_强制刷新(控件名)
            // 功能：忽略缓存重新加载当前页面。
            // 参数：控件名:controlRef；返回：int；可见性：default
            FBro_强制刷新(演示FBroBrowser控件)
            // 命令ID：FBro_取浏览器标识
            // [22] FBro_取浏览器标识(控件名)
            // 功能：返回 FBro/CEF 分配的浏览器标识。
            // 参数：控件名:controlRef；返回：int；可见性：default
            FBro_取浏览器标识(演示FBroBrowser控件)
            // 命令ID：FBro_是否同一实例
            // [23] FBro_是否同一实例(控件名, 另一控件名)
            // 功能：判断两个受管控件是否引用同一个底层浏览器。
            // 参数：控件名:controlRef，另一控件名:controlRef；返回：int；可见性：default
            FBro_是否同一实例(演示FBroBrowser控件, 演示FBroBrowser控件)
            // 命令ID：FBro_是否弹出窗口
            // [24] FBro_是否弹出窗口(控件名)
            // 功能：返回底层浏览器是否为 popup。
            // 参数：控件名:controlRef；返回：int；可见性：default
            FBro_是否弹出窗口(演示FBroBrowser控件)
            // 命令ID：FBro_是否有文档
            // [25] FBro_是否有文档(控件名)
            // 功能：返回浏览器是否已加载文档。
            // 参数：控件名:controlRef；返回：int；可见性：default
            FBro_是否有文档(演示FBroBrowser控件)
            // 命令ID：FBro_尝试关闭
            // [26] FBro_尝试关闭(控件名)
            // 功能：请求浏览器按官方关闭协议完成关闭。
            // 参数：控件名:controlRef；返回：int；可见性：default
            FBro_尝试关闭(演示FBroBrowser控件)
            // 命令ID：FBro_设置宿主焦点
            // [27] FBro_设置宿主焦点(控件名, 是否聚焦)
            // 功能：设置浏览器宿主的焦点状态。
            // 参数：控件名:controlRef，是否聚焦:bool；返回：int；可见性：default
            FBro_设置宿主焦点(演示FBroBrowser控件, 真)
            // 命令ID：FBro_是否有视图
            // [28] FBro_是否有视图(控件名)
            // 功能：返回浏览器宿主是否具有可用视图。
            // 参数：控件名:controlRef；返回：int；可见性：default
            FBro_是否有视图(演示FBroBrowser控件)
        如果结束
        调试输出("已查看 命令 15–28：FBro_设置静音 至 FBro_是否有视图；勾选允许实际执行后会使用演示参数调用。")
    结束

    事件 _运行第03组_被单击()
        控件_设置文本(演示状态, "命令 29–42：FBro_设置自动调整大小 至 FBro_取最近错误；源码内含完整签名、参数、返回值与调用。")
        如果 (控件_取勾选(允许实际执行))
            // 命令ID：FBro_设置自动调整大小
            // [29] FBro_设置自动调整大小(控件名, 启用, 最小高度, 最小宽度, 最大高度, 最大宽度)
            // 功能：设置官方宿主自动调整大小范围；范围必须非负且最大值不小于最小值。
            // 参数：控件名:controlRef，启用:bool，最小高度:int，最小宽度:int，最大高度:int，最大宽度:int；返回：int；可见性：default
            FBro_设置自动调整大小(演示FBroBrowser控件, 真, 1, 1, 1, 1)
            // 命令ID：FBro_执行JS
            // [30] FBro_执行JS(控件名, 脚本)
            // 功能：通过桥接层执行 JavaScript，返回 UTF-16 结果或中文错误。
            // 参数：控件名:controlRef，脚本:wideString；返回：wideString；可见性：default
            FBro_执行JS(演示FBroBrowser控件, "演示参数2")
            // 命令ID：FBro_取标题
            // [31] FBro_取标题(控件名)
            // 功能：返回最近一次标题事件记录的网页标题。
            // 参数：控件名:controlRef；返回：wideString；可见性：default
            FBro_取标题(演示FBroBrowser控件)
            // 命令ID：FBro_取地址
            // [32] FBro_取地址(控件名)
            // 功能：返回指定浏览器当前地址。
            // 参数：控件名:controlRef；返回：wideString；可见性：default
            FBro_取地址(演示FBroBrowser控件)
            // 命令ID：FBro_设置代理
            // [33] FBro_设置代理(控件名, 代理地址)
            // 功能：设置创建前使用的代理地址；空文本表示直连。
            // 参数：控件名:controlRef，代理地址:wideString；返回：int；可见性：default
            FBro_设置代理(演示FBroBrowser控件, "https://example.com")
            // 命令ID：FBro_设置缓存目录
            // [34] FBro_设置缓存目录(控件名, 目录)
            // 功能：设置创建前使用的独立缓存目录。
            // 参数：控件名:controlRef，目录:wideString；返回：int；可见性：default
            FBro_设置缓存目录(演示FBroBrowser控件, ".")
            // 命令ID：FBro_设置UserAgent
            // [35] FBro_设置UserAgent(控件名, UserAgent)
            // 功能：设置创建前使用的 User-Agent。
            // 参数：控件名:controlRef，UserAgent:wideString；返回：int；可见性：default
            FBro_设置UserAgent(演示FBroBrowser控件, "演示参数2")
            // 命令ID：FBro_取Cookie
            // [36] FBro_取Cookie(控件名, 地址)
            // 功能：异步读取指定地址 Cookie；首版返回桥接层最近快照。
            // 参数：控件名:controlRef，地址:wideString；返回：wideString；可见性：default
            FBro_取Cookie(演示FBroBrowser控件, "https://example.com")
            // 命令ID：FBro_清空Cookie
            // [37] FBro_清空Cookie(控件名, 地址)
            // 功能：删除指定地址的 Cookie。
            // 参数：控件名:controlRef，地址:wideString；返回：int；可见性：default
            FBro_清空Cookie(演示FBroBrowser控件, "https://example.com")
            // 命令ID：FBro指纹_应用配置
            // [38] FBro指纹_应用配置(控件名, JSON)
            // 功能：应用结构化指纹 JSON；未配置 VIP 授权时返回 0 并记录中文错误。
            // 参数：控件名:controlRef，JSON:wideString；返回：int；可见性：default
            FBro指纹_应用配置(演示FBroBrowser控件, "{}")
            // 命令ID：FBro指纹_取调用次数
            // [39] FBro指纹_取调用次数(控件名)
            // 功能：返回 FBro VIP 指纹调用次数。
            // 参数：控件名:controlRef；返回：wideString；可见性：default
            FBro指纹_取调用次数(演示FBroBrowser控件)
            // 命令ID：FBro指纹_清空调用次数
            // [40] FBro指纹_清空调用次数(控件名)
            // 功能：清空指定浏览器的指纹调用次数。
            // 参数：控件名:controlRef；返回：int；可见性：default
            FBro指纹_清空调用次数(演示FBroBrowser控件)
            // 命令ID：FBro_取最近事件
            // [41] FBro_取最近事件(控件名)
            // 功能：返回最近 FBro 浏览器事件名。
            // 参数：控件名:controlRef；返回：wideString；可见性：default
            FBro_取最近事件(演示FBroBrowser控件)
            // 命令ID：FBro_取最近错误
            // [42] FBro_取最近错误(控件名)
            // 功能：返回桥接层最近中文错误。
            // 参数：控件名:controlRef；返回：wideString；可见性：default
            FBro_取最近错误(演示FBroBrowser控件)
        如果结束
        调试输出("已查看 命令 29–42：FBro_设置自动调整大小 至 FBro_取最近错误；勾选允许实际执行后会使用演示参数调用。")
    结束

结束类
