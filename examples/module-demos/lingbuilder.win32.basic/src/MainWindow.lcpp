包 Win32窗口基础模块完整演示
使用 Win32窗口基础模块

// 本项目由模块清单自动生成；每条 binding 命令都在下方具有真实调用语句。
// 为避免误删文件、启动进程、访问网络或操作设备，必须先勾选“允许实际执行”才会进入命令调用区。
类 MainWindow : 公开 窗口
    事件 _MainWindow_创建完毕()
        控件_设置选择项(命令分组选项卡, 0)
        控件_设置文本(演示状态, "Win32窗口基础模块：293 条命令，默认处于安全预览模式。")
        调试输出("已加载模块演示：lingbuilder.win32.basic")
    结束

    事件 _运行第01组_被单击()
        控件_设置文本(演示状态, "命令 1–25：信息框 至 控件_设置可见；源码内含完整签名、参数、返回值与调用。")
        如果 (控件_取勾选(允许实际执行))
            // 命令ID：信息框
            // [1] 信息框(内容, 标志, 标题)
            // 功能：显示一个 Win32 系统消息框。
            // 参数：内容:wideString，标志:int，标题:wideString；返回：int；可见性：default
            信息框("演示参数1", 1, "演示参数3")
            // 命令ID：调试输出
            // [2] 调试输出(参数1, 参数2, ...)
            // 功能：向调试输出窗口和控制台输出任意数量的文本、整数、逻辑值等参数，参数使用英文逗号分隔。
            // 参数：内容:lingValue；返回：void；可见性：default
            调试输出()
            // 命令ID：结束
            // [3] 结束()
            // 功能：关闭当前窗口。
            // 参数：无；返回：void；可见性：default
            结束()
            // 命令ID：延时
            // [4] 延时(等待毫秒)
            // 功能：同步等待指定毫秒；等待期间持续泵送本线程消息队列，窗口不冻结、控件仍可点击（与易语言「延时/程序_延时」一致）。等待期间触发的事件处理器会先执行，之后才继续执行本行后面的代码。
            // 参数：等待毫秒:int；返回：void；可见性：default
            延时(1)
            // 命令ID：延迟调用
            // [5] 延迟调用(等待毫秒, &处理器)
            // 功能：一次性延迟调用：等待指定毫秒后在界面线程调用 &处理器（无参数子程序），等待期间界面不冻结；到期只触发一次，窗口销毁后不再触发。需要周期性触发请用「时钟」组件。
            // 参数：等待毫秒:int，处理器:handler；返回：bool；可见性：default
            延迟调用(1, &模块演示回调)
            // 命令ID：时钟_启动
            // [6] 时钟_启动(组件名)
            // 功能：启动设计器「时钟」组件的周期计时，周期由组件属性或 时钟_置周期 决定；周期为 0 时无法启动。每次周期到期触发「周期到期」事件。
            // 参数：组件名:controlRef；返回：bool；可见性：default
            时钟_启动(演示Clock资源)
            // 命令ID：时钟_停止
            // [7] 时钟_停止(组件名)
            // 功能：停止「时钟」组件的周期计时；未启动的时钟返回真。
            // 参数：组件名:controlRef；返回：bool；可见性：default
            时钟_停止(演示Clock资源)
            // 命令ID：时钟_置周期
            // [8] 时钟_置周期(组件名, 周期毫秒)
            // 功能：设置「时钟」组件的计时周期；正在计时且周期大于 0 时立即按新周期重新计时，周期为 0 表示停止计时（与易语言时钟周期语义一致）。
            // 参数：组件名:controlRef，周期毫秒:int；返回：bool；可见性：default
            时钟_置周期(演示Clock资源, 1)
            // 命令ID：时钟_取周期
            // [9] 时钟_取周期(组件名)
            // 功能：返回「时钟」组件当前的计时周期毫秒数；未单独设置过时返回组件属性里的默认周期。
            // 参数：组件名:controlRef；返回：int；可见性：default
            时钟_取周期(演示Clock资源)
            // 命令ID：时钟_是否已启动
            // [10] 时钟_是否已启动(组件名)
            // 功能：判断「时钟」组件当前是否正在按周期计时。
            // 参数：组件名:controlRef；返回：bool；可见性：default
            时钟_是否已启动(演示Clock资源)
            // 命令ID：到文本
            // [11] 到文本(值)
            // 功能：把整数、长整数、小数、逻辑值或文本确定性转换为文本；逻辑值返回“真”或“假”。
            // 参数：值:raw；返回：wideString；可见性：default
            到文本(0)
            // 命令ID：格式化文本
            // [12] 格式化文本(格式模板, 参数...)
            // 功能：按顺序用参数替换格式模板中的 {}；使用 {{ 和 }} 输出字面量花括号。参数不足时保留未替换的 {}，多余参数忽略。
            // 参数：格式模板:wideString，参数:lingValue；返回：wideString；可见性：default
            格式化文本("演示参数1")
            // 命令ID：到整数
            // [13] 到整数(文本)
            // 功能：把文本转换为整数；空文本或无法转换的内容返回 0。
            // 参数：文本:wideString；返回：int；可见性：default
            到整数("演示参数1")
            // 命令ID：到长整数
            // [14] 到长整数(文本)
            // 功能：把文本转换为长整数（64 位整数）；空文本或无法转换的内容返回 0。与 到整数 用法一致，但不做 32 位截断，适合转换时间戳、文件大小、内存地址等大数值。
            // 参数：文本:wideString；返回：longLong；可见性：default
            到长整数("演示参数1")
            // 命令ID：到小数
            // [15] 到小数(文本)
            // 功能：把文本转换为小数（双精度）；忽略首尾空白，空文本或无法转换的内容返回 0。
            // 参数：文本:wideString；返回：double；可见性：default
            到小数("演示参数1")
            // 命令ID：到单精度小数
            // [16] 到单精度小数(文本)
            // 功能：把文本转换为单精度小数；忽略首尾空白，空文本或无法转换的内容返回 0。需要与单精度小数型变量或单精度参数对接时用它，精度低于 到小数。
            // 参数：文本:wideString；返回：float；可见性：default
            到单精度小数("演示参数1")
            // 命令ID：到逻辑
            // [17] 到逻辑(文本)
            // 功能：把文本转换为逻辑值：空文本、“0”、“假”返回假，非零数值与“真”返回真，其余非空文本（如“是”“yes”）也返回真。
            // 参数：文本:wideString；返回：bool；可见性：default
            到逻辑("演示参数1")
            // 命令ID：取鼠标水平位置
            // [18] 取鼠标水平位置()
            // 功能：返回鼠标指针当前相对于屏幕左边的水平位置，单位为像素点。初级命令。
            // 参数：无；返回：int；可见性：default
            取鼠标水平位置()
            // 命令ID：取鼠标垂直位置
            // [19] 取鼠标垂直位置()
            // 功能：返回鼠标指针当前相对于屏幕顶边的垂直位置，单位为像素点。初级命令。
            // 参数：无；返回：int；可见性：default
            取鼠标垂直位置()
            // 命令ID：设置鼠标位置
            // [20] 设置鼠标位置(横, 纵)
            // 功能：把鼠标指针移动到指定的屏幕坐标（SetCursorPos 语义），成功返回真；坐标单位为像素点，与 取鼠标水平位置/取鼠标垂直位置 对应。初级命令。
            // 参数：横:int，纵:int；返回：bool；可见性：default
            设置鼠标位置(1, 1)
            // 命令ID：控件_设置文本
            // [21] 控件_设置文本(控件名, 文本)
            // 功能：设置当前窗口中指定控件的文本。
            // 参数：控件名:controlRef，文本:wideString；返回：bool；可见性：default
            控件_设置文本(演示状态, "演示参数2")
            // 命令ID：控件_设置图片
            // [22] 控件_设置图片(控件名, 图片路径)
            // 功能：设置图片框显示的本地图片；支持项目 assets 相对路径或本地完整路径，空路径清空图片。
            // 参数：控件名:controlRef，图片路径:wideString；返回：bool；可见性：default
            控件_设置图片(演示状态, "module-demo-temp.txt")
            // 命令ID：控件_取文本
            // [23] 控件_取文本(控件名)
            // 功能：读取指定控件的当前文本。
            // 参数：控件名:controlRef；返回：wideString；可见性：default
            控件_取文本(演示状态)
            // 命令ID：控件_设置启用
            // [24] 控件_设置启用(控件名, 启用)
            // 功能：启用或禁用指定控件。
            // 参数：控件名:controlRef，启用:bool；返回：bool；可见性：default
            控件_设置启用(演示状态, 真)
            // 命令ID：控件_设置可见
            // [25] 控件_设置可见(控件名, 可见)
            // 功能：显示或隐藏指定控件。
            // 参数：控件名:controlRef，可见:bool；返回：bool；可见性：default
            控件_设置可见(演示状态, 真)
        如果结束
        调试输出("已查看 命令 1–25：信息框 至 控件_设置可见；勾选允许实际执行后会使用演示参数调用。")
    结束

    事件 _运行第02组_被单击()
        控件_设置文本(演示状态, "命令 26–50：控件_设置位置大小 至 控件_设置选中标记颜色；源码内含完整签名、参数、返回值与调用。")
        如果 (控件_取勾选(允许实际执行))
            // 命令ID：控件_设置位置大小
            // [26] 控件_设置位置大小(控件名, 横坐标, 纵坐标, 宽度, 高度)
            // 功能：按逻辑坐标（与设计器坐标一致，自动按窗口 DPI 缩放）移动指定控件并调整大小，适合在创建完毕或窗口大小事件中实现自适应布局。
            // 参数：控件名:controlRef，横坐标:int，纵坐标:int，宽度:int，高度:int；返回：bool；可见性：default
            控件_设置位置大小(演示状态, 1, 1, 1, 1)
            // 命令ID：控件_设置勾选
            // [27] 控件_设置勾选(控件名, 勾选)
            // 功能：设置复选框、单选框或切换按钮状态。
            // 参数：控件名:controlRef，勾选:bool；返回：bool；可见性：default
            控件_设置勾选(演示状态, 真)
            // 命令ID：控件_取勾选
            // [28] 控件_取勾选(控件名)
            // 功能：读取控件勾选状态。
            // 参数：控件名:controlRef；返回：bool；可见性：default
            控件_取勾选(演示状态)
            // 命令ID：控件_设置数值
            // [29] 控件_设置数值(控件名, 数值)
            // 功能：设置进度条、滑块、调节器或滚动条数值。
            // 参数：控件名:controlRef，数值:int；返回：bool；可见性：default
            控件_设置数值(演示状态, 1)
            // 命令ID：控件_取数值
            // [30] 控件_取数值(控件名)
            // 功能：读取数值型控件当前值。
            // 参数：控件名:controlRef；返回：int；可见性：default
            控件_取数值(演示状态)
            // 命令ID：控件_设置选择项
            // [31] 控件_设置选择项(控件名, 索引)
            // 功能：设置列表、组合框、列表视图或选项卡选择项。
            // 参数：控件名:controlRef，索引:int；返回：bool；可见性：default
            控件_设置选择项(演示状态, 1)
            // 命令ID：控件_取选择项
            // [32] 控件_取选择项(控件名)
            // 功能：读取选择项索引。
            // 参数：控件名:controlRef；返回：int；可见性：default
            控件_取选择项(演示状态)
            // 命令ID：控件_添加项目
            // [33] 控件_添加项目(控件名, 文本)
            // 功能：向列表框、组合框或增强组合框追加项目。
            // 参数：控件名:controlRef，文本:wideString；返回：int；可见性：default
            控件_添加项目(演示状态, "演示参数2")
            // 命令ID：控件_清空项目
            // [34] 控件_清空项目(控件名)
            // 功能：清空集合控件项目。
            // 参数：控件名:controlRef；返回：bool；可见性：default
            控件_清空项目(演示状态)
            // 命令ID：控件_设置只读
            // [35] 控件_设置只读(控件名, 是否只读)
            // 功能：运行期设置编辑框（或富文本框）只读状态：只读时用户不能输入修改，程序仍可用 控件_设置文本 写入。传假解除只读。
            // 参数：控件名:controlRef，是否只读:bool；返回：bool；可见性：default
            控件_设置只读(演示状态, 真)
            // 命令ID：控件_设置密码输入
            // [36] 控件_设置密码输入(控件名, 是否密码)
            // 功能：运行期把编辑框切换为密码掩码（以 * 回显）或恢复明文，等价于设计器「密码输入」属性的运行期开关。
            // 参数：控件名:controlRef，是否密码:bool；返回：bool；可见性：default
            控件_设置密码输入(演示状态, 真)
            // 命令ID：控件_设置提示文字
            // [37] 控件_设置提示文字(控件名, 占位文本)
            // 功能：运行期设置编辑框的占位提示：内容为空时显示灰字，输入或写入内容后自动消失；传空文本清除提示。等价于设计器「占位提示」属性的运行期改写。
            // 参数：控件名:controlRef，占位文本:wideString；返回：bool；可见性：default
            控件_设置提示文字(演示状态, "演示参数2")
            // 命令ID：编辑框_滚动
            // [38] 编辑框_滚动(控件名, 行数)
            // 功能：运行期滚动多行编辑框的内容：正数向下滚动、负数向上滚动，单位为行；已到边界时停在首行或末行。单行编辑框不支持，返回假。
            // 参数：控件名:controlRef，行数:int；返回：bool；可见性：default
            编辑框_滚动(演示状态, 1)
            // 命令ID：编辑框_滚动到底
            // [39] 编辑框_滚动到底(控件名)
            // 功能：把多行编辑框滚动到内容末尾（无需控件获得焦点），适合日志或接收框追加内容后定位到最新一行；单行编辑框不支持，返回假。
            // 参数：控件名:controlRef；返回：bool；可见性：default
            编辑框_滚动到底(演示状态)
            // 命令ID：控件_设置数值范围
            // [40] 控件_设置数值范围(控件名, 最小值, 最大值)
            // 功能：运行期设置进度条、滑块、数值调节器或滚动条的数值范围，当前值自动钳制到新范围；后续 控件_设置数值 也按新范围钳制。最小值大于最大值时自动交换。
            // 参数：控件名:controlRef，最小值:int，最大值:int；返回：bool；可见性：default
            控件_设置数值范围(演示状态, 1, 1)
            // 命令ID：控件_设置不确定进度
            // [41] 控件_设置不确定进度(控件名, 是否)
            // 功能：运行期把进度条切换为不确定进度（跑马灯往复动画），适合耗时未知的长任务；传假恢复确定进度。
            // 参数：控件名:controlRef，是否:bool；返回：bool；可见性：default
            控件_设置不确定进度(演示状态, 真)
            // 命令ID：控件_插入项目
            // [42] 控件_插入项目(控件名, 索引, 文本)
            // 功能：向列表框或组合框的指定零基索引插入项目；索引 -1 追加到末尾，返回实际插入索引，失败返回 -1。
            // 参数：控件名:controlRef，索引:int，文本:wideString；返回：int；可见性：default
            控件_插入项目(演示状态, 1, "演示参数3")
            // 命令ID：控件_删除项目
            // [43] 控件_删除项目(控件名, 索引)
            // 功能：删除列表框或组合框指定零基索引的项目；索引越界或控件不支持时返回假。
            // 参数：控件名:controlRef，索引:int；返回：bool；可见性：default
            控件_删除项目(演示状态, 1)
            // 命令ID：控件_修改项目
            // [44] 控件_修改项目(控件名, 索引, 文本)
            // 功能：修改列表框或组合框指定零基索引的项目文本（整行替换，选中项按位移保持）。列表框是单列控件，没有行×列单元格；要修改某行某列的单元格请用 列表视图_设置单元格（列表视图）或 表格_置文本（数据表格）。
            // 参数：控件名:controlRef，索引:int，文本:wideString；返回：bool；可见性：default
            控件_修改项目(演示状态, 1, "演示参数3")
            // 命令ID：控件_取项目文本
            // [45] 控件_取项目文本(控件名, 索引)
            // 功能：读取列表框或组合框指定零基索引的项目文本；索引越界返回空文本。
            // 参数：控件名:controlRef，索引:int；返回：wideString；可见性：default
            控件_取项目文本(演示状态, 1)
            // 命令ID：控件_取项目数量
            // [46] 控件_取项目数量(控件名)
            // 功能：返回列表框或组合框当前的项目数量。
            // 参数：控件名:controlRef；返回：int；可见性：default
            控件_取项目数量(演示状态)
            // 命令ID：列表框_滚动到项
            // [47] 列表框_滚动到项(控件名, 索引)
            // 功能：把列表框滚动到指定零基索引的项目，使其成为顶部可见项（等价 LB_SETTOPINDEX）；常用于追加项目后定位到最新一条。索引越界或控件不是列表框返回假。
            // 参数：控件名:controlRef，索引:int；返回：bool；可见性：default
            列表框_滚动到项(演示状态, 1)
