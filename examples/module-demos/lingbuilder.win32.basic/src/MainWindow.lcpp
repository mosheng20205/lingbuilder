包 Win32窗口基础模块完整演示
使用 Win32窗口基础模块

// 本项目由模块清单自动生成；每条 binding 命令都在下方具有真实调用语句。
// 为避免误删文件、启动进程、访问网络或操作设备，必须先勾选“允许实际执行”才会进入命令调用区。
类 MainWindow : 公开 窗口
    事件 _MainWindow_创建完毕()
        控件_设置选择项(命令分组选项卡, 0)
        控件_设置文本(演示状态, "Win32窗口基础模块：206 条命令，默认处于安全预览模式。")
        调试输出("已加载模块演示：lingbuilder.win32.basic")
    结束

    事件 _运行第01组_被单击()
        控件_设置文本(演示状态, "命令 1–19：信息框 至 控件_设置选择项；源码内含完整签名、参数、返回值与调用。")
        如果 (控件_取勾选(允许实际执行))
            // 命令ID：信息框
            // [1] 信息框(内容, 标志, 标题)
            // 功能：显示一个 Win32 系统消息框。
            // 参数：内容:wideString，标志:int，标题:wideString；返回：int；可见性：default
            信息框("演示参数1", 1, "演示参数3")
            // 命令ID：调试输出
            // [2] 调试输出(参数1, 参数2, ...)
            // 功能：向调试输出窗口和控制台输出任意数量的文本、整数、逻辑值等参数，参数使用英文逗号分隔。
            // 参数：内容:lingValue；返回：void；可见性：default
            调试输出()
            // 命令ID：结束
            // [3] 结束()
            // 功能：关闭当前窗口。
            // 参数：无；返回：void；可见性：default
            结束()
            // 命令ID：到文本
            // [4] 到文本(值)
            // 功能：把整数、长整数、小数、逻辑值或文本确定性转换为文本；逻辑值返回“真”或“假”。
            // 参数：值:raw；返回：wideString；可见性：default
            到文本(0)
            // 命令ID：格式化文本
            // [5] 格式化文本(格式模板, 参数...)
            // 功能：按顺序用参数替换格式模板中的 {}；使用 {{ 和 }} 输出字面量花括号。参数不足时保留未替换的 {}，多余参数忽略。
            // 参数：格式模板:wideString，参数:raw；返回：wideString；可见性：default
            格式化文本("演示参数1", 0)
            // 命令ID：到整数
            // [6] 到整数(文本)
            // 功能：把文本转换为整数；空文本或无法转换的内容返回 0。
            // 参数：文本:wideString；返回：int；可见性：default
            到整数("演示参数1")
            // 命令ID：取鼠标水平位置
            // [7] 取鼠标水平位置()
            // 功能：返回鼠标指针当前相对于屏幕左边的水平位置，单位为像素点。初级命令。
            // 参数：无；返回：int；可见性：default
            取鼠标水平位置()
            // 命令ID：取鼠标垂直位置
            // [8] 取鼠标垂直位置()
            // 功能：返回鼠标指针当前相对于屏幕顶边的垂直位置，单位为像素点。初级命令。
            // 参数：无；返回：int；可见性：default
            取鼠标垂直位置()
            // 命令ID：控件_设置文本
            // [9] 控件_设置文本(控件名, 文本)
            // 功能：设置当前窗口中指定控件的文本。
            // 参数：控件名:controlRef，文本:wideString；返回：bool；可见性：default
            控件_设置文本(演示状态, "演示参数2")
            // 命令ID：控件_设置图片
            // [10] 控件_设置图片(控件名, 图片路径)
            // 功能：设置图片框显示的本地图片；支持项目 assets 相对路径或本地完整路径，空路径清空图片。
            // 参数：控件名:controlRef，图片路径:wideString；返回：bool；可见性：default
            控件_设置图片(演示状态, "module-demo-temp.txt")
            // 命令ID：控件_取文本
            // [11] 控件_取文本(控件名)
            // 功能：读取指定控件的当前文本。
            // 参数：控件名:controlRef；返回：wideString；可见性：default
            控件_取文本(演示状态)
            // 命令ID：控件_设置启用
            // [12] 控件_设置启用(控件名, 启用)
            // 功能：启用或禁用指定控件。
            // 参数：控件名:controlRef，启用:bool；返回：bool；可见性：default
            控件_设置启用(演示状态, 真)
            // 命令ID：控件_设置可见
            // [13] 控件_设置可见(控件名, 可见)
            // 功能：显示或隐藏指定控件。
            // 参数：控件名:controlRef，可见:bool；返回：bool；可见性：default
            控件_设置可见(演示状态, 真)
            // 命令ID：控件_设置位置大小
            // [14] 控件_设置位置大小(控件名, 横坐标, 纵坐标, 宽度, 高度)
            // 功能：按当前窗口客户区像素坐标移动指定控件并调整大小，适合在窗口大小事件中实现自适应布局。
            // 参数：控件名:controlRef，横坐标:int，纵坐标:int，宽度:int，高度:int；返回：bool；可见性：default
            控件_设置位置大小(演示状态, 1, 1, 1, 1)
            // 命令ID：控件_设置勾选
            // [15] 控件_设置勾选(控件名, 勾选)
            // 功能：设置复选框、单选框或切换按钮状态。
            // 参数：控件名:controlRef，勾选:bool；返回：bool；可见性：default
            控件_设置勾选(演示状态, 真)
            // 命令ID：控件_取勾选
            // [16] 控件_取勾选(控件名)
            // 功能：读取控件勾选状态。
            // 参数：控件名:controlRef；返回：bool；可见性：default
            控件_取勾选(演示状态)
            // 命令ID：控件_设置数值
            // [17] 控件_设置数值(控件名, 数值)
            // 功能：设置进度条、滑块、调节器或滚动条数值。
            // 参数：控件名:controlRef，数值:int；返回：bool；可见性：default
            控件_设置数值(演示状态, 1)
            // 命令ID：控件_取数值
            // [18] 控件_取数值(控件名)
            // 功能：读取数值型控件当前值。
            // 参数：控件名:controlRef；返回：int；可见性：default
            控件_取数值(演示状态)
            // 命令ID：控件_设置选择项
            // [19] 控件_设置选择项(控件名, 索引)
            // 功能：设置列表、组合框、列表视图或选项卡选择项。
            // 参数：控件名:controlRef，索引:int；返回：bool；可见性：default
            控件_设置选择项(演示状态, 1)
        如果结束
        调试输出("已查看 命令 1–19：信息框 至 控件_设置选择项；勾选允许实际执行后会使用演示参数调用。")
    结束

    事件 _运行第02组_被单击()
        控件_设置文本(演示状态, "命令 20–38：控件_取选择项 至 通过标记整数获取单选框；源码内含完整签名、参数、返回值与调用。")
        如果 (控件_取勾选(允许实际执行))
            // 命令ID：控件_取选择项
            // [20] 控件_取选择项(控件名)
            // 功能：读取选择项索引。
            // 参数：控件名:controlRef；返回：int；可见性：default
            控件_取选择项(演示状态)
            // 命令ID：控件_添加项目
            // [21] 控件_添加项目(控件名, 文本)
            // 功能：向列表框、组合框或增强组合框追加项目。
            // 参数：控件名:controlRef，文本:wideString；返回：int；可见性：default
            控件_添加项目(演示状态, "演示参数2")
            // 命令ID：控件_清空项目
            // [22] 控件_清空项目(控件名)
            // 功能：清空集合控件项目。
            // 参数：控件名:controlRef；返回：bool；可见性：default
            控件_清空项目(演示状态)
            // 命令ID：控件_是否有效
            // [23] 控件_是否有效(控件)
            // 功能：判断类型化控件引用是否仍指向当前窗口内存活的控件。
            // 参数：控件:controlRef；返回：bool；可见性：default
            控件_是否有效(演示状态)
            // 命令ID：控件_创建按钮
            // [24] 控件_创建按钮(父级, 横坐标, 纵坐标, 宽度, 高度, 文本, [标记文本], [标记整数])
            // 功能：在当前窗口运行时创建按钮；窗口拥有生命周期，代码获得非拥有型引用。
            // 参数：父级:controlRef，横坐标:int，纵坐标:int，宽度:int，高度:int，文本:wideString，标记文本:wideString，标记整数:int；返回：按钮；可见性：default
            控件_创建按钮(演示状态, 1, 1, 1, 1, "演示参数6", "演示参数7", 1)
            // 命令ID：通过标记文本获取按钮
            // [25] 通过标记文本获取按钮(标记文本)
            // 功能：在当前窗口按区分大小写的非空文本标记查找按钮，找不到时返回无效引用。
            // 参数：标记文本:wideString；返回：按钮；可见性：default
            通过标记文本获取按钮("演示参数1")
            // 命令ID：通过标记整数获取按钮
            // [26] 通过标记整数获取按钮(标记整数)
            // 功能：在当前窗口按有符号 32 位整数标记查找按钮，找不到时返回无效引用。
            // 参数：标记整数:int；返回：按钮；可见性：default
            通过标记整数获取按钮(1)
            // 命令ID：控件_创建编辑框
            // [27] 控件_创建编辑框(父级, 横坐标, 纵坐标, 宽度, 高度, 文本, [标记文本], [标记整数])
            // 功能：在当前窗口运行时创建编辑框；窗口拥有生命周期，代码获得非拥有型引用。
            // 参数：父级:controlRef，横坐标:int，纵坐标:int，宽度:int，高度:int，文本:wideString，标记文本:wideString，标记整数:int；返回：编辑框；可见性：default
            控件_创建编辑框(演示状态, 1, 1, 1, 1, "演示参数6", "演示参数7", 1)
            // 命令ID：通过标记文本获取编辑框
            // [28] 通过标记文本获取编辑框(标记文本)
            // 功能：在当前窗口按区分大小写的非空文本标记查找编辑框，找不到时返回无效引用。
            // 参数：标记文本:wideString；返回：编辑框；可见性：default
            通过标记文本获取编辑框("演示参数1")
            // 命令ID：通过标记整数获取编辑框
            // [29] 通过标记整数获取编辑框(标记整数)
            // 功能：在当前窗口按有符号 32 位整数标记查找编辑框，找不到时返回无效引用。
            // 参数：标记整数:int；返回：编辑框；可见性：default
            通过标记整数获取编辑框(1)
            // 命令ID：控件_创建标签
            // [30] 控件_创建标签(父级, 横坐标, 纵坐标, 宽度, 高度, 文本, [标记文本], [标记整数])
            // 功能：在当前窗口运行时创建标签；窗口拥有生命周期，代码获得非拥有型引用。
            // 参数：父级:controlRef，横坐标:int，纵坐标:int，宽度:int，高度:int，文本:wideString，标记文本:wideString，标记整数:int；返回：标签；可见性：default
            控件_创建标签(演示状态, 1, 1, 1, 1, "演示参数6", "演示参数7", 1)
            // 命令ID：通过标记文本获取标签
            // [31] 通过标记文本获取标签(标记文本)
            // 功能：在当前窗口按区分大小写的非空文本标记查找标签，找不到时返回无效引用。
            // 参数：标记文本:wideString；返回：标签；可见性：default
            通过标记文本获取标签("演示参数1")
            // 命令ID：通过标记整数获取标签
            // [32] 通过标记整数获取标签(标记整数)
            // 功能：在当前窗口按有符号 32 位整数标记查找标签，找不到时返回无效引用。
            // 参数：标记整数:int；返回：标签；可见性：default
            通过标记整数获取标签(1)
            // 命令ID：控件_创建复选框
            // [33] 控件_创建复选框(父级, 横坐标, 纵坐标, 宽度, 高度, 文本, [标记文本], [标记整数])
            // 功能：在当前窗口运行时创建复选框；窗口拥有生命周期，代码获得非拥有型引用。
            // 参数：父级:controlRef，横坐标:int，纵坐标:int，宽度:int，高度:int，文本:wideString，标记文本:wideString，标记整数:int；返回：复选框；可见性：default
            控件_创建复选框(演示状态, 1, 1, 1, 1, "演示参数6", "演示参数7", 1)
            // 命令ID：通过标记文本获取复选框
            // [34] 通过标记文本获取复选框(标记文本)
            // 功能：在当前窗口按区分大小写的非空文本标记查找复选框，找不到时返回无效引用。
            // 参数：标记文本:wideString；返回：复选框；可见性：default
            通过标记文本获取复选框("演示参数1")
            // 命令ID：通过标记整数获取复选框
            // [35] 通过标记整数获取复选框(标记整数)
            // 功能：在当前窗口按有符号 32 位整数标记查找复选框，找不到时返回无效引用。
            // 参数：标记整数:int；返回：复选框；可见性：default
            通过标记整数获取复选框(1)
            // 命令ID：控件_创建单选框
            // [36] 控件_创建单选框(父级, 横坐标, 纵坐标, 宽度, 高度, 文本, [标记文本], [标记整数])
            // 功能：在当前窗口运行时创建单选框；窗口拥有生命周期，代码获得非拥有型引用。
            // 参数：父级:controlRef，横坐标:int，纵坐标:int，宽度:int，高度:int，文本:wideString，标记文本:wideString，标记整数:int；返回：单选框；可见性：default
            控件_创建单选框(演示状态, 1, 1, 1, 1, "演示参数6", "演示参数7", 1)
            // 命令ID：通过标记文本获取单选框
