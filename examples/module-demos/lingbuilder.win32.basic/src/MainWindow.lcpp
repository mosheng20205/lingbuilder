包 Win32窗口基础模块完整演示
使用 Win32窗口基础模块

// 本项目由模块清单自动生成；每条 binding 命令都在下方具有真实调用语句。
// 为避免误删文件、启动进程、访问网络或操作设备，必须先勾选“允许实际执行”才会进入命令调用区。
类 MainWindow : 公开 窗口
    事件 _MainWindow_创建完毕()
        控件_设置选择项(命令分组选项卡, 0)
        控件_设置文本(演示状态, "Win32窗口基础模块：39 条命令，默认处于安全预览模式。")
        调试输出("已加载模块演示：lingbuilder.win32.basic")
    结束

    事件 _运行第01组_被单击()
        控件_设置文本(演示状态, "命令 1–20：信息框 至 控件_取选择项；源码内含完整签名、参数、返回值与调用。")
        如果 (控件_取勾选(允许实际执行))
            // 命令ID：信息框
            // [1] 信息框(内容, 标志, 标题)
            // 功能：显示一个 Win32 系统消息框。
            // 参数：内容:wideString，标志:int，标题:wideString；返回：int；可见性：default
            信息框("演示参数1", 1, "演示参数3")
            // 命令ID：调试输出
            // [2] 调试输出(参数1, 参数2, ...)
            // 功能：向调试输出窗口和控制台输出任意数量的文本、整数、逻辑值等参数，参数使用英文逗号分隔。
            // 参数：内容:wideString；返回：void；可见性：default
            调试输出("演示参数1")
            // 命令ID：结束
            // [3] 结束()
            // 功能：关闭当前窗口。
            // 参数：无；返回：void；可见性：default
            结束()
            // 命令ID：到文本
            // [4] 到文本(值)
            // 功能：把整数、长整数、小数、逻辑值或文本确定性转换为文本；逻辑值返回“真”或“假”。
            // 参数：值:raw；返回：wideString；可见性：default
            到文本(0)
            // 命令ID：格式化文本
            // [5] 格式化文本(格式模板, 参数...)
            // 功能：按顺序用参数替换格式模板中的 {}；使用 {{ 和 }} 输出字面量花括号。参数不足时保留未替换的 {}，多余参数忽略。
            // 参数：格式模板:wideString，参数:raw；返回：wideString；可见性：default
            格式化文本("演示参数1", 0)
            // 命令ID：到整数
            // [6] 到整数(文本)
            // 功能：把文本转换为整数；空文本或无法转换的内容返回 0。
            // 参数：文本:wideString；返回：int；可见性：default
            到整数("演示参数1")
            // 命令ID：取鼠标水平位置
            // [7] 取鼠标水平位置()
            // 功能：返回鼠标指针当前相对于屏幕左边的水平位置，单位为像素点。初级命令。
            // 参数：无；返回：int；可见性：default
            取鼠标水平位置()
            // 命令ID：取鼠标垂直位置
            // [8] 取鼠标垂直位置()
            // 功能：返回鼠标指针当前相对于屏幕顶边的垂直位置，单位为像素点。初级命令。
            // 参数：无；返回：int；可见性：default
            取鼠标垂直位置()
            // 命令ID：控件_设置文本
            // [9] 控件_设置文本(控件名, 文本)
            // 功能：设置当前窗口中指定控件的文本。
            // 参数：控件名:controlRef，文本:wideString；返回：bool；可见性：default
            控件_设置文本(演示状态, "演示参数2")
            // 命令ID：控件_设置图片
            // [10] 控件_设置图片(控件名, 图片路径)
            // 功能：设置图片框显示的本地图片；支持项目 assets 相对路径或本地完整路径，空路径清空图片。
            // 参数：控件名:controlRef，图片路径:wideString；返回：bool；可见性：default
            控件_设置图片(演示状态, "module-demo-temp.txt")
            // 命令ID：控件_取文本
            // [11] 控件_取文本(控件名)
            // 功能：读取指定控件的当前文本。
            // 参数：控件名:controlRef；返回：wideString；可见性：default
            控件_取文本(演示状态)
            // 命令ID：控件_设置启用
            // [12] 控件_设置启用(控件名, 启用)
            // 功能：启用或禁用指定控件。
            // 参数：控件名:controlRef，启用:bool；返回：bool；可见性：default
            控件_设置启用(演示状态, 真)
            // 命令ID：控件_设置可见
            // [13] 控件_设置可见(控件名, 可见)
            // 功能：显示或隐藏指定控件。
            // 参数：控件名:controlRef，可见:bool；返回：bool；可见性：default
            控件_设置可见(演示状态, 真)
            // 命令ID：控件_设置位置大小
            // [14] 控件_设置位置大小(控件名, 横坐标, 纵坐标, 宽度, 高度)
            // 功能：按当前窗口客户区像素坐标移动指定控件并调整大小，适合在窗口大小事件中实现自适应布局。
            // 参数：控件名:controlRef，横坐标:int，纵坐标:int，宽度:int，高度:int；返回：bool；可见性：default
            控件_设置位置大小(演示状态, 1, 1, 1, 1)
            // 命令ID：控件_设置勾选
            // [15] 控件_设置勾选(控件名, 勾选)
            // 功能：设置复选框、单选框或切换按钮状态。
            // 参数：控件名:controlRef，勾选:bool；返回：bool；可见性：default
            控件_设置勾选(演示状态, 真)
            // 命令ID：控件_取勾选
            // [16] 控件_取勾选(控件名)
            // 功能：读取控件勾选状态。
            // 参数：控件名:controlRef；返回：bool；可见性：default
            控件_取勾选(演示状态)
            // 命令ID：控件_设置数值
            // [17] 控件_设置数值(控件名, 数值)
            // 功能：设置进度条、滑块、调节器或滚动条数值。
            // 参数：控件名:controlRef，数值:int；返回：bool；可见性：default
            控件_设置数值(演示状态, 1)
            // 命令ID：控件_取数值
            // [18] 控件_取数值(控件名)
            // 功能：读取数值型控件当前值。
            // 参数：控件名:controlRef；返回：int；可见性：default
            控件_取数值(演示状态)
            // 命令ID：控件_设置选择项
            // [19] 控件_设置选择项(控件名, 索引)
            // 功能：设置列表、组合框、列表视图或选项卡选择项。
            // 参数：控件名:controlRef，索引:int；返回：bool；可见性：default
            控件_设置选择项(演示状态, 1)
            // 命令ID：控件_取选择项
            // [20] 控件_取选择项(控件名)
            // 功能：读取选择项索引。
            // 参数：控件名:controlRef；返回：int；可见性：default
            控件_取选择项(演示状态)
        如果结束
        调试输出("已查看 命令 1–20：信息框 至 控件_取选择项；勾选允许实际执行后会使用演示参数调用。")
    结束

    事件 _运行第02组_被单击()
        控件_设置文本(演示状态, "命令 21–39：控件_添加项目 至 窗口_取拖入文件；源码内含完整签名、参数、返回值与调用。")
        如果 (控件_取勾选(允许实际执行))
            // 命令ID：控件_添加项目
            // [21] 控件_添加项目(控件名, 文本)
            // 功能：向列表框、组合框或增强组合框追加项目。
            // 参数：控件名:controlRef，文本:wideString；返回：int；可见性：default
            控件_添加项目(演示状态, "演示参数2")
            // 命令ID：控件_清空项目
            // [22] 控件_清空项目(控件名)
            // 功能：清空集合控件项目。
            // 参数：控件名:controlRef；返回：bool；可见性：default
            控件_清空项目(演示状态)
            // 命令ID：窗口_取消关闭
            // [23] 窗口_取消关闭()
            // 功能：在窗口“关闭前”事件中取消本次关闭请求。
            // 参数：无；返回：bool；可见性：default
            窗口_取消关闭()
            // 命令ID：窗口_取事件宽度
            // [24] 窗口_取事件宽度()
            // 功能：返回最近窗口大小事件中的客户区宽度。
            // 参数：无；返回：int；可见性：default
            窗口_取事件宽度()
            // 命令ID：窗口_取事件高度
            // [25] 窗口_取事件高度()
            // 功能：返回最近窗口大小事件中的客户区高度。
            // 参数：无；返回：int；可见性：default
            窗口_取事件高度()
            // 命令ID：窗口_取事件横坐标
            // [26] 窗口_取事件横坐标()
            // 功能：返回最近窗口移动事件中的屏幕横坐标。
            // 参数：无；返回：int；可见性：default
            窗口_取事件横坐标()
            // 命令ID：窗口_取事件纵坐标
            // [27] 窗口_取事件纵坐标()
            // 功能：返回最近窗口移动事件中的屏幕纵坐标。
            // 参数：无；返回：int；可见性：default
            窗口_取事件纵坐标()
            // 命令ID：窗口_取是否激活
            // [28] 窗口_取是否激活()
            // 功能：返回当前窗口是否为活动窗口。
            // 参数：无；返回：bool；可见性：default
            窗口_取是否激活()
            // 命令ID：窗口_取是否可见
            // [29] 窗口_取是否可见()
            // 功能：返回当前窗口是否可见。
            // 参数：无；返回：bool；可见性：default
            窗口_取是否可见()
            // 命令ID：窗口_取当前状态
            // [30] 窗口_取当前状态()
            // 功能：返回窗口状态：0 正常、1 最小化、2 最大化。
            // 参数：无；返回：int；可见性：default
            窗口_取当前状态()
            // 命令ID：窗口_取事件键码
            // [31] 窗口_取事件键码()
            // 功能：返回最近键盘事件中的 Win32 虚拟键码。
            // 参数：无；返回：int；可见性：default
            窗口_取事件键码()
            // 命令ID：窗口_取事件字符
            // [32] 窗口_取事件字符()
            // 功能：返回最近字符输入事件中的 Unicode 字符。
            // 参数：无；返回：wideString；可见性：default
            窗口_取事件字符()
            // 命令ID：窗口_取Ctrl键状态
            // [33] 窗口_取Ctrl键状态()
            // 功能：返回最近键盘事件发生时 Ctrl 键是否按下。
            // 参数：无；返回：bool；可见性：default
            窗口_取Ctrl键状态()
            // 命令ID：窗口_取Shift键状态
            // [34] 窗口_取Shift键状态()
            // 功能：返回最近键盘事件发生时 Shift 键是否按下。
            // 参数：无；返回：bool；可见性：default
            窗口_取Shift键状态()
            // 命令ID：窗口_取Alt键状态
            // [35] 窗口_取Alt键状态()
            // 功能：返回最近键盘事件发生时 Alt 键是否按下。
            // 参数：无；返回：bool；可见性：default
            窗口_取Alt键状态()
            // 命令ID：窗口_标记按键已处理
            // [36] 窗口_标记按键已处理()
            // 功能：在窗口键盘事件中阻止消息继续交给子控件或默认窗口过程。
            // 参数：无；返回：bool；可见性：default
            窗口_标记按键已处理()
            // 命令ID：窗口_取事件DPI
            // [37] 窗口_取事件DPI()
            // 功能：返回最近 DPI 改变事件中的新 DPI。
            // 参数：无；返回：int；可见性：default
            窗口_取事件DPI()
            // 命令ID：窗口_取拖入文件数量
            // [38] 窗口_取拖入文件数量()
            // 功能：返回最近文件拖入事件中的文件和目录数量。
            // 参数：无；返回：int；可见性：default
            窗口_取拖入文件数量()
            // 命令ID：窗口_取拖入文件
            // [39] 窗口_取拖入文件(索引)
            // 功能：按从 0 开始的索引返回最近拖入的 Unicode 路径，越界返回空文本。
            // 参数：索引:int；返回：wideString；可见性：default
            窗口_取拖入文件(1)
        如果结束
        调试输出("已查看 命令 21–39：控件_添加项目 至 窗口_取拖入文件；勾选允许实际执行后会使用演示参数调用。")
    结束

结束类
