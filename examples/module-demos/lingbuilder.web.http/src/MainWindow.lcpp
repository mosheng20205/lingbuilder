包 网页访问模块完整演示
使用 Win32窗口基础模块
使用 网页访问模块

// 本项目由模块清单自动生成；每条 binding 命令都在下方具有真实调用语句。
// 为避免误删文件、启动进程、访问网络或操作设备，必须先勾选“允许实际执行”才会进入命令调用区。
类 MainWindow : 公开 窗口
    事件 _MainWindow_创建完毕()
        控件_设置选择项("命令分组选项卡", 0)
        控件_设置文本("演示状态", "网页访问模块：12 条命令，默认处于安全预览模式。")
        调试输出("已加载模块演示：lingbuilder.web.http")
    结束

    事件 _运行第01组_被单击()
        控件_设置文本("演示状态", "命令 1–12：网页_异步访问 至 网页_取错误信息；源码内含完整签名、参数、返回值与调用。")
        如果 (控件_取勾选("允许实际执行"))
            // 命令ID：网页_异步访问
            // [1] 网页_异步访问(网址, 访问方式, 完成处理器)
            // 功能：在受控后台线程中访问网页，立即返回请求编号；完成处理器使用 &处理器名 引用，并在 UI 主线程执行。
            // 参数：网址:wideString，访问方式:int，完成处理器:handler；返回：int；可见性：default
            网页_异步访问("https://example.com", 1, &模块演示回调)
            // 命令ID：网页_异步取返回文本
            // [2] 网页_异步取返回文本(请求编号)
            // 功能：按请求编号读取异步网页访问的 UTF-8 文本结果。
            // 参数：请求编号:int；返回：wideString；可见性：default
            网页_异步取返回文本(1)
            // 命令ID：网页_异步取状态代码
            // [3] 网页_异步取状态代码(请求编号)
            // 功能：按请求编号读取 HTTP 状态代码。
            // 参数：请求编号:int；返回：int；可见性：default
            网页_异步取状态代码(1)
            // 命令ID：网页_异步取错误信息
            // [4] 网页_异步取错误信息(请求编号)
            // 功能：按请求编号读取异步访问的中文错误信息。
            // 参数：请求编号:int；返回：wideString；可见性：default
            网页_异步取错误信息(1)
            // 命令ID：网页_异步取当前请求编号
            // [5] 网页_异步取当前请求编号()
            // 功能：在异步完成处理器中读取当前正在分发的请求编号。
            // 参数：无；返回：int；可见性：default
            网页_异步取当前请求编号()
            // 命令ID：网页_异步取消
            // [6] 网页_异步取消(请求编号)
            // 功能：标记取消指定异步请求；当前 WinHTTP 请求返回后会以已取消状态分发完成处理器。
            // 参数：请求编号:int；返回：bool；可见性：default
            网页_异步取消(1)
            // 命令ID：网页_访问_对象
            // [7] 网页_访问_对象(网址, 访问方式, 提交信息, 提交Cookies, 返回Cookies, 附加协议头, 返回协议头, 返回状态代码, 禁止重定向, 字节集提交, 代理地址, 超时, 代理用户名, 代理密码, 代理标识, 对象继承, 是否自动合并更新Cookie, 是否补全必要协议头, 是否处理协议头大小写)
            // 功能：使用 WinHTTP 对象方式访问网页。访问方式：0=GET，1=POST，2=HEAD，3=PUT，4=OPTIONS，5=DELETE，6=TRACE，7=CONNECT，8=PATCH。
            // 参数：网址:wideString，访问方式:int，提交信息:wideString，提交Cookies:wideString，返回Cookies:wideString，附加协议头:wideString，返回协议头:wideString，返回状态代码:int，禁止重定向:bool，字节集提交:raw，代理地址:wideString，超时:int，代理用户名:wideString，代理密码:wideString，代理标识:int，对象继承:raw，是否自动合并更新Cookie:bool，是否补全必要协议头:bool，是否处理协议头大小写:bool；返回：raw；可见性：default
            网页_访问_对象("https://example.com", 1, "演示参数3", "演示参数4", "演示参数5", "演示参数6", "演示参数7", 1, 真, 0, "https://example.com", 1, "演示参数13", "演示参数14", 1, 0, 真, 真, 真)
            // 命令ID：网页_取返回文本
            // [8] 网页_取返回文本()
            // 功能：读取最近一次网页_访问_对象返回的 UTF-8 文本内容。
            // 参数：无；返回：wideString；可见性：default
            网页_取返回文本()
            // 命令ID：网页_取返回Cookies
            // [9] 网页_取返回Cookies()
            // 功能：读取最近一次网页_访问_对象返回的 Cookie。
            // 参数：无；返回：wideString；可见性：default
            网页_取返回Cookies()
            // 命令ID：网页_取返回协议头
            // [10] 网页_取返回协议头()
            // 功能：读取最近一次网页_访问_对象返回的响应协议头。
            // 参数：无；返回：wideString；可见性：default
            网页_取返回协议头()
            // 命令ID：网页_取返回状态代码
            // [11] 网页_取返回状态代码()
            // 功能：读取最近一次网页_访问_对象返回的 HTTP 状态代码。
            // 参数：无；返回：int；可见性：default
            网页_取返回状态代码()
            // 命令ID：网页_取错误信息
            // [12] 网页_取错误信息()
            // 功能：读取最近一次网页访问失败时的中文错误信息。
            // 参数：无；返回：wideString；可见性：default
            网页_取错误信息()
        如果结束
        调试输出("已查看 命令 1–12：网页_异步访问 至 网页_取错误信息；勾选允许实际执行后会使用演示参数调用。")
    结束

    事件 模块演示回调()
        调试输出("模块演示回调已触发。")
    结束

结束类
