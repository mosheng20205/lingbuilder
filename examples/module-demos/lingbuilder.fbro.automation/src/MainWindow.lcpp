包 FBro自动化模块完整演示
使用 Win32窗口基础模块
使用 FBro自动化模块

// 本项目由模块清单自动生成；每条 binding 命令都在下方具有真实调用语句。
// 为避免误删文件、启动进程、访问网络或操作设备，必须先勾选“允许实际执行”才会进入命令调用区。
类 MainWindow : 公开 窗口
    事件 _MainWindow_创建完毕()
        控件_设置选择项("命令分组选项卡", 0)
        控件_设置文本("演示状态", "FBro自动化模块：25 条命令，默认处于安全预览模式。")
        调试输出("已加载模块演示：lingbuilder.fbro.automation")
    结束

    事件 _运行第01组_被单击()
        控件_设置文本("演示状态", "命令 1–13：FBro自动化_执行JS异步 至 FBro框架_取标识；源码内含完整签名、参数、返回值与调用。")
        如果 (控件_取勾选("允许实际执行"))
            // 命令ID：FBro自动化_执行JS异步
            // [1] FBro自动化_执行JS异步(控件名, 脚本)
            // 功能：异步执行 JavaScript 并返回受管任务 ID。
            // 参数：控件名:wideString，脚本:wideString；返回：longLong；可见性：advanced
            FBro自动化_执行JS异步("演示输出", "演示参数2")
            // 命令ID：FBro框架_取主框架
            // [2] FBro框架_取主框架(控件名)
            // 功能：取得浏览器主框架的受管句柄。
            // 参数：控件名:wideString；返回：longLong；可见性：advanced
            FBro框架_取主框架("演示输出")
            // 命令ID：FBro框架_取焦点框架
            // [3] FBro框架_取焦点框架(控件名)
            // 功能：取得当前焦点框架的受管句柄。
            // 参数：控件名:wideString；返回：longLong；可见性：advanced
            FBro框架_取焦点框架("演示输出")
            // 命令ID：FBro框架_按标识取框架
            // [4] FBro框架_按标识取框架(控件名, 标识)
            // 功能：按官方字符串标识取得受管框架句柄。
            // 参数：控件名:wideString，标识:wideString；返回：longLong；可见性：advanced
            FBro框架_按标识取框架("演示输出", "演示参数2")
            // 命令ID：FBro框架_按名称取框架
            // [5] FBro框架_按名称取框架(控件名, 名称)
            // 功能：按框架名称取得受管框架句柄。
            // 参数：控件名:wideString，名称:wideString；返回：longLong；可见性：advanced
            FBro框架_按名称取框架("演示输出", "演示参数2")
            // 命令ID：FBro框架_取标识列表JSON
            // [6] FBro框架_取标识列表JSON(控件名)
            // 功能：取得全部框架标识的 UTF-16 JSON 数组。
            // 参数：控件名:wideString；返回：wideString；可见性：advanced
            FBro框架_取标识列表JSON("演示输出")
            // 命令ID：FBro框架_取名称列表JSON
            // [7] FBro框架_取名称列表JSON(控件名)
            // 功能：取得全部框架名称的 UTF-16 JSON 数组。
            // 参数：控件名:wideString；返回：wideString；可见性：advanced
            FBro框架_取名称列表JSON("演示输出")
            // 命令ID：FBro框架_是否有效
            // [8] FBro框架_是否有效(框架句柄)
            // 功能：检查受管框架是否仍有效。
            // 参数：框架句柄:longLong；返回：int；可见性：advanced
            FBro框架_是否有效(1)
            // 命令ID：FBro框架_是否主框架
            // [9] FBro框架_是否主框架(框架句柄)
            // 功能：检查是否为主框架。
            // 参数：框架句柄:longLong；返回：int；可见性：advanced
            FBro框架_是否主框架(1)
            // 命令ID：FBro框架_是否焦点框架
            // [10] FBro框架_是否焦点框架(框架句柄)
            // 功能：检查框架是否拥有焦点。
            // 参数：框架句柄:longLong；返回：int；可见性：advanced
            FBro框架_是否焦点框架(1)
            // 命令ID：FBro框架_取地址
            // [11] FBro框架_取地址(框架句柄)
            // 功能：取得框架当前地址。
            // 参数：框架句柄:longLong；返回：wideString；可见性：advanced
            FBro框架_取地址(1)
            // 命令ID：FBro框架_取名称
            // [12] FBro框架_取名称(框架句柄)
            // 功能：取得框架名称。
            // 参数：框架句柄:longLong；返回：wideString；可见性：advanced
            FBro框架_取名称(1)
            // 命令ID：FBro框架_取标识
            // [13] FBro框架_取标识(框架句柄)
            // 功能：取得框架官方字符串标识。
            // 参数：框架句柄:longLong；返回：wideString；可见性：advanced
            FBro框架_取标识(1)
        如果结束
        调试输出("已查看 命令 1–13：FBro自动化_执行JS异步 至 FBro框架_取标识；勾选允许实际执行后会使用演示参数调用。")
    结束

    事件 _运行第02组_被单击()
        控件_设置文本("演示状态", "命令 14–25：FBro框架_取父框架 至 FBro框架_执行JS；源码内含完整签名、参数、返回值与调用。")
        如果 (控件_取勾选("允许实际执行"))
            // 命令ID：FBro框架_取父框架
            // [14] FBro框架_取父框架(框架句柄)
            // 功能：取得父框架受管句柄；主框架返回零。
            // 参数：框架句柄:longLong；返回：longLong；可见性：advanced
            FBro框架_取父框架(1)
            // 命令ID：FBro框架_取浏览器实例
            // [15] FBro框架_取浏览器实例(框架句柄)
            // 功能：取得框架所属的 LingBuilder 浏览器实例 ID。
            // 参数：框架句柄:longLong；返回：longLong；可见性：advanced
            FBro框架_取浏览器实例(1)
            // 命令ID：FBro框架_撤销
            // [16] FBro框架_撤销(框架句柄)
            // 功能：在框架中执行撤销。
            // 参数：框架句柄:longLong；返回：int；可见性：advanced
            FBro框架_撤销(1)
            // 命令ID：FBro框架_重做
            // [17] FBro框架_重做(框架句柄)
            // 功能：在框架中执行重做。
            // 参数：框架句柄:longLong；返回：int；可见性：advanced
            FBro框架_重做(1)
            // 命令ID：FBro框架_剪切
            // [18] FBro框架_剪切(框架句柄)
            // 功能：剪切框架当前选择。
            // 参数：框架句柄:longLong；返回：int；可见性：advanced
            FBro框架_剪切(1)
            // 命令ID：FBro框架_复制
            // [19] FBro框架_复制(框架句柄)
            // 功能：复制框架当前选择。
            // 参数：框架句柄:longLong；返回：int；可见性：advanced
            FBro框架_复制(1)
            // 命令ID：FBro框架_粘贴
            // [20] FBro框架_粘贴(框架句柄)
            // 功能：在框架中粘贴。
            // 参数：框架句柄:longLong；返回：int；可见性：advanced
            FBro框架_粘贴(1)
            // 命令ID：FBro框架_删除
            // [21] FBro框架_删除(框架句柄)
            // 功能：删除框架当前选择。
            // 参数：框架句柄:longLong；返回：int；可见性：advanced
            FBro框架_删除(1)
            // 命令ID：FBro框架_全选
            // [22] FBro框架_全选(框架句柄)
            // 功能：全选框架内容。
            // 参数：框架句柄:longLong；返回：int；可见性：advanced
            FBro框架_全选(1)
            // 命令ID：FBro框架_查看源代码
            // [23] FBro框架_查看源代码(框架句柄)
            // 功能：打开框架源代码查看器。
            // 参数：框架句柄:longLong；返回：int；可见性：advanced
            FBro框架_查看源代码(1)
            // 命令ID：FBro框架_载入地址
            // [24] FBro框架_载入地址(框架句柄, 地址)
            // 功能：让指定框架载入地址。
            // 参数：框架句柄:longLong，地址:wideString；返回：int；可见性：advanced
            FBro框架_载入地址(1, "https://example.com")
            // 命令ID：FBro框架_执行JS
            // [25] FBro框架_执行JS(框架句柄, 脚本, 脚本地址, 起始行)
            // 功能：在指定框架执行 JavaScript，不等待返回值。
            // 参数：框架句柄:longLong，脚本:wideString，脚本地址:wideString，起始行:int；返回：int；可见性：advanced
            FBro框架_执行JS(1, "演示参数2", "https://example.com", 1)
        如果结束
        调试输出("已查看 命令 14–25：FBro框架_取父框架 至 FBro框架_执行JS；勾选允许实际执行后会使用演示参数调用。")
    结束

结束类
