包 条码模块完整演示
使用 Win32窗口基础模块
使用 条码模块

// 本项目由模块清单自动生成；每条 binding 命令都在下方具有真实调用语句。
// 为避免误删文件、启动进程、访问网络或操作设备，必须先勾选“允许实际执行”才会进入命令调用区。
类 MainWindow : 公开 窗口
    事件 _MainWindow_创建完毕()
        控件_设置选择项(命令分组选项卡, 0)
        控件_设置文本(演示状态, "条码模块：25 条命令，默认处于安全预览模式。")
        调试输出("已加载模块演示：lingbuilder.barcode")
    结束

    事件 _运行第01组_被单击()
        控件_设置文本(演示状态, "命令 1–13：条码_生成EAN13 至 条码_识别位图；源码内含完整签名、参数、返回值与调用。")
        如果 (控件_取勾选(允许实际执行))
            // 命令ID：条码_生成EAN13
            // [1] 条码_生成EAN13(内容)
            // 功能：生成 EAN-13 商品条码。
            // 参数：内容:wideString；返回：条码句柄；可见性：default
            条码_生成EAN13("演示参数1")
            // 命令ID：条码_生成EAN8
            // [2] 条码_生成EAN8(内容)
            // 功能：生成 EAN-8 短版商品条码。
            // 参数：内容:wideString；返回：条码句柄；可见性：default
            条码_生成EAN8("演示参数1")
            // 命令ID：条码_生成UPCA
            // [3] 条码_生成UPCA(内容)
            // 功能：生成 UPC-A 条码（北美商品码，EAN-13 前置 0 同构）。
            // 参数：内容:wideString；返回：条码句柄；可见性：default
            条码_生成UPCA("演示参数1")
            // 命令ID：条码_生成Code128
            // [4] 条码_生成Code128(内容)
            // 功能：生成 Code128 条码（A/B/C 子集自动择优，含模 103 校验）。
            // 参数：内容:wideString；返回：条码句柄；可见性：default
            条码_生成Code128("演示参数1")
            // 命令ID：条码_生成Code39
            // [5] 条码_生成Code39(内容)
            // 功能：生成 Code39 条码（星号为起始/终止保留符，内容中不允许）。
            // 参数：内容:wideString；返回：条码句柄；可见性：default
            条码_生成Code39("演示参数1")
            // 命令ID：条码_取模块数
            // [6] 条码_取模块数(条码)
            // 功能：返回条码总模块数（含静区）。
            // 参数：条码:条码句柄；返回：int；可见性：default
            条码_取模块数(0)
            // 命令ID：条码_取内容
            // [7] 条码_取内容(条码)
            // 功能：返回条码完整内容（EAN/UPC 含补全后的校验位）。
            // 参数：条码:条码句柄；返回：wideString；可见性：default
            条码_取内容(0)
            // 命令ID：条码_取位图
            // [8] 条码_取位图(条码, 每模块像素)
            // 功能：渲染条码为黑白 HBITMAP（长整数句柄），可直接交给图片框显示或位图类命令处理。
            // 参数：条码:条码句柄，每模块像素:int；返回：longLong；可见性：default
            条码_取位图(0, 1)
            // 命令ID：条码_保存BMP
            // [9] 条码_保存BMP(条码, 路径, 每模块像素)
            // 功能：把条码保存为 BMP 图片文件。
            // 参数：条码:条码句柄，路径:wideString，每模块像素:int；返回：bool；可见性：default
            条码_保存BMP(0, "module-demo-temp.txt", 1)
            // 命令ID：条码_释放
            // [10] 条码_释放(条码)
            // 功能：释放一个受管条码句柄。
            // 参数：条码:条码句柄；返回：bool；可见性：default
            条码_释放(0)
            // 命令ID：条码_释放全部
            // [11] 条码_释放全部()
            // 功能：释放当前进程内全部条码句柄。
            // 参数：无；返回：void；可见性：default
            条码_释放全部()
            // 命令ID：条码_识别像素
            // [12] 条码_识别像素(数据, 宽度, 高度, 通道数)
            // 功能：识别像素字节集中的一维条码（免落盘直解，截图/投屏帧直传）。
            // 参数：数据:bytes，宽度:int，高度:int，通道数:int；返回：条码识别结果；可见性：default
            条码_识别像素({}, 1, 1, 1)
            // 命令ID：条码_识别位图
            // [13] 条码_识别位图(位图句柄)
            // 功能：识别 Windows 位图中的一维条码。
            // 参数：位图句柄:longLong；返回：条码识别结果；可见性：default
            条码_识别位图(1)
        如果结束
        调试输出("已查看 命令 1–13：条码_生成EAN13 至 条码_识别位图；勾选允许实际执行后会使用演示参数调用。")
    结束

    事件 _运行第02组_被单击()
        控件_设置文本(演示状态, "命令 14–25：条码_识别屏幕 至 条码_是否可用；源码内含完整签名、参数、返回值与调用。")
        如果 (控件_取勾选(允许实际执行))
            // 命令ID：条码_识别屏幕
            // [14] 条码_识别屏幕(横, 纵, 宽, 高)
            // 功能：抓取屏幕区域并识别其中的一维条码。
            // 参数：横:int，纵:int，宽:int，高:int；返回：条码识别结果；可见性：default
            条码_识别屏幕(1, 1, 1, 1)
            // 命令ID：条码_识别BMP
            // [15] 条码_识别BMP(路径)
            // 功能：识别 BMP 文件中的一维条码（PNG 请先经图像模块转 BMP/像素）。
            // 参数：路径:wideString；返回：条码识别结果；可见性：default
            条码_识别BMP("module-demo-temp.txt")
            // 命令ID：条码_识别取文本
            // [16] 条码_识别取文本(结果)
            // 功能：返回解码文本（EAN/UPC 含校验位；UPC-A 为 12 位形态）。
            // 参数：结果:条码识别结果；返回：wideString；可见性：default
            条码_识别取文本(0)
            // 命令ID：条码_识别取码制
            // [17] 条码_识别取码制(结果)
            // 功能：返回识别出的码制：EAN-13、EAN-8、UPC-A、Code128 或 Code39。
            // 参数：结果:条码识别结果；返回：wideString；可见性：default
            条码_识别取码制(0)
            // 命令ID：条码_识别取校验通过
            // [18] 条码_识别取校验通过(结果)
            // 功能：返回校验位是否通过（识别成功即通过；提供显式查询便于展示）。
            // 参数：结果:条码识别结果；返回：bool；可见性：default
            条码_识别取校验通过(0)
            // 命令ID：条码_识别释放
            // [19] 条码_识别释放(结果)
            // 功能：释放一个受管识别结果句柄。
            // 参数：结果:条码识别结果；返回：bool；可见性：default
            条码_识别释放(0)
            // 命令ID：条码_识别释放全部
            // [20] 条码_识别释放全部()
            // 功能：释放当前进程内全部识别结果句柄。
            // 参数：无；返回：void；可见性：default
            条码_识别释放全部()
            // 命令ID：条码_自检
            // [21] 条码_自检()
            // 功能：闭环自检：五码制生成→渲染→识别逐字节比对 + 校验位异常样本拒绝。返回假时读 条码_取错误。
            // 参数：无；返回：bool；可见性：default
            条码_自检()
            // 命令ID：条码_取错误
            // [22] 条码_取错误()
            // 功能：返回当前线程最近一次生成侧错误的中文说明。
            // 参数：无；返回：wideString；可见性：default
            条码_取错误()
            // 命令ID：条码_识别取错误
            // [23] 条码_识别取错误()
            // 功能：返回当前线程最近一次识别侧错误的中文说明。
            // 参数：无；返回：wideString；可见性：default
            条码_识别取错误()
            // 命令ID：条码_取版本
            // [24] 条码_取版本()
            // 功能：返回模块版本与支持的码制信息。
            // 参数：无；返回：wideString；可见性：default
            条码_取版本()
            // 命令ID：条码_是否可用
            // [25] 条码_是否可用()
            // 功能：纯本地实现，恒返回真。
            // 参数：无；返回：bool；可见性：advanced
            条码_是否可用()
        如果结束
        调试输出("已查看 命令 14–25：条码_识别屏幕 至 条码_是否可用；勾选允许实际执行后会使用演示参数调用。")
    结束

结束类
