包 HTTP客户端模块完整演示
使用 Win32窗口基础模块
使用 HTTP客户端模块

// 本项目由模块清单自动生成；每条 binding 命令都在下方具有真实调用语句。
// 为避免误删文件、启动进程、访问网络或操作设备，必须先勾选“允许实际执行”才会进入命令调用区。
类 MainWindow : 公开 窗口
    事件 _MainWindow_创建完毕()
        控件_设置选择项("命令分组选项卡", 0)
        控件_设置文本("演示状态", "HTTP客户端模块：7 条命令，默认处于安全预览模式。")
        调试输出("已加载模块演示：lingbuilder.net.http-client")
    结束

    事件 _运行第01组_被单击()
        控件_设置文本("演示状态", "命令 1–7：HTTP客户端_请求 至 HTTP客户端_清空状态；源码内含完整签名、参数、返回值与调用。")
        如果 (控件_取勾选("允许实际执行"))
            // 命令ID：HTTP客户端_请求
            // [1] HTTP客户端_请求(方法, 地址, 正文, 超时毫秒)
            // 功能：发送一次 UTF-8 HTTP 请求。
            // 参数：方法:wideString，地址:wideString，正文:wideString，超时毫秒:int；返回：bool；可见性：default
            HTTP客户端_请求("演示参数1", "https://example.com", "演示参数3", 1)
            // 命令ID：HTTP客户端_GET
            // [2] HTTP客户端_GET(地址)
            // 功能：发送 GET 请求。
            // 参数：地址:wideString；返回：bool；可见性：default
            HTTP客户端_GET("https://example.com")
            // 命令ID：HTTP客户端_POST
            // [3] HTTP客户端_POST(地址, 正文)
            // 功能：发送 application/json UTF-8 POST 请求。
            // 参数：地址:wideString，正文:wideString；返回：bool；可见性：default
            HTTP客户端_POST("https://example.com", "演示参数2")
            // 命令ID：HTTP客户端_取状态码
            // [4] HTTP客户端_取状态码()
            // 功能：返回最近响应的 HTTP 状态码。
            // 参数：无；返回：int；可见性：default
            HTTP客户端_取状态码()
            // 命令ID：HTTP客户端_取响应文本
            // [5] HTTP客户端_取响应文本()
            // 功能：返回最近响应正文，按 UTF-8 解码。
            // 参数：无；返回：wideString；可见性：default
            HTTP客户端_取响应文本()
            // 命令ID：HTTP客户端_取错误
            // [6] HTTP客户端_取错误()
            // 功能：返回最近请求的中文错误信息。
            // 参数：无；返回：wideString；可见性：default
            HTTP客户端_取错误()
            // 命令ID：HTTP客户端_清空状态
            // [7] HTTP客户端_清空状态()
            // 功能：清空最近状态码、响应和错误。
            // 参数：无；返回：void；可见性：default
            HTTP客户端_清空状态()
        如果结束
        调试输出("已查看 命令 1–7：HTTP客户端_请求 至 HTTP客户端_清空状态；勾选允许实际执行后会使用演示参数调用。")
    结束

结束类
