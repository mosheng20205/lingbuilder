包 HTTP客户端模块完整演示
使用 Win32窗口基础模块
使用 HTTP客户端模块

// 本项目由模块清单自动生成；每条 binding 命令都在下方具有真实调用语句。
// 为避免误删文件、启动进程、访问网络或操作设备，必须先勾选“允许实际执行”才会进入命令调用区。
类 MainWindow : 公开 窗口
    事件 _MainWindow_创建完毕()
        控件_设置选择项(命令分组选项卡, 0)
        控件_设置文本(演示状态, "HTTP 客户端模块：74 条命令，默认处于安全预览模式。")
        调试输出("已加载模块演示：lingbuilder.net.http-client")
    结束

    事件 _运行第01组_被单击()
        控件_设置文本(演示状态, "命令 1–19：HTTP客户端_创建客户端 至 HTTP客户端_取活动请求数；源码内含完整签名、参数、返回值与调用。")
        如果 (控件_取勾选(允许实际执行))
            // 命令ID：HTTP客户端_创建客户端
            // [1] HTTP客户端_创建客户端()
            // 功能：创建独立的受管 WinHTTP 客户端并返回稳定 ID。
            // 参数：无；返回：HTTP客户端；可见性：default
            HTTP客户端_创建客户端()
            // 命令ID：HTTP客户端_销毁客户端
            // [2] HTTP客户端_销毁客户端(客户端)
            // 功能：取消并回收该客户端的全部请求、Cookie 会话和 WinHTTP 资源。
            // 参数：客户端:HTTP客户端；返回：bool；可见性：default
            HTTP客户端_销毁客户端(0)
            // 命令ID：HTTP客户端_设置UserAgent
            // [3] HTTP客户端_设置UserAgent(客户端, UserAgent)
            // 功能：设置该客户端后续请求使用的 User-Agent；仅在无活动请求时修改。
            // 参数：客户端:HTTP客户端，UserAgent:wideString；返回：bool；可见性：default
            HTTP客户端_设置UserAgent(0, "演示参数2")
            // 命令ID：HTTP客户端_设置超时
            // [4] HTTP客户端_设置超时(客户端, 解析毫秒, 连接毫秒, 发送毫秒, 接收毫秒)
            // 功能：分别设置 DNS 解析、连接、发送和接收超时，范围 100-3600000 毫秒。
            // 参数：客户端:HTTP客户端，解析毫秒:int，连接毫秒:int，发送毫秒:int，接收毫秒:int；返回：bool；可见性：default
            HTTP客户端_设置超时(0, 1, 1, 1, 1)
            // 命令ID：HTTP客户端_设置资源限制
            // [5] HTTP客户端_设置资源限制(客户端, 响应头上限KB, 响应体上限MB, 上传上限MB, 最大重定向次数)
            // 功能：限制响应头、内存或文件响应、上传和自动重定向，阻止不受控资源占用。
            // 参数：客户端:HTTP客户端，响应头上限KB:int，响应体上限MB:int，上传上限MB:int，最大重定向次数:int；返回：bool；可见性：default
            HTTP客户端_设置资源限制(0, 1, 1, 1, 1)
            // 命令ID：HTTP客户端_设置重定向策略
            // [6] HTTP客户端_设置重定向策略(客户端, 允许重定向, 允许HTTPS降级HTTP)
            // 功能：设置自动重定向；默认允许同等或更安全协议，禁止 HTTPS 降级到 HTTP。
            // 参数：客户端:HTTP客户端，允许重定向:bool，允许HTTPS降级HTTP:bool；返回：bool；可见性：default
            HTTP客户端_设置重定向策略(0, 真, 真)
            // 命令ID：HTTP客户端_设置代理
            // [7] HTTP客户端_设置代理(客户端, 模式, 代理地址, 绕过列表)
            // 功能：配置代理模式：0 系统默认、1 直连、2 固定代理；固定代理必须提供地址。
            // 参数：客户端:HTTP客户端，模式:int，代理地址:wideString，绕过列表:wideString；返回：bool；可见性：default
            HTTP客户端_设置代理(0, 1, "https://example.com", "演示参数4")
            // 命令ID：HTTP客户端_设置服务器凭据
            // [8] HTTP客户端_设置服务器凭据(客户端, 用户名, 密码)
            // 功能：设置内存中的 HTTP Basic 服务器凭据；不会写入模块日志或持久化配置。
            // 参数：客户端:HTTP客户端，用户名:wideString，密码:wideString；返回：bool；可见性：default
            HTTP客户端_设置服务器凭据(0, "演示参数2", "演示参数3")
            // 命令ID：HTTP客户端_设置代理凭据
            // [9] HTTP客户端_设置代理凭据(客户端, 用户名, 密码)
            // 功能：设置内存中的 HTTP Basic 代理凭据。
            // 参数：客户端:HTTP客户端，用户名:wideString，密码:wideString；返回：bool；可见性：default
            HTTP客户端_设置代理凭据(0, "演示参数2", "演示参数3")
            // 命令ID：HTTP客户端_设置TLS策略
            // [10] HTTP客户端_设置TLS策略(客户端, 验证证书, 允许自签名)
            // 功能：设置 HTTPS 证书策略；默认完整验证系统信任链、主机名、用途和有效期。
            // 参数：客户端:HTTP客户端，验证证书:bool，允许自签名:bool；返回：bool；可见性：default
            HTTP客户端_设置TLS策略(0, 真, 真)
            // 命令ID：HTTP客户端_设置证书固定
            // [11] HTTP客户端_设置证书固定(客户端, SHA256指纹)
            // 功能：设置最终 HTTPS 服务端证书的 SHA-256 指纹；空文本清除固定，可包含冒号或空格。
            // 参数：客户端:HTTP客户端，SHA256指纹:wideString；返回：bool；可见性：default
            HTTP客户端_设置证书固定(0, "{}")
            // 命令ID：HTTP客户端_设置自动解压
            // [12] HTTP客户端_设置自动解压(客户端, 启用)
            // 功能：启用或关闭 WinHTTP gzip/deflate 自动解压；默认启用。
            // 参数：客户端:HTTP客户端，启用:bool；返回：bool；可见性：default
            HTTP客户端_设置自动解压(0, 真)
            // 命令ID：HTTP客户端_设置Cookie
            // [13] HTTP客户端_设置Cookie(客户端, 启用)
            // 功能：启用或关闭该受管客户端会话内的 Cookie 接收和回送；默认启用且不与浏览器共享。
            // 参数：客户端:HTTP客户端，启用:bool；返回：bool；可见性：default
            HTTP客户端_设置Cookie(0, 真)
            // 命令ID：HTTP客户端_设置默认请求头
            // [14] HTTP客户端_设置默认请求头(客户端, 名称, 值)
            // 功能：设置或替换客户端默认请求头，拒绝非法名称、CR/LF 注入和受运行时管理的头。
            // 参数：客户端:HTTP客户端，名称:wideString，值:wideString；返回：bool；可见性：default
            HTTP客户端_设置默认请求头(0, "演示参数2", "演示参数3")
            // 命令ID：HTTP客户端_添加默认请求头
            // [15] HTTP客户端_添加默认请求头(客户端, 名称, 值)
            // 功能：追加客户端默认请求头；适合 Accept、Cache-Control 等可重复头。
            // 参数：客户端:HTTP客户端，名称:wideString，值:wideString；返回：bool；可见性：default
            HTTP客户端_添加默认请求头(0, "演示参数2", "演示参数3")
            // 命令ID：HTTP客户端_删除默认请求头
            // [16] HTTP客户端_删除默认请求头(客户端, 名称)
            // 功能：删除客户端中全部同名默认请求头。
            // 参数：客户端:HTTP客户端，名称:wideString；返回：bool；可见性：default
            HTTP客户端_删除默认请求头(0, "演示参数2")
            // 命令ID：HTTP客户端_清空默认请求头
            // [17] HTTP客户端_清空默认请求头(客户端)
            // 功能：清空客户端默认请求头。
            // 参数：客户端:HTTP客户端；返回：bool；可见性：default
            HTTP客户端_清空默认请求头(0)
            // 命令ID：HTTP客户端_取消全部请求
            // [18] HTTP客户端_取消全部请求(客户端)
            // 功能：取消客户端全部运行中请求并关闭对应 WinHTTP 请求句柄。
            // 参数：客户端:HTTP客户端；返回：int；可见性：default
            HTTP客户端_取消全部请求(0)
            // 命令ID：HTTP客户端_取活动请求数
            // [19] HTTP客户端_取活动请求数(客户端)
            // 功能：返回当前正在发送或接收的请求数量。
            // 参数：客户端:HTTP客户端；返回：int；可见性：default
            HTTP客户端_取活动请求数(0)
        如果结束
        调试输出("已查看 命令 1–19：HTTP客户端_创建客户端 至 HTTP客户端_取活动请求数；勾选允许实际执行后会使用演示参数调用。")
    结束

    事件 _运行第02组_被单击()
        控件_设置文本(演示状态, "命令 20–38：HTTP客户端_取累计请求数 至 HTTP客户端_销毁请求；源码内含完整签名、参数、返回值与调用。")
        如果 (控件_取勾选(允许实际执行))
            // 命令ID：HTTP客户端_取累计请求数
            // [20] HTTP客户端_取累计请求数(客户端)
            // 功能：返回客户端已开始执行的累计请求数量。
            // 参数：客户端:HTTP客户端；返回：longLong；可见性：default
            HTTP客户端_取累计请求数(0)
            // 命令ID：HTTP客户端_取客户端错误
            // [21] HTTP客户端_取客户端错误(客户端)
            // 功能：返回客户端配置、会话创建或句柄操作的最近中文错误。
            // 参数：客户端:HTTP客户端；返回：wideString；可见性：default
            HTTP客户端_取客户端错误(0)
            // 命令ID：HTTP客户端_创建请求
            // [22] HTTP客户端_创建请求(客户端, 方法, 地址)
            // 功能：创建尚未执行的受管请求；仅接受 http:// 或 https:// 和合法 HTTP 方法。
            // 参数：客户端:HTTP客户端，方法:wideString，地址:wideString；返回：HTTP客户端请求；可见性：default
            HTTP客户端_创建请求(0, "演示参数2", "https://example.com")
            // 命令ID：HTTP客户端_设置请求头
            // [23] HTTP客户端_设置请求头(请求, 名称, 值)
            // 功能：在请求启动前设置或替换请求头。
            // 参数：请求:HTTP客户端请求，名称:wideString，值:wideString；返回：bool；可见性：default
            HTTP客户端_设置请求头(0, "演示参数2", "演示参数3")
            // 命令ID：HTTP客户端_添加请求头
            // [24] HTTP客户端_添加请求头(请求, 名称, 值)
            // 功能：在请求启动前追加请求头。
            // 参数：请求:HTTP客户端请求，名称:wideString，值:wideString；返回：bool；可见性：default
            HTTP客户端_添加请求头(0, "演示参数2", "演示参数3")
            // 命令ID：HTTP客户端_删除请求头
            // [25] HTTP客户端_删除请求头(请求, 名称)
            // 功能：在请求启动前删除全部同名请求头。
            // 参数：请求:HTTP客户端请求，名称:wideString；返回：bool；可见性：default
            HTTP客户端_删除请求头(0, "演示参数2")
            // 命令ID：HTTP客户端_清空请求头
            // [26] HTTP客户端_清空请求头(请求)
            // 功能：在请求启动前清空请求级请求头，不影响客户端默认头。
            // 参数：请求:HTTP客户端请求；返回：bool；可见性：default
            HTTP客户端_清空请求头(0)
            // 命令ID：HTTP客户端_设置文本正文
            // [27] HTTP客户端_设置文本正文(请求, 正文, 内容类型)
            // 功能：把文本编码为 UTF-8 请求正文并设置 Content-Type。
            // 参数：请求:HTTP客户端请求，正文:wideString，内容类型:wideString；返回：bool；可见性：default
            HTTP客户端_设置文本正文(0, "演示参数2", "演示参数3")
            // 命令ID：HTTP客户端_设置JSON正文
            // [28] HTTP客户端_设置JSON正文(请求, JSON)
            // 功能：把 UTF-8 JSON 文本设为请求正文并使用 application/json。
            // 参数：请求:HTTP客户端请求，JSON:wideString；返回：bool；可见性：default
            HTTP客户端_设置JSON正文(0, "{}")
            // 命令ID：HTTP客户端_设置二进制正文
            // [29] HTTP客户端_设置二进制正文(请求, 数据, 内容类型)
            // 功能：设置独立复制的字节集请求正文。
            // 参数：请求:HTTP客户端请求，数据:bytes，内容类型:wideString；返回：bool；可见性：default
            HTTP客户端_设置二进制正文(0, {}, "演示参数3")
            // 命令ID：HTTP客户端_设置十六进制正文
            // [30] HTTP客户端_设置十六进制正文(请求, 十六进制, 内容类型)
            // 功能：校验并解码偶数长度十六进制文本作为请求正文。
            // 参数：请求:HTTP客户端请求，十六进制:wideString，内容类型:wideString；返回：bool；可见性：default
            HTTP客户端_设置十六进制正文(0, "演示参数2", "演示参数3")
            // 命令ID：HTTP客户端_设置文件正文
            // [31] HTTP客户端_设置文件正文(请求, 文件路径, 内容类型)
            // 功能：以 64KB 分块上传本机文件，不把整个文件载入内存。
            // 参数：请求:HTTP客户端请求，文件路径:wideString，内容类型:wideString；返回：bool；可见性：default
            HTTP客户端_设置文件正文(0, "module-demo-temp.txt", "演示参数3")
            // 命令ID：HTTP客户端_设置响应文件
            // [32] HTTP客户端_设置响应文件(请求, 文件路径, 允许覆盖)
            // 功能：把响应流式写入临时文件并原子替换目标文件，避免大响应驻留内存。
            // 参数：请求:HTTP客户端请求，文件路径:wideString，允许覆盖:bool；返回：bool；可见性：default
            HTTP客户端_设置响应文件(0, "module-demo-temp.txt", 真)
            // 命令ID：HTTP客户端_绑定完成处理器
            // [33] HTTP客户端_绑定完成处理器(请求, &处理器)
            // 功能：绑定请求完成后在创建窗口 UI 线程调用的无参数处理器。
            // 参数：请求:HTTP客户端请求，处理器:handler；返回：bool；可见性：default
            HTTP客户端_绑定完成处理器(0, &模块演示回调)
            // 命令ID：HTTP客户端_开始请求
            // [34] HTTP客户端_开始请求(请求)
            // 功能：在独立后台线程执行请求，完成后投递 UI 线程处理器。
            // 参数：请求:HTTP客户端请求；返回：bool；可见性：default
            HTTP客户端_开始请求(0)
            // 命令ID：HTTP客户端_执行同步
            // [35] HTTP客户端_执行同步(请求)
            // 功能：在当前线程同步执行请求；主要用于命令行、测试或受控后台任务，UI 代码应使用异步。
            // 参数：请求:HTTP客户端请求；返回：bool；可见性：advanced
            HTTP客户端_执行同步(0)
            // 命令ID：HTTP客户端_等待请求
            // [36] HTTP客户端_等待请求(请求, 超时毫秒)
            // 功能：等待异步请求完成；主要用于测试和后台任务，UI 线程不应长时间等待。
            // 参数：请求:HTTP客户端请求，超时毫秒:int；返回：bool；可见性：advanced
            HTTP客户端_等待请求(0, 1)
            // 命令ID：HTTP客户端_取消请求
            // [37] HTTP客户端_取消请求(请求)
            // 功能：请求取消并关闭活动 WinHTTP 句柄；已完成请求返回假。
            // 参数：请求:HTTP客户端请求；返回：bool；可见性：default
            HTTP客户端_取消请求(0)
            // 命令ID：HTTP客户端_销毁请求
            // [38] HTTP客户端_销毁请求(请求)
            // 功能：取消、等待后台线程结束并永久释放请求 ID。
            // 参数：请求:HTTP客户端请求；返回：bool；可见性：default
            HTTP客户端_销毁请求(0)
        如果结束
        调试输出("已查看 命令 20–38：HTTP客户端_取累计请求数 至 HTTP客户端_销毁请求；勾选允许实际执行后会使用演示参数调用。")
    结束

    事件 _运行第03组_被单击()
        控件_设置文本(演示状态, "命令 39–57：HTTP客户端_取请求客户端 至 HTTP客户端_取响应大小；源码内含完整签名、参数、返回值与调用。")
        如果 (控件_取勾选(允许实际执行))
            // 命令ID：HTTP客户端_取请求客户端
            // [39] HTTP客户端_取请求客户端(请求)
            // 功能：返回请求所属的受管客户端 ID。
            // 参数：请求:HTTP客户端请求；返回：HTTP客户端；可见性：default
            HTTP客户端_取请求客户端(0)
            // 命令ID：HTTP客户端_取请求方法
            // [40] HTTP客户端_取请求方法(请求)
            // 功能：返回请求的大写 HTTP 方法。
            // 参数：请求:HTTP客户端请求；返回：wideString；可见性：default
            HTTP客户端_取请求方法(0)
            // 命令ID：HTTP客户端_取请求地址
            // [41] HTTP客户端_取请求地址(请求)
            // 功能：返回请求创建时的原始 URL。
            // 参数：请求:HTTP客户端请求；返回：wideString；可见性：default
            HTTP客户端_取请求地址(0)
            // 命令ID：HTTP客户端_取请求状态
            // [42] HTTP客户端_取请求状态(请求)
            // 功能：返回未开始、运行中、已完成、已取消或错误。
            // 参数：请求:HTTP客户端请求；返回：wideString；可见性：default
            HTTP客户端_取请求状态(0)
            // 命令ID：HTTP客户端_请求是否完成
            // [43] HTTP客户端_请求是否完成(请求)
            // 功能：判断请求是否已结束，包括成功、HTTP 非 2xx、错误或取消。
            // 参数：请求:HTTP客户端请求；返回：bool；可见性：default
            HTTP客户端_请求是否完成(0)
            // 命令ID：HTTP客户端_请求是否成功
            // [44] HTTP客户端_请求是否成功(请求)
            // 功能：判断传输成功且 HTTP 状态码位于 200-299。
            // 参数：请求:HTTP客户端请求；返回：bool；可见性：default
            HTTP客户端_请求是否成功(0)
            // 命令ID：HTTP客户端_取请求错误
            // [45] HTTP客户端_取请求错误(请求)
            // 功能：返回请求最近中文错误，不包含凭据或请求正文。
            // 参数：请求:HTTP客户端请求；返回：wideString；可见性：default
            HTTP客户端_取请求错误(0)
            // 命令ID：HTTP客户端_取系统错误码
            // [46] HTTP客户端_取系统错误码(请求)
            // 功能：返回最近 WinHTTP 或 Win32 错误码；协议状态失败通常为 0。
            // 参数：请求:HTTP客户端请求；返回：int；可见性：default
            HTTP客户端_取系统错误码(0)
            // 命令ID：HTTP客户端_取请求耗时
            // [47] HTTP客户端_取请求耗时(请求)
            // 功能：返回请求开始到结束的毫秒数。
            // 参数：请求:HTTP客户端请求；返回：longLong；可见性：default
            HTTP客户端_取请求耗时(0)
            // 命令ID：HTTP客户端_取上传字节数
            // [48] HTTP客户端_取上传字节数(请求)
            // 功能：返回已经成功写入 WinHTTP 的请求正文字节数。
            // 参数：请求:HTTP客户端请求；返回：longLong；可见性：default
            HTTP客户端_取上传字节数(0)
            // 命令ID：HTTP客户端_取下载字节数
            // [49] HTTP客户端_取下载字节数(请求)
            // 功能：返回已经读取并校验的响应正文字节数。
            // 参数：请求:HTTP客户端请求；返回：longLong；可见性：default
            HTTP客户端_取下载字节数(0)
            // 命令ID：HTTP客户端_取响应状态码
            // [50] HTTP客户端_取响应状态码(请求)
            // 功能：返回 HTTP 响应状态码；传输失败且无响应时为 0。
            // 参数：请求:HTTP客户端请求；返回：int；可见性：default
            HTTP客户端_取响应状态码(0)
            // 命令ID：HTTP客户端_取响应状态文本
            // [51] HTTP客户端_取响应状态文本(请求)
            // 功能：返回服务端状态文本，例如 OK 或 Not Found。
            // 参数：请求:HTTP客户端请求；返回：wideString；可见性：default
            HTTP客户端_取响应状态文本(0)
            // 命令ID：HTTP客户端_取响应协议
            // [52] HTTP客户端_取响应协议(请求)
            // 功能：返回响应协议版本，例如 HTTP/1.1 或 HTTP/2。
            // 参数：请求:HTTP客户端请求；返回：wideString；可见性：default
            HTTP客户端_取响应协议(0)
            // 命令ID：HTTP客户端_取最终地址
            // [53] HTTP客户端_取最终地址(请求)
            // 功能：返回自动重定向后的最终 URL。
            // 参数：请求:HTTP客户端请求；返回：wideString；可见性：default
            HTTP客户端_取最终地址(0)
            // 命令ID：HTTP客户端_取全部响应头
            // [54] HTTP客户端_取全部响应头(请求)
            // 功能：返回 WinHTTP 提供的完整 CRLF 响应头文本。
            // 参数：请求:HTTP客户端请求；返回：wideString；可见性：default
            HTTP客户端_取全部响应头(0)
            // 命令ID：HTTP客户端_取响应头JSON
            // [55] HTTP客户端_取响应头JSON(请求)
            // 功能：以 UTF-16 JSON 对象返回响应头；重复头合并为逗号分隔文本。
            // 参数：请求:HTTP客户端请求；返回：wideString；可见性：default
            HTTP客户端_取响应头JSON(0)
            // 命令ID：HTTP客户端_取响应十六进制
            // [56] HTTP客户端_取响应十六进制(请求)
            // 功能：以小写十六进制返回内存响应正文。
            // 参数：请求:HTTP客户端请求；返回：wideString；可见性：default
            HTTP客户端_取响应十六进制(0)
            // 命令ID：HTTP客户端_取响应大小
            // [57] HTTP客户端_取响应大小(请求)
            // 功能：返回响应正文总字节数，包括流式写入文件的响应。
            // 参数：请求:HTTP客户端请求；返回：longLong；可见性：default
            HTTP客户端_取响应大小(0)
        如果结束
        调试输出("已查看 命令 39–57：HTTP客户端_取请求客户端 至 HTTP客户端_取响应大小；勾选允许实际执行后会使用演示参数调用。")
    结束

    事件 _运行第04组_被单击()
        控件_设置文本(演示状态, "命令 58–74：HTTP客户端_取响应文件 至 HTTP客户端_清空状态；源码内含完整签名、参数、返回值与调用。")
        如果 (控件_取勾选(允许实际执行))
            // 命令ID：HTTP客户端_取响应文件
            // [58] HTTP客户端_取响应文件(请求)
            // 功能：返回成功流式保存后的目标文件路径。
            // 参数：请求:HTTP客户端请求；返回：wideString；可见性：default
            HTTP客户端_取响应文件(0)
            // 命令ID：HTTP客户端_取内容类型
            // [59] HTTP客户端_取内容类型(请求)
            // 功能：返回响应 Content-Type。
            // 参数：请求:HTTP客户端请求；返回：wideString；可见性：default
            HTTP客户端_取内容类型(0)
            // 命令ID：HTTP客户端_取服务器证书SHA256
            // [60] HTTP客户端_取服务器证书SHA256(请求)
            // 功能：返回最终 HTTPS 服务端证书 SHA-256 指纹；HTTP 请求为空。
            // 参数：请求:HTTP客户端请求；返回：wideString；可见性：default
            HTTP客户端_取服务器证书SHA256(0)
            // 命令ID：HTTP客户端_取响应头
            // [61] HTTP客户端_取响应头(请求, 名称)
            // 功能：不区分大小写返回合并后的指定响应头。
            // 参数：请求:HTTP客户端请求，名称:wideString；返回：wideString；可见性：default
            HTTP客户端_取响应头(0, "演示参数2")
            // 命令ID：HTTP客户端_取响应字节集
            // [62] HTTP客户端_取响应字节集(请求)
            // 功能：返回内存响应正文的独立字节集副本；流式文件响应返回空字节集。
            // 参数：请求:HTTP客户端请求；返回：bytes；可见性：default
            HTTP客户端_取响应字节集(0)
            // 命令ID：HTTP客户端_取响应文本编码
            // [63] HTTP客户端_取响应文本编码(请求, 编码)
            // 功能：按 auto、UTF-8、UTF-16LE、UTF-16BE、GBK、GB18030 或 ANSI 解码内存响应。
            // 参数：请求:HTTP客户端请求，编码:wideString；返回：wideString；可见性：default
            HTTP客户端_取响应文本编码(0, "演示参数2")
            // 命令ID：HTTP客户端_保存响应文件
            // [64] HTTP客户端_保存响应文件(请求, 文件路径, 允许覆盖)
            // 功能：把已缓冲的响应正文原子保存为文件；流式响应应使用设置响应文件。
            // 参数：请求:HTTP客户端请求，文件路径:wideString，允许覆盖:bool；返回：bool；可见性：default
            HTTP客户端_保存响应文件(0, "module-demo-temp.txt", 真)
            // 命令ID：HTTP客户端_取当前请求
            // [65] HTTP客户端_取当前请求()
            // 功能：在完成处理器中返回当前请求 ID；其它上下文返回 0。
            // 参数：无；返回：HTTP客户端请求；可见性：default
            HTTP客户端_取当前请求()
            // 命令ID：HTTP客户端_GET异步
            // [66] HTTP客户端_GET异步(客户端, 地址, &处理器)
            // 功能：创建并开始 GET 请求，返回请求 ID；完成后在 UI 线程调用处理器。
            // 参数：客户端:HTTP客户端，地址:wideString，处理器:handler；返回：HTTP客户端请求；可见性：default
            HTTP客户端_GET异步(0, "https://example.com", &模块演示回调)
            // 命令ID：HTTP客户端_POSTJSON异步
            // [67] HTTP客户端_POSTJSON异步(客户端, 地址, JSON, &处理器)
            // 功能：创建带 UTF-8 JSON 正文的 POST 请求并异步开始。
            // 参数：客户端:HTTP客户端，地址:wideString，JSON:wideString，处理器:handler；返回：HTTP客户端请求；可见性：default
            HTTP客户端_POSTJSON异步(0, "https://example.com", "{}", &模块演示回调)
            // 命令ID：HTTP客户端_请求
            // [68] HTTP客户端_请求(方法, 地址, 正文, 超时毫秒)
            // 功能：旧版同步兼容入口；使用默认客户端发送 UTF-8 请求，新代码应使用受管客户端和请求。
            // 参数：方法:wideString，地址:wideString，正文:wideString，超时毫秒:int；返回：bool；可见性：advanced
            HTTP客户端_请求("演示参数1", "https://example.com", "演示参数3", 1)
            // 命令ID：HTTP客户端_GET
            // [69] HTTP客户端_GET(地址)
            // 功能：旧版同步 GET 兼容入口。
            // 参数：地址:wideString；返回：bool；可见性：advanced
            HTTP客户端_GET("https://example.com")
            // 命令ID：HTTP客户端_POST
            // [70] HTTP客户端_POST(地址, 正文)
            // 功能：旧版同步 UTF-8 JSON POST 兼容入口。
            // 参数：地址:wideString，正文:wideString；返回：bool；可见性：advanced
            HTTP客户端_POST("https://example.com", "演示参数2")
            // 命令ID：HTTP客户端_取状态码
            // [71] HTTP客户端_取状态码()
            // 功能：旧版兼容入口；返回最近默认请求状态码。
            // 参数：无；返回：int；可见性：advanced
            HTTP客户端_取状态码()
            // 命令ID：HTTP客户端_取响应文本
            // [72] HTTP客户端_取响应文本()
            // 功能：旧版兼容入口；按 UTF-8 返回最近默认请求正文。
            // 参数：无；返回：wideString；可见性：advanced
            HTTP客户端_取响应文本()
            // 命令ID：HTTP客户端_取错误
            // [73] HTTP客户端_取错误()
            // 功能：旧版兼容入口；返回最近默认请求中文错误。
            // 参数：无；返回：wideString；可见性：advanced
            HTTP客户端_取错误()
            // 命令ID：HTTP客户端_清空状态
            // [74] HTTP客户端_清空状态()
            // 功能：旧版兼容入口；清空最近默认请求状态。
            // 参数：无；返回：void；可见性：advanced
            HTTP客户端_清空状态()
        如果结束
        调试输出("已查看 命令 58–74：HTTP客户端_取响应文件 至 HTTP客户端_清空状态；勾选允许实际执行后会使用演示参数调用。")
    结束

    事件 模块演示回调()
        调试输出("模块演示回调已触发。")
    结束

结束类
