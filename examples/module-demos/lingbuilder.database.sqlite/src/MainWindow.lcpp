包 SQLite数据库模块完整演示
使用 Win32窗口基础模块
使用 SQLite数据库模块

// 本项目由模块清单自动生成；每条 binding 命令都在下方具有真实调用语句。
// 为避免误删文件、启动进程、访问网络或操作设备，必须先勾选“允许实际执行”才会进入命令调用区。
类 MainWindow : 公开 窗口
    事件 _MainWindow_创建完毕()
        控件_设置选择项(命令分组选项卡, 0)
        控件_设置文本(演示状态, "SQLite 数据库模块：67 条命令，默认处于安全预览模式。")
        调试输出("已加载模块演示：lingbuilder.database.sqlite")
    结束

    事件 _运行第01组_被单击()
        控件_设置文本(演示状态, "命令 1–17：SQLite_加载运行库 至 SQLite_启用WAL；源码内含完整签名、参数、返回值与调用。")
        如果 (控件_取勾选(允许实际执行))
            // 命令ID：SQLite_加载运行库
            // [1] SQLite_加载运行库(DLL路径)
            // 功能：显式加载 SQLite 运行库并校验模块所需导出。存在活动连接时拒绝切换 DLL。
            // 参数：DLL路径:wideString；返回：bool；可见性：default
            SQLite_加载运行库("module-demo-temp.txt")
            // 命令ID：SQLite_卸载运行库
            // [2] SQLite_卸载运行库()
            // 功能：在没有活动连接和语句时卸载 sqlite3.dll。
            // 参数：无；返回：bool；可见性：default
            SQLite_卸载运行库()
            // 命令ID：SQLite_取运行库版本
            // [3] SQLite_取运行库版本()
            // 功能：返回当前已加载 SQLite 运行库的版本号。
            // 参数：无；返回：wideString；可见性：default
            SQLite_取运行库版本()
            // 命令ID：SQLite_运行库线程安全
            // [4] SQLite_运行库线程安全()
            // 功能：返回运行库编译时是否启用了 SQLite 线程安全支持。
            // 参数：无；返回：bool；可见性：default
            SQLite_运行库线程安全()
            // 命令ID：SQLite_打开
            // [5] SQLite_打开(数据库路径)
            // 功能：兼容接口：打开默认读写连接，自动创建文件、启用外键并设置 5 秒忙等待。
            // 参数：数据库路径:wideString；返回：bool；可见性：default
            SQLite_打开("module-demo-temp.txt")
            // 命令ID：SQLite_打开连接
            // [6] SQLite_打开连接(数据库路径, 打开模式, 忙等待毫秒)
            // 功能：打开独立的 FULLMUTEX 连接；成功后默认启用扩展错误码和外键约束。
            // 参数：数据库路径:wideString，打开模式:int，忙等待毫秒:int；返回：SQLite连接；可见性：default
            SQLite_打开连接("module-demo-temp.txt", 1, 1)
            // 命令ID：SQLite_打开内存库
            // [7] SQLite_打开内存库(名称)
            // 功能：创建独立的内存数据库连接。
            // 参数：名称:wideString；返回：SQLite连接；可见性：default
            SQLite_打开内存库("演示参数1")
            // 命令ID：SQLite_关闭
            // [8] SQLite_关闭()
            // 功能：兼容接口：关闭默认连接；没有其它连接时同时卸载运行库。
            // 参数：无；返回：void；可见性：default
            SQLite_关闭()
            // 命令ID：SQLite_关闭连接
            // [9] SQLite_关闭连接(连接)
            // 功能：释放连接所属全部语句后关闭连接。失效句柄会返回假。
            // 参数：连接:SQLite连接；返回：bool；可见性：default
            SQLite_关闭连接(0)
            // 命令ID：SQLite_关闭全部
            // [10] SQLite_关闭全部()
            // 功能：释放所有语句、关闭所有连接并卸载运行库。
            // 参数：无；返回：void；可见性：default
            SQLite_关闭全部()
            // 命令ID：SQLite_连接是否有效
            // [11] SQLite_连接是否有效(连接)
            // 功能：检查受管连接 ID 当前是否仍然有效。
            // 参数：连接:SQLite连接；返回：bool；可见性：default
            SQLite_连接是否有效(0)
            // 命令ID：SQLite_连接是否只读
            // [12] SQLite_连接是否只读(连接)
            // 功能：检查连接的 main 数据库是否为只读。
            // 参数：连接:SQLite连接；返回：bool；可见性：default
            SQLite_连接是否只读(0)
            // 命令ID：SQLite_连接是否在事务中
            // [13] SQLite_连接是否在事务中(连接)
            // 功能：返回连接是否处于显式事务或保存点中。
            // 参数：连接:SQLite连接；返回：bool；可见性：default
            SQLite_连接是否在事务中(0)
            // 命令ID：SQLite_设置忙等待
            // [14] SQLite_设置忙等待(连接, 毫秒)
            // 功能：设置连接遇到 SQLITE_BUSY 时的等待时间。
            // 参数：连接:SQLite连接，毫秒:int；返回：bool；可见性：default
            SQLite_设置忙等待(0, 1)
            // 命令ID：SQLite_设置外键
            // [15] SQLite_设置外键(连接, 启用)
            // 功能：启用或禁用 SQLite 外键约束；事务内修改会失败。
            // 参数：连接:SQLite连接，启用:bool；返回：bool；可见性：default
            SQLite_设置外键(0, 真)
            // 命令ID：SQLite_设置同步模式
            // [16] SQLite_设置同步模式(连接, 模式)
            // 功能：设置 PRAGMA synchronous。
            // 参数：连接:SQLite连接，模式:int；返回：bool；可见性：default
            SQLite_设置同步模式(0, 1)
            // 命令ID：SQLite_启用WAL
            // [17] SQLite_启用WAL(连接)
            // 功能：把文件数据库切换为 WAL 日志模式并确认 SQLite 返回 wal。
            // 参数：连接:SQLite连接；返回：bool；可见性：default
            SQLite_启用WAL(0)
        如果结束
        调试输出("已查看 命令 1–17：SQLite_加载运行库 至 SQLite_启用WAL；勾选允许实际执行后会使用演示参数调用。")
    结束

    事件 _运行第02组_被单击()
        控件_设置文本(演示状态, "命令 18–34：SQLite_设置WAL自动检查点 至 SQLite_语句取参数索引；源码内含完整签名、参数、返回值与调用。")
        如果 (控件_取勾选(允许实际执行))
            // 命令ID：SQLite_设置WAL自动检查点
            // [18] SQLite_设置WAL自动检查点(连接, 页数)
            // 功能：设置 WAL 自动检查点页数。
            // 参数：连接:SQLite连接，页数:int；返回：bool；可见性：default
            SQLite_设置WAL自动检查点(0, 1)
            // 命令ID：SQLite_WAL检查点
            // [19] SQLite_WAL检查点(连接, 模式)
            // 功能：执行 WAL 检查点并返回状态：0 成功、1 忙、-1 失败。
            // 参数：连接:SQLite连接，模式:int；返回：int；可见性：default
            SQLite_WAL检查点(0, 1)
            // 命令ID：SQLite_取WAL日志帧数
            // [20] SQLite_取WAL日志帧数()
            // 功能：返回当前线程最近一次 WAL 检查点报告的日志帧数。
            // 参数：无；返回：int；可见性：default
            SQLite_取WAL日志帧数()
            // 命令ID：SQLite_取WAL已检查点帧数
            // [21] SQLite_取WAL已检查点帧数()
            // 功能：返回当前线程最近一次 WAL 检查点报告的已检查点帧数。
            // 参数：无；返回：int；可见性：default
            SQLite_取WAL已检查点帧数()
            // 命令ID：SQLite_执行
            // [22] SQLite_执行(SQL语句)
            // 功能：兼容接口：在默认连接执行无结果 SQL。
            // 参数：SQL语句:wideString；返回：bool；可见性：default
            SQLite_执行("演示参数1")
            // 命令ID：SQLite_执行于
            // [23] SQLite_执行于(连接, SQL语句)
            // 功能：在指定连接执行一条或多条无结果 SQL。
            // 参数：连接:SQLite连接，SQL语句:wideString；返回：bool；可见性：default
            SQLite_执行于(0, "演示参数2")
            // 命令ID：SQLite_查询首值
            // [24] SQLite_查询首值(SQL语句)
            // 功能：兼容接口：返回默认连接首行首列的文本表示。NULL、无行或失败均返回空文本，应结合错误码判断。
            // 参数：SQL语句:wideString；返回：wideString；可见性：default
            SQLite_查询首值("演示参数1")
            // 命令ID：SQLite_查询首值于
            // [25] SQLite_查询首值于(连接, SQL语句)
            // 功能：返回指定连接首行首列的文本表示；复杂查询应使用预编译语句。
            // 参数：连接:SQLite连接，SQL语句:wideString；返回：wideString；可见性：default
            SQLite_查询首值于(0, "演示参数2")
            // 命令ID：SQLite_准备
            // [26] SQLite_准备(连接, SQL语句)
            // 功能：创建受管预编译语句，用于参数化执行和逐行读取。
            // 参数：连接:SQLite连接，SQL语句:wideString；返回：SQLite语句；可见性：default
            SQLite_准备(0, "演示参数2")
            // 命令ID：SQLite_语句是否有效
            // [27] SQLite_语句是否有效(语句)
            // 功能：检查预编译语句 ID 当前是否仍然有效。
            // 参数：语句:SQLite语句；返回：bool；可见性：default
            SQLite_语句是否有效(0)
            // 命令ID：SQLite_语句步进
            // [28] SQLite_语句步进(语句)
            // 功能：执行或读取下一行：1=得到一行，0=执行完成，-1=失败。
            // 参数：语句:SQLite语句；返回：int；可见性：default
            SQLite_语句步进(0)
            // 命令ID：SQLite_语句重置
            // [29] SQLite_语句重置(语句)
            // 功能：把语句重置到首次步进前，保留现有参数绑定。
            // 参数：语句:SQLite语句；返回：bool；可见性：default
            SQLite_语句重置(0)
            // 命令ID：SQLite_语句清空绑定
            // [30] SQLite_语句清空绑定(语句)
            // 功能：把语句的全部参数恢复为 NULL。
            // 参数：语句:SQLite语句；返回：bool；可见性：default
            SQLite_语句清空绑定(0)
            // 命令ID：SQLite_语句释放
            // [31] SQLite_语句释放(语句)
            // 功能：立即释放预编译语句；连接关闭时也会兜底释放。
            // 参数：语句:SQLite语句；返回：bool；可见性：default
            SQLite_语句释放(0)
            // 命令ID：SQLite_语句是否只读
            // [32] SQLite_语句是否只读(语句)
            // 功能：判断语句是否不会直接修改数据库内容。
            // 参数：语句:SQLite语句；返回：bool；可见性：default
            SQLite_语句是否只读(0)
            // 命令ID：SQLite_语句取参数数量
            // [33] SQLite_语句取参数数量(语句)
            // 功能：返回 SQL 中参数的最大索引。
            // 参数：语句:SQLite语句；返回：int；可见性：default
            SQLite_语句取参数数量(0)
            // 命令ID：SQLite_语句取参数索引
            // [34] SQLite_语句取参数索引(语句, 参数名)
            // 功能：返回命名参数的 1 起始索引，找不到返回 0。
            // 参数：语句:SQLite语句，参数名:wideString；返回：int；可见性：default
            SQLite_语句取参数索引(0, "演示参数2")
        如果结束
        调试输出("已查看 命令 18–34：SQLite_设置WAL自动检查点 至 SQLite_语句取参数索引；勾选允许实际执行后会使用演示参数调用。")
    结束

    事件 _运行第03组_被单击()
        控件_设置文本(演示状态, "命令 35–51：SQLite_绑定空值 至 SQLite_提交事务；源码内含完整签名、参数、返回值与调用。")
        如果 (控件_取勾选(允许实际执行))
            // 命令ID：SQLite_绑定空值
            // [35] SQLite_绑定空值(语句, 参数索引)
            // 功能：把参数绑定为 SQL NULL。
            // 参数：语句:SQLite语句，参数索引:int；返回：bool；可见性：default
            SQLite_绑定空值(0, 1)
            // 命令ID：SQLite_绑定整数
            // [36] SQLite_绑定整数(语句, 参数索引, 数值)
            // 功能：把参数绑定为 32 位整数。
            // 参数：语句:SQLite语句，参数索引:int，数值:int；返回：bool；可见性：default
            SQLite_绑定整数(0, 1, 1)
            // 命令ID：SQLite_绑定长整数
            // [37] SQLite_绑定长整数(语句, 参数索引, 数值)
            // 功能：把参数绑定为 64 位整数。
            // 参数：语句:SQLite语句，参数索引:int，数值:longLong；返回：bool；可见性：default
            SQLite_绑定长整数(0, 1, 1)
            // 命令ID：SQLite_绑定小数
            // [38] SQLite_绑定小数(语句, 参数索引, 数值)
            // 功能：把参数绑定为双精度小数。
            // 参数：语句:SQLite语句，参数索引:int，数值:double；返回：bool；可见性：default
            SQLite_绑定小数(0, 1, 1.0)
            // 命令ID：SQLite_绑定文本
            // [39] SQLite_绑定文本(语句, 参数索引, 文本)
            // 功能：把参数安全绑定为文本。
            // 参数：语句:SQLite语句，参数索引:int，文本:wideString；返回：bool；可见性：default
            SQLite_绑定文本(0, 1, "演示参数3")
            // 命令ID：SQLite_绑定字节集
            // [40] SQLite_绑定字节集(语句, 参数索引, 数据)
            // 功能：把参数安全绑定为 BLOB。
            // 参数：语句:SQLite语句，参数索引:int，数据:bytes；返回：bool；可见性：default
            SQLite_绑定字节集(0, 1, {})
            // 命令ID：SQLite_取列数量
            // [41] SQLite_取列数量(语句)
            // 功能：返回结果列数量。
            // 参数：语句:SQLite语句；返回：int；可见性：default
            SQLite_取列数量(0)
            // 命令ID：SQLite_取列名称
            // [42] SQLite_取列名称(语句, 列索引)
            // 功能：返回结果列名。
            // 参数：语句:SQLite语句，列索引:int；返回：wideString；可见性：default
            SQLite_取列名称(0, 1)
            // 命令ID：SQLite_取列类型
            // [43] SQLite_取列类型(语句, 列索引)
            // 功能：返回当前行存储类型：1=整数，2=小数，3=文本，4=字节集，5=NULL；失败返回 0。
            // 参数：语句:SQLite语句，列索引:int；返回：int；可见性：default
            SQLite_取列类型(0, 1)
            // 命令ID：SQLite_取列是否为空
            // [44] SQLite_取列是否为空(语句, 列索引)
            // 功能：判断当前行指定列是否为 SQL NULL。
            // 参数：语句:SQLite语句，列索引:int；返回：bool；可见性：default
            SQLite_取列是否为空(0, 1)
            // 命令ID：SQLite_取列整数
            // [45] SQLite_取列整数(语句, 列索引)
            // 功能：按 SQLite 转换规则读取 32 位整数。
            // 参数：语句:SQLite语句，列索引:int；返回：int；可见性：default
            SQLite_取列整数(0, 1)
            // 命令ID：SQLite_取列长整数
            // [46] SQLite_取列长整数(语句, 列索引)
            // 功能：按 SQLite 转换规则读取 64 位整数。
            // 参数：语句:SQLite语句，列索引:int；返回：longLong；可见性：default
            SQLite_取列长整数(0, 1)
            // 命令ID：SQLite_取列小数
            // [47] SQLite_取列小数(语句, 列索引)
            // 功能：按 SQLite 转换规则读取双精度小数。
            // 参数：语句:SQLite语句，列索引:int；返回：double；可见性：default
            SQLite_取列小数(0, 1)
            // 命令ID：SQLite_取列文本
            // [48] SQLite_取列文本(语句, 列索引)
            // 功能：读取 UTF-8 文本；SQL NULL 返回空文本，应用应先检查列类型。
            // 参数：语句:SQLite语句，列索引:int；返回：wideString；可见性：default
            SQLite_取列文本(0, 1)
            // 命令ID：SQLite_取列字节集
            // [49] SQLite_取列字节集(语句, 列索引)
            // 功能：读取 BLOB 的独立副本；SQL NULL 返回空字节集。
            // 参数：语句:SQLite语句，列索引:int；返回：bytes；可见性：default
            SQLite_取列字节集(0, 1)
            // 命令ID：SQLite_开始事务
            // [50] SQLite_开始事务(连接, 模式)
            // 功能：开始显式事务；批量写入推荐 IMMEDIATE。
            // 参数：连接:SQLite连接，模式:int；返回：bool；可见性：default
            SQLite_开始事务(0, 1)
            // 命令ID：SQLite_提交事务
            // [51] SQLite_提交事务(连接)
            // 功能：提交当前事务。失败时事务可能仍保持活动，应读取错误并决定回滚。
            // 参数：连接:SQLite连接；返回：bool；可见性：default
            SQLite_提交事务(0)
        如果结束
        调试输出("已查看 命令 35–51：SQLite_绑定空值 至 SQLite_提交事务；勾选允许实际执行后会使用演示参数调用。")
    结束

    事件 _运行第04组_被单击()
        控件_设置文本(演示状态, "命令 52–67：SQLite_回滚事务 至 SQLite_错误码到文本；源码内含完整签名、参数、返回值与调用。")
        如果 (控件_取勾选(允许实际执行))
            // 命令ID：SQLite_回滚事务
            // [52] SQLite_回滚事务(连接)
            // 功能：回滚当前事务。
            // 参数：连接:SQLite连接；返回：bool；可见性：default
            SQLite_回滚事务(0)
            // 命令ID：SQLite_创建保存点
            // [53] SQLite_创建保存点(连接, 名称)
            // 功能：创建可嵌套保存点。
            // 参数：连接:SQLite连接，名称:wideString；返回：bool；可见性：default
            SQLite_创建保存点(0, "演示参数2")
            // 命令ID：SQLite_释放保存点
            // [54] SQLite_释放保存点(连接, 名称)
            // 功能：释放并提交指定保存点。
            // 参数：连接:SQLite连接，名称:wideString；返回：bool；可见性：default
            SQLite_释放保存点(0, "演示参数2")
            // 命令ID：SQLite_回滚到保存点
            // [55] SQLite_回滚到保存点(连接, 名称)
            // 功能：回滚到指定保存点但不自动释放它。
            // 参数：连接:SQLite连接，名称:wideString；返回：bool；可见性：default
            SQLite_回滚到保存点(0, "演示参数2")
            // 命令ID：SQLite_备份到文件
            // [56] SQLite_备份到文件(连接, 目标路径, 忙等待毫秒)
            // 功能：使用 SQLite Online Backup API 生成一致性备份，不直接复制活动数据库文件。
            // 参数：连接:SQLite连接，目标路径:wideString，忙等待毫秒:int；返回：bool；可见性：default
            SQLite_备份到文件(0, "module-demo-temp.txt", 1)
            // 命令ID：SQLite_完整性检查
            // [57] SQLite_完整性检查(连接, 快速检查)
            // 功能：执行数据库完整性检查并返回首条结果；正常结果为 ok。
            // 参数：连接:SQLite连接，快速检查:bool；返回：wideString；可见性：default
            SQLite_完整性检查(0, 真)
            // 命令ID：SQLite_中断
            // [58] SQLite_中断(连接)
            // 功能：请求中断该连接当前正在执行的长查询；SQLite 会在安全点返回 SQLITE_INTERRUPT。
            // 参数：连接:SQLite连接；返回：bool；可见性：default
            SQLite_中断(0)
            // 命令ID：SQLite_取更改行数
            // [59] SQLite_取更改行数()
            // 功能：兼容接口：返回默认连接最近语句直接修改的行数。
            // 参数：无；返回：int；可见性：default
            SQLite_取更改行数()
            // 命令ID：SQLite_取连接更改行数
            // [60] SQLite_取连接更改行数(连接)
            // 功能：返回指定连接最近语句直接修改的 64 位行数。
            // 参数：连接:SQLite连接；返回：longLong；可见性：default
            SQLite_取连接更改行数(0)
            // 命令ID：SQLite_取累计更改行数
            // [61] SQLite_取累计更改行数(连接)
            // 功能：返回连接自打开以来直接修改的累计 64 位行数；SQLite 不会因事务回滚减少该计数。
            // 参数：连接:SQLite连接；返回：longLong；可见性：default
            SQLite_取累计更改行数(0)
            // 命令ID：SQLite_取最后插入行号
            // [62] SQLite_取最后插入行号(连接)
            // 功能：返回连接最近一次成功 INSERT 的 rowid；事务回滚不会自动恢复该值。
            // 参数：连接:SQLite连接；返回：longLong；可见性：default
            SQLite_取最后插入行号(0)
            // 命令ID：SQLite_取错误
            // [63] SQLite_取错误()
            // 功能：返回当前线程最近一次 SQLite 模块错误，包含操作、主错误码和扩展错误码。
            // 参数：无；返回：wideString；可见性：default
            SQLite_取错误()
            // 命令ID：SQLite_取错误码
            // [64] SQLite_取错误码()
            // 功能：返回当前线程最近一次 SQLite 主错误码。
            // 参数：无；返回：int；可见性：default
            SQLite_取错误码()
            // 命令ID：SQLite_取扩展错误码
            // [65] SQLite_取扩展错误码()
            // 功能：返回当前线程最近一次 SQLite 扩展错误码。
            // 参数：无；返回：int；可见性：default
            SQLite_取扩展错误码()
            // 命令ID：SQLite_取系统错误码
            // [66] SQLite_取系统错误码()
            // 功能：返回当前线程最近一次 SQLite 关联的操作系统错误码；运行库不支持时为 0。
            // 参数：无；返回：int；可见性：default
            SQLite_取系统错误码()
            // 命令ID：SQLite_错误码到文本
            // [67] SQLite_错误码到文本(错误码)
            // 功能：把 SQLite 错误码转换为运行库提供的英文稳定说明，便于日志和支持。
            // 参数：错误码:int；返回：wideString；可见性：default
            SQLite_错误码到文本(1)
        如果结束
        调试输出("已查看 命令 52–67：SQLite_回滚事务 至 SQLite_错误码到文本；勾选允许实际执行后会使用演示参数调用。")
    结束

结束类
