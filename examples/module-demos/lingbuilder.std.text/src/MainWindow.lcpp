包 文本处理模块完整演示
使用 Win32窗口基础模块
使用 文本处理模块

// 本项目由模块清单自动生成；每条 binding 命令都在下方具有真实调用语句。
// 为避免误删文件、启动进程、访问网络或操作设备，必须先勾选“允许实际执行”才会进入命令调用区。
类 MainWindow : 公开 窗口
    事件 _MainWindow_创建完毕()
        控件_设置选择项(命令分组选项卡, 0)
        控件_设置文本(演示状态, "文本处理模块：31 条命令，默认处于安全预览模式。")
        调试输出("已加载模块演示：lingbuilder.std.text")
    结束

    事件 _运行第01组_被单击()
        控件_设置文本(演示状态, "命令 1–16：文本_取长度 至 文本_到半角；源码内含完整签名、参数、返回值与调用。")
        局部 长整数型 演示结果数组[]
        如果 (控件_取勾选(允许实际执行))
            // 命令ID：文本_取长度
            // [1] 文本_取长度(文本)
            // 功能：返回 Unicode 文本的字符数量。
            // 参数：文本:wideString；返回：int；可见性：default
            文本_取长度("演示参数1")
            // 命令ID：文本_寻找
            // [2] 文本_寻找(文本, 目标)
            // 功能：返回目标文本首次出现的从 0 开始索引，未找到返回 -1。
            // 参数：文本:wideString，目标:wideString；返回：int；可见性：default
            文本_寻找("演示参数1", "演示参数2")
            // 命令ID：文本_是否包含
            // [3] 文本_是否包含(文本, 目标)
            // 功能：判断文本是否包含目标内容。
            // 参数：文本:wideString，目标:wideString；返回：bool；可见性：default
            文本_是否包含("演示参数1", "演示参数2")
            // 命令ID：文本_开头为
            // [4] 文本_开头为(文本, 前缀)
            // 功能：判断文本是否以指定前缀开头。
            // 参数：文本:wideString，前缀:wideString；返回：bool；可见性：default
            文本_开头为("演示参数1", "演示参数2")
            // 命令ID：文本_结尾为
            // [5] 文本_结尾为(文本, 后缀)
            // 功能：判断文本是否以指定后缀结尾。
            // 参数：文本:wideString，后缀:wideString；返回：bool；可见性：default
            文本_结尾为("演示参数1", "演示参数2")
            // 命令ID：文本_取中间
            // [6] 文本_取中间(文本, 起始位置, 长度)
            // 功能：按从 0 开始的索引截取文本，超出范围时安全截断。
            // 参数：文本:wideString，起始位置:int，长度:int；返回：wideString；可见性：default
            文本_取中间("演示参数1", 1, 1)
            // 命令ID：文本_替换
            // [7] 文本_替换(文本, 查找内容, 替换内容)
            // 功能：替换文本中的全部匹配内容。
            // 参数：文本:wideString，查找内容:wideString，替换内容:wideString；返回：wideString；可见性：default
            文本_替换("演示参数1", "演示参数2", "演示参数3")
            // 命令ID：文本_删首尾空白
            // [8] 文本_删首尾空白(文本)
            // 功能：删除文本首尾的 Unicode 空白字符。
            // 参数：文本:wideString；返回：wideString；可见性：default
            文本_删首尾空白("演示参数1")
            // 命令ID：文本_转大写
            // [9] 文本_转大写(文本)
            // 功能：把文本转换为大写。
            // 参数：文本:wideString；返回：wideString；可见性：default
            文本_转大写("演示参数1")
            // 命令ID：文本_转小写
            // [10] 文本_转小写(文本)
            // 功能：把文本转换为小写。
            // 参数：文本:wideString；返回：wideString；可见性：default
            文本_转小写("演示参数1")
            // 命令ID：文本_分割
            // [11] 文本_分割(文本, 分隔符, 结果数组, 忽略末尾空段)
            // 功能：把文本按分隔符拆分写入文本数组，返回分段数量；分隔符为空时整段作为一条返回。文本以分隔符结尾时默认会多出一段空文本（"a|b|" 得 3 段），累积拼接场景请传 真 忽略它。
            // 参数：文本:wideString，分隔符:wideString，结果数组:array，忽略末尾空段:bool；返回：int；可见性：default
            文本_分割("演示参数1", "演示参数2", 演示结果数组, 真)
            // 命令ID：文本_倒找
            // [12] 文本_倒找(文本, 目标)
            // 功能：从末尾向开头查找目标文本首次出现的位置（从 0 起）；未找到返回 -1。
            // 参数：文本:wideString，目标:wideString；返回：int；可见性：default
            文本_倒找("演示参数1", "演示参数2")
            // 命令ID：文本_替换子文本
            // [13] 文本_替换子文本(文本, 查找内容, 替换内容, 起始位置, 次数)
            // 功能：从起始位置（从 0 起）开始替换查找内容；次数小于等于 0 表示全部替换；起始位置越界或查找内容为空时原样返回。
            // 参数：文本:wideString，查找内容:wideString，替换内容:wideString，起始位置:int，次数:int；返回：wideString；可见性：default
            文本_替换子文本("演示参数1", "演示参数2", "演示参数3", 1, 1)
            // 命令ID：文本_删全部空白
            // [14] 文本_删全部空白(文本)
            // 功能：删除文本中全部空白字符（含首尾与中间）。
            // 参数：文本:wideString；返回：wideString；可见性：default
            文本_删全部空白("演示参数1")
            // 命令ID：文本_到全角
            // [15] 文本_到全角(文本)
            // 功能：把半角空格与 ASCII 可见字符转换为对应全角字符。
            // 参数：文本:wideString；返回：wideString；可见性：default
            文本_到全角("演示参数1")
            // 命令ID：文本_到半角
            // [16] 文本_到半角(文本)
            // 功能：把全角空格与全角 ASCII 字符转换为对应半角字符。
            // 参数：文本:wideString；返回：wideString；可见性：default
            文本_到半角("演示参数1")
        如果结束
        调试输出("已查看 命令 1–16：文本_取长度 至 文本_到半角；勾选允许实际执行后会使用演示参数调用。")
    结束

    事件 _运行第02组_被单击()
        控件_设置文本(演示状态, "命令 17–31：文本_重复 至 文本_倒序；源码内含完整签名、参数、返回值与调用。")
        局部 长整数型 演示结果数组[]
        如果 (控件_取勾选(允许实际执行))
            // 命令ID：文本_重复
            // [17] 文本_重复(文本, 次数)
            // 功能：把文本重复拼接指定次数；次数小于等于 0 或总长超过 16777216 字符时返回空文本。
            // 参数：文本:wideString，次数:int；返回：wideString；可见性：default
            文本_重复("演示参数1", 1)
            // 命令ID：文本_插入
            // [18] 文本_插入(文本, 位置, 插入内容)
            // 功能：在指定位置（从 0 起）插入内容；位置为负或超过长度时原样返回。
            // 参数：文本:wideString，位置:int，插入内容:wideString；返回：wideString；可见性：default
            文本_插入("演示参数1", 1, "演示参数3")
            // 命令ID：文本_取左边
            // [19] 文本_取左边(文本, 长度)
            // 功能：取出文本左边指定数量的字符；长度小于等于 0 返回空文本，超过文本长度时取全部。
            // 参数：文本:wideString，长度:int；返回：wideString；可见性：default
            文本_取左边("演示参数1", 1)
            // 命令ID：文本_取右边
            // [20] 文本_取右边(文本, 长度)
            // 功能：取出文本右边指定数量的字符；长度小于等于 0 返回空文本，超过文本长度时取全部。
            // 参数：文本:wideString，长度:int；返回：wideString；可见性：default
            文本_取右边("演示参数1", 1)
            // 命令ID：文本_码点转字符
            // [21] 文本_码点转字符(码点)
            // 功能：返回 Unicode 码点对应的字符；超过 0xFFFF 的码点自动生成代理对。
            // 参数：码点:int；返回：wideString；可见性：default
            文本_码点转字符(1)
            // 命令ID：文本_取码点
            // [22] 文本_取码点(文本, 位置)
            // 功能：返回文本中指定位置（从 0 起）字符的 Unicode 码点；越界返回 0。
            // 参数：文本:wideString，位置:int；返回：int；可见性：default
            文本_取码点("演示参数1", 1)
            // 命令ID：文本_删首空白
            // [23] 文本_删首空白(文本)
            // 功能：删除文本首部的空白字符。
            // 参数：文本:wideString；返回：wideString；可见性：default
            文本_删首空白("演示参数1")
            // 命令ID：文本_删尾空白
            // [24] 文本_删尾空白(文本)
            // 功能：删除文本尾部的空白字符。
            // 参数：文本:wideString；返回：wideString；可见性：default
            文本_删尾空白("演示参数1")
            // 命令ID：文本_填充右边
            // [25] 文本_填充右边(文本, 目标显示宽度, 填充字符)
            // 功能：左对齐补齐：按显示宽度在右侧补到目标宽度，已够宽时原样返回且不截断，表格排版用它对齐每一列。
            // 参数：文本:wideString，目标显示宽度:int，填充字符:wideString；返回：wideString；可见性：default
            文本_填充右边("演示参数1", 1, "演示参数3")
            // 命令ID：文本_填充左边
            // [26] 文本_填充左边(文本, 目标显示宽度, 填充字符)
            // 功能：右对齐补齐：按显示宽度在左侧补到目标宽度（数字列常用），已够宽时原样返回且不截断。
            // 参数：文本:wideString，目标显示宽度:int，填充字符:wideString；返回：wideString；可见性：default
            文本_填充左边("演示参数1", 1, "演示参数3")
            // 命令ID：文本_居中
            // [27] 文本_居中(文本, 目标显示宽度, 填充字符)
            // 功能：居中补齐：按显示宽度在两侧补到目标宽度，左侧分到多余的半列（左侧宽度取剩余列数的一半向下取整），已够宽时原样返回。
            // 参数：文本:wideString，目标显示宽度:int，填充字符:wideString；返回：wideString；可见性：default
            文本_居中("演示参数1", 1, "演示参数3")
            // 命令ID：文本_取显示宽度
            // [28] 文本_取显示宽度(文本, 中日韩按 2 列)
            // 功能：返回文本在等宽字体下占用的显示列数（不是字符数）；制表符和换行等控制字符按 0 列计算。
            // 参数：文本:wideString，中日韩按 2 列:bool；返回：int；可见性：default
            文本_取显示宽度("演示参数1", 真)
            // 命令ID：文本_连接
            // [29] 文本_连接(文本数组, 分隔符, 起始下标, 数量)
            // 功能：用分隔符把数组区间内的成员依次连成一段文本（文本_分割 的反向操作），拼接 JSON/CSV 记录时不必再手写「首个元素不加逗号」的累加逻辑。
            // 参数：文本数组:array，分隔符:wideString，起始下标:int，数量:int；返回：wideString；可见性：default
            文本_连接(演示结果数组, "演示参数2", 1, 1)
            // 命令ID：文本_取数据地址
            // [30] 文本_取数据地址(文本)
            // 功能：返回文本变量宽字符缓冲区的内存地址（长整数型），用于直接递给 DLL 命令的 指针整数 形参（wchar_t* /指针宽度参数），配合项目 DLL 命令声明完成原生互操作。⚠️ 传变量时地址直达该变量的字符缓冲区；传拼接结果或字面量时地址只在当条语句内有效，一律不要保存后延迟使用。
            // 参数：文本:wideString；返回：longLong；可见性：default
            文本_取数据地址("演示参数1")
            // 命令ID：文本_倒序
            // [31] 文本_倒序(文本)
            // 功能：【Pro 专享】把文本按字符逆序排列后返回；Pro 会员可用。
            // 参数：文本:wideString；返回：wideString；可见性：default
            文本_倒序("演示参数1")
        如果结束
        调试输出("已查看 命令 17–31：文本_重复 至 文本_倒序；勾选允许实际执行后会使用演示参数调用。")
    结束

结束类
