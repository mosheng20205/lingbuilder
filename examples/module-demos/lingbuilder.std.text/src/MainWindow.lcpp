包 文本处理模块完整演示
使用 Win32窗口基础模块
使用 文本处理模块

// 本项目由模块清单自动生成；每条 binding 命令都在下方具有真实调用语句。
// 为避免误删文件、启动进程、访问网络或操作设备，必须先勾选“允许实际执行”才会进入命令调用区。
类 MainWindow : 公开 窗口
    事件 _MainWindow_创建完毕()
        控件_设置选择项("命令分组选项卡", 0)
        控件_设置文本("演示状态", "文本处理模块：10 条命令，默认处于安全预览模式。")
        调试输出("已加载模块演示：lingbuilder.std.text")
    结束

    事件 _运行第01组_被单击()
        控件_设置文本("演示状态", "命令 1–10：文本_取长度 至 文本_转小写；源码内含完整签名、参数、返回值与调用。")
        如果 (控件_取勾选("允许实际执行"))
            // 命令ID：文本_取长度
            // [1] 文本_取长度(文本)
            // 功能：返回 Unicode 文本的字符数量。
            // 参数：文本:wideString；返回：int；可见性：default
            文本_取长度("演示参数1")
            // 命令ID：文本_寻找
            // [2] 文本_寻找(文本, 目标)
            // 功能：返回目标文本首次出现的从 0 开始索引，未找到返回 -1。
            // 参数：文本:wideString，目标:wideString；返回：int；可见性：default
            文本_寻找("演示参数1", "演示参数2")
            // 命令ID：文本_是否包含
            // [3] 文本_是否包含(文本, 目标)
            // 功能：判断文本是否包含目标内容。
            // 参数：文本:wideString，目标:wideString；返回：bool；可见性：default
            文本_是否包含("演示参数1", "演示参数2")
            // 命令ID：文本_开头为
            // [4] 文本_开头为(文本, 前缀)
            // 功能：判断文本是否以指定前缀开头。
            // 参数：文本:wideString，前缀:wideString；返回：bool；可见性：default
            文本_开头为("演示参数1", "演示参数2")
            // 命令ID：文本_结尾为
            // [5] 文本_结尾为(文本, 后缀)
            // 功能：判断文本是否以指定后缀结尾。
            // 参数：文本:wideString，后缀:wideString；返回：bool；可见性：default
            文本_结尾为("演示参数1", "演示参数2")
            // 命令ID：文本_取中间
            // [6] 文本_取中间(文本, 起始位置, 长度)
            // 功能：按从 0 开始的索引截取文本，超出范围时安全截断。
            // 参数：文本:wideString，起始位置:int，长度:int；返回：wideString；可见性：default
            文本_取中间("演示参数1", 1, 1)
            // 命令ID：文本_替换
            // [7] 文本_替换(文本, 查找内容, 替换内容)
            // 功能：替换文本中的全部匹配内容。
            // 参数：文本:wideString，查找内容:wideString，替换内容:wideString；返回：wideString；可见性：default
            文本_替换("演示参数1", "演示参数2", "演示参数3")
            // 命令ID：文本_删首尾空白
            // [8] 文本_删首尾空白(文本)
            // 功能：删除文本首尾的 Unicode 空白字符。
            // 参数：文本:wideString；返回：wideString；可见性：default
            文本_删首尾空白("演示参数1")
            // 命令ID：文本_转大写
            // [9] 文本_转大写(文本)
            // 功能：把文本转换为大写。
            // 参数：文本:wideString；返回：wideString；可见性：default
            文本_转大写("演示参数1")
            // 命令ID：文本_转小写
            // [10] 文本_转小写(文本)
            // 功能：把文本转换为小写。
            // 参数：文本:wideString；返回：wideString；可见性：default
            文本_转小写("演示参数1")
        如果结束
        调试输出("已查看 命令 1–10：文本_取长度 至 文本_转小写；勾选允许实际执行后会使用演示参数调用。")
    结束

结束类
