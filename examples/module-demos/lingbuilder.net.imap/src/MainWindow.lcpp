包 IMAP邮件接收模块完整演示
使用 Win32窗口基础模块
使用 IMAP邮件接收模块

// 本项目由模块清单自动生成；每条 binding 命令都在下方具有真实调用语句。
// 为避免误删文件、启动进程、访问网络或操作设备，必须先勾选“允许实际执行”才会进入命令调用区。
类 MainWindow : 公开 窗口
    事件 _MainWindow_创建完毕()
        控件_设置选择项(命令分组选项卡, 0)
        控件_设置文本(演示状态, "IMAP邮件接收模块：15 条命令，默认处于安全预览模式。")
        调试输出("已加载模块演示：lingbuilder.net.imap")
    结束

    事件 _运行第01组_被单击()
        控件_设置文本(演示状态, "命令 1–15：IMAP_连接 至 IMAP_取错误；源码内含完整签名、参数、返回值与调用。")
        如果 (控件_取勾选(允许实际执行))
            // 命令ID：IMAP_连接
            // [1] IMAP_连接(服务器, 端口, 用户名, 密码, 是否SSL)
            // 功能：连接 IMAP 收信服务器并完成登录；失败返回假，用 IMAP_取错误 查看原因。
            // 参数：服务器:wideString，端口:int，用户名:wideString，密码:wideString，是否SSL:bool；返回：bool；可见性：default
            IMAP_连接("演示参数1", 1, "演示参数3", "演示参数4", 真)
            // 命令ID：IMAP_断开
            // [2] IMAP_断开()
            // 功能：断开与收信服务器的连接。
            // 参数：无；返回：void；可见性：default
            IMAP_断开()
            // 命令ID：IMAP_是否已连接
            // [3] IMAP_是否已连接()
            // 功能：判断当前是否已连接收信服务器。
            // 参数：无；返回：bool；可见性：default
            IMAP_是否已连接()
            // 命令ID：IMAP_选择文件夹
            // [4] IMAP_选择文件夹(文件夹名称)
            // 功能：打开指定邮件文件夹；之后的取件命令都作用于该文件夹。
            // 参数：文件夹名称:wideString；返回：bool；可见性：default
            IMAP_选择文件夹("module-demo-temp.txt")
            // 命令ID：IMAP_取邮件数量
            // [5] IMAP_取邮件数量()
            // 功能：返回当前文件夹中的邮件数量；未连接或未选择文件夹返回 -1。
            // 参数：无；返回：int；可见性：default
            IMAP_取邮件数量()
            // 命令ID：IMAP_接收邮件
            // [6] IMAP_接收邮件(序号)
            // 功能：取回指定邮件的完整内容并解析为当前邮件上下文，之后用 取主题/取发件人/取正文文本/附件族 命令读取。
            // 参数：序号:int；返回：bool；可见性：default
            IMAP_接收邮件(1)
            // 命令ID：IMAP_取主题
            // [7] IMAP_取主题()
            // 功能：返回已接收邮件的主题（自动解码编码字）。
            // 参数：无；返回：wideString；可见性：default
            IMAP_取主题()
            // 命令ID：IMAP_取发件人
            // [8] IMAP_取发件人()
            // 功能：返回已接收邮件的发件人。
            // 参数：无；返回：wideString；可见性：default
            IMAP_取发件人()
            // 命令ID：IMAP_取日期
            // [9] IMAP_取日期()
            // 功能：返回已接收邮件的日期头。
            // 参数：无；返回：wideString；可见性：default
            IMAP_取日期()
            // 命令ID：IMAP_取正文文本
            // [10] IMAP_取正文文本()
            // 功能：返回已接收邮件的纯文本正文。
            // 参数：无；返回：wideString；可见性：default
            IMAP_取正文文本()
            // 命令ID：IMAP_取网页正文
            // [11] IMAP_取网页正文()
            // 功能：返回已接收邮件的 HTML 正文。
            // 参数：无；返回：wideString；可见性：default
            IMAP_取网页正文()
            // 命令ID：IMAP_取附件个数
            // [12] IMAP_取附件个数()
            // 功能：返回已接收邮件的附件数量。
            // 参数：无；返回：int；可见性：default
            IMAP_取附件个数()
            // 命令ID：IMAP_取附件名称
            // [13] IMAP_取附件名称(附件序号)
            // 功能：返回指定附件的文件名。
            // 参数：附件序号:int；返回：wideString；可见性：default
            IMAP_取附件名称(1)
            // 命令ID：IMAP_保存附件
            // [14] IMAP_保存附件(附件序号, 保存路径)
            // 功能：把指定附件内容写入目标文件。
            // 参数：附件序号:int，保存路径:wideString；返回：bool；可见性：default
            IMAP_保存附件(1, "module-demo-temp.txt")
            // 命令ID：IMAP_取错误
            // [15] IMAP_取错误()
            // 功能：返回最近一次 IMAP 错误或服务端响应。
            // 参数：无；返回：wideString；可见性：default
            IMAP_取错误()
        如果结束
        调试输出("已查看 命令 1–15：IMAP_连接 至 IMAP_取错误；勾选允许实际执行后会使用演示参数调用。")
    结束

结束类
