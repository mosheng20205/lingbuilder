            // 命令ID：CDP_取拦截请求体
            // [59] CDP_取拦截请求体(拦截, 完成处理器)
            // 功能：读取被拦截请求的提交体文本；完成后用 CDP_取当前事件文本 读取结果。
            // 参数：拦截:CDP拦截，完成处理器:handler；返回：bool；可见性：default
            CDP_取拦截请求体(0, &模块演示回调)
            // 命令ID：CDP_拦截停止
            // [60] CDP_拦截停止(页面)
            // 功能：停止该页面的请求拦截并放行后续网络。
            // 参数：页面:CDP页面；返回：bool；可见性：default
            CDP_拦截停止(0)
            // 命令ID：CDP_绑定对话框事件
            // [61] CDP_绑定对话框事件(页面, 处理器)
            // 功能：订阅 alert/confirm/prompt/beforeunload 对话框；对话框打开时页面脚本阻塞，处理器内必须尽快 CDP_应答对话框，未绑定时运行时自动拒绝。
            // 参数：页面:CDP页面，处理器:handler；返回：bool；可见性：default
            CDP_绑定对话框事件(0, &模块演示回调)
            // 命令ID：CDP_应答对话框
            // [62] CDP_应答对话框(页面, 接受, 提示文本)
            // 功能：应答当前对话框：接受为真等于确认/确定，提示文本用于 prompt 应答输入。
            // 参数：页面:CDP页面，接受:bool，提示文本:wideString；返回：bool；可见性：default
            CDP_应答对话框(0, 真, "演示参数3")
            // 命令ID：CDP_设置下载目录
            // [63] CDP_设置下载目录(连接, 目录, 允许)
            // 功能：控制浏览器下载行为：允许为真时下载到指定目录（必须已存在），为假时拒绝全部下载。
            // 参数：连接:CDP连接，目录:wideString，允许:bool；返回：bool；可见性：default
            CDP_设置下载目录(0, ".", 真)
            // 命令ID：CDP_绑定下载事件
            // [64] CDP_绑定下载事件(连接, 处理器)
            // 功能：订阅下载事件：下载开始、下载进度、下载完成、下载取消；需先用 CDP_设置下载目录 允许下载。
            // 参数：连接:CDP连接，处理器:handler；返回：bool；可见性：default
            CDP_绑定下载事件(0, &模块演示回调)
            // 命令ID：CDP_设置元素文件
            // [65] CDP_设置元素文件(元素, 文件路径, 完成处理器)
            // 功能：为文件选择控件元素设置上传文件（DOM.setFileInputFiles）；文件必须真实存在。
            // 参数：元素:CDP元素，文件路径:wideString，完成处理器:handler；返回：bool；可见性：default
            CDP_设置元素文件(0, "module-demo-temp.txt", &模块演示回调)
            // 命令ID：CDP_等待加载
            // [66] CDP_等待加载(页面, 事件类型, 超时秒, 完成处理器)
            // 功能：等待页面生命周期事件：0=load、1=DOMContentLoaded、2=networkIdle（网络空闲）、3=networkAlmostIdle；到达后触发命令完成，超时触发命令失败。
            // 参数：页面:CDP页面，事件类型:int，超时秒:int，完成处理器:handler；返回：bool；可见性：default
            CDP_等待加载(0, 1, 1, &模块演示回调)
            // 命令ID：CDP_设置视口
            // [67] CDP_设置视口(页面, 宽度, 高度)
            // 功能：覆盖页面视口尺寸；用 CDP_重置仿真 恢复。
            // 参数：页面:CDP页面，宽度:int，高度:int；返回：bool；可见性：default
            CDP_设置视口(0, 1, 1)
            // 命令ID：CDP_设置UserAgent
            // [68] CDP_设置UserAgent(页面, UserAgent)
            // 功能：覆盖页面 User-Agent。
            // 参数：页面:CDP页面，UserAgent:wideString；返回：bool；可见性：default
            CDP_设置UserAgent(0, "演示参数2")
            // 命令ID：CDP_设置触摸
