包 用户注册表模块完整演示
使用 Win32窗口基础模块
使用 用户注册表模块

// 本项目由模块清单自动生成；每条 binding 命令都在下方具有真实调用语句。
// 为避免误删文件、启动进程、访问网络或操作设备，必须先勾选“允许实际执行”才会进入命令调用区。
类 MainWindow : 公开 窗口
    事件 _MainWindow_创建完毕()
        控件_设置选择项("命令分组选项卡", 0)
        控件_设置文本("演示状态", "用户注册表模块：6 条命令，默认处于安全预览模式。")
        调试输出("已加载模块演示：lingbuilder.config.registry")
    结束

    事件 _运行第01组_被单击()
        控件_设置文本("演示状态", "命令 1–6：注册表_读文本 至 注册表_值是否存在；源码内含完整签名、参数、返回值与调用。")
        如果 (控件_取勾选("允许实际执行"))
            // 命令ID：注册表_读文本
            // [1] 注册表_读文本(子键, 值名, 默认值)
            // 功能：读取当前用户注册表字符串值。
            // 参数：子键:wideString，值名:wideString，默认值:wideString；返回：wideString；可见性：default
            注册表_读文本("演示参数1", "演示参数2", "演示参数3")
            // 命令ID：注册表_读整数
            // [2] 注册表_读整数(子键, 值名, 默认值)
            // 功能：读取当前用户注册表 DWORD 值。
            // 参数：子键:wideString，值名:wideString，默认值:int；返回：int；可见性：default
            注册表_读整数("演示参数1", "演示参数2", 1)
            // 命令ID：注册表_写文本
            // [3] 注册表_写文本(子键, 值名, 值)
            // 功能：写入当前用户注册表字符串值。
            // 参数：子键:wideString，值名:wideString，值:wideString；返回：bool；可见性：default
            注册表_写文本("演示参数1", "演示参数2", "演示参数3")
            // 命令ID：注册表_写整数
            // [4] 注册表_写整数(子键, 值名, 值)
            // 功能：写入当前用户注册表 DWORD 值。
            // 参数：子键:wideString，值名:wideString，值:int；返回：bool；可见性：default
            注册表_写整数("演示参数1", "演示参数2", 1)
            // 命令ID：注册表_删除值
            // [5] 注册表_删除值(子键, 值名)
            // 功能：删除当前用户注册表值。
            // 参数：子键:wideString，值名:wideString；返回：bool；可见性：default
            注册表_删除值("演示参数1", "演示参数2")
            // 命令ID：注册表_值是否存在
            // [6] 注册表_值是否存在(子键, 值名)
            // 功能：判断当前用户注册表值是否存在。
            // 参数：子键:wideString，值名:wideString；返回：bool；可见性：default
            注册表_值是否存在("演示参数1", "演示参数2")
        如果结束
        调试输出("已查看 命令 1–6：注册表_读文本 至 注册表_值是否存在；勾选允许实际执行后会使用演示参数调用。")
    结束

结束类
