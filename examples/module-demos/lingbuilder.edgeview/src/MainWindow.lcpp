            // 命令ID：EdgeView_导航实例
            // [249] EdgeView_导航实例(实例编号, 地址)
            // 功能：让指定 EdgeView 实例导航。
            // 参数：实例编号:int，地址:wideString；返回：int；可见性：default
            EdgeView_导航实例(1, "https://example.com")
            // 命令ID：EdgeView_执行JS
            // [250] EdgeView_执行JS(脚本)
            // 功能：执行 JavaScript 并等待异步回调，返回 WebView2 的 JSON 编码结果；失败返回空文本。
            // 参数：脚本:wideString；返回：wideString；可见性：default
            EdgeView_执行JS("演示参数1")
            // 命令ID：EdgeView_执行JS实例
            // [251] EdgeView_执行JS实例(实例编号, 脚本)
            // 功能：在指定实例执行 JavaScript，并返回 WebView2 JSON 编码结果。
            // 参数：实例编号:int，脚本:wideString；返回：wideString；可见性：default
            EdgeView_执行JS实例(1, "演示参数2")
            // 命令ID：EdgeView_取最近事件
            // [252] EdgeView_取最近事件()
            // 功能：返回最近触发的 WebView2 中文事件名。
            // 参数：无；返回：wideString；可见性：default
            EdgeView_取最近事件()
            // 命令ID：EdgeView_取事件数据
            // [253] EdgeView_取事件数据()
            // 功能：返回最近事件携带的 UTF-16 JSON 对象文本。
            // 参数：无；返回：wideString；可见性：default
            EdgeView_取事件数据()
        如果结束
        调试输出("已查看 命令 231–253：EdgeView安全_清除证书错误决策异步 至 EdgeView_取事件数据；勾选允许实际执行后会使用演示参数调用。")
    结束

    事件 _运行第12组_被单击()
        控件_设置文本(演示状态, "命令 254–271：EdgeView_取最近事件实例 至 EdgeView_监听开发者工具事件控件；源码内含完整签名、参数、返回值与调用。")
        如果 (控件_取勾选(允许实际执行))
            // 命令ID：EdgeView_取最近事件实例
            // [254] EdgeView_取最近事件实例(实例编号)
            // 功能：返回指定浏览器实例最近事件名。
            // 参数：实例编号:int；返回：wideString；可见性：default
            EdgeView_取最近事件实例(1)
            // 命令ID：EdgeView_取事件数据实例
            // [255] EdgeView_取事件数据实例(实例编号)
            // 功能：返回指定浏览器实例最近事件携带的数据。
            // 参数：实例编号:int；返回：wideString；可见性：default
            EdgeView_取事件数据实例(1)
            // 命令ID：EdgeView_后退
            // [256] EdgeView_后退()
            // 功能：浏览器可以后退时返回上一页。
            // 参数：无；返回：int；可见性：default
            EdgeView_后退()
            // 命令ID：EdgeView_前进
            // [257] EdgeView_前进()
            // 功能：浏览器可以前进时进入下一页。
            // 参数：无；返回：int；可见性：default
            EdgeView_前进()
            // 命令ID：EdgeView_刷新
            // [258] EdgeView_刷新()
            // 功能：刷新当前网页。
            // 参数：无；返回：void；可见性：default
            EdgeView_刷新()
            // 命令ID：EdgeView_关闭
            // [259] EdgeView_关闭()
            // 功能：关闭浏览器控制器并释放 WebView2 资源。
            // 参数：无；返回：void；可见性：default
            EdgeView_关闭()
            // 命令ID：EdgeView_关闭实例
            // [260] EdgeView_关闭实例(实例编号)
            // 功能：关闭指定 EdgeView 实例并释放其承载窗口。
            // 参数：实例编号:int；返回：void；可见性：default
            EdgeView_关闭实例(1)
            // 命令ID：EdgeView_创建控件
            // [261] EdgeView_创建控件(控件名)
            // 功能：使用设计器属性重新创建指定 Edge 浏览器控件；空文本创建当前窗口全部 Edge 浏览器控件。
            // 参数：控件名:controlRef；返回：int；可见性：default
            EdgeView_创建控件(演示EdgeBrowser控件)
            // 命令ID：EdgeView_导航控件
            // [262] EdgeView_导航控件(控件名, 地址)
            // 功能：让指定设计器 Edge 浏览器控件导航到新地址。
            // 参数：控件名:controlRef，地址:wideString；返回：int；可见性：default
            EdgeView_导航控件(演示EdgeBrowser控件, "https://example.com")
            // 命令ID：EdgeView_执行JS控件
            // [263] EdgeView_执行JS控件(控件名, 脚本)
            // 功能：在指定设计器 Edge 浏览器控件中执行 JavaScript 并返回 JSON 编码结果。
            // 参数：控件名:controlRef，脚本:wideString；返回：wideString；可见性：default
            EdgeView_执行JS控件(演示EdgeBrowser控件, "演示参数2")
            // 命令ID：EdgeView_取最近事件控件
            // [264] EdgeView_取最近事件控件(控件名)
            // 功能：读取指定设计器 Edge 浏览器控件最近触发的事件名。
            // 参数：控件名:controlRef；返回：wideString；可见性：default
            EdgeView_取最近事件控件(演示EdgeBrowser控件)
            // 命令ID：EdgeView_取事件数据控件
            // [265] EdgeView_取事件数据控件(控件名)
            // 功能：读取指定设计器 Edge 浏览器控件最近事件的数据。
            // 参数：控件名:controlRef；返回：wideString；可见性：default
            EdgeView_取事件数据控件(演示EdgeBrowser控件)
            // 命令ID：EdgeView_后退控件
            // [266] EdgeView_后退控件(控件名)
            // 功能：让指定设计器 Edge 浏览器控件后退。
            // 参数：控件名:controlRef；返回：int；可见性：default
            EdgeView_后退控件(演示EdgeBrowser控件)
            // 命令ID：EdgeView_前进控件
            // [267] EdgeView_前进控件(控件名)
            // 功能：让指定设计器 Edge 浏览器控件前进。
            // 参数：控件名:controlRef；返回：int；可见性：default
            EdgeView_前进控件(演示EdgeBrowser控件)
            // 命令ID：EdgeView_刷新控件
            // [268] EdgeView_刷新控件(控件名)
            // 功能：刷新指定设计器 Edge 浏览器控件。
            // 参数：控件名:controlRef；返回：void；可见性：default
            EdgeView_刷新控件(演示EdgeBrowser控件)
            // 命令ID：EdgeView_关闭控件
            // [269] EdgeView_关闭控件(控件名)
            // 功能：关闭指定设计器 Edge 浏览器控件并保留设计器宿主占位。
            // 参数：控件名:controlRef；返回：void；可见性：default
            EdgeView_关闭控件(演示EdgeBrowser控件)
            // 命令ID：EdgeView_绑定控件事件
            // [270] EdgeView_绑定控件事件(控件名, 事件名, &处理器名)
            // 功能：按控件名绑定 WebView2 完整事件目录中的中文事件；当前目录共 71 项。旧字符串处理器仍兼容，但会产生迁移警告。
            // 参数：控件名:controlRef，事件名:wideString，处理器名:handler；返回：int；可见性：default
            EdgeView_绑定控件事件(演示EdgeBrowser控件, "演示事件", &模块演示回调)
            // 命令ID：EdgeView_监听开发者工具事件控件
            // [271] EdgeView_监听开发者工具事件控件(控件名, 协议事件名)
            // 功能：按设计器控件名监听 Chromium DevTools Protocol 事件。
            // 参数：控件名:controlRef，协议事件名:wideString；返回：int；可见性：default
            EdgeView_监听开发者工具事件控件(演示EdgeBrowser控件, "演示事件")
        如果结束
        调试输出("已查看 命令 254–271：EdgeView_取最近事件实例 至 EdgeView_监听开发者工具事件控件；勾选允许实际执行后会使用演示参数调用。")
    结束

    事件 模块演示回调()
        调试输出("模块演示回调已触发。")
    结束

结束类
