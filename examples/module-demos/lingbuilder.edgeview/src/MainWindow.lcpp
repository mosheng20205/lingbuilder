包 EdgeView浏览器模块完整演示
使用 Win32窗口基础模块
使用 EdgeView浏览器模块

// 本项目由模块清单自动生成；每条 binding 命令都在下方具有真实调用语句。
// 为避免误删文件、启动进程、访问网络或操作设备，必须先勾选“允许实际执行”才会进入命令调用区。
类 MainWindow : 公开 窗口
    事件 _MainWindow_创建完毕()
        控件_设置选择项(命令分组选项卡, 0)
        控件_设置文本(演示状态, "EdgeView 浏览器模块：271 条命令，默认处于安全预览模式。")
        调试输出("已加载模块演示：lingbuilder.edgeview")
        打开窗口("Edge 多控件安全示例", "居中")
    结束

    事件 _运行第01组_被单击()
        控件_设置文本(演示状态, "命令 1–23：EdgeView任务_取当前任务ID 至 EdgeView脚本_发送JSON消息；源码内含完整签名、参数、返回值与调用。")
        如果 (控件_取勾选(允许实际执行))
            // 命令ID：EdgeView任务_取当前任务ID
            // [1] EdgeView任务_取当前任务ID()
            // 功能：取得当前 EdgeView 完成处理器正在消费的任务 ID。
            // 参数：无；返回：longLong；可见性：advanced
            EdgeView任务_取当前任务ID()
            // 命令ID：EdgeView任务_取状态
            // [2] EdgeView任务_取状态(任务ID)
            // 功能：取得任务状态：0等待、1成功、2失败、3已取消、4已超时。
            // 参数：任务ID:longLong；返回：int；可见性：advanced
            EdgeView任务_取状态(1)
            // 命令ID：EdgeView任务_取结果
            // [3] EdgeView任务_取结果(任务ID)
            // 功能：取得任务 UTF-16 文本或 JSON 结果。
            // 参数：任务ID:longLong；返回：wideString；可见性：advanced
            EdgeView任务_取结果(1)
            // 命令ID：EdgeView任务_取错误
            // [4] EdgeView任务_取错误(任务ID)
            // 功能：取得任务的中文错误信息和 HRESULT。
            // 参数：任务ID:longLong；返回：wideString；可见性：advanced
            EdgeView任务_取错误(1)
            // 命令ID：EdgeView任务_取消
            // [5] EdgeView任务_取消(任务ID)
            // 功能：取消尚未完成的任务；迟到回调将被代际检查拒绝。
            // 参数：任务ID:longLong；返回：int；可见性：advanced
            EdgeView任务_取消(1)
            // 命令ID：EdgeView任务_释放
            // [6] EdgeView任务_释放(任务ID)
            // 功能：释放任务及结果；运行中的任务会先取消。
            // 参数：任务ID:longLong；返回：int；可见性：advanced
            EdgeView任务_释放(1)
            // 命令ID：EdgeView导航_HTML
            // [7] EdgeView导航_HTML(控件名, HTML)
            // 功能：让指定控件导航到内存 HTML。
            // 参数：控件名:controlRef，HTML:wideString；返回：int；可见性：default
            EdgeView导航_HTML(演示EdgeBrowser控件, "演示参数2")
            // 命令ID：EdgeView导航_请求
            // [8] EdgeView导航_请求(控件名, 地址, 方法, 请求头, 正文)
            // 功能：使用文本请求头和 UTF-8 正文导航，不暴露 IStream。
            // 参数：控件名:controlRef，地址:wideString，方法:wideString，请求头:wideString，正文:wideString；返回：int；可见性：advanced
            EdgeView导航_请求(演示EdgeBrowser控件, "https://example.com", "演示参数3", "演示参数4", "演示参数5")
            // 命令ID：EdgeView导航_停止
            // [9] EdgeView导航_停止(控件名)
            // 功能：停止指定控件当前导航。
            // 参数：控件名:controlRef；返回：int；可见性：default
            EdgeView导航_停止(演示EdgeBrowser控件)
            // 命令ID：EdgeView导航_取地址
            // [10] EdgeView导航_取地址(控件名)
            // 功能：取得当前页面地址。
            // 参数：控件名:controlRef；返回：wideString；可见性：default
            EdgeView导航_取地址(演示EdgeBrowser控件)
            // 命令ID：EdgeView导航_取标题
            // [11] EdgeView导航_取标题(控件名)
            // 功能：取得当前文档标题。
            // 参数：控件名:controlRef；返回：wideString；可见性：default
            EdgeView导航_取标题(演示EdgeBrowser控件)
            // 命令ID：EdgeView导航_取状态JSON
            // [12] EdgeView导航_取状态JSON(控件名)
            // 功能：取得后退、前进、挂起、主 Frame、进程、用户数据和故障报告目录状态 JSON。
            // 参数：控件名:controlRef；返回：wideString；可见性：default
            EdgeView导航_取状态JSON(演示EdgeBrowser控件)
            // 命令ID：EdgeView导航_取进程信息异步
            // [13] EdgeView导航_取进程信息异步(控件名, 完成处理器)
            // 功能：异步取得进程 ID、类型和关联 Frame 数量 JSON；旧 Runtime 使用基础进程集合。
            // 参数：控件名:controlRef，完成处理器:handler；返回：longLong；可见性：default
            EdgeView导航_取进程信息异步(演示EdgeBrowser控件, &模块演示回调)
            // 命令ID：EdgeView导航_挂起异步
            // [14] EdgeView导航_挂起异步(控件名, 完成处理器)
            // 功能：异步挂起 WebView，返回任务 ID。
            // 参数：控件名:controlRef，完成处理器:handler；返回：longLong；可见性：default
            EdgeView导航_挂起异步(演示EdgeBrowser控件, &模块演示回调)
            // 命令ID：EdgeView导航_恢复
            // [15] EdgeView导航_恢复(控件名)
            // 功能：恢复已挂起的 WebView。
            // 参数：控件名:controlRef；返回：int；可见性：default
            EdgeView导航_恢复(演示EdgeBrowser控件)
            // 命令ID：EdgeView导航_设置虚拟主机
            // [16] EdgeView导航_设置虚拟主机(控件名, 主机名, 目录, 访问模式)
            // 功能：把虚拟主机映射到明确目录。
            // 参数：控件名:controlRef，主机名:wideString，目录:wideString，访问模式:int；返回：int；可见性：advanced
            EdgeView导航_设置虚拟主机(演示EdgeBrowser控件, "演示参数2", ".", 1)
            // 命令ID：EdgeView导航_清除虚拟主机
            // [17] EdgeView导航_清除虚拟主机(控件名, 主机名)
            // 功能：清除指定虚拟主机映射。
            // 参数：控件名:controlRef，主机名:wideString；返回：int；可见性：advanced
            EdgeView导航_清除虚拟主机(演示EdgeBrowser控件, "演示参数2")
            // 命令ID：EdgeView脚本_文档预注入异步
            // [18] EdgeView脚本_文档预注入异步(控件名, 脚本, 完成处理器)
            // 功能：注册文档创建前执行脚本，任务结果为脚本 ID。
            // 参数：控件名:controlRef，脚本:wideString，完成处理器:handler；返回：longLong；可见性：default
            EdgeView脚本_文档预注入异步(演示EdgeBrowser控件, "演示参数2", &模块演示回调)
            // 命令ID：EdgeView脚本_移除文档预注入
            // [19] EdgeView脚本_移除文档预注入(控件名, 脚本ID)
            // 功能：移除文档预注入脚本。
            // 参数：控件名:controlRef，脚本ID:wideString；返回：int；可见性：default
            EdgeView脚本_移除文档预注入(演示EdgeBrowser控件, "演示参数2")
            // 命令ID：EdgeView脚本_执行异步
            // [20] EdgeView脚本_执行异步(控件名, 脚本, 完成处理器)
            // 功能：异步执行 JavaScript，任务结果为 JSON。
            // 参数：控件名:controlRef，脚本:wideString，完成处理器:handler；返回：longLong；可见性：default
            EdgeView脚本_执行异步(演示EdgeBrowser控件, "演示参数2", &模块演示回调)
            // 命令ID：EdgeView脚本_执行详情异步
            // [21] EdgeView脚本_执行详情异步(控件名, 脚本, 完成处理器)
            // 功能：异步执行 JavaScript，返回成功、JSON、字符串结果和异常详情。
            // 参数：控件名:controlRef，脚本:wideString，完成处理器:handler；返回：longLong；可见性：default
            EdgeView脚本_执行详情异步(演示EdgeBrowser控件, "演示参数2", &模块演示回调)
            // 命令ID：EdgeView脚本_发送字符串消息
            // [22] EdgeView脚本_发送字符串消息(控件名, 消息)
            // 功能：向网页发送字符串消息。
            // 参数：控件名:controlRef，消息:wideString；返回：int；可见性：default
            EdgeView脚本_发送字符串消息(演示EdgeBrowser控件, "演示参数2")
            // 命令ID：EdgeView脚本_发送JSON消息
            // [23] EdgeView脚本_发送JSON消息(控件名, JSON)
            // 功能：向网页发送 JSON 消息。
            // 参数：控件名:controlRef，JSON:wideString；返回：int；可见性：default
            EdgeView脚本_发送JSON消息(演示EdgeBrowser控件, "{}")
        如果结束
        调试输出("已查看 命令 1–23：EdgeView任务_取当前任务ID 至 EdgeView脚本_发送JSON消息；勾选允许实际执行后会使用演示参数调用。")
    结束

    事件 _运行第02组_被单击()
        控件_设置文本(演示状态, "命令 24–46：EdgeView设置_置脚本执行 至 EdgeView设置_置捏合缩放；源码内含完整签名、参数、返回值与调用。")
        如果 (控件_取勾选(允许实际执行))
