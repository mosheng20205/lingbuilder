            // 参数：实例编号:int；返回：void；可见性：default
            EdgeView_关闭实例(1)
            // 命令ID：EdgeView_创建控件
            // [291] EdgeView_创建控件(控件名)
            // 功能：使用设计器属性重新创建指定 Edge 浏览器控件；空文本创建当前窗口全部 Edge 浏览器控件。
            // 参数：控件名:controlRef；返回：int；可见性：default
            EdgeView_创建控件(演示EdgeBrowser控件)
            // 命令ID：EdgeView_导航控件
            // [292] EdgeView_导航控件(控件名, 地址)
            // 功能：让指定设计器 Edge 浏览器控件导航到新地址。
            // 参数：控件名:controlRef，地址:wideString；返回：int；可见性：default
            EdgeView_导航控件(演示EdgeBrowser控件, "https://example.com")
            // 命令ID：EdgeView_执行JS控件
            // [293] EdgeView_执行JS控件(控件名, 脚本)
            // 功能：在指定设计器 Edge 浏览器控件中执行 JavaScript 并返回 JSON 编码结果。
            // 参数：控件名:controlRef，脚本:wideString；返回：wideString；可见性：default
            EdgeView_执行JS控件(演示EdgeBrowser控件, "演示参数2")
            // 命令ID：EdgeView_取最近事件控件
            // [294] EdgeView_取最近事件控件(控件名)
            // 功能：读取指定设计器 Edge 浏览器控件最近触发的事件名。
            // 参数：控件名:controlRef；返回：wideString；可见性：default
            EdgeView_取最近事件控件(演示EdgeBrowser控件)
            // 命令ID：EdgeView_取事件数据控件
            // [295] EdgeView_取事件数据控件(控件名)
            // 功能：读取指定设计器 Edge 浏览器控件最近事件的数据。
            // 参数：控件名:controlRef；返回：wideString；可见性：default
            EdgeView_取事件数据控件(演示EdgeBrowser控件)
            // 命令ID：EdgeView_后退控件
            // [296] EdgeView_后退控件(控件名)
            // 功能：让指定设计器 Edge 浏览器控件后退。
            // 参数：控件名:controlRef；返回：int；可见性：default
            EdgeView_后退控件(演示EdgeBrowser控件)
            // 命令ID：EdgeView_前进控件
            // [297] EdgeView_前进控件(控件名)
            // 功能：让指定设计器 Edge 浏览器控件前进。
            // 参数：控件名:controlRef；返回：int；可见性：default
            EdgeView_前进控件(演示EdgeBrowser控件)
        如果结束
        调试输出("已查看 命令 271–297：EdgeView_清除全局代理 至 EdgeView_前进控件；勾选允许实际执行后会使用演示参数调用。")
