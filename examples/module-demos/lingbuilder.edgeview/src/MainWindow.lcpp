            // 命令ID：EdgeView_刷新
            // [288] EdgeView_刷新()
            // 功能：刷新当前网页。
            // 参数：无；返回：void；可见性：default
            EdgeView_刷新()
            // 命令ID：EdgeView_关闭
            // [289] EdgeView_关闭()
            // 功能：关闭浏览器控制器并释放 WebView2 资源。
            // 参数：无；返回：void；可见性：default
