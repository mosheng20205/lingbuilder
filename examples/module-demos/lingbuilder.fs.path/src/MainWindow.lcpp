包 路径处理模块完整演示
使用 Win32窗口基础模块
使用 路径处理模块

// 本项目由模块清单自动生成；每条 binding 命令都在下方具有真实调用语句。
// 为避免误删文件、启动进程、访问网络或操作设备，必须先勾选“允许实际执行”才会进入命令调用区。
类 MainWindow : 公开 窗口
    事件 _MainWindow_创建完毕()
        控件_设置选择项("命令分组选项卡", 0)
        控件_设置文本("演示状态", "路径处理模块：7 条命令，默认处于安全预览模式。")
        调试输出("已加载模块演示：lingbuilder.fs.path")
    结束

    事件 _运行第01组_被单击()
        控件_设置文本("演示状态", "命令 1–7：路径_合并 至 路径_规范化；源码内含完整签名、参数、返回值与调用。")
        如果 (控件_取勾选("允许实际执行"))
            // 命令ID：路径_合并
            // [1] 路径_合并(基础路径, 子路径)
            // 功能：组合两个路径并进行词法规范化。
            // 参数：基础路径:wideString，子路径:wideString；返回：wideString；可见性：default
            路径_合并("module-demo-temp.txt", "module-demo-temp.txt")
            // 命令ID：路径_取文件名
            // [2] 路径_取文件名(路径)
            // 功能：返回路径中的文件名。
            // 参数：路径:wideString；返回：wideString；可见性：default
            路径_取文件名("module-demo-temp.txt")
            // 命令ID：路径_取目录
            // [3] 路径_取目录(路径)
            // 功能：返回路径中的父目录。
            // 参数：路径:wideString；返回：wideString；可见性：default
            路径_取目录("module-demo-temp.txt")
            // 命令ID：路径_取扩展名
            // [4] 路径_取扩展名(路径)
            // 功能：返回包含点号的文件扩展名。
            // 参数：路径:wideString；返回：wideString；可见性：default
            路径_取扩展名("module-demo-temp.txt")
            // 命令ID：路径_改扩展名
            // [5] 路径_改扩展名(路径, 新扩展名)
            // 功能：替换文件扩展名。
            // 参数：路径:wideString，新扩展名:wideString；返回：wideString；可见性：default
            路径_改扩展名("module-demo-temp.txt", "演示参数2")
            // 命令ID：路径_转绝对路径
            // [6] 路径_转绝对路径(路径)
            // 功能：以当前工作目录为基准生成绝对路径。
            // 参数：路径:wideString；返回：wideString；可见性：default
            路径_转绝对路径("module-demo-temp.txt")
            // 命令ID：路径_规范化
            // [7] 路径_规范化(路径)
            // 功能：移除路径中的点段并规范分隔结构。
            // 参数：路径:wideString；返回：wideString；可见性：default
            路径_规范化("module-demo-temp.txt")
        如果结束
        调试输出("已查看 命令 1–7：路径_合并 至 路径_规范化；勾选允许实际执行后会使用演示参数调用。")
    结束

结束类
