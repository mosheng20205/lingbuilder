包 FBro受管对象模块完整演示
使用 Win32窗口基础模块
使用 FBro受管对象模块

// 本项目由模块清单自动生成；每条 binding 命令都在下方具有真实调用语句。
// 为避免误删文件、启动进程、访问网络或操作设备，必须先勾选“允许实际执行”才会进入命令调用区。
类 MainWindow : 公开 窗口
    事件 _MainWindow_创建完毕()
        控件_设置选择项(命令分组选项卡, 0)
        控件_设置文本(演示状态, "FBro受管对象模块：227 条命令，默认处于安全预览模式。")
        调试输出("已加载模块演示：lingbuilder.fbro.objects")
    结束

    事件 _运行第01组_被单击()
        控件_设置文本(演示状态, "命令 1–19：FBro任务_取状态 至 FBro请求_取方法；源码内含完整签名、参数、返回值与调用。")
        如果 (控件_取勾选(允许实际执行))
            // 命令ID：FBro任务_取状态
            // [1] FBro任务_取状态(任务ID)
            // 功能：查询异步任务状态。
            // 参数：任务ID:longLong；返回：int；可见性：advanced
            FBro任务_取状态(1)
            // 命令ID：FBro任务_取结果
            // [2] FBro任务_取结果(任务ID)
            // 功能：取得异步任务 UTF-16 结果。
            // 参数：任务ID:longLong；返回：wideString；可见性：advanced
            FBro任务_取结果(1)
            // 命令ID：FBro任务_取错误
            // [3] FBro任务_取错误(任务ID)
            // 功能：取得异步任务中文错误。
            // 参数：任务ID:longLong；返回：wideString；可见性：advanced
            FBro任务_取错误(1)
            // 命令ID：FBro任务_等待
            // [4] FBro任务_等待(任务ID, 超时毫秒)
            // 功能：等待任务进入完成、失败或取消状态，最长十分钟。
            // 参数：任务ID:longLong，超时毫秒:int；返回：int；可见性：advanced
            FBro任务_等待(1, 1)
            // 命令ID：FBro任务_取对象
            // [5] FBro任务_取对象(任务ID)
            // 功能：取得已完成任务返回的受管对象句柄。
            // 参数：任务ID:longLong；返回：longLong；可见性：advanced
            FBro任务_取对象(1)
            // 命令ID：FBro任务_取缓冲
            // [6] FBro任务_取缓冲(任务ID)
            // 功能：取得已完成任务返回的受管二进制缓冲句柄。
            // 参数：任务ID:longLong；返回：longLong；可见性：advanced
            FBro任务_取缓冲(1)
            // 命令ID：FBro任务_取消
            // [7] FBro任务_取消(任务ID)
            // 功能：取消尚未完成的任务。
            // 参数：任务ID:longLong；返回：int；可见性：advanced
            FBro任务_取消(1)
            // 命令ID：FBro任务_释放
            // [8] FBro任务_释放(任务ID)
            // 功能：释放任务句柄。
            // 参数：任务ID:longLong；返回：int；可见性：advanced
            FBro任务_释放(1)
            // 命令ID：FBro缓冲_从文本
            // [9] FBro缓冲_从文本(文本)
            // 功能：把 UTF-16 文本复制到受管二进制缓冲并返回句柄。
            // 参数：文本:wideString；返回：longLong；可见性：advanced
            FBro缓冲_从文本("演示参数1")
            // 命令ID：FBro缓冲_取大小
            // [10] FBro缓冲_取大小(缓冲句柄)
            // 功能：取得受管缓冲字节数。
            // 参数：缓冲句柄:longLong；返回：longLong；可见性：advanced
            FBro缓冲_取大小(1)
            // 命令ID：FBro缓冲_转十六进制
            // [11] FBro缓冲_转十六进制(缓冲句柄)
            // 功能：把受管缓冲转换为十六进制文本。
            // 参数：缓冲句柄:longLong；返回：wideString；可见性：advanced
            FBro缓冲_转十六进制(1)
            // 命令ID：FBro缓冲_保存文件
            // [12] FBro缓冲_保存文件(缓冲句柄, 路径)
            // 功能：保存受管缓冲到文件。
            // 参数：缓冲句柄:longLong，路径:wideString；返回：int；可见性：advanced
            FBro缓冲_保存文件(1, "module-demo-temp.txt")
            // 命令ID：FBro缓冲_释放
            // [13] FBro缓冲_释放(缓冲句柄)
            // 功能：释放受管缓冲句柄。
            // 参数：缓冲句柄:longLong；返回：int；可见性：advanced
            FBro缓冲_释放(1)
            // 命令ID：FBro缓冲_转文本
            // [14] FBro缓冲_转文本(缓冲句柄)
            // 功能：按 UTF-8 解码受管缓冲并返回文本（单次上限约 16K 字符；大内容请用 FBro缓冲_保存文件）。
            // 参数：缓冲句柄:longLong；返回：wideString；可见性：advanced
            FBro缓冲_转文本(1)
            // 命令ID：FBro缓冲_是否有效
            // [15] FBro缓冲_是否有效(缓冲句柄)
            // 功能：检查受管缓冲句柄是否仍然有效。
            // 参数：缓冲句柄:longLong；返回：int；可见性：advanced
            FBro缓冲_是否有效(1)
            // 命令ID：FBro工具_创建数据URI
            // [16] FBro工具_创建数据URI(MIME类型, 数据)
            // 功能：把文本数据编码为 data: URI；MIME 类型如 image/png、text/html。
            // 参数：MIME类型:wideString，数据:wideString；返回：wideString；可见性：advanced
            FBro工具_创建数据URI("演示参数1", "演示参数2")
            // 命令ID：FBro请求_创建
            // [17] FBro请求_创建()
            // 功能：创建受管 HTTP 请求对象并返回句柄；可用 FBro框架_载入请求 或 FBro异步请求_发起 使用。
            // 参数：无；返回：longLong；可见性：advanced
            FBro请求_创建()
            // 命令ID：FBro请求_取地址
            // [18] FBro请求_取地址(请求句柄)
            // 功能：读取请求对象当前地址。
            // 参数：请求句柄:longLong；返回：wideString；可见性：advanced
            FBro请求_取地址(1)
            // 命令ID：FBro请求_取方法
            // [19] FBro请求_取方法(请求句柄)
            // 功能：读取请求对象当前的 HTTP 方法（GET、POST 等）。
            // 参数：请求句柄:longLong；返回：wideString；可见性：advanced
            FBro请求_取方法(1)
        如果结束
        调试输出("已查看 命令 1–19：FBro任务_取状态 至 FBro请求_取方法；勾选允许实际执行后会使用演示参数调用。")
    结束

    事件 _运行第02组_被单击()
        控件_设置文本(演示状态, "命令 20–38：FBro请求_设置地址 至 FBro菜单_取颜色；源码内含完整签名、参数、返回值与调用。")
        如果 (控件_取勾选(允许实际执行))
            // 命令ID：FBro请求_设置地址
            // [20] FBro请求_设置地址(请求句柄, 地址)
            // 功能：设置请求对象地址。
            // 参数：请求句柄:longLong，地址:wideString；返回：int；可见性：advanced
            FBro请求_设置地址(1, "https://example.com")
            // 命令ID：FBro请求_设置方法
            // [21] FBro请求_设置方法(请求句柄, 方法)
            // 功能：设置请求方法，如 GET、POST。
            // 参数：请求句柄:longLong，方法:wideString；返回：int；可见性：advanced
            FBro请求_设置方法(1, "演示参数2")
            // 命令ID：FBro请求_设置引用页
            // [22] FBro请求_设置引用页(请求句柄, 引用页, 策略)
            // 功能：设置请求引用页与策略（0=清除 1=省略 2=降级 3=始终 4=源）。
            // 参数：请求句柄:longLong，引用页:wideString，策略:int；返回：int；可见性：advanced
            FBro请求_设置引用页(1, "演示参数2", 1)
            // 命令ID：FBro请求_设置头映射JSON
            // [23] FBro请求_设置头映射JSON(请求句柄, 头列表JSON)
            // 功能：按 [{"name":"...","value":"..."}] 数组设置请求头；不覆盖未列出的已有头。
            // 参数：请求句柄:longLong，头列表JSON:wideString；返回：int；可见性：advanced
            FBro请求_设置头映射JSON(1, "{}")
            // 命令ID：FBro请求_组合设置
            // [24] FBro请求_组合设置(请求句柄, 地址, 方法, 提交数据句柄, 头列表JSON)
            // 功能：一次性设置地址、方法、提交体与头；提交数据句柄传 0 跳过，头 JSON 传空跳过。
            // 参数：请求句柄:longLong，地址:wideString，方法:wideString，提交数据句柄:longLong，头列表JSON:wideString；返回：int；可见性：advanced
            FBro请求_组合设置(1, "https://example.com", "演示参数3", 1, "{}")
            // 命令ID：FBro提交数据_创建
            // [25] FBro提交数据_创建()
            // 功能：创建受管提交数据对象（POST 请求体）。
            // 参数：无；返回：longLong；可见性：advanced
            FBro提交数据_创建()
            // 命令ID：FBro提交数据_添加元素
            // [26] FBro提交数据_添加元素(提交数据句柄, 元素句柄)
            // 功能：向提交数据对象追加一个提交元素。
            // 参数：提交数据句柄:longLong，元素句柄:longLong；返回：int；可见性：advanced
            FBro提交数据_添加元素(1, 1)
            // 命令ID：FBro提交数据_取元素数量
            // [27] FBro提交数据_取元素数量(提交数据句柄)
            // 功能：取得提交数据对象中的元素数量。
            // 参数：提交数据句柄:longLong；返回：int；可见性：advanced
            FBro提交数据_取元素数量(1)
            // 命令ID：FBro提交数据_取元素句柄列表JSON
            // [28] FBro提交数据_取元素句柄列表JSON(提交数据句柄)
            // 功能：取得全部提交元素并注册为受管句柄，返回 JSON 数组。
            // 参数：提交数据句柄:longLong；返回：wideString；可见性：advanced
            FBro提交数据_取元素句柄列表JSON(1)
            // 命令ID：FBro提交数据_创建元素
            // [29] FBro提交数据_创建元素()
            // 功能：创建受管提交元素。
            // 参数：无；返回：longLong；可见性：advanced
            FBro提交数据_创建元素()
            // 命令ID：FBro提交数据_元素设字节
            // [30] FBro提交数据_元素设字节(元素句柄, 文本)
            // 功能：把元素内容设为 UTF-8 字节（按文本传入）。
            // 参数：元素句柄:longLong，文本:wideString；返回：int；可见性：advanced
            FBro提交数据_元素设字节(1, "演示参数2")
            // 命令ID：FBro提交数据_元素取字节大小
            // [31] FBro提交数据_元素取字节大小(元素句柄)
            // 功能：取得元素字节大小。
            // 参数：元素句柄:longLong；返回：int；可见性：advanced
            FBro提交数据_元素取字节大小(1)
            // 命令ID：FBro提交数据_元素取文本
            // [32] FBro提交数据_元素取文本(元素句柄)
            // 功能：按 UTF-8 读取元素字节并返回文本。
            // 参数：元素句柄:longLong；返回：wideString；可见性：advanced
            FBro提交数据_元素取文本(1)
            // 命令ID：FBro消息_创建
            // [33] FBro消息_创建(消息名)
            // 功能：创建受管进程消息对象。
            // 参数：消息名:wideString；返回：longLong；可见性：advanced
            FBro消息_创建("演示参数1")
            // 命令ID：FBro消息_取参数列表
            // [34] FBro消息_取参数列表(消息句柄)
            // 功能：取得消息参数列表的受管 List 句柄；可用 FBro列表_* 读写。
            // 参数：消息句柄:longLong；返回：longLong；可见性：advanced
            FBro消息_取参数列表(1)
            // 命令ID：FBro菜单_添加项
            // [35] FBro菜单_添加项(菜单句柄, 命令ID, 标题)
            // 功能：向右键菜单模型添加菜单项；仅可在“上下文菜单显示前”事件处理期内使用。
            // 参数：菜单句柄:longLong，命令ID:int，标题:wideString；返回：int；可见性：advanced
            FBro菜单_添加项(1, 1, "演示参数3")
            // 命令ID：FBro菜单_添加子菜单
            // [36] FBro菜单_添加子菜单(菜单句柄, 命令ID, 标题)
            // 功能：向右键菜单模型添加子菜单并返回其受管句柄；仅可在事件处理期内使用。
            // 参数：菜单句柄:longLong，命令ID:int，标题:wideString；返回：longLong；可见性：advanced
            FBro菜单_添加子菜单(1, 1, "演示参数3")
            // 命令ID：FBro菜单_设置加速键
            // [37] FBro菜单_设置加速键(菜单句柄, 命令ID, 键码, Shift, Ctrl, Alt)
            // 功能：为菜单项设置加速键组合。
            // 参数：菜单句柄:longLong，命令ID:int，键码:int，Shift:bool，Ctrl:bool，Alt:bool；返回：int；可见性：advanced
            FBro菜单_设置加速键(1, 1, 1, 真, 真, 真)
            // 命令ID：FBro菜单_取颜色
            // [38] FBro菜单_取颜色(菜单句柄, 命令ID, 颜色类型)
            // 功能：读取菜单项颜色，返回 red/green/blue/alpha JSON。
            // 参数：菜单句柄:longLong，命令ID:int，颜色类型:int；返回：wideString；可见性：advanced
            FBro菜单_取颜色(1, 1, 1)
        如果结束
        调试输出("已查看 命令 20–38：FBro请求_设置地址 至 FBro菜单_取颜色；勾选允许实际执行后会使用演示参数调用。")
    结束

    事件 _运行第03组_被单击()
        控件_设置文本(演示状态, "命令 39–57：FBro右键参数_取X 至 FBro菜单_置启用；源码内含完整签名、参数、返回值与调用。")
        如果 (控件_取勾选(允许实际执行))
            // 命令ID：FBro右键参数_取X
            // [39] FBro右键参数_取X(参数句柄)
            // 功能：读取右键菜单弹出坐标 X；仅可在事件处理期内使用。
            // 参数：参数句柄:longLong；返回：int；可见性：advanced
            FBro右键参数_取X(1)
            // 命令ID：FBro右键参数_取Y
            // [40] FBro右键参数_取Y(参数句柄)
            // 功能：读取右键菜单弹出坐标 Y；仅可在事件处理期内使用。
            // 参数：参数句柄:longLong；返回：int；可见性：advanced
            FBro右键参数_取Y(1)
            // 命令ID：FBro右键参数_取类型标志
            // [41] FBro右键参数_取类型标志(参数句柄)
            // 功能：读取右键菜单上下文类型标志位（TypeFlags 位掩码）；仅可在事件处理期内使用。
            // 参数：参数句柄:longLong；返回：int；可见性：advanced
            FBro右键参数_取类型标志(1)
            // 命令ID：FBro菜单_清空
            // [42] FBro菜单_清空(句柄)
            // 功能：清空菜单全部项。
            // 参数：句柄:longLong；返回：int；可见性：advanced
            FBro菜单_清空(1)
            // 命令ID：FBro菜单_取数量
            // [43] FBro菜单_取数量(句柄)
            // 功能：取菜单项数量。
            // 参数：句柄:longLong；返回：int；可见性：advanced
            FBro菜单_取数量(1)
            // 命令ID：FBro菜单_添加分隔栏
            // [44] FBro菜单_添加分隔栏(句柄)
            // 功能：在菜单末尾添加分隔栏。
            // 参数：句柄:longLong；返回：int；可见性：advanced
            FBro菜单_添加分隔栏(1)
            // 命令ID：FBro菜单_添加复选项
            // [45] FBro菜单_添加复选项(句柄, 命令ID, 标签)
            // 功能：添加带勾选状态的菜单项。
            // 参数：句柄:longLong，命令ID:int，标签:wideString；返回：int；可见性：advanced
            FBro菜单_添加复选项(1, 1, "演示参数3")
            // 命令ID：FBro菜单_添加单选项
            // [46] FBro菜单_添加单选项(句柄, 命令ID, 标签, 分组ID)
            // 功能：添加单选菜单项；同分组ID互斥。
            // 参数：句柄:longLong，命令ID:int，标签:wideString，分组ID:int；返回：int；可见性：advanced
            FBro菜单_添加单选项(1, 1, "演示参数3", 1)
            // 命令ID：FBro菜单_删除项
            // [47] FBro菜单_删除项(句柄, 命令ID)
            // 功能：按命令ID删除菜单项。
            // 参数：句柄:longLong，命令ID:int；返回：int；可见性：advanced
            FBro菜单_删除项(1, 1)
            // 命令ID：FBro菜单_取标签
            // [48] FBro菜单_取标签(句柄, 命令ID)
            // 功能：取菜单项标签文本。
            // 参数：句柄:longLong，命令ID:int；返回：wideString；可见性：advanced
            FBro菜单_取标签(1, 1)
            // 命令ID：FBro菜单_置标签
            // [49] FBro菜单_置标签(句柄, 命令ID, 标签)
            // 功能：设置菜单项标签文本。
            // 参数：句柄:longLong，命令ID:int，标签:wideString；返回：int；可见性：advanced
            FBro菜单_置标签(1, 1, "演示参数3")
            // 命令ID：FBro菜单_取类型
            // [50] FBro菜单_取类型(句柄, 命令ID)
            // 功能：取菜单项类型（命令/复选/单选/分隔栏/子菜单）。
            // 参数：句柄:longLong，命令ID:int；返回：int；可见性：advanced
            FBro菜单_取类型(1, 1)
            // 命令ID：FBro菜单_取分组
            // [51] FBro菜单_取分组(句柄, 命令ID)
            // 功能：取单选项分组ID。
            // 参数：句柄:longLong，命令ID:int；返回：int；可见性：advanced
            FBro菜单_取分组(1, 1)
            // 命令ID：FBro菜单_置分组
            // [52] FBro菜单_置分组(句柄, 命令ID, 分组ID)
            // 功能：设置单选项分组ID。
            // 参数：句柄:longLong，命令ID:int，分组ID:int；返回：int；可见性：advanced
            FBro菜单_置分组(1, 1, 1)
            // 命令ID：FBro菜单_取子菜单
            // [53] FBro菜单_取子菜单(句柄, 命令ID)
            // 功能：取命令ID对应的子菜单句柄，可继续用 FBro菜单_* 操作。
            // 参数：句柄:longLong，命令ID:int；返回：longLong；可见性：advanced
