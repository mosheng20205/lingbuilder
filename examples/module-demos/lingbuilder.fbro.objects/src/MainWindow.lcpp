包 FBro受管对象模块完整演示
使用 Win32窗口基础模块
使用 FBro受管对象模块

// 本项目由模块清单自动生成；每条 binding 命令都在下方具有真实调用语句。
// 为避免误删文件、启动进程、访问网络或操作设备，必须先勾选“允许实际执行”才会进入命令调用区。
类 MainWindow : 公开 窗口
    事件 _MainWindow_创建完毕()
        控件_设置选择项("命令分组选项卡", 0)
        控件_设置文本("演示状态", "FBro受管对象模块：132 条命令，默认处于安全预览模式。")
        调试输出("已加载模块演示：lingbuilder.fbro.objects")
    结束

    事件 _运行第01组_被单击()
        控件_设置文本("演示状态", "命令 1–19：FBro任务_取状态 至 FBro值_是否只读；源码内含完整签名、参数、返回值与调用。")
        如果 (控件_取勾选("允许实际执行"))
            // 命令ID：FBro任务_取状态
            // [1] FBro任务_取状态(任务ID)
            // 功能：查询异步任务状态。
            // 参数：任务ID:longLong；返回：int；可见性：advanced
            FBro任务_取状态(1)
            // 命令ID：FBro任务_取结果
            // [2] FBro任务_取结果(任务ID)
            // 功能：取得异步任务 UTF-16 结果。
            // 参数：任务ID:longLong；返回：wideString；可见性：advanced
            FBro任务_取结果(1)
            // 命令ID：FBro任务_取错误
            // [3] FBro任务_取错误(任务ID)
            // 功能：取得异步任务中文错误。
            // 参数：任务ID:longLong；返回：wideString；可见性：advanced
            FBro任务_取错误(1)
            // 命令ID：FBro任务_等待
            // [4] FBro任务_等待(任务ID, 超时毫秒)
            // 功能：等待任务进入完成、失败或取消状态，最长十分钟。
            // 参数：任务ID:longLong，超时毫秒:int；返回：int；可见性：advanced
            FBro任务_等待(1, 1)
            // 命令ID：FBro任务_取对象
            // [5] FBro任务_取对象(任务ID)
            // 功能：取得已完成任务返回的受管对象句柄。
            // 参数：任务ID:longLong；返回：longLong；可见性：advanced
            FBro任务_取对象(1)
            // 命令ID：FBro任务_取缓冲
            // [6] FBro任务_取缓冲(任务ID)
            // 功能：取得已完成任务返回的受管二进制缓冲句柄。
            // 参数：任务ID:longLong；返回：longLong；可见性：advanced
            FBro任务_取缓冲(1)
            // 命令ID：FBro任务_取消
            // [7] FBro任务_取消(任务ID)
            // 功能：取消尚未完成的任务。
            // 参数：任务ID:longLong；返回：int；可见性：advanced
            FBro任务_取消(1)
            // 命令ID：FBro任务_释放
            // [8] FBro任务_释放(任务ID)
            // 功能：释放任务句柄。
            // 参数：任务ID:longLong；返回：int；可见性：advanced
            FBro任务_释放(1)
            // 命令ID：FBro缓冲_从文本
            // [9] FBro缓冲_从文本(文本)
            // 功能：把 UTF-16 文本复制到受管二进制缓冲并返回句柄。
            // 参数：文本:wideString；返回：longLong；可见性：advanced
            FBro缓冲_从文本("演示参数1")
            // 命令ID：FBro缓冲_取大小
            // [10] FBro缓冲_取大小(缓冲句柄)
            // 功能：取得受管缓冲字节数。
            // 参数：缓冲句柄:longLong；返回：longLong；可见性：advanced
            FBro缓冲_取大小(1)
            // 命令ID：FBro缓冲_转十六进制
            // [11] FBro缓冲_转十六进制(缓冲句柄)
            // 功能：把受管缓冲转换为十六进制文本。
            // 参数：缓冲句柄:longLong；返回：wideString；可见性：advanced
            FBro缓冲_转十六进制(1)
            // 命令ID：FBro缓冲_保存文件
            // [12] FBro缓冲_保存文件(缓冲句柄, 路径)
            // 功能：保存受管缓冲到文件。
            // 参数：缓冲句柄:longLong，路径:wideString；返回：int；可见性：advanced
            FBro缓冲_保存文件(1, "module-demo-temp.txt")
            // 命令ID：FBro缓冲_释放
            // [13] FBro缓冲_释放(缓冲句柄)
            // 功能：释放受管缓冲句柄。
            // 参数：缓冲句柄:longLong；返回：int；可见性：advanced
            FBro缓冲_释放(1)
            // 命令ID：FBro对象_取类型
            // [14] FBro对象_取类型(对象句柄)
            // 功能：取得受管对象注册表类型。
            // 参数：对象句柄:longLong；返回：int；可见性：advanced
            FBro对象_取类型(1)
            // 命令ID：FBro对象_释放
            // [15] FBro对象_释放(对象句柄)
            // 功能：释放受管对象；重复释放返回稳定错误码。
            // 参数：对象句柄:longLong；返回：int；可见性：advanced
            FBro对象_释放(1)
            // 命令ID：FBro值_创建
            // [16] FBro值_创建()
            // 功能：创建受管 Value 对象并返回不透明句柄。
            // 参数：无；返回：longLong；可见性：advanced
            FBro值_创建()
            // 命令ID：FBro值_是否有效
            // [17] FBro值_是否有效(值句柄)
            // 功能：检查 Value 对象是否有效。
            // 参数：值句柄:longLong；返回：int；可见性：advanced
            FBro值_是否有效(1)
            // 命令ID：FBro值_是否被拥有
            // [18] FBro值_是否被拥有(值句柄)
            // 功能：检查 Value 对象是否已归属于其它容器。
            // 参数：值句柄:longLong；返回：int；可见性：advanced
            FBro值_是否被拥有(1)
            // 命令ID：FBro值_是否只读
            // [19] FBro值_是否只读(值句柄)
            // 功能：检查 Value 对象是否只读。
            // 参数：值句柄:longLong；返回：int；可见性：advanced
            FBro值_是否只读(1)
        如果结束
        调试输出("已查看 命令 1–19：FBro任务_取状态 至 FBro值_是否只读；勾选允许实际执行后会使用演示参数调用。")
    结束

    事件 _运行第02组_被单击()
        控件_设置文本("演示状态", "命令 20–38：FBro值_是否同一对象 至 FBro值_设置列表；源码内含完整签名、参数、返回值与调用。")
        如果 (控件_取勾选("允许实际执行"))
            // 命令ID：FBro值_是否同一对象
            // [20] FBro值_是否同一对象(值句柄, 另一值句柄)
            // 功能：检查两个 Value 句柄是否引用同一官方对象。
            // 参数：值句柄:longLong，另一值句柄:longLong；返回：int；可见性：advanced
            FBro值_是否同一对象(1, 1)
            // 命令ID：FBro值_是否相等
            // [21] FBro值_是否相等(值句柄, 另一值句柄)
            // 功能：比较两个 Value 的内容。
            // 参数：值句柄:longLong，另一值句柄:longLong；返回：int；可见性：advanced
            FBro值_是否相等(1, 1)
            // 命令ID：FBro值_复制
            // [22] FBro值_复制(值句柄)
            // 功能：复制 Value 并返回独立受管句柄。
            // 参数：值句柄:longLong；返回：longLong；可见性：advanced
            FBro值_复制(1)
            // 命令ID：FBro值_取类型
            // [23] FBro值_取类型(值句柄)
            // 功能：取得 Value 的官方值类型。
            // 参数：值句柄:longLong；返回：int；可见性：advanced
            FBro值_取类型(1)
            // 命令ID：FBro值_取逻辑
            // [24] FBro值_取逻辑(值句柄)
            // 功能：读取逻辑值。
            // 参数：值句柄:longLong；返回：int；可见性：advanced
            FBro值_取逻辑(1)
            // 命令ID：FBro值_取整数
            // [25] FBro值_取整数(值句柄)
            // 功能：读取整数值。
            // 参数：值句柄:longLong；返回：int；可见性：advanced
            FBro值_取整数(1)
            // 命令ID：FBro值_取小数
            // [26] FBro值_取小数(值句柄)
            // 功能：读取小数值。
            // 参数：值句柄:longLong；返回：double；可见性：advanced
            FBro值_取小数(1)
            // 命令ID：FBro值_取文本
            // [27] FBro值_取文本(值句柄)
            // 功能：读取 UTF-16 文本值。
            // 参数：值句柄:longLong；返回：wideString；可见性：advanced
            FBro值_取文本(1)
            // 命令ID：FBro值_设为空
            // [28] FBro值_设为空(值句柄)
            // 功能：把 Value 设置为空值。
            // 参数：值句柄:longLong；返回：int；可见性：advanced
            FBro值_设为空(1)
            // 命令ID：FBro值_设置逻辑
            // [29] FBro值_设置逻辑(值句柄, 值)
            // 功能：写入逻辑值。
            // 参数：值句柄:longLong，值:bool；返回：int；可见性：advanced
            FBro值_设置逻辑(1, 真)
            // 命令ID：FBro值_设置整数
            // [30] FBro值_设置整数(值句柄, 值)
            // 功能：写入整数值。
            // 参数：值句柄:longLong，值:int；返回：int；可见性：advanced
            FBro值_设置整数(1, 1)
            // 命令ID：FBro值_设置小数
            // [31] FBro值_设置小数(值句柄, 值)
            // 功能：写入小数值。
            // 参数：值句柄:longLong，值:double；返回：int；可见性：advanced
            FBro值_设置小数(1, 1.0)
            // 命令ID：FBro值_设置文本
            // [32] FBro值_设置文本(值句柄, 值)
            // 功能：写入 UTF-16 文本值。
            // 参数：值句柄:longLong，值:wideString；返回：int；可见性：advanced
            FBro值_设置文本(1, "演示参数2")
            // 命令ID：FBro值_取二进制
            // [33] FBro值_取二进制(值句柄)
            // 功能：复制二进制值到受管缓冲并返回句柄。
            // 参数：值句柄:longLong；返回：longLong；可见性：advanced
            FBro值_取二进制(1)
            // 命令ID：FBro值_设置二进制
            // [34] FBro值_设置二进制(值句柄, 缓冲句柄)
            // 功能：从受管缓冲写入二进制值。
            // 参数：值句柄:longLong，缓冲句柄:longLong；返回：int；可见性：advanced
            FBro值_设置二进制(1, 1)
            // 命令ID：FBro值_取字典
            // [35] FBro值_取字典(值句柄)
            // 功能：取得受父对象管理的 Dictionary 句柄。
            // 参数：值句柄:longLong；返回：longLong；可见性：advanced
            FBro值_取字典(1)
            // 命令ID：FBro值_取列表
            // [36] FBro值_取列表(值句柄)
            // 功能：取得受父对象管理的 List 句柄。
            // 参数：值句柄:longLong；返回：longLong；可见性：advanced
            FBro值_取列表(1)
            // 命令ID：FBro值_设置字典
            // [37] FBro值_设置字典(值句柄, 字典句柄)
            // 功能：把 Dictionary 交由 Value 管理。
            // 参数：值句柄:longLong，字典句柄:longLong；返回：int；可见性：advanced
            FBro值_设置字典(1, 1)
            // 命令ID：FBro值_设置列表
            // [38] FBro值_设置列表(值句柄, 列表句柄)
            // 功能：把 List 交由 Value 管理。
            // 参数：值句柄:longLong，列表句柄:longLong；返回：int；可见性：advanced
            FBro值_设置列表(1, 1)
        如果结束
        调试输出("已查看 命令 20–38：FBro值_是否同一对象 至 FBro值_设置列表；勾选允许实际执行后会使用演示参数调用。")
    结束

    事件 _运行第03组_被单击()
        控件_设置文本("演示状态", "命令 39–57：FBro字典_创建 至 FBro字典_取二进制；源码内含完整签名、参数、返回值与调用。")
        如果 (控件_取勾选("允许实际执行"))
            // 命令ID：FBro字典_创建
            // [39] FBro字典_创建()
            // 功能：创建受管 Dictionary 对象。
            // 参数：无；返回：longLong；可见性：advanced
            FBro字典_创建()
            // 命令ID：FBro字典_是否有效
            // [40] FBro字典_是否有效(字典句柄)
            // 功能：检查 Dictionary 是否有效。
            // 参数：字典句柄:longLong；返回：int；可见性：advanced
            FBro字典_是否有效(1)
            // 命令ID：FBro字典_是否被拥有
            // [41] FBro字典_是否被拥有(字典句柄)
            // 功能：检查 Dictionary 是否已被拥有。
            // 参数：字典句柄:longLong；返回：int；可见性：advanced
            FBro字典_是否被拥有(1)
            // 命令ID：FBro字典_是否只读
            // [42] FBro字典_是否只读(字典句柄)
            // 功能：检查 Dictionary 是否只读。
            // 参数：字典句柄:longLong；返回：int；可见性：advanced
            FBro字典_是否只读(1)
            // 命令ID：FBro字典_是否同一对象
            // [43] FBro字典_是否同一对象(字典句柄, 另一字典句柄)
            // 功能：检查两个 Dictionary 句柄是否引用同一官方对象。
            // 参数：字典句柄:longLong，另一字典句柄:longLong；返回：int；可见性：advanced
            FBro字典_是否同一对象(1, 1)
            // 命令ID：FBro字典_是否相等
            // [44] FBro字典_是否相等(字典句柄, 另一字典句柄)
            // 功能：比较两个 Dictionary 的内容。
            // 参数：字典句柄:longLong，另一字典句柄:longLong；返回：int；可见性：advanced
            FBro字典_是否相等(1, 1)
            // 命令ID：FBro字典_复制
            // [45] FBro字典_复制(字典句柄, 排除空子项)
            // 功能：复制 Dictionary 并返回独立受管句柄。
            // 参数：字典句柄:longLong，排除空子项:bool；返回：longLong；可见性：advanced
            FBro字典_复制(1, 真)
            // 命令ID：FBro字典_取数量
            // [46] FBro字典_取数量(字典句柄)
            // 功能：取得键数量。
            // 参数：字典句柄:longLong；返回：int；可见性：advanced
            FBro字典_取数量(1)
            // 命令ID：FBro字典_清空
            // [47] FBro字典_清空(字典句柄)
            // 功能：删除全部键。
            // 参数：字典句柄:longLong；返回：int；可见性：advanced
            FBro字典_清空(1)
            // 命令ID：FBro字典_是否存在键
            // [48] FBro字典_是否存在键(字典句柄, 键)
            // 功能：检查键是否存在。
            // 参数：字典句柄:longLong，键:wideString；返回：int；可见性：advanced
            FBro字典_是否存在键(1, "演示参数2")
            // 命令ID：FBro字典_删除
            // [49] FBro字典_删除(字典句柄, 键)
            // 功能：删除指定键。
            // 参数：字典句柄:longLong，键:wideString；返回：int；可见性：advanced
            FBro字典_删除(1, "演示参数2")
            // 命令ID：FBro字典_取类型
            // [50] FBro字典_取类型(字典句柄, 键)
            // 功能：取得指定键的官方值类型。
            // 参数：字典句柄:longLong，键:wideString；返回：int；可见性：advanced
            FBro字典_取类型(1, "演示参数2")
            // 命令ID：FBro字典_取逻辑
            // [51] FBro字典_取逻辑(字典句柄, 键)
            // 功能：读取逻辑值。
            // 参数：字典句柄:longLong，键:wideString；返回：int；可见性：advanced
            FBro字典_取逻辑(1, "演示参数2")
            // 命令ID：FBro字典_取整数
            // [52] FBro字典_取整数(字典句柄, 键)
            // 功能：读取整数值。
            // 参数：字典句柄:longLong，键:wideString；返回：int；可见性：advanced
            FBro字典_取整数(1, "演示参数2")
            // 命令ID：FBro字典_取小数
            // [53] FBro字典_取小数(字典句柄, 键)
            // 功能：读取小数值。
            // 参数：字典句柄:longLong，键:wideString；返回：double；可见性：advanced
            FBro字典_取小数(1, "演示参数2")
            // 命令ID：FBro字典_取文本
            // [54] FBro字典_取文本(字典句柄, 键)
            // 功能：读取 UTF-16 文本值。
            // 参数：字典句柄:longLong，键:wideString；返回：wideString；可见性：advanced
            FBro字典_取文本(1, "演示参数2")
            // 命令ID：FBro字典_取键列表JSON
            // [55] FBro字典_取键列表JSON(字典句柄)
            // 功能：取得 UTF-16 JSON 键数组，不向源码暴露 StringList 或 STL。
            // 参数：字典句柄:longLong；返回：wideString；可见性：advanced
            FBro字典_取键列表JSON(1)
            // 命令ID：FBro字典_取值对象
            // [56] FBro字典_取值对象(字典句柄, 键)
            // 功能：取得受字典管理的 Value 句柄。
            // 参数：字典句柄:longLong，键:wideString；返回：longLong；可见性：advanced
            FBro字典_取值对象(1, "演示参数2")
            // 命令ID：FBro字典_取二进制
            // [57] FBro字典_取二进制(字典句柄, 键)
            // 功能：复制指定键的二进制值到受管缓冲。
            // 参数：字典句柄:longLong，键:wideString；返回：longLong；可见性：advanced
            FBro字典_取二进制(1, "演示参数2")
        如果结束
        调试输出("已查看 命令 39–57：FBro字典_创建 至 FBro字典_取二进制；勾选允许实际执行后会使用演示参数调用。")
    结束

    事件 _运行第04组_被单击()
        控件_设置文本("演示状态", "命令 58–76：FBro字典_取字典 至 FBro列表_设置数量；源码内含完整签名、参数、返回值与调用。")
        如果 (控件_取勾选("允许实际执行"))
            // 命令ID：FBro字典_取字典
            // [58] FBro字典_取字典(字典句柄, 键)
            // 功能：取得受父字典管理的 Dictionary 句柄。
            // 参数：字典句柄:longLong，键:wideString；返回：longLong；可见性：advanced
            FBro字典_取字典(1, "演示参数2")
            // 命令ID：FBro字典_取列表
            // [59] FBro字典_取列表(字典句柄, 键)
            // 功能：取得受父字典管理的 List 句柄。
