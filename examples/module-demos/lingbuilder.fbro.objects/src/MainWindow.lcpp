        如果 (控件_取勾选("允许实际执行"))
            // 命令ID：FBro证书_取颁发者
            // [115] FBro证书_取颁发者(证书句柄)
            // 功能：取得受证书管理的颁发者 Principal 句柄。
            // 参数：证书句柄:longLong；返回：longLong；可见性：advanced
            FBro证书_取颁发者(1)
            // 命令ID：FBro证书_取序列号缓冲
            // [116] FBro证书_取序列号缓冲(证书句柄)
            // 功能：取得证书序列号受管缓冲。
            // 参数：证书句柄:longLong；返回：longLong；可见性：advanced
            FBro证书_取序列号缓冲(1)
            // 命令ID：FBro证书_取DER缓冲
            // [117] FBro证书_取DER缓冲(证书句柄)
            // 功能：取得 DER 编码证书受管缓冲。
            // 参数：证书句柄:longLong；返回：longLong；可见性：advanced
            FBro证书_取DER缓冲(1)
            // 命令ID：FBro证书_取PEM缓冲
            // [118] FBro证书_取PEM缓冲(证书句柄)
            // 功能：取得 PEM 编码证书受管缓冲。
            // 参数：证书句柄:longLong；返回：longLong；可见性：advanced
            FBro证书_取PEM缓冲(1)
            // 命令ID：FBro证书_取生效时间
            // [119] FBro证书_取生效时间(证书句柄)
            // 功能：取得证书生效 Unix 时间。
            // 参数：证书句柄:longLong；返回：longLong；可见性：advanced
            FBro证书_取生效时间(1)
            // 命令ID：FBro证书_取失效时间
            // [120] FBro证书_取失效时间(证书句柄)
            // 功能：取得证书失效 Unix 时间。
            // 参数：证书句柄:longLong；返回：longLong；可见性：advanced
            FBro证书_取失效时间(1)
            // 命令ID：FBro证书_取颁发链数量
            // [121] FBro证书_取颁发链数量(证书句柄)
            // 功能：取得颁发链数量。
            // 参数：证书句柄:longLong；返回：int；可见性：advanced
            FBro证书_取颁发链数量(1)
            // 命令ID：FBro证书_取DER颁发链项
            // [122] FBro证书_取DER颁发链项(证书句柄, 索引)
            // 功能：取得指定颁发链项的 DER 受管缓冲。
            // 参数：证书句柄:longLong，索引:int；返回：longLong；可见性：advanced
            FBro证书_取DER颁发链项(1, 1)
            // 命令ID：FBro证书_取PEM颁发链项
            // [123] FBro证书_取PEM颁发链项(证书句柄, 索引)
            // 功能：取得指定颁发链项的 PEM 受管缓冲。
            // 参数：证书句柄:longLong，索引:int；返回：longLong；可见性：advanced
            FBro证书_取PEM颁发链项(1, 1)
            // 命令ID：FBro证书主体_取显示名
            // [124] FBro证书主体_取显示名(主体句柄)
            // 功能：取得证书主体显示名。
            // 参数：主体句柄:longLong；返回：wideString；可见性：advanced
            FBro证书主体_取显示名(1)
            // 命令ID：FBro证书主体_取通用名
            // [125] FBro证书主体_取通用名(主体句柄)
            // 功能：取得证书主体通用名。
            // 参数：主体句柄:longLong；返回：wideString；可见性：advanced
            FBro证书主体_取通用名(1)
            // 命令ID：FBro证书主体_取地区名
            // [126] FBro证书主体_取地区名(主体句柄)
            // 功能：取得证书主体地区名。
            // 参数：主体句柄:longLong；返回：wideString；可见性：advanced
            FBro证书主体_取地区名(1)
            // 命令ID：FBro证书主体_取省州名
            // [127] FBro证书主体_取省州名(主体句柄)
            // 功能：取得证书主体省或州名。
            // 参数：主体句柄:longLong；返回：wideString；可见性：advanced
            FBro证书主体_取省州名(1)
            // 命令ID：FBro证书主体_取国家名
            // [128] FBro证书主体_取国家名(主体句柄)
            // 功能：取得证书主体国家名。
            // 参数：主体句柄:longLong；返回：wideString；可见性：advanced
            FBro证书主体_取国家名(1)
            // 命令ID：FBro证书主体_取组织JSON
            // [129] FBro证书主体_取组织JSON(主体句柄)
            // 功能：取得组织名 UTF-16 JSON 数组。
            // 参数：主体句柄:longLong；返回：wideString；可见性：advanced
            FBro证书主体_取组织JSON(1)
            // 命令ID：FBro证书主体_取组织单位JSON
            // [130] FBro证书主体_取组织单位JSON(主体句柄)
            // 功能：取得组织单位名 UTF-16 JSON 数组。
            // 参数：主体句柄:longLong；返回：wideString；可见性：advanced
            FBro证书主体_取组织单位JSON(1)
            // 命令ID：FBro拖放数据_是否有图像
            // [131] FBro拖放数据_是否有图像(拖放数据句柄)
            // 功能：检查 DragEnter 事件对象是否携带图像。
            // 参数：拖放数据句柄:longLong；返回：int；可见性：advanced
            FBro拖放数据_是否有图像(1)
            // 命令ID：FBro拖放数据_取图像
            // [132] FBro拖放数据_取图像(拖放数据句柄)
            // 功能：从 DragEnter 事件对象取得受管 Image 句柄。
            // 参数：拖放数据句柄:longLong；返回：longLong；可见性：advanced
            FBro拖放数据_取图像(1)
        如果结束
        调试输出("已查看 命令 115–132：FBro证书_取颁发者 至 FBro拖放数据_取图像；勾选允许实际执行后会使用演示参数调用。")
    结束

结束类
