包 邮件接收模块完整演示
使用 Win32窗口基础模块
使用 邮件接收模块

// 本项目由模块清单自动生成；每条 binding 命令都在下方具有真实调用语句。
// 为避免误删文件、启动进程、访问网络或操作设备，必须先勾选“允许实际执行”才会进入命令调用区。
类 MainWindow : 公开 窗口
    事件 _MainWindow_创建完毕()
        控件_设置选择项(命令分组选项卡, 0)
        控件_设置文本(演示状态, "邮件接收模块：18 条命令，默认处于安全预览模式。")
        调试输出("已加载模块演示：lingbuilder.net.pop3")
    结束

    事件 _运行第01组_被单击()
        控件_设置文本(演示状态, "命令 1–18：POP3_连接 至 POP3_取错误；源码内含完整签名、参数、返回值与调用。")
        如果 (控件_取勾选(允许实际执行))
            // 命令ID：POP3_连接
            // [1] POP3_连接(服务器, 端口, 用户名, 密码, 是否SSL)
            // 功能：连接 POP3 收信服务器并完成登录；失败返回假，用 POP3_取错误 查看原因。
            // 参数：服务器:wideString，端口:int，用户名:wideString，密码:wideString，是否SSL:bool；返回：bool；可见性：default
            POP3_连接("演示参数1", 1, "演示参数3", "演示参数4", 真)
            // 命令ID：POP3_断开
            // [2] POP3_断开()
            // 功能：断开与收信服务器的连接。
            // 参数：无；返回：void；可见性：default
            POP3_断开()
            // 命令ID：POP3_是否已连接
            // [3] POP3_是否已连接()
            // 功能：判断当前是否已连接收信服务器。
            // 参数：无；返回：bool；可见性：default
            POP3_是否已连接()
            // 命令ID：POP3_取邮件数量
            // [4] POP3_取邮件数量()
            // 功能：返回邮箱中的邮件数量；未连接返回 -1。
            // 参数：无；返回：int；可见性：default
            POP3_取邮件数量()
            // 命令ID：POP3_取邮箱总大小
            // [5] POP3_取邮箱总大小()
            // 功能：返回邮箱中全部邮件的总字节数；未连接返回 -1。
            // 参数：无；返回：int；可见性：default
            POP3_取邮箱总大小()
            // 命令ID：POP3_取邮件大小
            // [6] POP3_取邮件大小(序号)
            // 功能：返回指定邮件的字节数。
            // 参数：序号:int；返回：int；可见性：default
            POP3_取邮件大小(1)
            // 命令ID：POP3_接收邮件
            // [7] POP3_接收邮件(序号)
            // 功能：取回指定邮件的完整内容并解析为当前邮件上下文，之后用 取主题/取发件人/取正文文本/附件族 命令读取。
            // 参数：序号:int；返回：bool；可见性：default
            POP3_接收邮件(1)
            // 命令ID：POP3_删除邮件
            // [8] POP3_删除邮件(序号)
            // 功能：把指定邮件标记为删除；真正删除发生在 QUIT 时，可用 POP3_复位删除 撤销。
            // 参数：序号:int；返回：bool；可见性：default
            POP3_删除邮件(1)
            // 命令ID：POP3_复位删除
            // [9] POP3_复位删除()
            // 功能：撤销本次连接中所有删除标记。
            // 参数：无；返回：bool；可见性：default
            POP3_复位删除()
            // 命令ID：POP3_取主题
            // [10] POP3_取主题()
            // 功能：返回已接收邮件的主题（自动解码编码字）。
            // 参数：无；返回：wideString；可见性：default
            POP3_取主题()
            // 命令ID：POP3_取发件人
            // [11] POP3_取发件人()
            // 功能：返回已接收邮件的发件人。
            // 参数：无；返回：wideString；可见性：default
            POP3_取发件人()
            // 命令ID：POP3_取日期
            // [12] POP3_取日期()
            // 功能：返回已接收邮件的日期头。
            // 参数：无；返回：wideString；可见性：default
            POP3_取日期()
            // 命令ID：POP3_取正文文本
            // [13] POP3_取正文文本()
            // 功能：返回已接收邮件的纯文本正文。
            // 参数：无；返回：wideString；可见性：default
            POP3_取正文文本()
            // 命令ID：POP3_取网页正文
            // [14] POP3_取网页正文()
            // 功能：返回已接收邮件的 HTML 正文。
            // 参数：无；返回：wideString；可见性：default
            POP3_取网页正文()
            // 命令ID：POP3_取附件个数
            // [15] POP3_取附件个数()
            // 功能：返回已接收邮件的附件数量。
            // 参数：无；返回：int；可见性：default
            POP3_取附件个数()
            // 命令ID：POP3_取附件名称
            // [16] POP3_取附件名称(附件序号)
            // 功能：返回指定附件的文件名。
            // 参数：附件序号:int；返回：wideString；可见性：default
            POP3_取附件名称(1)
            // 命令ID：POP3_保存附件
            // [17] POP3_保存附件(附件序号, 保存路径)
            // 功能：把指定附件内容写入目标文件。
            // 参数：附件序号:int，保存路径:wideString；返回：bool；可见性：default
            POP3_保存附件(1, "module-demo-temp.txt")
            // 命令ID：POP3_取错误
            // [18] POP3_取错误()
            // 功能：返回最近一次 POP3 错误或服务端响应。
            // 参数：无；返回：wideString；可见性：default
            POP3_取错误()
        如果结束
        调试输出("已查看 命令 1–18：POP3_连接 至 POP3_取错误；勾选允许实际执行后会使用演示参数调用。")
    结束

结束类
