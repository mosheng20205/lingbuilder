包 微信OCR识别模块完整演示
使用 Win32窗口基础模块
使用 微信OCR识别模块

// 本项目由模块清单自动生成；每条 binding 命令都在下方具有真实调用语句。
// 为避免误删文件、启动进程、访问网络或操作设备，必须先勾选“允许实际执行”才会进入命令调用区。
类 MainWindow : 公开 窗口
    事件 _MainWindow_创建完毕()
        控件_设置选择项(命令分组选项卡, 0)
        控件_设置文本(演示状态, "微信OCR识别模块：19 条命令，默认处于安全预览模式。")
        调试输出("已加载模块演示：lingbuilder.ocr")
    结束

    事件 _运行第01组_被单击()
        控件_设置文本(演示状态, "命令 1–19：OCR_取版本 至 OCR结果_释放全部；源码内含完整签名、参数、返回值与调用。")
        如果 (控件_取勾选(允许实际执行))
            // 命令ID：OCR_取版本
            // [1] OCR_取版本()
            // 功能：返回模块版本与实现口径（借用本机微信 4.x OCR 组件，仅 64 位）。
            // 参数：无；返回：wideString；可见性：default
            OCR_取版本()
            // 命令ID：OCR_取微信状态
            // [2] OCR_取微信状态()
            // 功能：探测本机微信与 OCR 组件（不启动进程），返回 JSON：found、versionDir、pluginVersion、wxocrDll 或 error。微信未下载 OCR 组件时错误里带触发下载的操作指引。
            // 参数：无；返回：wideString；可见性：default
            OCR_取微信状态()
            // 命令ID：OCR_取错误
            // [3] OCR_取错误()
            // 功能：读取当前线程最近一次 OCR 操作的中文错误。
            // 参数：无；返回：wideString；可见性：default
            OCR_取错误()
            // 命令ID：OCR_停止
            // [4] OCR_停止()
            // 功能：停止 OCR 组件进程并复位会话；下次识别自动重新探测启动。组件长时间不用或识别失败后可用。
            // 参数：无；返回：bool；可见性：default
            OCR_停止()
            // 命令ID：OCR_识别
            // [5] OCR_识别(图片路径)
            // 功能：识别图片中的全部文字并返回受管结果句柄；首次调用自动探测微信并启动其 OCR 组件（握手 15 秒、单图识别 120 秒超时）。失败返回 0，原因读 OCR_取错误()。
            // 参数：图片路径:wideString；返回：OCR结果句柄；可见性：default
            OCR_识别("module-demo-temp.txt")
            // 命令ID：OCR_识别字节集
            // [6] OCR_识别字节集(图片数据)
            // 功能：识别字节集图片中的全部文字并返回受管结果句柄；前置与超时同 OCR_识别，结果读取/释放命令共用。失败返回 0，原因读 OCR_取错误()。
            // 参数：图片数据:bytes；返回：OCR结果句柄；可见性：default
            OCR_识别字节集({})
            // 命令ID：OCR结果_取行数
            // [7] OCR结果_取行数(结果)
            // 功能：返回识别行数；句柄无效返回 0。
            // 参数：结果:OCR结果句柄；返回：int；可见性：default
            OCR结果_取行数(0)
            // 命令ID：OCR结果_取文本
            // [8] OCR结果_取文本(结果, 索引)
            // 功能：返回指定行的识别文本；越界返回空文本。
            // 参数：结果:OCR结果句柄，索引:int；返回：wideString；可见性：default
            OCR结果_取文本(0, 1)
            // 命令ID：OCR结果_取全部文本
            // [9] OCR结果_取全部文本(结果, 换行分隔)
            // 功能：一次性取回全部识别文本；句柄无效返回空文本。
            // 参数：结果:OCR结果句柄，换行分隔:bool；返回：wideString；可见性：default
            OCR结果_取全部文本(0, 真)
            // 命令ID：OCR结果_取置信度
            // [10] OCR结果_取置信度(结果, 索引)
            // 功能：返回指定行识别置信度（0～1）；越界返回 0。
            // 参数：结果:OCR结果句柄，索引:int；返回：double；可见性：default
            OCR结果_取置信度(0, 1)
            // 命令ID：OCR结果_取左坐标
            // [11] OCR结果_取左坐标(结果, 索引)
            // 功能：返回指定行包围盒左边界横坐标（像素）；越界返回 -1。
            // 参数：结果:OCR结果句柄，索引:int；返回：int；可见性：default
            OCR结果_取左坐标(0, 1)
            // 命令ID：OCR结果_取上坐标
            // [12] OCR结果_取上坐标(结果, 索引)
            // 功能：返回指定行包围盒上边界纵坐标（像素）；越界返回 -1。
            // 参数：结果:OCR结果句柄，索引:int；返回：int；可见性：default
            OCR结果_取上坐标(0, 1)
            // 命令ID：OCR结果_取右坐标
            // [13] OCR结果_取右坐标(结果, 索引)
            // 功能：返回指定行包围盒右边界横坐标（像素）；越界返回 -1。
            // 参数：结果:OCR结果句柄，索引:int；返回：int；可见性：default
            OCR结果_取右坐标(0, 1)
            // 命令ID：OCR结果_取下坐标
            // [14] OCR结果_取下坐标(结果, 索引)
            // 功能：返回指定行包围盒下边界纵坐标（像素）；越界返回 -1。
            // 参数：结果:OCR结果句柄，索引:int；返回：int；可见性：default
            OCR结果_取下坐标(0, 1)
            // 命令ID：OCR结果_取宽度
            // [15] OCR结果_取宽度(结果)
            // 功能：返回原图宽度像素；句柄无效返回 0。
            // 参数：结果:OCR结果句柄；返回：int；可见性：default
            OCR结果_取宽度(0)
            // 命令ID：OCR结果_取高度
            // [16] OCR结果_取高度(结果)
            // 功能：返回原图高度像素；句柄无效返回 0。
            // 参数：结果:OCR结果句柄；返回：int；可见性：default
            OCR结果_取高度(0)
            // 命令ID：OCR结果_取JSON
            // [17] OCR结果_取JSON(结果)
            // 功能：返回完整识别结果 JSON：errcode、width、height、lines[]（text、rate、left/top/right/bottom、chars[] 字符级坐标）。
            // 参数：结果:OCR结果句柄；返回：wideString；可见性：default
            OCR结果_取JSON(0)
            // 命令ID：OCR结果_释放
            // [18] OCR结果_释放(结果)
            // 功能：释放一个识别结果句柄；句柄无效返回假。
            // 参数：结果:OCR结果句柄；返回：bool；可见性：default
            OCR结果_释放(0)
            // 命令ID：OCR结果_释放全部
            // [19] OCR结果_释放全部()
            // 功能：释放当前进程内全部识别结果句柄。
            // 参数：无；返回：void；可见性：default
            OCR结果_释放全部()
        如果结束
        调试输出("已查看 命令 1–19：OCR_取版本 至 OCR结果_释放全部；勾选允许实际执行后会使用演示参数调用。")
    结束

结束类
