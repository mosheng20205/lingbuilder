包 Word文档模块完整演示
使用 Win32窗口基础模块
使用 Word文档模块

// 本项目由模块清单自动生成；每条 binding 命令都在下方具有真实调用语句。
// 为避免误删文件、启动进程、访问网络或操作设备，必须先勾选“允许实际执行”才会进入命令调用区。
类 MainWindow : 公开 窗口
    事件 _MainWindow_创建完毕()
        控件_设置选择项(命令分组选项卡, 0)
        控件_设置文本(演示状态, "Word文档模块：27 条命令，默认处于安全预览模式。")
        调试输出("已加载模块演示：lingbuilder.data.word")
    结束

    事件 _运行第01组_被单击()
        控件_设置文本(演示状态, "命令 1–14：Word_创建文档 至 Word_添加标题；源码内含完整签名、参数、返回值与调用。")
        如果 (控件_取勾选(允许实际执行))
            // 命令ID：Word_创建文档
            // [1] Word_创建文档()
            // 功能：新建一个仅存在于内存的 .docx 文档；调用 Word_保存文档 才写出文件。
            // 参数：无；返回：Word文档；可见性：default
            Word_创建文档()
            // 命令ID：Word_打开文档
            // [2] Word_打开文档(文件路径)
            // 功能：打开既有 .docx 文档：可读段落表格、替换占位符、追加内容后另存。
            // 参数：文件路径:wideString；返回：Word文档；可见性：default
            Word_打开文档("module-demo-temp.txt")
            // 命令ID：Word_保存文档
            // [3] Word_保存文档(文档, 文件路径)
            // 功能：把文档写出到指定路径（创建与打开模式通用；打开模式会保留原文档其余部分原样改写）。
            // 参数：文档:Word文档，文件路径:wideString；返回：bool；可见性：default
            Word_保存文档(0, "module-demo-temp.txt")
            // 命令ID：Word_关闭文档
            // [4] Word_关闭文档(文档)
            // 功能：关闭并释放文档；未保存的修改会丢失。失效句柄返回假。
            // 参数：文档:Word文档；返回：bool；可见性：default
            Word_关闭文档(0)
            // 命令ID：Word_释放全部
            // [5] Word_释放全部()
            // 功能：释放当前进程内全部文档句柄。
            // 参数：无；返回：void；可见性：default
            Word_释放全部()
            // 命令ID：Word_取全文本
            // [6] Word_取全文本(文档)
            // 功能：返回全部段落与表格单元格文本：段落之间换行分隔，单元格之间制表符分隔。
            // 参数：文档:Word文档；返回：wideString；可见性：default
            Word_取全文本(0)
            // 命令ID：Word_取段落数
            // [7] Word_取段落数(文档)
            // 功能：返回文档段落数（表格内段落不计入）。
            // 参数：文档:Word文档；返回：int；可见性：default
            Word_取段落数(0)
            // 命令ID：Word_取段落文本
            // [8] Word_取段落文本(文档, 索引)
            // 功能：返回指定段落的文本；越界返回空文本并记录错误。
            // 参数：文档:Word文档，索引:int；返回：wideString；可见性：default
            Word_取段落文本(0, 1)
            // 命令ID：Word_取段落样式
            // [9] Word_取段落样式(文档, 索引)
            // 功能：返回段落样式：标题1～标题6 或 正文。
            // 参数：文档:Word文档，索引:int；返回：wideString；可见性：default
            Word_取段落样式(0, 1)
            // 命令ID：Word_取表格数
            // [10] Word_取表格数(文档)
            // 功能：返回文档表格数量（含未保存的新建表格）。
            // 参数：文档:Word文档；返回：int；可见性：default
            Word_取表格数(0)
            // 命令ID：Word_取表格行数
            // [11] Word_取表格行数(文档, 表格索引)
            // 功能：返回表格行数；越界返回 0 并记录错误。
            // 参数：文档:Word文档，表格索引:int；返回：int；可见性：default
            Word_取表格行数(0, 1)
            // 命令ID：Word_取表格列数
            // [12] Word_取表格列数(文档, 表格索引)
            // 功能：返回表格列数（按最大行宽计）。
            // 参数：文档:Word文档，表格索引:int；返回：int；可见性：default
            Word_取表格列数(0, 1)
            // 命令ID：Word_取单元格文本
            // [13] Word_取单元格文本(文档, 表格索引, 行, 列)
            // 功能：返回表格单元格文本；越界返回空文本并记录错误。
            // 参数：文档:Word文档，表格索引:int，行:int，列:int；返回：wideString；可见性：default
            Word_取单元格文本(0, 1, 1, 1)
            // 命令ID：Word_添加标题
            // [14] Word_添加标题(文档, 文本, 级别)
            // 功能：在文档末尾追加一个标题段落。
            // 参数：文档:Word文档，文本:wideString，级别:int；返回：bool；可见性：default
            Word_添加标题(0, "演示参数2", 1)
        如果结束
        调试输出("已查看 命令 1–14：Word_创建文档 至 Word_添加标题；勾选允许实际执行后会使用演示参数调用。")
    结束

    事件 _运行第02组_被单击()
        控件_设置文本(演示状态, "命令 15–27：Word_添加段落 至 Word_是否可用；源码内含完整签名、参数、返回值与调用。")
        如果 (控件_取勾选(允许实际执行))
            // 命令ID：Word_添加段落
            // [15] Word_添加段落(文档, 文本, 样式)
            // 功能：在文档末尾追加一个文本段落。
            // 参数：文档:Word文档，文本:wideString，样式:wideString；返回：bool；可见性：default
            Word_添加段落(0, "演示参数2", "演示参数3")
            // 命令ID：Word_添加表格
            // [16] Word_添加表格(文档, 行数, 列数)
            // 功能：在文档末尾追加一个带边框的空表格，之后用 Word_设置单元格文本 填内容。
            // 参数：文档:Word文档，行数:int，列数:int；返回：bool；可见性：default
            Word_添加表格(0, 1, 1)
            // 命令ID：Word_设置单元格文本
            // [17] Word_设置单元格文本(文档, 表格索引, 行, 列, 文本)
            // 功能：覆写表格单元格文本。
            // 参数：文档:Word文档，表格索引:int，行:int，列:int，文本:wideString；返回：bool；可见性：default
            Word_设置单元格文本(0, 1, 1, 1, "演示参数5")
            // 命令ID：Word_添加图片
            // [18] Word_添加图片(文档, 图片路径, 宽度, 高度)
            // 功能：在文档末尾插入一张内联图片。
            // 参数：文档:Word文档，图片路径:wideString，宽度:int，高度:int；返回：bool；可见性：default
            Word_添加图片(0, "module-demo-temp.txt", 1, 1)
            // 命令ID：Word_替换占位符
            // [19] Word_替换占位符(文档, 占位名, 替换值)
            // 功能：全文替换一处占位符，返回替换次数（0 表示模板中没有该占位符）。段落级合并 run 后替换，IME/拼写检查把 {{名称}} 拆进多个文本片段也能正确命中；表格单元格内同样生效。
            // 参数：文档:Word文档，占位名:wideString，替换值:wideString；返回：int；可见性：default
            Word_替换占位符(0, "演示参数2", "演示参数3")
            // 命令ID：Word_批量替换占位符
            // [20] Word_批量替换占位符(文档, 替换JSON)
            // 功能：按 JSON 对象批量替换全部占位符，返回总替换次数。
            // 参数：文档:Word文档，替换JSON:wideString；返回：int；可见性：default
            Word_批量替换占位符(0, "{}")
            // 命令ID：Word_从JSON生成报告
            // [21] Word_从JSON生成报告(模板路径, 数据JSON, 输出路径)
            // 功能：一步完成「打开模板 → 批量替换 → 保存输出」，批量报告生成的主入口。
            // 参数：模板路径:wideString，数据JSON:wideString，输出路径:wideString；返回：bool；可见性：default
            Word_从JSON生成报告("module-demo-temp.txt", "{}", "module-demo-temp.txt")
            // 命令ID：Word_导出PDF
            // [22] Word_导出PDF(文档, 输出路径)
            // 功能：把文档导出为 PDF：中文走 CID 字体方案（查看器字体替换，Chrome/Edge/WPS 可直接显示），表格自动分页并重复表头，图片按比例嵌入。仅支持本模块内容子集（段落/表格/图片）；文档含文本框、浮动图形等未支持元素时明确报错并指出元素类型，不会静默丢内容。
            // 参数：文档:Word文档，输出路径:wideString；返回：bool；可见性：default
            Word_导出PDF(0, "module-demo-temp.txt")
            // 命令ID：Word_表格另存Excel
            // [23] Word_表格另存Excel(文档, 表格索引, 输出路径)
            // 功能：把文档中的表格导出为 .xlsx 工作表（Excel/WPS 可直接打开）。
            // 参数：文档:Word文档，表格索引:int，输出路径:wideString；返回：bool；可见性：default
            Word_表格另存Excel(0, 1, "module-demo-temp.txt")
            // 命令ID：Word_从Excel填充表格
            // [24] Word_从Excel填充表格(文档, 表格索引, Excel路径)
            // 功能：把 Excel 第一个工作表的数据按单元格坐标覆写到文档表格：Excel 第 1 行第 1 列写入表格 (1,1)。要求表格行列不小于数据区域，超出会明确报错。批量报告「Excel 数据 → Word 模板表格」的主链路。
            // 参数：文档:Word文档，表格索引:int，Excel路径:wideString；返回：bool；可见性：default
            Word_从Excel填充表格(0, 1, "module-demo-temp.txt")
            // 命令ID：Word_取错误
            // [25] Word_取错误()
            // 功能：返回当前线程最近一次 Word 模块错误的中文说明。
            // 参数：无；返回：wideString；可见性：default
            Word_取错误()
            // 命令ID：Word_取版本
            // [26] Word_取版本()
            // 功能：返回随附运行桥版本与内置组件信息。
            // 参数：无；返回：wideString；可见性：default
            Word_取版本()
            // 命令ID：Word_是否可用
            // [27] Word_是否可用()
            // 功能：检查随附运行桥 LingBuilderWord.dll 是否可以加载且全部导出可用。
            // 参数：无；返回：bool；可见性：default
            Word_是否可用()
        如果结束
        调试输出("已查看 命令 15–27：Word_添加段落 至 Word_是否可用；勾选允许实际执行后会使用演示参数调用。")
    结束

结束类
