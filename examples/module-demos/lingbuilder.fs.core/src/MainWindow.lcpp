包 文件目录模块完整演示
使用 Win32窗口基础模块
使用 文件目录模块

// 本项目由模块清单自动生成；每条 binding 命令都在下方具有真实调用语句。
// 为避免误删文件、启动进程、访问网络或操作设备，必须先勾选“允许实际执行”才会进入命令调用区。
类 MainWindow : 公开 窗口
    事件 _MainWindow_创建完毕()
        控件_设置选择项(命令分组选项卡, 0)
        控件_设置文本(演示状态, "文件目录模块：42 条命令，默认处于安全预览模式。")
        调试输出("已加载模块演示：lingbuilder.fs.core")
    结束

    事件 _运行第01组_被单击()
        控件_设置文本(演示状态, "命令 1–14：文件_是否存在 至 文件_关闭；源码内含完整签名、参数、返回值与调用。")
        如果 (控件_取勾选(允许实际执行))
            // 命令ID：文件_是否存在
            // [1] 文件_是否存在(路径)
            // 功能：判断指定路径是否为普通文件。
            // 参数：路径:wideString；返回：bool；可见性：default
            文件_是否存在("module-demo-temp.txt")
            // 命令ID：目录_是否存在
            // [2] 目录_是否存在(路径)
            // 功能：判断指定路径是否为目录。
            // 参数：路径:wideString；返回：bool；可见性：default
            目录_是否存在("module-demo-temp.txt")
            // 命令ID：文件_读取文本
            // [3] 文件_读取文本(路径, 编码名称)
            // 功能：按指定编码读取完整文本，缺省 UTF-8；失败返回空文本。
            // 参数：路径:wideString，编码名称:wideString；返回：wideString；可见性：default
            文件_读取文本("module-demo-temp.txt", "演示参数2")
            // 命令ID：文件_写入文本
            // [4] 文件_写入文本(路径, 内容)
            // 功能：按 UTF-8 覆盖写入文本文件。
            // 参数：路径:wideString，内容:wideString；返回：bool；可见性：default
            文件_写入文本("module-demo-temp.txt", "演示参数2")
            // 命令ID：文件_追加文本
            // [5] 文件_追加文本(路径, 内容)
            // 功能：按 UTF-8 向文件末尾追加文本。
            // 参数：路径:wideString，内容:wideString；返回：bool；可见性：default
            文件_追加文本("module-demo-temp.txt", "演示参数2")
            // 命令ID：文件_复制
            // [6] 文件_复制(来源, 目标, 允许覆盖)
            // 功能：复制文件并可选择是否覆盖。
            // 参数：来源:wideString，目标:wideString，允许覆盖:bool；返回：bool；可见性：default
            文件_复制("演示参数1", "演示参数2", 真)
            // 命令ID：文件_移动
            // [7] 文件_移动(来源, 目标, 允许覆盖)
            // 功能：移动或重命名文件。
            // 参数：来源:wideString，目标:wideString，允许覆盖:bool；返回：bool；可见性：default
            文件_移动("演示参数1", "演示参数2", 真)
            // 命令ID：文件_删除
            // [8] 文件_删除(路径)
            // 功能：删除一个普通文件。
            // 参数：路径:wideString；返回：bool；可见性：default
            文件_删除("module-demo-temp.txt")
            // 命令ID：文件_取大小
            // [9] 文件_取大小(路径)
            // 功能：返回文件字节数，失败返回 -1。
            // 参数：路径:wideString；返回：longLong；可见性：default
            文件_取大小("module-demo-temp.txt")
            // 命令ID：目录_创建
            // [10] 目录_创建(路径)
            // 功能：递归创建目录；目录已经存在也返回真。
            // 参数：路径:wideString；返回：bool；可见性：default
            目录_创建("module-demo-temp.txt")
            // 命令ID：目录_删除空目录
            // [11] 目录_删除空目录(路径)
            // 功能：只删除空目录，不执行递归删除。
            // 参数：路径:wideString；返回：bool；可见性：default
            目录_删除空目录("module-demo-temp.txt")
            // 命令ID：目录_删除树
            // [12] 目录_删除树(路径)
            // 功能：递归删除整个目录树（目录自身及全部子目录和文件）；这是危险操作，调用前请确认路径。
            // 参数：路径:wideString；返回：bool；可见性：default
            目录_删除树("module-demo-temp.txt")
            // 命令ID：文件_打开
            // [13] 文件_打开(路径, 打开方式, 共享方式)
            // 功能：打开一个普通文件供句柄式读写，成功返回文件号，失败返回 0。
            // 参数：路径:wideString，打开方式:int，共享方式:int；返回：longLong；可见性：default
            文件_打开("module-demo-temp.txt", 1, 1)
            // 命令ID：文件_关闭
            // [14] 文件_关闭(文件号)
            // 功能：关闭被打开的文件并释放文件号；句柄无效时不产生任何效果。
            // 参数：文件号:longLong；返回：void；可见性：default
            文件_关闭(1)
        如果结束
        调试输出("已查看 命令 1–14：文件_是否存在 至 文件_关闭；勾选允许实际执行后会使用演示参数调用。")
    结束

    事件 _运行第02组_被单击()
        控件_设置文本(演示状态, "命令 15–28：文件_关闭全部 至 文件_取读写位置；源码内含完整签名、参数、返回值与调用。")
        如果 (控件_取勾选(允许实际执行))
            // 命令ID：文件_关闭全部
            // [15] 文件_关闭全部()
            // 功能：关闭当前进程内所有被打开的文件。程序退出前调用可以确保数据落盘。
            // 参数：无；返回：void；可见性：default
            文件_关闭全部()
            // 命令ID：文件_移动读写位置
            // [16] 文件_移动读写位置(文件号, 移动距离, 起始位置)
            // 功能：在打开的文件中设置下一次读写的位置；成功返回真，文件号无效或基准位置非法返回假。
            // 参数：文件号:longLong，移动距离:longLong，起始位置:int；返回：bool；可见性：default
            文件_移动读写位置(1, 1, 1)
            // 命令ID：文件_移到文件首
            // [17] 文件_移到文件首(文件号)
            // 功能：把读写位置移到文件首；成功返回真。
            // 参数：文件号:longLong；返回：bool；可见性：default
            文件_移到文件首(1)
            // 命令ID：文件_移到文件尾
            // [18] 文件_移到文件尾(文件号)
            // 功能：把读写位置移到文件尾；成功返回真。
            // 参数：文件号:longLong；返回：bool；可见性：default
            文件_移到文件尾(1)
            // 命令ID：文件_读入字节集
            // [19] 文件_读入字节集(文件号, 长度)
            // 功能：从文件当前读写位置读取字节集；失败或已到文件尾返回空字节集。
            // 参数：文件号:longLong，长度:int；返回：bytes；可见性：default
            文件_读入字节集(1, 1)
            // 命令ID：文件_写出字节集
            // [20] 文件_写出字节集(文件号, 数据)
            // 功能：把字节集写到文件当前读写位置；成功返回真，以只读方式打开的文件返回假。
            // 参数：文件号:longLong，数据:bytes；返回：bool；可见性：default
            文件_写出字节集(1, {})
            // 命令ID：文件_读入文本
            // [21] 文件_读入文本(文件号, 长度)
            // 功能：从文件当前读写位置读取文本（内容按 UTF-8 解码）；失败返回空文本。
            // 参数：文件号:longLong，长度:longLong；返回：wideString；可见性：default
            文件_读入文本(1, 1)
            // 命令ID：文件_写出文本
            // [22] 文件_写出文本(文件号, 文本)
            // 功能：把文本写到文件当前读写位置；成功返回真，以只读方式打开的文件返回假。
            // 参数：文件号:longLong，文本:wideString；返回：bool；可见性：default
            文件_写出文本(1, "演示参数2")
            // 命令ID：文件_读入一行
            // [23] 文件_读入一行(文件号)
            // 功能：从文件当前读写位置读取一行文本，行尾回车换行符被抛弃（按 UTF-8 解码）；已到文件尾返回空文本。
            // 参数：文件号:longLong；返回：wideString；可见性：default
            文件_读入一行(1)
            // 命令ID：文件_写文本行
            // [24] 文件_写文本行(文件号, 文本)
            // 功能：把一行文本写到文件当前读写位置并自动换行；成功返回真。
            // 参数：文件号:longLong，文本:wideString；返回：bool；可见性：default
            文件_写文本行(1, "演示参数2")
            // 命令ID：文件_读入数据
            // [25] 文件_读入数据(文件号, 变量)
            // 功能：从文件当前读写位置按 文件_写出数据 的格式依次读出多个值到变量；成功返回真，数据不足或类型不匹配返回假。
            // 参数：文件号:longLong，变量:lingValue；返回：bool；可见性：default
            文件_读入数据(1)
            // 命令ID：文件_写出数据
            // [26] 文件_写出数据(文件号, 数据)
            // 功能：把多个值按固定二进制格式写到文件当前读写位置，供 文件_读入数据 读回；成功返回真。
            // 参数：文件号:longLong，数据:lingValue；返回：bool；可见性：default
            文件_写出数据(1)
            // 命令ID：文件_是否在文件尾
            // [27] 文件_是否在文件尾(文件号)
            // 功能：判断文件当前读写位置是否已处于数据尾部；是返回真，无效文件号也返回真。
            // 参数：文件号:longLong；返回：bool；可见性：default
            文件_是否在文件尾(1)
            // 命令ID：文件_取读写位置
            // [28] 文件_取读写位置(文件号)
            // 功能：返回文件当前读写位置（从 0 起）；文件号无效返回 -1。
            // 参数：文件号:longLong；返回：longLong；可见性：default
            文件_取读写位置(1)
        如果结束
        调试输出("已查看 命令 15–28：文件_关闭全部 至 文件_取读写位置；勾选允许实际执行后会使用演示参数调用。")
    结束

    事件 _运行第03组_被单击()
        控件_设置文本(演示状态, "命令 29–42：文件_取长度 至 文件_取错误；源码内含完整签名、参数、返回值与调用。")
        局部 长整数型 演示结果数组[]
        如果 (控件_取勾选(允许实际执行))
            // 命令ID：文件_取长度
            // [29] 文件_取长度(文件号)
            // 功能：返回打开文件的字节长度；文件号无效返回 -1。与按路径取大小的 文件_取大小 不同，本命令作用于已打开的文件。
            // 参数：文件号:longLong；返回：longLong；可见性：default
            文件_取长度(1)
            // 命令ID：文件_插入字节集
            // [30] 文件_插入字节集(文件号, 数据)
            // 功能：在文件当前读写位置插入字节集（要求以可写方式打开）；插入后读写位置回到插入内容首部，成功返回真。
            // 参数：文件号:longLong，数据:bytes；返回：bool；可见性：default
            文件_插入字节集(1, {})
            // 命令ID：文件_插入文本
            // [31] 文件_插入文本(文件号, 文本)
            // 功能：在文件当前读写位置插入文本（要求以可写方式打开）；插入后读写位置回到插入内容首部，成功返回真。
            // 参数：文件号:longLong，文本:wideString；返回：bool；可见性：default
            文件_插入文本(1, "演示参数2")
            // 命令ID：文件_插入文本行
            // [32] 文件_插入文本行(文件号, 文本)
            // 功能：在文件当前读写位置插入一行文本（要求以可写方式打开）；插入后读写位置回到插入内容首部，成功返回真。
            // 参数：文件号:longLong，文本:wideString；返回：bool；可见性：default
            文件_插入文本行(1, "演示参数2")
            // 命令ID：文件_删除数据
            // [33] 文件_删除数据(文件号, 字节数)
            // 功能：在文件当前读写位置删除一段数据，后续内容顺序前移（要求以可写方式打开）；成功返回真。
            // 参数：文件号:longLong，字节数:longLong；返回：bool；可见性：default
            文件_删除数据(1, 1)
            // 命令ID：文件_锁定
            // [34] 文件_锁定(文件号, 位置, 长度, 重试毫秒)
            // 功能：拒绝其它进程读写文件指定区域，用于多进程共享文件；成功返回真。
            // 参数：文件号:longLong，位置:longLong，长度:longLong，重试毫秒:int；返回：bool；可见性：default
            文件_锁定(1, 1, 1, 1)
            // 命令ID：文件_解锁
            // [35] 文件_解锁(文件号, 位置, 长度)
            // 功能：解除 文件_锁定 加上的区域锁；参数必须与加锁时完全一致才会成功。
            // 参数：文件号:longLong，位置:longLong，长度:longLong；返回：bool；可见性：default
            文件_解锁(1, 1, 1)
            // 命令ID：文件_枚举
            // [36] 文件_枚举(目录, 通配符, 含子目录, 结果数组)
            // 功能：枚举目录下的文件（含隐藏、系统文件），返回命中数量。
            // 参数：目录:wideString，通配符:wideString，含子目录:bool，结果数组:array；返回：int；可见性：default
            文件_枚举(".", "演示参数2", 真, 演示结果数组)
            // 命令ID：目录_枚举
            // [37] 目录_枚举(目录, 含子目录, 结果数组)
            // 功能：枚举目录下的子目录，返回命中数量。
            // 参数：目录:wideString，含子目录:bool，结果数组:array；返回：int；可见性：default
            目录_枚举(".", 真, 演示结果数组)
            // 命令ID：文件_取修改时间
            // [38] 文件_取修改时间(路径)
            // 功能：返回文件最后修改时间（本地时区）；失败返回 0。
            // 参数：路径:wideString；返回：longLong；可见性：default
            文件_取修改时间("module-demo-temp.txt")
            // 命令ID：文件_取创建时间
            // [39] 文件_取创建时间(路径)
            // 功能：返回文件创建时间（本地时区）；失败返回 0。
            // 参数：路径:wideString；返回：longLong；可见性：default
            文件_取创建时间("module-demo-temp.txt")
            // 命令ID：文件_取访问时间
            // [40] 文件_取访问时间(路径)
            // 功能：返回文件最后访问时间（本地时区）；失败返回 0。
            // 参数：路径:wideString；返回：longLong；可见性：default
            文件_取访问时间("module-demo-temp.txt")
            // 命令ID：文件_取最新文件
            // [41] 文件_取最新文件(目录, 通配符, 结果数组)
            // 功能：枚举目录下匹配通配符的文件，挑出最后修改时间最新的一个写入结果数组，返回写入数量（1 成功、0 失败）。
            // 参数：目录:wideString，通配符:wideString，结果数组:array；返回：int；可见性：default
            文件_取最新文件(".", "演示参数2", 演示结果数组)
            // 命令ID：文件_取错误
            // [42] 文件_取错误()
            // 功能：返回最近一次文件时间命令（文件_取修改时间/创建时间/访问时间/最新文件）失败的中文原因；成功调用会清空它。
            // 参数：无；返回：wideString；可见性：default
            文件_取错误()
        如果结束
        调试输出("已查看 命令 29–42：文件_取长度 至 文件_取错误；勾选允许实际执行后会使用演示参数调用。")
    结束

结束类
