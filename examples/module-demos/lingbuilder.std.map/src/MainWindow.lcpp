包 哈希表与栈模块完整演示
使用 Win32窗口基础模块
使用 哈希表与栈模块

// 本项目由模块清单自动生成；每条 binding 命令都在下方具有真实调用语句。
// 为避免误删文件、启动进程、访问网络或操作设备，必须先勾选“允许实际执行”才会进入命令调用区。
类 MainWindow : 公开 窗口
    事件 _MainWindow_创建完毕()
        控件_设置选择项(命令分组选项卡, 0)
        控件_设置文本(演示状态, "哈希表与栈模块：28 条命令，默认处于安全预览模式。")
        调试输出("已加载模块演示：lingbuilder.std.map")
    结束

    事件 _运行第01组_被单击()
        控件_设置文本(演示状态, "命令 1–14：哈希表_创建 至 哈希表_取字节集；源码内含完整签名、参数、返回值与调用。")
        如果 (控件_取勾选(允许实际执行))
            // 命令ID：哈希表_创建
            // [1] 哈希表_创建(初始容量)
            // 功能：创建空哈希表并返回句柄（0 表示失败）；初始容量只用于预分配，哈希表会自动增长。
            // 参数：初始容量:int；返回：longLong；可见性：default
            哈希表_创建(1)
            // 命令ID：哈希表_销毁
            // [2] 哈希表_销毁(哈希表)
            // 功能：销毁哈希表并回收句柄；销毁后句柄不可再用。
            // 参数：哈希表:longLong；返回：bool；可见性：default
            哈希表_销毁(1)
            // 命令ID：哈希表_取数量
            // [3] 哈希表_取数量(哈希表)
            // 功能：返回哈希表当前的键值对数量；句柄无效返回 -1。
            // 参数：哈希表:longLong；返回：int；可见性：default
            哈希表_取数量(1)
            // 命令ID：哈希表_是否包含
            // [4] 哈希表_是否包含(哈希表, 键)
            // 功能：判断哈希表中是否存在指定键。
            // 参数：哈希表:longLong，键:wideString；返回：bool；可见性：default
            哈希表_是否包含(1, "演示参数2")
            // 命令ID：哈希表_删除
            // [5] 哈希表_删除(哈希表, 键)
            // 功能：删除指定键值对；键不存在返回假。
            // 参数：哈希表:longLong，键:wideString；返回：bool；可见性：default
            哈希表_删除(1, "演示参数2")
            // 命令ID：哈希表_清空
            // [6] 哈希表_清空(哈希表)
            // 功能：删除哈希表中的全部键值对，句柄保持可用。
            // 参数：哈希表:longLong；返回：bool；可见性：default
            哈希表_清空(1)
            // 命令ID：哈希表_置文本
            // [7] 哈希表_置文本(哈希表, 键, 值)
            // 功能：写入或覆盖文本型键值对。
            // 参数：哈希表:longLong，键:wideString，值:wideString；返回：bool；可见性：default
            哈希表_置文本(1, "演示参数2", "演示参数3")
            // 命令ID：哈希表_取文本
            // [8] 哈希表_取文本(哈希表, 键)
            // 功能：读取文本型值；键不存在时返回空文本。
            // 参数：哈希表:longLong，键:wideString；返回：wideString；可见性：default
            哈希表_取文本(1, "演示参数2")
            // 命令ID：哈希表_置整数
            // [9] 哈希表_置整数(哈希表, 键, 值)
            // 功能：写入或覆盖整数型键值对。
            // 参数：哈希表:longLong，键:wideString，值:longLong；返回：bool；可见性：default
            哈希表_置整数(1, "演示参数2", 1)
            // 命令ID：哈希表_取整数
            // [10] 哈希表_取整数(哈希表, 键)
            // 功能：读取整数型值；键不存在时返回 0。
            // 参数：哈希表:longLong，键:wideString；返回：longLong；可见性：default
            哈希表_取整数(1, "演示参数2")
            // 命令ID：哈希表_置逻辑
            // [11] 哈希表_置逻辑(哈希表, 键, 值)
            // 功能：写入或覆盖逻辑型键值对。
            // 参数：哈希表:longLong，键:wideString，值:bool；返回：bool；可见性：default
            哈希表_置逻辑(1, "演示参数2", 真)
            // 命令ID：哈希表_取逻辑
            // [12] 哈希表_取逻辑(哈希表, 键)
            // 功能：读取逻辑型值；键不存在时返回假。
            // 参数：哈希表:longLong，键:wideString；返回：bool；可见性：default
            哈希表_取逻辑(1, "演示参数2")
            // 命令ID：哈希表_置字节集
            // [13] 哈希表_置字节集(哈希表, 键, 值)
            // 功能：写入或覆盖字节集型键值对。
            // 参数：哈希表:longLong，键:wideString，值:bytes；返回：bool；可见性：default
            哈希表_置字节集(1, "演示参数2", {})
            // 命令ID：哈希表_取字节集
            // [14] 哈希表_取字节集(哈希表, 键)
            // 功能：读取字节集型值；键不存在时返回空字节集。
            // 参数：哈希表:longLong，键:wideString；返回：bytes；可见性：default
            哈希表_取字节集(1, "演示参数2")
        如果结束
        调试输出("已查看 命令 1–14：哈希表_创建 至 哈希表_取字节集；勾选允许实际执行后会使用演示参数调用。")
    结束

    事件 _运行第02组_被单击()
        控件_设置文本(演示状态, "命令 15–28：哈希表_取全部键 至 栈_上次弹出是否成功；源码内含完整签名、参数、返回值与调用。")
        如果 (控件_取勾选(允许实际执行))
            // 命令ID：哈希表_取全部键
            // [15] 哈希表_取全部键(哈希表, 结果数组)
            // 功能：把全部键写入文本型数组，返回键的数量；写入顺序不保证与插入顺序一致。
            // 参数：哈希表:longLong，结果数组:array；返回：int；可见性：default
            哈希表_取全部键(1, 0)
            // 命令ID：哈希表_上次操作是否成功
            // [16] 哈希表_上次操作是否成功()
            // 功能：报告本线程上一次 哈希表_取 命令是否取到有效值；哈希表句柄各自独立保存该状态。
            // 参数：无；返回：bool；可见性：default
            哈希表_上次操作是否成功()
            // 命令ID：栈_创建
            // [17] 栈_创建(初始容量)
            // 功能：创建空栈并返回句柄（0 表示失败）；初始容量只用于预分配，栈会自动增长。
            // 参数：初始容量:int；返回：longLong；可见性：default
            栈_创建(1)
            // 命令ID：栈_销毁
            // [18] 栈_销毁(栈)
            // 功能：销毁栈并回收句柄；销毁后句柄不可再用。
            // 参数：栈:longLong；返回：bool；可见性：default
            栈_销毁(1)
            // 命令ID：栈_取数量
            // [19] 栈_取数量(栈)
            // 功能：返回栈当前的元素数量；句柄无效返回 -1。
            // 参数：栈:longLong；返回：int；可见性：default
            栈_取数量(1)
            // 命令ID：栈_是否为空
            // [20] 栈_是否为空(栈)
            // 功能：判断栈是否没有任何元素；句柄无效返回真。
            // 参数：栈:longLong；返回：bool；可见性：default
            栈_是否为空(1)
            // 命令ID：栈_清空
            // [21] 栈_清空(栈)
            // 功能：清空栈内全部元素，句柄保持可用。
            // 参数：栈:longLong；返回：bool；可见性：default
            栈_清空(1)
            // 命令ID：栈_压入
            // [22] 栈_压入(栈, 值)
            // 功能：把文本值压入栈顶。
            // 参数：栈:longLong，值:wideString；返回：bool；可见性：default
            栈_压入(1, "演示参数2")
            // 命令ID：栈_弹出
            // [23] 栈_弹出(栈)
            // 功能：弹出栈顶文本值；栈为空时返回空文本。
            // 参数：栈:longLong；返回：wideString；可见性：default
            栈_弹出(1)
            // 命令ID：栈_压入整数
            // [24] 栈_压入整数(栈, 值)
            // 功能：把整数压入栈顶。
            // 参数：栈:longLong，值:longLong；返回：bool；可见性：default
            栈_压入整数(1, 1)
            // 命令ID：栈_弹出整数
            // [25] 栈_弹出整数(栈)
            // 功能：弹出栈顶整数；栈为空时返回 0。
            // 参数：栈:longLong；返回：longLong；可见性：default
            栈_弹出整数(1)
            // 命令ID：栈_压入字节集
            // [26] 栈_压入字节集(栈, 值)
            // 功能：把字节集压入栈顶。
            // 参数：栈:longLong，值:bytes；返回：bool；可见性：default
            栈_压入字节集(1, {})
            // 命令ID：栈_弹出字节集
            // [27] 栈_弹出字节集(栈)
            // 功能：弹出栈顶字节集；栈为空时返回空字节集。
            // 参数：栈:longLong；返回：bytes；可见性：default
            栈_弹出字节集(1)
            // 命令ID：栈_上次弹出是否成功
            // [28] 栈_上次弹出是否成功()
            // 功能：报告本线程上一次 栈_弹出 命令是否真的弹出了元素；栈句柄各自独立保存该状态。
            // 参数：无；返回：bool；可见性：default
            栈_上次弹出是否成功()
        如果结束
        调试输出("已查看 命令 15–28：哈希表_取全部键 至 栈_上次弹出是否成功；勾选允许实际执行后会使用演示参数调用。")
    结束

结束类
