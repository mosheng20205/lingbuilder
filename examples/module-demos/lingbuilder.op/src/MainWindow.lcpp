            // [53] 后台_执行命令(句柄, 命令行, 显示方式)
            // 功能：启动程序（不取 PID 的轻量形态）。
            // 参数：句柄:OP句柄，命令行:wideString，显示方式:int；返回：bool；可见性：default
            后台_执行命令(0, "演示参数2", 1)
            // 命令ID：后台_取命令输出
            // [54] 后台_取命令输出(句柄, 命令, 超时毫秒)
            // 功能：执行命令行并返回其标准输出文本（内部捕获，控制台窗口不弹出）。
            // 参数：句柄:OP句柄，命令:wideString，超时毫秒:int；返回：wideString；可见性：default
            后台_取命令输出(0, "演示参数2", 1)
            // 命令ID：后台_置剪贴板
            // [55] 后台_置剪贴板(句柄, 文本)
            // 功能：把文本写入系统剪贴板；配合 后台_发送粘贴 可向目标窗口后台粘贴。
            // 参数：句柄:OP句柄，文本:wideString；返回：bool；可见性：default
            后台_置剪贴板(0, "演示参数2")
            // 命令ID：后台_取剪贴板
            // [56] 后台_取剪贴板(句柄)
            // 功能：读取系统剪贴板文本内容。
            // 参数：句柄:OP句柄；返回：wideString；可见性：default
            后台_取剪贴板(0)
            // 命令ID：后台_延迟
            // [57] 后台_延迟(句柄, 毫秒)
            // 功能：让当前线程暂停指定毫秒；挂机脚本里做步骤间隔的常规选择。
            // 参数：句柄:OP句柄，毫秒:int；返回：bool；可见性：default
            后台_延迟(0, 1)
            // 命令ID：后台_随机延迟
            // [58] 后台_随机延迟(句柄, 最小毫秒, 最大毫秒)
            // 功能：在 [最小,最大] 毫秒区间内随机暂停；比固定延迟更接近人工节奏。
            // 参数：句柄:OP句柄，最小毫秒:int，最大毫秒:int；返回：bool；可见性：default
            后台_随机延迟(0, 1, 1)
            // 命令ID：后台_绑定窗口
            // [59] 后台_绑定窗口(句柄, 窗口句柄, 显示后端, 鼠标模式, 键盘模式, 绑定模式)
            // 功能：把目标窗口绑定为本引擎的后台操作对象：之后的截图/找图/找色/键鼠命令都作用于该窗口，窗口被遮挡、失焦仍可操作。绑定失败读 后台_取错误 排查（常见原因：后端与目标渲染方式不符，换 gdi2 或 dx.d3d11 再试）。
            // 参数：句柄:OP句柄，窗口句柄:longLong，显示后端:wideString，鼠标模式:wideString，键盘模式:wideString，绑定模式:int；返回：bool；可见性：default
            后台_绑定窗口(0, 1, "演示参数3", "演示参数4", "演示参数5", 1)
            // 命令ID：后台_绑定窗口扩展
            // [60] 后台_绑定窗口扩展(句柄, 显示窗口句柄, 输入窗口句柄, 显示后端, 鼠标模式, 键盘模式, 绑定模式)
            // 功能：显示/输入分离的扩展绑定：截图窗口与收输入窗口不是同一个时使用（模拟器多层窗口、嵌套浏览器内核、游戏渲染子窗口）。普通窗口用 后台_绑定窗口 即可。
            // 参数：句柄:OP句柄，显示窗口句柄:longLong，输入窗口句柄:longLong，显示后端:wideString，鼠标模式:wideString，键盘模式:wideString，绑定模式:int；返回：bool；可见性：default
            后台_绑定窗口扩展(0, 1, 1, "演示参数4", "演示参数5", "演示参数6", 1)
        如果结束
        调试输出("已查看 命令 41–60：后台_移动窗口 至 后台_绑定窗口扩展；勾选允许实际执行后会使用演示参数调用。")
    结束

