            // 命令ID：后台_单字预览
            // [189] 后台_单字预览(句柄, 字库信息, 成功标记)
            // 功能：把单条字库条目的点阵渲染成预览文本（校验字库条目内容）。
            // 参数：句柄:OP句柄，字库信息:wideString，成功标记:int；返回：wideString；可见性：advanced
            后台_单字预览(0, "演示参数2", 1)
            // 命令ID：后台_校验字库
            // [190] 后台_校验字库(句柄, 字库信息, 结果标记)
            // 功能：校验字库条目格式是否合法并返回诊断信息。
            // 参数：句柄:OP句柄，字库信息:wideString，结果标记:int；返回：wideString；可见性：advanced
            后台_校验字库(0, "演示参数2", 1)
            // 命令ID：后台_规范化字库
            // [191] 后台_规范化字库(句柄, 字库信息, 结果标记)
            // 功能：把字库条目规范化为标准形态（采集工具输出前处理）。
            // 参数：句柄:OP句柄，字库信息:wideString，结果标记:int；返回：wideString；可见性：advanced
            后台_规范化字库(0, "演示参数2", 1)
            // 命令ID：后台_字库改名
            // [192] 后台_字库改名(句柄, 字库信息, 新词, 结果标记)
            // 功能：修改字库条目对应的字符（采错字时改绑）。
            // 参数：句柄:OP句柄，字库信息:wideString，新词:wideString，结果标记:int；返回：wideString；可见性：advanced
            后台_字库改名(0, "演示参数2", "演示参数3", 1)
            // 命令ID：后台_无字库取词
            // [193] 后台_无字库取词(句柄, 左上横坐标, 左上纵坐标, 右下横坐标, 右下纵坐标, 颜色)
            // 功能：不加载字库直接切出区域内全部文字块及其点阵描述——配合 后台_追加字库 就地采集新字库。
            // 参数：句柄:OP句柄，左上横坐标:int，左上纵坐标:int，右下横坐标:int，右下纵坐标:int，颜色:wideString；返回：wideString；可见性：default
            后台_无字库取词(0, 1, 1, 1, 1, "演示参数6")
            // 命令ID：后台_取词结果数量
            // [194] 后台_取词结果数量(句柄, 结果)
            // 功能：解析取词结果中的条目数量。
            // 参数：句柄:OP句柄，结果:wideString；返回：int；可见性：default
            后台_取词结果数量(0, "演示参数2")
            // 命令ID：后台_取词结果坐标
            // [195] 后台_取词结果坐标(句柄, 结果, 索引, 横坐标, 纵坐标)
            // 功能：读取取词结果中指定条目的坐标（写回两个变量）。
            // 参数：句柄:OP句柄，结果:wideString，索引:int，横坐标:int，纵坐标:int；返回：bool；可见性：default
            后台_取词结果坐标(0, "演示参数2", 1, 1, 1)
            // 命令ID：后台_取词结果文本
            // [196] 后台_取词结果文本(句柄, 结果, 索引)
            // 功能：读取取词结果中指定条目识别出的文字。
            // 参数：句柄:OP句柄，结果:wideString，索引:int；返回：wideString；可见性：default
            后台_取词结果文本(0, "演示参数2", 1)
            // 命令ID：后台_识字
            // [197] 后台_识字(句柄, 左上横坐标, 左上纵坐标, 右下横坐标, 右下纵坐标, 颜色, 相似度)
            // 功能：用当前字库识别区域内文字并返回文本（游戏点阵字体的标准识字入口；自然图片文字请改用 lingbuilder.ocr 模块）。
            // 参数：句柄:OP句柄，左上横坐标:int，左上纵坐标:int，右下横坐标:int，右下纵坐标:int，颜色:wideString，相似度:double；返回：wideString；可见性：default
            后台_识字(0, 1, 1, 1, 1, "演示参数6", 1.0)
            // 命令ID：后台_识字带坐标
            // [198] 后台_识字带坐标(句柄, 左上横坐标, 左上纵坐标, 右下横坐标, 右下纵坐标, 颜色, 相似度)
            // 功能：识字并返回每段文字的坐标信息（配合 后台_取词结果数量/坐标/文本 三件套解析）。
            // 参数：句柄:OP句柄，左上横坐标:int，左上纵坐标:int，右下横坐标:int，右下纵坐标:int，颜色:wideString，相似度:double；返回：wideString；可见性：default
            后台_识字带坐标(0, 1, 1, 1, 1, "演示参数6", 1.0)
            // 命令ID：后台_找字
            // [199] 后台_找字(句柄, 左上横坐标, 左上纵坐标, 右下横坐标, 右下纵坐标, 字串集, 颜色, 相似度, 结果横坐标, 结果纵坐标)
            // 功能：在区域内查找指定文字，命中坐标写回两个变量（找"活动"、"领取"等文字按钮的直接入口）。
            // 参数：句柄:OP句柄，左上横坐标:int，左上纵坐标:int，右下横坐标:int，右下纵坐标:int，字串集:wideString，颜色:wideString，相似度:double，结果横坐标:int，结果纵坐标:int；返回：bool；可见性：default
            后台_找字(0, 1, 1, 1, 1, "演示参数6", "演示参数7", 1.0, 1, 1)
            // 命令ID：后台_找字全部
            // [200] 后台_找字全部(句柄, 左上横坐标, 左上纵坐标, 右下横坐标, 右下纵坐标, 字串集, 颜色, 相似度)
            // 功能：查找全部命中文字及其位置。
            // 参数：句柄:OP句柄，左上横坐标:int，左上纵坐标:int，右下横坐标:int，右下纵坐标:int，字串集:wideString，颜色:wideString，相似度:double；返回：wideString；可见性：default
            后台_找字全部(0, 1, 1, 1, 1, "演示参数6", "演示参数7", 1.0)
        如果结束
        调试输出("已查看 命令 181–200：后台_取词 至 后台_找字全部；勾选允许实际执行后会使用演示参数调用。")
    结束

    事件 _运行第11组_被单击()
        控件_设置文本(演示状态, "命令 201–214：后台_自动识字 至 后台_写内存文本；源码内含完整签名、参数、返回值与调用。")
        如果 (控件_取勾选(允许实际执行))
            // 命令ID：后台_自动识字
            // [201] 后台_自动识字(句柄, 左上横坐标, 左上纵坐标, 右下横坐标, 右下纵坐标, 相似度)
            // 功能：免颜色描述的识字（引擎自动分析前景色）；颜色不固定或懒得取色时用。
            // 参数：句柄:OP句柄，左上横坐标:int，左上纵坐标:int，右下横坐标:int，右下纵坐标:int，相似度:double；返回：wideString；可见性：default
            后台_自动识字(0, 1, 1, 1, 1, 1.0)
            // 命令ID：后台_文件识字
            // [202] 后台_文件识字(句柄, 文件名, 颜色格式, 相似度)
            // 功能：对图片文件做字库识字（不依赖当前绑定；配合 后台_截图 做离线批量识别）。
            // 参数：句柄:OP句柄，文件名:wideString，颜色格式:wideString，相似度:double；返回：wideString；可见性：default
            后台_文件识字(0, "module-demo-temp.txt", "演示参数3", 1.0)
            // 命令ID：后台_文件自动识字
            // [203] 后台_文件自动识字(句柄, 文件名, 相似度)
            // 功能：对图片文件做免颜色识字。
            // 参数：句柄:OP句柄，文件名:wideString，相似度:double；返回：wideString；可见性：default
            后台_文件自动识字(0, "module-demo-temp.txt", 1.0)
            // 命令ID：后台_找直线
            // [204] 后台_找直线(句柄, 左上横坐标, 左上纵坐标, 右下横坐标, 右下纵坐标, 颜色, 相似度)
            // 功能：在区域内找指定颜色的直线段（小地图寻路、跑道对齐等场景）。
            // 参数：句柄:OP句柄，左上横坐标:int，左上纵坐标:int，右下横坐标:int，右下纵坐标:int，颜色:wideString，相似度:double；返回：wideString；可见性：default
            后台_找直线(0, 1, 1, 1, 1, "演示参数6", 1.0)
            // 命令ID：后台_写内存数据
            // [205] 后台_写内存数据(句柄, 窗口句柄, 地址, 十六进制数据, 字节数)
            // 功能：向目标进程内存写入原始字节。仅用于调试自有软件；操作第三方游戏内存可能违反其用户协议，风险自负。
            // 参数：句柄:OP句柄，窗口句柄:longLong，地址:wideString，十六进制数据:wideString，字节数:int；返回：bool；可见性：default
            后台_写内存数据(0, 1, "https://example.com", "演示参数4", 1)
            // 命令ID：后台_读内存数据
            // [206] 后台_读内存数据(句柄, 窗口句柄, 地址, 字节数)
            // 功能：读取目标进程内存原始字节，返回十六进制文本。
            // 参数：句柄:OP句柄，窗口句柄:longLong，地址:wideString，字节数:int；返回：wideString；可见性：default
            后台_读内存数据(0, 1, "https://example.com", 1)
            // 命令ID：后台_读内存整数
            // [207] 后台_读内存整数(句柄, 窗口句柄, 地址, 类型, 数值)
            // 功能：读取目标进程内存中的整数（类型决定宽度与符号解释；写回 数值 变量）。
            // 参数：句柄:OP句柄，窗口句柄:longLong，地址:wideString，类型:int，数值:longLong；返回：bool；可见性：default
            后台_读内存整数(0, 1, "https://example.com", 1, 1)
            // 命令ID：后台_写内存整数
            // [208] 后台_写内存整数(句柄, 窗口句柄, 地址, 类型, 数值)
            // 功能：向目标进程内存写入整数。
            // 参数：句柄:OP句柄，窗口句柄:longLong，地址:wideString，类型:int，数值:longLong；返回：bool；可见性：default
            后台_写内存整数(0, 1, "https://example.com", 1, 1)
            // 命令ID：后台_读内存单精度
            // [209] 后台_读内存单精度(句柄, 窗口句柄, 地址, 数值)
            // 功能：读取单精度浮点（血量/坐标等 float 数值常用）。
            // 参数：句柄:OP句柄，窗口句柄:longLong，地址:wideString，数值:float；返回：bool；可见性：default
            后台_读内存单精度(0, 1, "https://example.com", 0)
            // 命令ID：后台_写内存单精度
            // [210] 后台_写内存单精度(句柄, 窗口句柄, 地址, 数值)
            // 功能：写入单精度浮点。
            // 参数：句柄:OP句柄，窗口句柄:longLong，地址:wideString，数值:float；返回：bool；可见性：default
            后台_写内存单精度(0, 1, "https://example.com", 0)
            // 命令ID：后台_读内存小数
            // [211] 后台_读内存小数(句柄, 窗口句柄, 地址, 数值)
            // 功能：读取双精度浮点。
            // 参数：句柄:OP句柄，窗口句柄:longLong，地址:wideString，数值:double；返回：bool；可见性：default
            后台_读内存小数(0, 1, "https://example.com", 1.0)
            // 命令ID：后台_写内存小数
            // [212] 后台_写内存小数(句柄, 窗口句柄, 地址, 数值)
            // 功能：写入双精度浮点。
            // 参数：句柄:OP句柄，窗口句柄:longLong，地址:wideString，数值:double；返回：bool；可见性：default
            后台_写内存小数(0, 1, "https://example.com", 1.0)
            // 命令ID：后台_读内存文本
            // [213] 后台_读内存文本(句柄, 窗口句柄, 地址, 编码, 长度)
            // 功能：读取目标进程内存中的字符串（按指定编码解释）。
            // 参数：句柄:OP句柄，窗口句柄:longLong，地址:wideString，编码:int，长度:int；返回：wideString；可见性：default
            后台_读内存文本(0, 1, "https://example.com", 1, 1)
            // 命令ID：后台_写内存文本
            // [214] 后台_写内存文本(句柄, 窗口句柄, 地址, 编码, 内容)
            // 功能：向目标进程内存写入字符串。
            // 参数：句柄:OP句柄，窗口句柄:longLong，地址:wideString，编码:int，内容:wideString；返回：bool；可见性：default
            后台_写内存文本(0, 1, "https://example.com", 1, "演示参数5")
        如果结束
        调试输出("已查看 命令 201–214：后台_自动识字 至 后台_写内存文本；勾选允许实际执行后会使用演示参数调用。")
    结束

结束类
