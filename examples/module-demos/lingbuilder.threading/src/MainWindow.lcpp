包 多线程模块完整演示
使用 Win32窗口基础模块
使用 多线程模块

// 本项目由模块清单自动生成；每条 binding 命令都在下方具有真实调用语句。
// 为避免误删文件、启动进程、访问网络或操作设备，必须先勾选“允许实际执行”才会进入命令调用区。
类 MainWindow : 公开 窗口
    事件 _MainWindow_创建完毕()
        控件_设置选择项(命令分组选项卡, 0)
        控件_设置文本(演示状态, "多线程模块：54 条命令，默认处于安全预览模式。")
        调试输出("已加载模块演示：lingbuilder.threading")
    结束

    事件 _运行第01组_被单击()
        控件_设置文本(演示状态, "命令 1–18：线程_提交 至 线程_清理已完成；源码内含完整签名、参数、返回值与调用。")
        如果 (控件_取勾选(允许实际执行))
            // 命令ID：线程_提交
            // [1] 线程_提交(&工作处理器, 参数...)
            // 功能：向项目默认线程池提交类型化工作；所有参数在提交时按值深拷贝。
            // 参数：工作处理器:handler，参数:lingValue；返回：longLong；可见性：default
            线程_提交(&模块演示工作)
            // 命令ID：线程_提交完成
            // [2] 线程_提交完成(&工作处理器, &完成处理器, 参数...)
            // 功能：提交工作并在发起窗口 UI 线程执行一次完成处理器。
            // 参数：工作处理器:handler，完成处理器:handler，参数:lingValue；返回：longLong；可见性：default
            线程_提交完成(&模块演示工作, &模块演示完成)
            // 命令ID：线程_提交进度
            // [3] 线程_提交进度(&工作处理器, &进度处理器, &完成处理器, 参数...)
            // 功能：提交可报告进度的工作；进度按 80ms 合并并在 UI 线程分发。
            // 参数：工作处理器:handler，进度处理器:handler，完成处理器:handler，参数:lingValue；返回：longLong；可见性：default
            线程_提交进度(&模块演示进度工作, &模块演示进度, &模块演示完成)
            // 命令ID：线程_取当前任务
            // [4] 线程_取当前任务()
            // 功能：在工作处理器内返回当前任务；其它线程返回 0。
            // 参数：无；返回：longLong；可见性：default
            线程_取当前任务()
            // 命令ID：线程_请求取消
            // [5] 线程_请求取消(任务)
            // 功能：请求排队或运行任务协作取消。
            // 参数：任务:longLong；返回：bool；可见性：default
            线程_请求取消(1)
            // 命令ID：线程_是否请求取消
            // [6] 线程_是否请求取消(任务)
            // 功能：查询指定任务是否已请求取消；传 0 时查询当前任务。
            // 参数：任务:longLong；返回：bool；可见性：default
            线程_是否请求取消(1)
            // 命令ID：线程_取状态
            // [7] 线程_取状态(任务)
            // 功能：返回固定任务状态码：-1 无效，0 排队，1 运行，2 成功，3 失败，4 请求取消，5 已取消。
            // 参数：任务:longLong；返回：int；可见性：default
            线程_取状态(1)
            // 命令ID：线程_取状态名称
            // [8] 线程_取状态名称(任务)
            // 功能：返回任务状态的中文名称。
            // 参数：任务:longLong；返回：wideString；可见性：default
            线程_取状态名称(1)
            // 命令ID：线程_是否完成
            // [9] 线程_是否完成(任务)
            // 功能：判断任务是否处于成功、失败或已取消状态。
            // 参数：任务:longLong；返回：bool；可见性：default
            线程_是否完成(1)
            // 命令ID：线程_取错误
            // [10] 线程_取错误(任务)
            // 功能：返回任务失败、取消或提交失败的中文错误。
            // 参数：任务:longLong；返回：wideString；可见性：default
            线程_取错误(1)
            // 命令ID：线程_等待
            // [11] 线程_等待(任务, 超时毫秒)
            // 功能：等待任务结束；-1 表示无限等待。禁止在任务中等待自身。
            // 参数：任务:longLong，超时毫秒:int；返回：bool；可见性：default
            线程_等待(1, 1)
            // 命令ID：线程_等待全部超时
            // [12] 线程_等待全部超时(超时毫秒, 任务...)
            // 功能：在总超时内等待给出的全部任务。
            // 参数：超时毫秒:int，参数:lingValue；返回：bool；可见性：default
            线程_等待全部超时(1)
            // 命令ID：线程_协作等待
            // [13] 线程_协作等待(毫秒)
            // 功能：在工作处理器中分段等待并响应取消；UI 线程调用时不会泵送界面消息。
            // 参数：毫秒:int；返回：bool；可见性：default
            线程_协作等待(1)
            // 命令ID：线程_报告进度
            // [14] 线程_报告进度(百分比, 说明)
            // 功能：从当前工作处理器报告 0～100 的最新进度。
            // 参数：百分比:int，说明:wideString；返回：bool；可见性：default
            线程_报告进度(1, "演示参数2")
            // 命令ID：线程_取进度
            // [15] 线程_取进度(任务)
            // 功能：返回任务最近报告的百分比。
            // 参数：任务:longLong；返回：int；可见性：default
            线程_取进度(1)
            // 命令ID：线程_取进度说明
            // [16] 线程_取进度说明(任务)
            // 功能：返回任务最近报告的说明。
            // 参数：任务:longLong；返回：wideString；可见性：default
            线程_取进度说明(1)
            // 命令ID：线程_释放任务
            // [17] 线程_释放任务(任务)
            // 功能：释放已完成任务的项目级记录；运行中的任务不能释放。
            // 参数：任务:longLong；返回：bool；可见性：default
            线程_释放任务(1)
            // 命令ID：线程_清理已完成
            // [18] 线程_清理已完成()
            // 功能：清理当前项目中全部已完成任务记录并返回数量。
            // 参数：无；返回：int；可见性：default
            线程_清理已完成()
        如果结束
        调试输出("已查看 命令 1–18：线程_提交 至 线程_清理已完成；勾选允许实际执行后会使用演示参数调用。")
    结束

    事件 _运行第02组_被单击()
        控件_设置文本(演示状态, "命令 19–36：线程池_取默认池 至 互斥锁_执行；源码内含完整签名、参数、返回值与调用。")
        如果 (控件_取勾选(允许实际执行))
            // 命令ID：线程池_取默认池
            // [19] 线程池_取默认池()
            // 功能：返回惰性启动的项目默认线程池。
            // 参数：无；返回：longLong；可见性：default
            线程池_取默认池()
            // 命令ID：线程池_创建
            // [20] 线程池_创建(并发数, 队列容量)
            // 功能：创建项目级自定义有界线程池；并发数 1～64，容量 1～100000，最多 16 个。
            // 参数：并发数:int，队列容量:int；返回：longLong；可见性：default
            线程池_创建(1, 1)
            // 命令ID：线程池_提交
            // [21] 线程池_提交(线程池, &工作处理器, 参数...)
            // 功能：向指定线程池提交类型化工作。
            // 参数：线程池:longLong，工作处理器:handler，参数:lingValue；返回：longLong；可见性：default
            线程池_提交(1, &模块演示工作)
            // 命令ID：线程池_提交完成
            // [22] 线程池_提交完成(线程池, &工作处理器, &完成处理器, 参数...)
            // 功能：向指定线程池提交工作并在 UI 线程执行完成处理器。
            // 参数：线程池:longLong，工作处理器:handler，完成处理器:handler，参数:lingValue；返回：longLong；可见性：default
            线程池_提交完成(1, &模块演示工作, &模块演示完成)
            // 命令ID：线程池_提交进度
            // [23] 线程池_提交进度(线程池, &工作处理器, &进度处理器, &完成处理器, 参数...)
            // 功能：向指定线程池提交带进度和完成回调的工作。
            // 参数：线程池:longLong，工作处理器:handler，进度处理器:handler，完成处理器:handler，参数:lingValue；返回：longLong；可见性：default
            线程池_提交进度(1, &模块演示进度工作, &模块演示进度, &模块演示完成)
            // 命令ID：线程池_设置并发数
            // [24] 线程池_设置并发数(线程池, 并发数)
            // 功能：在线程池空闲时调整并发数。
            // 参数：线程池:longLong，并发数:int；返回：bool；可见性：default
            线程池_设置并发数(1, 1)
            // 命令ID：线程池_取并发数
            // [25] 线程池_取并发数(线程池)
            // 功能：返回线程池工作线程数。
            // 参数：线程池:longLong；返回：int；可见性：default
            线程池_取并发数(1)
            // 命令ID：线程池_取等待数量
            // [26] 线程池_取等待数量(线程池)
            // 功能：返回线程池有界队列中的等待任务数。
            // 参数：线程池:longLong；返回：int；可见性：default
            线程池_取等待数量(1)
            // 命令ID：线程池_取运行数量
            // [27] 线程池_取运行数量(线程池)
            // 功能：返回线程池当前运行任务数。
            // 参数：线程池:longLong；返回：int；可见性：default
            线程池_取运行数量(1)
            // 命令ID：线程池_是否空闲
            // [28] 线程池_是否空闲(线程池)
            // 功能：判断线程池是否没有排队或运行任务。
            // 参数：线程池:longLong；返回：bool；可见性：default
            线程池_是否空闲(1)
            // 命令ID：线程池_等待空闲
            // [29] 线程池_等待空闲(线程池, 超时毫秒)
            // 功能：等待线程池进入空闲状态；-1 表示无限等待。
            // 参数：线程池:longLong，超时毫秒:int；返回：bool；可见性：default
            线程池_等待空闲(1, 1)
            // 命令ID：线程池_请求停止
            // [30] 线程池_请求停止(线程池)
            // 功能：协作取消线程池中的排队和运行任务。
            // 参数：线程池:longLong；返回：bool；可见性：default
            线程池_请求停止(1)
            // 命令ID：线程池_关闭
            // [31] 线程池_关闭(线程池, 超时毫秒)
            // 功能：协作停止并等待工作线程退出；超时不会强杀线程。
            // 参数：线程池:longLong，超时毫秒:int；返回：bool；可见性：default
            线程池_关闭(1, 1)
            // 命令ID：线程池_重启
            // [32] 线程池_重启(线程池)
            // 功能：重启已关闭且空闲的自定义线程池。
            // 参数：线程池:longLong；返回：bool；可见性：default
            线程池_重启(1)
            // 命令ID：线程池_销毁
            // [33] 线程池_销毁(线程池)
            // 功能：销毁已停止且空闲的自定义线程池；默认池不可销毁。
            // 参数：线程池:longLong；返回：bool；可见性：default
            线程池_销毁(1)
            // 命令ID：线程池_取硬件并发数
            // [34] 线程池_取硬件并发数()
            // 功能：返回 C++ 运行时报告的硬件并发数，最小为 1。
            // 参数：无；返回：int；可见性：default
            线程池_取硬件并发数()
            // 命令ID：互斥锁_创建
            // [35] 互斥锁_创建()
            // 功能：创建项目级非递归定时互斥锁。
            // 参数：无；返回：longLong；可见性：default
            互斥锁_创建()
            // 命令ID：互斥锁_执行
            // [36] 互斥锁_执行(互斥锁, &处理器, 参数...)
            // 功能：持锁执行处理器并由 RAII 自动解锁；同线程重入会失败。
            // 参数：互斥锁:longLong，处理器:handler，参数:lingValue；返回：bool；可见性：default
            互斥锁_执行(1, &模块演示工作)
        如果结束
        调试输出("已查看 命令 19–36：线程池_取默认池 至 互斥锁_执行；勾选允许实际执行后会使用演示参数调用。")
    结束

    事件 _运行第03组_被单击()
        控件_设置文本(演示状态, "命令 37–54：互斥锁_尝试执行 至 信号量_销毁；源码内含完整签名、参数、返回值与调用。")
        如果 (控件_取勾选(允许实际执行))
            // 命令ID：互斥锁_尝试执行
            // [37] 互斥锁_尝试执行(互斥锁, 超时毫秒, &处理器, 参数...)
            // 功能：在超时内尝试持锁执行处理器，并由 RAII 自动解锁。
            // 参数：互斥锁:longLong，超时毫秒:int，处理器:handler，参数:lingValue；返回：bool；可见性：default
            互斥锁_尝试执行(1, 1, &模块演示工作)
            // 命令ID：互斥锁_销毁
            // [38] 互斥锁_销毁(互斥锁)
            // 功能：销毁当前无人持有或等待的互斥锁。
            // 参数：互斥锁:longLong；返回：bool；可见性：default
            互斥锁_销毁(1)
            // 命令ID：原子整数_创建
            // [39] 原子整数_创建(初始值)
            // 功能：创建项目级 64 位原子整数。
            // 参数：初始值:longLong；返回：longLong；可见性：default
            原子整数_创建(1)
            // 命令ID：原子整数_读取
            // [40] 原子整数_读取(原子整数)
            // 功能：原子读取当前值。
            // 参数：原子整数:longLong；返回：longLong；可见性：default
            原子整数_读取(1)
            // 命令ID：原子整数_写入
            // [41] 原子整数_写入(原子整数, 新值)
            // 功能：原子写入并返回旧值。
            // 参数：原子整数:longLong，新值:longLong；返回：longLong；可见性：default
            原子整数_写入(1, 1)
            // 命令ID：原子整数_增加
            // [42] 原子整数_增加(原子整数, 增量)
            // 功能：原子增加并返回新值。
            // 参数：原子整数:longLong，增量:longLong；返回：longLong；可见性：default
            原子整数_增加(1, 1)
            // 命令ID：原子整数_比较交换
            // [43] 原子整数_比较交换(原子整数, 预期值, 新值)
            // 功能：仅当当前值等于预期值时交换，并返回是否成功。
            // 参数：原子整数:longLong，预期值:longLong，新值:longLong；返回：bool；可见性：default
            原子整数_比较交换(1, 1, 1)
            // 命令ID：原子整数_销毁
            // [44] 原子整数_销毁(原子整数)
            // 功能：销毁项目级原子整数。
            // 参数：原子整数:longLong；返回：bool；可见性：default
            原子整数_销毁(1)
            // 命令ID：线程事件_创建
            // [45] 线程事件_创建(手动重置, 初始置位)
            // 功能：创建自动或手动重置的项目级同步事件。
            // 参数：手动重置:bool，初始置位:bool；返回：longLong；可见性：default
            线程事件_创建(真, 真)
            // 命令ID：线程事件_置位
            // [46] 线程事件_置位(事件)
            // 功能：置位事件并唤醒等待者。
            // 参数：事件:longLong；返回：bool；可见性：default
            线程事件_置位(1)
            // 命令ID：线程事件_重置
            // [47] 线程事件_重置(事件)
            // 功能：将事件恢复为未置位状态。
            // 参数：事件:longLong；返回：bool；可见性：default
            线程事件_重置(1)
            // 命令ID：线程事件_等待
            // [48] 线程事件_等待(事件, 超时毫秒)
            // 功能：等待事件置位；自动重置事件仅释放一个等待者。
            // 参数：事件:longLong，超时毫秒:int；返回：bool；可见性：default
            线程事件_等待(1, 1)
            // 命令ID：线程事件_销毁
            // [49] 线程事件_销毁(事件)
            // 功能：销毁事件并唤醒等待者使其失败返回。
            // 参数：事件:longLong；返回：bool；可见性：default
            线程事件_销毁(1)
            // 命令ID：信号量_创建
            // [50] 信号量_创建(初始值, 最大值)
            // 功能：创建项目级计数信号量。
            // 参数：初始值:int，最大值:int；返回：longLong；可见性：default
            信号量_创建(1, 1)
            // 命令ID：信号量_等待
            // [51] 信号量_等待(信号量, 超时毫秒)
            // 功能：等待并消耗一个信号量计数。
            // 参数：信号量:longLong，超时毫秒:int；返回：bool；可见性：default
            信号量_等待(1, 1)
            // 命令ID：信号量_释放
            // [52] 信号量_释放(信号量, 数量)
            // 功能：释放指定计数；超过最大值时拒绝。
            // 参数：信号量:longLong，数量:int；返回：bool；可见性：default
            信号量_释放(1, 1)
            // 命令ID：信号量_取可用数量
            // [53] 信号量_取可用数量(信号量)
            // 功能：返回当前可用计数。
            // 参数：信号量:longLong；返回：int；可见性：default
            信号量_取可用数量(1)
            // 命令ID：信号量_销毁
            // [54] 信号量_销毁(信号量)
            // 功能：销毁信号量并唤醒等待者使其失败返回。
            // 参数：信号量:longLong；返回：bool；可见性：default
            信号量_销毁(1)
        如果结束
        调试输出("已查看 命令 37–54：互斥锁_尝试执行 至 信号量_销毁；勾选允许实际执行后会使用演示参数调用。")
    结束

    空 模块演示工作()
        线程_协作等待(1)
    结束

    空 模块演示进度工作()
        线程_报告进度(100, "演示工作完成")
    结束

    空 模块演示进度(线程任务 任务, 整数型 百分比, 文本型 说明)
        调试输出(说明)
    结束

    空 模块演示完成(线程任务 任务)
        调试输出("模块演示任务完成")
    结束

结束类
