包 二维码模块完整演示
使用 Win32窗口基础模块
使用 二维码模块

// 本项目由模块清单自动生成；每条 binding 命令都在下方具有真实调用语句。
// 为避免误删文件、启动进程、访问网络或操作设备，必须先勾选“允许实际执行”才会进入命令调用区。
类 MainWindow : 公开 窗口
    事件 _MainWindow_创建完毕()
        控件_设置选择项(命令分组选项卡, 0)
        控件_设置文本(演示状态, "二维码模块：31 条命令，默认处于安全预览模式。")
        调试输出("已加载模块演示：lingbuilder.qrcode")
    结束

    事件 _运行第01组_被单击()
        控件_设置文本(演示状态, "命令 1–16：二维码_取版本 至 二维码_识别字节集；源码内含完整签名、参数、返回值与调用。")
        如果 (控件_取勾选(允许实际执行))
            // 命令ID：二维码_取版本
            // [1] 二维码_取版本()
            // 功能：返回二维码模块版本与实现口径描述。
            // 参数：无；返回：wideString；可见性：default
            二维码_取版本()
            // 命令ID：二维码_生成
            // [2] 二维码_生成(内容, 纠错级别, 边长像素, 空白边模块数)
            // 功能：生成二维码并返回受管句柄；内容超出 40-H 容量或输出边长超过 4096 像素时返回 0，失败原因读 二维码_取错误()。
            // 参数：内容:wideString，纠错级别:wideString，边长像素:int，空白边模块数:int；返回：二维码句柄；可见性：default
            二维码_生成("演示参数1", "演示参数2", 1, 1)
            // 命令ID：二维码_取错误
            // [3] 二维码_取错误()
            // 功能：读取当前线程最近一次生成侧操作的中文错误。
            // 参数：无；返回：wideString；可见性：default
            二维码_取错误()
            // 命令ID：二维码_取模块数
            // [4] 二维码_取模块数(码)
            // 功能：返回单边模块数（21～177）；句柄无效返回 0。
            // 参数：码:二维码句柄；返回：int；可见性：default
            二维码_取模块数(0)
            // 命令ID：二维码_取版本号
            // [5] 二维码_取版本号(码)
            // 功能：返回自动选出的 QR 版本号（1～40）；句柄无效返回 0。
            // 参数：码:二维码句柄；返回：int；可见性：default
            二维码_取版本号(0)
            // 命令ID：二维码_取掩码
            // [6] 二维码_取掩码(码)
            // 功能：返回掩码号（0～7，罚分最低者）；句柄无效返回 -1。
            // 参数：码:二维码句柄；返回：int；可见性：default
            二维码_取掩码(0)
            // 命令ID：二维码_取纠错级别
            // [7] 二维码_取纠错级别(码)
            // 功能：返回该码的纠错级别 L/M/Q/H；句柄无效返回空文本。
            // 参数：码:二维码句柄；返回：wideString；可见性：default
            二维码_取纠错级别(0)
            // 命令ID：二维码_取深色
            // [8] 二维码_取深色(码, 行, 列)
            // 功能：读取原始矩阵中指定模块是否为深色；越界或句柄无效返回假。
            // 参数：码:二维码句柄，行:int，列:int；返回：bool；可见性：default
            二维码_取深色(0, 1, 1)
            // 命令ID：二维码_保存PNG
            // [9] 二维码_保存PNG(码, 路径, 前景色, 背景色)
            // 功能：把二维码渲染为 PNG（GDI+ 可直接打开；灰度 8bit 或 RGB 8bit，deflate 内置）。中文路径安全。
            // 参数：码:二维码句柄，路径:wideString，前景色:longLong，背景色:longLong；返回：bool；可见性：default
            二维码_保存PNG(0, "module-demo-temp.txt", 1, 1)
            // 命令ID：二维码_取位图
            // [10] 二维码_取位图(码, 前景色, 背景色)
            // 功能：渲染为 32 位 HBITMAP（可直接 SendMessage STM_SETIMAGE 到静态控件）；同句柄同色重复调用返回缓存，位图随 二维码_释放 一起销毁。
            // 参数：码:二维码句柄，前景色:longLong，背景色:longLong；返回：longLong；可见性：default
            二维码_取位图(0, 1, 1)
            // 命令ID：二维码_自检
            // [11] 二维码_自检()
            // 功能：闭环自检：format 已知答案、M 级 v1-20 数据码字表核对、全部 160 组（版本×级别）RS 伴随式、多组「生成→渲染→识别」逐字节闭环与带损伤纠错。返回假时读 二维码_取错误()。
            // 参数：无；返回：bool；可见性：default
            二维码_自检()
            // 命令ID：二维码_释放
            // [12] 二维码_释放(码)
            // 功能：释放一个二维码句柄及其位图缓存；句柄无效返回假。
            // 参数：码:二维码句柄；返回：bool；可见性：default
            二维码_释放(0)
            // 命令ID：二维码_释放全部
            // [13] 二维码_释放全部()
            // 功能：释放当前进程内全部二维码句柄。
            // 参数：无；返回：void；可见性：default
            二维码_释放全部()
            // 命令ID：二维码_识别PNG
            // [14] 二维码_识别PNG(路径)
            // 功能：识别图片中的二维码；找不到定位图形或纠错失败返回 0，原因读 二维码_识别取错误()。
            // 参数：路径:wideString；返回：二维码识别结果；可见性：default
            二维码_识别PNG("module-demo-temp.txt")
            // 命令ID：二维码_识别位图
            // [15] 二维码_识别位图(位图句柄)
            // 功能：识别 Windows 位图中的二维码。
            // 参数：位图句柄:longLong；返回：二维码识别结果；可见性：default
            二维码_识别位图(1)
            // 命令ID：二维码_识别字节集
            // [16] 二维码_识别字节集(数据, 宽度, 高度, 通道数)
            // 功能：免落盘直解：把像素字节集当图像识别，长度必须等于 宽×高×通道数。
            // 参数：数据:bytes，宽度:int，高度:int，通道数:int；返回：二维码识别结果；可见性：default
            二维码_识别字节集({}, 1, 1, 1)
        如果结束
        调试输出("已查看 命令 1–16：二维码_取版本 至 二维码_识别字节集；勾选允许实际执行后会使用演示参数调用。")
    结束

    事件 _运行第02组_被单击()
        控件_设置文本(演示状态, "命令 17–31：二维码_识别屏幕 至 二维码_识别释放全部；源码内含完整签名、参数、返回值与调用。")
        如果 (控件_取勾选(允许实际执行))
            // 命令ID：二维码_识别屏幕
            // [17] 二维码_识别屏幕(横, 纵, 宽, 高)
            // 功能：抓取屏幕指定区域并识别其中的二维码；坐标按当前进程 DPI 意识解释。
            // 参数：横:int，纵:int，宽:int，高:int；返回：二维码识别结果；可见性：default
            二维码_识别屏幕(1, 1, 1, 1)
            // 命令ID：二维码_识别取文本
            // [18] 二维码_识别取文本(结果)
            // 功能：返回解码文本（字节模式按 UTF-8、汉字模式转 Unicode）；失败返回空文本。
            // 参数：结果:二维码识别结果；返回：wideString；可见性：default
            二维码_识别取文本(0)
            // 命令ID：二维码_识别取字节
            // [19] 二维码_识别取字节(结果)
            // 功能：返回负载原始字节（字节模式原样、数字/字母数字为 ASCII、汉字模式为 Shift_JIS 编码）。
            // 参数：结果:二维码识别结果；返回：bytes；可见性：default
            二维码_识别取字节(0)
            // 命令ID：二维码_识别取版本
            // [20] 二维码_识别取版本(结果)
            // 功能：返回识别出的 QR 版本号（1～40）。
            // 参数：结果:二维码识别结果；返回：int；可见性：default
            二维码_识别取版本(0)
            // 命令ID：二维码_识别取掩码
            // [21] 二维码_识别取掩码(结果)
            // 功能：返回 format 区恢复出的掩码号（0～7）。
            // 参数：结果:二维码识别结果；返回：int；可见性：default
            二维码_识别取掩码(0)
            // 命令ID：二维码_识别取纠错级别
            // [22] 二维码_识别取纠错级别(结果)
            // 功能：返回纠错级别 L/M/Q/H。
            // 参数：结果:二维码识别结果；返回：wideString；可见性：default
            二维码_识别取纠错级别(0)
            // 命令ID：二维码_识别取模式
            // [23] 二维码_识别取模式(结果)
            // 功能：返回首个数据段的编码模式：数字、字母数字、字节或汉字。
            // 参数：结果:二维码识别结果；返回：wideString；可见性：default
            二维码_识别取模式(0)
            // 命令ID：二维码_识别取修复码字数
            // [24] 二维码_识别取修复码字数(结果)
            // 功能：返回 RS 纠错实际修正的错误码字总数（0 表示无损伤）；如实上报，不做美化。
            // 参数：结果:二维码识别结果；返回：int；可见性：default
            二维码_识别取修复码字数(0)
            // 命令ID：二维码_识别取定位点数
            // [25] 二维码_识别取定位点数(结果)
            // 功能：返回图像中找到并通过交叉校验的定位图形个数（通常为 3）。
            // 参数：结果:二维码识别结果；返回：int；可见性：default
            二维码_识别取定位点数(0)
            // 命令ID：二维码_识别取角点横坐标
            // [26] 二维码_识别取角点横坐标(结果, 索引, 角点)
            // 功能：返回符号外接四边形某角点的横坐标（像素）；越界返回 -1。供调用方画框标注。
            // 参数：结果:二维码识别结果，索引:int，角点:int；返回：int；可见性：default
            二维码_识别取角点横坐标(0, 1, 1)
            // 命令ID：二维码_识别取角点纵坐标
            // [27] 二维码_识别取角点纵坐标(结果, 索引, 角点)
            // 功能：返回符号外接四边形某角点的纵坐标（像素）；越界返回 -1。
            // 参数：结果:二维码识别结果，索引:int，角点:int；返回：int；可见性：default
            二维码_识别取角点纵坐标(0, 1, 1)
            // 命令ID：二维码_识别取外接四边形
            // [28] 二维码_识别取外接四边形(结果, 索引)
            // 功能：一次性取回外接四边形：32 字节小端，4 角点依 左上/右上/右下/左下，每角点 2 个 int32（先 x 后 y）。
            // 参数：结果:二维码识别结果，索引:int；返回：bytes；可见性：default
            二维码_识别取外接四边形(0, 1)
            // 命令ID：二维码_识别取错误
            // [29] 二维码_识别取错误()
            // 功能：读取当前线程最近一次识别侧操作的中文错误。
            // 参数：无；返回：wideString；可见性：default
            二维码_识别取错误()
            // 命令ID：二维码_识别释放
            // [30] 二维码_识别释放(结果)
            // 功能：释放一个识别结果句柄；句柄无效返回假。
            // 参数：结果:二维码识别结果；返回：bool；可见性：default
            二维码_识别释放(0)
            // 命令ID：二维码_识别释放全部
            // [31] 二维码_识别释放全部()
            // 功能：释放当前进程内全部识别结果句柄。
            // 参数：无；返回：void；可见性：default
            二维码_识别释放全部()
        如果结束
        调试输出("已查看 命令 17–31：二维码_识别屏幕 至 二维码_识别释放全部；勾选允许实际执行后会使用演示参数调用。")
    结束

结束类
