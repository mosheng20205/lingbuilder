            // 命令ID：视频播放器_暂停
            // [620] 视频播放器_暂停(控件名)
            // 功能：暂停指定视频。
            // 参数：控件名:controlRef；返回：bool；可见性：default
            视频播放器_暂停(演示VideoPlayer控件)
            // 命令ID：视频播放器_停止
            // [621] 视频播放器_停止(控件名)
            // 功能：停止指定视频。
            // 参数：控件名:controlRef；返回：bool；可见性：default
            视频播放器_停止(演示VideoPlayer控件)
            // 命令ID：视频播放器_设置音量
            // [622] 视频播放器_设置音量(控件名, 音量)
            // 功能：设置视频音量，范围 0～100。
            // 参数：控件名:controlRef，音量:int；返回：bool；可见性：default
            视频播放器_设置音量(演示VideoPlayer控件, 1)
            // 命令ID：视频播放器_取状态
            // [623] 视频播放器_取状态(控件名)
            // 功能：返回 Media Foundation 播放器状态；未创建时返回 -1。
            // 参数：控件名:controlRef；返回：int；可见性：default
            视频播放器_取状态(演示VideoPlayer控件)
            // 命令ID：滑块_置刻度间隔
            // [624] 滑块_置刻度间隔(控件名, 刻度间隔)
            // 功能：运行期设置滑块的刻度间隔（每隔多少单位画一刻度）；小于 1 按 1 处理。
            // 参数：控件名:controlRef，刻度间隔:int；返回：bool；可见性：default
            滑块_置刻度间隔(演示状态, 1)
            // 命令ID：滑块_取刻度间隔
            // [625] 滑块_取刻度间隔(控件名)
            // 功能：返回滑块的刻度间隔（创建期属性或最近一次 置刻度间隔 的值）；Win32 没有刻度间隔读取消息，这里按设计器属性与运行期覆盖口径返回，控件不支持时返回 0。
            // 参数：控件名:controlRef；返回：int；可见性：default
            滑块_取刻度间隔(演示状态)
            // 命令ID：日期时间选择器_置日期
            // [626] 日期时间选择器_置日期(控件名, 日期文本)
            // 功能：运行期设置日期时间选择器的当前值：日期写 "yyyy-MM-dd"，time 格式控件写 "HH:mm" 或 "HH:mm:ss"；解析失败返回假。
            // 参数：控件名:controlRef，日期文本:wideString；返回：bool；可见性：default
            日期时间选择器_置日期(演示状态, "演示参数2")
            // 命令ID：日期时间选择器_取日期
            // [627] 日期时间选择器_取日期(控件名)
            // 功能：读取日期时间选择器当前值，返回 "yyyy-MM-dd HH:mm:ss" 文本；未设置时返回空文本。
            // 参数：控件名:controlRef；返回：wideString；可见性：default
            日期时间选择器_取日期(演示状态)
            // 命令ID：日期时间选择器_置显示格式
            // [628] 日期时间选择器_置显示格式(控件名, 格式文本)
            // 功能：运行期改写显示格式（DTM 格式串：yyyy 年、MM 月、dd 日、HH 时、mm 分、ss 秒，字面字符用单引号包裹）；传空文本恢复按控件格式属性的默认显示。
            // 参数：控件名:controlRef，格式文本:wideString；返回：bool；可见性：default
            日期时间选择器_置显示格式(演示状态, "演示参数2")
            // 命令ID：月历_置日期
            // [629] 月历_置日期(控件名, 日期文本)
            // 功能：运行期设置月历选中的日期（"yyyy-MM-dd"）；多选月历置为单日选区，普通月历直接选中；解析失败返回假。
            // 参数：控件名:controlRef，日期文本:wideString；返回：bool；可见性：default
            月历_置日期(演示状态, "演示参数2")
            // 命令ID：月历_取日期
            // [630] 月历_取日期(控件名)
            // 功能：读取月历当前选中日期，返回 "yyyy-MM-dd" 文本；多选月历返回选区起始日，未选中返回空文本。
            // 参数：控件名:controlRef；返回：wideString；可见性：default
            月历_取日期(演示状态)
            // 命令ID：月历_置选中范围
            // [631] 月历_置选中范围(控件名, 起始日期, 结束日期)
            // 功能：运行期设置月历的选中日期范围（"yyyy-MM-dd"，起止自动按先后排序）；仅多选月历生效，单选月历返回假。
            // 参数：控件名:controlRef，起始日期:wideString，结束日期:wideString；返回：bool；可见性：default
            月历_置选中范围(演示状态, "演示参数2", "演示参数3")
            // 命令ID：富文本框_置RTF文本
            // [632] 富文本框_置RTF文本(控件名, RTF文本)
            // 功能：把 RTF 格式化文本写入富文本框（EM_STREAMIN，与设计器「RTF 格式化文本」属性同一条流式链路）；传空文本清空内容。红线：RTF 含大量 \rtf1/\par 序列，禁止在 .lcpp 里手写 RTF 字面量（源码转义会把 \r 变回车），用 文件_读入文本 从 .rtf 文件读入后传入。
            // 参数：控件名:controlRef，RTF文本:wideString；返回：bool；可见性：default
            富文本框_置RTF文本(演示状态, "演示参数2")
            // 命令ID：富文本框_取RTF文本
            // [633] 富文本框_取RTF文本(控件名)
            // 功能：读取富文本框当前内容的 RTF 表示（EM_STREAMOUT，含颜色字体等格式信息）。
            // 参数：控件名:controlRef；返回：wideString；可见性：default
            富文本框_取RTF文本(演示状态)
        如果结束
        调试输出("已查看 命令 584–633：表格_设置排序 至 富文本框_取RTF文本；勾选允许实际执行后会使用演示参数调用。")
    结束

    事件 模块演示回调()
        调试输出("模块演示回调已触发。")
    结束

结束类
