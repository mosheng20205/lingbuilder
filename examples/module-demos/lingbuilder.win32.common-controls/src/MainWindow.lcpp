            // 参数：控件名:controlRef，隐藏:bool；返回：bool；可见性：default
            选项卡_设置隐藏表头(命令分组选项卡, 真)
            // 命令ID：选项卡_取隐藏表头
            // [208] 选项卡_取隐藏表头(控件名)
            // 功能：读取 TabControl 当前是否隐藏标签表头。
            // 参数：控件名:controlRef；返回：bool；可见性：default
            选项卡_取隐藏表头(命令分组选项卡)
            // 命令ID：文件对话框_打开
            // [209] 文件对话框_打开(组件名)
            // 功能：打开设计器中配置的非可视文件对话框，并保存选择结果。
            // 参数：组件名:controlRef；返回：bool；可见性：default
            文件对话框_打开(演示FileDialog资源)
        如果结束
        调试输出("已查看 命令 191–209：表格_设置列数值范围 至 文件对话框_打开；勾选允许实际执行后会使用演示参数调用。")
    结束

    事件 _运行第12组_被单击()
        控件_设置文本(演示状态, "命令 210–222：文件对话框_清空 至 视频播放器_取状态；源码内含完整签名、参数、返回值与调用。")
        如果 (控件_取勾选(允许实际执行))
            // 命令ID：文件对话框_清空
            // [210] 文件对话框_清空(组件名)
            // 功能：清空文件对话框组件最近选择或拖入的文件。
            // 参数：组件名:controlRef；返回：bool；可见性：default
            文件对话框_清空(演示FileDialog资源)
            // 命令ID：文件对话框_取文件数量
            // [211] 文件对话框_取文件数量(组件名)
            // 功能：返回文件对话框组件最近选择或拖入的文件数量。
            // 参数：组件名:controlRef；返回：int；可见性：default
            文件对话框_取文件数量(演示FileDialog资源)
            // 命令ID：文件对话框_取文件
            // [212] 文件对话框_取文件(组件名, 索引)
            // 功能：返回文件对话框组件指定索引的完整文件路径。
            // 参数：组件名:controlRef，索引:int；返回：wideString；可见性：default
            文件对话框_取文件(演示FileDialog资源, 1)
            // 命令ID：上下文菜单_显示
            // [213] 上下文菜单_显示(组件名)
            // 功能：在鼠标位置主动显示上下文菜单；绑定目标右键时无需手动调用。
            // 参数：组件名:controlRef；返回：bool；可见性：default
            上下文菜单_显示(演示ContextMenu资源)
            // 命令ID：弹出菜单_显示
            // [214] 弹出菜单_显示(组件名)
            // 功能：在当前鼠标位置显示弹出菜单。
            // 参数：组件名:controlRef；返回：bool；可见性：default
            弹出菜单_显示(演示PopupMenu资源)
            // 命令ID：弹出菜单_在坐标显示
            // [215] 弹出菜单_在坐标显示(组件名, 横坐标, 纵坐标)
            // 功能：在指定的屏幕像素坐标显示弹出菜单。
            // 参数：组件名:controlRef，横坐标:int，纵坐标:int；返回：bool；可见性：default
            弹出菜单_在坐标显示(演示PopupMenu资源, 1, 1)
            // 命令ID：菜单_取最后项目
            // [216] 菜单_取最后项目(组件名)
            // 功能：返回指定上下文菜单或弹出菜单最近选择的稳定菜单项 ID。
            // 参数：组件名:controlRef；返回：wideString；可见性：default
            菜单_取最后项目(演示ContextMenu资源)
            // 命令ID：视频播放器_设置文件
            // [217] 视频播放器_设置文件(控件名, 视频路径)
            // 功能：切换视频播放器的本地媒体文件；支持 MP4、WMV 等 Media Foundation 可解码格式。
            // 参数：控件名:controlRef，视频路径:wideString；返回：bool；可见性：default
            视频播放器_设置文件(演示VideoPlayer控件, "module-demo-temp.txt")
            // 命令ID：视频播放器_播放
            // [218] 视频播放器_播放(控件名)
            // 功能：播放或继续播放指定视频。
            // 参数：控件名:controlRef；返回：bool；可见性：default
            视频播放器_播放(演示VideoPlayer控件)
            // 命令ID：视频播放器_暂停
            // [219] 视频播放器_暂停(控件名)
            // 功能：暂停指定视频。
            // 参数：控件名:controlRef；返回：bool；可见性：default
            视频播放器_暂停(演示VideoPlayer控件)
            // 命令ID：视频播放器_停止
            // [220] 视频播放器_停止(控件名)
            // 功能：停止指定视频。
            // 参数：控件名:controlRef；返回：bool；可见性：default
            视频播放器_停止(演示VideoPlayer控件)
            // 命令ID：视频播放器_设置音量
            // [221] 视频播放器_设置音量(控件名, 音量)
            // 功能：设置视频音量，范围 0～100。
            // 参数：控件名:controlRef，音量:int；返回：bool；可见性：default
            视频播放器_设置音量(演示VideoPlayer控件, 1)
            // 命令ID：视频播放器_取状态
            // [222] 视频播放器_取状态(控件名)
            // 功能：返回 Media Foundation 播放器状态；未创建时返回 -1。
            // 参数：控件名:controlRef；返回：int；可见性：default
            视频播放器_取状态(演示VideoPlayer控件)
        如果结束
        调试输出("已查看 命令 210–222：文件对话框_清空 至 视频播放器_取状态；勾选允许实际执行后会使用演示参数调用。")
    结束

结束类
