包 Win32高级控件模块完整演示
使用 Win32窗口基础模块
使用 Win32高级控件模块

// 本项目由模块清单自动生成；每条 binding 命令都在下方具有真实调用语句。
// 为避免误删文件、启动进程、访问网络或操作设备，必须先勾选“允许实际执行”才会进入命令调用区。
类 MainWindow : 公开 窗口
    事件 _MainWindow_创建完毕()
        控件_设置选择项(命令分组选项卡, 0)
        控件_设置文本(演示状态, "Win32高级控件模块：222 条命令，默认处于安全预览模式。")
        调试输出("已加载模块演示：lingbuilder.win32.common-controls")
    结束

    事件 _运行第01组_被单击()
        控件_设置文本(演示状态, "命令 1–19：打开文件 至 查找替换_替换内容；源码内含完整签名、参数、返回值与调用。")
        如果 (控件_取勾选(允许实际执行))
            // 命令ID：打开文件
            // [1] 打开文件(标题, 筛选器)
            // 功能：显示 Windows 文件打开对话框并返回路径。
            // 参数：标题:wideString，筛选器:wideString；返回：wideString；可见性：default
            打开文件("演示参数1", "演示参数2")
            // 命令ID：保存文件
            // [2] 保存文件(标题, 筛选器)
            // 功能：显示 Windows 文件保存对话框并返回路径。
            // 参数：标题:wideString，筛选器:wideString；返回：wideString；可见性：default
            保存文件("演示参数1", "演示参数2")
            // 命令ID：选择文件夹
            // [3] 选择文件夹(标题)
            // 功能：显示 Windows 文件夹选择对话框并返回路径。
            // 参数：标题:wideString；返回：wideString；可见性：default
            选择文件夹("演示参数1")
            // 命令ID：选择颜色
            // [4] 选择颜色(默认颜色)
            // 功能：显示系统颜色对话框并返回 COLORREF 整数。
            // 参数：默认颜色:int；返回：int；可见性：default
            选择颜色(1)
            // 命令ID：颜色选择器_打开
            // [5] 颜色选择器_打开(控件名)
            // 功能：打开指定颜色选择器的系统选色窗口；控件设置为不可视时仍可由按钮或其他事件调用。
            // 参数：控件名:controlRef；返回：bool；可见性：default
            颜色选择器_打开(演示ColorPicker控件)
            // 命令ID：颜色选择器_置颜色
            // [6] 颜色选择器_置颜色(控件名, 颜色)
            // 功能：设置颜色选择器当前 COLORREF 颜色，并在颜色变化时触发事件。
            // 参数：控件名:controlRef，颜色:int；返回：bool；可见性：default
            颜色选择器_置颜色(演示ColorPicker控件, 1)
            // 命令ID：颜色选择器_取颜色
            // [7] 颜色选择器_取颜色(控件名)
            // 功能：返回颜色选择器当前 COLORREF 整数。
            // 参数：控件名:controlRef；返回：int；可见性：default
            颜色选择器_取颜色(演示ColorPicker控件)
            // 命令ID：选择字体
            // [8] 选择字体(默认字号)
            // 功能：显示系统字体对话框并返回字体说明。
            // 参数：默认字号:int；返回：wideString；可见性：default
            选择字体(1)
            // 命令ID：查找文本
            // [9] 查找文本(默认文本)
            // 功能：显示系统查找对话框。
            // 参数：默认文本:wideString；返回：void；可见性：default
            查找文本("演示参数1")
            // 命令ID：替换文本
            // [10] 替换文本(查找内容, 替换内容)
            // 功能：显示系统替换对话框。
            // 参数：查找内容:wideString，替换内容:wideString；返回：void；可见性：default
            替换文本("演示参数1", "演示参数2")
            // 命令ID：打印
            // [11] 打印()
            // 功能：显示系统打印对话框。
            // 参数：无；返回：bool；可见性：default
            打印()
            // 命令ID：页面设置
            // [12] 页面设置()
            // 功能：显示系统页面设置对话框。
            // 参数：无；返回：bool；可见性：default
            页面设置()
            // 命令ID：任务对话框
            // [13] 任务对话框(标题, 内容)
            // 功能：显示 Windows Task Dialog。
            // 参数：标题:wideString，内容:wideString；返回：int；可见性：default
            任务对话框("演示参数1", "演示参数2")
            // 命令ID：系统对话框_状态
            // [14] 系统对话框_状态()
            // 功能：返回最近文件或目录对话框状态：1 成功、0 取消、-1 错误。
            // 参数：无；返回：int；可见性：default
            系统对话框_状态()
            // 命令ID：工具栏_最后命令
            // [15] 工具栏_最后命令()
            // 功能：返回最近点击的工具栏按钮命令 ID。
            // 参数：无；返回：int；可见性：default
            工具栏_最后命令()
            // 命令ID：状态栏_最后分区
            // [16] 状态栏_最后分区()
            // 功能：返回最近双击的状态栏分区索引。
            // 参数：无；返回：int；可见性：default
            状态栏_最后分区()
            // 命令ID：查找替换_动作
            // [17] 查找替换_动作()
            // 功能：返回最近查找替换动作。
            // 参数：无；返回：wideString；可见性：default
            查找替换_动作()
            // 命令ID：查找替换_查找内容
            // [18] 查找替换_查找内容()
            // 功能：返回查找替换对话框中的查找文本。
            // 参数：无；返回：wideString；可见性：default
            查找替换_查找内容()
            // 命令ID：查找替换_替换内容
            // [19] 查找替换_替换内容()
            // 功能：返回查找替换对话框中的替换文本。
            // 参数：无；返回：wideString；可见性：default
            查找替换_替换内容()
        如果结束
        调试输出("已查看 命令 1–19：打开文件 至 查找替换_替换内容；勾选允许实际执行后会使用演示参数调用。")
    结束

    事件 _运行第02组_被单击()
        控件_设置文本(演示状态, "命令 20–38：打印文本 至 列表视图_取最后单击列；源码内含完整签名、参数、返回值与调用。")
        如果 (控件_取勾选(允许实际执行))
            // 命令ID：打印文本
            // [20] 打印文本(文档名, 文本)
            // 功能：选择打印机并把指定文本作为真实打印文档输出。
            // 参数：文档名:wideString，文本:wideString；返回：bool；可见性：default
            打印文本("演示参数1", "演示参数2")
            // 命令ID：页面设置_左边距
            // [21] 页面设置_左边距()
            // 功能：返回最近页面设置的左边距。
            // 参数：无；返回：int；可见性：default
            页面设置_左边距()
            // 命令ID：页面设置_上边距
            // [22] 页面设置_上边距()
            // 功能：返回最近页面设置的上边距。
            // 参数：无；返回：int；可见性：default
            页面设置_上边距()
            // 命令ID：页面设置_右边距
            // [23] 页面设置_右边距()
            // 功能：返回最近页面设置的右边距。
            // 参数：无；返回：int；可见性：default
            页面设置_右边距()
            // 命令ID：页面设置_下边距
            // [24] 页面设置_下边距()
            // 功能：返回最近页面设置的下边距。
            // 参数：无；返回：int；可见性：default
            页面设置_下边距()
            // 命令ID：属性页_显示
            // [25] 属性页_显示(属性页)
            // 功能：显示设计器资源中定义的顶层 Windows PropertySheet。
            // 参数：属性页:controlRef；返回：int；可见性：default
            属性页_显示(演示PropertySheet资源)
            // 命令ID：列表视图_创建行
            // [26] 列表视图_创建行(单元格...)
            // 功能：按参数顺序创建类型化列表视图行；文本、整数、小数和逻辑值会确定性转换为单元格文本。
            // 参数：单元格:raw；返回：raw；可见性：default
            列表视图_创建行(0)
            // 命令ID：列表视图_创建行集合
            // [27] 列表视图_创建行集合(行...)
            // 功能：把一个或多个列表视图行组成可批量提交的类型化行集合。
            // 参数：行:raw；返回：raw；可见性：default
            列表视图_创建行集合(0)
            // 命令ID：列表视图_添加行
            // [28] 列表视图_添加行(控件名, 列表视图行)
            // 功能：向 ListView 追加类型化单元格数组；继续兼容旧式 Tab 分隔文本。
            // 参数：控件名:controlRef，行数据:raw；返回：int；可见性：default
            列表视图_添加行(演示ListView控件, 0)
            // 命令ID：列表视图_插入行
            // [29] 列表视图_插入行(控件名, 行索引, 列表视图行)
            // 功能：在指定的零基行索引插入类型化单元格数组；继续兼容旧式 Tab 分隔文本。
            // 参数：控件名:controlRef，行索引:int，行数据:raw；返回：int；可见性：default
            列表视图_插入行(演示ListView控件, 1, 0)
            // 命令ID：列表视图_删除行
            // [30] 列表视图_删除行(控件名, 行索引)
            // 功能：删除指定的零基行索引。
            // 参数：控件名:controlRef，行索引:int；返回：bool；可见性：default
            列表视图_删除行(演示ListView控件, 1)
            // 命令ID：列表视图_设置单元格
            // [31] 列表视图_设置单元格(控件名, 行索引, 列索引, 文本)
            // 功能：修改指定零基行、列索引的单元格。
            // 参数：控件名:controlRef，行索引:int，列索引:int，文本:wideString；返回：bool；可见性：default
            列表视图_设置单元格(演示ListView控件, 1, 1, "演示参数4")
            // 命令ID：列表视图_取单元格
            // [32] 列表视图_取单元格(控件名, 行索引, 列索引)
            // 功能：读取指定零基行、列索引的单元格文本。
            // 参数：控件名:controlRef，行索引:int，列索引:int；返回：wideString；可见性：default
            列表视图_取单元格(演示ListView控件, 1, 1)
            // 命令ID：列表视图_取行数
            // [33] 列表视图_取行数(控件名)
            // 功能：返回列表视图当前数据行数。
            // 参数：控件名:controlRef；返回：int；可见性：default
            列表视图_取行数(演示ListView控件)
            // 命令ID：列表视图_批量添加行
            // [34] 列表视图_批量添加行(控件名, 列表视图行集合)
            // 功能：一次追加类型化行集合，内部自动关闭并恢复重绘；继续兼容旧式多行 TSV 文本。
            // 参数：控件名:controlRef，行集合:raw；返回：int；可见性：default
            列表视图_批量添加行(演示ListView控件, 0)
            // 命令ID：列表视图_开始批量更新
            // [35] 列表视图_开始批量更新(控件名)
            // 功能：暂停 ListView 重绘；必须与结束批量更新成对调用。
            // 参数：控件名:controlRef；返回：bool；可见性：default
            列表视图_开始批量更新(演示ListView控件)
            // 命令ID：列表视图_结束批量更新
            // [36] 列表视图_结束批量更新(控件名)
            // 功能：结束一层批量更新，并在最外层结束时恢复重绘。
            // 参数：控件名:controlRef；返回：bool；可见性：default
            列表视图_结束批量更新(演示ListView控件)
            // 命令ID：列表视图_排序
            // [37] 列表视图_排序(控件名, 列索引, 升序)
            // 功能：按指定列文本稳定排序，列索引从 0 开始。
            // 参数：控件名:controlRef，列索引:int，升序:bool；返回：bool；可见性：default
            列表视图_排序(演示ListView控件, 1, 真)
            // 命令ID：列表视图_取最后单击列
            // [38] 列表视图_取最后单击列(控件名)
            // 功能：返回最近一次表头单击的零基列索引；尚未单击时返回 -1。
            // 参数：控件名:controlRef；返回：int；可见性：default
            列表视图_取最后单击列(演示ListView控件)
        如果结束
        调试输出("已查看 命令 20–38：打印文本 至 列表视图_取最后单击列；勾选允许实际执行后会使用演示参数调用。")
    结束

    事件 _运行第03组_被单击()
        控件_设置文本(演示状态, "命令 39–57：列表视图_取虚拟模式 至 列表视图_设置行图像；源码内含完整签名、参数、返回值与调用。")
        如果 (控件_取勾选(允许实际执行))
            // 命令ID：列表视图_取虚拟模式
            // [39] 列表视图_取虚拟模式(控件名)
            // 功能：返回控件是否以 Win32 LVS_OWNERDATA 虚拟模式创建。
            // 参数：控件名:controlRef；返回：bool；可见性：default
            列表视图_取虚拟模式(演示ListView控件)
            // 命令ID：列表视图_设置虚拟行数
            // [40] 列表视图_设置虚拟行数(控件名, 行数)
            // 功能：设置虚拟 ListView 的总行数；设计器必须先开启虚拟列表模式。
            // 参数：控件名:controlRef，行数:int；返回：bool；可见性：default
            列表视图_设置虚拟行数(演示ListView控件, 1)
            // 命令ID：列表视图_设置虚拟行
            // [41] 列表视图_设置虚拟行(控件名, 行索引, 列表视图行)
            // 功能：用类型化单元格数组设置虚拟 ListView 指定行，不创建真实行项目；继续兼容旧式 Tab 分隔文本。
            // 参数：控件名:controlRef，行索引:int，行数据:raw；返回：bool；可见性：default
            列表视图_设置虚拟行(演示ListView控件, 1, 0)
            // 命令ID：列表视图_添加列
            // [42] 列表视图_添加列(控件名, 标题, 宽度, 对齐)
            // 功能：在末尾添加详细信息视图列。对齐为 left/center/right。
            // 参数：控件名:controlRef，标题:wideString，宽度:int，对齐:wideString；返回：int；可见性：default
            列表视图_添加列(演示ListView控件, "演示参数2", 1, "演示参数4")
            // 命令ID：列表视图_插入列
            // [43] 列表视图_插入列(控件名, 列索引, 标题, 宽度, 对齐)
            // 功能：在指定零基索引插入列。
            // 参数：控件名:controlRef，列索引:int，标题:wideString，宽度:int，对齐:wideString；返回：int；可见性：default
            列表视图_插入列(演示ListView控件, 1, "演示参数3", 1, "演示参数5")
            // 命令ID：列表视图_删除列
            // [44] 列表视图_删除列(控件名, 列索引)
            // 功能：删除指定列并同步虚拟行数据。
            // 参数：控件名:controlRef，列索引:int；返回：bool；可见性：default
            列表视图_删除列(演示ListView控件, 1)
            // 命令ID：列表视图_设置列标题
            // [45] 列表视图_设置列标题(控件名, 列索引, 标题)
            // 功能：修改列标题。
            // 参数：控件名:controlRef，列索引:int，标题:wideString；返回：bool；可见性：default
            列表视图_设置列标题(演示ListView控件, 1, "演示参数3")
            // 命令ID：列表视图_取列标题
            // [46] 列表视图_取列标题(控件名, 列索引)
            // 功能：读取列标题。
            // 参数：控件名:controlRef，列索引:int；返回：wideString；可见性：default
            列表视图_取列标题(演示ListView控件, 1)
            // 命令ID：列表视图_设置列宽
            // [47] 列表视图_设置列宽(控件名, 列索引, 宽度)
            // 功能：设置列宽；-1/-2 对应自动宽度。
            // 参数：控件名:controlRef，列索引:int，宽度:int；返回：bool；可见性：default
            列表视图_设置列宽(演示ListView控件, 1, 1)
            // 命令ID：列表视图_取列宽
            // [48] 列表视图_取列宽(控件名, 列索引)
            // 功能：读取列宽。
            // 参数：控件名:controlRef，列索引:int；返回：int；可见性：default
            列表视图_取列宽(演示ListView控件, 1)
            // 命令ID：列表视图_取列数
            // [49] 列表视图_取列数(控件名)
            // 功能：读取表头列数。
            // 参数：控件名:controlRef；返回：int；可见性：default
            列表视图_取列数(演示ListView控件)
            // 命令ID：列表视图_设置行选中
            // [50] 列表视图_设置行选中(控件名, 行索引, 选中)
            // 功能：设置行选择状态和焦点。
            // 参数：控件名:controlRef，行索引:int，选中:bool；返回：bool；可见性：default
            列表视图_设置行选中(演示ListView控件, 1, 真)
            // 命令ID：列表视图_取选中行数
            // [51] 列表视图_取选中行数(控件名)
            // 功能：读取当前选中行数量。
            // 参数：控件名:controlRef；返回：int；可见性：default
            列表视图_取选中行数(演示ListView控件)
            // 命令ID：列表视图_取下一个选中行
            // [52] 列表视图_取下一个选中行(控件名, 起始行)
            // 功能：从起始行之后查找下一个选中行。
            // 参数：控件名:controlRef，起始行:int；返回：int；可见性：default
            列表视图_取下一个选中行(演示ListView控件, 1)
            // 命令ID：列表视图_设置行勾选
            // [53] 列表视图_设置行勾选(控件名, 行索引, 勾选)
            // 功能：启用复选框后设置行勾选状态。
            // 参数：控件名:controlRef，行索引:int，勾选:bool；返回：bool；可见性：default
            列表视图_设置行勾选(演示ListView控件, 1, 真)
            // 命令ID：列表视图_取行勾选
            // [54] 列表视图_取行勾选(控件名, 行索引)
