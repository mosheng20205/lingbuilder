包 Excel表格模块完整演示
使用 Win32窗口基础模块
使用 Excel表格模块

// 本项目由模块清单自动生成；每条 binding 命令都在下方具有真实调用语句。
// 为避免误删文件、启动进程、访问网络或操作设备，必须先勾选“允许实际执行”才会进入命令调用区。
类 MainWindow : 公开 窗口
    事件 _MainWindow_创建完毕()
        控件_设置选择项(命令分组选项卡, 0)
        控件_设置文本(演示状态, "Excel 表格模块：45 条命令，默认处于安全预览模式。")
        调试输出("已加载模块演示：lingbuilder.data.excel")
    结束

    事件 _运行第01组_被单击()
        控件_设置文本(演示状态, "命令 1–15：Excel_创建工作簿 至 Excel_写公式；源码内含完整签名、参数、返回值与调用。")
        如果 (控件_取勾选(允许实际执行))
            // 命令ID：Excel_创建工作簿
            // [1] Excel_创建工作簿(文件路径)
            // 功能：新建一个仅存在于内存的 .xlsx 工作簿（默认含 Sheet1），全部格式能力可用；调用 Excel_保存 才写出文件。
            // 参数：文件路径:wideString；返回：Excel工作簿；可见性：default
            Excel_创建工作簿("module-demo-temp.txt")
            // 命令ID：Excel_打开工作簿
            // [2] Excel_打开工作簿(文件路径)
            // 功能：打开既有 .xlsx 工作簿；修改后保存会保真保留原有样式、列宽和公式结构。打开模式不支持格式与结构类命令。
            // 参数：文件路径:wideString；返回：Excel工作簿；可见性：default
            Excel_打开工作簿("module-demo-temp.txt")
            // 命令ID：Excel_保存
            // [3] Excel_保存(工作簿)
            // 功能：把工作簿写出当前文件；创建模式可反复修改后再次保存，打开模式原地写回。
            // 参数：工作簿:Excel工作簿；返回：bool；可见性：default
            Excel_保存(0)
            // 命令ID：Excel_另存为
            // [4] Excel_另存为(工作簿, 文件路径)
            // 功能：把工作簿写出到新路径，之后的 Excel_保存 也会写向新路径。
            // 参数：工作簿:Excel工作簿，文件路径:wideString；返回：bool；可见性：default
            Excel_另存为(0, "module-demo-temp.txt")
            // 命令ID：Excel_关闭
            // [5] Excel_关闭(工作簿)
            // 功能：关闭并释放工作簿；未保存的修改会丢失。失效句柄返回假。
            // 参数：工作簿:Excel工作簿；返回：bool；可见性：default
            Excel_关闭(0)
            // 命令ID：Excel_取工作表数量
            // [6] Excel_取工作表数量(工作簿)
            // 功能：返回工作簿内工作表数量。
            // 参数：工作簿:Excel工作簿；返回：int；可见性：default
            Excel_取工作表数量(0)
            // 命令ID：Excel_取工作表名
            // [7] Excel_取工作表名(工作簿, 序号)
            // 功能：返回指定序号的工作表名称；越界返回空文本并记录错误。
            // 参数：工作簿:Excel工作簿，序号:int；返回：wideString；可见性：default
            Excel_取工作表名(0, 1)
            // 命令ID：Excel_取当前工作表
            // [8] Excel_取当前工作表(工作簿)
            // 功能：返回当前读写操作所用的工作表名称。
            // 参数：工作簿:Excel工作簿；返回：wideString；可见性：default
            Excel_取当前工作表(0)
            // 命令ID：Excel_置当前工作表
            // [9] Excel_置当前工作表(工作簿, 名称)
            // 功能：切换当前读写操作所用的工作表；找不到同名工作表返回假。
            // 参数：工作簿:Excel工作簿，名称:wideString；返回：bool；可见性：default
            Excel_置当前工作表(0, "演示参数2")
            // 命令ID：Excel_添加工作表
            // [10] Excel_添加工作表(工作簿, 名称)
            // 功能：在工作簿末尾追加一个空工作表。
            // 参数：工作簿:Excel工作簿，名称:wideString；返回：bool；可见性：default
            Excel_添加工作表(0, "演示参数2")
            // 命令ID：Excel_删除工作表
            // [11] Excel_删除工作表(工作簿, 名称)
            // 功能：删除指定工作表；工作簿至少保留一个工作表。
            // 参数：工作簿:Excel工作簿，名称:wideString；返回：bool；可见性：default
            Excel_删除工作表(0, "演示参数2")
            // 命令ID：Excel_写文本
            // [12] Excel_写文本(工作簿, 单元格, 内容)
            // 功能：把文本写入单元格。
            // 参数：工作簿:Excel工作簿，单元格:wideString，内容:wideString；返回：bool；可见性：default
            Excel_写文本(0, "演示参数2", "演示参数3")
            // 命令ID：Excel_写数值
            // [13] Excel_写数值(工作簿, 单元格, 数值)
            // 功能：把数值写入单元格。
            // 参数：工作簿:Excel工作簿，单元格:wideString，数值:double；返回：bool；可见性：default
            Excel_写数值(0, "演示参数2", 1.0)
            // 命令ID：Excel_写布尔
            // [14] Excel_写布尔(工作簿, 单元格, 值)
            // 功能：把布尔值写入单元格。
            // 参数：工作簿:Excel工作簿，单元格:wideString，值:bool；返回：bool；可见性：default
            Excel_写布尔(0, "演示参数2", 真)
            // 命令ID：Excel_写公式
            // [15] Excel_写公式(工作簿, 单元格, 公式)
            // 功能：写入公式；Excel/WPS 打开文件时自动计算。创建模式公式没有缓存值。
            // 参数：工作簿:Excel工作簿，单元格:wideString，公式:wideString；返回：bool；可见性：default
            Excel_写公式(0, "演示参数2", "演示参数3")
        如果结束
        调试输出("已查看 命令 1–15：Excel_创建工作簿 至 Excel_写公式；勾选允许实际执行后会使用演示参数调用。")
    结束

    事件 _运行第02组_被单击()
        控件_设置文本(演示状态, "命令 16–30：Excel_写日期 至 Excel_冻结窗格；源码内含完整签名、参数、返回值与调用。")
        如果 (控件_取勾选(允许实际执行))
            // 命令ID：Excel_写日期
            // [16] Excel_写日期(工作簿, 单元格, 日期时间)
            // 功能：把日期时间写入单元格：自动换算为日期序列值；创建模式会同时套用日期显示格式，打开模式只写序列值。
            // 参数：工作簿:Excel工作簿，单元格:wideString，日期时间:wideString；返回：bool；可见性：default
            Excel_写日期(0, "演示参数2", "演示参数3")
            // 命令ID：Excel_清除单元格
            // [17] Excel_清除单元格(工作簿, 单元格)
            // 功能：清空单元格内容和格式。
            // 参数：工作簿:Excel工作簿，单元格:wideString；返回：bool；可见性：default
            Excel_清除单元格(0, "演示参数2")
            // 命令ID：Excel_读单元格文本
            // [18] Excel_读单元格文本(工作簿, 单元格)
            // 功能：读取单元格文本表示；数值、布尔与公式缓存值都会转成文本，空单元格返回空文本。
            // 参数：工作簿:Excel工作簿，单元格:wideString；返回：wideString；可见性：default
            Excel_读单元格文本(0, "演示参数2")
            // 命令ID：Excel_读单元格数值
            // [19] Excel_读单元格数值(工作簿, 单元格)
            // 功能：读取单元格数值；内容不是数值时返回 0 并记录错误。
            // 参数：工作簿:Excel工作簿，单元格:wideString；返回：double；可见性：default
            Excel_读单元格数值(0, "演示参数2")
            // 命令ID：Excel_读单元格公式
            // [20] Excel_读单元格公式(工作簿, 单元格)
            // 功能：读取公式内容（不带等号）；不是公式单元格时返回空文本并记录错误。
            // 参数：工作簿:Excel工作簿，单元格:wideString；返回：wideString；可见性：default
            Excel_读单元格公式(0, "演示参数2")
            // 命令ID：Excel_取单元格类型
            // [21] Excel_取单元格类型(工作簿, 单元格)
            // 功能：返回单元格类型：0=空，1=文本，2=数值，3=布尔，4=公式。
            // 参数：工作簿:Excel工作簿，单元格:wideString；返回：int；可见性：default
            Excel_取单元格类型(0, "演示参数2")
            // 命令ID：Excel_是否为空单元格
            // [22] Excel_是否为空单元格(工作簿, 单元格)
            // 功能：判断单元格是否为空。
            // 参数：工作簿:Excel工作簿，单元格:wideString；返回：bool；可见性：default
            Excel_是否为空单元格(0, "演示参数2")
            // 命令ID：Excel_写一行
            // [23] Excel_写一行(工作簿, 起始单元格, 行内容, 分隔符)
            // 功能：从起始单元格开始横向写入一整行；纯数字片段自动写成数值，空片段跳过不写。
            // 参数：工作簿:Excel工作簿，起始单元格:wideString，行内容:wideString，分隔符:wideString；返回：bool；可见性：default
            Excel_写一行(0, "演示参数2", "演示参数3", "演示参数4")
            // 命令ID：Excel_追加行
            // [24] Excel_追加行(工作簿, 行内容, 分隔符)
            // 功能：在当前工作表最后一个非空行的下一行追加数据；返回写入的行号（从 1 开始），失败返回 -1。
            // 参数：工作簿:Excel工作簿，行内容:wideString，分隔符:wideString；返回：int；可见性：default
            Excel_追加行(0, "演示参数2", "演示参数3")
            // 命令ID：Excel_读区域
            // [25] Excel_读区域(工作簿, 范围, 分隔符)
            // 功能：读取一个矩形区域：行之间用换行分隔、单元格之间用指定分隔符拼接；可直接逐行解析或配合 CSV/JSON 模块加工。
            // 参数：工作簿:Excel工作簿，范围:wideString，分隔符:wideString；返回：wideString；可见性：default
            Excel_读区域(0, "演示参数2", "演示参数3")
            // 命令ID：Excel_取已用范围
            // [26] Excel_取已用范围(工作簿)
            // 功能：返回当前工作表已使用区域，例如 "A1:F20"；空表返回空文本。
            // 参数：工作簿:Excel工作簿；返回：wideString；可见性：default
            Excel_取已用范围(0)
            // 命令ID：Excel_置列宽
            // [27] Excel_置列宽(工作簿, 列标, 宽度)
            // 功能：设置当前工作表列宽。
            // 参数：工作簿:Excel工作簿，列标:wideString，宽度:double；返回：bool；可见性：default
            Excel_置列宽(0, "演示参数2", 1.0)
            // 命令ID：Excel_置行高
            // [28] Excel_置行高(工作簿, 行号, 高度)
            // 功能：设置当前工作表行高。
            // 参数：工作簿:Excel工作簿，行号:int，高度:double；返回：bool；可见性：default
            Excel_置行高(0, 1, 1.0)
            // 命令ID：Excel_合并单元格
            // [29] Excel_合并单元格(工作簿, 范围)
            // 功能：合并一个矩形区域；左上角单元格的值作为合并后内容。
            // 参数：工作簿:Excel工作簿，范围:wideString；返回：bool；可见性：default
            Excel_合并单元格(0, "演示参数2")
            // 命令ID：Excel_冻结窗格
            // [30] Excel_冻结窗格(工作簿, 行数, 列数)
            // 功能：冻结当前工作表首部行与左侧列，滚动时保持表头可见。
            // 参数：工作簿:Excel工作簿，行数:int，列数:int；返回：bool；可见性：default
            Excel_冻结窗格(0, 1, 1)
        如果结束
        调试输出("已查看 命令 16–30：Excel_写日期 至 Excel_冻结窗格；勾选允许实际执行后会使用演示参数调用。")
    结束

    事件 _运行第03组_被单击()
        控件_设置文本(演示状态, "命令 31–45：Excel_置数字格式 至 Excel_是否可用；源码内含完整签名、参数、返回值与调用。")
        如果 (控件_取勾选(允许实际执行))
            // 命令ID：Excel_置数字格式
            // [31] Excel_置数字格式(工作簿, 单元格, 格式索引)
            // 功能：设置单元格数字显示格式。
            // 参数：工作簿:Excel工作簿，单元格:wideString，格式索引:int；返回：bool；可见性：default
            Excel_置数字格式(0, "演示参数2", 1)
            // 命令ID：Excel_置加粗
            // [32] Excel_置加粗(工作簿, 单元格, 启用)
            // 功能：设置单元格字体加粗。
            // 参数：工作簿:Excel工作簿，单元格:wideString，启用:bool；返回：bool；可见性：default
            Excel_置加粗(0, "演示参数2", 真)
            // 命令ID：Excel_置字号
            // [33] Excel_置字号(工作簿, 单元格, 字号)
            // 功能：设置单元格字号。
            // 参数：工作簿:Excel工作簿，单元格:wideString，字号:double；返回：bool；可见性：default
            Excel_置字号(0, "演示参数2", 1.0)
            // 命令ID：Excel_置字体颜色
            // [34] Excel_置字体颜色(工作簿, 单元格, 颜色值)
            // 功能：设置单元格字体颜色。
            // 参数：工作簿:Excel工作簿，单元格:wideString，颜色值:int；返回：bool；可见性：default
            Excel_置字体颜色(0, "演示参数2", 1)
            // 命令ID：Excel_置背景色
            // [35] Excel_置背景色(工作簿, 单元格, 颜色值)
            // 功能：设置单元格背景填充色。
            // 参数：工作簿:Excel工作簿，单元格:wideString，颜色值:int；返回：bool；可见性：default
            Excel_置背景色(0, "演示参数2", 1)
            // 命令ID：Excel_置水平对齐
            // [36] Excel_置水平对齐(工作簿, 单元格, 对齐方式)
            // 功能：设置单元格水平对齐方式。
            // 参数：工作簿:Excel工作簿，单元格:wideString，对齐方式:int；返回：bool；可见性：default
            Excel_置水平对齐(0, "演示参数2", 1)
            // 命令ID：Excel_插入行
            // [37] Excel_插入行(工作簿, 行号, 数量)
            // 功能：在指定行前插入空行，已有内容整体下移。
            // 参数：工作簿:Excel工作簿，行号:int，数量:int；返回：bool；可见性：default
            Excel_插入行(0, 1, 1)
            // 命令ID：Excel_删除行
            // [38] Excel_删除行(工作簿, 行号, 数量)
            // 功能：删除指定起点的若干行，后续内容上移补位。
            // 参数：工作簿:Excel工作簿，行号:int，数量:int；返回：bool；可见性：default
            Excel_删除行(0, 1, 1)
            // 命令ID：Excel_插入列
            // [39] Excel_插入列(工作簿, 列号, 数量)
            // 功能：在指定列前插入空列，已有内容整体右移。
            // 参数：工作簿:Excel工作簿，列号:int，数量:int；返回：bool；可见性：default
            Excel_插入列(0, 1, 1)
            // 命令ID：Excel_删除列
            // [40] Excel_删除列(工作簿, 列号, 数量)
            // 功能：删除指定起点的若干列，后续内容左移补位。
            // 参数：工作簿:Excel工作簿，列号:int，数量:int；返回：bool；可见性：default
            Excel_删除列(0, 1, 1)
            // 命令ID：Excel_日期转序列
            // [41] Excel_日期转序列(日期时间)
            // 功能：把日期时间换算为 Excel 序列值；格式无效返回 -1。1900-03-01 之前的日期与 Excel 相差 1（Excel 1900 年闰年历史缺陷）。
            // 参数：日期时间:wideString；返回：double；可见性：default
            Excel_日期转序列("演示参数1")
            // 命令ID：Excel_序列转日期
            // [42] Excel_序列转日期(序列值)
            // 功能：把 Excel 序列值换算为 "YYYY-MM-DD[ HH:MM:SS]" 文本；超出范围返回空文本。
            // 参数：序列值:double；返回：wideString；可见性：default
            Excel_序列转日期(1.0)
            // 命令ID：Excel_取错误
            // [43] Excel_取错误()
            // 功能：返回当前线程最近一次 Excel 模块错误的中文说明。
            // 参数：无；返回：wideString；可见性：default
            Excel_取错误()
            // 命令ID：Excel_取版本
            // [44] Excel_取版本()
            // 功能：返回随附运行桥版本与内置库信息。
            // 参数：无；返回：wideString；可见性：default
            Excel_取版本()
            // 命令ID：Excel_是否可用
            // [45] Excel_是否可用()
            // 功能：检查随附运行桥 LingBuilderExcel.dll 是否可以加载且全部导出可用。
            // 参数：无；返回：bool；可见性：default
            Excel_是否可用()
        如果结束
        调试输出("已查看 命令 31–45：Excel_置数字格式 至 Excel_是否可用；勾选允许实际执行后会使用演示参数调用。")
    结束

结束类
