包 磁盘信息模块完整演示
使用 Win32窗口基础模块
使用 磁盘信息模块

// 本项目由模块清单自动生成；每条 binding 命令都在下方具有真实调用语句。
// 为避免误删文件、启动进程、访问网络或操作设备，必须先勾选“允许实际执行”才会进入命令调用区。
类 MainWindow : 公开 窗口
    事件 _MainWindow_创建完毕()
        控件_设置选择项(命令分组选项卡, 0)
        控件_设置文本(演示状态, "磁盘信息模块：28 条命令，默认处于安全预览模式。")
        调试输出("已加载模块演示：lingbuilder.system.disk")
    结束

    事件 _运行第01组_被单击()
        控件_设置文本(演示状态, "命令 1–14：磁盘_总容量MB 至 磁盘_枚举全部卷；源码内含完整签名、参数、返回值与调用。")
        如果 (控件_取勾选(允许实际执行))
            // 命令ID：磁盘_总容量MB
            // [1] 磁盘_总容量MB(路径)
            // 功能：返回路径所在卷的总容量 MB，失败返回 -1；兼容旧源码。
            // 参数：路径:wideString；返回：longLong；可见性：default
            磁盘_总容量MB("module-demo-temp.txt")
            // 命令ID：磁盘_可用容量MB
            // [2] 磁盘_可用容量MB(路径)
            // 功能：返回当前用户配额下可用容量 MB，失败返回 -1；兼容旧源码。
            // 参数：路径:wideString；返回：longLong；可见性：default
            磁盘_可用容量MB("module-demo-temp.txt")
            // 命令ID：磁盘_取卷标
            // [3] 磁盘_取卷标(根路径)
            // 功能：返回卷标，失败返回空文本。
            // 参数：根路径:wideString；返回：wideString；可见性：default
            磁盘_取卷标("module-demo-temp.txt")
            // 命令ID：磁盘_取文件系统
            // [4] 磁盘_取文件系统(根路径)
            // 功能：返回 NTFS、ReFS、FAT32 等文件系统名称。
            // 参数：根路径:wideString；返回：wideString；可见性：default
            磁盘_取文件系统("module-demo-temp.txt")
            // 命令ID：磁盘_取驱动器类型
            // [5] 磁盘_取驱动器类型(根路径)
            // 功能：返回 Win32 DRIVE_* 类型编号。
            // 参数：根路径:wideString；返回：int；可见性：default
            磁盘_取驱动器类型("module-demo-temp.txt")
            // 命令ID：磁盘_取总容量字节
            // [6] 磁盘_取总容量字节(路径)
            // 功能：返回路径所在卷的精确总容量字节数，失败返回 -1。
            // 参数：路径:wideString；返回：longLong；可见性：default
            磁盘_取总容量字节("module-demo-temp.txt")
            // 命令ID：磁盘_取用户可用字节
            // [7] 磁盘_取用户可用字节(路径)
            // 功能：返回当前用户配额下可用的精确字节数，失败返回 -1。
            // 参数：路径:wideString；返回：longLong；可见性：default
            磁盘_取用户可用字节("module-demo-temp.txt")
            // 命令ID：磁盘_取总空闲字节
            // [8] 磁盘_取总空闲字节(路径)
            // 功能：返回卷上所有用户合计可见的空闲字节数，失败返回 -1。
            // 参数：路径:wideString；返回：longLong；可见性：default
            磁盘_取总空闲字节("module-demo-temp.txt")
            // 命令ID：磁盘_取已用容量字节
            // [9] 磁盘_取已用容量字节(路径)
            // 功能：返回总容量减去总空闲容量的字节数，失败返回 -1。
            // 参数：路径:wideString；返回：longLong；可见性：default
            磁盘_取已用容量字节("module-demo-temp.txt")
            // 命令ID：磁盘_取使用率
            // [10] 磁盘_取使用率(路径)
            // 功能：返回卷使用率百分比，失败返回 -1。
            // 参数：路径:wideString；返回：double；可见性：default
            磁盘_取使用率("module-demo-temp.txt")
            // 命令ID：磁盘_取容量信息
            // [11] 磁盘_取容量信息(路径)
            // 功能：一次返回精确容量、空闲容量、已用容量和使用率。
            // 参数：路径:wideString；返回：磁盘容量信息；可见性：default
            磁盘_取容量信息("module-demo-temp.txt")
            // 命令ID：磁盘_取卷信息
            // [12] 磁盘_取卷信息(路径)
            // 功能：返回路径所在卷的容量、标识、文件系统、类型和挂载点快照。
            // 参数：路径:wideString；返回：磁盘卷信息；可见性：default
            磁盘_取卷信息("module-demo-temp.txt")
            // 命令ID：磁盘_枚举逻辑驱动器
            // [13] 磁盘_枚举逻辑驱动器()
            // 功能：枚举当前会话可见的盘符和网络映射驱动器；未就绪设备也会保留并携带错误代码。
            // 参数：无；返回：磁盘卷信息列表；可见性：default
            磁盘_枚举逻辑驱动器()
            // 命令ID：磁盘_枚举全部卷
            // [14] 磁盘_枚举全部卷()
            // 功能：使用 Windows 卷枚举 API 返回包含无盘符卷在内的全部卷。
            // 参数：无；返回：磁盘卷信息列表；可见性：default
            磁盘_枚举全部卷()
        如果结束
        调试输出("已查看 命令 1–14：磁盘_总容量MB 至 磁盘_枚举全部卷；勾选允许实际执行后会使用演示参数调用。")
    结束

    事件 _运行第02组_被单击()
        控件_设置文本(演示状态, "命令 15–28：磁盘_取挂载点列表 至 磁盘_取最近错误；源码内含完整签名、参数、返回值与调用。")
        如果 (控件_取勾选(允许实际执行))
            // 命令ID：磁盘_取挂载点列表
            // [15] 磁盘_取挂载点列表(卷GUID路径)
            // 功能：返回卷对应的全部盘符和目录挂载点。
            // 参数：卷GUID路径:wideString；返回：磁盘路径列表；可见性：default
            磁盘_取挂载点列表("module-demo-temp.txt")
            // 命令ID：磁盘_取路径卷根
            // [16] 磁盘_取路径卷根(路径)
            // 功能：把任意本地路径解析为所属卷根路径。
            // 参数：路径:wideString；返回：wideString；可见性：default
            磁盘_取路径卷根("module-demo-temp.txt")
            // 命令ID：磁盘_取卷GUID路径
            // [17] 磁盘_取卷GUID路径(路径)
            // 功能：返回路径所属卷的稳定 \\?\Volume{GUID}\ 名称。
            // 参数：路径:wideString；返回：wideString；可见性：default
            磁盘_取卷GUID路径("module-demo-temp.txt")
            // 命令ID：磁盘_取驱动器类型名称
            // [18] 磁盘_取驱动器类型名称(根路径)
            // 功能：返回未知、无效根路径、可移动、固定、网络、光盘或内存盘。
            // 参数：根路径:wideString；返回：wideString；可见性：default
            磁盘_取驱动器类型名称("module-demo-temp.txt")
            // 命令ID：磁盘_取卷序列号
            // [19] 磁盘_取卷序列号(根路径)
            // 功能：返回文件系统卷序列号，失败返回 -1。
            // 参数：根路径:wideString；返回：longLong；可见性：default
            磁盘_取卷序列号("module-demo-temp.txt")
            // 命令ID：磁盘_取文件系统标志
            // [20] 磁盘_取文件系统标志(根路径)
            // 功能：返回 GetVolumeInformationW 的 FILE_* 能力标志位，失败返回 -1。
            // 参数：根路径:wideString；返回：longLong；可见性：default
            磁盘_取文件系统标志("module-demo-temp.txt")
            // 命令ID：磁盘_取最大文件名长度
            // [21] 磁盘_取最大文件名长度(根路径)
            // 功能：返回文件系统支持的单个名称最大字符数，失败返回 -1。
            // 参数：根路径:wideString；返回：int；可见性：default
            磁盘_取最大文件名长度("module-demo-temp.txt")
            // 命令ID：磁盘_卷是否就绪
            // [22] 磁盘_卷是否就绪(根路径)
            // 功能：判断卷是否存在且介质可读取。
            // 参数：根路径:wideString；返回：bool；可见性：default
            磁盘_卷是否就绪("module-demo-temp.txt")
            // 命令ID：磁盘_文件系统是否支持
            // [23] 磁盘_文件系统是否支持(根路径, 能力名称)
            // 功能：按中文或英文能力名查询压缩、稀疏文件、重解析点、命名流、加密、ACL、硬链接、事务、USN、DAX 等 FILE_* 标志。
            // 参数：根路径:wideString，能力名称:wideString；返回：bool；可见性：default
            磁盘_文件系统是否支持("module-demo-temp.txt", "演示参数2")
            // 命令ID：磁盘_枚举物理磁盘
            // [24] 磁盘_枚举物理磁盘()
            // 功能：枚举 Windows PhysicalDrive 设备并返回只读存储描述、容量、扇区、分区、SSD 和 TRIM 信息。
            // 参数：无；返回：物理磁盘信息列表；可见性：default
            磁盘_枚举物理磁盘()
            // 命令ID：磁盘_取物理磁盘信息
            // [25] 磁盘_取物理磁盘信息(磁盘编号)
            // 功能：按 PhysicalDrive 编号查询物理磁盘；不请求写权限。
            // 参数：磁盘编号:int；返回：物理磁盘信息；可见性：default
            磁盘_取物理磁盘信息(1)
            // 命令ID：磁盘_取分区列表
            // [26] 磁盘_取分区列表(磁盘编号)
            // 功能：读取物理磁盘的 MBR/GPT/RAW 分区布局，失败返回空数组并记录错误。
            // 参数：磁盘编号:int；返回：磁盘分区信息列表；可见性：default
            磁盘_取分区列表(1)
            // 命令ID：磁盘_取最近错误码
            // [27] 磁盘_取最近错误码()
            // 功能：返回当前线程最近一次磁盘模块失败的 Win32 错误代码；成功调用会清零。
            // 参数：无；返回：int；可见性：default
            磁盘_取最近错误码()
            // 命令ID：磁盘_取最近错误
            // [28] 磁盘_取最近错误()
            // 功能：返回当前线程最近一次磁盘模块失败的中文上下文和系统错误文本。
            // 参数：无；返回：wideString；可见性：default
            磁盘_取最近错误()
        如果结束
        调试输出("已查看 命令 15–28：磁盘_取挂载点列表 至 磁盘_取最近错误；勾选允许实际执行后会使用演示参数调用。")
    结束

结束类
