包 WebSocket客户端模块完整演示
使用 Win32窗口基础模块
使用 WebSocket客户端模块

// 本项目由模块清单自动生成；每条 binding 命令都在下方具有真实调用语句。
// 为避免误删文件、启动进程、访问网络或操作设备，必须先勾选“允许实际执行”才会进入命令调用区。
类 MainWindow : 公开 窗口
    事件 _MainWindow_创建完毕()
        控件_设置选择项(命令分组选项卡, 0)
        控件_设置文本(演示状态, "WebSocket 客户端模块：51 条命令，默认处于安全预览模式。")
        调试输出("已加载模块演示：lingbuilder.websocket.client")
    结束

    事件 _运行第01组_被单击()
        控件_设置文本(演示状态, "命令 1–17：WS_创建连接 至 WS_绑定重连处理器；源码内含完整签名、参数、返回值与调用。")
        如果 (控件_取勾选(允许实际执行))
            // 命令ID：WS_创建连接
            // [1] WS_创建连接()
            // 功能：创建尚未启动的受管 WebSocket 客户端并返回稳定连接 ID。
            // 参数：无；返回：WebSocket连接；可见性：default
            WS_创建连接()
            // 命令ID：WS_配置连接
            // [2] WS_配置连接(连接, 地址)
            // 功能：配置 ws:// 或 wss:// 地址；只能在连接停止时修改。
            // 参数：连接:WebSocket连接，地址:wideString；返回：bool；可见性：default
            WS_配置连接(0, "https://example.com")
            // 命令ID：WS_设置资源限制
            // [3] WS_设置资源限制(连接, 连接超时毫秒, 接收超时毫秒, 消息上限MB, 单次发送上限MB)
            // 功能：设置连接/接收超时和消息硬限制，防止无限阻塞或超大消息耗尽内存。
            // 参数：连接:WebSocket连接，连接超时毫秒:int，接收超时毫秒:int，消息上限MB:int，单次发送上限MB:int；返回：bool；可见性：default
            WS_设置资源限制(0, 1, 1, 1, 1)
            // 命令ID：WS_设置UserAgent
            // [4] WS_设置UserAgent(连接, UserAgent)
            // 功能：设置握手使用的 User-Agent；只能在连接停止时修改。
            // 参数：连接:WebSocket连接，UserAgent:wideString；返回：bool；可见性：default
            WS_设置UserAgent(0, "演示参数2")
            // 命令ID：WS_设置请求头
            // [5] WS_设置请求头(连接, 请求头)
            // 功能：设置 UTF-16 原始请求头，每行一个“名称: 值”；禁止覆盖 WebSocket 升级关键头。
            // 参数：连接:WebSocket连接，请求头:wideString；返回：bool；可见性：default
            WS_设置请求头(0, "演示参数2")
            // 命令ID：WS_设置Origin
            // [6] WS_设置Origin(连接, 来源)
            // 功能：设置 WebSocket 握手 Origin；空文本表示不发送。
            // 参数：连接:WebSocket连接，来源:wideString；返回：bool；可见性：default
            WS_设置Origin(0, "演示参数2")
            // 命令ID：WS_设置子协议
            // [7] WS_设置子协议(连接, 子协议列表)
            // 功能：设置逗号分隔的客户端子协议优先表，并校验服务端选择结果。
            // 参数：连接:WebSocket连接，子协议列表:wideString；返回：bool；可见性：default
            WS_设置子协议(0, "演示参数2")
            // 命令ID：WS_设置代理
            // [8] WS_设置代理(连接, 模式, 代理地址, 绕过列表)
            // 功能：设置代理模式：0=系统自动，1=直连，2=固定代理；固定代理格式遵循 WinHTTP。
            // 参数：连接:WebSocket连接，模式:int，代理地址:wideString，绕过列表:wideString；返回：bool；可见性：default
            WS_设置代理(0, 1, "https://example.com", "演示参数4")
            // 命令ID：WS_设置服务器凭据
            // [9] WS_设置服务器凭据(连接, 用户名, 密码)
            // 功能：设置握手服务器 HTTP Basic 身份验证凭据；仅保存在连接对象内存中。
            // 参数：连接:WebSocket连接，用户名:wideString，密码:wideString；返回：bool；可见性：default
            WS_设置服务器凭据(0, "演示参数2", "演示参数3")
            // 命令ID：WS_设置代理凭据
            // [10] WS_设置代理凭据(连接, 用户名, 密码)
            // 功能：设置代理 HTTP Basic 身份验证凭据；仅保存在连接对象内存中。
            // 参数：连接:WebSocket连接，用户名:wideString，密码:wideString；返回：bool；可见性：default
            WS_设置代理凭据(0, "演示参数2", "演示参数3")
            // 命令ID：WS_设置TLS验证
            // [11] WS_设置TLS验证(连接, 验证证书, 允许自签名, 证书SHA256)
            // 功能：配置 wss:// 证书验证和可选 SHA-256 证书固定；关闭验证属于高风险调试能力。
            // 参数：连接:WebSocket连接，验证证书:bool，允许自签名:bool，证书SHA256:wideString；返回：bool；可见性：advanced
            WS_设置TLS验证(0, 真, 真, "演示参数4")
            // 命令ID：WS_设置自动重连
            // [12] WS_设置自动重连(连接, 启用, 最大次数, 初始延迟毫秒, 最大延迟毫秒)
            // 功能：设置意外断开后的指数退避重连；主动关闭不会触发重连。
            // 参数：连接:WebSocket连接，启用:bool，最大次数:int，初始延迟毫秒:int，最大延迟毫秒:int；返回：bool；可见性：default
            WS_设置自动重连(0, 真, 1, 1, 1)
            // 命令ID：WS_绑定已连接处理器
            // [13] WS_绑定已连接处理器(连接, &处理器)
            // 功能：绑定已连接事件处理器；处理器通过窗口消息在创建连接的 UI 线程执行，并使用 WS_取当前事件系列命令读取快照。
            // 参数：连接:WebSocket连接，处理器:handler；返回：bool；可见性：default
            WS_绑定已连接处理器(0, &模块演示回调)
            // 命令ID：WS_绑定消息处理器
            // [14] WS_绑定消息处理器(连接, &处理器)
            // 功能：绑定消息事件处理器；处理器通过窗口消息在创建连接的 UI 线程执行，并使用 WS_取当前事件系列命令读取快照。
            // 参数：连接:WebSocket连接，处理器:handler；返回：bool；可见性：default
            WS_绑定消息处理器(0, &模块演示回调)
            // 命令ID：WS_绑定已断开处理器
            // [15] WS_绑定已断开处理器(连接, &处理器)
            // 功能：绑定已断开事件处理器；处理器通过窗口消息在创建连接的 UI 线程执行，并使用 WS_取当前事件系列命令读取快照。
            // 参数：连接:WebSocket连接，处理器:handler；返回：bool；可见性：default
            WS_绑定已断开处理器(0, &模块演示回调)
            // 命令ID：WS_绑定错误处理器
            // [16] WS_绑定错误处理器(连接, &处理器)
            // 功能：绑定错误事件处理器；处理器通过窗口消息在创建连接的 UI 线程执行，并使用 WS_取当前事件系列命令读取快照。
            // 参数：连接:WebSocket连接，处理器:handler；返回：bool；可见性：default
            WS_绑定错误处理器(0, &模块演示回调)
            // 命令ID：WS_绑定重连处理器
            // [17] WS_绑定重连处理器(连接, &处理器)
            // 功能：绑定重连事件处理器；处理器通过窗口消息在创建连接的 UI 线程执行，并使用 WS_取当前事件系列命令读取快照。
            // 参数：连接:WebSocket连接，处理器:handler；返回：bool；可见性：default
            WS_绑定重连处理器(0, &模块演示回调)
        如果结束
        调试输出("已查看 命令 1–17：WS_创建连接 至 WS_绑定重连处理器；勾选允许实际执行后会使用演示参数调用。")
    结束

    事件 _运行第02组_被单击()
        控件_设置文本(演示状态, "命令 18–34：WS_开始连接 至 WS_取接收消息数；源码内含完整签名、参数、返回值与调用。")
        如果 (控件_取勾选(允许实际执行))
            // 命令ID：WS_开始连接
            // [18] WS_开始连接(连接)
            // 功能：在后台启动连接、握手和接收循环，不阻塞 UI 线程。
            // 参数：连接:WebSocket连接；返回：bool；可见性：default
            WS_开始连接(0)
            // 命令ID：WS_等待连接
            // [19] WS_等待连接(连接, 超时毫秒)
            // 功能：等待连接进入“已连接”或失败状态；主要用于命令行和测试，UI 代码应使用已连接处理器。
            // 参数：连接:WebSocket连接，超时毫秒:int；返回：bool；可见性：default
            WS_等待连接(0, 1)
            // 命令ID：WS_关闭连接
            // [20] WS_关闭连接(连接, 状态码, 原因)
            // 功能：发送关闭帧并停止后台接收；状态码和 UTF-8 原因按 RFC 6455 校验。
            // 参数：连接:WebSocket连接，状态码:int，原因:wideString；返回：bool；可见性：default
            WS_关闭连接(0, 1, "演示参数3")
            // 命令ID：WS_强制断开
            // [21] WS_强制断开(连接)
            // 功能：立即关闭底层 WinHTTP 句柄并停止自动重连，仅用于超时或故障恢复。
            // 参数：连接:WebSocket连接；返回：bool；可见性：default
            WS_强制断开(0)
            // 命令ID：WS_销毁连接
            // [22] WS_销毁连接(连接)
            // 功能：停止并释放受管连接；重复销毁返回假。
            // 参数：连接:WebSocket连接；返回：bool；可见性：default
            WS_销毁连接(0)
            // 命令ID：WS_是否已连接
            // [23] WS_是否已连接(连接)
            // 功能：判断连接是否已完成握手且未进入关闭状态。
            // 参数：连接:WebSocket连接；返回：bool；可见性：default
            WS_是否已连接(0)
            // 命令ID：WS_取连接状态
            // [24] WS_取连接状态(连接)
            // 功能：返回连接状态：未配置、已停止、连接中、已连接、重连等待、关闭中或错误。
            // 参数：连接:WebSocket连接；返回：wideString；可见性：default
            WS_取连接状态(0)
            // 命令ID：WS_取连接地址
            // [25] WS_取连接地址(连接)
            // 功能：返回当前配置的 ws:// 或 wss:// 地址。
            // 参数：连接:WebSocket连接；返回：wideString；可见性：default
            WS_取连接地址(0)
            // 命令ID：WS_取协商子协议
            // [26] WS_取协商子协议(连接)
            // 功能：返回服务端握手选择的子协议。
            // 参数：连接:WebSocket连接；返回：wideString；可见性：default
            WS_取协商子协议(0)
            // 命令ID：WS_取握手响应头
            // [27] WS_取握手响应头(连接)
            // 功能：返回最近一次 WebSocket 握手的完整响应头。
            // 参数：连接:WebSocket连接；返回：wideString；可见性：default
            WS_取握手响应头(0)
            // 命令ID：WS_取握手状态码
            // [28] WS_取握手状态码(连接)
            // 功能：返回最近一次握手 HTTP 状态码。
            // 参数：连接:WebSocket连接；返回：int；可见性：default
            WS_取握手状态码(0)
            // 命令ID：WS_取连接错误
            // [29] WS_取连接错误(连接)
            // 功能：返回连接最近一次中文错误信息。
            // 参数：连接:WebSocket连接；返回：wideString；可见性：default
            WS_取连接错误(0)
            // 命令ID：WS_取连接时长
            // [30] WS_取连接时长(连接)
            // 功能：返回当前连接完成握手后的在线毫秒数。
            // 参数：连接:WebSocket连接；返回：longLong；可见性：default
            WS_取连接时长(0)
            // 命令ID：WS_取发送字节数
            // [31] WS_取发送字节数(连接)
            // 功能：返回累计成功发送的应用负载字节数。
            // 参数：连接:WebSocket连接；返回：longLong；可见性：default
            WS_取发送字节数(0)
            // 命令ID：WS_取接收字节数
            // [32] WS_取接收字节数(连接)
            // 功能：返回累计接收的应用负载字节数。
            // 参数：连接:WebSocket连接；返回：longLong；可见性：default
            WS_取接收字节数(0)
            // 命令ID：WS_取发送消息数
            // [33] WS_取发送消息数(连接)
            // 功能：返回累计成功发送的文本和二进制消息数。
            // 参数：连接:WebSocket连接；返回：longLong；可见性：default
            WS_取发送消息数(0)
            // 命令ID：WS_取接收消息数
            // [34] WS_取接收消息数(连接)
            // 功能：返回累计接收的完整文本和二进制消息数。
            // 参数：连接:WebSocket连接；返回：longLong；可见性：default
            WS_取接收消息数(0)
        如果结束
        调试输出("已查看 命令 18–34：WS_开始连接 至 WS_取接收消息数；勾选允许实际执行后会使用演示参数调用。")
    结束

    事件 _运行第03组_被单击()
        控件_设置文本(演示状态, "命令 35–51：WS_取重连次数 至 WS_关闭；源码内含完整签名、参数、返回值与调用。")
        如果 (控件_取勾选(允许实际执行))
            // 命令ID：WS_取重连次数
            // [35] WS_取重连次数(连接)
            // 功能：返回当前启动周期已经执行的自动重连次数。
            // 参数：连接:WebSocket连接；返回：int；可见性：default
            WS_取重连次数(0)
            // 命令ID：WS_发送文本到连接
            // [36] WS_发送文本到连接(连接, 内容)
            // 功能：向指定已连接客户端发送一条完整 UTF-8 文本消息，并执行 UTF-8 与发送大小校验。
            // 参数：连接:WebSocket连接，内容:wideString；返回：bool；可见性：default
            WS_发送文本到连接(0, "演示参数2")
            // 命令ID：WS_发送二进制到连接
            // [37] WS_发送二进制到连接(连接, 数据)
            // 功能：向指定已连接客户端发送一条完整二进制消息。
            // 参数：连接:WebSocket连接，数据:bytes；返回：bool；可见性：default
            WS_发送二进制到连接(0, {})
            // 命令ID：WS_取当前事件类型
            // [38] WS_取当前事件类型()
            // 功能：返回当前回调事件类型：已连接、文本、二进制、已断开、错误或重连。
            // 参数：无；返回：wideString；可见性：default
            WS_取当前事件类型()
            // 命令ID：WS_取当前连接
            // [39] WS_取当前连接()
            // 功能：返回当前事件对应的受管连接 ID。
            // 参数：无；返回：WebSocket连接；可见性：default
            WS_取当前连接()
            // 命令ID：WS_取当前消息类型
            // [40] WS_取当前消息类型()
            // 功能：返回当前消息类型：文本或二进制；其它事件返回空文本。
            // 参数：无；返回：wideString；可见性：default
            WS_取当前消息类型()
            // 命令ID：WS_取当前文本
            // [41] WS_取当前文本()
            // 功能：返回当前文本消息的不可变快照。
            // 参数：无；返回：wideString；可见性：default
            WS_取当前文本()
            // 命令ID：WS_取当前二进制
            // [42] WS_取当前二进制()
            // 功能：返回当前二进制消息的独立字节集副本。
            // 参数：无；返回：bytes；可见性：default
            WS_取当前二进制()
            // 命令ID：WS_取当前关闭代码
            // [43] WS_取当前关闭代码()
            // 功能：返回当前断开事件的 WebSocket 关闭状态码。
            // 参数：无；返回：int；可见性：default
            WS_取当前关闭代码()
            // 命令ID：WS_取当前关闭原因
            // [44] WS_取当前关闭原因()
            // 功能：返回当前断开事件的 UTF-8 关闭原因。
            // 参数：无；返回：wideString；可见性：default
            WS_取当前关闭原因()
            // 命令ID：WS_取当前错误
            // [45] WS_取当前错误()
            // 功能：返回当前错误事件的中文说明。
            // 参数：无；返回：wideString；可见性：default
            WS_取当前错误()
            // 命令ID：WS_取当前重连次数
            // [46] WS_取当前重连次数()
            // 功能：返回当前重连事件对应的重试序号。
            // 参数：无；返回：int；可见性：default
            WS_取当前重连次数()
            // 命令ID：WS_连接
            // [47] WS_连接(地址)
            // 功能：旧版单连接兼容入口；同步等待最多 30 秒，新代码应使用受管连接和事件处理器。
            // 参数：地址:wideString；返回：int；可见性：advanced
            WS_连接("https://example.com")
            // 命令ID：WS_发送文本
            // [48] WS_发送文本(内容)
            // 功能：旧版兼容入口；向默认受管连接发送文本。
            // 参数：内容:wideString；返回：int；可见性：advanced
            WS_发送文本("演示参数1")
            // 命令ID：WS_接收到调试输出
            // [49] WS_接收到调试输出()
            // 功能：旧版阻塞兼容入口；等待一条默认连接文本消息并写入调试输出。
            // 参数：无；返回：int；可见性：advanced
            WS_接收到调试输出()
            // 命令ID：WS_接收文本
            // [50] WS_接收文本()
            // 功能：旧版阻塞兼容入口；等待并返回默认连接的下一条文本消息。
            // 参数：无；返回：wideString；可见性：advanced
            WS_接收文本()
            // 命令ID：WS_关闭
            // [51] WS_关闭()
            // 功能：旧版兼容入口；关闭并销毁默认受管连接。
            // 参数：无；返回：void；可见性：advanced
            WS_关闭()
        如果结束
        调试输出("已查看 命令 35–51：WS_取重连次数 至 WS_关闭；勾选允许实际执行后会使用演示参数调用。")
    结束

    事件 模块演示回调()
        调试输出("模块演示回调已触发。")
