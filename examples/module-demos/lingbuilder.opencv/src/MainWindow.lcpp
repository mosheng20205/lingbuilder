包 OpenCV图像处理模块完整演示
使用 Win32窗口基础模块
使用 Win32高级控件模块
使用 OpenCV图像处理模块

// 本项目覆盖 lingbuilder.opencv 1.0.0 的全部 33 条命令。
// 每个命令按钮只调用一条 OpenCV 命令；前置图像和结果通过窗口成员句柄传递。
类 MainWindow : 公开 窗口
私有:
    长整数型 原始图像 = 0
    长整数型 当前图像 = 0
    长整数型 模板图像 = 0
    长整数型 当前结果 = 0
    文本型 当前分析名称 = "未执行"

公开:
    构造()
    结束

    事件 _MainWindow_创建完毕()
        控件_设置选择项(命令分组选项卡, 0)
        控件_清空项目(运行日志)
        控件_设置图片(结果预览, "assets/module-demo-lingbuilder.opencv/OpenCV缺口背景.png")
        控件_设置文本(演示状态, "就绪：预览图右侧有真实拼图缺口；请先点击“加载图像”。")
        记录日志("操作顺序：加载图像 -> 单项处理/分析 -> 单项读取或保存 -> 释放句柄。")
    结束

    空 记录日志(文本型 内容)
        控件_添加项目(运行日志, 内容)
        调试输出(内容)
    结束

    逻辑型 检查原始图像()
        如果 (原始图像 == 0)
            记录日志("尚未加载图像，请先点击“OpenCV_加载图像”。")
            返回 (假)
        如果结束
        返回 (真)
    结束

    逻辑型 检查当前图像()
        如果 (当前图像 == 0)
            记录日志("当前没有可用图像，请先加载图像或执行一项图像处理。")
            返回 (假)
        如果结束
        返回 (真)
    结束

    逻辑型 检查可生成图像()
        如果 (!检查原始图像())
            返回 (假)
        如果结束
        如果 (当前图像 != 原始图像)
            记录日志("已有一张处理图。请先单独执行“OpenCV_保存图像”或“OpenCV_释放图像”，再运行下一项处理。")
            返回 (假)
        如果结束
        返回 (真)
    结束

    逻辑型 检查当前结果()
        如果 (当前结果 == 0)
            记录日志("尚无分析结果，请先单独执行模板匹配、查找轮廓或分析缺口。")
            返回 (假)
        如果结束
        返回 (真)
    结束

    空 完成图像命令(文本型 命令名称)
        如果 (当前图像 == 0)
            记录日志(格式化文本("{}失败；请点击“OpenCV_取错误”查看原因。", 命令名称))
            控件_设置文本(演示状态, 格式化文本("{}失败。", 命令名称))
            返回
        如果结束
        记录日志(格式化文本("{}完成，已得到新的图像句柄。可切到基础页单独保存或释放。", 命令名称))
        控件_设置文本(演示状态, 格式化文本("{}完成。", 命令名称))
    结束

    空 完成分析命令(文本型 命令名称)
        当前分析名称 = 命令名称
        如果 (当前结果 == 0)
            记录日志(格式化文本("{}失败；请点击“OpenCV_取错误”查看原因。", 命令名称))
            控件_设置文本(演示状态, 格式化文本("{}失败。", 命令名称))
            返回
        如果结束
        记录日志(格式化文本("{}完成，已得到结果句柄。下方结果按钮可逐项读取。", 命令名称))
        控件_设置文本(演示状态, 格式化文本("{}完成。", 命令名称))
    结束

    事件 _取版本按钮_被单击()
        // 命令ID：OpenCV_取版本
        局部 文本型 版本 = OpenCV_取版本()
        记录日志(格式化文本("OpenCV 运行时版本：{}", 版本))
        控件_设置文本(演示状态, "OpenCV_取版本完成。")
    结束

    事件 _加载图像按钮_被单击()
        如果 (原始图像 != 0)
            记录日志("原始图像已加载。请先点击“OpenCV_释放全部”，再重新加载。")
            返回
        如果结束
        // 命令ID：OpenCV_加载图像
        原始图像 = OpenCV_加载图像("assets/module-demo-lingbuilder.opencv/OpenCV缺口背景.png", "彩色")
        当前图像 = 原始图像
        如果 (原始图像 == 0)
            记录日志("OpenCV_加载图像失败；请点击“OpenCV_取错误”。")
        否则
            记录日志(格式化文本("OpenCV_加载图像完成，句柄={}", 原始图像))
        如果结束
        控件_设置文本(演示状态, "OpenCV_加载图像执行完毕。")
    结束

    事件 _保存图像按钮_被单击()
        如果 (!检查当前图像())
            返回
        如果结束
        // 命令ID：OpenCV_保存图像
        局部 逻辑型 成功 = OpenCV_保存图像(当前图像, "assets/module-demo-lingbuilder.opencv/输出-当前图像.png", 95)
        记录日志(格式化文本("OpenCV_保存图像：{}", 成功))
        如果 (成功)
            控件_设置图片(结果预览, "assets/module-demo-lingbuilder.opencv/输出-当前图像.png")
        如果结束
        控件_设置文本(演示状态, "OpenCV_保存图像执行完毕。")
    结束

    事件 _克隆图像按钮_被单击()
        如果 (!检查可生成图像())
            返回
        如果结束
        // 命令ID：OpenCV_克隆图像
        当前图像 = OpenCV_克隆图像(原始图像)
        完成图像命令("OpenCV_克隆图像")
    结束

    事件 _释放图像按钮_被单击()
        如果 (!检查当前图像())
            返回
        如果结束
        局部 长整数型 待释放图像 = 当前图像
        // 命令ID：OpenCV_释放图像
        局部 逻辑型 成功 = OpenCV_释放图像(待释放图像)
        如果 (成功)
            如果 (模板图像 == 待释放图像)
                模板图像 = 0
            如果结束
            如果 (原始图像 == 待释放图像)
                原始图像 = 0
            如果结束
            当前图像 = 原始图像
        如果结束
        记录日志(格式化文本("OpenCV_释放图像：{}", 成功))
        控件_设置文本(演示状态, "OpenCV_释放图像执行完毕。")
    结束

    事件 _释放全部按钮_被单击()
        // 命令ID：OpenCV_释放全部
        OpenCV_释放全部()
        原始图像 = 0
        当前图像 = 0
        模板图像 = 0
        当前结果 = 0
        当前分析名称 = "未执行"
        记录日志("OpenCV_释放全部完成：窗口保存的全部句柄状态已清零。")
        控件_设置文本(演示状态, "OpenCV_释放全部完成。")
    结束

    事件 _取宽度按钮_被单击()
        如果 (!检查当前图像())
            返回
        如果结束
        // 命令ID：OpenCV_取宽度
        局部 整数型 数值 = OpenCV_取宽度(当前图像)
        记录日志(格式化文本("OpenCV_取宽度：{} 像素", 数值))
    结束

    事件 _取高度按钮_被单击()
        如果 (!检查当前图像())
            返回
        如果结束
        // 命令ID：OpenCV_取高度
        局部 整数型 数值 = OpenCV_取高度(当前图像)
        记录日志(格式化文本("OpenCV_取高度：{} 像素", 数值))
    结束

    事件 _取通道数按钮_被单击()
        如果 (!检查当前图像())
            返回
        如果结束
        // 命令ID：OpenCV_取通道数
        局部 整数型 数值 = OpenCV_取通道数(当前图像)
        记录日志(格式化文本("OpenCV_取通道数：{}", 数值))
    结束

    事件 _准备错误按钮_被单击()
        // 本按钮只调用加载图像，用不存在的路径为下一步“取错误”准备状态。
        局部 长整数型 失败句柄 = OpenCV_加载图像("assets/module-demo-lingbuilder.opencv/用于演示的不存在文件.png", "彩色")
        记录日志(格式化文本("错误状态已准备，预期返回句柄 0，实际={}", 失败句柄))
        控件_设置文本(演示状态, "请点击“OpenCV_取错误”读取刚才的错误。")
    结束

    事件 _取错误按钮_被单击()
        // 命令ID：OpenCV_取错误
        局部 文本型 错误 = OpenCV_取错误()
        记录日志(格式化文本("OpenCV_取错误：{}", 错误))
        控件_设置文本(演示状态, "OpenCV_取错误完成。")
    结束

    事件 _灰度化按钮_被单击()
        如果 (!检查可生成图像())
            返回
        如果结束
        // 命令ID：OpenCV_灰度化
        当前图像 = OpenCV_灰度化(原始图像)
        完成图像命令("OpenCV_灰度化")
    结束

    事件 _缩放按钮_被单击()
        如果 (!检查可生成图像())
            返回
        如果结束
        // 命令ID：OpenCV_缩放
        当前图像 = OpenCV_缩放(原始图像, 320, 320)
        完成图像命令("OpenCV_缩放")
    结束

    事件 _裁剪按钮_被单击()
        如果 (!检查可生成图像())
            返回
        如果结束
        // 命令ID：OpenCV_裁剪
        当前图像 = OpenCV_裁剪(原始图像, 150, 110, 210, 120)
        模板图像 = 当前图像
        完成图像命令("OpenCV_裁剪")
        记录日志("本次裁剪结果同时作为模板匹配所需的模板图像。")
    结束

    事件 _高斯模糊按钮_被单击()
        如果 (!检查可生成图像())
            返回
        如果结束
        // 命令ID：OpenCV_高斯模糊
        当前图像 = OpenCV_高斯模糊(原始图像, 7, 1.5)
        完成图像命令("OpenCV_高斯模糊")
    结束

    事件 _二值化按钮_被单击()
        如果 (!检查可生成图像())
            返回
        如果结束
        // 命令ID：OpenCV_二值化
        当前图像 = OpenCV_二值化(原始图像, 128, "二值")
        完成图像命令("OpenCV_二值化")
    结束

    事件 _自适应二值化按钮_被单击()
        如果 (!检查可生成图像())
            返回
        如果结束
        // 命令ID：OpenCV_自适应二值化
        当前图像 = OpenCV_自适应二值化(原始图像, 11, 2.0, 假)
        完成图像命令("OpenCV_自适应二值化")
    结束

    事件 _Canny边缘按钮_被单击()
        如果 (!检查可生成图像())
            返回
        如果结束
        // 命令ID：OpenCV_Canny边缘
        当前图像 = OpenCV_Canny边缘(原始图像, 50, 150)
        完成图像命令("OpenCV_Canny边缘")
    结束

    事件 _形态学按钮_被单击()
        如果 (!检查可生成图像())
            返回
        如果结束
        // 命令ID：OpenCV_形态学
        当前图像 = OpenCV_形态学(原始图像, "闭运算", 3, 1)
        完成图像命令("OpenCV_形态学")
    结束

    事件 _模板匹配按钮_被单击()
        如果 (!检查原始图像())
            返回
        如果结束
        如果 (模板图像 == 0)
            记录日志("模板图像尚未准备，请先单独执行“OpenCV_裁剪”。")
            返回
        如果结束
        如果 (当前结果 != 0)
            记录日志("已有分析结果，请先单独执行“OpenCV结果_释放”。")
            返回
        如果结束
        // 命令ID：OpenCV_模板匹配
        当前结果 = OpenCV_模板匹配(原始图像, 模板图像, "相关系数", 0.75, 5)
        完成分析命令("OpenCV_模板匹配")
    结束

    事件 _查找轮廓按钮_被单击()
        如果 (!检查当前图像())
            返回
        如果结束
        如果 (当前结果 != 0)
            记录日志("已有分析结果，请先单独执行“OpenCV结果_释放”。")
            返回
        如果结束
        // 命令ID：OpenCV_查找轮廓
        当前结果 = OpenCV_查找轮廓(当前图像, 80.0, 0.0, 20)
        完成分析命令("OpenCV_查找轮廓")
    结束

    事件 _分析缺口按钮_被单击()
        如果 (!检查原始图像())
            返回
        如果结束
        如果 (当前结果 != 0)
            记录日志("已有分析结果，请先单独执行“OpenCV结果_释放”。")
            返回
        如果结束
        // 命令ID：OpenCV_分析缺口
        当前结果 = OpenCV_分析缺口(原始图像, 0, 1, "{\"mode\":\"contour\",\"roiX\":290,\"roiY\":80,\"roiWidth\":170,\"roiHeight\":160,\"minWidth\":60,\"minHeight\":80,\"maxWidth\":130,\"maxHeight\":140,\"minScore\":0.2}")
        完成分析命令("OpenCV_分析缺口")
    结束

    事件 _结果取类型按钮_被单击()
        如果 (!检查当前结果())
            返回
        如果结束
        // 命令ID：OpenCV结果_取类型
        局部 文本型 数值 = OpenCV结果_取类型(当前结果)
        记录日志(格式化文本("OpenCV结果_取类型：{}", 数值))
    结束

    事件 _结果取数量按钮_被单击()
        如果 (!检查当前结果())
            返回
        如果结束
        // 命令ID：OpenCV结果_取数量
        局部 整数型 数值 = OpenCV结果_取数量(当前结果)
        记录日志(格式化文本("OpenCV结果_取数量：{}", 数值))
    结束

    事件 _结果取横坐标按钮_被单击()
        如果 (!检查当前结果())
            返回
        如果结束
        // 命令ID：OpenCV结果_取横坐标
        局部 整数型 数值 = OpenCV结果_取横坐标(当前结果, 0)
        记录日志(格式化文本("OpenCV结果_取横坐标[0]：{}", 数值))
    结束

    事件 _结果取纵坐标按钮_被单击()
        如果 (!检查当前结果())
            返回
        如果结束
        // 命令ID：OpenCV结果_取纵坐标
        局部 整数型 数值 = OpenCV结果_取纵坐标(当前结果, 0)
        记录日志(格式化文本("OpenCV结果_取纵坐标[0]：{}", 数值))
    结束

    事件 _结果取宽度按钮_被单击()
        如果 (!检查当前结果())
            返回
        如果结束
        // 命令ID：OpenCV结果_取宽度
        局部 整数型 数值 = OpenCV结果_取宽度(当前结果, 0)
        记录日志(格式化文本("OpenCV结果_取宽度[0]：{}", 数值))
    结束

    事件 _结果取高度按钮_被单击()
        如果 (!检查当前结果())
            返回
        如果结束
        // 命令ID：OpenCV结果_取高度
        局部 整数型 数值 = OpenCV结果_取高度(当前结果, 0)
        记录日志(格式化文本("OpenCV结果_取高度[0]：{}", 数值))
    结束

    事件 _结果取中心横坐标按钮_被单击()
        如果 (!检查当前结果())
            返回
        如果结束
        // 命令ID：OpenCV结果_取中心横坐标
        局部 整数型 数值 = OpenCV结果_取中心横坐标(当前结果, 0)
        记录日志(格式化文本("OpenCV结果_取中心横坐标[0]：{}", 数值))
    结束

    事件 _结果取中心纵坐标按钮_被单击()
        如果 (!检查当前结果())
            返回
        如果结束
        // 命令ID：OpenCV结果_取中心纵坐标
        局部 整数型 数值 = OpenCV结果_取中心纵坐标(当前结果, 0)
        记录日志(格式化文本("OpenCV结果_取中心纵坐标[0]：{}", 数值))
    结束

    事件 _结果取置信度按钮_被单击()
        如果 (!检查当前结果())
            返回
        如果结束
        // 命令ID：OpenCV结果_取置信度
        局部 双精度小数型 数值 = OpenCV结果_取置信度(当前结果, 0)
        记录日志(格式化文本("OpenCV结果_取置信度[0]：{}", 数值))
    结束

    事件 _结果取JSON按钮_被单击()
        如果 (!检查当前结果())
            返回
        如果结束
        // 命令ID：OpenCV结果_取JSON
        局部 文本型 数值 = OpenCV结果_取JSON(当前结果)
        记录日志(格式化文本("OpenCV结果_取JSON：{}", 数值))
    结束

    事件 _结果保存标注图按钮_被单击()
        如果 (!检查当前结果())
            返回
        如果结束
        // 命令ID：OpenCV结果_保存标注图
        局部 逻辑型 成功 = OpenCV结果_保存标注图(当前结果, "assets/module-demo-lingbuilder.opencv/输出-当前分析标注.png", 95)
        记录日志(格式化文本("OpenCV结果_保存标注图（{}）：{}", 当前分析名称, 成功))
        如果 (成功)
            控件_设置图片(结果预览, "assets/module-demo-lingbuilder.opencv/输出-当前分析标注.png")
        如果结束
    结束

    事件 _结果释放按钮_被单击()
        如果 (!检查当前结果())
            返回
        如果结束
        // 命令ID：OpenCV结果_释放
        局部 逻辑型 成功 = OpenCV结果_释放(当前结果)
        如果 (成功)
            当前结果 = 0
            当前分析名称 = "未执行"
        如果结束
        记录日志(格式化文本("OpenCV结果_释放：{}", 成功))
        控件_设置文本(演示状态, "OpenCV结果_释放执行完毕。")
    结束

    事件 _清空日志按钮_被单击()
        控件_清空项目(运行日志)
        控件_设置文本(演示状态, "运行日志已清空。")
    结束

    事件 _退出按钮_被单击()
        结束()
    结束
结束类
