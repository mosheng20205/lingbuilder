包 全部控制流命令详细演示
使用 Win32窗口基础模块
使用 通用控件模块

类 MainWindow : 窗口
公开
  构造()
  结束

  事件 _MainWindow_创建完毕()
    控件_设置文本(底部状态, "状态：请选择标签页并运行对应示例。")
    控件_添加项目(条件结果, "准备完成：本页演示条件判断和多分支选择。")
    控件_添加项目(循环结果, "准备完成：本页演示无限、前置和后置循环。")
    控件_添加项目(遍历结果, "准备完成：本页演示计次、变量和枚举循环。")
    控件_添加项目(异常结果, "准备完成：本页演示异常、返回和程序退出。")
  结束

  // ------------------------------------------------------------------
  // 第 1 页：条件判断
  // 覆盖：如果真、否则如果、否则、如果真结束、如果、如果结束。
  // 分别把数值设置为 1、2、9，确保三个分支都能被实际观察到。
  // ------------------------------------------------------------------
  事件 _条件判断按钮_被单击()
    局部 整数型 数值 = 1

    控件_清空项目(条件结果)
    控件_添加项目(条件结果, "【如果真 / 否则如果 / 否则】开始")

    如果真 (数值 == 1)
      控件_添加项目(条件结果, "数值=1：命中 如果真 分支。")
    否则如果 (数值 == 2)
      控件_添加项目(条件结果, "数值=1：不会执行这个 否则如果 分支。")
    否则
      控件_添加项目(条件结果, "数值=1：不会执行这个 否则 分支。")
    如果真结束

    数值 = 2
    如果真 (数值 == 1)
      控件_添加项目(条件结果, "数值=2：不会执行第一个分支。")
    否则如果 (数值 == 2)
      控件_添加项目(条件结果, "数值=2：命中 否则如果 分支。")
    否则
      控件_添加项目(条件结果, "数值=2：不会执行 否则 分支。")
    如果真结束

    数值 = 9
    如果真 (数值 == 1)
      控件_添加项目(条件结果, "数值=9：不会执行第一个分支。")
    否则如果 (数值 == 2)
      控件_添加项目(条件结果, "数值=9：不会执行第二个分支。")
    否则
      控件_添加项目(条件结果, "数值=9：前面条件都不成立，命中 否则。")
    如果真结束

    // 如果 / 如果结束 是简单条件块写法。
    如果 (数值 > 5)
      控件_添加项目(条件结果, "如果：9 大于 5，简单条件块执行成功。")
    如果结束

    控件_添加项目(条件结果, "条件判断演示完成。")
    控件_设置文本(底部状态, "状态：条件判断的全部分支均已实际执行。")
  结束

  // ------------------------------------------------------------------
  // 第 1 页：多分支选择
  // 覆盖：选择、分支（单值和多值）、默认、选择结束。
  // ------------------------------------------------------------------
  事件 _多分支选择按钮_被单击()
    局部 整数型 数值 = 1

    控件_清空项目(条件结果)
    控件_添加项目(条件结果, "【选择 / 分支 / 默认】开始")

    选择 (数值)
      分支 (1)
        控件_添加项目(条件结果, "数值=1：命中单值 分支 (1)。")
      分支 (2, 3)
        控件_添加项目(条件结果, "数值=1：不会执行多值分支。")
      默认
        控件_添加项目(条件结果, "数值=1：不会执行默认分支。")
    选择结束

    数值 = 3
    选择 (数值)
      分支 (1)
        控件_添加项目(条件结果, "数值=3：不会执行单值分支。")
      分支 (2, 3)
        控件_添加项目(条件结果, "数值=3：命中多值 分支 (2, 3)。")
      默认
        控件_添加项目(条件结果, "数值=3：不会执行默认分支。")
    选择结束

    数值 = 9
    选择 (数值)
      分支 (1)
        控件_添加项目(条件结果, "数值=9：不会执行单值分支。")
      分支 (2, 3)
        控件_添加项目(条件结果, "数值=9：不会执行多值分支。")
      默认
        控件_添加项目(条件结果, "数值=9：没有分支匹配，命中 默认。")
    选择结束

    控件_添加项目(条件结果, "多分支选择演示完成。")
    控件_设置文本(底部状态, "状态：选择结构的单值、多值和默认分支均已执行。")
  结束

  // ------------------------------------------------------------------
  // 第 2 页：三种基础循环
  // 覆盖：循环、跳出循环、循环结束、判断循环首/尾、循环判断首/尾。
  // ------------------------------------------------------------------
  事件 _基础循环按钮_被单击()
    局部 整数型 索引 = 0

    控件_清空项目(循环结果)
    控件_添加项目(循环结果, "【循环 / 跳出循环】无限循环由代码主动结束")

    循环
      索引 = 索引 + 1
      控件_添加项目(循环结果, 格式化文本("无限循环第 {} 轮。", 索引))
      如果 (索引 >= 3)
        控件_添加项目(循环结果, "索引达到 3，执行 跳出循环。")
        跳出循环
      如果结束
    循环结束

    控件_添加项目(循环结果, "【判断循环首 / 判断循环尾】先判断再执行")
    索引 = 0
    判断循环首 (索引 < 3)
      索引 = 索引 + 1
      控件_添加项目(循环结果, 格式化文本("前置判断循环第 {} 轮。", 索引))
    判断循环尾 ()

    控件_添加项目(循环结果, "【循环判断首 / 循环判断尾】循环体至少执行一次")
    索引 = 0
    循环判断首 ()
      索引 = 索引 + 1
      控件_添加项目(循环结果, 格式化文本("后置判断循环第 {} 轮。", 索引))
    循环判断尾 (索引 < 2)

    控件_添加项目(循环结果, "三种基础循环演示完成。")
    控件_设置文本(底部状态, "状态：无限循环、前置判断循环、后置判断循环均已执行。")
  结束

  // ------------------------------------------------------------------
  // 第 3 页：计次、变量和枚举循环
  // 覆盖：计次循环首/尾、继续循环、变量循环首/尾、到循环尾、
  //       枚举循环首/尾。
  // ------------------------------------------------------------------
  事件 _计次枚举按钮_被单击()
    局部 整数型 索引 = 0
    局部 整数型 当前项 = 0
    局部 整数型 数字列表[] = {2, 4, 6}

    控件_清空项目(遍历结果)
    控件_添加项目(遍历结果, "【计次循环】固定执行 5 次，第 2 次使用 继续循环")

    计次循环首 (5, 索引)
      如果 (索引 == 2)
        控件_添加项目(遍历结果, "计次索引=2：执行 继续循环，跳过本轮剩余代码。")
        继续循环
      如果结束
      控件_添加项目(遍历结果, 格式化文本("计次循环有效轮次：{}。", 索引))
    计次循环尾 ()

    控件_添加项目(遍历结果, "【变量循环】1 到 5、步长 2；索引 3 使用 到循环尾")
    变量循环首 (1, 5, 2, 索引)
      如果 (索引 == 3)
        控件_添加项目(遍历结果, "变量索引=3：执行 到循环尾（继续循环的别名）。")
        到循环尾
      如果结束
      控件_添加项目(遍历结果, 格式化文本("变量循环有效值：{}。", 索引))
    变量循环尾 ()

    控件_添加项目(遍历结果, "【枚举循环】依次读取数组 {2, 4, 6}")
    枚举循环首 (数字列表, 当前项)
      控件_添加项目(遍历结果, 格式化文本("枚举到数组成员：{}。", 当前项))
    枚举循环尾 ()

    控件_添加项目(遍历结果, "计次、变量和枚举循环演示完成。")
    控件_设置文本(底部状态, "状态：计次、变量、枚举循环及两种继续语义均已执行。")
  结束

  // ------------------------------------------------------------------
  // 第 4 页：异常流程
  // 覆盖：尝试、抛出、捕获、最终、尝试结束。
  // ------------------------------------------------------------------
  事件 _异常处理按钮_被单击()
    控件_清空项目(异常结果)
    控件_添加项目(异常结果, "【尝试】进入受保护代码块。")

    尝试
      控件_添加项目(异常结果, "准备执行 抛出，后续尝试块代码将被跳过。")
      抛出("这是控制流演示主动抛出的异常")
      控件_添加项目(异常结果, "这行不会执行。")
    捕获 (错误信息)
      控件_添加项目(异常结果, 格式化文本("【捕获】已接住异常：{}", 错误信息))
      调试输出("捕获到异常", 错误信息)
    最终
      控件_添加项目(异常结果, "【最终】无论是否发生异常，这里都会执行。")
    尝试结束

    控件_添加项目(异常结果, "异常处理完成，程序继续正常运行。")
    控件_设置文本(底部状态, "状态：尝试、抛出、捕获、最终均已执行。")
  结束

  // ------------------------------------------------------------------
  // 第 4 页：返回流程
  // 覆盖：返回 (值)。正数返回 100，非正数返回 0。
  // ------------------------------------------------------------------
  事件 _返回值按钮_被单击()
    局部 整数型 正数结果 = 0
    局部 整数型 零值结果 = 0

    控件_清空项目(异常结果)
    正数结果 = 演示返回(8)
    零值结果 = 演示返回(0)
    控件_添加项目(异常结果, 格式化文本("演示返回(8) = {}：命中提前 返回 (100)。", 正数结果))
    控件_添加项目(异常结果, 格式化文本("演示返回(0) = {}：执行方法末尾 返回 (0)。", 零值结果))
    控件_添加项目(异常结果, "返回命令演示完成。")
    控件_设置文本(底部状态, "状态：返回命令的两个路径均已执行。")
  结束

  整数型 演示返回(整数型 输入值)
    如果 (输入值 > 0)
      返回 (100)
    如果结束
    返回 (0)
  结束

  事件 _清空条件结果按钮_被单击()
    控件_清空项目(条件结果)
    控件_设置文本(底部状态, "状态：已清空条件与选择结果。")
  结束

  事件 _清空循环结果按钮_被单击()
    控件_清空项目(循环结果)
    控件_设置文本(底部状态, "状态：已清空基础循环结果。")
  结束

  事件 _清空遍历结果按钮_被单击()
    控件_清空项目(遍历结果)
    控件_设置文本(底部状态, "状态：已清空计次与枚举结果。")
  结束

  事件 _清空异常结果按钮_被单击()
    控件_清空项目(异常结果)
    控件_设置文本(底部状态, "状态：已清空异常与返回结果。")
  结束

  // 结束() 是程序终止命令；普通“结束”只是事件或方法的结构结束标记。
  事件 _退出程序按钮_被单击()
    结束()
  结束
结束类
