包 邮件传输演示 // v4 // v3
使用 邮件接收模块
使用 IMAP邮件接收模块
使用 SMTP邮件模块
使用 文件目录模块
使用 文本处理模块
使用 数组操作模块
使用 Win32窗口基础模块
使用 路径处理模块

类 邮件传输演示 : 窗口
公开
  整数型 启动()
    局部 文本型 报告文件 = "mail-transport-report.txt"
    局部 文件号 报告
    报告 = 文件_打开(报告文件, 4, 1)

    局部 逻辑型 连接成功
    连接成功 = SMTP_发送HTML邮件("127.0.0.1", 1025, "user", "pass", "from@example.com", "to@example.com", "HTML测试", "<b>LB_HTML_OK</b>")
    文件_写文本行(报告, 格式化文本("S发送HTML={}", 到文本(连接成功)))
    文件_写文本行(报告, 格式化文本("S错误1={}", SMTP_取错误()))

    局部 文本型 附件[]
    数组_加入成员(附件, "lb-attachment.txt")
    连接成功 = SMTP_发送附件邮件("127.0.0.1", 1025, "user", "pass", "from@example.com", "to@example.com", "附件测试", "LB_SMTP_BODY", 假, 附件)
    文件_写文本行(报告, 格式化文本("S发送附件={}", 到文本(连接成功)))
    文件_写文本行(报告, 格式化文本("S错误2={}", SMTP_取错误()))

    连接成功 = POP3_连接("127.0.0.1", 1110, "user", "pass", 假)
    文件_写文本行(报告, 格式化文本("P连接={}", 到文本(连接成功)))
    文件_写文本行(报告, 格式化文本("P数量={}", 到文本(POP3_取邮件数量())))
    局部 逻辑型 收信成功
    收信成功 = POP3_接收邮件(1)
    文件_写文本行(报告, 格式化文本("P收信={}", 到文本(收信成功)))
    文件_写文本行(报告, 格式化文本("P主题={}", POP3_取主题()))
    文件_写文本行(报告, 格式化文本("P正文={}", POP3_取正文文本()))
    文件_写文本行(报告, 格式化文本("P附件数={}", 到文本(POP3_取附件个数())))
    POP3_保存附件(0, "pop3-attachment.bin")
    局部 逻辑型 附件存在
    附件存在 = 文件_是否存在("pop3-attachment.bin")
    文件_写文本行(报告, 格式化文本("P附件落盘={}", 到文本(附件存在)))
    POP3_断开()

    连接成功 = IMAP_连接("127.0.0.1", 11143, "user", "pass", 假)
    文件_写文本行(报告, 格式化文本("I连接={}", 到文本(连接成功)))
    IMAP_选择文件夹("INBOX")
    文件_写文本行(报告, 格式化文本("I数量={}", 到文本(IMAP_取邮件数量())))
    收信成功 = IMAP_接收邮件(1)
    文件_写文本行(报告, 格式化文本("I收信={}", 到文本(收信成功)))
    文件_写文本行(报告, 格式化文本("I主题={}", IMAP_取主题()))

    局部 文本型 配置文件 = 路径_转绝对路径("mail-demo.ini")
    局部 文件号 配置句柄
    配置句柄 = 文件_打开(配置文件, 4, 1)
    文件_写文本行(配置句柄, "[SectionA]")
    文件_写文本行(配置句柄, "Key1=1")
    文件_写文本行(配置句柄, "")
    文件_写文本行(配置句柄, "[SectionB]")
    文件_写文本行(配置句柄, "Key2=2")
    文件_关闭(配置句柄)

    局部 文本型 节列表[]
    局部 整数型 节数
    文件_写文本行(报告, 格式化文本("P探针={}", INI_读文本(配置文件, "SectionB", "Key2", "缺")))
    节数 = INI_枚举节(配置文件, 节列表)
    文件_写文本行(报告, 格式化文本("I节数={}", 到文本(节数)))
    局部 文本型 键列表[]
    局部 整数型 键数
    键数 = INI_枚举键(配置文件, "SectionB", 键列表)
    文件_写文本行(报告, 格式化文本("I键数={}", 到文本(键数)))

    文件_写文本行(报告, "DONE=1")
    文件_关闭(报告)
    返回 0
  结束
结束类
