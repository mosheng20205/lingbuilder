包 记忆迁移助手
使用 Win32窗口基础模块
使用 文件目录模块
使用 路径处理模块
使用 ZIP压缩模块
使用 系统信息模块
使用 日期时间模块
使用 数组操作模块

// ZCode 记忆迁移助手：旧电脑把三处记忆打包成一个 zip，新电脑从 zip 还原。
// 红线：路径全程按文本传递不做编码转换；单文件复制失败只记一行「跳过」，不中断整批。

类 MainWindow
    事件 _MainWindow_创建完毕()
        控件_设置文本(提示, "就绪：旧电脑点「开始打包」，新电脑点「开始还原」")
        追加日志("ZCode 记忆迁移助手已启动")
    结束

    事件 _开始打包_被单击()
        局部 文本型 工作区
        局部 文本型 用户目录
        局部 文本型 记忆源
        局部 文本型 技能源
        局部 文本型 项目源
        局部 文本型 下载目录
        局部 文本型 时间标记
        局部 文本型 打包时间
        局部 文本型 临时根
        局部 文本型 包目录
        局部 文本型 ZIP路径
        局部 文本型 清单
        局部 整数型 记忆数 = 0
        局部 整数型 技能数 = 0
        局部 整数型 项目数 = 0
        局部 逻辑型 压缩成功 = 假

        工作区 = 控件_取文本(工作区路径输入)
        如果 (工作区 = "")
            控件_设置文本(提示, "打包失败：工作区路径为空")
            追加日志("错误：工作区路径为空")
            返回()
        如果结束
        用户目录 = 系统_取环境变量("USERPROFILE")
        如果 (用户目录 = "")
            控件_设置文本(提示, "打包失败：读不到用户目录")
            追加日志("错误：环境变量 USERPROFILE 为空")
            返回()
        如果结束

        记忆源 = 路径_合并(用户目录, ".zcode\cli\memories")
        技能源 = 路径_合并(用户目录, ".zcode\skills")
        项目源 = 路径_合并(工作区, ".zcode\memory")

        追加日志("=== 开始打包 ===")
        追加日志("工作区：" + 工作区)
        追加日志("用户目录：" + 用户目录)

        如果 (目录_是否存在(记忆源) = 假)
            控件_设置文本(提示, "打包失败：自动记忆目录不存在")
            追加日志("错误：找不到自动记忆目录 " + 记忆源)
            返回()
        如果结束
        如果 (目录_是否存在(技能源) = 假)
            控件_设置文本(提示, "打包失败：技能目录不存在")
            追加日志("错误：找不到技能目录 " + 技能源)
            返回()
        如果结束

        下载目录 = 路径_合并(用户目录, "Downloads")
        目录_创建(下载目录)
        时间标记 = 时间_格式化当前("%Y%m%d-%H%M%S")
        打包时间 = 时间_格式化当前("%Y-%m-%d %H:%M:%S")
        临时根 = 路径_合并(下载目录, "zcode-memory-stage-" + 时间标记)
        包目录 = 路径_合并(临时根, "package")
        如果 (目录_是否存在(临时根))
            目录_删除树(临时根)
        如果结束
        目录_创建(包目录)

        控件_设置文本(提示, "正在复制自动记忆……")
        记忆数 = 复制目录树(记忆源, 路径_合并(包目录, "cli-memories"))
        追加日志("自动记忆：" + 到文本(记忆数) + " 个文件")

        控件_设置文本(提示, "正在复制自定义技能……")
        技能数 = 复制目录树(技能源, 路径_合并(包目录, "skills"))
        追加日志("自定义技能：" + 到文本(技能数) + " 个文件")

        如果 (目录_是否存在(项目源))
            控件_设置文本(提示, "正在复制项目记忆库……")
            项目数 = 复制目录树(项目源, 路径_合并(包目录, "workspaces\ws-0"))
            追加日志("项目记忆库：" + 到文本(项目数) + " 个文件")
        否则
            追加日志("跳过：项目记忆库不存在 " + 项目源)
        如果结束

        清单 = "{" + "\n"
        清单 = 清单 + "  \"packedAt\": \"" + 打包时间 + "\"" + "," + "\n"
        清单 = 清单 + "  \"computer\": \"" + 系统_取计算机名() + "\"" + "," + "\n"
        清单 = 清单 + "  \"cliMemories\": " + 到文本(记忆数) + "," + "\n"
        清单 = 清单 + "  \"skills\": " + 到文本(技能数) + "," + "\n"
        清单 = 清单 + "  \"workspaceMemory\": " + 到文本(项目数) + "\n"
        清单 = 清单 + "}" + "\n"
        文件_写入文本(路径_合并(包目录, "manifest.json"), 清单)

        控件_设置文本(提示, "正在压缩打包……")
        ZIP路径 = 路径_合并(下载目录, "zcode-memory-pack-" + 时间标记 + ".zip")
        压缩成功 = 压缩_ZIP创建(包目录, ZIP路径)
        如果 (压缩成功)
            目录_删除树(临时根)
            追加日志("=== 打包完成 ===")
            追加日志("自动记忆：" + 到文本(记忆数) + " 个，自定义技能：" + 到文本(技能数) + " 个，项目记忆库：" + 到文本(项目数) + " 个")
            追加日志("ZIP 文件：" + ZIP路径)
            控件_设置文本(提示, "打包完成")
        否则
            追加日志("错误：压缩失败 " + 压缩_取错误())
            追加日志("临时目录保留：" + 临时根)
            控件_设置文本(提示, "打包失败：压缩出错")
        如果结束
    结束

    事件 _开始还原_被单击()
        局部 文本型 工作区
        局部 文本型 用户目录
        局部 文本型 临时目录
        局部 文本型 时间标记
        局部 文本型 临时根
        局部 文本型 包目录
        局部 文本型 备份根
        局部 文本型 记忆目标
        局部 文本型 技能目标
        局部 文本型 项目目标
        局部 文本型 记忆包
        局部 文本型 技能包
        局部 文本型 项目包
        局部 文本型 ZIP路径
        局部 整数型 记忆数 = 0
        局部 整数型 技能数 = 0
        局部 整数型 项目数 = 0
        局部 逻辑型 解压成功 = 假

        工作区 = 控件_取文本(工作区路径输入)
        如果 (工作区 = "")
            控件_设置文本(提示, "还原失败：工作区路径为空")
            追加日志("错误：工作区路径为空")
            返回()
        如果结束
        ZIP路径 = 控件_取文本(包路径输入)
        如果 (ZIP路径 = "")
            控件_设置文本(提示, "还原失败：请填写迁移包路径")
            追加日志("错误：迁移包路径为空")
            返回()
        如果结束
        如果 (文件_是否存在(ZIP路径) = 假)
            控件_设置文本(提示, "还原失败：迁移包不存在")
            追加日志("错误：找不到迁移包 " + ZIP路径)
            返回()
        如果结束
        用户目录 = 系统_取环境变量("USERPROFILE")
        时间标记 = 时间_格式化当前("%Y%m%d-%H%M%S")

        追加日志("=== 开始还原 ===")
        追加日志("迁移包：" + ZIP路径)

        临时目录 = 系统_取环境变量("TEMP")
        如果 (临时目录 = "")
            临时目录 = 用户目录
        如果结束
        临时根 = 路径_合并(临时目录, "zcode-memory-restore-" + 时间标记)
        如果 (目录_是否存在(临时根))
            目录_删除树(临时根)
        如果结束
        目录_创建(临时根)
        控件_设置文本(提示, "正在解压迁移包……")
        解压成功 = 压缩_ZIP解压(ZIP路径, 临时根)
        如果 (解压成功 = 假)
            控件_设置文本(提示, "还原失败：解压出错")
            追加日志("错误：解压失败 " + 压缩_取错误())
            返回()
        如果结束
        包目录 = 路径_合并(临时根, "package")
        如果 (目录_是否存在(包目录) = 假)
            包目录 = 临时根
        如果结束

        记忆目标 = 路径_合并(用户目录, ".zcode\cli\memories")
        技能目标 = 路径_合并(用户目录, ".zcode\skills")
        项目目标 = 路径_合并(工作区, ".zcode\memory")
        备份根 = 路径_合并(路径_合并(用户目录, ".zcode\backup\memory-migration"), 时间标记)
        目录_创建(备份根)

        控件_设置文本(提示, "正在备份本机现有记忆……")
        如果 (目录_是否存在(记忆目标))
            复制目录树(记忆目标, 路径_合并(备份根, "cli-memories"))
            追加日志("已备份自动记忆：" + 路径_合并(备份根, "cli-memories"))
        否则
            追加日志("跳过备份：本机没有自动记忆目录")
        如果结束
        如果 (目录_是否存在(技能目标))
            复制目录树(技能目标, 路径_合并(备份根, "skills"))
            追加日志("已备份自定义技能：" + 路径_合并(备份根, "skills"))
        否则
            追加日志("跳过备份：本机没有技能目录")
        如果结束
        如果 (目录_是否存在(项目目标))
            复制目录树(项目目标, 路径_合并(备份根, "workspace-memory"))
            追加日志("已备份项目记忆库：" + 路径_合并(备份根, "workspace-memory"))
        否则
            追加日志("跳过备份：本机没有项目记忆库")
        如果结束

        控件_设置文本(提示, "正在还原自动记忆……")
        记忆包 = 路径_合并(包目录, "cli-memories")
        如果 (目录_是否存在(记忆包))
            记忆数 = 复制目录树(记忆包, 记忆目标)
            追加日志("自动记忆已还原：" + 到文本(记忆数) + " 个文件")
        否则
            追加日志("跳过：迁移包里没有自动记忆")
        如果结束

        控件_设置文本(提示, "正在还原自定义技能……")
        技能包 = 路径_合并(包目录, "skills")
        如果 (目录_是否存在(技能包))
            技能数 = 复制目录树(技能包, 技能目标)
            追加日志("自定义技能已还原：" + 到文本(技能数) + " 个文件")
        否则
            追加日志("跳过：迁移包里没有自定义技能")
        如果结束

        控件_设置文本(提示, "正在还原项目记忆库……")
        项目包 = 路径_合并(包目录, "workspaces\ws-0")
        如果 (目录_是否存在(项目包))
            项目数 = 复制目录树(项目包, 项目目标)
            追加日志("项目记忆库已还原：" + 到文本(项目数) + " 个文件")
        否则
            追加日志("跳过：迁移包里没有项目记忆库")
        如果结束

        目录_删除树(临时根)
        追加日志("=== 还原完成 ===")
        追加日志("自动记忆：" + 到文本(记忆数) + " 个，自定义技能：" + 到文本(技能数) + " 个，项目记忆库：" + 到文本(项目数) + " 个")
        追加日志("备份目录：" + 备份根)
        控件_设置文本(提示, "还原完成，请重启 ZCode 验证记忆")
    结束

    空 追加日志(文本型 新行)
        局部 文本型 当前文本
        当前文本 = 控件_取文本(日志)
        如果 (当前文本 = "")
            控件_设置文本(日志, 新行)
        否则
            控件_设置文本(日志, 当前文本 + "\n" + 新行)
        如果结束
        编辑框_滚动到底(日志)
    结束

    整数型 复制目录树(文本型 来源目录, 文本型 目标目录)
        局部 文本型 文件列表[]
        局部 文本型 子目录列表[]
        局部 文本型 来源文件
        局部 文本型 目标文件
        局部 文本型 来源子目录
        局部 文本型 目标子目录
        局部 整数型 文件数 = 0
        局部 整数型 子目录数 = 0
        局部 整数型 序号 = 0
        局部 整数型 已复制 = 0
        局部 逻辑型 复制成功 = 假

        如果 (目录_是否存在(来源目录) = 假)
            返回(0)
        如果结束
        目录_创建(目标目录)

        文件数 = 文件_枚举(来源目录, "", 假, 文件列表)
        计次循环首 (文件数, 序号)
            来源文件 = 数组_取成员(文件列表, 序号 - 1)
            目标文件 = 路径_合并(目标目录, 路径_取文件名(来源文件))
            复制成功 = 文件_复制(来源文件, 目标文件, 真)
            如果 (复制成功)
                已复制 = 已复制 + 1
            否则
                追加日志("跳过: " + 来源文件)
            如果结束
        计次循环尾

        子目录数 = 目录_枚举(来源目录, 假, 子目录列表)
        计次循环首 (子目录数, 序号)
            来源子目录 = 数组_取成员(子目录列表, 序号 - 1)
            目标子目录 = 路径_合并(目标目录, 路径_取文件名(来源子目录))
            已复制 = 已复制 + 复制目录树(来源子目录, 目标子目录)
        计次循环尾
        返回(已复制)
    结束
结束类
