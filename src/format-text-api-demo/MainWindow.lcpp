包 格式化文本完整能力示例
使用 Win32窗口基础模块
使用 Win32高级控件模块

类 MainWindow : 公开 窗体
    事件 _MainWindow_创建完毕()
        控件_设置选择项("演示选项卡", 0)
        控件_设置文本("底部状态", 格式化文本("已加载：{}；当前共有 {} 个能力分组。", "格式化文本完整能力示例", 4))
        调试输出(格式化文本("启动检查：中文={}，整数={}，逻辑={}", "正常", 2026, 真))
    结束

    // 01：从真实输入框读取文本，把文本和整数填入多个顺序占位符。
    事件 _基础执行按钮_被单击()
        局部 文本型 姓名 = ""
        局部 整数型 年龄 = 0
        局部 文本型 结果 = ""
        姓名 = 控件_取文本("基础姓名输入")
        年龄 = 到整数(控件_取文本("基础年龄输入"))
        结果 = 格式化文本("你好，{}！你今年 {} 岁；{} 个占位符已按顺序替换。", 姓名, 年龄, 3)
        控件_设置文本("基础结果", 结果)
        控件_设置文本("底部状态", 格式化文本("基础替换完成：姓名={}，年龄={}", 姓名, 年龄))
    结束

    // 02：一次覆盖命令支持的全部值类型；逻辑值稳定输出“真”或“假”。
    事件 _类型执行按钮_被单击()
        局部 文本型 文本值 = "中文与 emoji：🚀"
        局部 整数型 整数值 = -42
        局部 长整数型 长整数值 = 9876543210
        局部 小数型 小数值 = 3.5
        局部 双精度小数型 双精度值 = 3.14159265358979
        局部 逻辑型 真值 = 真
        局部 逻辑型 假值 = 假
        局部 文本型 结果 = ""
        结果 = 格式化文本("文本={} | 整数={} | 长整数={} | 小数={} | 双精度={} | 真值={} | 假值={}", 文本值, 整数值, 长整数值, 小数值, 双精度值, 真值, 假值)
        控件_设置文本("类型结果", 结果)
        控件_设置文本("底部状态", "已验证文本、整数、长整数、小数、双精度小数和逻辑值。")
    结束

    // 03：双花括号输出字面量花括号，不消费参数。
    事件 _花括号执行按钮_被单击()
        局部 文本型 结果 = ""
        结果 = 格式化文本("对象外观：{{名称={}，状态={{}}}}", "LingBuilder")
        控件_设置文本("花括号结果", 结果)
        控件_设置文本("底部状态", "{{ 与 }} 已作为字面量花括号输出。")
    结束

    // 04：参数不足时保留剩余 {}，多余参数不会追加到结果尾部。
    事件 _边界执行按钮_被单击()
        局部 文本型 参数不足 = ""
        局部 文本型 参数多余 = ""
        参数不足 = 格式化文本("不足：{} / {} / {}", "只替换第一个")
        参数多余 = 格式化文本("多余：{}", "只使用第一个", "不会出现", 999)
        控件_设置文本("边界结果", 格式化文本("{}\r\n{}", 参数不足, 参数多余))
        控件_设置文本("底部状态", "已验证参数不足保留占位符、多余参数忽略。")
    结束

    // 05：没有占位符时原样返回格式模板；传入的多余参数被忽略。
    事件 _无占位执行按钮_被单击()
        控件_设置文本("无占位结果", 格式化文本("这段模板没有占位符，会保持原样。", 123, 假, "多余"))
        控件_设置文本("底部状态", "已验证零占位符模板和多余参数安全降级。")
    结束

    // 06：格式化结果可以嵌套为另一个格式化参数，并直接写入控件。
    事件 _嵌套执行按钮_被单击()
        局部 文本型 内层 = ""
        局部 文本型 外层 = ""
        内层 = 格式化文本("版本 {}.{}", 0, 2)
        外层 = 格式化文本("外层消息：[{}]；构建状态={}", 内层, "通过")
        控件_设置文本("嵌套结果", 外层)
        控件_设置文本("底部状态", "已验证返回值赋值、嵌套调用和控件文本写入。")
    结束

    // 07：真实业务场景——输入商品、单价和数量，计算后生成完整摘要。
    事件 _场景执行按钮_被单击()
        局部 文本型 商品 = ""
        局部 整数型 单价 = 0
        局部 整数型 数量 = 0
        局部 整数型 小计 = 0
        局部 文本型 摘要 = ""
        商品 = 控件_取文本("场景商品输入")
        单价 = 到整数(控件_取文本("场景单价输入"))
        数量 = 到整数(控件_取文本("场景数量输入"))
        小计 = 单价 * 数量
        摘要 = 格式化文本("订单：{} | 单价={} 元 | 数量={} | 小计={} 元", 商品, 单价, 数量, 小计)
        控件_设置文本("场景结果", 摘要)
        控件_设置文本("底部状态", 格式化文本("场景计算完成，小计={} 元。", 小计))
    结束

    // 08：返回文本可直接传给信息框。
    事件 _弹出结果按钮_被单击()
        信息框(格式化文本("当前订单摘要：\r\n{}", 控件_取文本("场景结果")), 64, "格式化文本演示")
    结束

    // 09：返回文本可直接传给调试输出，便于日志记录。
    事件 _调试结果按钮_被单击()
        调试输出(格式化文本("[格式化日志] 页面={}，结果={}", 控件_取选择项("演示选项卡"), 控件_取文本("场景结果")))
        控件_设置文本("底部状态", "格式化结果已写入调试输出。")
    结束

    事件 _演示选项卡_标签页被改变()
        控件_设置文本("底部状态", 格式化文本("已切换到第 {} 个能力分组（索引从 0 开始）。", 控件_取选择项("演示选项卡")))
    结束
结束类
