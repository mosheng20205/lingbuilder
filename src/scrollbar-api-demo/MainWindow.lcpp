包 ScrollBar完整示例
使用 Win32窗口基础模块
使用 Win32高级控件模块

类 MainWindow : 公开 窗体
    事件 _MainWindow_创建完毕()
        控件_设置文本(接口状态, "已加载：ScrollBar 全部公开接口演示")
        更新基础数值文本()
        更新范围数值文本()
        更新联动数值文本()
    结束

    事件 _功能选项卡_标签页被改变()
        控件_设置文本(接口状态, "选项卡已切换：可以继续操作当前页的 ScrollBar")
    结束

    空 更新基础数值文本()
        控件_设置文本(垂直当前值, "当前值：" + 到文本(控件_取数值(垂直滚动条)))
        控件_设置文本(水平当前值, "当前值：" + 到文本(控件_取数值(水平滚动条)))
    结束

    空 更新范围数值文本()
        控件_设置文本(范围当前值, "当前值：" + 到文本(控件_取数值(范围演示条)) + "（范围 10 - 90）")
    结束

    空 更新联动数值文本()
        控件_设置文本(联动垂直值, "垂直值：" + 到文本(控件_取数值(联动垂直条)))
        控件_设置文本(联动水平值, "水平值：" + 到文本(控件_取数值(联动水平条)))
    结束

    事件 _垂直滚动条_数值被改变()
        控件_设置文本(垂直当前值, "当前值：" + 到文本(控件_取数值(垂直滚动条)))
        控件_设置文本(接口状态, "ValueChanged 事件：垂直滚动条数值已改变")
    结束

    事件 _水平滚动条_数值被改变()
        控件_设置文本(水平当前值, "当前值：" + 到文本(控件_取数值(水平滚动条)))
        控件_设置文本(接口状态, "ValueChanged 事件：水平滚动条数值已改变")
    结束

    事件 _范围演示条_数值被改变()
        更新范围数值文本()
        控件_设置文本(接口状态, "ValueChanged 事件：范围演示条数值已改变")
    结束

    事件 _读写测试按钮_被单击()
        局部 整数型 垂直值 = 0
        局部 整数型 水平值 = 0
        垂直值 = 控件_取数值(垂直滚动条)
        水平值 = 控件_取数值(水平滚动条)
        控件_设置文本(接口状态, "读取成功：垂直=" + 到文本(垂直值) + "，水平=" + 到文本(水平值))
        更新基础数值文本()
    结束

    事件 _设为中间按钮_被单击()
        控件_设置数值(垂直滚动条, 50)
        控件_设置数值(水平滚动条, 50)
        控件_设置文本(接口状态, "设置数值成功：两个滚动条均已设为 50")
        更新基础数值文本()
    结束

    事件 _设为最小按钮_被单击()
        控件_设置数值(垂直滚动条, 0)
        控件_设置数值(水平滚动条, 0)
        控件_设置文本(接口状态, "边界测试：已设置为最小值 0")
        更新基础数值文本()
    结束

    事件 _设为最大按钮_被单击()
        控件_设置数值(垂直滚动条, 100)
        控件_设置数值(水平滚动条, 100)
        控件_设置文本(接口状态, "边界测试：已设置为最大值 100")
        更新基础数值文本()
    结束

    事件 _禁用垂直按钮_被单击()
        控件_设置启用(垂直滚动条, 假)
        控件_设置文本(接口状态, "控件_设置启用：垂直滚动条已禁用")
    结束

    事件 _重新启用按钮_被单击()
        控件_设置启用(垂直滚动条, 真)
        控件_设置文本(接口状态, "控件_设置启用：垂直滚动条已重新启用")
    结束

    事件 _隐藏水平按钮_被单击()
        控件_设置可见(水平滚动条, 假)
        控件_设置文本(接口状态, "控件_设置可见：水平滚动条已隐藏")
    结束

    事件 _显示水平按钮_被单击()
        控件_设置可见(水平滚动条, 真)
        控件_设置文本(接口状态, "控件_设置可见：水平滚动条已显示")
    结束

    事件 _范围设为10按钮_被单击()
        控件_设置数值(范围演示条, 10)
        更新范围数值文本()
        控件_设置文本(接口状态, "范围条已设为最小值 10")
    结束

    事件 _范围设为50按钮_被单击()
        控件_设置数值(范围演示条, 50)
        更新范围数值文本()
        控件_设置文本(接口状态, "范围条已设为中间值 50")
    结束

    事件 _范围设为90按钮_被单击()
        控件_设置数值(范围演示条, 90)
        更新范围数值文本()
        控件_设置文本(接口状态, "范围条已设为最大值 90")
    结束

    事件 _移动范围条按钮_被单击()
        控件_设置位置大小(范围演示条, 300, 112, 24, 250)
        控件_设置文本(接口状态, "控件_设置位置大小：范围条已移动并调整为 24×250")
    结束

    事件 _恢复范围条按钮_被单击()
        控件_设置位置大小(范围演示条, 120, 112, 24, 250)
        控件_设置文本(接口状态, "控件_设置位置大小：范围条已恢复原位置")
    结束

    事件 _联动垂直条_数值被改变()
        局部 整数型 当前值 = 0
        当前值 = 控件_取数值(联动垂直条)
        控件_设置数值(联动水平条, 当前值)
        控件_设置文本(联动垂直值, "垂直值：" + 到文本(当前值))
        控件_设置文本(联动水平值, "水平值：" + 到文本(控件_取数值(联动水平条)))
        控件_设置文本(接口状态, "ValueChanged 事件：垂直条已把数值同步到水平条")
    结束

    事件 _联动水平条_数值被改变()
        控件_设置文本(联动水平值, "水平值：" + 到文本(控件_取数值(联动水平条)))
        控件_设置文本(接口状态, "ValueChanged 事件：水平滚动条数值已改变")
    结束

    事件 _联动设为25按钮_被单击()
        控件_设置数值(联动垂直条, 25)
        控件_设置数值(联动水平条, 25)
        更新联动数值文本()
        控件_设置文本(接口状态, "联动测试：两个滚动条都已设为 25")
    结束

    事件 _联动设为75按钮_被单击()
        控件_设置数值(联动垂直条, 75)
        控件_设置数值(联动水平条, 75)
        更新联动数值文本()
        控件_设置文本(接口状态, "联动测试：两个滚动条都已设为 75")
    结束

    事件 _读取当前页按钮_被单击()
        局部 整数型 当前页 = 0
        当前页 = 控件_取选择项(功能选项卡)
        控件_设置文本(接口状态, "控件_取选择项：当前选项卡索引为 " + 到文本(当前页))
    结束

    事件 _跳到范围页按钮_被单击()
        控件_设置选择项(功能选项卡, 1)
        控件_设置文本(接口状态, "控件_设置选择项：已跳转到“范围与方向”标签页")
    结束
结束类
