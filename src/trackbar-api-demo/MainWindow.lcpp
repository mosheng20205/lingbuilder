包 Win32滑块TrackBar完整接口示例
使用 Win32窗口基础模块
使用 Win32高级控件模块

类 MainWindow : 公开 窗体
    事件 _MainWindow_创建完毕()
        控件_设置文本(接口状态, "已加载：TrackBar / 滑块完整接口演示，请从选项卡逐项操作。")
        更新基础数值()
        更新范围数值()
        更新联动数值()
        调试输出("TrackBar 示例已启动")
    结束

    空 更新基础数值()
        控件_设置文本(基础水平值, "当前值：" + 到文本(控件_取数值(基础水平滑块)))
        控件_设置文本(基础垂直值, "当前值：" + 到文本(控件_取数值(基础垂直滑块)))
    结束

    空 更新范围数值()
        控件_设置文本(范围当前值, "当前值：" + 到文本(控件_取数值(范围滑块)) + "（范围 10 - 90）")
        控件_设置文本(刻度当前值, "当前值：" + 到文本(控件_取数值(刻度滑块)) + "（刻度间隔 100）")
    结束

    空 更新联动数值()
        控件_设置文本(联动源值, "源滑块：" + 到文本(控件_取数值(联动源滑块)))
        控件_设置文本(联动目标值, "目标滑块：" + 到文本(控件_取数值(联动目标滑块)))
    结束

    事件 _功能选项卡_标签页被改变()
        控件_设置文本(接口状态, "选项卡已切换：当前索引 = " + 到文本(控件_取选择项(功能选项卡)))
    结束

    事件 _读取基础值按钮_被单击()
        局部 整数型 水平值 = 0
        局部 整数型 垂直值 = 0
        水平值 = 控件_取数值(基础水平滑块)
        垂直值 = 控件_取数值(基础垂直滑块)
        控件_设置文本(接口状态, "控件_取数值：水平=" + 到文本(水平值) + "，垂直=" + 到文本(垂直值))
        调试输出("基础水平滑块当前值：", 水平值, 真)
        调试输出("基础垂直滑块当前值：", 垂直值, 真)
    结束

    事件 _设置基础中间值按钮_被单击()
        控件_设置数值(基础水平滑块, 50)
        控件_设置数值(基础垂直滑块, 50)
        更新基础数值()
        控件_设置文本(接口状态, "控件_设置数值：两个基础滑块已设置为 50。")
    结束

    事件 _设置基础最小值按钮_被单击()
        控件_设置数值(基础水平滑块, 0)
        控件_设置数值(基础垂直滑块, 0)
        更新基础数值()
        控件_设置文本(接口状态, "边界测试：已设置为最小值 0。")
    结束

    事件 _设置基础最大值按钮_被单击()
        控件_设置数值(基础水平滑块, 100)
        控件_设置数值(基础垂直滑块, 100)
        更新基础数值()
        控件_设置文本(接口状态, "边界测试：已设置为最大值 100。")
    结束

    事件 _禁用基础水平按钮_被单击()
        控件_设置启用(基础水平滑块, 假)
        控件_设置文本(接口状态, "控件_设置启用：基础水平滑块已禁用。")
    结束

    事件 _启用基础水平按钮_被单击()
        控件_设置启用(基础水平滑块, 真)
        控件_设置文本(接口状态, "控件_设置启用：基础水平滑块已启用。")
    结束

    事件 _基础水平滑块_数值被改变()
        更新基础数值()
        控件_设置文本(接口状态, "数值被改变事件：基础水平滑块 = " + 到文本(控件_取数值(基础水平滑块)))
    结束

    事件 _基础垂直滑块_数值被改变()
        更新基础数值()
        控件_设置文本(接口状态, "数值被改变事件：基础垂直滑块 = " + 到文本(控件_取数值(基础垂直滑块)))
    结束

    事件 _读取范围值按钮_被单击()
        控件_设置文本(接口状态, "控件_取数值：范围=" + 到文本(控件_取数值(范围滑块)) + "，刻度=" + 到文本(控件_取数值(刻度滑块)))
    结束

    事件 _范围设为最小按钮_被单击()
        控件_设置数值(范围滑块, 10)
        更新范围数值()
        控件_设置文本(接口状态, "控件_设置数值：范围滑块已设为最小值 10。")
    结束

    事件 _范围设为中间按钮_被单击()
        控件_设置数值(范围滑块, 50)
        更新范围数值()
        控件_设置文本(接口状态, "控件_设置数值：范围滑块已设为中间值 50。")
    结束

    事件 _范围设为最大按钮_被单击()
        控件_设置数值(范围滑块, 90)
        更新范围数值()
        控件_设置文本(接口状态, "控件_设置数值：范围滑块已设为最大值 90。")
    结束

    事件 _移动范围滑块按钮_被单击()
        控件_设置位置大小(范围滑块, 300, 125, 560, 36)
        控件_设置文本(接口状态, "控件_设置位置大小：范围滑块已移动并调整为 560×36。")
    结束

    事件 _恢复范围滑块按钮_被单击()
        控件_设置位置大小(范围滑块, 60, 130, 580, 36)
        控件_设置文本(接口状态, "已恢复范围滑块的设计器位置和大小。")
    结束

    事件 _隐藏刻度滑块按钮_被单击()
        控件_设置可见(刻度滑块, 假)
        控件_设置文本(接口状态, "控件_设置可见：刻度滑块已隐藏。")
    结束

    事件 _显示刻度滑块按钮_被单击()
        控件_设置可见(刻度滑块, 真)
        控件_设置文本(接口状态, "控件_设置可见：刻度滑块已显示。")
    结束

    事件 _范围滑块_数值被改变()
        更新范围数值()
        控件_设置文本(接口状态, "数值被改变事件：范围滑块 = " + 到文本(控件_取数值(范围滑块)))
    结束

    事件 _刻度滑块_数值被改变()
        更新范围数值()
        控件_设置文本(接口状态, "数值被改变事件：刻度滑块 = " + 到文本(控件_取数值(刻度滑块)))
    结束

    事件 _联动源滑块_数值被改变()
        局部 整数型 当前值 = 0
        当前值 = 控件_取数值(联动源滑块)
        控件_设置数值(联动目标滑块, 当前值)
        更新联动数值()
        控件_设置文本(接口状态, "数值被改变事件：源滑块已同步目标滑块，当前值 = " + 到文本(当前值))
    结束

    事件 _联动目标滑块_数值被改变()
        更新联动数值()
        控件_设置文本(接口状态, "数值被改变事件：目标滑块发生变化。")
    结束

    事件 _联动设为25按钮_被单击()
        控件_设置数值(联动源滑块, 25)
        控件_设置数值(联动目标滑块, 25)
        更新联动数值()
        控件_设置文本(接口状态, "联动测试：两个滑块已设为 25。")
    结束

    事件 _联动设为75按钮_被单击()
        控件_设置数值(联动源滑块, 75)
        控件_设置数值(联动目标滑块, 75)
        更新联动数值()
        控件_设置文本(接口状态, "联动测试：两个滑块已设为 75。")
    结束

    事件 _读取当前页按钮_被单击()
        控件_设置文本(接口状态, "控件_取选择项：当前选项卡索引 = " + 到文本(控件_取选择项(功能选项卡)))
    结束

    事件 _跳到范围页按钮_被单击()
        控件_设置选择项(功能选项卡, 1)
        控件_设置文本(接口状态, "控件_设置选择项：已跳转到“范围、刻度与布局”。")
    结束
结束类
