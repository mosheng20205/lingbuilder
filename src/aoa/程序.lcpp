包 控制台程序

类 程序
公开
  整数型 启动()
    // AOA 模块验收探针（2026-10-21 二轮）
    // 红线：生成器把「带初始化的局部声明」整体提升到函数最前、按声明序执行——
    // 所以全部零初始化声明，赋值严格按执行序写（否则错误文本会互相覆盖）。
    局部 AOA设备 设备
    局部 长整数型 通道 = 0
    局部 字节集 帧
    局部 文本型 错误 = ""
    局部 整数型 帧数 = 0
    局部 整数型 拍 = 0
    局部 长整数型 起 = 0
    局部 长整数型 耗 = 0

    // ① 列表
    调试输出("=== 设备列表 ===")
    调试输出(AOA_取设备列表())

    // ② 问题 1：MI 8（FF40，MIUI 不保配件）应在 45 秒内失败且报「已回退」
    调试输出("=== 问题1: 打开 6929b744（回退场景，预算 45 秒）===")
    起 = AOA_取时钟()
    设备 = AOA_打开设备("6929b744")
    耗 = AOA_取时钟() - 起
    如果 (设备 = 0)
      调试输出("P1 失败 耗时=" + 到文本(耗) + "ms：" + AOA_取错误())
    否则
      调试输出("P1 打开成功 耗时=" + 到文本(耗) + "ms（手机保持了配件模式）")
      AOA_关闭设备(设备)
    如果结束

    // ③ 问题 2：FF48 复合形态（调试开）——不存在时应快速给出处置；存在时应 1 秒内报处置
    调试输出("=== 问题2: 打开 2717:ff48（USB 调试复合形态）===")
    起 = AOA_取时钟()
    设备 = AOA_打开设备("2717:ff48")
    耗 = AOA_取时钟() - 起
    如果 (设备 = 0)
      调试输出("P2 失败 耗时=" + 到文本(耗) + "ms：" + AOA_取错误())
    否则
      调试输出("P2 打开成功 耗时=" + 到文本(耗) + "ms")
      AOA_关闭设备(设备)
    如果结束

    // ④ 回归：Mi 10（FF40）切换配件 + 数据通道
    调试输出("=== 回归: 打开 b3cf0c91（FF40 切换）===")
    起 = AOA_取时钟()
    设备 = AOA_打开设备("b3cf0c91")
    耗 = AOA_取时钟() - 起
    如果 (设备 = 0)
      调试输出("回归失败 耗时=" + 到文本(耗) + "ms：" + AOA_取错误())
      返回(1)
    如果结束
    调试输出("回归打开成功 耗时=" + 到文本(耗) + "ms（句柄=" + 到文本(设备) + "）")
    通道 = AOA_打开数据通道(设备, 1500)
    调试输出("数据通道句柄=" + 到文本(通道) + " 错误=" + AOA_取错误())

    // ⑤ 收帧若干拍（拔线/移除节点时应由宿主自愈，不崩）
    如果 (通道 > 0)
      计次循环首 (20, 拍)
        帧 = AOA_数据通道收帧(通道, 200)
        如果 (字节集_长度(帧) > 0)
          帧数 = 帧数 + 1
        否则
          错误 = AOA_取错误()
          如果 (错误 <> "")
            调试输出("通道已断（第 " + 到文本(拍) + " 拍）：" + 错误)
            跳出循环()
          如果结束
        如果结束
      计次循环尾 ()
      调试输出("收帧结束：帧数=" + 到文本(帧数) + " 存活=是")
      AOA_关闭数据通道(通道)
    如果结束
    AOA_关闭设备(设备)
    调试输出("清理完成")
    返回(0)
  结束
结束类
