包 DataGrid新手逐项示例
使用 Win32窗口基础模块
使用 Win32高级控件模块

类 MainWindow : 公开 窗体
    // 初始列和三行示例数据来自设计器模型，因此启动时不需要批量调用表格接口。
    事件 _MainWindow_创建完毕()
        控件_设置文本(操作结果, "操作结果：请选择右侧选项卡，每个按钮只执行一条 DataGrid 接口。")
        控件_设置文本(事件日志, "事件日志：请直接单击、双击或编辑左侧表格。")
    结束

    // 01. 表格_添加列(控件名, 列ID, 标题, 类型, 宽度)
    // 追加具有稳定列 ID 的强类型列。
    事件 _接口01_添加列_被单击()
        调试输出("表格_添加列 返回值：", 表格_添加列(静态表格, "demo-column", "演示列", "text", 110), 真)
        控件_设置文本(操作结果, "已单独执行 01：表格_添加列；返回值见输出面板。")
    结束

    // 02. 表格_插入列(控件名, 索引, 列ID, 标题, 类型, 宽度)
    // 在指定位置插入强类型列。
    事件 _接口02_插入列_被单击()
        调试输出("表格_插入列 返回值：", 表格_插入列(静态表格, 1, "demo-insert-column", "插入演示列", "text", 120), 真)
        控件_设置文本(操作结果, "已单独执行 02：表格_插入列；返回值见输出面板。")
    结束

    // 03. 表格_删除列(控件名, 列ID)
    // 删除列并同步删除全部行中的对应单元格。
    事件 _接口03_删除列_被单击()
        调试输出("表格_删除列 返回值：", 表格_删除列(静态表格, "demo-column"), 真)
        控件_设置文本(操作结果, "已单独执行 03：表格_删除列；返回值见输出面板。")
    结束

    // 04. 表格_设置列标题(控件名, 列ID, 标题)
    // 设置列标题。
    事件 _接口04_设置列标题_被单击()
        调试输出("表格_设置列标题 返回值：", 表格_设置列标题(静态表格, "order_no", "订单编号"), 真)
        控件_设置文本(操作结果, "已单独执行 04：表格_设置列标题；返回值见输出面板。")
    结束

    // 05. 表格_设置列宽度(控件名, 列ID, 宽度)
    // 设置列宽度。
    事件 _接口05_设置列宽度_被单击()
        调试输出("表格_设置列宽度 返回值：", 表格_设置列宽度(静态表格, "order_no", 150), 真)
        控件_设置文本(操作结果, "已单独执行 05：表格_设置列宽度；返回值见输出面板。")
    结束

    // 06. 表格_设置列对齐(控件名, 列ID, 对齐方式)
    // 设置列为 left/center/right（居左/居中/居右）。
    事件 _接口06_设置列对齐_被单击()
        调试输出("表格_设置列对齐 返回值：", 表格_设置列对齐(静态表格, "order_no", "left"), 真)
        控件_设置文本(操作结果, "已单独执行 06：表格_设置列对齐；返回值见输出面板。")
    结束

    // 07. 表格_设置列只读(控件名, 列ID, 只读)
    // 设置列只读状态。
    事件 _接口07_设置列只读_被单击()
        调试输出("表格_设置列只读 返回值：", 表格_设置列只读(静态表格, "order_no", 真), 真)
        控件_设置文本(操作结果, "已单独执行 07：表格_设置列只读；返回值见输出面板。")
    结束

    // 08. 表格_设置列显示(控件名, 列ID, 显示)
    // 设置列显示状态。
    事件 _接口08_设置列显示_被单击()
        调试输出("表格_设置列显示 返回值：", 表格_设置列显示(静态表格, "date", 假), 真)
        控件_设置文本(操作结果, "已单独执行 08：表格_设置列显示；返回值见输出面板。")
    结束

    // 09. 表格_设置列冻结(控件名, 列ID, 冻结)
    // 设置列冻结状态。
    事件 _接口09_设置列冻结_被单击()
        调试输出("表格_设置列冻结 返回值：", 表格_设置列冻结(静态表格, "order_no", 真), 真)
        控件_设置文本(操作结果, "已单独执行 09：表格_设置列冻结；返回值见输出面板。")
    结束

    // 10. 表格_设置列格式(控件名, 列ID, 格式)
    // 设置日期、数字等列的显示格式。
    事件 _接口10_设置列格式_被单击()
        调试输出("表格_设置列格式 返回值：", 表格_设置列格式(静态表格, "amount", "0.00"), 真)
        控件_设置文本(操作结果, "已单独执行 10：表格_设置列格式；返回值见输出面板。")
    结束

    // 11. 表格_取列数(控件名)
    // 返回当前列数。
    事件 _接口11_取列数_被单击()
        调试输出("表格_取列数 返回值：", 表格_取列数(静态表格), 真)
        控件_设置文本(操作结果, "已单独执行 11：表格_取列数；返回值见输出面板。")
    结束

    // 12. 表格_添加列选项(控件名, 列ID, 值, 显示文字)
    // 向组合框列追加稳定值与中文显示文字。
    事件 _接口12_添加列选项_被单击()
        调试输出("表格_添加列选项 返回值：", 表格_添加列选项(静态表格, "status", "waiting", "待处理"), 真)
        控件_设置文本(操作结果, "已单独执行 12：表格_添加列选项；返回值见输出面板。")
    结束

    // 13. 表格_清空列选项(控件名, 列ID)
    // 清空组合框列选项。
    事件 _接口13_清空列选项_被单击()
        调试输出("表格_清空列选项 返回值：", 表格_清空列选项(静态表格, "status"), 真)
        控件_设置文本(操作结果, "已单独执行 13：表格_清空列选项；返回值见输出面板。")
    结束

    // 14. 表格_设置单元格组合框选项(控件名, 行键, 列ID, 选项TSV)
    // 用 TSV 覆盖单元格组合框选项。
    事件 _接口14_设置单元格组合框选项_被单击()
        调试输出("表格_设置单元格组合框选项 返回值：", 表格_设置单元格组合框选项(静态表格, "order-1001", "status", "processing\t处理中\ndone\t已完成"), 真)
        控件_设置文本(操作结果, "已单独执行 14：表格_设置单元格组合框选项；返回值见输出面板。")
    结束

    // 15. 表格_设置选择框三态(控件名, 列ID, 启用三态)
    // 允许选择框使用 null 作为第三态。
    事件 _接口15_设置选择框三态_被单击()
        调试输出("表格_设置选择框三态 返回值：", 表格_设置选择框三态(静态表格, "select", 真), 真)
        控件_设置文本(操作结果, "已单独执行 15：表格_设置选择框三态；返回值见输出面板。")
    结束

    // 16. 表格_设置开关文字(控件名, 列ID, 开启文字, 关闭文字)
    // 设置 Switch 的开启和关闭文字。
    事件 _接口16_设置开关文字_被单击()
        调试输出("表格_设置开关文字 返回值：", 表格_设置开关文字(静态表格, "enabled", "启用", "停用"), 真)
        控件_设置文本(操作结果, "已单独执行 16：表格_设置开关文字；返回值见输出面板。")
    结束

    // 17. 表格_设置图片显示方式(控件名, 列ID, 显示方式)
    // 设置 tile/contain/cover/center/stretch（平铺/等比完整/等比铺满/原始居中/拉伸）图片显示方式。
    事件 _接口17_设置图片显示方式_被单击()
        调试输出("表格_设置图片显示方式 返回值：", 表格_设置图片显示方式(静态表格, "image", "contain"), 真)
        控件_设置文本(操作结果, "已单独执行 17：表格_设置图片显示方式；返回值见输出面板。")
    结束

    // 18. 表格_设置进度范围(控件名, 列ID, 最小值, 最大值, 显示文字)
    // 设置进度列范围及文字显示。
    事件 _接口18_设置进度范围_被单击()
        调试输出("表格_设置进度范围 返回值：", 表格_设置进度范围(静态表格, "progress", 0.0, 100.0, "演示选项"), 真)
        控件_设置文本(操作结果, "已单独执行 18：表格_设置进度范围；返回值见输出面板。")
    结束

    // 19. 表格_添加列按钮(控件名, 列ID, 按钮ID, 文字, 样式)
    // 向按钮列追加稳定按钮 ID。
    事件 _接口19_添加列按钮_被单击()
        调试输出("表格_添加列按钮 返回值：", 表格_添加列按钮(静态表格, "actions", "print", "打印", "normal"), 真)
        控件_设置文本(操作结果, "已单独执行 19：表格_添加列按钮；返回值见输出面板。")
    结束

    // 20. 表格_清空列按钮(控件名, 列ID)
    // 清空按钮列定义。
    事件 _接口20_清空列按钮_被单击()
        调试输出("表格_清空列按钮 返回值：", 表格_清空列按钮(静态表格, "actions"), 真)
        控件_设置文本(操作结果, "已单独执行 20：表格_清空列按钮；返回值见输出面板。")
    结束

    // 21. 表格_添加行(控件名, 行键, 单元格TSV)
    // 追加稳定行键的数据行。
    事件 _接口21_添加行_被单击()
        调试输出("表格_添加行 返回值：", 表格_添加行(静态表格, "demo-row", "0\t2001\t5\t88.80\t2026-08-10\t1\tassets/datagrid-api-demo/datagrid-demo.png\t45\tnew\t"), 真)
        控件_设置文本(操作结果, "已单独执行 21：表格_添加行；返回值见输出面板。")
    结束

    // 22. 表格_插入行(控件名, 索引, 行键, 单元格TSV)
    // 在指定位置插入数据行。
    事件 _接口22_插入行_被单击()
        调试输出("表格_插入行 返回值：", 表格_插入行(静态表格, 1, "demo-insert-row", "0\t2002\t1\t19.90\t2026-08-11\t1\t\t20\tprocessing\t"), 真)
        控件_设置文本(操作结果, "已单独执行 22：表格_插入行；返回值见输出面板。")
    结束

    // 23. 表格_删除行(控件名, 行键)
    // 按稳定行键删除行。
    事件 _接口23_删除行_被单击()
        调试输出("表格_删除行 返回值：", 表格_删除行(静态表格, "demo-row"), 真)
        控件_设置文本(操作结果, "已单独执行 23：表格_删除行；返回值见输出面板。")
    结束

    // 24. 表格_清空行(控件名)
    // 清空全部静态数据行。
    事件 _接口24_清空行_被单击()
        调试输出("表格_清空行 返回值：", 表格_清空行(静态表格), 真)
        控件_设置文本(操作结果, "已单独执行 24：表格_清空行；返回值见输出面板。")
    结束

    // 25. 表格_取行数(控件名)
    // 返回数据行数或虚拟总行数。
    事件 _接口25_取行数_被单击()
        调试输出("表格_取行数 返回值：", 表格_取行数(静态表格), 真)
        控件_设置文本(操作结果, "已单独执行 25：表格_取行数；返回值见输出面板。")
    结束

    // 26. 表格_取显示行键(控件名, 索引)
    // 返回排序筛选后指定显示索引的稳定行键。
    事件 _接口26_取显示行键_被单击()
        调试输出("表格_取显示行键 返回值：", 表格_取显示行键(静态表格, 0), 真)
        控件_设置文本(操作结果, "已单独执行 26：表格_取显示行键；返回值见输出面板。")
    结束

    // 27. 表格_开始批量更新(控件名)
    // 进入可嵌套批量更新并暂停重绘。
    事件 _接口27_开始批量更新_被单击()
        调试输出("表格_开始批量更新 返回值：", 表格_开始批量更新(静态表格), 真)
        控件_设置文本(操作结果, "已单独执行 27：表格_开始批量更新；返回值见输出面板。")
    结束

    // 28. 表格_结束批量更新(控件名)
    // 结束一层批量更新，最外层恢复重绘。
    事件 _接口28_结束批量更新_被单击()
        调试输出("表格_结束批量更新 返回值：", 表格_结束批量更新(静态表格), 真)
        控件_设置文本(操作结果, "已单独执行 28：表格_结束批量更新；返回值见输出面板。")
    结束

    // 29. 表格_加载TSV(控件名, TSV文本, 首行为标题)
    // 按明确的引号和换行规则加载 TSV。
    事件 _接口29_加载TSV_被单击()
        调试输出("表格_加载TSV 返回值：", 表格_加载TSV(静态表格, "选择\t订单号\t数量\t金额\t日期\t启用\t图片\t进度\t状态\t操作\n1\t3001\t2\t66.60\t2026-08-12\t1\t\t50\tnew\t", 真), 真)
        控件_设置文本(操作结果, "已单独执行 29：表格_加载TSV；返回值见输出面板。")
    结束

    // 30. 表格_导出TSV(控件名, 包含标题)
    // 导出可往返的 TSV。
    事件 _接口30_导出TSV_被单击()
        调试输出("表格_导出TSV 返回值：", 表格_导出TSV(静态表格, 真), 真)
        控件_设置文本(操作结果, "已单独执行 30：表格_导出TSV；返回值见输出面板。")
    结束

    // 31. 表格_导入CSV(控件名, CSV文本, 首行为标题)
    // 按 RFC 4180 风格引号规则导入 CSV。
    事件 _接口31_导入CSV_被单击()
        调试输出("表格_导入CSV 返回值：", 表格_导入CSV(静态表格, "选择,订单号,数量,金额,日期,启用,图片,进度,状态,操作\n1,3002,3,99.90,2026-08-13,1,,75,processing,", 真), 真)
        控件_设置文本(操作结果, "已单独执行 31：表格_导入CSV；返回值见输出面板。")
    结束

    // 32. 表格_导出CSV(控件名, 包含标题)
    // 导出可往返的 CSV。
    事件 _接口32_导出CSV_被单击()
        调试输出("表格_导出CSV 返回值：", 表格_导出CSV(静态表格, 真), 真)
        控件_设置文本(操作结果, "已单独执行 32：表格_导出CSV；返回值见输出面板。")
    结束

    // 33. 表格_导入Excel(控件名, 文件路径, 首行为标题)
    // 从 .xlsx 文件的第一个工作表导入数据，无需安装 Microsoft Excel。
    事件 _接口33_导入Excel_被单击()
        调试输出("表格_导入Excel 返回值：", 表格_导入Excel(静态表格, "DataGrid导出示例.xlsx", 真), 真)
        控件_设置文本(操作结果, "已单独执行 33：表格_导入Excel；返回值见输出面板。")
    结束

    // 34. 表格_导出Excel(控件名, 文件路径, 包含标题)
    // 将静态数据导出为标准 .xlsx 文件，无需安装 Microsoft Excel。
    事件 _接口34_导出Excel_被单击()
        调试输出("表格_导出Excel 返回值：", 表格_导出Excel(静态表格, "DataGrid导出示例.xlsx", 真), 真)
        控件_设置文本(操作结果, "已单独执行 34：表格_导出Excel；返回值见输出面板。")
    结束

    // 35. 表格_置文本(控件名, 行键, 列ID, 文本)
    // 写入文本单元格。
    事件 _接口35_置文本_被单击()
        调试输出("表格_置文本 返回值：", 表格_置文本(静态表格, "order-1001", "order_no", "1001-A"), 真)
        控件_设置文本(操作结果, "已单独执行 35：表格_置文本；返回值见输出面板。")
    结束

    // 36. 表格_取文本(控件名, 行键, 列ID)
    // 读取单元格显示文本。
    事件 _接口36_取文本_被单击()
        调试输出("表格_取文本 返回值：", 表格_取文本(静态表格, "order-1001", "order_no"), 真)
        控件_设置文本(操作结果, "已单独执行 36：表格_取文本；返回值见输出面板。")
    结束

    // 37. 表格_置整数(控件名, 行键, 列ID, 数值)
    // 写入整数单元格。
    事件 _接口37_置整数_被单击()
        调试输出("表格_置整数 返回值：", 表格_置整数(静态表格, "order-1001", "quantity", 0), 真)
        控件_设置文本(操作结果, "已单独执行 37：表格_置整数；返回值见输出面板。")
    结束

    // 38. 表格_取整数(控件名, 行键, 列ID)
    // 读取整数单元格。
    事件 _接口38_取整数_被单击()
        调试输出("表格_取整数 返回值：", 表格_取整数(静态表格, "order-1001", "quantity"), 真)
        控件_设置文本(操作结果, "已单独执行 38：表格_取整数；返回值见输出面板。")
    结束

    // 39. 表格_置小数(控件名, 行键, 列ID, 数值)
    // 写入小数单元格。
    事件 _接口39_置小数_被单击()
        调试输出("表格_置小数 返回值：", 表格_置小数(静态表格, "order-1001", "amount", 0.0), 真)
        控件_设置文本(操作结果, "已单独执行 39：表格_置小数；返回值见输出面板。")
    结束

    // 40. 表格_取小数(控件名, 行键, 列ID)
    // 读取小数单元格。
    事件 _接口40_取小数_被单击()
        调试输出("表格_取小数 返回值：", 表格_取小数(静态表格, "order-1001", "amount"), 真)
        控件_设置文本(操作结果, "已单独执行 40：表格_取小数；返回值见输出面板。")
    结束

    // 41. 表格_置逻辑(控件名, 行键, 列ID, 数值)
    // 写入选择框或 Switch 单元格。
    事件 _接口41_置逻辑_被单击()
        调试输出("表格_置逻辑 返回值：", 表格_置逻辑(静态表格, "order-1001", "enabled", 真), 真)
