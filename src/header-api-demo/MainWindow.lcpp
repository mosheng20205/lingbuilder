包 表头Header完整接口演示
使用 Win32窗口基础模块
使用 Win32高级控件模块

类 MainWindow : 公开 窗体
    构造()
        调试输出("Header 表头演示窗口正在初始化", 真)
    结束

    事件 _MainWindow_创建完毕()
        控件_设置文本("状态文本", "已加载：表头列模型、图像列表、通用接口和两个通知事件。")
        控件_设置选择项("演示选项卡", 0)
        调试输出("表头演示已加载", 真)
        调试输出("运行时表头初始文本", 控件_取文本("运行时表头"), 真)
    结束

    // 通用接口：Header 的可见状态可以独立切换。
    事件 _隐藏表头按钮_被单击()
        控件_设置可见("运行时表头", 假)
        控件_设置文本("通用结果", "已调用 控件_设置可见(运行时表头, 假)。请点击“显示表头”恢复。")
    结束

    事件 _显示表头按钮_被单击()
        控件_设置可见("运行时表头", 真)
        控件_设置文本("通用结果", "已调用 控件_设置可见(运行时表头, 真)。")
    结束

    // 通用接口：禁用 Header 后仍保留布局，恢复按钮位于表头之外。
    事件 _禁用表头按钮_被单击()
        控件_设置启用("运行时表头", 假)
        控件_设置文本("通用结果", "已调用 控件_设置启用(运行时表头, 假)。")
    结束

    事件 _恢复启用按钮_被单击()
        控件_设置启用("运行时表头", 真)
        控件_设置文本("通用结果", "已调用 控件_设置启用(运行时表头, 真)。")
    结束

    // 通用接口：窗口文字不是 Header 列标题；列标题仍由设计器列集合提供。
    事件 _写入文本按钮_被单击()
        局部 逻辑型 成功 = 假
        成功 = 控件_设置文本("运行时表头", "Header窗口文本接口")
        控件_设置文本("通用结果", "控件_设置文本 返回：" + 到文本(成功) + "；可见列标题仍来自列集合。")
        调试输出("Header 控件_设置文本 返回值", 成功, 真)
    结束

    事件 _读取文本按钮_被单击()
        局部 文本型 文本 = ""
        文本 = 控件_取文本("运行时表头")
        控件_设置文本("通用结果", "控件_取文本 返回：" + 文本 + "。Header 的可见标题由列集合绘制。")
        调试输出("Header 控件_取文本 返回值", 文本, 真)
    结束

    事件 _属性表头_列被单击()
        控件_设置文本("状态文本", "属性与列模型页收到：属性表头_列被单击。")
        调试输出("属性表头列被单击", 真)
    结束

    事件 _属性表头_列宽被改变()
        控件_设置文本("状态文本", "属性与列模型页收到：属性表头_列宽被改变。")
        调试输出("属性表头列宽被改变", 真)
    结束

    事件 _调整大小按钮_被单击()
        控件_设置位置大小("运行时表头", 30, 78, 900, 92)
        控件_设置文本("通用结果", "已调用 控件_设置位置大小：30,78,900,92。")
    结束

    事件 _恢复布局按钮_被单击()
        控件_设置位置大小("运行时表头", 30, 78, 1000, 72)
        控件_设置文本("通用结果", "已恢复运行时表头的初始位置和大小。")
    结束

    事件 _清空事件日志按钮_被单击()
        控件_设置文本("事件日志", "事件日志已清空；请点击表头列或拖动列分隔线。")
    结束

    事件 _演示表头_列被单击()
        控件_设置文本("事件日志", "收到事件：演示表头_列被单击。当前事件契约不携带列索引参数。")
        调试输出("演示表头列被单击", 真)
    结束

    事件 _演示表头_列宽被改变()
        控件_设置文本("事件日志", "收到事件：演示表头_列宽被改变。列宽已由原生 Header 控件更新。")
        调试输出("演示表头列宽被改变", 真)
    结束

    事件 _运行事件页示例按钮_被单击()
        控件_设置文本("事件日志", "请在上方表头上点击一列，或拖动任意列分隔线，观察两个事件。")
    结束
结束类
