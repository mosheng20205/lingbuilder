类 MainWindow
    // 识别走的是本机微信 4.x OCR 组件：握手最长 15 秒、单图最长 120 秒，必须放在工作线程执行。
    // 界面线程只做两件事——提交任务、在完成处理器里写控件（完成处理器固定回到发起任务的窗口界面线程）。
    // 结果不靠共享全局变量回传：识别文本由工作处理器的返回值带出，失败原因由抛出 -> 任务失败 ->
    // 线程_取错误(任务) 这条通道带出，因此不需要额外的锁，也不会和上一次任务串味。
    线程任务 识别任务
    逻辑型 识别运行中 = 假

    事件 _MainWindow_创建完毕()
        控件_设置文本(状态标签, "就绪：截屏识别 / 选择图片 / 识别剪贴板；识别在后台线程执行，界面不卡。")
        控件_设置文本(识别结果, "")
    结束

    事件 _截屏识别按钮_被单击()
        如果 (识别运行中)
            控件_设置文本(状态标签, "上一次识别还在后台进行，请等它结束再点。")
        否则
            调试输出("[截屏识别] 按钮点击，1.5 秒后截取主屏")
            控件_设置文本(状态标签, "1.5 秒后截取主屏，请切换到目标窗口…")
            延时(1500)
            局部 文本型 截图路径
            // 临时图放用户临时目录（系统_取临时目录 返回值自带结尾反斜杠），识别完在工作线程里删掉。
            截图路径 = 系统_取临时目录() + "lingbuilder-ocr-snap.png"
            调试输出(格式化文本("[截屏识别] 临时截图={}", 截图路径))
            识别运行中 = 真
            控件_设置文本(状态标签, "正在后台截屏并识别…")
            识别任务 = 线程_提交完成(&截屏并识别工作, &识别完成, 截图路径)
            提交后状态(识别任务)
        如果结束
    结束

    事件 _选择图片按钮_被单击()
        调试输出("[选择图片] 按钮点击，打开文件选择窗口")
        控件_设置文本(状态标签, "请在文件选择窗口中挑选要识别的图片…")
        // 模态对话框返回之前，运行时就已经派发了「文件已选择」或「已取消」事件；
        // 这里不能再写状态标签，否则会把识别状态覆盖成过时提示（旧版正是这么错的）。
        文件对话框_打开(文件对话框1)
        调试输出("[选择图片] 对话框已关闭")
    结束

    事件 _识别剪贴板按钮_被单击()
        如果 (识别运行中)
            控件_设置文本(状态标签, "上一次识别还在后台进行，请等它结束再点。")
        否则
            调试输出("[识别剪贴板] 按钮点击，检查剪贴板图片")
            如果 (剪贴板_是否有图片())
                局部 文本型 图片格式
                图片格式 = 剪贴板_取图片格式()
                调试输出(格式化文本("[识别剪贴板] 剪贴板有图片（格式={}），提交后台识别", 图片格式))
                识别运行中 = 真
                控件_设置文本(状态标签, "正在后台识别剪贴板图片…")
                识别任务 = 线程_提交完成(&剪贴板识别工作, &识别完成, 图片格式)
                提交后状态(识别任务)
            否则
                控件_设置文本(状态标签, "剪贴板里没有图片：请先截图（任意截屏软件或 PrintScreen），再点本按钮。")
            如果结束
        如果结束
    结束

    事件 _文件对话框1_文件已选择()
        如果 (文件对话框_取文件数量(文件对话框1) > 0)
            提交图片识别(文件对话框_取文件(文件对话框1, 0))
        如果结束
    结束

    事件 _文件对话框1_已取消()
        控件_设置文本(状态标签, "已取消选择图片，未做识别。")
    结束

    事件 _文件对话框1_文件被拖入()
        如果 (文件对话框_取文件数量(文件对话框1) > 0)
            提交图片识别(文件对话框_取文件(文件对话框1, 0))
        如果结束
    结束

    空 提交图片识别(文本型 图片路径)
        如果 (识别运行中)
            调试输出(格式化文本("[提交跳过] 忙，忽略图片={}", 图片路径))
            控件_设置文本(状态标签, "上一次识别还在后台进行，这次先跳过。")
        否则
            识别运行中 = 真
            控件_设置文本(状态标签, "正在后台识别：" + 图片路径)
            识别任务 = 线程_提交完成(&识别图片工作, &识别完成, 图片路径)
            提交后状态(识别任务)
        如果结束
    结束

    // 只有提交失败（任务为 0）才需要当场收回在跑标记；提交成功后的状态一律交给完成处理器写回。
    空 提交后状态(线程任务 任务)
        如果 (任务 = 0)
            识别运行中 = 假
            控件_设置文本(状态标签, "后台任务提交失败：" + 线程_取错误(0))
        如果结束
    结束

    // 工作线程：截屏 -> 识别 -> 删除临时图。
    文本型 截屏并识别工作(文本型 截图路径)
        局部 文本型 识别文本
        如果 (截图_主屏到PNG(截图路径))
            识别文本 = 识别图片工作(截图路径)
            文件_删除(截图路径)
            返回(识别文本)
        否则
            抛出("截屏失败：未生成截图文件。")
        如果结束
        返回("")
    结束

    // 工作线程：把剪贴板图片取成字节集再识别。字节集只活在本线程，不跨线程传句柄。
    文本型 剪贴板识别工作(文本型 图片格式)
        局部 字节集 图片数据
        图片数据 = 剪贴板_取图片字节集()
        局部 OCR结果句柄 结果
        结果 = OCR_识别字节集(图片数据)
        返回(收尾识别结果(结果, 格式化文本("剪贴板图片（格式={}，{} 字节）", 图片格式, 字节集_长度(图片数据))))
    结束

    // 工作线程：按图片路径识别。
    文本型 识别图片工作(文本型 图片路径)
        局部 OCR结果句柄 结果
        结果 = OCR_识别(图片路径)
        返回(收尾识别结果(结果, 图片路径))
    结束

    // 工作线程共用收尾：失败就地抛出（OCR_取错误 是线程本地错误，必须在本线程读，
    // 回到界面线程再读只会是空文本）；成功则取全文、记日志并释放句柄。
    文本型 收尾识别结果(OCR结果句柄 结果, 文本型 来源说明)
        局部 文本型 失败原因
        如果 (结果 = 0)
            失败原因 = OCR_取错误()
            如果 (失败原因 = "")
                抛出(格式化文本("{} 识别失败：模块未给出具体原因（可用 OCR_停止 复位微信 OCR 组件后重试）。", 来源说明))
            如果结束
            抛出(格式化文本("{} 识别失败：{}", 来源说明, 失败原因))
        如果结束
        局部 文本型 识别文本
        识别文本 = OCR结果_取全部文本(结果, 真)
        调试输出(格式化文本("[OCR] {}：共 {} 行，原图 {}×{} 像素", 来源说明, OCR结果_取行数(结果), OCR结果_取宽度(结果), OCR结果_取高度(结果)))
        OCR结果_释放(结果)
        返回(识别文本)
    结束

    // 完成处理器只在界面线程跑，是全工程唯一被允许写控件的地方。
    空 识别完成(线程任务 任务, 文本型 识别文本)
        识别运行中 = 假
        局部 文本型 状态说明
        如果 (线程_取状态(任务) = 2)
            控件_设置文本(识别结果, 识别文本)
            控件_设置文本(状态标签, "识别完成：结果已显示在下方。")
        否则
            状态说明 = 线程_取错误(任务)
            如果 (状态说明 = "")
                状态说明 = "识别未完成。"
            如果结束
            控件_设置文本(状态标签, 状态说明)
        如果结束
        调试输出(格式化文本("[识别完成] 任务={} 状态={}", 任务, 线程_取状态名称(任务)))
    结束
结束类
