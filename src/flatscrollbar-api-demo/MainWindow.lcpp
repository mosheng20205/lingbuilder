包 FlatScrollBar完整示例
使用 Win32窗口基础模块
使用 Win32高级控件模块

类 MainWindow : 公开 窗体
    事件 _MainWindow_创建完毕()
        控件_设置文本(接口状态, "已加载：FlatScrollBar 全部公开接口演示")
        更新基础数值文本()
        更新范围数值文本()
        更新联动数值文本()
    结束

    事件 _功能选项卡_标签页被改变()
        控件_设置文本(接口状态, "选项卡已切换：当前页面继续演示 FlatScrollBar 能力")
    结束

    空 更新基础数值文本()
        控件_设置文本(基础垂直值, "垂直当前值：" + 到文本(控件_取数值(基础垂直条)))
        控件_设置文本(基础水平值, "水平当前值：" + 到文本(控件_取数值(基础水平条)))
    结束

    空 更新范围数值文本()
        控件_设置文本(范围垂直值, "垂直值：" + 到文本(控件_取数值(范围垂直条)) + "（范围 10 - 90）")
        控件_设置文本(范围水平值, "水平值：" + 到文本(控件_取数值(范围水平条)) + "（范围 -50 - 50）")
    结束

    空 更新联动数值文本()
        控件_设置文本(联动垂直值, "垂直值：" + 到文本(控件_取数值(联动垂直条)))
        控件_设置文本(联动水平值, "水平值：" + 到文本(控件_取数值(联动水平条)))
    结束

    事件 _基础垂直条_数值被改变()
        更新基础数值文本()
        控件_设置文本(接口状态, "ValueChanged：基础垂直条数值已改变")
    结束

    事件 _基础水平条_数值被改变()
        更新基础数值文本()
        控件_设置文本(接口状态, "ValueChanged：基础水平条数值已改变")
    结束

    事件 _读取基础值按钮_被单击()
        局部 整数型 垂直值 = 0
        局部 整数型 水平值 = 0
        垂直值 = 控件_取数值(基础垂直条)
        水平值 = 控件_取数值(基础水平条)
        控件_设置文本(接口状态, "控件_取数值成功：垂直=" + 到文本(垂直值) + "，水平=" + 到文本(水平值))
        更新基础数值文本()
    结束

    事件 _设为中间值按钮_被单击()
        控件_设置数值(基础垂直条, 50)
        控件_设置数值(基础水平条, 50)
        控件_设置文本(接口状态, "控件_设置数值成功：两个 FlatScrollBar 均已设为 50")
        更新基础数值文本()
    结束

    事件 _设为最小值按钮_被单击()
        控件_设置数值(基础垂直条, 0)
        控件_设置数值(基础水平条, 0)
        控件_设置文本(接口状态, "边界测试：已设置为最小值 0")
        更新基础数值文本()
    结束

    事件 _设为最大值按钮_被单击()
        控件_设置数值(基础垂直条, 100)
        控件_设置数值(基础水平条, 100)
        控件_设置文本(接口状态, "边界测试：已设置为最大值 100")
        更新基础数值文本()
    结束

    事件 _禁用基础垂直条按钮_被单击()
        控件_设置启用(基础垂直条, 假)
        控件_设置文本(接口状态, "控件_设置启用：基础垂直条已禁用")
    结束

    事件 _重新启用基础垂直条按钮_被单击()
        控件_设置启用(基础垂直条, 真)
        控件_设置文本(接口状态, "控件_设置启用：基础垂直条已重新启用")
    结束

    事件 _隐藏基础水平条按钮_被单击()
        控件_设置可见(基础水平条, 假)
        控件_设置文本(接口状态, "控件_设置可见：基础水平条已隐藏")
    结束

    事件 _显示基础水平条按钮_被单击()
        控件_设置可见(基础水平条, 真)
        控件_设置文本(接口状态, "控件_设置可见：基础水平条已显示")
    结束

    事件 _文本接口自检按钮_被单击()
        局部 文本型 当前内容 = ""
        控件_设置文本(基础垂直条, "FlatScrollBar")
        当前内容 = 控件_取文本(基础垂直条)
        控件_设置文本(接口状态, "控件_设置文本/控件_取文本成功：" + 当前内容)
    结束

    事件 _范围垂直条_数值被改变()
        更新范围数值文本()
        控件_设置文本(接口状态, "ValueChanged：范围垂直条数值已改变")
    结束

    事件 _范围水平条_数值被改变()
        更新范围数值文本()
        控件_设置文本(接口状态, "ValueChanged：范围水平条数值已改变")
    结束

    事件 _范围设为最小按钮_被单击()
        控件_设置数值(范围垂直条, 10)
        控件_设置数值(范围水平条, -50)
        更新范围数值文本()
        控件_设置文本(接口状态, "范围边界：垂直=10，水平=-50")
    结束

    事件 _范围设为中间按钮_被单击()
        控件_设置数值(范围垂直条, 50)
        控件_设置数值(范围水平条, 0)
        更新范围数值文本()
        控件_设置文本(接口状态, "范围中值：垂直=50，水平=0")
    结束

    事件 _范围设为最大按钮_被单击()
        控件_设置数值(范围垂直条, 90)
        控件_设置数值(范围水平条, 50)
        更新范围数值文本()
        控件_设置文本(接口状态, "范围边界：垂直=90，水平=50")
    结束

    事件 _移动范围条按钮_被单击()
        控件_设置位置大小(范围垂直条, 300, 100, 24, 250)
        控件_设置文本(接口状态, "控件_设置位置大小：范围垂直条已移动并调整为 24×250")
    结束

    事件 _恢复范围条按钮_被单击()
        控件_设置位置大小(范围垂直条, 120, 100, 24, 250)
        控件_设置文本(接口状态, "控件_设置位置大小：范围垂直条已恢复原位置")
    结束

    事件 _联动垂直条_数值被改变()
        局部 整数型 当前值 = 0
        当前值 = 控件_取数值(联动垂直条)
        控件_设置数值(联动水平条, 当前值)
        更新联动数值文本()
        控件_设置文本(接口状态, "ValueChanged：垂直条已把数值同步到水平条")
    结束

    事件 _联动水平条_数值被改变()
        更新联动数值文本()
        控件_设置文本(接口状态, "ValueChanged：联动水平条数值已改变")
    结束

    事件 _联动设为25按钮_被单击()
        控件_设置数值(联动垂直条, 25)
        控件_设置数值(联动水平条, 25)
        更新联动数值文本()
        控件_设置文本(接口状态, "联动测试：两个 FlatScrollBar 都已设为 25")
    结束

    事件 _联动设为75按钮_被单击()
        控件_设置数值(联动垂直条, 75)
        控件_设置数值(联动水平条, 75)
        更新联动数值文本()
        控件_设置文本(接口状态, "联动测试：两个 FlatScrollBar 都已设为 75")
    结束

    事件 _读取当前页按钮_被单击()
        局部 整数型 当前页 = 0
        当前页 = 控件_取选择项(功能选项卡)
        控件_设置文本(接口状态, "控件_取选择项：当前选项卡索引为 " + 到文本(当前页))
    结束

    事件 _跳到范围页按钮_被单击()
        控件_设置选择项(功能选项卡, 1)
        控件_设置文本(接口状态, "控件_设置选择项：已跳转到“范围与方向”标签页")
    结束
结束类
