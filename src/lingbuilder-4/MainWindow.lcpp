类 MainWindow
    事件 创建完毕()
        调试输出("窗口创建完毕")
        选项卡_设置隐藏表头("选项卡_tab", 真)

    事件 _按钮_切换选项卡_被单击()
        调试输出("按钮_切换选项卡被单击")
        选项卡1.设置选择项(到整数(编辑框_表头.内容))

    事件 _按钮_显示表头_被单击()
        选项卡_设置隐藏表头("选项卡1", 假)
        调试输出("按钮_显示表头被单击")

    事件 _按钮_隐藏表头_被单击()
        选项卡_设置隐藏表头("选项卡1", 真)
        调试输出("按钮_隐藏表头被单击")

    事件 _列表框_tab_选择项被改变()
        调试输出("列表框_tab选择项被改变", 控件_取选择项("列表框_tab"))
        选项卡_tab.设置选择项(控件_取选择项("列表框_tab"))

    事件 _按钮_进度条加_被单击()
        控件_设置数值("进度条1", 控件_取数值("进度条1")+10)
        调试输出("按钮_进度条加被单击")

    事件 _按钮_进度条减_被单击()
        控件_设置数值("进度条1", 控件_取数值("进度条1")-10)
        调试输出("按钮_进度条减被单击")

    事件 _MainWindow_切换到基础模块组件_被选择()
        调试输出("切换到基础模块组件被选择")
    结束

    事件 _MainWindow_切换到高级模块组件_被选择()
        调试输出("切换到高级模块组件被选择")
    结束
结束类