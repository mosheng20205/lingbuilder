类 MainWindow
    事件 创建完毕()
        调试输出("窗口创建完毕")
        选项卡_设置隐藏表头(选项卡_tab, 真)
        选项卡_tab.设置选择项(0)
        列表框_tab.设置选择项(0)
    事件 _按钮_切换选项卡_被单击()
        调试输出("按钮_切换选项卡被单击")
        选项卡1.设置选择项(到整数(编辑框_表头.内容))

    事件 _按钮_显示表头_被单击()
        选项卡_设置隐藏表头(选项卡1, 假)
        调试输出("按钮_显示表头被单击")

    事件 _按钮_隐藏表头_被单击()
        选项卡_设置隐藏表头(选项卡1, 真)
        调试输出("按钮_隐藏表头被单击")

    事件 _列表框_tab_选择项被改变()
        调试输出("列表框_tab选择项被改变", 控件_取选择项(列表框_tab))
        选项卡_tab.设置选择项(控件_取选择项(列表框_tab))

    事件 _按钮_进度条加_被单击()
        控件_设置数值(进度条1, 控件_取数值(进度条1)+10)
        调试输出("按钮_进度条加被单击")

    事件 _按钮_进度条减_被单击()
        控件_设置数值(进度条1, 控件_取数值(进度条1)-10)
        调试输出("按钮_进度条减被单击")

    事件 _MainWindow_切换到基础模块组件_被选择()
        调试输出("切换到基础模块组件被选择")
        选项卡_tab.设置选择项(0)
    事件 _MainWindow_切换到高级模块组件_被选择()
        调试输出("切换到高级模块组件被选择")
        选项卡_tab.设置选择项(1)

    事件 _文件对话框1_文件已选择()
        调试输出("文件对话框1FilesSelected",文件对话框_取文件(文件对话框1, 0))
        如果 (文件对话框_取文件(文件对话框1, 0)!="")
        图片框2.设置图片(文件对话框_取文件(文件对话框1, 0))
        否则

        如果结束
    事件 _文件对话框1_文件被拖入()
        调试输出("文件对话框1FilesDropped",文件对话框_取文件(文件对话框1, 0))
        如果 (文件对话框_取文件(文件对话框1, 0)!="")
        图片框2.设置图片(文件对话框_取文件(文件对话框1, 0))
        否则

        如果结束

    事件 _按钮_弹出菜单_被单击()
        // 弹出菜单_显示("弹出菜单1")

        弹出菜单_在坐标显示(弹出菜单1, 取鼠标水平位置(), 取鼠标垂直位置())
        调试输出("按钮_弹出菜单被单击")

    事件 _滑块1_数值被改变()
        调试输出("滑块1数值被改变"，控件_取数值(滑块1))

    事件 _按钮_上传图片_被单击()
        信息框("点击上传图片", 64, "事件触发")
        调试输出("按钮_上传图片被单击")
    结束
结束类
