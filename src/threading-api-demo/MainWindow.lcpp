包 多线程模块完整演示
使用 Win32窗口基础模块
使用 Win32高级控件模块
使用 多线程模块

类 MainWindow : 公开 窗体
    线程任务 当前任务
    线程任务 进度任务
    线程任务 取消任务
    线程任务 等待任务甲
    线程任务 等待任务乙
    线程任务 池任务
    线程任务 事件任务
    线程任务 信号量任务
    线程池 默认池
    线程池 自定义池
    线程互斥锁 演示锁
    线程原子整数 原子计数
    线程同步事件 演示事件
    线程信号量 演示信号量
    整数型 受锁计数 = 0
    整数型 日志序号 = 0
    逻辑型 自定义池有效 = 假

    事件 _MainWindow_创建完毕()
        默认池 = 线程池_取默认池()
        演示锁 = 互斥锁_创建()
        原子计数 = 原子整数_创建(10)
        演示事件 = 线程事件_创建(真, 假)
        演示信号量 = 信号量_创建(0, 3)
        写日志("多线程模块 2.0 演示已就绪。")
        写日志(格式化文本("默认池并发数={}，硬件并发数={}", 线程池_取并发数(默认池), 线程池_取硬件并发数()))
    结束

    空 写日志(文本型 内容)
        日志序号 = 日志序号 + 1
        控件_设置文本(运行日志, 格式化文本("{}[{}] {}\r\n", 控件_取文本(运行日志), 日志序号, 内容))
        调试输出(内容)
    结束

    空 确保自定义池()
        如果 (自定义池有效 == 假)
            自定义池 = 线程池_创建(3, 32)
            自定义池有效 = 真
            写日志(格式化文本("已创建自定义池：并发=3，队列容量=32，ID={}", 自定义池))
        如果结束
    结束

    空 确保同步对象()
        如果 (演示锁 == 0)
            演示锁 = 互斥锁_创建()
        如果结束
        如果 (原子计数 == 0)
            原子计数 = 原子整数_创建(10)
        如果结束
        如果 (演示事件 == 0)
            演示事件 = 线程事件_创建(真, 假)
        如果结束
        如果 (演示信号量 == 0)
            演示信号量 = 信号量_创建(0, 3)
        如果结束
    结束

    事件 _多参数提交按钮_被单击()
        局部 线程演示输入 输入
        局部 整数型 附加[]
        输入.数量 = 7
        输入.名称 = "原始记录"
        输入.启用 = 真
        输入.元数据.来源 = "任务与多参数页"
        输入.元数据.版本 = 2
        @ 输入 . 样本 = { 3, 5, 8 };
        @ 附加 = { 11, 13, 17 };
        当前任务 = 线程_提交完成(&多参数工作, &记录完成, 100, "批次A", 真, 输入, 附加)
        输入.数量 = 999
        输入.名称 = "提交后已修改"
        @ 附加[0] = 999;
        写日志(格式化文本("已提交记录、嵌套记录、数组和混合基础类型；提交后立即修改原变量，用于验证深拷贝。任务={}", 当前任务))
    结束

    事件 _数组返回按钮_被单击()
        局部 整数型 输入[]
        @ 输入 = { 2, 4, 6, 8 };
        当前任务 = 线程_提交完成(&数组翻倍工作, &数组完成, 输入)
        @ 输入[0] = 1000;
        写日志(格式化文本("已提交数组返回任务；原数组随后改写，不影响工作线程副本。任务={}", 当前任务))
    结束

    事件 _普通提交按钮_被单击()
        当前任务 = 线程_提交(&短工作, 120)
        写日志(格式化文本("普通提交：无完成回调任务={}", 当前任务))
    结束

    事件 _完成提交按钮_被单击()
        当前任务 = 线程_提交完成(&求和工作, &整数完成, 21, 34)
        写日志(格式化文本("完成提交：21 + 34，任务={}", 当前任务))
    结束

    事件 _进度任务按钮_被单击()
        进度任务 = 线程_提交进度(&进度工作, &工作进度, &空结果完成, "默认池进度", 12)
        写日志(格式化文本("已启动进度任务；进度处理器与完成处理器均在本窗口 UI 线程执行。任务={}", 进度任务))
    结束

    事件 _查询任务按钮_被单击()
        如果 (进度任务 != 0)
            写日志(格式化文本("进度任务：状态码={}，状态={}", 线程_取状态(进度任务), 线程_取状态名称(进度任务)))
            写日志(格式化文本("是否完成={}，进度={}%", 线程_是否完成(进度任务), 线程_取进度(进度任务)))
            写日志(格式化文本("进度说明={}，错误={}", 线程_取进度说明(进度任务), 线程_取错误(进度任务)))
        如果结束
    结束

    事件 _取消任务按钮_被单击()
        取消任务 = 线程_提交进度(&进度工作, &工作进度, &空结果完成, "待取消任务", 50)
        写日志(格式化文本("已创建待取消任务={}", 取消任务))
        如果 (线程_请求取消(取消任务))
            写日志(格式化文本("取消请求已发送；是否请求取消={}，当前状态={}", 线程_是否请求取消(取消任务), 线程_取状态名称(取消任务)))
        如果结束
    结束

    事件 _等待任务按钮_被单击()
        当前任务 = 线程_提交(&短工作, 180)
        写日志(格式化文本("单任务等待返回={}，最终状态={}", 线程_等待(当前任务, 2000), 线程_取状态名称(当前任务)))
    结束

    事件 _等待全部按钮_被单击()
        等待任务甲 = 线程_提交(&短工作, 100)
        等待任务乙 = 线程_提交(&短工作, 160)
        写日志(格式化文本("等待全部任务返回={}", 线程_等待全部超时(3000, 等待任务甲, 等待任务乙)))
    结束

    事件 _失败任务按钮_被单击()
        当前任务 = 线程_提交完成(&失败工作, &空结果完成)
        写日志(格式化文本("已提交预期失败任务；完成回调将读取失败状态和中文错误。任务={}", 当前任务))
    结束

    事件 _释放清理按钮_被单击()
        如果 (当前任务 != 0)
            如果 (线程_是否完成(当前任务))
                写日志(格式化文本("释放任务返回={}", 线程_释放任务(当前任务)))
            如果结束
        如果结束
        写日志(格式化文本("清理已完成任务数量={}", 线程_清理已完成()))
    结束

    事件 _创建线程池按钮_被单击()
        确保自定义池()
        写日志(格式化文本("默认池={}；自定义池={}；硬件并发={}", 默认池, 自定义池, 线程池_取硬件并发数()))
    结束

    事件 _线程池提交按钮_被单击()
        确保自定义池()
        池任务 = 线程池_提交(自定义池, &短工作, 140)
        当前任务 = 线程池_提交完成(自定义池, &求和工作, &整数完成, 8, 9)
        进度任务 = 线程池_提交进度(自定义池, &进度工作, &工作进度, &空结果完成, "自定义池进度", 10)
        写日志("已分别调用线程池_提交、线程池_提交完成、线程池_提交进度。")
    结束

    事件 _线程池状态按钮_被单击()
        确保自定义池()
        写日志(格式化文本("并发={}，等待={}，运行={}", 线程池_取并发数(自定义池), 线程池_取等待数量(自定义池), 线程池_取运行数量(自定义池)))
        写日志(格式化文本("是否空闲={}；等待空闲 2000ms={}", 线程池_是否空闲(自定义池), 线程池_等待空闲(自定义池, 2000)))
    结束

    事件 _调整并发按钮_被单击()
        确保自定义池()
        线程池_等待空闲(自定义池, 3000)
        写日志(格式化文本("设置并发数为 4 返回={}，当前并发={}", 线程池_设置并发数(自定义池, 4), 线程池_取并发数(自定义池)))
    结束

    事件 _停止线程池按钮_被单击()
        确保自定义池()
        池任务 = 线程池_提交(自定义池, &长工作, 40)
        写日志(格式化文本("线程池请求停止返回={}；任务状态={}", 线程池_请求停止(自定义池), 线程_取状态名称(池任务)))
    结束

    事件 _关闭重启按钮_被单击()
        确保自定义池()
        写日志(格式化文本("线程池关闭返回={}", 线程池_关闭(自定义池, 5000)))
        写日志(格式化文本("线程池重启返回={}，并发={}", 线程池_重启(自定义池), 线程池_取并发数(自定义池)))
    结束

    事件 _销毁线程池按钮_被单击()
        如果 (自定义池 != 0)
            线程池_请求停止(自定义池)
            线程池_关闭(自定义池, 5000)
            线程池_等待空闲(自定义池, 5000)
            写日志(格式化文本("线程池销毁返回={}", 线程池_销毁(自定义池)))
            自定义池有效 = 假
        如果结束
    结束

    事件 _互斥执行按钮_被单击()
        局部 逻辑型 执行成功 = 假
        确保同步对象()
        执行成功 = 互斥锁_执行(演示锁, &受锁增加, 5)
        写日志(格式化文本("持锁执行返回={}，受锁计数={}", 执行成功, 受锁计数))
    结束

    事件 _互斥尝试按钮_被单击()
        局部 逻辑型 执行成功 = 假
        确保同步对象()
        执行成功 = 互斥锁_尝试执行(演示锁, 200, &受锁增加, 3)
        写日志(格式化文本("200ms 尝试持锁返回={}，受锁计数={}", 执行成功, 受锁计数))
    结束

    事件 _原子操作按钮_被单击()
        确保同步对象()
        写日志(格式化文本("原子初值={}；写入20返回旧值={}", 原子整数_读取(原子计数), 原子整数_写入(原子计数, 20)))
        写日志(格式化文本("增加5后的值={}；比较交换25→100={}；当前值={}", 原子整数_增加(原子计数, 5), 原子整数_比较交换(原子计数, 25, 100), 原子整数_读取(原子计数)))
    结束

    事件 _重建锁按钮_被单击()
        如果 (演示锁 != 0)
            写日志(格式化文本("互斥锁销毁返回={}", 互斥锁_销毁(演示锁)))
        如果结束
        演示锁 = 互斥锁_创建()
        写日志(格式化文本("已重建非递归定时互斥锁，ID={}", 演示锁))
    结束

    事件 _重建原子按钮_被单击()
        如果 (原子计数 != 0)
            写日志(格式化文本("原子整数销毁返回={}", 原子整数_销毁(原子计数)))
        如果结束
        原子计数 = 原子整数_创建(10)
        写日志(格式化文本("已重建 64 位原子整数，值={}", 原子整数_读取(原子计数)))
    结束

    事件 _事件等待按钮_被单击()
        确保同步对象()
        线程事件_重置(演示事件)
        事件任务 = 线程_提交完成(&等待事件工作, &事件等待完成, 演示事件)
        写日志(格式化文本("已在工作线程等待事件；请点击“置位事件”。任务={}", 事件任务))
    结束

    事件 _事件置位按钮_被单击()
        确保同步对象()
        写日志(格式化文本("事件置位返回={}", 线程事件_置位(演示事件)))
    结束

    事件 _事件重置按钮_被单击()
        确保同步对象()
        写日志(格式化文本("事件重置返回={}", 线程事件_重置(演示事件)))
    结束

    事件 _事件重建按钮_被单击()
        如果 (事件任务 != 0)
            线程事件_置位(演示事件)
            线程_等待(事件任务, 2000)
        如果结束
        如果 (演示事件 != 0)
            写日志(格式化文本("事件销毁返回={}", 线程事件_销毁(演示事件)))
        如果结束
        演示事件 = 线程事件_创建(假, 真)
        写日志(格式化文本("已创建初始置位的自动重置事件；首次等待={}，第二次等待={}", 线程事件_等待(演示事件, 0), 线程事件_等待(演示事件, 0)))
    结束

    事件 _信号量等待按钮_被单击()
        确保同步对象()
        信号量任务 = 线程_提交完成(&等待信号量工作, &信号量等待完成, 演示信号量)
        写日志(格式化文本("已在工作线程等待信号量；当前可用数量={}", 信号量_取可用数量(演示信号量)))
    结束

    事件 _信号量释放按钮_被单击()
        确保同步对象()
        写日志(格式化文本("信号量释放 1 个许可返回={}；当前可用数量={}", 信号量_释放(演示信号量, 1), 信号量_取可用数量(演示信号量)))
    结束

    事件 _信号量重建按钮_被单击()
        如果 (演示信号量 != 0)
            信号量_释放(演示信号量, 1)
            如果 (信号量任务 != 0)
                线程_等待(信号量任务, 2000)
            如果结束
            写日志(格式化文本("信号量销毁返回={}", 信号量_销毁(演示信号量)))
        如果结束
        演示信号量 = 信号量_创建(1, 3)
        写日志(格式化文本("已重建信号量：初始值=1，最大值=3，当前可用={}", 信号量_取可用数量(演示信号量)))
    结束

    事件 _推荐演示按钮_被单击()
        _多参数提交按钮_被单击()
        _进度任务按钮_被单击()
        _创建线程池按钮_被单击()
        _互斥执行按钮_被单击()
        _原子操作按钮_被单击()
        写日志("推荐演示已启动；事件和信号量需要在对应标签页分两步操作。")
    结束

    事件 _清空日志按钮_被单击()
        日志序号 = 0
        控件_设置文本(运行日志, "")
    结束

    线程演示结果 多参数工作(整数型 基数, 文本型 批次, 逻辑型 启用, 线程演示输入 输入, 整数型[] 附加)
        局部 线程演示结果 结果
        结果.合计 = 基数 + 输入.数量
        @ for (const auto value : 输入 . 样本) 结果 . 合计 += value;
        @ for (const auto value : 附加) 结果 . 合计 += value;
        结果.摘要 = 批次 + " / " + 输入.名称 + " / " + 输入.元数据.来源
        结果.成功 = 启用
        @ 结果 . 输出 = 附加;
        线程_协作等待(120)
        返回 结果
    结束

    整数型[] 数组翻倍工作(整数型[] 输入)
        @ for (auto& value : 输入) value *= 2;
        线程_协作等待(80)
        返回 输入
    结束

    空 短工作(整数型 毫秒)
        线程_取当前任务()
        线程_协作等待(毫秒)
    结束

    空 长工作(整数型 次数)
        局部 整数型 i = 0
        计次循环首 (次数, i)
            如果 (线程_是否请求取消(0))
                返回
            如果结束
            如果 (线程_协作等待(50) == 假)
                返回
            如果结束
        计次循环尾 ()
    结束

    整数型 求和工作(整数型 左值, 整数型 右值)
        线程_协作等待(100)
        返回 左值 + 右值
    结束

    空 进度工作(文本型 标题, 整数型 步数)
        局部 整数型 i = 0
        计次循环首 (步数, i)
            如果 (线程_是否请求取消(线程_取当前任务()))
                返回
            如果结束
            线程_报告进度(i * 100 / 步数, 格式化文本("{}：第 {} 步", 标题, i))
            如果 (线程_协作等待(90) == 假)
                返回
            如果结束
        计次循环尾 ()
    结束

    空 失败工作()
        @ throw std::runtime_error("threading demo expected failure");
    结束

    空 受锁增加(整数型 增量)
        受锁计数 = 受锁计数 + 增量
    结束

    逻辑型 等待事件工作(线程同步事件 事件)
        局部 逻辑型 等待成功 = 线程事件_等待(事件, 5000)
        返回 等待成功
    结束

    逻辑型 等待信号量工作(线程信号量 信号量)
        局部 逻辑型 等待成功 = 信号量_等待(信号量, 5000)
        返回 等待成功
    结束

    空 记录完成(线程任务 任务, 线程演示结果 结果)
        写日志(格式化文本("记录完成：任务={}，状态={}，合计={}，摘要={}，数组字段已按值返回", 任务, 线程_取状态名称(任务), 结果.合计, 结果.摘要))
    结束

    空 数组完成(线程任务 任务, 整数型[] 结果)
        写日志(格式化文本("数组完成：任务={}，状态={}，数组结果已按值返回", 任务, 线程_取状态名称(任务)))
    结束

    空 整数完成(线程任务 任务, 整数型 结果)
        写日志(格式化文本("整数完成：任务={}，结果={}，状态={}", 任务, 结果, 线程_取状态名称(任务)))
    结束

    空 工作进度(线程任务 任务, 整数型 百分比, 文本型 说明)
        写日志(格式化文本("进度：任务={}，{}% - {}", 任务, 百分比, 说明))
    结束

    空 空结果完成(线程任务 任务)
        写日志(格式化文本("空结果完成：任务={}，状态={}，错误={}", 任务, 线程_取状态名称(任务), 线程_取错误(任务)))
    结束

    空 事件等待完成(线程任务 任务, 逻辑型 已置位)
        写日志(格式化文本("事件等待完成：任务={}，结果={}，状态={}", 任务, 已置位, 线程_取状态名称(任务)))
    结束

    空 信号量等待完成(线程任务 任务, 逻辑型 已获得)
        写日志(格式化文本("信号量等待完成：任务={}，结果={}，剩余={}", 任务, 已获得, 信号量_取可用数量(演示信号量)))
    结束
结束类
