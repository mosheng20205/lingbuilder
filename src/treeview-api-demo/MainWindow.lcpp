包 TreeView完整示例
使用 Win32窗口基础模块
使用 Win32高级控件模块

类 MainWindow : 公开 窗体
    事件 _MainWindow_创建完毕()
        调试输出("TreeView 完整接口示例已启动")
        树形框_添加节点(演示树, "", "运行时根节点")
        树形框_添加节点(演示树, "运行时根节点", "运行时子节点")
        控件_设置文本(接口状态, "已创建：节点集合、运行时追加和全部事件均已就绪")
    结束

    空 重建演示树()
        控件_清空项目(演示树)
        树形框_添加节点(演示树, "", "项目")
        树形框_添加节点(演示树, "项目", "源代码")
        树形框_添加节点(演示树, "项目", "资源")
        树形框_添加节点(演示树, "源代码", "MainWindow.lcpp")
        树形框_添加节点(演示树, "源代码", "treeViewApi.cpp")
        树形框_添加节点(演示树, "资源", "图像列表")
        控件_设置文本(接口状态, "已调用清空项目和树形框_添加节点：完整示例树已重建")
    结束

    空 运行全部接口()
        控件_清空项目(演示树)
        树形框_添加节点(演示树, "", "接口根节点")
        树形框_添加节点(演示树, "接口根节点", "根节点的子节点")
        树形框_添加节点(演示树, "根节点的子节点", "三级节点")
        树形框_添加节点(演示树, "接口根节点", "第二个子节点")
        控件_设置文本(接口状态, "运行完成：根级、子级和多级树形框_添加节点调用均已执行")
        调试输出("TreeView 运行时接口演示完成", 真)
    结束

    事件 _重建树按钮_被单击()
        重建演示树()
    结束

    事件 _添加根节点按钮_被单击()
        树形框_添加节点(演示树, "", "新建根节点")
        控件_设置文本(接口状态, "已追加根节点：父节点文字为空")
    结束

    事件 _添加子节点按钮_被单击()
        树形框_添加节点(演示树, "项目", "新建子节点")
        控件_设置文本(接口状态, "已按父节点文字追加子节点")
    结束

    事件 _清空树按钮_被单击()
        控件_清空项目(演示树)
        控件_设置文本(接口状态, "已清空 TreeView 项目，可继续添加节点")
    结束

    事件 _运行全部接口按钮_被单击()
        运行全部接口()
    结束

    事件 _显示当前页按钮_被单击()
        调试输出("当前选项卡索引", 控件_取选择项(功能选项卡), 真)
        控件_设置文本(接口状态, "已读取当前选项卡索引")
    结束

    事件 _功能选项卡_选择项被改变()
        调试输出("选项卡被改变", 控件_取选择项(功能选项卡), 真)
    结束

    事件 _演示树_选择节点被改变()
        调试输出("TreeView 事件：选择节点被改变", 真)
        控件_设置文本(接口状态, "事件已触发：选择节点被改变")
    结束

    事件 _演示树_节点被展开()
        调试输出("TreeView 事件：节点被展开", 真)
        控件_设置文本(接口状态, "事件已触发：节点被展开")
    结束

    事件 _演示树_节点被折叠()
        调试输出("TreeView 事件：节点被折叠", 真)
        控件_设置文本(接口状态, "事件已触发：节点被折叠")
    结束

    事件 _演示树_被双击()
        调试输出("TreeView 事件：节点被双击", 真)
        控件_设置文本(接口状态, "事件已触发：节点被双击")
    结束
结束类
