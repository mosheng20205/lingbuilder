包 微信读消息探针
使用 OP 后台图色模块
使用 微信OCR识别模块
使用 文件目录模块

// 微信读消息探针：验证「后台截图 + 红点识别 + OCR 读消息」
// 运行前提：本机已登录 Windows 版微信 4.x（进程 Weixin.exe）。
// 输出：调试输出走控制台 stdout；截图 BMP 落盘 src/wechat-probe/out/。
// 实测：wgc 后端在无消息泵的控制台进程会卡死，已移除；gdi2 能截图但微信 4.x (Qt+GPU) 画面基本空白。
类 程序
公开
  整数型 识别并输出(文本型 路径)
    局部 OCR结果句柄 结果
    局部 整数型 行数 = 0
    局部 整数型 行 = 0
    局部 整数型 索引 = 0
    结果 = OCR_识别(路径)
    如果 (结果 = 0)
      调试输出("  [OCR失败] " + OCR_取错误())
      返回 (-1)
    如果结束
    行数 = OCR结果_取行数(结果)
    调试输出("  OCR行数=" + 到文本(行数) + " 图像=" + 到文本(OCR结果_取宽度(结果)) + "x" + 到文本(OCR结果_取高度(结果)))
    计次循环首 (行数, 行)
      索引 = 行 - 1
      调试输出("  行" + 到文本(索引) + " [" + 到文本(OCR结果_取左坐标(结果, 索引)) + "," + 到文本(OCR结果_取上坐标(结果, 索引)) + " - " + 到文本(OCR结果_取右坐标(结果, 索引)) + "," + 到文本(OCR结果_取下坐标(结果, 索引)) + "] " + OCR结果_取文本(结果, 索引))
    计次循环尾 ()
    OCR结果_释放(结果)
    返回 (行数)
  结束

  文本型 尝试后端(OP句柄 引擎, 长整数型 微信窗口, 文本型 后端, 整数型 客户宽, 整数型 客户高, 文本型 输出目录)
    局部 文本型 截图路径 = 输出目录 + "/wechat_" + 后端 + ".bmp"
    局部 逻辑型 绑定成功 = 假
    局部 逻辑型 截图成功 = 假
    局部 整数型 文件大小 = 0
    局部 文本型 红点集 = ""
    绑定成功 = 后台_绑定窗口(引擎, 微信窗口, 后端, "windows", "windows", 0)
    如果 (绑定成功 = 假)
      调试输出("[后端 " + 后端 + "] 绑定失败: " + 后台_取错误())
      返回 ("")
    如果结束
    截图成功 = 后台_截图(引擎, 0, 0, 客户宽, 客户高, 截图路径)
    如果 (截图成功 = 假)
      调试输出("[后端 " + 后端 + "] 截图失败: " + 后台_取错误())
      返回 ("")
    如果结束
    文件大小 = 文件_取大小(截图路径)
    红点集 = 后台_找色全部(引擎, 0, 0, 客户宽 / 3, 客户高, "FA5151|FF5C5C|E64545|FF4D4A|F0484A", 0.85, 0)
    调试输出("[后端 " + 后端 + "] 截图 " + 到文本(文件大小) + "字节; 列表区红点候选: [" + 红点集 + "]")
    返回 (截图路径)
  结束

  整数型 启动()
    局部 OP句柄 引擎
    局部 长整数型 微信窗口 = 0
    局部 整数型 客户宽 = 0
    局部 整数型 客户高 = 0
    局部 整数型 窗左 = 0
    局部 整数型 窗上 = 0
    局部 整数型 窗右 = 0
    局部 整数型 窗下 = 0
    局部 文本型 输出目录 = "T:/electron/lingbuilder/src/wechat-probe/out"
    局部 文本型 路径1 = ""
    局部 文本型 路径2 = ""
    局部 文本型 路径3 = ""

    调试输出("=== 微信读消息探针 开始 ===")
    调试输出("OCR模块: " + OCR_取版本())
    调试输出("微信OCR组件: " + OCR_取微信状态())

    引擎 = 后台_创建()
    如果 (引擎 = 0)
      调试输出("[FAIL] 后台_创建 失败: " + 后台_取错误())
      返回 (1)
    如果结束

    调试输出("Weixin.exe 可见窗口: " + 后台_按进程枚举窗口(引擎, "Weixin.exe", "", "", 1))
    微信窗口 = 后台_按进程找窗口(引擎, "Weixin.exe", "", "")
    如果 (微信窗口 = 0)
      调试输出("[FAIL] 未找到 Weixin.exe 主窗口，请确认微信已登录")
      后台_销毁(引擎)
      返回 (2)
    如果结束
    调试输出("主窗口句柄=" + 到文本(微信窗口) + " 标题=" + 后台_取窗口标题(引擎, 微信窗口) + " 类名=" + 后台_取窗口类名(引擎, 微信窗口))
    后台_取窗口矩形(引擎, 微信窗口, 窗左, 窗上, 窗右, 窗下)
    调试输出("窗口矩形: [" + 到文本(窗左) + "," + 到文本(窗上) + "] - [" + 到文本(窗右) + "," + 到文本(窗下) + "]")
    后台_取客户区尺寸(引擎, 微信窗口, 客户宽, 客户高)
    调试输出("客户区: " + 到文本(客户宽) + " x " + 到文本(客户高))

    目录_创建(输出目录)

    路径1 = 尝试后端(引擎, 微信窗口, "gdi2", 客户宽, 客户高, 输出目录)
    路径3 = 尝试后端(引擎, 微信窗口, "normal", 客户宽, 客户高, 输出目录)

    如果 (路径1 != "")
      调试输出("===== OCR (gdi2) =====")
      识别并输出(路径1)
    如果结束
    如果 (路径3 != "")
      调试输出("===== OCR (normal) =====")
      识别并输出(路径3)
    如果结束

    如果 ((路径1 = "") 且 (路径3 = ""))
      调试输出("[FAIL] 所有后端均未产出截图")
      后台_销毁(引擎)
      返回 (3)
    如果结束
    调试输出("=== 微信读消息探针 结束 ===")
    返回 (0)
  结束
结束类
