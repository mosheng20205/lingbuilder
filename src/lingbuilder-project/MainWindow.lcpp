类 MainWindow
    整数型 IP请求编号

    事件 创建完毕()
        调试输出("窗口创建完毕")
    结束

    事件 _按钮1_被单击()
        调试输出("按钮1被单击")
        编辑框1.内容 = "正在获取本机IP……"
        IP请求编号 = 网页_异步访问("https://ipinfo.io/json", 0, &获取IP完成)
        如果 (IP请求编号 == 0)
            编辑框1.内容 = "无法启动后台请求"
        如果结束
    结束

    事件 获取IP完成()
        局部 文本型 错误信息
        IP请求编号 = 网页_异步取当前请求编号()
        错误信息 = 网页_异步取错误信息(IP请求编号)
        如果 (错误信息 != "")
            编辑框1.内容 = "获取失败：" + 错误信息
        否则
            编辑框1.内容 = 网页_异步取返回文本(IP请求编号)
        如果结束
    结束
结束类
