类 MainWindow
    整数型 IP请求编号

    事件 创建完毕()
        调试输出("窗口创建完毕")
        控件_设置文本(状态标签, "就绪")
    结束

    事件 _按钮1_被单击()
        调试输出("按钮1被单击")
        编辑框1.内容 = "正在获取本机IP……"
        控件_设置文本(状态标签, "正在获取…")
        IP请求编号 = 网页_异步访问("https://ipinfo.io/json", 0, &获取IP完成)
        如果 (IP请求编号 == 0)
            编辑框1.内容 = "无法启动后台请求"
            控件_设置文本(状态标签, "请求失败")
        如果结束
    结束

    事件 获取IP完成()
        局部 文本型 错误信息
        IP请求编号 = 网页_异步取当前请求编号()
        错误信息 = 网页_异步取错误信息(IP请求编号)
        如果 (错误信息 != "")
            编辑框1.内容 = "获取失败：" + 错误信息
            控件_设置文本(状态标签, "获取失败")
        否则
            编辑框1.内容 = 网页_异步取返回文本(IP请求编号)
            控件_设置文本(状态标签, "获取成功")
        如果结束
    结束

    事件 _清空按钮_被单击()
        编辑框1.内容 = ""
        控件_设置文本(状态标签, "已清空")
    结束

    事件 _复制按钮_被单击()
        局部 文本型 内容
        内容 = 控件_取文本(编辑框1)
        如果 (内容 != "")
            剪贴板_置文本(内容)
            控件_设置文本(状态标签, "已复制")
        否则
            控件_设置文本(状态标签, "没有可复制的内容")
        如果结束
    结束
结束类
