包 选项卡TabControl完整接口示例
使用 Win32窗口基础模块
使用 Win32高级控件模块

类 MainWindow : 公开 窗体
    事件 _MainWindow_创建完毕()
        控件_设置文本("操作状态", "状态：已创建 4 个设计器标签页；请选择右侧接口按钮。")
        调试输出("TabControl 示例已启动；默认选中页：", 控件_取选择项("演示选项卡"), 真)
    结束

    // 01：通用选择接口。索引从 0 开始。
    事件 _设置第一页按钮_被单击()
        控件_设置选择项("演示选项卡", 0)
        控件_设置文本("操作状态", "已调用 控件_设置选择项：当前页 = 0（基础页面）。")
    结束

    事件 _设置第二页按钮_被单击()
        控件_设置选择项("演示选项卡", 1)
        控件_设置文本("操作状态", "已调用 控件_设置选择项：当前页 = 1（动态页面）。")
    结束

    // 02：通用读取接口。
    事件 _读取当前页按钮_被单击()
        局部 整数型 当前页 = -1
        当前页 = 控件_取选择项("演示选项卡")
        调试输出("控件_取选择项 返回：", 当前页, 真)
        控件_设置文本("操作状态", "已调用 控件_取选择项：当前页索引 = " + 到文本(当前页))
    结束

    // 03：专属动态页接口。
    事件 _添加运行页按钮_被单击()
        局部 整数型 新页索引 = -1
        新页索引 = 选项卡_添加页("演示选项卡", "运行时新增页")
        调试输出("选项卡_添加页 返回：", 新页索引, 真)
        控件_设置选择项("演示选项卡", 新页索引)
        控件_设置文本("操作状态", "已调用 选项卡_添加页：新增页索引 = " + 到文本(新页索引))
    结束

    // 04：通用清空接口。清空后仍可用“恢复初始页”重新添加页面。
    事件 _清空全部页按钮_被单击()
        控件_清空项目("演示选项卡")
        控件_设置文本("操作状态", "已调用 控件_清空项目：标签页已清空，请点击“恢复初始页”。")
    结束

    事件 _恢复初始页按钮_被单击()
        选项卡_添加页("演示选项卡", "基础页面")
        选项卡_添加页("演示选项卡", "动态页面")
        选项卡_添加页("演示选项卡", "主题与表头")
        选项卡_添加页("演示选项卡", "嵌套控件")
        控件_设置选择项("演示选项卡", 0)
        控件_设置文本("操作状态", "已恢复 4 个运行时标签页；设计器中的页面内容仍由页面槽位承载。")
    结束

    // 05：专属表头接口。
    事件 _隐藏表头按钮_被单击()
        选项卡_设置隐藏表头("演示选项卡", 真)
        控件_设置文本("操作状态", "已调用 选项卡_设置隐藏表头(真)：标签表头已隐藏。")
    结束

    事件 _显示表头按钮_被单击()
        选项卡_设置隐藏表头("演示选项卡", 假)
        控件_设置文本("操作状态", "已调用 选项卡_设置隐藏表头(假)：标签表头已显示。")
    结束

    事件 _读取表头状态按钮_被单击()
        局部 逻辑型 是否隐藏 = 假
        是否隐藏 = 选项卡_取隐藏表头("演示选项卡")
        调试输出("选项卡_取隐藏表头 返回：", 是否隐藏, 真)
        如果 (是否隐藏)
            控件_设置文本("操作状态", "选项卡_取隐藏表头 返回：真（当前隐藏）。")
        否则
            控件_设置文本("操作状态", "选项卡_取隐藏表头 返回：假（当前显示）。")
        如果结束
    结束

    // 06：TabControl 的容器事件。切换页面时读取当前索引。
    事件 _演示选项卡_标签页被改变()
        局部 整数型 当前页 = -1
        当前页 = 控件_取选择项("演示选项卡")
        调试输出("事件：标签页被改变，当前页 = ", 当前页, 真)
        控件_设置文本("操作状态", "事件：标签页被改变；当前页索引 = " + 到文本(当前页))
    结束

    事件 _第一页按钮_被单击()
        控件_设置文本("页面事件状态", "基础页面按钮已被单击；页面内子控件事件正常工作。")
    结束
结束类
