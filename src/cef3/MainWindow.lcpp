类 MainWindow : 窗口
公开
    构造()
    结束

    事件 _MainWindow_创建完毕()
        控件_设置文本(地址栏, "https://www.baidu.com")
        控件_设置启用(后退按钮, 假)
        控件_设置启用(前进按钮, 假)
        调试输出("CEF3 浏览器窗口创建完毕")
    结束

    事件 _MainWindow_大小被改变()
        局部 整数型 窗口宽度 = 窗口_取事件宽度()
        局部 整数型 窗口高度 = 窗口_取事件高度()
        局部 整数型 当前DPI = 窗口_取事件DPI()

        如果 (当前DPI <= 0)
            当前DPI = 96
        如果结束

        如果 (窗口宽度 < 360 * 当前DPI / 96)
            窗口宽度 = 360 * 当前DPI / 96
        如果结束
        如果 (窗口高度 < 160 * 当前DPI / 96)
            窗口高度 = 160 * 当前DPI / 96
        如果结束

        控件_设置位置大小(后退按钮, 8 * 当前DPI / 96, 8 * 当前DPI / 96, 48 * 当前DPI / 96, 34 * 当前DPI / 96)
        控件_设置位置大小(前进按钮, 60 * 当前DPI / 96, 8 * 当前DPI / 96, 48 * 当前DPI / 96, 34 * 当前DPI / 96)
        控件_设置位置大小(刷新按钮, 112 * 当前DPI / 96, 8 * 当前DPI / 96, 48 * 当前DPI / 96, 34 * 当前DPI / 96)
        控件_设置位置大小(地址栏, 164 * 当前DPI / 96, 8 * 当前DPI / 96, 窗口宽度 - 274 * 当前DPI / 96, 34 * 当前DPI / 96)
        控件_设置位置大小(导航按钮, 窗口宽度 - 102 * 当前DPI / 96, 8 * 当前DPI / 96, 94 * 当前DPI / 96, 34 * 当前DPI / 96)
        控件_设置位置大小(CEF3浏览器1, 0, 48 * 当前DPI / 96, 窗口宽度, 窗口高度 - 48 * 当前DPI / 96)
    结束

    事件 _后退按钮_被单击()
        CEF3_后退(CEF3浏览器1)
    结束

    事件 _前进按钮_被单击()
        CEF3_前进(CEF3浏览器1)
    结束

    事件 _刷新按钮_被单击()
        CEF3_刷新(CEF3浏览器1)
    结束

    事件 _导航按钮_被单击()
        局部 文本型 导航地址 = 控件_取文本(地址栏)

        如果 (导航地址 != "")
            CEF3_导航(CEF3浏览器1, 导航地址)
        如果结束
    结束

    事件 _CEF3浏览器1_加载状态改变()
        控件_设置启用(后退按钮, CEF3_是否可后退(CEF3浏览器1) != 0)
        控件_设置启用(前进按钮, CEF3_是否可前进(CEF3浏览器1) != 0)
    结束

    事件 _CEF3浏览器1_加载完成()
        控件_设置文本(地址栏, CEF3_取地址(CEF3浏览器1))
    结束

    事件 _CEF3浏览器1_地址被改变()
        控件_设置文本(地址栏, CEF3_取地址(CEF3浏览器1))
    结束

    事件 _CEF3浏览器1_新窗口打开前()
        局部 文本型 目标地址 = CEF3_取事件字段(CEF3浏览器1, "url")

        // 接管弹窗请求并把目标地址交给当前浏览器，不创建新的浏览器窗口。
        CEF3_设置事件结果(CEF3浏览器1, 3)
        如果 (目标地址 != "")
            CEF3_导航(CEF3浏览器1, 目标地址)
        如果结束
    结束
结束类
