包 ListView完整示例
使用 Win32窗口基础模块
使用 Win32高级控件模块

类 MainWindow : 公开 窗体
    事件 _MainWindow_创建完毕()
        控件_设置可见(普通列表, 真)
        控件_设置启用(普通列表, 真)
        重建普通列表()
        重建虚拟列表()
        控件_设置选择项(普通列表, 0)
        调试输出("普通列表当前行数", 列表视图_取行数(普通列表), 真)
        调试输出("虚拟列表当前行数", 列表视图_取行数(虚拟列表), 真)
    结束

    空 测试列状态查找接口()
        重建普通列表()
        列表视图_添加列(普通列表, "临时列", 100, "center")
        列表视图_插入列(普通列表, 1, "插入列", 110, "left")
        列表视图_设置列标题(普通列表, 1, "已修改列")
        调试输出("列标题", 列表视图_取列标题(普通列表, 1), 真)
        列表视图_设置列宽(普通列表, 1, 135)
        调试输出("列宽", 列表视图_取列宽(普通列表, 1), 真)
        调试输出("列数", 列表视图_取列数(普通列表), 真)
        列表视图_删除列(普通列表, 列表视图_取列数(普通列表) - 1)
        列表视图_设置扩展样式(普通列表, "checkBoxes", 真)
        列表视图_设置行选中(普通列表, 0, 真)
        调试输出("选中行数", 列表视图_取选中行数(普通列表), 真)
        调试输出("下一个选中行", 列表视图_取下一个选中行(普通列表, -1), 真)
        列表视图_设置行勾选(普通列表, 0, 真)
        调试输出("行勾选", 列表视图_取行勾选(普通列表, 0), 真)
        列表视图_设置焦点行(普通列表, 0)
        调试输出("焦点行", 列表视图_取焦点行(普通列表), 真)
        列表视图_设置行图像(普通列表, 0, 0)
        调试输出("行图像", 列表视图_取行图像(普通列表, 0), 真)
        列表视图_设置行数据(普通列表, 0, 1001)
        调试输出("行数据", 列表视图_取行数据(普通列表, 0), 真)
        调试输出("查找代码段", 列表视图_查找文本(普通列表, "代码段", -1, 假), 真)
        调试输出("命中行", 列表视图_命中测试行(普通列表, 30, 45), 真)
        调试输出("命中列", 列表视图_命中测试列(普通列表, 30, 45), 真)
        调试输出("行矩形", 列表视图_取行矩形(普通列表, 0, "bounds"), 真)
        调试输出("单元格矩形", 列表视图_取单元格矩形(普通列表, 0, 1), 真)
        列表视图_保证可见(普通列表, 0, 假)
        调试输出("行可见", 列表视图_是否可见(普通列表, 0), 真)
        列表视图_滚动(普通列表, 0, 28)
        调试输出("顶部行", 列表视图_取顶部行(普通列表), 真)
        调试输出("每页行数", 列表视图_取每页行数(普通列表), 真)
        列表视图_重绘行(普通列表, 0, 1)
        列表视图_更新行(普通列表, 0)
        控件_设置文本(接口状态, "列、状态、查找与布局接口执行完成")
    结束

    空 测试视图样式颜色接口()
        列表视图_设置视图(普通列表, "list")
        调试输出("当前视图", 列表视图_取视图(普通列表), 真)
        列表视图_设置视图(普通列表, "details")
        列表视图_设置扩展样式(普通列表, "gridLines", 真)
        列表视图_设置扩展样式(普通列表, "fullRowSelect", 真)
        列表视图_设置扩展样式(普通列表, "doubleBuffer", 真)
        列表视图_设置扩展样式(普通列表, "headerDragDrop", 真)
        列表视图_设置扩展样式(普通列表, "infoTip", 真)
        列表视图_设置扩展样式(普通列表, "labelTip", 真)
        列表视图_设置扩展样式(普通列表, "trackSelect", 真)
        列表视图_设置扩展样式(普通列表, "borderSelect", 真)
        调试输出("网格线样式", 列表视图_取扩展样式(普通列表, "gridLines"), 真)
        列表视图_设置背景色(普通列表, 15, 23, 42)
        调试输出("背景色", 列表视图_取背景色(普通列表), 真)
        列表视图_设置文字色(普通列表, 226, 232, 240)
        调试输出("文字色", 列表视图_取文字色(普通列表), 真)
        列表视图_设置文字背景色(普通列表, 15, 23, 42)
        调试输出("文字背景色", 列表视图_取文字背景色(普通列表), 真)
        控件_设置文本(接口状态, "视图、扩展样式与颜色接口执行完成")
    结束

    空 测试分组标签热项接口()
        重建普通列表()
        列表视图_添加组(普通列表, 1, "代码资源")
        列表视图_添加组(普通列表, 2, "其他资源")
        列表视图_启用分组(普通列表, 真)
        调试输出("分组启用", 列表视图_取分组启用(普通列表), 真)
        调试输出("组数", 列表视图_取组数(普通列表), 真)
        调试输出("是否有组1", 列表视图_是否有组(普通列表, 1), 真)
        列表视图_设置组标题(普通列表, 1, "代码与数据")
        调试输出("组标题", 列表视图_取组标题(普通列表, 1), 真)
        列表视图_设置行组(普通列表, 0, 1)
        调试输出("行组", 列表视图_取行组(普通列表, 0), 真)
        列表视图_删除组(普通列表, 2)
        列表视图_设置标签可编辑(普通列表, 真)
        列表视图_开始标签编辑(普通列表, 0)
        列表视图_取消标签编辑(普通列表)
        列表视图_设置选择标记(普通列表, 0)
        调试输出("选择标记", 列表视图_取选择标记(普通列表), 真)
        列表视图_设置热项(普通列表, 0)
        调试输出("热项", 列表视图_取热项(普通列表), 真)
        列表视图_设置悬停时间(普通列表, 400)
        调试输出("悬停时间", 列表视图_取悬停时间(普通列表), 真)
        列表视图_清空组(普通列表)
        控件_设置文本(接口状态, "分组、标签编辑、选择标记与热项接口执行完成")
    结束

    空 测试图像插入标记布局接口()
        重建普通列表()
        列表视图_设置图像列表(普通列表, ListView示例图像列表, "small")
        调试输出("表头句柄", 列表视图_取表头句柄(普通列表), 真)
        调试输出("字符串宽度", 列表视图_取字符串宽度(普通列表, "分类段名称"), 真)
        列表视图_设置插入标记(普通列表, 1, 真)
        调试输出("插入标记", 列表视图_取插入标记(普通列表), 真)
        列表视图_设置视图(普通列表, "icon")
        列表视图_设置项目位置(普通列表, 0, 20, 20)
        调试输出("项目位置", 列表视图_取项目位置(普通列表, 0), 真)
        列表视图_设置图标间距(普通列表, 100, 80)
        列表视图_排列图标(普通列表, "snap")
        调试输出("近似尺寸", 列表视图_取近似尺寸(普通列表, 10, 400, 300), 真)
        列表视图_设置视图(普通列表, "details")
        控件_设置文本(接口状态, "图像列表、插入标记与图标布局接口执行完成")
    结束

    空 重建普通列表()
        局部 整数型 i = 0
        局部 文本型 文本序号 = ""
        控件_清空项目(普通列表)
        列表视图_开始批量更新(普通列表)
        计次循环首 (3, i)
            文本序号 = 到文本(i)
            // 截图中的正确用法：序号和第一项数据之间必须有 \t。
            列表视图_添加行(普通列表, 文本序号 + "\t代码段\t128\t5")
        计次循环尾 ()
        列表视图_插入行(普通列表, 1, "99\t插入的数据\t512\t20")
        列表视图_批量添加行(普通列表, "4\t导入段\t80\t6\n5\t重定位段\t96\t8")
        列表视图_结束批量更新(普通列表)
    结束

    空 重建虚拟列表()
        局部 整数型 i = 0
        局部 文本型 文本序号 = ""
        控件_清空项目(虚拟列表)
        列表视图_开始批量更新(虚拟列表)
        列表视图_设置虚拟行数(虚拟列表, 15000)
        计次循环首 (15000, i)
            文本序号 = 到文本(i)
            // 正确用法：序号和第一项数据之间必须有 \t。
            列表视图_设置虚拟行(虚拟列表, i - 1, 文本序号 + "\t代码段\t128\t5")
        计次循环尾 ()
        列表视图_结束批量更新(虚拟列表)
    结束

    事件 _重建普通列表按钮_被单击()
        重建普通列表()
    结束

    事件 _插入行按钮_被单击()
        列表视图_插入行(普通列表, 1, "99\t插入的数据\t512\t20")
    结束

    事件 _修改单元格按钮_被单击()
        列表视图_设置单元格(普通列表, 0, 1, "修改后的代码段")
    结束

    事件 _读取单元格按钮_被单击()
        局部 整数型 选中行 = -1
        局部 文本型 单元格内容 = ""
        选中行 = 控件_取选择项(普通列表)
        如果 (选中行 < 0)
            信息框("请先在普通列表中选择一行。", 48, "读取单元格")
        如果结束
        如果 (选中行 >= 0)
            单元格内容 = 列表视图_取单元格(普通列表, 选中行, 1)
            信息框("第 " + 到文本(选中行 + 1) + " 行、第 2 列的值：" + 单元格内容, 64, "读取单元格")
        如果结束
    结束

    事件 _读取选中行按钮_被单击()
        局部 整数型 选中行 = -1
        局部 整数型 选中行数 = 0
        局部 整数型 首个选中行 = -1
        局部 文本型 行内容 = ""
        局部 文本型 选中行文本 = ""
        局部 文本型 选中行数文本 = ""
        局部 文本型 首个选中行文本 = ""
        选中行 = 控件_取选择项(普通列表)
        选中行数 = 列表视图_取选中行数(普通列表)
        首个选中行 = 列表视图_取下一个选中行(普通列表, -1)
        如果 (选中行 < 0)
            信息框("请先选择一行；按住 Ctrl 可选择多行。", 48, "读取选中行")
        如果结束
        如果 (选中行 >= 0)
            行内容 = 列表视图_取单元格(普通列表, 选中行, 0)
            选中行文本 = 到文本(选中行)
            选中行数文本 = 到文本(选中行数)
            首个选中行文本 = 到文本(首个选中行)
            信息框("控件_取选择项：" + 选中行文本 + "\n选中行数：" + 选中行数文本 + "\n首个选中行：" + 首个选中行文本 + "\n第 1 列内容：" + 行内容, 64, "读取选中行")
        如果结束
    结束

    事件 _删除选中行按钮_被单击()
        局部 整数型 选中行 = -1
        选中行 = 控件_取选择项(普通列表)
        如果 (选中行 >= 0)
            列表视图_删除行(普通列表, 选中行)
        如果结束
    结束

    事件 _排序按钮_被单击()
        列表视图_排序(普通列表, 1, 真)
    结束

    事件 _重建虚拟列表按钮_被单击()
        重建虚拟列表()
    结束

    事件 _修改虚拟行按钮_被单击()
        列表视图_设置虚拟行(虚拟列表, 99, "100\t虚拟行已修改\t1024\t99")
        列表视图_设置单元格(虚拟列表, 99, 2, "2048")
        调试输出("虚拟列表模式", 列表视图_取虚拟模式(虚拟列表), 真)
        调试输出("虚拟第100行名称", 列表视图_取单元格(虚拟列表, 99, 1), 真)
    结束

    事件 _清空按钮_被单击()
        控件_清空项目(普通列表)
        控件_清空项目(虚拟列表)
    结束

    事件 _列与状态测试按钮_被单击()
        测试列状态查找接口()
    结束

    事件 _视图样式测试按钮_被单击()
        测试视图样式颜色接口()
    结束

    事件 _分组标签测试按钮_被单击()
        测试分组标签热项接口()
    结束

    事件 _图标布局测试按钮_被单击()
        测试图像插入标记布局接口()
    结束

    事件 _运行全部接口按钮_被单击()
        测试列状态查找接口()
        测试视图样式颜色接口()
        测试分组标签热项接口()
        测试图像插入标记布局接口()
        控件_设置文本(接口状态, "85 条 ListView 高层命令已全部调用")
    结束

    事件 _普通列表_选择项被改变()
        调试输出("普通列表选择行", 控件_取选择项(普通列表), 真)
    结束

    事件 _普通列表_被双击()
        调试输出("普通列表双击内容", 列表视图_取单元格(普通列表, 控件_取选择项(普通列表), 1), 真)
    结束

    事件 _普通列表_列被单击()
        局部 整数型 列索引 = -1
        列索引 = 列表视图_取最后单击列(普通列表)
        列表视图_排序(普通列表, 列索引, 真)
    结束

    事件 _虚拟列表_选择项被改变()
        调试输出("虚拟列表选择行", 控件_取选择项(虚拟列表), 真)
    结束

    事件 _虚拟列表_被双击()
        调试输出("虚拟列表双击内容", 列表视图_取单元格(虚拟列表, 控件_取选择项(虚拟列表), 1), 真)
    结束

    事件 _虚拟列表_列被单击()
        局部 整数型 列索引 = -1
        列索引 = 列表视图_取最后单击列(虚拟列表)
        列表视图_排序(虚拟列表, 列索引, 真)
    结束
结束类
