包 动态图像控件完整接口示例
使用 Win32窗口基础模块
使用 Win32高级控件模块

类 MainWindow : 公开 窗体
    事件 _MainWindow_创建完毕()
        控件_设置文本(运行状态, "已加载：动态图像控件完整接口示例")
        控件_设置选择项(演示选项卡, 0)
        调试输出("动态图像控件示例已启动", "GIF 资源：assets/animated-image-api-demo/animated-image-demo.gif", 真)
    结束

    空 运行全部演示()
        控件_设置选择项(演示选项卡, 0)
        调试输出("填充方式", "原始大小、拉伸填满、等比适应、等比填满", 真)
        控件_设置选择项(演示选项卡, 1)
        调试输出("播放配置", "自动播放+循环、自动播放+单次、手动播放配置", 真)
        控件_设置选择项(演示选项卡, 2)
        调试输出("资源与提示", "GIF 文件、工具提示和延迟", 真)
        控件_设置选择项(演示选项卡, 3)
        调试输出("事件演示", "单击、鼠标按下、移入、移出、播放完毕", 真)
        控件_设置文本(运行状态, "全部配置与事件入口已调用，请操作各个选项卡中的控件")
    结束

    事件 _全部演示按钮_被单击()
        运行全部演示()
    结束

    事件 _填充方式按钮_被单击()
        控件_设置选择项(演示选项卡, 0)
        控件_设置文本(运行状态, "当前页：填充方式（4 种 stretch 配置）")
    结束

    事件 _播放配置按钮_被单击()
        控件_设置选择项(演示选项卡, 1)
        控件_设置文本(运行状态, "当前页：播放配置（自动播放与循环组合）")
    结束

    事件 _资源提示按钮_被单击()
        控件_设置选择项(演示选项卡, 2)
        控件_设置文本(运行状态, "当前页：GIF 资源与工具提示")
    结束

    事件 _事件演示按钮_被单击()
        控件_设置选择项(演示选项卡, 3)
        控件_设置文本(运行状态, "当前页：动态图像控件事件")
    结束

    事件 _演示选项卡_标签页被改变()
        调试输出("当前演示页", 控件_取选择项(演示选项卡), 真)
    结束

    事件 _适应图像_被单击()
        控件_设置文本(填充状态, "已单击：适应")
        调试输出("适应图像 Click", 真)
    结束

    事件 _填充图像_被单击()
        控件_设置文本(填充状态, "已单击：填充")
        调试输出("填充图像 Click", 真)
    结束

    事件 _覆盖图像_被单击()
        控件_设置文本(填充状态, "已单击：覆盖")
        调试输出("覆盖图像 Click", 真)
    结束

    事件 _原始图像_被单击()
        控件_设置文本(填充状态, "已单击：原始大小")
        调试输出("原始图像 Click", 真)
    结束

    事件 _资源演示图像_被单击()
        控件_设置文本(运行状态, "资源演示图像 Click：GIF 路径和工具提示已生效")
        调试输出("资源演示图像 Click", 真)
    结束

    事件 _一次播放图像_播放完毕()
        控件_设置文本(播放状态, "已触发：一次播放完成（Finished / 播放完毕）")
        调试输出("一次播放图像 Finished", 真)
    结束

    事件 _事件演示图像_被单击()
        控件_设置文本(事件状态, "Click：事件演示图像被单击")
        调试输出("事件演示图像 Click", 真)
    结束

    事件 _事件演示图像_鼠标按下()
        控件_设置文本(事件状态, "MouseDown：鼠标按下")
        调试输出("事件演示图像 MouseDown", 真)
    结束

    事件 _事件演示图像_鼠标移入()
        控件_设置文本(事件状态, "MouseEnter：鼠标移入")
    结束

    事件 _事件演示图像_鼠标移出()
        控件_设置文本(事件状态, "MouseLeave：鼠标移出")
    结束

    事件 _隐藏事件图像按钮_被单击()
        控件_设置可见(事件演示图像, 假)
        控件_设置文本(事件状态, "已隐藏事件演示图像（控件_设置可见）")
    结束

    事件 _显示事件图像按钮_被单击()
        控件_设置可见(事件演示图像, 真)
        控件_设置文本(事件状态, "已显示事件演示图像（控件_设置可见）")
    结束

    事件 _禁用事件图像按钮_被单击()
        控件_设置启用(事件演示图像, 假)
        控件_设置文本(事件状态, "已禁用事件演示图像（控件_设置启用）")
    结束

    事件 _启用事件图像按钮_被单击()
        控件_设置启用(事件演示图像, 真)
        控件_设置文本(事件状态, "已启用事件演示图像（控件_设置启用）")
    结束
结束类
