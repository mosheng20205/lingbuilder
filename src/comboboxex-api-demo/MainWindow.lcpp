包 Win32增强组合框ComboBoxEx全接口示例
使用 Win32窗口基础模块
使用 Win32高级控件模块

类 MainWindow : 窗口
    事件 _MainWindow_创建完毕()
        控件_设置文本("操作结果", "已加载增强组合框完整接口实验室，请从选项卡逐项操作。")
        控件_设置文本("事件日志", "等待增强组合框的选择项被改变事件。")
        调试输出("增强组合框 ComboBoxEx 演示项目已启动")
    结束

    事件 _接口_读取当前文本_被单击()
        调试输出("控件_取文本 返回值：", 控件_取文本("查询目标组合框"))
        控件_设置文本("操作结果", "已执行：控件_取文本(查询目标组合框)，返回值见输出面板。")
    结束

    事件 _接口_设置当前文本_被单击()
        调试输出("控件_设置文本 返回值：", 控件_设置文本("查询目标组合框", "由控件_设置文本写入"))
        控件_设置文本("操作结果", "已执行：控件_设置文本(查询目标组合框, 由控件_设置文本写入)。")
    结束

    事件 _接口_读取选中索引_被单击()
        调试输出("控件_取选择项 返回值：", 控件_取选择项("查询目标组合框"))
        控件_设置文本("操作结果", "已执行：控件_取选择项(查询目标组合框)，返回值见输出面板。")
    结束

    事件 _接口_设置选中索引_被单击()
        调试输出("控件_设置选择项 返回值：", 控件_设置选择项("查询目标组合框", 2))
        控件_设置文本("操作结果", "已执行：控件_设置选择项(查询目标组合框, 2)。")
    结束

    事件 _接口_添加项目_被单击()
        调试输出("控件_添加项目 返回值：", 控件_添加项目("动态项目组合框", "运行时追加项目"))
        控件_设置文本("操作结果", "已执行：控件_添加项目(动态项目组合框, 运行时追加项目)。")
    结束

    事件 _接口_再次添加项目_被单击()
        调试输出("控件_添加项目 返回值：", 控件_添加项目("动态项目组合框", "第二个运行时项目"))
        控件_设置文本("操作结果", "已执行第二次控件_添加项目，返回值见输出面板。")
    结束

    事件 _接口_清空项目_被单击()
        调试输出("控件_清空项目 返回值：", 控件_清空项目("动态项目组合框"))
        控件_设置文本("操作结果", "已执行：控件_清空项目(动态项目组合框)。")
    结束

    事件 _接口_禁用组合框_被单击()
        调试输出("控件_设置启用 返回值：", 控件_设置启用("状态组合框", 假))
        控件_设置文本("操作结果", "已执行：控件_设置启用(状态组合框, 假)。")
    结束

    事件 _接口_启用组合框_被单击()
        调试输出("控件_设置启用 返回值：", 控件_设置启用("状态组合框", 真))
        控件_设置文本("操作结果", "已执行：控件_设置启用(状态组合框, 真)。")
    结束

    事件 _接口_隐藏组合框_被单击()
        调试输出("控件_设置可见 返回值：", 控件_设置可见("状态组合框", 假))
        控件_设置文本("操作结果", "已执行：控件_设置可见(状态组合框, 假)。")
    结束

    事件 _接口_显示组合框_被单击()
        调试输出("控件_设置可见 返回值：", 控件_设置可见("状态组合框", 真))
        控件_设置文本("操作结果", "已执行：控件_设置可见(状态组合框, 真)。")
    结束

    事件 _接口_调整位置大小_被单击()
        调试输出("控件_设置位置大小 返回值：", 控件_设置位置大小("状态组合框", 250, 150, 300, 46))
        控件_设置文本("操作结果", "已执行：控件_设置位置大小(状态组合框, 250, 150, 300, 46)。")
    结束

    事件 _接口_恢复位置大小_被单击()
        调试输出("控件_设置位置大小 返回值：", 控件_设置位置大小("状态组合框", 80, 200, 280, 40))
        控件_设置文本("操作结果", "已恢复状态组合框的位置和大小。")
    结束

    事件 _事件演示组合框_选择项被改变()
        控件_设置文本("事件日志", "增强组合框选择项被改变：索引=" ＋ 到文本(控件_取选择项("事件演示组合框")) ＋ "，文本=" ＋ 控件_取文本("事件演示组合框"))
        调试输出("增强组合框 SelectionChanged：", 控件_取文本("事件演示组合框"))
    结束
结束类
