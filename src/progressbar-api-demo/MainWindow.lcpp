包 进度条ProgressBar完整接口示例
使用 new_emoji 原生界面库

类 MainWindow : 公开 窗体
    构造()
    结束

    事件 _MainWindow_创建完毕()
        调试输出("ProgressBar 30 个接口演示已启动")
        控件_设置文本(状态标签, "状态：请选择一个选项卡中的接口组。")
    结束

    事件 _接口01_进度与状态_被点击()
        @ const LB_NE_ElementRef* progress = LB_NE_FindElement(L"演示进度条");
        @ if (!progress) return;
        @ int id = progress->id;
        @ EU_SetProgressPercentage(g_newEmojiWindow, id, 35);
        @ int postedPercentage = EU_PostSetProgressPercentage(g_newEmojiWindow, id, 72);
        @ int percentage = EU_GetProgressPercentage(g_newEmojiWindow, id);
        @ EU_SetProgressStatus(g_newEmojiWindow, id, 1);
        @ int postedStatus = EU_PostSetProgressStatus(g_newEmojiWindow, id, 2);
        @ int status = EU_GetProgressStatus(g_newEmojiWindow, id);
        @ EU_SetProgressShowText(g_newEmojiWindow, id, 1);
        @ int postedShowText = EU_PostSetProgressShowText(g_newEmojiWindow, id, 0);
        调试输出("接口01：Percentage / Status / ShowText 的设置、异步设置、读取已调用")
        控件_设置文本(状态标签, "状态：进度与状态接口已执行；请查看调试输出中的读取值。")
    结束

    事件 _接口02_选项_被点击()
        @ const LB_NE_ElementRef* progress = LB_NE_FindElement(L"演示进度条");
        @ if (!progress) return;
        @ int id = progress->id;
        @ EU_SetProgressOptions(g_newEmojiWindow, id, 0, 12, 1);
        @ int posted = EU_PostSetProgressOptions(g_newEmojiWindow, id, 1, 16, 0);
        @ int progressType = 0;
        @ int strokeWidth = 0;
        @ int showText = 0;
        @ EU_GetProgressOptions(g_newEmojiWindow, id, &progressType, &strokeWidth, &showText);
        调试输出("接口02：ProgressOptions 设置、异步设置和读取已调用")
        控件_设置文本(状态标签, "状态：选项接口已执行。")
    结束

    事件 _接口03_格式_被点击()
        @ const LB_NE_ElementRef* progress = LB_NE_FindElement(L"演示进度条");
        @ if (!progress) return;
        @ int id = progress->id;
        @ EU_SetProgressFormatOptions(g_newEmojiWindow, id, 1, 1);
        @ int posted = EU_PostSetProgressFormatOptions(g_newEmojiWindow, id, 4, 1);
        @ int format = 0;
        @ int striped = 0;
        @ EU_GetProgressFormatOptions(g_newEmojiWindow, id, &format, &striped);
        调试输出("接口03：FormatOptions 设置、异步设置和读取已调用")
        控件_设置文本(状态标签, "状态：格式接口已执行，已切换为模板格式。")
    结束

    事件 _接口04_文字内显_被点击()
        @ const LB_NE_ElementRef* progress = LB_NE_FindElement(L"演示进度条");
        @ if (!progress) return;
        @ int id = progress->id;
        @ EU_SetProgressTextInside(g_newEmojiWindow, id, 1);
        @ int posted = EU_PostSetProgressTextInside(g_newEmojiWindow, id, 0);
        @ int inside = EU_GetProgressTextInside(g_newEmojiWindow, id);
        调试输出("接口04：TextInside 设置、异步设置和读取已调用")
        控件_设置文本(状态标签, "状态：文字内显接口已执行；请查看调试输出中的读取值。")
    结束

    事件 _接口05_颜色_被点击()
        @ const LB_NE_ElementRef* progress = LB_NE_FindElement(L"演示进度条");
        @ if (!progress) return;
        @ int id = progress->id;
        @ EU_SetProgressColors(g_newEmojiWindow, id, static_cast<Color>(0xFF67C23A), static_cast<Color>(0xFF334155), static_cast<Color>(0xFFF8FAFC));
        @ int posted = EU_PostSetProgressColors(g_newEmojiWindow, id, static_cast<Color>(0xFF409EFF), static_cast<Color>(0xFFE5E7EB), static_cast<Color>(0xFF303133));
        @ Color fill = static_cast<Color>(0);
        @ Color track = static_cast<Color>(0);
        @ Color text = static_cast<Color>(0);
        @ EU_GetProgressColors(g_newEmojiWindow, id, &fill, &track, &text);
        调试输出("接口05：Colors 设置、异步设置和读取已调用")
        控件_设置文本(状态标签, "状态：颜色接口已执行。")
    结束

    事件 _接口06_分段颜色_被点击()
        @ const LB_NE_ElementRef* progress = LB_NE_FindElement(L"演示进度条");
        @ if (!progress) return;
        @ int id = progress->id;
        @ const char* stops = "0xFFF56C6C\\t20|0xFFE6A23C\\t40|0xFF5CB87A\\t60|0xFF1989FA\\t80|0xFF6F7AD3\\t100";
        @ EU_SetProgressColorStops(g_newEmojiWindow, id, reinterpret_cast<const unsigned char*>(stops), static_cast<int>(sizeof("0xFFF56C6C\\t20|0xFFE6A23C\\t40|0xFF5CB87A\\t60|0xFF1989FA\\t80|0xFF6F7AD3\\t100") - 1));
        @ int posted = EU_PostSetProgressColorStops(g_newEmojiWindow, id, reinterpret_cast<const unsigned char*>(stops), static_cast<int>(sizeof("0xFFF56C6C\\t20|0xFFE6A23C\\t40|0xFF5CB87A\\t60|0xFF1989FA\\t80|0xFF6F7AD3\\t100") - 1));
        @ int count = EU_GetProgressColorStopCount(g_newEmojiWindow, id);
        @ Color firstColor = static_cast<Color>(0);
        @ int firstPercent = 0;
        @ EU_GetProgressColorStop(g_newEmojiWindow, id, 0, &firstColor, &firstPercent);
        调试输出("接口06：ColorStops 设置、异步设置、数量和首项读取已调用")
        控件_设置文本(状态标签, "状态：分段颜色接口已执行；请查看调试输出中的分段数量。")
    结束

    事件 _接口07_完成与模板_被点击()
        @ const LB_NE_ElementRef* progress = LB_NE_FindElement(L"演示进度条");
        @ if (!progress) return;
        @ int id = progress->id;
        @ const char* completeText = "全部完成";
        @ const char* templateText = "状态：{status} · 进度：{percent}";
        @ EU_SetProgressCompleteText(g_newEmojiWindow, id, reinterpret_cast<const unsigned char*>(completeText), static_cast<int>(sizeof("全部完成") - 1));
        @ int postedComplete = EU_PostSetProgressCompleteText(g_newEmojiWindow, id, reinterpret_cast<const unsigned char*>(completeText), static_cast<int>(sizeof("全部完成") - 1));
        @ EU_SetProgressTextTemplate(g_newEmojiWindow, id, reinterpret_cast<const unsigned char*>(templateText), static_cast<int>(sizeof("状态：{status} · 进度：{percent}") - 1));
        @ int postedTemplate = EU_PostSetProgressTextTemplate(g_newEmojiWindow, id, reinterpret_cast<const unsigned char*>(templateText), static_cast<int>(sizeof("状态：{status} · 进度：{percent}") - 1));
        @ unsigned char completeBuffer[256] = {};
        @ unsigned char templateBuffer[256] = {};
        @ int completeSize = EU_GetProgressCompleteText(g_newEmojiWindow, id, completeBuffer, static_cast<int>(sizeof(completeBuffer)));
        @ int templateSize = EU_GetProgressTextTemplate(g_newEmojiWindow, id, templateBuffer, static_cast<int>(sizeof(templateBuffer)));
        调试输出("接口07：CompleteText / TextTemplate 设置、异步设置和读取已调用")
        控件_设置文本(状态标签, "状态：完成文本与模板接口已执行。")
    结束

    事件 _接口08_全部回归_被点击()
        调试输出("接口08：请依次点击四个选项卡中的接口按钮，完成全部 30 个接口回归。")
        控件_设置文本(状态标签, "状态：已开始全部 30 个 ProgressBar 接口回归，请依次查看前三个选项卡。")
    结束

    事件 _接口09_恢复默认_被点击()
        @ const LB_NE_ElementRef* progress = LB_NE_FindElement(L"演示进度条");
        @ if (!progress) return;
        @ int id = progress->id;
        @ EU_SetProgressPercentage(g_newEmojiWindow, id, 60);
        @ EU_SetProgressStatus(g_newEmojiWindow, id, 0);
        @ EU_SetProgressOptions(g_newEmojiWindow, id, 0, 8, 1);
        @ EU_SetProgressFormatOptions(g_newEmojiWindow, id, 0, 0);
        @ EU_SetProgressTextInside(g_newEmojiWindow, id, 0);
        @ EU_SetProgressColors(g_newEmojiWindow, id, static_cast<Color>(0xFF409EFF), static_cast<Color>(0xFFE5E7EB), static_cast<Color>(0xFF303133));
        @ EU_SetProgressColorStops(g_newEmojiWindow, id, reinterpret_cast<const unsigned char*>(""), 0);
        @ EU_SetProgressCompleteText(g_newEmojiWindow, id, reinterpret_cast<const unsigned char*>("满"), static_cast<int>(sizeof("满") - 1));
        @ EU_SetProgressTextTemplate(g_newEmojiWindow, id, reinterpret_cast<const unsigned char*>("{value}%"), static_cast<int>(sizeof("{value}%") - 1));
        调试输出("接口09：已恢复设计器默认状态")
        控件_设置文本(状态标签, "状态：已恢复默认值。")
    结束

    事件 _演示进度条_鼠标进入()
        调试输出("ProgressBar MouseEnter")
    结束

    事件 _演示进度条_鼠标离开()
        调试输出("ProgressBar MouseLeave")
    结束

    事件 _演示进度条_鼠标按下()
        调试输出("ProgressBar MouseDown")
    结束

    事件 _演示进度条_鼠标抬起()
        调试输出("ProgressBar MouseUp")
    结束

    事件 _演示进度条_鼠标双击()
        调试输出("ProgressBar MouseDoubleClick")
    结束

    事件 _演示进度条_鼠标移动()
        调试输出("ProgressBar MouseMove")
    结束

    事件 _演示进度条_鼠标滚轮()
        调试输出("ProgressBar MouseWheel")
    结束

    事件 _演示进度条_获得焦点()
        调试输出("ProgressBar GotFocus")
    结束

    事件 _演示进度条_失去焦点()
        调试输出("ProgressBar LostFocus")
    结束
结束类
