包 控制台程序

类 程序
公开
  整数型 启动()
    // ============================================================
    // APP 自动化样板：打开 App → 感知（识图找目标）→ 决策 → 注入点击 → 日志。
    // 以「京东签到」为第一个示例任务：launchApp 拉起京东 → 在帧里找「签到」按钮 → 点击 → 识别「已签到」收尾。
    // 感知层当前用 识图_模板匹配（对固定 UI 有效）；装好 lingbuilder.ocr 后把 找模板并点击
    // 换成「OCR 找文字坐标」即可适配动态运营页（代码里已标注替换点）。
    //
    // 使用前置（一次性）：
    //   ① 手机装 LingBuilder 投屏伴侣 1.2.0+，插 USB 后授予配件权限（勾选「一律允许」）
    //   ② 伴生 App 授予「显示在其他应用上层」权限（launchApp 需要，主界面会引导）
    //   ③ 电脑侧配件接口装好 WinUSB 驱动（AOA_安装驱动 可引导）——数据通道需要它
    //   ④ 事先从手机截屏裁出「签到」按钮与「已签到」两张小模板图，放到下方配置的路径
    // ============================================================

    // ===== ① 任务配置（OCR 版：目标用文字描述，不再需要裁模板图）=====
    局部 文本型 目标包名 = "com.android.settings"
    局部 文本型 目标按钮文字 = "蓝牙"
    局部 文本型 完成标志文字 = "设备名称"
    局部 文本型 帧路径 = "C:\LingBuilder剧本\最新帧.jpg"
    局部 整数型 识图容差 = 24

    // ===== ② 连接手机 =====
    调试输出("OCR：" + OCR_取版本())
    调试输出("微信组件：" + OCR_取微信状态())
    调试输出(AOA_取设备列表())
    局部 AOA设备 设备 = AOA_打开设备("PQY0221113016888")
    如果 (设备 = 0)
      调试输出("打开手机失败：" + AOA_取错误())
      返回 (1)
    如果结束
    局部 长整数型 通道 = AOA_打开数据通道(设备, 1000)
    如果 (通道 = 0)
      调试输出("打开数据通道失败：" + AOA_取错误())
      AOA_关闭设备(设备)
      返回 (1)
    如果结束

    // 心跳对端检测：发 ping 等 pong（证明手机侧投屏伴侣在运行）
    如果 (手机任务.发指令(通道, "{\"cmd\":\"ping\"}", 2000) = 假)
      调试输出("手机侧对端未就绪：" + 最近指令回执)
      AOA_关闭数据通道(通道)
      AOA_关闭设备(设备)
      返回 (1)
    如果结束
    调试输出("数据通道就绪")

    // ===== ③ 任务链：亮屏 → 回桌面 → 打开京东 =====
    手机任务.发指令(通道, "{\"cmd\":\"wakeScreen\"}", 1500)
    延时(800)
    手机任务.发指令(通道, "{\"cmd\":\"goHome\"}", 1500)
    延时(800)
    局部 逻辑型 拉起成功 = 手机任务.发指令(通道, "{\"cmd\":\"launchApp\",\"package\":\"" + 目标包名 + "\"}", 2000)
    如果 (拉起成功)
      调试输出("已拉起目标应用，等待冷启动……")
      延时(8000)
    否则
      调试输出("拉起失败：" + 最近指令回执)
    如果结束

    // ===== ④ 感知-决策-执行循环（帧宽/帧高 为项目全局变量，由 手机任务库.收一帧 按心跳自动更新）=====
    局部 逻辑型 有帧 = 假
    局部 逻辑型 完成 = 假
    局部 逻辑型 已点按钮 = 假
    局部 整数型 轮次 = 0
    计次循环首 (40, 轮次)
      如果 (完成)
        跳出循环
      如果结束
      有帧 = 手机任务.收一帧(通道, 帧路径, 1500)
      如果 (有帧 = 假)
        调试输出("第 " + 到文本(轮次) + " 轮：未收到视频帧（对端无推流？）")
        延时(500)
      否则
        // 收尾判定：OCR 找「已签到」文字
        如果 (手机任务.OCR包含文字(帧路径, 完成标志文字))
          完成 = 真
          调试输出("第 " + 到文本(轮次) + " 轮：OCR 识别到「" + 完成标志文字 + "」，任务结束")
          跳出循环
        如果结束
        // OCR 找「签到」按钮文字并点击中心
        已点按钮 = 手机任务.OCR找文字并点击(设备, 帧路径, 目标按钮文字)
        如果 (已点按钮)
          调试输出("第 " + 到文本(轮次) + " 轮：OCR 命中「" + 目标按钮文字 + "」并已点击")
          延时(3000)
        否则
          调试输出("第 " + 到文本(轮次) + " 轮：OCR 未命中（" + 最近指令回执 + "）")
          延时(700)
        如果结束
      如果结束
    计次循环尾 ()
    如果 (完成 = 假)
      调试输出("轮次用尽仍未识别到完成标记（检查模板图/容差，或改用 OCR）")
    如果结束

    // ===== ⑤ 收尾 =====
    AOA_关闭数据通道(通道)
    AOA_关闭设备(设备)
    调试输出("样板任务结束，数据线重插可恢复手机普通 USB 模式")
    返回 (0)
  结束
结束类
