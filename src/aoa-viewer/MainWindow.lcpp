类 MainWindow

    事件 _MainWindow_创建完毕()
        窗口dpi = 显示器_系统DPI()
        如果 (窗口dpi < 96)
          窗口dpi = 96
        如果结束
        手机连接1 = WS_创建连接()
        WS_设置资源限制(手机连接1, 5000, 5000, 32, 32)
        WS_绑定消息处理器(手机连接1, &收到消息1)
        WS_绑定已断开处理器(手机连接1, &连接断开1)
        WS_绑定错误处理器(手机连接1, &连接出错1)
        手机连接2 = WS_创建连接()
        WS_设置资源限制(手机连接2, 5000, 5000, 32, 32)
        WS_绑定消息处理器(手机连接2, &收到消息2)
        WS_绑定已断开处理器(手机连接2, &连接断开2)
        WS_绑定错误处理器(手机连接2, &连接出错2)
        手机连接3 = WS_创建连接()
        WS_设置资源限制(手机连接3, 5000, 5000, 32, 32)
        WS_绑定消息处理器(手机连接3, &收到消息3)
        WS_绑定已断开处理器(手机连接3, &连接断开3)
        WS_绑定错误处理器(手机连接3, &连接出错3)
        手机连接4 = WS_创建连接()
        WS_设置资源限制(手机连接4, 5000, 5000, 32, 32)
        WS_绑定消息处理器(手机连接4, &收到消息4)
        WS_绑定已断开处理器(手机连接4, &连接断开4)
        WS_绑定错误处理器(手机连接4, &连接出错4)
        控件_设置文本(状态栏, "多机就绪：点「N 接收」按槽位自动分配手机（USB 直传优先，Wi-Fi 降级兜底），点画面即真实点击")
        调试输出("AOA 多机投屏群控 v2 就绪（USB 数据通道 + WS 降级）")
        // MirrorDesk WebUI：本机 HTTP 帧服务（127.0.0.1:8900）+ EdgeView 页面导航
        WebUI模式 = 真
        // 页面直接走 file://（exe 同目录 mirrordesk.html）：帧图与页面同为本地文件，
        // 状态经 WebView2 消息桥推送。此前 http.server 方案里 WebView 轮询与
        // UI 线程动态/静态路由交互会在分配完成 ~16 秒后把界面拖死（静态路由也只能撑十几秒）。
        // 页面定位以 exe 目录为基（2026-10-22 实锤）：帧文件按 exe 目录落盘，而 CWD 随启动方
        // 变化（AI Bridge 拉起时 CWD≠bin），路径_转绝对路径 按 CWD 解析会把页面定位到源码根，
        // img 相对帧文件全部 broken（画面黑屏+闪烁复现的第三个根因）。缺失再回退源码根。
        页面绝对路径 = ""
        @ {
        @     wchar_t Exe缓冲[MAX_PATH] = {};
        @     GetModuleFileNameW(nullptr, Exe缓冲, MAX_PATH);
        @     std::wstring Exe路径 = Exe缓冲;
        @     size_t 斜杠位置 = Exe路径.find_last_of(L"\\/");
        @     std::wstring Exe目录 = (斜杠位置 == std::wstring::npos) ? std::wstring(L".") : Exe路径.substr(0, 斜杠位置);
        @     页面绝对路径 = Exe目录 + L"\\mirrordesk.html";
        @     帧基址 = Exe目录;
        @     std::replace(帧基址.begin(), 帧基址.end(), L'\\', L'/');
        @ }
        如果 (文件_是否存在(页面绝对路径) = 假)
          页面绝对路径 = "T:\\electron\\lingbuilder\\src\\aoa-viewer\\mirrordesk.html"
        如果结束
        // bin 会被每次构建清空，回退源码根是常态；帧图经 帧基址 绝对地址不受影响
        文件_追加文本("viewer.log", "页面 " + 页面绝对路径 + " |")
        调试输出("MirrorDesk 页面：" + 页面绝对路径)
        延迟调用(500, &打开网页)
        // 投屏自动发现：UDP 51750 信标监听（绑定失败只提示不阻断），泵 3 秒后常驻启动
        //（等 EdgeView 导航稳定，避免首拍状态推送/页面自照打在未加载的浏览器上）
        群控库.信标启动()
        延迟调用(3000, &泵启动)
    结束

    事件 泵启动()
        如果 (泵运行 = 假)
          泵运行 = 真
          延迟调用(15, &轮询泵)
        如果结束
    结束

    // ===== 槽 1 =====
    事件 _开始接收1_被单击()
        _开始接收1主体()
    结束

    空 _开始接收1主体()
        群控库.信标恢复()
        如果 (槽USB传输1)
          控件_设置文本(状态栏, "槽1 已在 USB 直传")
          返回()
        如果结束
        局部 文本型 序列号 = 控件_取文本(序列号输入)
        如果 (序列号 = "")
          序列号 = 群控库.取槽序列号(群控库.取已连槽数() + 1)
        如果结束
        如果 (通道1 = 0)
          // 序列号为空不再发起打开：多台在线时空串兜底在 libusb 层同步阻塞 30 秒+，
          // 会卡死整个 UI 线程（HTTP/页面全部超时的真凶）。双空配件机（鸿蒙配件会话）改用磁贴触控按钮单独兜底。
          如果 (序列号 <> "")
            调试输出("槽1接收：打开设备 [" + 序列号 + "]")
            已用序列号1 = 序列号
            已用序列号1 = 序列号
            文件_追加文本("viewer.log", "槽1 open [" + 序列号 + "]")
            设备1 = AOA_打开设备(序列号)
          否则
            调试输出("槽1接收：无可用设备，跳过打开")
          如果结束
          如果 (设备1 = 0)
              文件_追加文本("viewer.log", "槽1 openfail " + AOA_取错误())
            控件_设置文本(状态1, "槽1 打开设备失败：" + AOA_取错误())
            否则
              设备已开1 = 真
              通道1 = AOA_打开数据通道(设备1, 1500)
              调试输出("槽1 通道句柄=" + 到文本(通道1))
              文件_追加文本("viewer.log", "槽1 ch=" + 到文本(通道1) + " err=" + AOA_取错误() + " |")
              如果 (通道1 = 0)
                文件_追加文本("viewer.log", "槽1 chfail " + AOA_取错误())
                控件_设置文本(状态1, "槽1 USB 通道未开（" + AOA_取错误() + "），走 Wi-Fi")
              否则
                USB帧数1 = 0
                控件_设置文本(状态1, "槽1 USB 等帧中（通道已开）")
              如果结束
            如果结束
        如果结束
        如果 (通道1 > 0)
          如果 (泵运行 = 假)
            泵运行 = 真
            延迟调用(15, &轮询泵)
          如果结束
        如果结束
        // Wi-Fi 降级并行保底：USB 首帧到达时 存槽帧 会自动关掉这条 WS
        如果 (WS_是否已连接(手机连接1) = 假)
          局部 文本型 连接串 = 控件_取文本(连接串输入)
          如果 (WS_配置连接(手机连接1, 连接串))
            如果 (连接串 <> "")
              槽信标1 = 连接串
            如果结束
            如果 (WS_开始连接(手机连接1))
              如果 (通道1 = 0)
                控件_设置文本(状态1, "槽1 Wi-Fi 连接中……")
              如果结束
            否则
              如果 (通道1 = 0)
                控件_设置文本(状态1, "槽1 启动失败：" + WS_取连接错误(手机连接1))
              如果结束
            如果结束
          否则
            如果 (通道1 = 0)
              控件_设置文本(状态1, "槽1 连接串格式错误")
            如果结束
          如果结束
        如果结束
    结束

    事件 _连接设备1_被单击()
        _连接设备1主体()
    结束

    空 _连接设备1主体()
        如果 (设备已开1)
          控件_设置文本(状态栏, "槽1 触控已接通")
          返回()
        如果结束
        // 序列号优先级：本槽信标 sn（Wi-Fi 视频槽与 USB 触控槽自动对齐）> 输入框 > 列表序号
        局部 文本型 序列号 = 槽信标SN1
        局部 文本型 来源文本 = "信标sn"
        如果 (序列号 = "")
          序列号 = 群控库.按名找序列号(信标名1, 假)
          来源文本 = "信标名"
        如果结束
        如果 (序列号 = "")
          序列号 = 控件_取文本(序列号输入)
          来源文本 = "输入框"
        如果结束
        如果 (序列号 = "")
          序列号 = 群控库.取槽序列号(群控库.取已连槽数() + 1)
          来源文本 = "列表序号"
        如果结束
        如果 (序列号 = "")
          控件_设置文本(状态栏, "槽1 无可打开的 USB 设备（手机需插 USB 线）")
          返回()
        如果结束
        文件_追加文本("viewer.log", "槽1 触控 SN[" + 序列号 + "] 来源" + 来源文本 + " |")
        设备1 = AOA_打开设备(序列号)
        如果 (设备1 = 0)
          控件_设置文本(状态栏, "槽1 打开设备失败：" + AOA_取错误())
          返回()
        如果结束
        AOA_设置屏幕旋转(设备1, 当前旋转1)
        设备已开1 = 真
        如果 (通道1 > 0)
          AOA_数据通道发帧(通道1, 字节集_从文本("{\"cmd\":\"wakeScreen\"}"))
          AOA_数据通道发帧(通道1, 字节集_从文本("{\"cmd\":\"launchApp\",\"package\":\"com.android.settings\"}"))
        如果结束
        如果 (通道1 > 0)
          // USB 通道 2 直发唤醒指令：MIUI/鸿蒙熄屏会暂停 MediaProjection，先点亮再投
        如果结束
        控件_设置文本(状态栏, "槽1 触控已接通，点击画面即可操作")
    结束

    事件 收到消息1()
      // 只清本槽登记串的失败账：全局清零会被其他槽的正常流量打断退避（MI8/Mi10 同场实证）
      如果 (槽信标1 = 信标失败串)
        信标失败次数 = 0
      如果结束
      如果 (WS_取当前消息类型() = "文本")
        局部 文本型 环境 = WS_取当前文本()
        // screenInfo/screenChanged（v1.4.0 坐标回映射）由坐标映射库认领刷新缓存，其余按 env 心跳解析
        如果 (坐标映射.屏幕_处理消息(1, 环境) = 假)
          当前旋转1 = JSON_取整数(环境, "rotation", 0)
          局部 整数型 新帧宽1 = JSON_取整数(环境, "width", 0)
          局部 整数型 新帧高1 = JSON_取整数(环境, "height", 0)
          如果 (新帧宽1 > 0)
            帧宽1 = 新帧宽1
            需重排1 = 真
          如果结束
          如果 (新帧高1 > 0)
            帧高1 = 新帧高1
            需重排1 = 真
          如果结束
          延迟调用(1, &刷新槽1)
        如果结束
      否则
        局部 字节集 帧数据 = WS_取当前二进制()
        如果 (字节集_长度(帧数据) > 1024)
          如果 (用甲帧1)
            群控库.写帧文件("aoa_s1_1.jpg", 帧数据)
            用甲帧1 = 假
          否则
            群控库.写帧文件("aoa_s1_0.jpg", 帧数据)
            用甲帧1 = 真
          如果结束
          有新帧1 = 真
          延迟调用(1, &刷新槽1)
        如果结束
      如果结束
    结束

    事件 连接断开1()
        延迟调用(1, &断开提示1)
    结束

    事件 断开提示1()
        如果 (槽USB传输1)
          控件_设置文本(状态1, "槽1 Wi-Fi 降级通道已停（USB 直传中）")
        否则
          信标失败串 = 槽信标1
          信标失败次数 = 信标失败次数 + 1
          信标失败时刻 = 0
          @ 信标失败时刻 = (long long)GetTickCount64();
          槽信标1 = ""
          文件_追加文本("viewer.log", "槽1 WS断开记退避 次数" + 到文本(信标失败次数) + " @" + 到文本(信标失败时刻) + " |")
          控件_设置文本(状态1, "槽1 推流已断开（设备信标存活会自动重连）")
        如果结束
    结束

    事件 连接出错1()
        出错文本1 = WS_取当前错误()
        延迟调用(1, &错误提示1)
    结束

    事件 错误提示1()
        如果 (通道1 > 0)
          控件_设置文本(状态1, "槽1 USB 等帧中（Wi-Fi 断开不影响），点状态栏拉通知栏")
        否则
          信标失败串 = 槽信标1
          信标失败次数 = 信标失败次数 + 1
          信标失败时刻 = 0
          @ 信标失败时刻 = (long long)GetTickCount64();
          槽信标1 = ""
          文件_追加文本("viewer.log", "槽1 WS错误记退避 次数" + 到文本(信标失败次数) + " @" + 到文本(信标失败时刻) + " 错误:" + 出错文本1 + " |")
          控件_设置文本(状态1, "槽1 连接错误：" + 出错文本1)
        如果结束
    结束

    事件 _画面1_被单击()
        如果 (群控库.吞槽点击(1))
            返回()
        如果结束
        群控库.处理槽点击(1)
    结束

    // 拖动手势三段（2026-10-21）：按下=手指按下，移动=距离节流后手指移动，抬起=手指抬起；
    // 手势期间的 Click 由 吞槽点击 拦截，短按（按下即抬起）就是一次真实 tap。
    事件 _画面1_鼠标按下()
        群控库.手势按下鼠标(1)
    结束

    事件 _画面1_鼠标移动()
        群控库.手势移动鼠标(1)
    结束

    事件 _画面1_鼠标抬起()
        群控库.手势抬起(1)
    结束

    事件 刷新槽1()
        如果 (需重排1)
          需重排1 = 假
          群控库.按帧重排槽画面(1)
        如果结束
        如果 (有新帧1)
          有新帧1 = 假
          如果 (WebUI模式 = 假)
            如果 (用甲帧1)
              控件_设置图片(画面1, "aoa_s1_0.jpg")
            否则
              控件_设置图片(画面1, "aoa_s1_1.jpg")
            如果结束
          如果结束
        如果结束
        如果 (槽USB传输1)
          控件_设置文本(状态1, "槽1 USB 直传 " + 到文本(USB帧数1) + " 帧 " + 到文本(帧宽1) + "×" + 到文本(帧高1))
        否则
          如果 (通道1 > 0)
            控件_设置文本(状态1, "槽1 USB 等帧中(通道" + 到文本(通道1) + ")，点状态栏可下拉通知栏")
          否则
            控件_设置文本(状态1, "槽1 Wi-Fi 推流 " + 到文本(帧宽1) + "×" + 到文本(帧高1) + " 旋转 " + 到文本(当前旋转1) + "°")
          如果结束
        如果结束
    结束

    // ===== 槽 2 =====
    事件 _开始接收2_被单击()
        _开始接收2主体()
    结束

    空 _开始接收2主体()
        群控库.信标恢复()
        如果 (槽USB传输2)
          控件_设置文本(状态栏, "槽2 已在 USB 直传")
          返回()
        如果结束
        局部 文本型 序列号 = 控件_取文本(序列号输入)
        如果 (序列号 = "")
          序列号 = 群控库.取槽序列号(群控库.取已连槽数() + 1)
        如果结束
        如果 (通道2 = 0)
          // 序列号为空不再发起打开：多台在线时空串兜底在 libusb 层同步阻塞 30 秒+，
          // 会卡死整个 UI 线程（HTTP/页面全部超时的真凶）。双空配件机（鸿蒙配件会话）改用磁贴触控按钮单独兜底。
          如果 (序列号 <> "")
            调试输出("槽2接收：打开设备 [" + 序列号 + "]")
            已用序列号2 = 序列号
            已用序列号2 = 序列号
            文件_追加文本("viewer.log", "槽2 open [" + 序列号 + "]")
            设备2 = AOA_打开设备(序列号)
          否则
            调试输出("槽2接收：无可用设备，跳过打开")
          如果结束
          如果 (设备2 = 0)
              文件_追加文本("viewer.log", "槽2 openfail " + AOA_取错误())
            控件_设置文本(状态2, "槽2 打开设备失败：" + AOA_取错误())
            否则
              设备已开2 = 真
              通道2 = AOA_打开数据通道(设备2, 1500)
              文件_追加文本("viewer.log", "槽2 ch=" + 到文本(通道2) + " err=" + AOA_取错误() + " |")
              如果 (通道2 = 0)
                文件_追加文本("viewer.log", "槽2 chfail " + AOA_取错误())
                控件_设置文本(状态2, "槽2 USB 通道未开（" + AOA_取错误() + "），走 Wi-Fi")
              否则
                USB帧数2 = 0
                控件_设置文本(状态2, "槽2 USB 通道已开，等手机帧……")
              如果结束
            如果结束
        如果结束
        如果 (通道2 > 0)
          如果 (泵运行 = 假)
            泵运行 = 真
            延迟调用(15, &轮询泵)
          如果结束
        如果结束
        // Wi-Fi 降级并行保底：USB 首帧到达时 存槽帧 会自动关掉这条 WS
        如果 (WS_是否已连接(手机连接2) = 假)
          局部 文本型 连接串 = 控件_取文本(连接串输入)
          如果 (WS_配置连接(手机连接2, 连接串))
            如果 (连接串 <> "")
              槽信标2 = 连接串
            如果结束
            如果 (WS_开始连接(手机连接2))
              如果 (通道2 = 0)
                控件_设置文本(状态2, "槽2 Wi-Fi 连接中……")
              如果结束
            否则
              如果 (通道2 = 0)
                控件_设置文本(状态2, "槽2 启动失败：" + WS_取连接错误(手机连接2))
              如果结束
            如果结束
          否则
            如果 (通道2 = 0)
              控件_设置文本(状态2, "槽2 连接串格式错误")
            如果结束
          如果结束
        如果结束
    结束

    事件 _连接设备2_被单击()
        _连接设备2主体()
    结束

    空 _连接设备2主体()
        如果 (设备已开2)
          控件_设置文本(状态栏, "槽2 触控已接通")
          返回()
        如果结束
        // 序列号优先级：本槽信标 sn（Wi-Fi 视频槽与 USB 触控槽自动对齐）> 输入框 > 列表序号
        局部 文本型 序列号 = 槽信标SN2
        局部 文本型 来源文本 = "信标sn"
        如果 (序列号 = "")
          序列号 = 群控库.按名找序列号(信标名2, 假)
          来源文本 = "信标名"
        如果结束
        如果 (序列号 = "")
          序列号 = 控件_取文本(序列号输入)
          来源文本 = "输入框"
        如果结束
        如果 (序列号 = "")
          序列号 = 群控库.取槽序列号(群控库.取已连槽数() + 1)
          来源文本 = "列表序号"
        如果结束
        如果 (序列号 = "")
