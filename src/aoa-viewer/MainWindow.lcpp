类 MainWindow

    事件 _MainWindow_创建完毕()
        窗口dpi = 显示器_系统DPI()
        如果 (窗口dpi < 96)
          窗口dpi = 96
        如果结束
        控件_设置文本(状态栏, "USB 直传版就绪：插上手机自动接入（免调试·免 Wi-Fi），画面可点可拖")
        调试输出("AOA 多机投屏群控 v3 就绪（USB 设备池版，无 Wi-Fi）")
        // MirrorDesk WebUI：页面走 file://（mirrordesk.html），状态经 WebView2 消息桥推送。
        // 此前 http.server 方案里 WebView 轮询与 UI 线程动态路由交互会把界面拖死，勿回头。
        // 页面解析全便携（2026-10-23 实锤：硬编码本机源码根绝对路径，分享包在别的机器
        // 上回退到不存在的 T:\ 路径 → ERR_FILE_NOT_FOUND 白屏）：① exe 同目录 ② CWD
        // ③ 从 exe 目录向上最多 6 级找 src\aoa-viewer\mirrordesk.html——标准构建布局
        // .lingbuilder-build\<项目>\x64\Debug\bin 上溯 4 级即工作区根，F5/导出/分享包全通用。
        // 帧基址固定 exe 目录（帧文件按它绝对落盘，页面从源码根回退加载也不受影响）。
        页面绝对路径 = ""
        @ {
        @     wchar_t Exe缓冲[MAX_PATH] = {};
        @     GetModuleFileNameW(nullptr, Exe缓冲, MAX_PATH);
        @     std::wstring Exe路径 = Exe缓冲;
        @     size_t 斜杠位置 = Exe路径.find_last_of(L"\\/");
        @     std::wstring Exe目录 = (斜杠位置 == std::wstring::npos) ? std::wstring(L".") : Exe路径.substr(0, 斜杠位置);
        @     帧基址 = Exe目录;
        @     std::replace(帧基址.begin(), 帧基址.end(), L'\\', L'/');
        @     页面绝对路径 = Exe目录 + L"\\mirrordesk.html";
        @     if (GetFileAttributesW(页面绝对路径.c_str()) == INVALID_FILE_ATTRIBUTES) {
        @         wchar_t Cwd缓冲[MAX_PATH] = {};
        @         if (GetCurrentDirectoryW(MAX_PATH, Cwd缓冲) > 0) {
        @             std::wstring Cwd页面 = std::wstring(Cwd缓冲) + L"\\mirrordesk.html";
        @             if (GetFileAttributesW(Cwd页面.c_str()) != INVALID_FILE_ATTRIBUTES) 页面绝对路径 = Cwd页面;
        @         }
        @     }
        @     if (GetFileAttributesW(页面绝对路径.c_str()) == INVALID_FILE_ATTRIBUTES) {
        @         std::wstring 目录 = Exe目录;
        @         for (int 上溯 = 0; 上溯 < 6; ++上溯) {
        @             std::wstring 候选 = 目录 + L"\\src\\aoa-viewer\\mirrordesk.html";
        @             if (GetFileAttributesW(候选.c_str()) != INVALID_FILE_ATTRIBUTES) { 页面绝对路径 = 候选; break; }
        @             size_t 末斜杠 = 目录.find_last_of(L"\\/");
        @             if (末斜杠 == std::wstring::npos || 末斜杠 == 0) break;
        @             目录 = 目录.substr(0, 末斜杠);
        @         }
        @     }
        @ }
        文件_追加文本("viewer.log", "页面 " + 页面绝对路径 + " |")
        调试输出("MirrorDesk 页面：" + 页面绝对路径)
        延迟调用(500, &打开网页)
        // 泵 3 秒后常驻启动：等 EdgeView 导航稳定，避免首拍状态推送打在未加载的浏览器上
        延迟调用(3000, &泵启动)
    结束

    事件 泵启动()
        如果 (泵运行 = 假)
          泵运行 = 真
          延迟调用(15, &轮询泵)
        如果结束
    结束

    // ===== 轮询泵（界面线程 15ms 一拍，常驻不停表）=====
    // 池工作（打开队列/设备巡检/轮询巡游/状态推送）在 群控库.泵一拍；
    // 这里保留两类窗口侧职责：EdgeView 页拍自愈 与 找图点击演示状态机。
    事件 轮询泵()
        群控库.泵一拍()
        当前毫秒 = 0
        @ 当前毫秒 = (long long)GetTickCount64();
        // 页拍自愈：截图回调丢失（EdgeView 未加载完就发起时发生）10 秒后复位重试
        如果 (页拍进行 且 当前毫秒 - 页拍发起时刻 > 10000)
          页拍进行 = 假
        如果结束
        页拍节流 = 页拍节流 + 1
        如果 (页拍节流 >= 256 且 页拍进行 = 假)
          页拍节流 = 0
          页拍发起时刻 = 当前毫秒
          页拍进行 = 真
          EdgeView媒体_截图异步(浏览器, "page.jpg", 1, &页面拍完成)
        如果结束
        // 找图点击演示状态机：queryScreen 应答到达且已校准即执行；
        // 2 秒仍未校准（手机端 <v1.4.0 不回 screenInfo）自动取消
        如果 (演示槽 > 0)
          如果 (坐标映射.屏幕_是否已校准())
            局部 整数型 演示目标槽 = 0
            演示目标槽 = 演示槽
            演示槽 = 0
            执行找图点击(演示目标槽)
          否则
            如果 (当前毫秒 - 演示发起时刻 > 2000)
              局部 整数型 超时槽 = 0
              超时槽 = 演示槽
              演示槽 = 0
              控件_设置文本(状态栏, "找图演示取消：手机端未回屏幕信息（需投屏伴侣 v1.4.0+）")
              文件_追加文本("viewer.log", "找图演示 槽" + 到文本(超时槽) + " 超时取消 |")
            如果结束
          如果结束
        如果结束
        // 回放进度轮询（约 1 秒一次）：有回放任务时把进度快照推给页面横幅
        回放轮询节流 = 回放轮询节流 + 1
        如果 (回放轮询节流 >= 64)
          回放轮询节流 = 0
          局部 文本型 回放状态 = ""
          如果 (群控库.回放进行中(回放状态))
            EdgeView脚本_发送JSON消息(浏览器, "{\"event\":\"replayStatus\",\"status\":\"" + 回放状态 + "\"}")
          如果结束
        如果结束
        延迟调用(15, &轮询泵)
    结束

    // WebView2 控件异步初始化：导航失败延迟重试（上限 10 次），成功即停。
    // 不带任何自启参数：USB 设备由插线巡检自动入池接入，页面按钮只做批量补接。
    事件 打开网页()
        如果 (EdgeView_导航控件(浏览器, "file:///" + 页面绝对路径) = 0)
          导航重试 = 导航重试 + 1
          如果 (导航重试 < 10)
            延迟调用(600, &打开网页)
          如果结束
        否则
          导航重试 = 0
          EdgeView脚本_发送JSON消息(浏览器, "{\"event\":\"frameBase\",\"base\":\"" + 帧基址 + "\"}")
        如果结束
    结束

    事件 页面拍完成()
        页拍进行 = 假
    结束

    // HTML 端 chrome.webview.postMessage 的统一入口（信封两层解析：消息体在 message 字段）。
    事件 _浏览器_网页消息()
        局部 文本型 消息 = EdgeView_取事件数据控件(浏览器)
        // 事件数据是信封：{source,message,additionalObjectHandles}，消息体在 message 字段（转义 JSON 字符串）
        局部 文本型 内层 = JSON_取文本(消息, "message")
        局部 整数型 槽 = JSON_取整数(内层, "slot", 0)
        局部 文本型 动作 = JSON_取文本(内层, "action")
        局部 整数型 横 = JSON_取整数(内层, "x", -1)
        局部 整数型 纵 = JSON_取整数(内层, "y", -1)
        文件_追加文本("viewer.log", "MSG " + 内层 + " |")
        如果 (动作 = "dragWindow")
          窗口_开始拖拽(窗口_取自身句柄())
        如果结束
        如果 (动作 = "getFrameBase")
          EdgeView脚本_发送JSON消息(浏览器, "{\"event\":\"frameBase\",\"base\":\"" + 帧基址 + "\"}")
        如果结束
        如果 (动作 = "setSerial")
          指定序列号 = JSON_取文本(内层, "serial")
          文件_追加文本("viewer.log", "指定序列号 [" + 指定序列号 + "] |")
        如果结束
        如果 (动作 = "syncMode")
          如果 (JSON_取整数(内层, "on", 0) = 1)
            同步操控开 = 真
          否则
            同步操控开 = 假
          如果结束
        如果结束
        如果 (动作 = "batchShot")
          局部 整数型 截槽 = 0
          计次循环首 (群控库.池数量(), 截槽)
            群控库.截取槽画面(截槽)
          计次循环尾 ()
        如果结束
        如果 (动作 = "batchWake")
          群控库.批量唤醒()
        如果结束
        如果 (动作 = "findClick")
          找图点击演示(槽)
        如果结束
        如果 (动作 = "down")
          如果 (同步操控开)
            群控库.广播按下(横, 纵)
          否则
            群控库.手势按下(槽, 横, 纵)
          如果结束
        如果结束
        如果 (动作 = "move")
          如果 (同步操控开)
            群控库.广播移动(横, 纵)
          否则
            群控库.手势移动(槽, 横, 纵)
          如果结束
        如果结束
        如果 (动作 = "up")
          如果 (同步操控开)
            群控库.广播抬起()
          否则
            群控库.手势抬起(槽)
          如果结束
        如果结束
        如果 (动作 = "home")
          群控库.发槽指令(槽, "{\"cmd\":\"goHome\"}")
        如果结束
        如果 (动作 = "wake")
          群控库.发槽指令(槽, "{\"cmd\":\"wakeScreen\"}")
        如果结束
        如果 (动作 = "back")
          // 1.4.4 起 APK 协议无 goBack：返回键改走 AOA 多媒体键（Consumer 0x224）
          如果 (群控库.返回键(槽) = 假)
            EdgeView脚本_发送JSON消息(浏览器, "{\"event\":\"notify\",\"text\":\"槽" + 到文本(槽) + " 返回键失败，见状态栏\",\"ok\":false}")
          如果结束
        如果结束
        // 文本输入：经 AOA 键盘注入打进当前聚焦输入框（ASCII；广播=真 时发全部已接通）
        如果 (动作 = "inputText")
          局部 文本型 输入内容 = JSON_取文本(内层, "text")
          局部 整数型 广播标志 = JSON_取整数(内层, "broadcast", 0)
          局部 整数型 成功台 = 0
          局部 逻辑型 广播全部 = 假
          如果 (广播标志 = 1)
            广播全部 = 真
          如果结束
          如果 (输入内容 <> "")
            成功台 = 群控库.输入文本到池(槽, 输入内容, 广播全部)
            控件_设置文本(状态栏, "已向 " + 到文本(成功台) + " 台输入文本（ASCII）")
            EdgeView脚本_发送JSON消息(浏览器, "{\"event\":\"notify\",\"text\":\"已向 " + 到文本(成功台) + " 台输入文本\",\"ok\":true}")
          如果结束
        如果结束
        // 中文粘贴路径（伴侣 1.4.5+）：写手机剪贴板 → AOA Ctrl+V 注入粘贴
        如果 (动作 = "pasteText" 或 动作 = "paste")
          局部 文本型 粘贴内容 = JSON_取文本(内层, "text")
          局部 整数型 粘广播 = JSON_取整数(内层, "broadcast", 0)
          局部 逻辑型 粘广播全部 = 假
          如果 (粘广播 = 1)
            粘广播全部 = 真
          如果结束
          如果 (动作 = "pasteText")
            // 第一步：文本写入目标手机系统剪贴板（控制通道指令）
            局部 整数型 贴序号 = 0
            计次循环首 (群控库.池数量(), 贴序号)
              如果 (数组_取成员(池已开, 贴序号 - 1))
                如果 (粘广播全部 或 贴序号 = 槽)
                  群控库.发槽指令(贴序号, "{\"cmd\":\"setClipboard\",\"text\":\"" + 文本_替换(粘贴内容, "\"", "'") + "\"}")
                如果结束
              如果结束
            计次循环尾 ()
            控件_设置文本(状态栏, "已写入手机剪贴板（" + 到文本(文本_取长度(粘贴内容)) + " 字）——点磁贴「粘贴」按钮完成粘贴")
          否则
            // 第二步：向目标注入 Ctrl+V（HID 组合键 修饰键1=Ctrl + 键码25=V）
            局部 整数型 贴序号2 = 0
            局部 AOA设备 贴目标
            局部 整数型 贴成功 = 0
            计次循环首 (群控库.池数量(), 贴序号2)
              如果 (数组_取成员(池已开, 贴序号2 - 1))
                如果 (粘广播全部 或 贴序号2 = 槽)
                  贴目标 = 数组_取成员(池设备, 贴序号2 - 1)
                  如果 (AOA_键盘组合(贴目标, 1, 25))
                    贴成功 = 贴成功 + 1
                  否则
                    文件_追加文本("viewer.log", "槽" + 到文本(贴序号2) + " Ctrl+V 失败 " + AOA_取错误() + " |")
                  如果结束
                如果结束
              如果结束
            计次循环尾 ()
            控件_设置文本(状态栏, "已向 " + 到文本(贴成功) + " 台发送粘贴（Ctrl+V）")
            EdgeView脚本_发送JSON消息(浏览器, "{\"event\":\"notify\",\"text\":\"已向 " + 到文本(贴成功) + " 台发送粘贴\",\"ok\":true}")
          如果结束
        如果结束
        如果 (动作 = "notif")
          群控库.下拉通知栏(槽)
        如果结束
        如果 (动作 = "shot")
          群控库.截取槽画面(槽)
        如果结束
        // 接收/触控合一：附着 = 打开会话 + 打开数据通道（幂等，走打开队列串行）
        如果 (动作 = "receive" 或 动作 = "touch")
          群控库.附着槽位(槽)
        如果结束
        如果 (动作 = "attachAll")
          群控库.接收全部()
        如果结束
        如果 (动作 = "autoAttach")
          如果 (JSON_取整数(内层, "on", 0) = 1)
            自动接入开 = 真
          否则
            自动接入开 = 假
          如果结束
          文件_追加文本("viewer.log", "自动接入 " + 群控库.逻辑文本(自动接入开) + " |")
        如果结束
        // 同步操控广播勾选集合：空名单=回到「广播全部已接通」；非空=只广播勾选槽位
        如果 (动作 = "syncSet")
          局部 文本型 勾选文本 = JSON_取文本(内层, "list")
          局部 文本型 勾数组[]
          局部 整数型 勾数 = 0
          局部 整数型 勾序 = 0
          局部 整数型 勾槽 = 0
          计次循环首 (群控库.池数量(), 勾槽)
            数组_置成员(池勾选, 勾槽 - 1, 假)
          计次循环尾 ()
          勾数 = 文本_分割(勾选文本, ",", 勾数组, 真)
          计次循环首 (勾数, 勾序)
            勾槽 = 到整数(数组_取成员(勾数组, 勾序 - 1))
            如果 (勾槽 >= 1 且 勾槽 <= 群控库.池数量())
              数组_置成员(池勾选, 勾槽 - 1, 真)
            如果结束
          计次循环尾 ()
          如果 (勾数 > 0)
            勾选已设置 = 真
          否则
            勾选已设置 = 假
          如果结束
          文件_追加文本("viewer.log", "syncSet [" + 勾选文本 + "] |")
        如果结束
        // 批量启动 App：控制通道 launchApp 广播到全部已接通槽位
        如果 (动作 = "batchLaunch")
          局部 文本型 启动包名 = JSON_取文本(内层, "package")
          局部 整数型 启序号 = 0
          如果 (启动包名 <> "")
            计次循环首 (群控库.池数量(), 启序号)
              群控库.发槽指令(启序号, "{\"cmd\":\"launchApp\",\"package\":\"" + 启动包名 + "\"}")
            计次循环尾 ()
            控件_设置文本(状态栏, "已广播启动 App：" + 启动包名)
            文件_追加文本("viewer.log", "batchLaunch [" + 启动包名 + "] |")
          如果结束
        如果结束
        // 录制回放（路线图 #5）：录制进程级单例；回放对全部已接通槽位异步执行
        如果 (动作 = "recStart")
          如果 (群控库.录制开始() = 假)
            EdgeView脚本_发送JSON消息(浏览器, "{\"event\":\"notify\",\"text\":\"录制启动失败，见状态栏\",\"ok\":false}")
          如果结束
        如果结束
        如果 (动作 = "recStop")
          群控库.录制停止()
        如果结束
        如果 (动作 = "replayStart")
          局部 整数型 回放倍速 = JSON_取整数(内层, "speed", 1)
          局部 整数型 回放循环 = JSON_取整数(内层, "loops", 1)
          如果 (回放倍速 < 1)
            回放倍速 = 1
          如果结束
          如果 (回放循环 < 1)
            回放循环 = 1
          如果结束
          局部 整数型 已启动 = 0
          已启动 = 群控库.回放到池("群控剧本.csv", 回放倍速, 回放循环)
          如果 (已启动 = 0)
            EdgeView脚本_发送JSON消息(浏览器, "{\"event\":\"notify\",\"text\":\"回放启动失败：无已接通设备或剧本不存在\",\"ok\":false}")
          否则
            EdgeView脚本_发送JSON消息(浏览器, "{\"event\":\"notify\",\"text\":\"回放已启动 " + 到文本(已启动) + " 台（倍速 " + 到文本(回放倍速) + "× 循环 " + 到文本(回放循环) + "）\",\"ok\":true}")
          如果结束
        如果结束
        如果 (动作 = "replayStop")
          局部 整数型 停序号 = 0
          局部 AOA设备 停目标
          计次循环首 (群控库.池数量(), 停序号)
            如果 (数组_取成员(池已开, 停序号 - 1))
              停目标 = 数组_取成员(池设备, 停序号 - 1)
              AOA_停止回放(停目标)
            如果结束
          计次循环尾 ()
          控件_设置文本(状态栏, "已请求停止全部回放（协作式：当前步执行完退出）")
        如果结束
        // 页面可视区名单（逗号分隔槽号）：可视槽全帧率落盘，不可视槽 2 秒一帧节流
        如果 (动作 = "visible")
          局部 文本型 列表文本 = JSON_取文本(内层, "list")
          局部 文本型 槽数组[]
          局部 整数型 槽数 = 0
          局部 整数型 序号 = 0
          局部 整数型 槽号 = 0
          计次循环首 (群控库.池数量(), 槽号)
            数组_置成员(池可见, 槽号 - 1, 假)
          计次循环尾 ()
          槽数 = 文本_分割(列表文本, ",", 槽数组, 真)
          计次循环首 (槽数, 序号)
            槽号 = 到整数(数组_取成员(槽数组, 序号 - 1))
            如果 (槽号 >= 1 且 槽号 <= 群控库.池数量())
              数组_置成员(池可见, 槽号 - 1, 真)
            如果结束
          计次循环尾 ()
        如果结束
        如果 (动作 = "disconnectAll")
          群控库.断开全部()
        如果结束
    结束

    // ===== 找图点击演示：识图 → 坐标映射 → AOA HID 点击 最小闭环 =====
    // 流程：发 queryScreen → 泵等 screenInfo 校准（2 秒超时取消）→ 从最新帧裁一块小模板
    // → 识图_模板匹配字节集 命中帧坐标 → 坐标映射 换算手机真实坐标 → 换算 0~32767 逻辑坐标
    // → 群控库.注入槽点击 真实点击。实战把裁模板这一步换成事先截好的目标小图字节集即可复用全链。

    事件 _找图点击_被单击()
        找图点击演示(1)
    结束

    空 找图点击演示(整数型 槽)
        演示槽 = 槽
        @ 演示发起时刻 = (long long)GetTickCount64();
        坐标映射.屏幕_请求信息(槽)
        控件_设置文本(状态栏, "槽" + 到文本(槽) + " 找图演示：已请求屏幕信息，等校准…")
    结束

    空 执行找图点击(整数型 槽)
        局部 文本型 帧文件 = ""
        局部 整数型 帧图宽 = 0
        局部 整数型 帧图高 = 0
        局部 整数型 模板宽 = 0
        局部 整数型 模板高 = 0
        局部 整数型 模板横 = 0
        局部 整数型 模板纵 = 0
        局部 字节集 帧数据 = 字节集_从文本("")
        局部 字节集 模板数据 = 字节集_从文本("")
        局部 整数型 命中横 = 0
        局部 整数型 命中纵 = 0
        局部 整数型 中心帧横 = 0
        局部 整数型 中心帧纵 = 0
        局部 整数型 手机横 = 0
        局部 整数型 手机纵 = 0
        局部 整数型 触点横局部 = 0
        局部 整数型 触点纵局部 = 0
        如果 (坐标映射.屏幕_是否已校准() = 假)
          控件_设置文本(状态栏, "找图演示取消：屏幕信息未校准")
          返回()
        如果结束
        帧文件 = 群控库.取槽帧文件(槽)
        如果 (帧文件 = "" 或 文件_是否存在(帧文件) = 假)
          控件_设置文本(状态栏, "槽" + 到文本(槽) + " 找图演示：还没有画面帧，先接通投屏")
          返回()
        如果结束
        帧图宽 = 图像_取宽度(帧文件)
        帧图高 = 图像_取高度(帧文件)
        如果 (帧图宽 < 64 或 帧图高 < 64)
          控件_设置文本(状态栏, "找图演示：帧图读取失败 " + 图像_取错误())
          返回()
        如果结束
        // 演示模板 = 帧中上部裁小块（宽 1/16、高 1/32，靠近顶部让朴素匹配少扫几行）
        模板宽 = 帧图宽 / 16
        模板高 = 帧图高 / 32
        模板横 = (帧图宽 - 模板宽) / 2
        模板纵 = 帧图高 / 8
        如果 (图像_裁剪(帧文件, "演示模板.png", 模板横, 模板纵, 模板宽, 模板高) = 假)
          控件_设置文本(状态栏, "找图演示：模板裁剪失败 " + 图像_取错误())
          返回()
        如果结束
        帧数据 = 群控库.读文件字节集(帧文件)
        模板数据 = 群控库.读文件字节集("演示模板.png")
        如果 (字节集_长度(帧数据) < 1 或 字节集_长度(模板数据) < 1)
          控件_设置文本(状态栏, "找图演示：帧/模板字节集读取失败")
          返回()
        如果结束
        如果 (识图_模板匹配字节集(帧数据, 模板数据, 12) = 假)
          控件_设置文本(状态栏, "槽" + 到文本(槽) + " 找图演示：未命中模板（容差 12）")
          返回()
        如果结束
        命中横 = 识图_取结果横坐标()
        命中纵 = 识图_取结果纵坐标()
        // 命中点是模板左上角，点击取模板中心
        中心帧横 = 命中横 + 模板宽 / 2
        中心帧纵 = 命中纵 + 模板高 / 2
        手机横 = 坐标映射.屏幕_帧坐标到手机横坐标(中心帧横)
        手机纵 = 坐标映射.屏幕_帧坐标到手机纵坐标(中心帧纵)
        触点横局部 = 坐标映射.屏幕_手机坐标到逻辑横坐标(手机横)
        触点纵局部 = 坐标映射.屏幕_手机坐标到逻辑纵坐标(手机纵)
        如果 (手机横 < 0 或 手机纵 < 0 或 触点横局部 < 0 或 触点纵局部 < 0)
          控件_设置文本(状态栏, "找图演示：坐标换算失败（屏幕信息未校准）")
          返回()
        如果结束
        触点横 = 触点横局部
        触点纵 = 触点纵局部
        文件_追加文本("viewer.log", "找图演示 槽" + 到文本(槽) + " 帧点(" + 到文本(中心帧横) + "," + 到文本(中心帧纵) + ") 手机点(" + 到文本(手机横) + "," + 到文本(手机纵) + ") 真实" + 到文本(坐标映射.屏幕_取真实宽()) + "x" + 到文本(坐标映射.屏幕_取真实高()) + " 帧面" + 到文本(坐标映射.屏幕_取帧宽()) + "x" + 到文本(坐标映射.屏幕_取帧高()) + " |")
        如果 (群控库.注入槽点击(槽))
          控件_设置文本(状态栏, "槽" + 到文本(槽) + " 找图演示：帧(" + 到文本(中心帧横) + "," + 到文本(中心帧纵) + ")→手机(" + 到文本(手机横) + "," + 到文本(手机纵) + ") 已点击")
        如果结束
    结束

    事件 _断开全部_被单击()
        群控库.断开全部()
    结束

    事件 _退出按钮_被单击()
        群控库.断开全部()
        结束()
    结束
结束类
