          返回()
        如果结束
        // 序列号优先级：本槽信标 sn（Wi-Fi 视频槽与 USB 触控槽自动对齐）> 输入框 > 列表序号
        局部 文本型 序列号 = 槽信标SN4
        局部 文本型 来源文本 = "信标sn"
        如果 (序列号 = "")
          序列号 = 群控库.按名找序列号(信标名4, 假)
          来源文本 = "信标名"
        如果结束
        如果 (序列号 = "")
          序列号 = 控件_取文本(序列号输入)
          来源文本 = "输入框"
        如果结束
        如果 (序列号 = "")
          序列号 = 群控库.取槽序列号(群控库.取已连槽数() + 1)
          来源文本 = "列表序号"
        如果结束
        如果 (序列号 = "")
          控件_设置文本(状态栏, "槽4 无可打开的 USB 设备（手机需插 USB 线）")
          返回()
        如果结束
        文件_追加文本("viewer.log", "槽4 触控 SN[" + 序列号 + "] 来源" + 来源文本 + " |")
        设备4 = AOA_打开设备(序列号)
        如果 (设备4 = 0)
          控件_设置文本(状态栏, "槽4 打开设备失败：" + AOA_取错误())
          返回()
        如果结束
        AOA_设置屏幕旋转(设备4, 当前旋转4)
        设备已开4 = 真
        如果 (通道4 > 0)
          AOA_数据通道发帧(通道4, 字节集_从文本("{\"cmd\":\"wakeScreen\"}"))
          AOA_数据通道发帧(通道4, 字节集_从文本("{\"cmd\":\"launchApp\",\"package\":\"com.android.settings\"}"))
        如果结束
        如果 (通道4 > 0)
          // USB 通道 2 直发唤醒指令：MIUI/鸿蒙熄屏会暂停 MediaProjection，先点亮再投
        如果结束
        控件_设置文本(状态栏, "槽4 触控已接通，点击画面即可操作")
    结束

    事件 收到消息4()
      // 只清本槽登记串的失败账：全局清零会被其他槽的正常流量打断退避（MI8/Mi10 同场实证）
      如果 (槽信标4 = 信标失败串)
        信标失败次数 = 0
      如果结束
      如果 (WS_取当前消息类型() = "文本")
        局部 文本型 环境 = WS_取当前文本()
        // screenInfo/screenChanged（v1.4.0 坐标回映射）由坐标映射库认领刷新缓存，其余按 env 心跳解析
        如果 (坐标映射.屏幕_处理消息(4, 环境) = 假)
          当前旋转4 = JSON_取整数(环境, "rotation", 0)
          局部 整数型 新帧宽4 = JSON_取整数(环境, "width", 0)
          局部 整数型 新帧高4 = JSON_取整数(环境, "height", 0)
          如果 (新帧宽4 > 0)
            帧宽4 = 新帧宽4
            需重排4 = 真
          如果结束
          如果 (新帧高4 > 0)
            帧高4 = 新帧高4
            需重排4 = 真
          如果结束
          延迟调用(1, &刷新槽4)
        如果结束
      否则
        局部 字节集 帧数据 = WS_取当前二进制()
        如果 (字节集_长度(帧数据) > 1024)
          如果 (用甲帧4)
            群控库.写帧文件("aoa_s4_1.jpg", 帧数据)
            用甲帧4 = 假
          否则
            群控库.写帧文件("aoa_s4_0.jpg", 帧数据)
            用甲帧4 = 真
          如果结束
          有新帧4 = 真
          延迟调用(1, &刷新槽4)
        如果结束
      如果结束
    结束

    事件 连接断开4()
        延迟调用(1, &断开提示4)
    结束

    事件 断开提示4()
        如果 (槽USB传输4)
          控件_设置文本(状态4, "槽4 Wi-Fi 降级通道已停（USB 直传中）")
        否则
          信标失败串 = 槽信标4
          信标失败次数 = 信标失败次数 + 1
          信标失败时刻 = 0
          @ 信标失败时刻 = (long long)GetTickCount64();
          槽信标4 = ""
          文件_追加文本("viewer.log", "槽4 WS断开记退避 次数" + 到文本(信标失败次数) + " @" + 到文本(信标失败时刻) + " |")
          控件_设置文本(状态4, "槽4 推流已断开（设备信标存活会自动重连）")
        如果结束
    结束

    事件 连接出错4()
        出错文本4 = WS_取当前错误()
        延迟调用(1, &错误提示4)
    结束

    事件 错误提示4()
        如果 (槽USB传输4)
          控件_设置文本(状态4, "槽4 USB 直传中（Wi-Fi 断开不影响）")
        否则
          信标失败串 = 槽信标4
          信标失败次数 = 信标失败次数 + 1
          信标失败时刻 = 0
          @ 信标失败时刻 = (long long)GetTickCount64();
          槽信标4 = ""
          文件_追加文本("viewer.log", "槽4 WS错误记退避 次数" + 到文本(信标失败次数) + " @" + 到文本(信标失败时刻) + " 错误:" + 出错文本4 + " |")
          控件_设置文本(状态4, "槽4 连接错误：" + 出错文本4)
        如果结束
    结束

    事件 _画面4_被单击()
        如果 (群控库.吞槽点击(4))
            返回()
        如果结束
        群控库.处理槽点击(4)
    结束

    事件 _画面4_鼠标按下()
        群控库.手势按下鼠标(4)
    结束

    事件 _画面4_鼠标移动()
        群控库.手势移动鼠标(4)
    结束

    事件 _画面4_鼠标抬起()
        群控库.手势抬起(4)
    结束

    事件 刷新槽4()
        如果 (需重排4)
          需重排4 = 假
          群控库.按帧重排槽画面(4)
        如果结束
        如果 (有新帧4)
          有新帧4 = 假
          如果 (WebUI模式 = 假)
            如果 (用甲帧4)
              控件_设置图片(画面4, "aoa_s4_0.jpg")
            否则
              控件_设置图片(画面4, "aoa_s4_1.jpg")
            如果结束
          如果结束
        如果结束
        如果 (槽USB传输4)
          控件_设置文本(状态4, "槽4 USB 直传 " + 到文本(USB帧数4) + " 帧 " + 到文本(帧宽4) + "×" + 到文本(帧高4))
        否则
          控件_设置文本(状态4, "槽4 推流 " + 到文本(帧宽4) + "×" + 到文本(帧高4) + " 旋转 " + 到文本(当前旋转4) + "°")
        如果结束
    结束

    事件 _状态1下拉_被单击()
        群控库.下拉通知栏(1)
    结束

    事件 _状态2下拉_被单击()
        群控库.下拉通知栏(2)
    结束

    事件 _状态3下拉_被单击()
        群控库.下拉通知栏(3)
    结束

    事件 _状态4下拉_被单击()
        群控库.下拉通知栏(4)
    结束

    // ===== USB 轮询泵（界面线程 15ms 一拍；空轮询 1ms 超时即返回）=====
    // 红线：AOA_数据通道收帧 超时不能传 0（libusb 0=永久等待）；手机侧发送端在 PC 停止收帧时会阻塞，
    // 因此只要有通道未关就必须持续轮询。
    // 2026-10-22 起泵常驻：槽位全空也不再停表——投屏自动发现的信标收包、心跳超时巡检与
    // 状态推送必须全程在跑，手机点「开始投屏」才能在 ≤5 秒内被自动接入。
    事件 轮询泵()
        局部 逻辑型 还有活 = 假
        局部 整数型 演示目标槽 = 0
        如果 (通道1 > 0)
          还有活 = 真
          群控库.轮询槽(1)
          如果 (有新帧1 或 需重排1)
            刷新槽1()
          如果结束
        如果结束
        如果 (通道2 > 0)
          还有活 = 真
          群控库.轮询槽(2)
          如果 (有新帧2 或 需重排2)
            刷新槽2()
          如果结束
        如果结束
        如果 (通道3 > 0)
          还有活 = 真
          群控库.轮询槽(3)
          如果 (有新帧3 或 需重排3)
            刷新槽3()
          如果结束
        如果结束
        如果 (通道4 > 0)
          还有活 = 真
          群控库.轮询槽(4)
          如果 (有新帧4 或 需重排4)
            刷新槽4()
          如果结束
        如果结束
        // 自动发现常驻段：每拍消化信标，每 32 拍巡检心跳超时并推一次页面状态
        群控库.信标轮询()
        状态节流 = 状态节流 + 1
        如果 (状态节流 >= 32)
          状态节流 = 0
          群控库.信标超时巡检()
          EdgeView脚本_发送JSON消息(浏览器, "{\"event\":\"status\",\"data\":" + 群控库.状态JSON() + "}")
        如果结束
        // 页拍自愈：截图回调丢失（EdgeView 未加载完就发起时发生）10 秒后复位重试
        当前毫秒 = 0
        @ 当前毫秒 = (long long)GetTickCount64();
        如果 (页拍进行 且 当前毫秒 - 页拍发起时刻 > 10000)
          页拍进行 = 假
        如果结束
        页拍节流 = 页拍节流 + 1
        // 自动接通触控：信标 SN 已知（配件模式回填）而触控未接通 → 打开对的那台（30 秒失败冷却）
        如果 (信标暂停 = 假)
          如果 (槽信标SN1 <> "" 或 信标名1 <> "")
            如果 (设备已开1 = 假)
              如果 (当前毫秒 > 自动接通冷却1)
                自动接通冷却1 = 当前毫秒 + 30000
                群控库.自动接通触控(1)
              如果结束
            如果结束
          如果结束
          如果 (槽信标SN2 <> "" 或 信标名2 <> "")
            如果 (设备已开2 = 假)
              如果 (当前毫秒 > 自动接通冷却2)
                自动接通冷却2 = 当前毫秒 + 30000
                群控库.自动接通触控(2)
              如果结束
            如果结束
          如果结束
          如果 (槽信标SN3 <> "" 或 信标名3 <> "")
            如果 (设备已开3 = 假)
              如果 (当前毫秒 > 自动接通冷却3)
                自动接通冷却3 = 当前毫秒 + 30000
                群控库.自动接通触控(3)
              如果结束
            如果结束
          如果结束
          如果 (槽信标SN4 <> "" 或 信标名4 <> "")
            如果 (设备已开4 = 假)
              如果 (当前毫秒 > 自动接通冷却4)
                自动接通冷却4 = 当前毫秒 + 30000
                群控库.自动接通触控(4)
              如果结束
            如果结束
          如果结束
        如果结束
        // 找图点击演示状态机（2026-10-22）：queryScreen 应答到达且已校准即执行；
        // 2 秒仍未校准（手机端 <v1.4.0 不回 screenInfo）自动取消。screenInfo 无论走
        // WS 文本还是 USB 控制通道都会刷新坐标映射缓存，这里只看 校准标志+超时。
        如果 (演示槽 > 0)
          如果 (坐标映射.屏幕_是否已校准())
            演示目标槽 = 演示槽
            演示槽 = 0
            执行找图点击(演示目标槽)
          否则
            如果 (当前毫秒 - 演示发起时刻 > 2000)
              演示目标槽 = 演示槽
              演示槽 = 0
              控件_设置文本(状态栏, "找图演示取消：手机端未回屏幕信息（需投屏伴侣 v1.4.0+）")
              文件_追加文本("viewer.log", "找图演示 槽" + 到文本(演示目标槽) + " 超时取消 |")
            如果结束
          如果结束
        如果结束
        如果 (页拍节流 >= 256 且 页拍进行 = 假)
          页拍节流 = 0
          页拍发起时刻 = 当前毫秒
          页拍进行 = 真
          EdgeView媒体_截图异步(浏览器, "page.jpg", 1, &页面拍完成)
        如果结束
        延迟调用(15, &轮询泵)
    结束

    事件 _断开全部_被单击()
        _断开全部主体()
    结束

    // ===== MirrorDesk WebUI（2026-10-21）：HTTP 帧服务处理器 + EdgeView 输入桥 =====







    // WebView2 控件异步初始化：导航失败延迟重试（上限 10 次），成功即停。
    // 2026-10-22 起不带任何 ?ws=/serial= 自启参数：Wi-Fi 设备由 UDP 51750 信标自动接入，
    // USB 设备仍由「自动分配接收」按钮按槽位分配；硬编码上一会话地址的老做法废弃。
    事件 打开网页()
        如果 (EdgeView_导航控件(浏览器, "file:///" + 页面绝对路径) = 0)
          导航重试 = 导航重试 + 1
          如果 (导航重试 < 10)
            延迟调用(600, &打开网页)
          如果结束
        否则
          导航重试 = 0
          EdgeView脚本_发送JSON消息(浏览器, "{\"event\":\"frameBase\",\"base\":\"" + 帧基址 + "\"}")
        如果结束
    结束

    事件 页面拍完成()
        页拍进行 = 假
    结束

    // HTML 端 chrome.webview.postMessage 的统一入口：手势三段/指令/接收触控/断开全部分发。
    事件 _浏览器_网页消息()
        局部 文本型 消息 = EdgeView_取事件数据控件(浏览器)
        文件_追加文本("viewer.log", "MSG " + 消息 + " |")
        // 事件数据是信封：{source,message,additionalObjectHandles}，消息体在 message 字段（转义 JSON 字符串）
        局部 文本型 内层 = JSON_取文本(消息, "message")
        局部 整数型 槽 = JSON_取整数(内层, "slot", 0)
        局部 文本型 动作 = JSON_取文本(内层, "action")
        局部 整数型 横 = JSON_取整数(内层, "x", -1)
        局部 整数型 纵 = JSON_取整数(内层, "y", -1)
        如果 (动作 = "dragWindow")
          窗口_开始拖拽(窗口_取自身句柄())
        如果结束
        如果 (动作 = "getFrameBase")
          EdgeView脚本_发送JSON消息(浏览器, "{\"event\":\"frameBase\",\"base\":\"" + 帧基址 + "\"}")
        如果结束
        如果 (动作 = "clearSerial")
          控件_设置文本(序列号输入, "")
        如果结束
        如果 (动作 = "setSerial")
          控件_设置文本(序列号输入, JSON_取文本(内层, "serial"))
        如果结束
        如果 (动作 = "syncMode")
          如果 (JSON_取整数(内层, "on", 0) = 1)
            同步操控开 = 真
          否则
            同步操控开 = 假
          如果结束
          如果 (同步操控开)
            文件_追加文本("viewer.log", "同步操控 开 |")
          如果结束
        如果结束
        如果 (动作 = "batchShot")
          群控库.截取槽画面(1)
          群控库.截取槽画面(2)
          群控库.截取槽画面(3)
          群控库.截取槽画面(4)
        如果结束
        如果 (动作 = "findClick")
          找图点击演示(槽)
        如果结束
        如果 (动作 = "down")
          如果 (同步操控开)
            群控库.广播按下(横, 纵)
          否则
            群控库.手势按下(槽, 横, 纵)
          如果结束
        如果结束
        如果 (动作 = "move")
          如果 (同步操控开)
            群控库.广播移动(横, 纵)
          否则
            群控库.手势移动(槽, 横, 纵)
          如果结束
        如果结束
        如果 (动作 = "up")
          如果 (同步操控开)
            群控库.广播抬起()
          否则
            群控库.手势抬起(槽)
          如果结束
        如果结束
        如果 (动作 = "home")
          群控库.发槽指令(槽, "{\"cmd\":\"goHome\"}")
        如果结束
        如果 (动作 = "wake")
          群控库.发槽指令(槽, "{\"cmd\":\"wakeScreen\"}")
        如果结束
        如果 (动作 = "back")
          群控库.发槽指令(槽, "{\"cmd\":\"goBack\"}")
        如果结束
        如果 (动作 = "notif")
          群控库.下拉通知栏(槽)
        如果结束
        如果 (动作 = "shot")
          群控库.截取槽画面(槽)
        如果结束
        如果 (动作 = "receive")
          如果 (槽 = 1)
            _开始接收1主体()
          如果结束
          如果 (槽 = 2)
            _开始接收2主体()
          如果结束
          如果 (槽 = 3)
            _开始接收3主体()
          如果结束
          如果 (槽 = 4)
            _开始接收4主体()
          如果结束
        如果结束
        如果 (动作 = "touch")
          如果 (槽 = 1)
            _连接设备1主体()
          如果结束
          如果 (槽 = 2)
            _连接设备2主体()
          如果结束
          如果 (槽 = 3)
            _连接设备3主体()
          如果结束
          如果 (槽 = 4)
            _连接设备4主体()
          如果结束
        如果结束
        如果 (动作 = "connectUrl")
          局部 文本型 连接串 = JSON_取文本(内层, "url")
          如果 (连接串 <> "")
            群控库.信标恢复()
            如果 (槽 = 1)
              如果 (WS_是否已连接(手机连接1) = 假)
                如果 (WS_配置连接(手机连接1, 连接串))
                  槽信标1 = 连接串
                  WS_开始连接(手机连接1)
                如果结束
              如果结束
            如果结束
            如果 (槽 = 2)
              如果 (WS_是否已连接(手机连接2) = 假)
                如果 (WS_配置连接(手机连接2, 连接串))
                  槽信标2 = 连接串
                  WS_开始连接(手机连接2)
                如果结束
              如果结束
            如果结束
            如果 (槽 = 3)
              如果 (WS_是否已连接(手机连接3) = 假)
                如果 (WS_配置连接(手机连接3, 连接串))
                  槽信标3 = 连接串
                  WS_开始连接(手机连接3)
                如果结束
              如果结束
            如果结束
            如果 (槽 = 4)
              如果 (WS_是否已连接(手机连接4) = 假)
                如果 (WS_配置连接(手机连接4, 连接串))
                  槽信标4 = 连接串
                  WS_开始连接(手机连接4)
                如果结束
              如果结束
            如果结束
          如果结束
        如果结束
        如果 (动作 = "disconnectAll")
          _断开全部主体()
        如果结束
    结束

    // ===== 找图点击演示（2026-10-22）：识图 → 坐标映射 → AOA HID 点击 最小闭环 =====
    // 触发：WebUI 磁贴工具条「找图」按钮（data-act=findClick，传槽号）或原生备用按钮 找图点击（槽1）。
    // 流程：发 queryScreen → 泵等 screenInfo 校准（2 秒超时取消）→ 从最新帧裁一块小模板
    // → 识图_模板匹配字节集 命中帧坐标 → 坐标映射 换算手机真实坐标 → 换算 0~32767 逻辑坐标
    // → 群控库.注入槽点击 真实点击。模板是演示自配（帧中上部裁块，自截自配必命中）；
    // 实战把裁模板这一步换成 事先截好的目标小图字节集 即可复用全链。

    事件 _找图点击_被单击()
        找图点击演示(1)
    结束

    空 找图点击演示(整数型 槽)
        演示槽 = 槽
        @ 演示发起时刻 = (long long)GetTickCount64();
        坐标映射.屏幕_请求信息(槽)
        控件_设置文本(状态栏, "槽" + 到文本(槽) + " 找图演示：已请求屏幕信息，等校准…")
    结束

    空 执行找图点击(整数型 槽)
        局部 文本型 帧文件 = ""
        局部 整数型 帧图宽 = 0
        局部 整数型 帧图高 = 0
        局部 整数型 模板宽 = 0
        局部 整数型 模板高 = 0
        局部 整数型 模板横 = 0
        局部 整数型 模板纵 = 0
        局部 字节集 帧数据 = 字节集_从文本("")
        局部 字节集 模板数据 = 字节集_从文本("")
        局部 整数型 命中横 = 0
        局部 整数型 命中纵 = 0
        局部 整数型 中心帧横 = 0
        局部 整数型 中心帧纵 = 0
        局部 整数型 手机横 = 0
        局部 整数型 手机纵 = 0
        如果 (坐标映射.屏幕_是否已校准() = 假)
          控件_设置文本(状态栏, "找图演示取消：屏幕信息未校准")
          返回()
        如果结束
        帧文件 = 群控库.取槽帧文件(槽)
        如果 (帧文件 = "" 或 文件_是否存在(帧文件) = 假)
          控件_设置文本(状态栏, "槽" + 到文本(槽) + " 找图演示：还没有画面帧，先接通投屏")
          返回()
        如果结束
        帧图宽 = 图像_取宽度(帧文件)
        帧图高 = 图像_取高度(帧文件)
        如果 (帧图宽 < 64 或 帧图高 < 64)
          控件_设置文本(状态栏, "找图演示：帧图读取失败 " + 图像_取错误())
          返回()
        如果结束
        // 演示模板 = 帧中上部裁小块（宽 1/16、高 1/32，靠近顶部让朴素匹配少扫几行）
        模板宽 = 帧图宽 / 16
        模板高 = 帧图高 / 32
        模板横 = (帧图宽 - 模板宽) / 2
        模板纵 = 帧图高 / 8
        如果 (图像_裁剪(帧文件, "演示模板.png", 模板横, 模板纵, 模板宽, 模板高) = 假)
          控件_设置文本(状态栏, "找图演示：模板裁剪失败 " + 图像_取错误())
          返回()
        如果结束
        帧数据 = 群控库.读文件字节集(帧文件)
        模板数据 = 群控库.读文件字节集("演示模板.png")
        如果 (字节集_长度(帧数据) < 1 或 字节集_长度(模板数据) < 1)
          控件_设置文本(状态栏, "找图演示：帧/模板字节集读取失败")
          返回()
        如果结束
        如果 (识图_模板匹配字节集(帧数据, 模板数据, 12) = 假)
          控件_设置文本(状态栏, "槽" + 到文本(槽) + " 找图演示：未命中模板（容差 12）")
          返回()
        如果结束
        命中横 = 识图_取结果横坐标()
        命中纵 = 识图_取结果纵坐标()
        // 命中点是模板左上角，点击取模板中心
        中心帧横 = 命中横 + 模板宽 / 2
        中心帧纵 = 命中纵 + 模板高 / 2
        手机横 = 坐标映射.屏幕_帧坐标到手机横坐标(中心帧横)
        手机纵 = 坐标映射.屏幕_帧坐标到手机纵坐标(中心帧纵)
        触点横 = 坐标映射.屏幕_手机坐标到逻辑横坐标(手机横)
        触点纵 = 坐标映射.屏幕_手机坐标到逻辑纵坐标(手机纵)
        如果 (手机横 < 0 或 手机纵 < 0 或 触点横 < 0 或 触点纵 < 0)
          控件_设置文本(状态栏, "找图演示：坐标换算失败（屏幕信息未校准）")
          返回()
        如果结束
        文件_追加文本("viewer.log", "找图演示 槽" + 到文本(槽) + " 帧点(" + 到文本(中心帧横) + "," + 到文本(中心帧纵) + ") 手机点(" + 到文本(手机横) + "," + 到文本(手机纵) + ") 真实" + 到文本(坐标映射.屏幕_取真实宽()) + "x" + 到文本(坐标映射.屏幕_取真实高()) + " 帧面" + 到文本(坐标映射.屏幕_取帧宽()) + "x" + 到文本(坐标映射.屏幕_取帧高()) + " |")
        如果 (群控库.注入槽点击(槽))
          控件_设置文本(状态栏, "槽" + 到文本(槽) + " 找图演示：帧(" + 到文本(中心帧横) + "," + 到文本(中心帧纵) + ")→手机(" + 到文本(手机横) + "," + 到文本(手机纵) + ") 已点击")
        如果结束
    结束

    空 _断开全部主体()
        如果 (通道1 > 0)
          通道1 = 0
        如果结束
        如果 (通道2 > 0)
          通道2 = 0
        如果结束
        如果 (通道3 > 0)
          通道3 = 0
        如果结束
        如果 (通道4 > 0)
          通道4 = 0
        如果结束
        槽USB传输1 = 假
        槽USB传输2 = 假
        槽USB传输3 = 假
        槽USB传输4 = 假
        // 全部断开同时挂起自动发现并清空信标登记：否则在投的手机 3 秒内会被信标自动接回，
        // 「断开」变成假动作；点任一「接收」/「触控」或发起连接即恢复自动接入。
        槽信标1 = ""
        槽信标2 = ""
        槽信标3 = ""
        槽信标4 = ""
        信标暂停 = 真
        如果 (设备已开1)
          AOA_关闭设备(设备1)
          设备已开1 = 假
        如果结束
        如果 (设备已开2)
          AOA_关闭设备(设备2)
          设备已开2 = 假
        如果结束
        如果 (设备已开3)
          AOA_关闭设备(设备3)
          设备已开3 = 假
        如果结束
        如果 (设备已开4)
          AOA_关闭设备(设备4)
          设备已开4 = 假
        如果结束
        WS_关闭连接(手机连接1, 1000, "")
        WS_关闭连接(手机连接2, 1000, "")
        WS_关闭连接(手机连接3, 1000, "")
        WS_关闭连接(手机连接4, 1000, "")
        控件_设置文本(状态栏, "已全部断开；自动发现已挂起，点「接收」恢复")
    结束

    事件 _退出按钮_被单击()
        如果 (通道1 > 0)
          通道1 = 0
        如果结束
        如果 (通道2 > 0)
          通道2 = 0
        如果结束
        如果 (通道3 > 0)
          通道3 = 0
        如果结束
        如果 (通道4 > 0)
          通道4 = 0
        如果结束
        槽USB传输1 = 假
        槽USB传输2 = 假
        槽USB传输3 = 假
        槽USB传输4 = 假
        如果 (设备已开1)
          AOA_关闭设备(设备1)
          设备已开1 = 假
        如果结束
        如果 (设备已开2)
          AOA_关闭设备(设备2)
          设备已开2 = 假
        如果结束
        如果 (设备已开3)
          AOA_关闭设备(设备3)
          设备已开3 = 假
        如果结束
        如果 (设备已开4)
          AOA_关闭设备(设备4)
          设备已开4 = 假
        如果结束
        WS_关闭连接(手机连接1, 1000, "")
        WS_关闭连接(手机连接2, 1000, "")
        WS_关闭连接(手机连接3, 1000, "")
        WS_关闭连接(手机连接4, 1000, "")
        结束()
    结束
结束类
