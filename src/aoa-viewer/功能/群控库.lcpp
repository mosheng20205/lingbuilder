// 群控库：多机投屏点击器的槽位几何、USB 数据通道轮询与点击注入。
// 红线（2026-10-20 实锤）：
//   ① 带参数方法必须放功能库——窗口类「事件」声明不支持参数，生成器会丢参数导致槽号恒 0（除零崩溃）。
//   ② 功能库内部互调必须带库名限定（群控库.xxx）。
//   ③ 函数签名必须单行（多行参数列表解析器会静默丢函数）。
//   ④ Image 控件（STATIC+SS_NOTIFY）运行时只派发 Click 事件，MouseDown 永不触发——画面点击一律绑 Click。
功能库 群控库

公开:

  // 产品名与信标设备名前缀匹配（忽略大小写）：列表产品名 "MI 8" ⊂ Build.MODEL "MI 8 UD"
  逻辑型 名字匹配(文本型 产品, 文本型 设备名)
    局部 逻辑型 匹配 = 假
    @ { 匹配 = (产品.size() > 0 && 设备名.size() >= 产品.size() && _wcsnicmp(产品.c_str(), 设备名.c_str(), 产品.size()) == 0); }
    返回(匹配)
  结束

  // 按信标设备名（Build.MODEL）在 USB 列表里找序列号。仅配件=真（自动路径红线）：
  // 只匹配「配件模式+可打开」——普通模式打开会触发切配件、最长阻塞 UI 线程 45 秒。
  // 仅配件=假（手动按钮）：普通模式也匹配——宁可尝试本机失败，也不许把别的手机错绑到该槽
  //（2026-10-22 实锤：输入框残留值优先级过高，槽1(MI8) 被错绑 Mi10 的 HID，滑动串机）。
  文本型 按名找序列号(文本型 设备名, 逻辑型 仅配件)
    局部 文本型 清单 = AOA_取设备列表()
    局部 文本型 行数组[]
    局部 文本型 字段[]
    局部 整数型 行数 = 文本_分割(清单, "\n", 行数组, 真)
    局部 整数型 行 = 0
    局部 整数型 字段数 = 0
    局部 文本型 行文本 = ""
    局部 文本型 序列号 = ""
    局部 文本型 产品 = ""
    计次循环首 (行数, 行)
      行文本 = 数组_取成员(行数组, 行 - 1)
      字段数 = 文本_分割(行文本, "|", 字段, 真)
      // 红线：只匹配「配件模式+可打开」——配件直开毫秒级；普通模式打开会触发切配件、
      // 最长阻塞 UI 线程 45 秒（MI8 调试关闭必失败），绝不能进自动路径，留给手动按钮。
      如果 (字段数 >= 4)
        序列号 = 数组_取成员(字段, 0)
        产品 = 数组_取成员(字段, 1)
        如果 (序列号 <> "")
          如果 (数组_取成员(字段, 2) = "配件模式")
            如果 (数组_取成员(字段, 3) = "可打开")
              如果 (群控库.名字匹配(产品, 设备名))
                返回(序列号)
              如果结束
            如果结束
          如果结束
        如果结束
      如果结束
    计次循环尾 ()
    返回("")
  结束


  // 已连接（USB 通道已开）的槽位数。自动分配时用它把「槽号」折算成「可用设备序号」：
  // 期望序号 = 槽号 - 已连槽数（错开串行分配下已连槽总排在前面，其目标设备已占用、
  // 在列表里显示「需驱动」被跳过，直接用槽号当序号会错位漏分后面的真机）。
  整数型 取已连槽数()
    局部 整数型 已连 = 0
    如果 (通道1 > 0)
      已连 = 已连 + 1
    如果结束
    如果 (通道2 > 0)
      已连 = 已连 + 1
    如果结束
    如果 (通道3 > 0)
      已连 = 已连 + 1
    如果结束
    如果 (通道4 > 0)
      已连 = 已连 + 1
    如果结束
    返回(已连)
  结束

  // 解析 AOA_取设备列表，返回第 槽 台「可用」手机的序列号。单遍统一分配：
  // 可用 = 配件模式+可打开，或 普通模式且序列号/产品名非双空（模块对 WinUSB 绑定的普通机执行
  // AOA_打开设备 会自动切配件并拉起伴侣——三台全在普通模式时的冷启动路径）。
  // 跳过两类行：①序列号+产品名双空（复合设备接口残影，如开着 USB 调试的小米 FF48 复合，
  // 不跳过会抢槽位序号）；②配件模式但「需驱动」（多为已被本程序占用的设备——libusb 打不开
  // 的误报文案，也可能是真缺驱动，两种都不该再分给别的槽）。
  // MIUI 配件描述符读不到序列号：返回产品名占位，模块侧走「唯一空序列号配件」兜底打开。
  // 找不到返回空文本（调用方走 Wi-Fi 降级）。
  文本型 取槽序列号(整数型 槽)
    局部 文本型 清单 = AOA_取设备列表()
    // 数组声明为文本型：数组命令对元素类型透明，取成员随声明类型解析
    局部 文本型 行数组[]
    局部 文本型 字段[]
    局部 整数型 行数 = 文本_分割(清单, "\n", 行数组, 真)
    局部 整数型 字段数 = 0
    局部 整数型 序号 = 0
    局部 整数型 行 = 0
    局部 文本型 行文本 = ""
    局部 文本型 命中 = ""
    计次循环首 (行数, 行)
      行文本 = 数组_取成员(行数组, 行 - 1)
      字段数 = 文本_分割(行文本, "|", 字段, 真)
      如果 (字段数 >= 4)
        如果 (数组_取成员(字段, 2) = "配件模式")
          如果 (数组_取成员(字段, 3) = "可打开")
            序号 = 序号 + 1
            如果 (序号 = 槽)
              命中 = 数组_取成员(字段, 0)
              如果 (命中 = "")
                命中 = 数组_取成员(字段, 1)
              如果结束
              // 已消耗排除:打开尝试即消耗,通道未开时 已连槽数 不涨,同一序号会重复命中同一台
              如果 (群控库.已消耗(命中))
                序号 = 序号 - 1
              否则
                返回(命中)
              如果结束
            如果结束
          如果结束
        如果结束
      如果结束
      如果 (字段数 >= 2)
        如果 (数组_取成员(字段, 2) = "普通模式")
          如果 (数组_取成员(字段, 0) <> "" 或 数组_取成员(字段, 1) <> "")
            序号 = 序号 + 1
            如果 (序号 = 槽)
              命中 = 数组_取成员(字段, 0)
              如果 (群控库.已消耗(命中))
                序号 = 序号 - 1
              否则
                返回(命中)
              如果结束
            如果结束
          如果结束
        如果结束
      如果结束
    计次循环尾 ()
    返回("")
  结束

  长整数型 取槽通道(整数型 槽)
    如果 (槽 = 1)
      返回(通道1)
    如果结束
    如果 (槽 = 2)
      返回(通道2)
    如果结束
    如果 (槽 = 3)
      返回(通道3)
    如果结束
    如果 (槽 = 4)
      返回(通道4)
    如果结束
    返回(0)
  结束

  // 槽位 USB 通道自愈：设备被拔掉/重新枚举后模块把会话判死，这里关掉通道与设备句柄、
  // 槽位退回「未连接」，避免对死句柄继续轮询（死句柄收帧立即返回，白占 UI 线程）。
  // 写法对齐 _断开全部主体：设备句柄不置 0（AOA设备 类型不接受整数赋值），只把 设备已开 落下。
  空 槽USB掉线(整数型 槽, 文本型 原因)
    局部 长整数型 通道 = 群控库.取槽通道(槽)
    如果 (通道 > 0)
      AOA_关闭数据通道(通道)
    如果结束
    如果 (槽 = 1)
      如果 (设备已开1)
        AOA_关闭设备(设备1)
        设备已开1 = 假
      如果结束
      通道1 = 0
      槽USB传输1 = 假
      控件_设置文本(状态1, "槽1 USB 已断开：" + 原因 + "（重插后可点「连接设备」重连）")
    否则如果 (槽 = 2)
      如果 (设备已开2)
        AOA_关闭设备(设备2)
        设备已开2 = 假
      如果结束
      通道2 = 0
      槽USB传输2 = 假
      控件_设置文本(状态2, "槽2 USB 已断开：" + 原因 + "（重插后可点「连接设备」重连）")
    否则如果 (槽 = 3)
      如果 (设备已开3)
        AOA_关闭设备(设备3)
        设备已开3 = 假
      如果结束
      通道3 = 0
      槽USB传输3 = 假
      控件_设置文本(状态3, "槽3 USB 已断开：" + 原因 + "（重插后可点「连接设备」重连）")
    否则如果 (槽 = 4)
      如果 (设备已开4)
        AOA_关闭设备(设备4)
        设备已开4 = 假
      如果结束
      通道4 = 0
      槽USB传输4 = 假
      控件_设置文本(状态4, "槽4 USB 已断开：" + 原因 + "（重插后可点「连接设备」重连）")
    如果结束
    文件_追加文本("viewer.log", "槽" + 到文本(槽) + " usbdown " + 原因 + " |")
  结束

  // 字节集 → 文本（UTF-8 解码，走缓冲区模块；控制 JSON 与回执都是 UTF-8）。
  文本型 字节集转文本(字节集 数据)
    局部 长整数型 缓冲 = 0
    局部 文本型 结果 = ""
    缓冲 = 缓冲区_创建(0)
    缓冲区_写字节集(缓冲, 数据)
    缓冲区_重置读取(缓冲)
    结果 = 缓冲区_读文本(缓冲, -1)
    缓冲区_销毁(缓冲)
    返回(结果)
  结束

  // 轮询泵的每槽一步：收一帧（1ms 超时，非阻塞），视频帧落盘置「有新帧」，
  // 控制 JSON（env 心跳/指令回执）解析出宽高旋转置「需重排」。返回 真=本拍有数据。
  // 红线：超时毫秒不能传 0（libusb 0=永久等待会卡死界面）；手机侧发送端阻塞要求必须持续轮询。
  逻辑型 轮询槽(整数型 槽)
    局部 长整数型 通道 = 群控库.取槽通道(槽)
    局部 字节集 帧 = AOA_数据通道收帧(通道, 1)
    局部 整数型 帧长 = 字节集_长度(帧)
    // 零初始化声明必须放在函数最前：带初始化的局部声明会被生成器整体提升到函数入口，
    // 若写成 局部 文本型 失败原因 = AOA_取错误() 就会在收帧之前先执行（拿到上一次的旧错误）。
    局部 文本型 失败原因 = ""
    如果 (帧长 < 1)
      // 2026-10-21：模块在设备拔出/重枚举后把会话判死，收帧返回空并留下中文原因
      //（成功与超时都会清空错误通道，所以非空＝这条通道真的坏了，不是「这拍没帧」）。
      失败原因 = AOA_取错误()
      如果 (失败原因 <> "")
        群控库.槽USB掉线(槽, 失败原因)
      如果结束
      返回(假)
    如果结束
    如果 (字节集_取字节(帧, 0) = 255)
      // JPEG 帧头 FF D8：视频帧；过小的载荷是协议残片，丢弃但算有活动
      如果 (帧长 > 1024)
        群控库.存槽帧(槽, 帧)
      如果结束
      返回(真)
    如果结束
    群控库.处理槽控制JSON(槽, 帧)
    返回(真)
  结束

  // USB 视频帧落盘（双缓冲交替）+ 首帧切 USB（关掉该槽 Wi-Fi 降级通道）。
  空 存槽帧(整数型 槽, 字节集 帧数据)
    如果 (槽 = 1)
      如果 (槽USB传输1 = 假)
        槽USB传输1 = 真
        WS_关闭连接(手机连接1, 1000, "")
        控件_设置文本(状态栏, "槽1 已切 USB 直传")
      如果结束
      USB帧数1 = USB帧数1 + 1
      如果 (用甲帧1)
        群控库.写帧文件("aoa_s1_1.jpg", 帧数据)
        用甲帧1 = 假
      否则
        群控库.写帧文件("aoa_s1_0.jpg", 帧数据)
        用甲帧1 = 真
      如果结束
      有新帧1 = 真
    如果结束
    如果 (槽 = 2)
      如果 (槽USB传输2 = 假)
        槽USB传输2 = 真
        WS_关闭连接(手机连接2, 1000, "")
        控件_设置文本(状态栏, "槽2 已切 USB 直传")
      如果结束
      USB帧数2 = USB帧数2 + 1
      如果 (用甲帧2)
        群控库.写帧文件("aoa_s2_1.jpg", 帧数据)
        用甲帧2 = 假
      否则
        群控库.写帧文件("aoa_s2_0.jpg", 帧数据)
        用甲帧2 = 真
      如果结束
      有新帧2 = 真
    如果结束
    如果 (槽 = 3)
      如果 (槽USB传输3 = 假)
        槽USB传输3 = 真
        WS_关闭连接(手机连接3, 1000, "")
        控件_设置文本(状态栏, "槽3 已切 USB 直传")
      如果结束
      USB帧数3 = USB帧数3 + 1
      如果 (用甲帧3)
        群控库.写帧文件("aoa_s3_1.jpg", 帧数据)
        用甲帧3 = 假
      否则
        群控库.写帧文件("aoa_s3_0.jpg", 帧数据)
        用甲帧3 = 真
      如果结束
      有新帧3 = 真
    如果结束
    如果 (槽 = 4)
      如果 (槽USB传输4 = 假)
        槽USB传输4 = 真
        WS_关闭连接(手机连接4, 1000, "")
        控件_设置文本(状态栏, "槽4 已切 USB 直传")
      如果结束
      USB帧数4 = USB帧数4 + 1
      如果 (用甲帧4)
        群控库.写帧文件("aoa_s4_1.jpg", 帧数据)
        用甲帧4 = 假
      否则
        群控库.写帧文件("aoa_s4_0.jpg", 帧数据)
        用甲帧4 = 真
      如果结束
      有新帧4 = 真
    如果结束
  结束

  空 写帧文件(文本型 路径, 字节集 帧数据)
    局部 文件号 号
    号 = 文件_打开(路径, 4, 1)
    如果 (号 > 0)
      文件_写出字节集(号, 帧数据)
      文件_关闭(号)
    如果结束
  结束

  // 数据通道上的控制 JSON：env 心跳（width/height/rotation）与指令回执。
  空 处理槽控制JSON(整数型 槽, 字节集 帧)
    局部 文本型 文本 = 群控库.字节集转文本(帧)
    // screenInfo/screenChanged（v1.4.0 坐标回映射协议）也可能从 USB 控制通道回来：
    // 手机端 replyControl 双路回执（USB 在回 USB、WS 同时广播），交给坐标映射库认领。
    坐标映射.屏幕_处理消息(槽, 文本)
    局部 整数型 新宽 = JSON_取整数(文本, "width", 0)
    局部 整数型 新高 = JSON_取整数(文本, "height", 0)
    局部 整数型 新旋转 = JSON_取整数(文本, "rotation", -1)
    如果 (新宽 > 0)
      如果 (槽 = 1)
        帧宽1 = 新宽
        需重排1 = 真
      如果结束
      如果 (槽 = 2)
        帧宽2 = 新宽
        需重排2 = 真
      如果结束
      如果 (槽 = 3)
        帧宽3 = 新宽
        需重排3 = 真
      如果结束
      如果 (槽 = 4)
        帧宽4 = 新宽
        需重排4 = 真
      如果结束
    如果结束
    如果 (新高 > 0)
      如果 (槽 = 1)
        帧高1 = 新高
        需重排1 = 真
      如果结束
      如果 (槽 = 2)
        帧高2 = 新高
        需重排2 = 真
      如果结束
      如果 (槽 = 3)
        帧高3 = 新高
        需重排3 = 真
      如果结束
      如果 (槽 = 4)
        帧高4 = 新高
        需重排4 = 真
      如果结束
    如果结束
    如果 (新旋转 >= 0)
      如果 (槽 = 1)
        当前旋转1 = 新旋转
      如果结束
      如果 (槽 = 2)
        当前旋转2 = 新旋转
      如果结束
      如果 (槽 = 3)
        当前旋转3 = 新旋转
      如果结束
      如果 (槽 = 4)
        当前旋转4 = 新旋转
      如果结束
    如果结束
  结束

  // 按帧宽高等比缩放槽画面控件并回写全局矩形（点击换算的唯一矩形来源）。
  // 红线：带初始化的局部变量声明会被生成器整体提升到函数最前——初始化式依赖后续 if 链赋值的变量，
  // 一律「声明=字面量初值、赋值按执行序」，否则恒除零（2026-10-20 cdb 实锤 +0x9092f）。
  空 按帧重排槽画面(整数型 槽)
    局部 整数型 格宽 = 246
    局部 整数型 格高 = 460
    局部 整数型 格横 = 10
    局部 整数型 格纵 = 80
    局部 整数型 槽帧宽 = 0
    局部 整数型 槽帧高 = 0
    局部 整数型 新高 = 0
    局部 整数型 新宽 = 0
    局部 整数型 新横 = 0
    局部 整数型 新纵 = 0
    如果 (槽 = 1)
      槽帧宽 = 帧宽1
      槽帧高 = 帧高1
    如果结束
    如果 (槽 = 2)
      槽帧宽 = 帧宽2
      槽帧高 = 帧高2
      格横 = 262
    如果结束
    如果 (槽 = 3)
      槽帧宽 = 帧宽3
      槽帧高 = 帧高3
      格横 = 514
    如果结束
    如果 (槽 = 4)
      槽帧宽 = 帧宽4
      槽帧高 = 帧高4
      格横 = 766
    如果结束
    如果 (槽帧宽 < 1 或 槽帧高 < 1)
      返回()
    如果结束
    新高 = 格高
    新宽 = 格高 * 槽帧宽 / 槽帧高
    如果 (新宽 > 格宽)
      新宽 = 格宽
      新高 = 格宽 * 槽帧高 / 槽帧宽
    如果结束
    新横 = 格横 + (格宽 - 新宽) / 2
    新纵 = 格纵 + (格高 - 新高) / 2
    如果 (槽 = 1)
      画面横1 = 新横
      画面纵1 = 新纵
      画面宽1 = 新宽
      画面高1 = 新高
      控件_设置位置大小(画面1, 新横, 新纵, 新宽, 新高)
    如果结束
    如果 (槽 = 2)
      画面横2 = 新横
      画面纵2 = 新纵
      画面宽2 = 新宽
      画面高2 = 新高
      控件_设置位置大小(画面2, 新横, 新纵, 新宽, 新高)
    如果结束
    如果 (槽 = 3)
      画面横3 = 新横
      画面纵3 = 新纵
      画面宽3 = 新宽
      画面高3 = 新高
      控件_设置位置大小(画面3, 新横, 新纵, 新宽, 新高)
    如果结束
    如果 (槽 = 4)
      画面横4 = 新横
      画面纵4 = 新纵
      画面宽4 = 新宽
      画面高4 = 新高
      控件_设置位置大小(画面4, 新横, 新纵, 新宽, 新高)
    如果结束
  结束

  // 画面点击 → 逻辑坐标 → AOA HID 真实点击。窗口事件绑定（Click）薄壳转调到这里；
  // 2026-10-21 起换算与旋转同步抽成 换算槽触点/同步槽旋转（与拖动手势共用），手势期间的
  // Click 由 吞槽点击 在窗口事件里先行拦截。
  逻辑型 处理槽点击(整数型 槽)
    局部 逻辑型 已开 = 假
    如果 (槽 = 1)
      已开 = 设备已开1
    如果结束
    如果 (槽 = 2)
      已开 = 设备已开2
    如果结束
    如果 (槽 = 3)
      已开 = 设备已开3
    如果结束
    如果 (槽 = 4)
      已开 = 设备已开4
    如果结束
    如果 (已开 = 假)
      控件_设置文本(状态栏, "槽 " + 到文本(槽) + "：该槽尚未接通手机（点「N 接收」或「N 触控」）")
      返回(假)
    如果结束
    群控库.换算槽触点(槽, 假)
    如果 (触点横 < 0)
      控件_设置文本(状态栏, "槽 " + 到文本(槽) + "：画面尺寸未知或点击在画面外，等首帧后再点")
      返回(假)
    如果结束
    群控库.同步槽旋转(槽)
    如果 (槽 = 1)
      如果 (AOA_单击(设备1, 触点横, 触点纵))
        控件_设置文本(状态栏, "槽1 已点击 (" + 到文本(触点横) + ", " + 到文本(触点纵) + ")")
        返回(真)
      否则
        控件_设置文本(状态栏, "槽1 点击失败：" + AOA_取错误())
        返回(假)
      如果结束
    如果结束
    如果 (槽 = 2)
      如果 (AOA_单击(设备2, 触点横, 触点纵))
        控件_设置文本(状态栏, "槽2 已点击 (" + 到文本(触点横) + ", " + 到文本(触点纵) + ")")
        返回(真)
      否则
        控件_设置文本(状态栏, "槽2 点击失败：" + AOA_取错误())
        返回(假)
      如果结束
    如果结束
    如果 (槽 = 3)
      如果 (AOA_单击(设备3, 触点横, 触点纵))
        控件_设置文本(状态栏, "槽3 已点击 (" + 到文本(触点横) + ", " + 到文本(触点纵) + ")")
        返回(真)
      否则
        控件_设置文本(状态栏, "槽3 点击失败：" + AOA_取错误())
        返回(假)
      如果结束
    如果结束
    如果 (槽 = 4)
      如果 (AOA_单击(设备4, 触点横, 触点纵))
        控件_设置文本(状态栏, "槽4 已点击 (" + 到文本(触点横) + ", " + 到文本(触点纵) + ")")
        返回(真)
      否则
        控件_设置文本(状态栏, "槽4 点击失败：" + AOA_取错误())
        返回(假)
      如果结束
    如果结束
    返回(假)
  结束

  // ===== 拖动手势（2026-10-21）：MouseDown→手指按下、MouseMove(距离节流)→手指移动、MouseUp→手指抬起 =====
  // 坐标一律 0~32767 逻辑坐标；手势期间收到的 Click（STN_CLICKED 在 MouseUp 派发前到达）一律吞掉，
  // 避免按下+抬起构成的完整触摸之外再补一发 AOA_单击 形成双击。

  // 取鼠标物理位置 → 槽画面矩形（DPI 换算）→ 0~32767 逻辑坐标，写入全局 触点横/触点纵。
  // 出界：钳制出界=真 时夹到 0~32767（拖动场景）；否则 触点横=-1 表示出界（点击场景）。
  空 换算槽触点(整数型 槽, 逻辑型 钳制出界)
    局部 整数型 槽横 = 0
    局部 整数型 槽纵 = 0
    局部 整数型 槽宽 = 0
    局部 整数型 槽高 = 0
    局部 整数型 鼠标x = 0
    局部 整数型 鼠标y = 0
    局部 文本型 边界 = ""
    局部 整数型 窗口x = 0
    局部 整数型 窗口y = 0
    局部 整数型 画面物理x = 0
    局部 整数型 画面物理y = 0
    局部 整数型 画面物理宽 = 0
    局部 整数型 画面物理高 = 0
    局部 整数型 相对x = 0
    局部 整数型 相对y = 0
    触点横 = -1
    触点纵 = -1
    如果 (槽 = 1)
      槽横 = 画面横1
      槽纵 = 画面纵1
      槽宽 = 画面宽1
      槽高 = 画面高1
    如果结束
    如果 (槽 = 2)
      槽横 = 画面横2
      槽纵 = 画面纵2
      槽宽 = 画面宽2
      槽高 = 画面高2
    如果结束
    如果 (槽 = 3)
      槽横 = 画面横3
      槽纵 = 画面纵3
      槽宽 = 画面宽3
      槽高 = 画面高3
    如果结束
    如果 (槽 = 4)
      槽横 = 画面横4
      槽纵 = 画面纵4
      槽宽 = 画面宽4
      槽高 = 画面高4
    如果结束
    如果 (槽宽 < 1 或 槽高 < 1)
      返回()
    如果结束
    鼠标x = 取鼠标水平位置()
    鼠标y = 取鼠标垂直位置()
    边界 = 窗口_取边界JSON(窗口_取自身句柄())
    窗口x = JSON_取整数(边界, "x", 0)
    窗口y = JSON_取整数(边界, "y", 0)
    // 窗口是无边框样式：窗口矩形即客户区，控件 DIP 坐标 × DPI 即物理坐标
    画面物理x = 窗口x + 槽横 * 窗口dpi / 96
    画面物理y = 窗口y + 槽纵 * 窗口dpi / 96
    画面物理宽 = 槽宽 * 窗口dpi / 96
    画面物理高 = 槽高 * 窗口dpi / 96
    如果 (画面物理宽 < 1 或 画面物理高 < 1)
      返回()
    如果结束
    相对x = (鼠标x - 画面物理x) * 32767 / 画面物理宽
    相对y = (鼠标y - 画面物理y) * 32767 / 画面物理高
    如果 (钳制出界)
      如果 (相对x < 0)
        相对x = 0
      如果结束
      如果 (相对x > 32767)
        相对x = 32767
      如果结束
      如果 (相对y < 0)
        相对y = 0
      如果结束
      如果 (相对y > 32767)
        相对y = 32767
      如果结束
      触点横 = 相对x
      触点纵 = 相对y
    否则
      如果 (相对x >= 0 且 相对x <= 32767)
        如果 (相对y >= 0 且 相对y <= 32767)
          触点横 = 相对x
          触点纵 = 相对y
        如果结束
      如果结束
    如果结束
  结束

  // 手机实际方向与上次声明不同步时重新声明（点击与手势共用）。
  空 同步槽旋转(整数型 槽)
    局部 整数型 槽旋转 = 0
    局部 整数型 槽上次旋转 = -1
    如果 (槽 = 1)
      槽旋转 = 当前旋转1
      槽上次旋转 = 上次旋转1
    如果结束
    如果 (槽 = 2)
      槽旋转 = 当前旋转2
      槽上次旋转 = 上次旋转2
    如果结束
    如果 (槽 = 3)
      槽旋转 = 当前旋转3
      槽上次旋转 = 上次旋转3
    如果结束
    如果 (槽 = 4)
      槽旋转 = 当前旋转4
      槽上次旋转 = 上次旋转4
    如果结束
    如果 (槽旋转 <> 槽上次旋转)
      如果 (槽 = 1)
        AOA_设置屏幕旋转(设备1, 槽旋转)
        上次旋转1 = 槽旋转
      如果结束
      如果 (槽 = 2)
        AOA_设置屏幕旋转(设备2, 槽旋转)
        上次旋转2 = 槽旋转
      如果结束
      如果 (槽 = 3)
        AOA_设置屏幕旋转(设备3, 槽旋转)
        上次旋转3 = 槽旋转
      如果结束
      如果 (槽 = 4)
        AOA_设置屏幕旋转(设备4, 槽旋转)
        上次旋转4 = 槽旋转
      如果结束
    如果结束
  结束

  // 手势按下：逻辑坐标处按下虚拟手指。上一手势未收尾时先抬起（防呆）。
  逻辑型 手势按下(整数型 槽, 整数型 x, 整数型 y)
    局部 逻辑型 已开 = 假
    局部 长整数型 新触点 = 0
    如果 (手势槽 <> 0)
      群控库.手势抬起(手势槽)
    如果结束
    如果 (x < 0 或 x > 32767 或 y < 0 或 y > 32767)
      返回(假)
    如果结束
    如果 (槽 = 1)
      已开 = 设备已开1
    如果结束
    如果 (槽 = 2)
      已开 = 设备已开2
    如果结束
    如果 (槽 = 3)
      已开 = 设备已开3
    如果结束
    如果 (槽 = 4)
      已开 = 设备已开4
    如果结束
    如果 (已开 = 假)
      控件_设置文本(状态栏, "槽 " + 到文本(槽) + "：手势需要先接通手机（点「N 触控」）")
      返回(假)
    如果结束
    群控库.同步槽旋转(槽)
    如果 (槽 = 1)
      新触点 = AOA_手指按下(设备1, x, y)
    如果结束
    如果 (槽 = 2)
      新触点 = AOA_手指按下(设备2, x, y)
    如果结束
    如果 (槽 = 3)
      新触点 = AOA_手指按下(设备3, x, y)
    如果结束
    如果 (槽 = 4)
      新触点 = AOA_手指按下(设备4, x, y)
    如果结束
    如果 (新触点 = 0)
      控件_设置文本(状态栏, "槽 " + 到文本(槽) + " 手势按下失败：" + AOA_取错误())
      返回(假)
    如果结束
    手势槽 = 槽
    手势触点 = 新触点
    手势起点横 = x
    手势起点纵 = y
    手势上次横 = x
    手势上次纵 = y
    返回(真)
  结束

  // 手势移动：曼哈顿距离 ≥500（约屏宽 1.5%）才真正下发，兼顾 USB 吞吐与滑动连续性。
  逻辑型 手势移动(整数型 槽, 整数型 x, 整数型 y)
    局部 整数型 差横 = 0
    局部 整数型 差纵 = 0
    局部 整数型 钳x = 0
    局部 整数型 钳y = 0
    如果 (手势槽 <> 槽 或 手势触点 < 1)
      返回(假)
    如果结束
    钳x = x
    钳y = y
    如果 (钳x < 0)
      钳x = 0
    如果结束
    如果 (钳x > 32767)
      钳x = 32767
    如果结束
    如果 (钳y < 0)
      钳y = 0
    如果结束
    如果 (钳y > 32767)
      钳y = 32767
    如果结束
    差横 = 钳x - 手势上次横
    如果 (差横 < 0)
      差横 = 0 - 差横
    如果结束
    差纵 = 钳y - 手势上次纵
    如果 (差纵 < 0)
      差纵 = 0 - 差纵
    如果结束
    如果 (差横 + 差纵 < 500)
      返回(真)
    如果结束
    如果 (槽 = 1)
      AOA_手指移动(设备1, 手势触点, 钳x, 钳y)
    如果结束
    如果 (槽 = 2)
      AOA_手指移动(设备2, 手势触点, 钳x, 钳y)
    如果结束
    如果 (槽 = 3)
      AOA_手指移动(设备3, 手势触点, 钳x, 钳y)
    如果结束
    如果 (槽 = 4)
      AOA_手指移动(设备4, 手势触点, 钳x, 钳y)
    如果结束
    手势上次横 = 钳x
    手势上次纵 = 钳y
    返回(真)
  结束

  // 手势抬起：结束触摸并清状态。Click（STN_CLICKED）在本事件派发前到达，由 吞槽点击 拦截。
  逻辑型 手势抬起(整数型 槽)
    如果 (手势槽 <> 槽)
      返回(假)
    如果结束
    如果 (槽 = 1)
      AOA_手指抬起(设备1, 手势触点)
    如果结束
    如果 (槽 = 2)
      AOA_手指抬起(设备2, 手势触点)
    如果结束
    如果 (槽 = 3)
      AOA_手指抬起(设备3, 手势触点)
    如果结束
    如果 (槽 = 4)
      AOA_手指抬起(设备4, 手势触点)
    如果结束
    手势槽 = 0
    手势触点 = 0
    返回(真)
  结束

  // 手势进行中收到 Click 一律吞（按下+抬起已构成完整触摸，不能再来一发 AOA_单击）。
  逻辑型 吞槽点击(整数型 槽)
    如果 (手势槽 = 槽)
      返回(真)
    如果结束
    返回(假)
  结束

  // 读整个文件为字节集（上限 4MB，帧 JPEG 与小模板都够用）；打不开返回空字节集。
  字节集 读文件字节集(文本型 路径)
    局部 文件号 号
    局部 字节集 数据 = 字节集_从文本("")
    号 = 文件_打开(路径, 1, 1)
    如果 (号 > 0)
      数据 = 文件_读入字节集(号, 4 * 1024 * 1024)
      文件_关闭(号)
    如果结束
    返回(数据)
  结束

  // 用当前 触点横/触点纵 全局值直接向指定槽注入 HID 单击（找图点击等程序化点击共用；
  // 与 处理槽点击 的区别：这里不做鼠标换算，坐标由调用方算好写入 触点横/触点纵）。
  逻辑型 注入槽点击(整数型 槽)
    局部 逻辑型 已开 = 假
    如果 (槽 = 1)
      已开 = 设备已开1
    如果结束
    如果 (槽 = 2)
      已开 = 设备已开2
    如果结束
    如果 (槽 = 3)
      已开 = 设备已开3
    如果结束
    如果 (槽 = 4)
      已开 = 设备已开4
    如果结束
    如果 (已开 = 假)
      控件_设置文本(状态栏, "槽 " + 到文本(槽) + "：注入点击需要先接通触控（点「N 触控」）")
      返回(假)
    如果结束
    群控库.同步槽旋转(槽)
    如果 (槽 = 1)
      如果 (AOA_单击(设备1, 触点横, 触点纵))
        返回(真)
      否则
        控件_设置文本(状态栏, "槽1 注入点击失败：" + AOA_取错误())
        返回(假)
      如果结束
    如果结束
    如果 (槽 = 2)
      如果 (AOA_单击(设备2, 触点横, 触点纵))
        返回(真)
      否则
        控件_设置文本(状态栏, "槽2 注入点击失败：" + AOA_取错误())
        返回(假)
      如果结束
    如果结束
    如果 (槽 = 3)
      如果 (AOA_单击(设备3, 触点横, 触点纵))
        返回(真)
      否则
        控件_设置文本(状态栏, "槽3 注入点击失败：" + AOA_取错误())
        返回(假)
      如果结束
    如果结束
    如果 (槽 = 4)
      如果 (AOA_单击(设备4, 触点横, 触点纵))
        返回(真)
      否则
        控件_设置文本(状态栏, "槽4 注入点击失败：" + AOA_取错误())
        返回(假)
      如果结束
    如果结束
    返回(假)
  结束

  // MouseDown/Move 事件薄壳：读鼠标位置换算成逻辑坐标后走手势三段（按下要求界内，拖动钳到边缘）。
  逻辑型 手势按下鼠标(整数型 槽)
    群控库.换算槽触点(槽, 假)
    如果 (触点横 < 0)
      返回(假)
    如果结束
    返回(群控库.手势按下(槽, 触点横, 触点纵))
  结束

  逻辑型 手势移动鼠标(整数型 槽)
    群控库.换算槽触点(槽, 真)
    如果 (触点横 < 0)
      返回(假)
    如果结束
    返回(群控库.手势移动(槽, 触点横, 触点纵))
  结束

  // ===== MirrorDesk WebUI（2026-10-21）：HTTP 帧服务 + EdgeView 输入桥 =====
  // 帧管线不变（泵照旧双缓冲落盘），WebUI 用 http.server 动态路由取帧与状态；
  // 输入反向：HTML pointer 事件经 EdgeView 网页消息（JSON）送到 处理网页动作。

  // 给指定槽下发控制指令 JSON：USB 数据通道优先（LBAC 通道2），WS 已连接走 WS。
  空 发槽指令(整数型 槽, 文本型 指令JSON)
    局部 字节集 指令字节 = 字节集_从文本(指令JSON)
    如果 (槽 = 1)
      如果 (通道1 > 0)
        AOA_数据通道发帧(通道1, 指令字节)
      否则
        如果 (WS_是否已连接(手机连接1))
          // 异步发送（2026-10-22）：同步发送会卡在半开 TCP 的内核重传上、阻塞 UI 线程数十秒（点主页卡死实锤）
          WS_发送文本到连接异步(手机连接1, 指令JSON)
        如果结束
      如果结束
    如果结束
    如果 (槽 = 2)
      如果 (通道2 > 0)
        AOA_数据通道发帧(通道2, 指令字节)
      否则
        如果 (WS_是否已连接(手机连接2))
          // 异步发送（2026-10-22）：同步发送会卡在半开 TCP 的内核重传上、阻塞 UI 线程数十秒（点主页卡死实锤）
          WS_发送文本到连接异步(手机连接2, 指令JSON)
        如果结束
      如果结束
    如果结束
    如果 (槽 = 3)
      如果 (通道3 > 0)
        AOA_数据通道发帧(通道3, 指令字节)
      否则
        如果 (WS_是否已连接(手机连接3))
          // 异步发送（2026-10-22）：同步发送会卡在半开 TCP 的内核重传上、阻塞 UI 线程数十秒（点主页卡死实锤）
          WS_发送文本到连接异步(手机连接3, 指令JSON)
        如果结束
      如果结束
    如果结束
    如果 (槽 = 4)
      如果 (通道4 > 0)
        AOA_数据通道发帧(通道4, 指令字节)
      否则
        如果 (WS_是否已连接(手机连接4))
          // 异步发送（2026-10-22）：同步发送会卡在半开 TCP 的内核重传上、阻塞 UI 线程数十秒（点主页卡死实锤）
          WS_发送文本到连接异步(手机连接4, 指令JSON)
        如果结束
      如果结束
    如果结束
  结束

  // 双缓冲里「最新完整帧」的文件名（与 控件_设置图片 的选择逻辑一致）。
  文本型 取槽帧文件(整数型 槽)
    如果 (槽 = 1)
      如果 (用甲帧1)
        返回("aoa_s1_0.jpg")
      否则
        返回("aoa_s1_1.jpg")
      如果结束
    如果结束
    如果 (槽 = 2)
      如果 (用甲帧2)
        返回("aoa_s2_0.jpg")
      否则
        返回("aoa_s2_1.jpg")
      如果结束
    如果结束
    如果 (槽 = 3)
      如果 (用甲帧3)
        返回("aoa_s3_0.jpg")
      否则
        返回("aoa_s3_1.jpg")
      如果结束
    如果结束
    如果 (槽 = 4)
      如果 (用甲帧4)
        返回("aoa_s4_0.jpg")
      否则
        返回("aoa_s4_1.jpg")
      如果结束
    如果结束
    返回("")
  结束

  // HTTP 动态路由 /frame/N：no-store 发送该槽最新帧（无帧 404）。
  空 服务帧(整数型 槽)
    局部 HTTP请求 请求
    请求 = HTTP_取当前请求()
    局部 文本型 帧文件 = ""
    如果 (请求 = 0)
      返回()
    如果结束
    帧文件 = 群控库.取槽帧文件(槽)
    HTTP_设置响应头(请求, "Cache-Control", "no-store")
    如果 (帧文件 = "" 或 文件_是否存在(帧文件) = 假)
      HTTP_发送文本(请求, "no frame yet", "text/plain; charset=utf-8", 404)
      返回()
    如果结束
    HTTP_发送文件(请求, 帧文件, "", "image/jpeg", 200)
  结束

  // 状态 JSON 构造（静态路由定期重注册用；WebView 轮询经工作线程直回，绕开 UI 线程动态处理）。
  文本型 状态JSON()
    局部 文本型 JSON = ""
    JSON = "{\"slots\":["
    JSON = JSON + "{\"slot\":1,\"usb\":" + 群控库.逻辑文本(通道1 > 0) + ",\"ws\":" + 群控库.逻辑文本(WS_是否已连接(手机连接1)) + ",\"frames\":" + 到文本(USB帧数1) + ",\"w\":" + 到文本(帧宽1) + ",\"h\":" + 到文本(帧高1) + ",\"rot\":" + 到文本(当前旋转1) + ",\"flip\":" + 群控库.逻辑文本(用甲帧1) + "},"
    JSON = JSON + "{\"slot\":2,\"usb\":" + 群控库.逻辑文本(通道2 > 0) + ",\"ws\":" + 群控库.逻辑文本(WS_是否已连接(手机连接2)) + ",\"frames\":" + 到文本(USB帧数2) + ",\"w\":" + 到文本(帧宽2) + ",\"h\":" + 到文本(帧高2) + ",\"rot\":" + 到文本(当前旋转2) + ",\"flip\":" + 群控库.逻辑文本(用甲帧2) + "},"
    JSON = JSON + "{\"slot\":3,\"usb\":" + 群控库.逻辑文本(通道3 > 0) + ",\"ws\":" + 群控库.逻辑文本(WS_是否已连接(手机连接3)) + ",\"frames\":" + 到文本(USB帧数3) + ",\"w\":" + 到文本(帧宽3) + ",\"h\":" + 到文本(帧高3) + ",\"rot\":" + 到文本(当前旋转3) + ",\"flip\":" + 群控库.逻辑文本(用甲帧3) + "},"
    JSON = JSON + "{\"slot\":4,\"usb\":" + 群控库.逻辑文本(通道4 > 0) + ",\"ws\":" + 群控库.逻辑文本(WS_是否已连接(手机连接4)) + ",\"frames\":" + 到文本(USB帧数4) + ",\"w\":" + 到文本(帧宽4) + ",\"h\":" + 到文本(帧高4) + ",\"rot\":" + 到文本(当前旋转4) + ",\"flip\":" + 群控库.逻辑文本(用甲帧4) + "}"
    JSON = JSON + "]}"
    返回(JSON)
  结束

  // HTTP /api/status：四槽聚合状态（connected=USB 通道/WS 任一在传，frames=USB 帧数，w/h/rot=最近 env）。
  空 服务状态()
    局部 HTTP请求 请求
    请求 = HTTP_取当前请求()
    局部 文本型 JSON = ""
    如果 (请求 = 0)
      返回()
    如果结束
    JSON = "{\"slots\":["
    JSON = JSON + "{\"slot\":1,\"usb\":" + 群控库.逻辑文本(通道1 > 0) + ",\"ws\":" + 群控库.逻辑文本(WS_是否已连接(手机连接1)) + ",\"frames\":" + 到文本(USB帧数1) + ",\"w\":" + 到文本(帧宽1) + ",\"h\":" + 到文本(帧高1) + ",\"rot\":" + 到文本(当前旋转1) + ",\"flip\":" + 群控库.逻辑文本(用甲帧1) + "},"
    JSON = JSON + "{\"slot\":2,\"usb\":" + 群控库.逻辑文本(通道2 > 0) + ",\"ws\":" + 群控库.逻辑文本(WS_是否已连接(手机连接2)) + ",\"frames\":" + 到文本(USB帧数2) + ",\"w\":" + 到文本(帧宽2) + ",\"h\":" + 到文本(帧高2) + ",\"rot\":" + 到文本(当前旋转2) + ",\"flip\":" + 群控库.逻辑文本(用甲帧2) + "},"
    JSON = JSON + "{\"slot\":3,\"usb\":" + 群控库.逻辑文本(通道3 > 0) + ",\"ws\":" + 群控库.逻辑文本(WS_是否已连接(手机连接3)) + ",\"frames\":" + 到文本(USB帧数3) + ",\"w\":" + 到文本(帧宽3) + ",\"h\":" + 到文本(帧高3) + ",\"rot\":" + 到文本(当前旋转3) + ",\"flip\":" + 群控库.逻辑文本(用甲帧3) + "},"
    JSON = JSON + "{\"slot\":4,\"usb\":" + 群控库.逻辑文本(通道4 > 0) + ",\"ws\":" + 群控库.逻辑文本(WS_是否已连接(手机连接4)) + ",\"frames\":" + 到文本(USB帧数4) + ",\"w\":" + 到文本(帧宽4) + ",\"h\":" + 到文本(帧高4) + ",\"rot\":" + 到文本(当前旋转4) + ",\"flip\":" + 群控库.逻辑文本(用甲帧4) + "}"
    JSON = JSON + "]}"
    HTTP_发送JSON(请求, JSON, 200)
  结束

  文本型 逻辑文本(逻辑型 值)
    如果 (值)
      返回("true")
    如果结束
    返回("false")
  结束

  // HTTP /：MirrorDesk 页面（CWD 优先，源码根兜底；UTF-8 文本回发）。
  空 服务页面()
    局部 HTTP请求 请求
    请求 = HTTP_取当前请求()
    局部 文本型 页面 = ""
    如果 (请求 = 0)
      返回()
    如果结束
    页面 = 群控库.取页面路径()
    如果 (页面 = "")
      HTTP_发送文本(请求, "mirrordesk.html not found", "text/plain; charset=utf-8", 404)
      返回()
    如果结束
    HTTP_发送文本(请求, 文件_读取文本(页面, "UTF-8"), "text/html; charset=utf-8", 200)
  结束

  文本型 取页面路径()
    如果 (文件_是否存在("mirrordesk.html"))
      返回("mirrordesk.html")
    如果结束
    如果 (文件_是否存在("T:\\electron\\lingbuilder\\src\\aoa-viewer\\mirrordesk.html"))
      返回("T:\\electron\\lingbuilder\\src\\aoa-viewer\\mirrordesk.html")
    如果结束
    返回("")
  结束

  // EdgeView 网页消息入口：HTML 端 chrome.webview.postMessage 的 JSON 统一在此分发。
  // 动作：down/move/up（0~32767 逻辑坐标手势三段）、home、wake、shot、receive、touch、disconnectAll、refresh。
  空 处理网页动作(文本型 消息JSON)
    局部 整数型 槽 = JSON_取整数(消息JSON, "slot", 0)
    局部 文本型 动作 = JSON_取文本(消息JSON, "action")
    局部 整数型 横 = JSON_取整数(消息JSON, "x", -1)
    局部 整数型 纵 = JSON_取整数(消息JSON, "y", -1)
    如果 (动作 = "down")
      群控库.手势按下(槽, 横, 纵)
    如果结束
    如果 (动作 = "move")
      群控库.手势移动(槽, 横, 纵)
    如果结束
    如果 (动作 = "up")
      群控库.手势抬起(槽)
    如果结束
    如果 (动作 = "home")
      群控库.发槽指令(槽, "{\"cmd\":\"goHome\"}")
    如果结束
    如果 (动作 = "wake")
      群控库.发槽指令(槽, "{\"cmd\":\"wakeScreen\"}")
    如果结束
    如果 (动作 = "back")
      群控库.发槽指令(槽, "{\"cmd\":\"goBack\"}")
    如果结束
    如果 (动作 = "notif")
      群控库.下拉通知栏(槽)
    如果结束
    如果 (动作 = "shot")
      群控库.截取槽画面(槽)
    如果结束
  结束

  // 截图：当前最新帧复制为 截图_槽N_时间戳.jpg（存 exe 同目录；失败静默——WebUI 端 toast 提示由前端做）。
  空 截取槽画面(整数型 槽)
    局部 文本型 帧文件 = 群控库.取槽帧文件(槽)
    如果 (帧文件 = "" 或 文件_是否存在(帧文件) = 假)
      返回()
    如果结束
    文件_复制(帧文件, "截图_槽" + 到文本(槽) + "_" + 到文本(截图计数) + ".jpg", 真)
    截图计数 = 截图计数 + 1
  结束

  // 隐藏手势：点状态N = 从该手机屏幕顶部下滑拉出通知栏（用于放行 MIUI/鸿蒙的
  // 「已拦截 USB 输入设备」提示）。仅该槽设备已接通时有效。
  逻辑型 下拉通知栏(整数型 槽)
    如果 (槽 = 1)
      如果 (设备已开1 = 假)
        返回(假)
      如果结束
      返回(AOA_滑动(设备1, 16383, 300, 16383, 26000, 350))
    如果结束
    如果 (槽 = 2)
      如果 (设备已开2 = 假)
        返回(假)
      如果结束
      返回(AOA_滑动(设备2, 16383, 300, 16383, 26000, 350))
    如果结束
    如果 (槽 = 3)
      如果 (设备已开3 = 假)
        返回(假)
      如果结束
      返回(AOA_滑动(设备3, 16383, 300, 16383, 26000, 350))
    如果结束
    如果 (槽 = 4)
      如果 (设备已开4 = 假)
        返回(假)
      如果结束
      返回(AOA_滑动(设备4, 16383, 300, 16383, 26000, 350))
    如果结束
    返回(假)
  结束

  // ===== 投屏自动发现（2026-10-22）：UDP 51750 信标监听 + 登记 + 自动连接 =====
  // 手机伴侣 v1.3.0 投屏会话运行期间每 3 秒广播 {"app":"lingbuilder-companion","ver":130,
  // "name":"<型号>","ws":"ws://IP:端口/stream?token=配对码","w":..,"h":..,"fps":..}，
  // 停止投屏先发 {"offline":true,"ws":..} 再停服务。本端 @-inline 非阻塞 recvfrom 逐包消化
  //（winsock2.h 与 ws2_32.lib 已由运行时基座包含链接，@ 块可直接写套接字代码），
  // 按连接串登记到 槽信标1..4；新设备自动占用第一个空闲槽走 WS 连接；心跳超 10 秒判离线释放。
  // 红线：监听必须非阻塞、泵每拍顺带消化，禁止自建线程、禁止阻塞 UI 线程。

  // 建立监听套接字（幂等，创建完毕调用一次；失败不重试，原因写 viewer.log 与状态栏）。
  空 信标启动()
    局部 文本型 结果文本 = ""
    @ {
    @     if (信标初始化 == 0) {
    @         WSADATA 信标数据 {};
    @         信标初始化 = WSAStartup(MAKEWORD(2, 2), &信标数据) == 0 ? 1 : -1;
    @         if (信标初始化 == 1) {
    @             SOCKET 新套接字 = socket(AF_INET, SOCK_DGRAM, IPPROTO_UDP);
    @             if (新套接字 != INVALID_SOCKET) {
    @                 BOOL 允许复用 = TRUE;
    @                 setsockopt(新套接字, SOL_SOCKET, SO_REUSEADDR, (const char*)&允许复用, sizeof(允许复用));
    @                 u_long 非阻塞 = 1;
    @                 ioctlsocket(新套接字, FIONBIO, &非阻塞);
    @                 sockaddr_in 本地地址 {};
    @                 本地地址.sin_family = AF_INET;
    @                 本地地址.sin_port = htons(51750);
    @                 本地地址.sin_addr.s_addr = INADDR_ANY;
    @                 if (bind(新套接字, (sockaddr*)&本地地址, sizeof(本地地址)) == 0) {
    @                     信标套接字 = (long long)新套接字;
    @                 } else {
    @                     closesocket(新套接字);
    @                 }
    @             }
    @         }
    @     }
    @     结果文本 = 信标套接字 != 0 ? std::wstring(L"UDP 51750 监听就绪") : (信标初始化 == -1 ? std::wstring(L"网络服务初始化失败") : std::wstring(L"端口 51750 绑定失败（可能另一台查看器在运行，或被防火墙/安全软件拦截）"));
    @ }
    文件_追加文本("viewer.log", "信标 " + 结果文本 + " |")
    如果 (信标套接字 = 0)
      控件_设置文本(状态栏, "自动发现不可用：" + 结果文本)
    否则
      控件_设置文本(状态栏, "自动发现已就绪，手机点「开始投屏」即自动接入（首包可能被防火墙拦，允许后生效）")
    如果结束
  结束

  // 泵每拍调用：非阻塞消化待收信标包（每拍最多 8 包），本拍收到过包返回 真。
  逻辑型 信标轮询()
    局部 逻辑型 有包 = 假
    局部 文本型 包文本 = ""
    局部 整数型 序号 = 0
    计次循环首 (8, 序号)
      包文本 = ""
      @ {
      @     if (信标套接字 != 0) {
      @         char 包缓冲[2048];
      @         sockaddr_in 来源地址 {};
      @         int 来源长度 = sizeof(来源地址);
      @         int 收到字节 = recvfrom((SOCKET)信标套接字, 包缓冲, (int)sizeof(包缓冲) - 1, 0, (sockaddr*)&来源地址, &来源长度);
      @         if (收到字节 < 0) {
      @             int 套接字错误码 = WSAGetLastError();
      @             if (套接字错误码 != WSAEWOULDBLOCK && 套接字错误码 != 信标最后错误) { 信标最后错误 = 套接字错误码; }
      @         }
      @         if (收到字节 > 0) {
      @             包缓冲[收到字节] = 0;
      @             int 宽长度 = MultiByteToWideChar(CP_UTF8, 0, 包缓冲, 收到字节, nullptr, 0);
      @             if (宽长度 > 0 && 宽长度 < 4096) {
      @                 std::wstring 宽文本(宽长度, L'\0');
      @                 MultiByteToWideChar(CP_UTF8, 0, 包缓冲, 收到字节, &宽文本[0], 宽长度);
      @                 包文本 = 宽文本;
      @             }
      @         }
      @     }
      @ }
      如果 (包文本 <> "")
        有包 = 真
        群控库.信标收包(包文本)
      如果结束
    计次循环尾 ()
    如果 (信标最后错误 <> 信标已记错误)
      信标已记错误 = 信标最后错误
      文件_追加文本("viewer.log", "信标 recv 错误码 " + 到文本(信标最后错误) + " |")
    如果结束
    返回(有包)
  结束

  // 单包处理：刷新已知设备心跳 / 下线释放 / 新设备分配空闲槽并连接。
  空 信标收包(文本型 包JSON)
    当前毫秒 = 0
    @ 当前毫秒 = (long long)GetTickCount64();
    局部 文本型 连接串 = ""
    局部 整数型 已知槽 = 0
    局部 整数型 空槽 = 0
    局部 文本型 设备名 = ""
    局部 文本型 应用名 = ""
    局部 逻辑型 是下线 = 假
    局部 文本型 sn = ""
    连接串 = JSON_取文本(包JSON, "ws")
    如果 (连接串 = "")
      文件_追加文本("viewer.log", "信标 弃包:ws为空 |")
      返回()
    如果结束
    // 红线（2026-10-22 实锤）：JSON_取文本 返回轮转缓冲裸指针，「函数调用直接 <> 字面量」
    // 会被生成器按指针比较恒不等——必须先赋给文本变量再比较（变量比较才会包 std::wstring）。
    应用名 = JSON_取文本(包JSON, "app")
    如果 (应用名 <> "lingbuilder-companion")
      文件_追加文本("viewer.log", "信标 弃包:app=" + 应用名 + " |")
      返回()
    如果结束
    // 下线标记兼容两种形态：数字 1（app v1.3.0 实际发送）与布尔 true
    //（协议草稿形态；JSON_取整数 不认布尔，必须再取一次文本判 "true"）
    是下线 = 假
    如果 (JSON_取整数(包JSON, "offline", 0) = 1)
      是下线 = 真
    如果结束
    如果 (是下线 = 假)
      // 布尔形态走 JSON_取逻辑（取文本/取整数都不认布尔节点）
      如果 (JSON_取逻辑(包JSON, "offline", 假))
        是下线 = 真
      如果结束
    如果结束
    如果 (是下线)
      // 正常下线清该串退避：用户重开投屏是新会话，必须能立即接入
      如果 (信标失败串 = 连接串)
        信标失败串 = ""
        信标失败次数 = 0
      如果结束
      群控库.信标释放(连接串, "手机已停止投屏")
      返回()
    如果结束
    已知槽 = 群控库.信标查找槽(连接串)
    如果 (已知槽 > 0)
      sn = JSON_取文本(包JSON, "sn")
      群控库.信标刷新(已知槽, 包JSON)
      如果 (sn <> "")
        文件_追加文本("viewer.log", "sn 观测 槽" + 到文本(已知槽) + " [" + sn + "] |")
      如果结束
      返回()
    如果结束
    如果 (信标暂停)
      文件_追加文本("viewer.log", "信标 弃包:自动发现已暂停 |")
      返回()
    如果结束
    空槽 = 群控库.取空闲信标槽()
    如果 (空槽 = 0)
      返回()
    如果结束
    如果 (连接串 = 信标失败串)
      如果 (当前毫秒 - 信标失败时刻 < 群控库.信标退避窗口())
        返回()
      如果结束
    如果结束
    设备名 = JSON_取文本(包JSON, "name")
    如果 (设备名 = "")
      设备名 = "设备"
    如果结束
    群控库.信标接入(空槽, 连接串, 设备名, JSON_取文本(包JSON, "sn"))
  结束

  // 该连接串已登记在哪个槽（含手动连接登记），没有返回 0。
  整数型 信标查找槽(文本型 连接串)
    如果 (槽信标1 = 连接串)
      返回(1)
    如果结束
    如果 (槽信标2 = 连接串)
      返回(2)
    如果结束
    如果 (槽信标3 = 连接串)
      返回(3)
    如果结束
    如果 (槽信标4 = 连接串)
      返回(4)
    如果结束
    返回(0)
  结束

  // 已登记设备的信标心跳刷新（顺带更新设备名与配件序列号——sn 只在非空时回填：
  // 手机离开配件模式后信标不再携带 sn，保留旧值才能维持槽与 USB 设备的对齐）。
  空 信标刷新(整数型 槽, 文本型 包JSON)
    局部 文本型 sn = ""
    sn = JSON_取文本(包JSON, "sn")
    如果 (槽 = 1)
      信标心跳1 = 当前毫秒
      信标名1 = JSON_取文本(包JSON, "name")
      如果 (sn <> "")
        槽信标SN1 = sn
      如果结束
    如果结束
    如果 (槽 = 2)
      信标心跳2 = 当前毫秒
      信标名2 = JSON_取文本(包JSON, "name")
      如果 (sn <> "")
        槽信标SN2 = sn
      如果结束
    如果结束
    如果 (槽 = 3)
      信标心跳3 = 当前毫秒
      信标名3 = JSON_取文本(包JSON, "name")
      如果 (sn <> "")
        槽信标SN3 = sn
      如果结束
    如果结束
    如果 (槽 = 4)
      信标心跳4 = 当前毫秒
      信标名4 = JSON_取文本(包JSON, "name")
      如果 (sn <> "")
        槽信标SN4 = sn
      如果结束
    如果结束
  结束

  // 第一个既无信标登记也未连接（USB/WS 皆空）的槽，没有返回 0。
  整数型 取空闲信标槽()
    如果 (槽信标1 = "")
      如果 (通道1 = 0)
        如果 (WS_是否已连接(手机连接1) = 假)
          返回(1)
        如果结束
      如果结束
    如果结束
    如果 (槽信标2 = "")
      如果 (通道2 = 0)
        如果 (WS_是否已连接(手机连接2) = 假)
          返回(2)
        如果结束
      如果结束
    如果结束
    如果 (槽信标3 = "")
      如果 (通道3 = 0)
        如果 (WS_是否已连接(手机连接3) = 假)
          返回(3)
        如果结束
      如果结束
    如果结束
    如果 (槽信标4 = "")
      如果 (通道4 = 0)
        如果 (WS_是否已连接(手机连接4) = 假)
          返回(4)
        如果结束
      如果结束
    如果结束
    返回(0)
  结束

  // 新设备接入：登记 + 发起 WS 连接。发起失败立即退避；异步连不上由 断开/错误提示 记退避。
  空 信标接入(整数型 槽, 文本型 连接串, 文本型 设备名, 文本型 sn)
    局部 逻辑型 已发起 = 假
    如果 (槽 = 1)
      槽信标1 = 连接串
      信标心跳1 = 当前毫秒
      信标名1 = 设备名
      槽信标SN1 = sn
      如果 (WS_配置连接(手机连接1, 连接串))
        如果 (WS_开始连接(手机连接1))
          已发起 = 真
        如果结束
      如果结束
      如果 (已发起 = 假)
        槽信标1 = ""
      如果结束
    如果结束
    如果 (槽 = 2)
      槽信标2 = 连接串
      信标心跳2 = 当前毫秒
      信标名2 = 设备名
      槽信标SN2 = sn
      如果 (WS_配置连接(手机连接2, 连接串))
        如果 (WS_开始连接(手机连接2))
          已发起 = 真
        如果结束
      如果结束
      如果 (已发起 = 假)
        槽信标2 = ""
      如果结束
    如果结束
    如果 (槽 = 3)
      槽信标3 = 连接串
      信标心跳3 = 当前毫秒
      信标名3 = 设备名
      槽信标SN3 = sn
      如果 (WS_配置连接(手机连接3, 连接串))
        如果 (WS_开始连接(手机连接3))
          已发起 = 真
        如果结束
      如果结束
      如果 (已发起 = 假)
        槽信标3 = ""
      如果结束
    如果结束
    如果 (槽 = 4)
      槽信标4 = 连接串
      信标心跳4 = 当前毫秒
      信标名4 = 设备名
      槽信标SN4 = sn
      如果 (WS_配置连接(手机连接4, 连接串))
        如果 (WS_开始连接(手机连接4))
          已发起 = 真
        如果结束
      如果结束
      如果 (已发起 = 假)
        槽信标4 = ""
      如果结束
    如果结束
    如果 (已发起)
      文件_追加文本("viewer.log", "信标 槽" + 到文本(槽) + " 接入 " + 设备名 + " @" + 到文本(当前毫秒) + " |")
      控件_设置文本(状态栏, "自动发现：" + 设备名 + " 已接入槽" + 到文本(槽))
      EdgeView脚本_发送JSON消息(浏览器, "{\"event\":\"notify\",\"text\":\"发现设备 " + 设备名 + "，已自动接入槽位 " + 到文本(槽) + "\"}")
    否则
      信标失败串 = 连接串
      信标失败次数 = 信标失败次数 + 1
      信标失败时刻 = 0
      @ 信标失败时刻 = (long long)GetTickCount64();
      文件_追加文本("viewer.log", "信标 槽" + 到文本(槽) + " 接入失败，退避 " + 连接串 + " |")
      控件_设置文本(状态栏, "自动发现：" + 设备名 + " 连接未发起（可能已切 USB 直传），20 秒后重试")
    如果结束
  结束

  // 释放绑定该连接串的槽位（下线信标 / 心跳超时共用）。USB 直传槽只清登记不动通道。
  空 信标释放(文本型 连接串, 文本型 原因)
    如果 (槽信标1 = 连接串)
      槽信标1 = ""
      信标名1 = ""
      槽信标SN1 = ""
      如果 (槽USB传输1 = 假)
        WS_关闭连接(手机连接1, 1000, "")
        控件_设置文本(状态1, "槽1 未连接（" + 原因 + "）")
      如果结束
    如果结束
    如果 (槽信标2 = 连接串)
      槽信标2 = ""
      信标名2 = ""
      槽信标SN2 = ""
      如果 (槽USB传输2 = 假)
        WS_关闭连接(手机连接2, 1000, "")
        控件_设置文本(状态2, "槽2 未连接（" + 原因 + "）")
      如果结束
    如果结束
    如果 (槽信标3 = 连接串)
      槽信标3 = ""
      信标名3 = ""
      槽信标SN3 = ""
      如果 (槽USB传输3 = 假)
        WS_关闭连接(手机连接3, 1000, "")
        控件_设置文本(状态3, "槽3 未连接（" + 原因 + "）")
      如果结束
    如果结束
    如果 (槽信标4 = 连接串)
      槽信标4 = ""
      信标名4 = ""
      槽信标SN4 = ""
      如果 (槽USB传输4 = 假)
        WS_关闭连接(手机连接4, 1000, "")
        控件_设置文本(状态4, "槽4 未连接（" + 原因 + "）")
      如果结束
    如果结束
    文件_追加文本("viewer.log", "信标 离线 " + 原因 + " |")
    EdgeView脚本_发送JSON消息(浏览器, "{\"event\":\"notify\",\"text\":\"设备已离开（" + 原因 + "），槽位已退回\"}")
  结束

  // 泵每 32 拍巡检：登记中设备心跳超 10 秒（杀进程/断网无下线包）即释放槽位。
  空 信标超时巡检()
    当前毫秒 = 0
    @ 当前毫秒 = (long long)GetTickCount64();
    如果 (槽信标1 <> "")
      如果 (当前毫秒 - 信标心跳1 > 10000)
        群控库.信标释放(槽信标1, "心跳超时")
      如果结束
    如果结束
    如果 (槽信标2 <> "")
      如果 (当前毫秒 - 信标心跳2 > 10000)
        群控库.信标释放(槽信标2, "心跳超时")
      如果结束
    如果结束
    如果 (槽信标3 <> "")
      如果 (当前毫秒 - 信标心跳3 > 10000)
        群控库.信标释放(槽信标3, "心跳超时")
      如果结束
    如果结束
    如果 (槽信标4 <> "")
      如果 (当前毫秒 - 信标心跳4 > 10000)
        群控库.信标释放(槽信标4, "心跳超时")
      如果结束
    如果结束
  结束

  // 指数退避窗口：连续失败越多等越久，5 分钟封顶；收到数据或下线信标即清零重来。
  整数型 信标退避窗口()
    如果 (信标失败次数 <= 1)
      返回(20000)
    如果结束
    如果 (信标失败次数 = 2)
      返回(40000)
    如果结束
    如果 (信标失败次数 = 3)
      返回(80000)
    如果结束
    如果 (信标失败次数 = 4)
      返回(160000)
    如果结束
    返回(300000)
  结束

  // ===== 自动接通触控（2026-10-22）：信标 SN 已知即自动打开对的那台 =====
  // 仅在 sn 已知时触发（手机已在配件模式，直开秒级返回，无切配件长阻塞）；
  // 打开由泵在冷却到期时调用，失败不置 设备已开，泵侧 30 秒后再试。
  空 自动接通触控(整数型 槽)
    如果 (槽 = 1)
      如果 (设备已开1 = 假)
        如果 (槽信标SN1 = "")
          槽信标SN1 = 群控库.按名找序列号(信标名1, 真)
        如果结束
        如果 (槽信标SN1 <> "")
          文件_追加文本("viewer.log", "槽1 自动接通触控 SN[" + 槽信标SN1 + "] |")
          设备1 = AOA_打开设备(槽信标SN1)
          如果 (设备1 = 0)
            文件_追加文本("viewer.log", "槽1 自动接通失败 " + AOA_取错误() + " |")
          否则
            设备已开1 = 真
            AOA_设置屏幕旋转(设备1, 当前旋转1)
            上次旋转1 = 当前旋转1
            控件_设置文本(状态栏, "槽1 触控已自动接通（信标对齐）")
          如果结束
        如果结束
      如果结束
    如果结束
    如果 (槽 = 2)
      如果 (设备已开2 = 假)
        如果 (槽信标SN2 = "")
          槽信标SN2 = 群控库.按名找序列号(信标名2, 真)
        如果结束
        如果 (槽信标SN2 <> "")
          文件_追加文本("viewer.log", "槽2 自动接通触控 SN[" + 槽信标SN2 + "] |")
          设备2 = AOA_打开设备(槽信标SN2)
          如果 (设备2 = 0)
            文件_追加文本("viewer.log", "槽2 自动接通失败 " + AOA_取错误() + " |")
          否则
            设备已开2 = 真
            AOA_设置屏幕旋转(设备2, 当前旋转2)
            上次旋转2 = 当前旋转2
            控件_设置文本(状态栏, "槽2 触控已自动接通（信标对齐）")
          如果结束
        如果结束
      如果结束
    如果结束
    如果 (槽 = 3)
      如果 (设备已开3 = 假)
        如果 (槽信标SN3 = "")
          槽信标SN3 = 群控库.按名找序列号(信标名3, 真)
        如果结束
        如果 (槽信标SN3 <> "")
          文件_追加文本("viewer.log", "槽3 自动接通触控 SN[" + 槽信标SN3 + "] |")
          设备3 = AOA_打开设备(槽信标SN3)
          如果 (设备3 = 0)
            文件_追加文本("viewer.log", "槽3 自动接通失败 " + AOA_取错误() + " |")
          否则
            设备已开3 = 真
            AOA_设置屏幕旋转(设备3, 当前旋转3)
            上次旋转3 = 当前旋转3
            控件_设置文本(状态栏, "槽3 触控已自动接通（信标对齐）")
          如果结束
        如果结束
      如果结束
    如果结束
    如果 (槽 = 4)
      如果 (设备已开4 = 假)
        如果 (槽信标SN4 = "")
          槽信标SN4 = 群控库.按名找序列号(信标名4, 真)
        如果结束
        如果 (槽信标SN4 <> "")
          文件_追加文本("viewer.log", "槽4 自动接通触控 SN[" + 槽信标SN4 + "] |")
          设备4 = AOA_打开设备(槽信标SN4)
          如果 (设备4 = 0)
            文件_追加文本("viewer.log", "槽4 自动接通失败 " + AOA_取错误() + " |")
          否则
            设备已开4 = 真
            AOA_设置屏幕旋转(设备4, 当前旋转4)
            上次旋转4 = 当前旋转4
            控件_设置文本(状态栏, "槽4 触控已自动接通（信标对齐）")
          如果结束
        如果结束
      如果结束
    如果结束
  结束

  // ===== 同步操控（2026-10-22）：手势三段广播到所有已接通触控的槽位 =====
  // 红线：广播不经 手势按下/手势抬起（单组 手势槽/手势触点 会被多指互踩），每槽独立触点 ID。

  空 广播按下(整数型 x, 整数型 y)
    如果 (设备已开1)
      广播触点1 = AOA_手指按下(设备1, x, y)
    如果结束
    如果 (设备已开2)
      广播触点2 = AOA_手指按下(设备2, x, y)
    如果结束
    如果 (设备已开3)
      广播触点3 = AOA_手指按下(设备3, x, y)
    如果结束
    如果 (设备已开4)
      广播触点4 = AOA_手指按下(设备4, x, y)
    如果结束
  结束

  空 广播移动(整数型 x, 整数型 y)
    如果 (广播触点1 > 0)
      AOA_手指移动(设备1, 广播触点1, x, y)
    如果结束
    如果 (广播触点2 > 0)
      AOA_手指移动(设备2, 广播触点2, x, y)
    如果结束
    如果 (广播触点3 > 0)
      AOA_手指移动(设备3, 广播触点3, x, y)
    如果结束
    如果 (广播触点4 > 0)
      AOA_手指移动(设备4, 广播触点4, x, y)
    如果结束
  结束

  空 广播抬起()
    如果 (广播触点1 > 0)
      AOA_手指抬起(设备1, 广播触点1)
      广播触点1 = 0
    如果结束
    如果 (广播触点2 > 0)
      AOA_手指抬起(设备2, 广播触点2)
      广播触点2 = 0
    如果结束
    如果 (广播触点3 > 0)
      AOA_手指抬起(设备3, 广播触点3)
      广播触点3 = 0
    如果结束
    如果 (广播触点4 > 0)
      AOA_手指抬起(设备4, 广播触点4)
      广播触点4 = 0
    如果结束
  结束

  // 手动接收动作入口统一恢复自动发现（「全部断开」会挂起信标暂停）。
  空 信标恢复()
    信标暂停 = 假
  结束

私有:

  // 已消耗序列号判断（大小写不敏感）：MIUI/驱动层回报的序列号大小写不稳定，
  // 精确比较会让「已消耗排除」失效 → 自动分配逐槽重复打开同一台（2026-10-22 实锤）。
  逻辑型 已消耗(文本型 命中)
    局部 逻辑型 命中已用 = 假
    @ {
    @     命中已用 = (!已用序列号1.empty() && !_wcsicmp(命中.c_str(), 已用序列号1.c_str())) ||
    @                (!已用序列号2.empty() && !_wcsicmp(命中.c_str(), 已用序列号2.c_str())) ||
    @                (!已用序列号3.empty() && !_wcsicmp(命中.c_str(), 已用序列号3.c_str())) ||
    @                (!已用序列号4.empty() && !_wcsicmp(命中.c_str(), 已用序列号4.c_str()));
    @ }
    返回(命中已用)
  结束

结束功能库
