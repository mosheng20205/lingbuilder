// 群控库：USB 直传设备池——入池/打开队列/轮询巡游/帧落盘/HID 注入/群控广播。
// 2026-10-22 重写为 USB 专用版：删除 Wi-Fi（WS 收发/连接串/降级）与 UDP 51750 信标，
// 固定 4 槽改为「设备池」并行数组，槽号 = 本会话内首次见到该手机的顺序，拔线不清条目。
// 红线（沿用 + 新增）：
//   ① 带参数方法必须放功能库——窗口类「事件」声明不支持参数，生成器会丢参数。
//   ② 功能库内部互调必须带库名限定（群控库.xxx）。
//   ③ 函数签名必须单行（多行参数列表解析器会静默丢函数）。
//   ④ 带初始化的局部声明会被生成器整体提升到函数入口——初始化式只允许字面量或
//      「入参/全局的当场值」，循环内才有值的量一律「先声明、循环内赋值」。
//   ⑤ JSON_取文本 返回轮转缓冲裸指针，与字面量比较前必须先赋文本变量。
//   ⑥ AOA_数据通道收帧 超时不能传 0（libusb 0=永久等待会卡死界面）；手机侧发送端
//      在 PC 停止收帧时会阻塞，所有已开通道必须被轮询泵持续排水，不许只挑着收。
//   ⑦ AOA_打开设备 同步阻塞（普通模式切配件最长 45 秒）——只允许经 打开队列
//      一次一台串行打开，禁止多台并发。
功能库 群控库

公开:

  整数型 池数量()
    返回(数组_取成员数(池序列号))
  结束

  // 大小写不敏感找槽号（MIUI/驱动层回报的序列号大小写不稳定，精确比较会重复入池）。0=无。
  整数型 池查找(文本型 序列号)
    局部 整数型 总数 = 0
    局部 整数型 序号 = 0
    局部 文本型 已有 = ""
    局部 逻辑型 相等 = 假
    总数 = 数组_取成员数(池序列号)
    计次循环首 (总数, 序号)
      已有 = 数组_取成员(池序列号, 序号 - 1)
      @ { 相等 = (!序列号.empty() && !已有.empty() && _wcsicmp(序列号.c_str(), 已有.c_str()) == 0); }
      如果 (相等)
        返回(序号)
      如果结束
    计次循环尾 ()
    返回(0)
  结束

  // 入池并返回槽号；已存在只补名称。新条目用 数组_重定义 扩容（元素默认值：
  // 句柄 0、逻辑假、可见真、上次旋转 -1 需单独补写——可见默认真：页面未上报前全量写盘）。
  整数型 入池(文本型 序列号, 文本型 名称)
    局部 整数型 已有槽 = 0
    局部 整数型 新槽 = 0
    已有槽 = 群控库.池查找(序列号)
    如果 (已有槽 > 0)
      如果 (名称 <> "")
        数组_置成员(池名称, 已有槽 - 1, 名称)
      如果结束
      返回(已有槽)
    如果结束
    新槽 = 群控库.池数量() + 1
    数组_重定义(池设备, 新槽)
    数组_重定义(池序列号, 新槽)
    数组_重定义(池名称, 新槽)
    数组_重定义(池通道, 新槽)
    数组_重定义(池已开, 新槽)
    数组_重定义(池在传, 新槽)
    数组_重定义(池可见, 新槽)
    数组_重定义(池用甲帧, 新槽)
    数组_重定义(池有新帧, 新槽)
    数组_重定义(池帧宽, 新槽)
    数组_重定义(池帧高, 新槽)
    数组_重定义(池旋转, 新槽)
    数组_重定义(池上次旋转, 新槽)
    数组_重定义(池帧数, 新槽)
    数组_重定义(池上次写盘, 新槽)
    数组_重定义(池错误, 新槽)
    数组_重定义(池待重试, 新槽)
    数组_重定义(池重试跳过, 新槽)
    数组_重定义(池勾选, 新槽)
    数组_重定义(广播触点, 新槽)
    数组_置成员(池序列号, 新槽 - 1, 序列号)
    数组_置成员(池名称, 新槽 - 1, 名称)
    数组_置成员(池可见, 新槽 - 1, 真)
    数组_置成员(池上次旋转, 新槽 - 1, -1)
    文件_追加文本("viewer.log", "入池 槽" + 到文本(新槽) + " [" + 序列号 + "] " + 名称 + " |")
    返回(新槽)
  结束

  // ===== 打开队列 =====

  // 去重入队。已在队列的直接跳过；是否已开由 处理打开队列 前的调用方判定。
  空 入队(文本型 序列号)
    如果 (序列号 = "")
      返回()
    如果结束
    如果 (数组_查找(打开队列, 序列号) >= 0)
      返回()
    如果结束
    数组_加入成员(打开队列, 序列号)
  结束

  // 泵每拍一步：有冷却先耗冷却；队列非空则取队首串行打开一台（同步，秒级）。
  空 处理打开队列()
    局部 整数型 队列数 = 0
    局部 文本型 序列号 = ""
    如果 (打开冷却 > 0)
      打开冷却 = 打开冷却 - 1
      返回()
    如果结束
    队列数 = 数组_取成员数(打开队列)
    如果 (队列数 < 1)
      返回()
    如果结束
    序列号 = 数组_取成员(打开队列, 0)
    数组_删除成员(打开队列, 0)
    群控库.打开并接通(序列号)
    打开冷却 = 8
  结束

  // 打开一台手机并接通 USB 数据通道（HID 会话由 AOA_打开设备 一并建立）。
  空 打开并接通(文本型 序列号)
    局部 整数型 槽 = 0
    局部 AOA设备 新设备
    槽 = 群控库.池查找(序列号)
    如果 (槽 = 0)
      槽 = 群控库.入池(序列号, "")
    如果结束
    如果 (数组_取成员(池已开, 槽 - 1))
      群控库.补开通道(槽)
      返回()
    如果结束
    数组_置成员(池错误, 槽 - 1, "")
    // 消费待重试标志：打开尝试已发起，失败也不许巡检每 2 秒自动重试（手动点「接通」或再重插）
    数组_置成员(池待重试, 槽 - 1, 假)
    控件_设置文本(状态栏, "槽" + 到文本(槽) + " 接通中 [" + 序列号 + "]（普通模式机型切配件需数秒）")
    文件_追加文本("viewer.log", "槽" + 到文本(槽) + " open [" + 序列号 + "] |")
    新设备 = AOA_打开设备(序列号)
    如果 (新设备 = 0)
      局部 文本型 打开失败原因 = AOA_取错误()
      数组_置成员(池错误, 槽 - 1, 打开失败原因)
      // 分级自动重试：45 秒切换超时=机型拒绝切换（重试只会反复冻结 UI 45 秒）→ 置 -1 永不自动；
      // 其余（配件绑定 30 秒未完成等瞬时故障）→ 置 8，巡检按节流自动重试（驱动就绪即成）。
      如果 (文本_是否包含(打开失败原因, "45 秒"))
        数组_置成员(池重试跳过, 槽 - 1, -1)
      否则
        数组_置成员(池重试跳过, 槽 - 1, 8)
      如果结束
      文件_追加文本("viewer.log", "槽" + 到文本(槽) + " openfail " + 打开失败原因 + " 重试跳过=" + 到文本(数组_取成员(池重试跳过, 槽 - 1)) + " |")
      控件_设置文本(状态栏, "槽" + 到文本(槽) + " 打开失败：" + 打开失败原因)
      返回()
    如果结束
    数组_置成员(池设备, 槽 - 1, 新设备)
    数组_置成员(池已开, 槽 - 1, 真)
    AOA_设置屏幕旋转(新设备, 数组_取成员(池旋转, 槽 - 1))
    数组_置成员(池上次旋转, 槽 - 1, 数组_取成员(池旋转, 槽 - 1))
    群控库.补开通道(槽)
  结束

  // 已开会话补开数据通道（附着动作的幂等后半段）。
  空 补开通道(整数型 槽)
    局部 AOA设备 目标
    局部 长整数型 新通道 = 0
    如果 (数组_取成员(池已开, 槽 - 1) = 假)
      返回()
    如果结束
    如果 (数组_取成员(池通道, 槽 - 1) > 0)
      返回()
    如果结束
    目标 = 数组_取成员(池设备, 槽 - 1)
    新通道 = AOA_打开数据通道(目标, 1500)
    如果 (新通道 = 0)
      数组_置成员(池错误, 槽 - 1, "USB 通道未开：" + AOA_取错误())
      数组_置成员(池重试跳过, 槽 - 1, 8)
      文件_追加文本("viewer.log", "槽" + 到文本(槽) + " chfail " + AOA_取错误() + " |")
      控件_设置文本(状态栏, "槽" + 到文本(槽) + " USB 通道未开：" + AOA_取错误())
      返回()
    如果结束
    数组_置成员(池通道, 槽 - 1, 新通道)
    // MIUI/鸿蒙熄屏会暂停 MediaProjection：通道打通即先点亮，插线即出画面
    AOA_数据通道发帧(新通道, 字节集_从文本("{\"cmd\":\"wakeScreen\"}"))
    文件_追加文本("viewer.log", "槽" + 到文本(槽) + " ch=" + 到文本(新通道) + " |")
    控件_设置文本(状态栏, "槽" + 到文本(槽) + "（" + 数组_取成员(池名称, 槽 - 1) + "）已接通，等手机画面…")
  结束

  // 页面「接收全部」/磁贴「接通」的统一入口：指定序列号优先，其次按槽号入队。
  空 附着槽位(整数型 槽)
    如果 (槽 < 1 或 槽 > 群控库.池数量())
      返回()
    如果结束
    自动接入开 = 真
    如果 (数组_取成员(池已开, 槽 - 1))
      群控库.补开通道(槽)
      返回()
    如果结束
    数组_置成员(池错误, 槽 - 1, "")
    群控库.入队(数组_取成员(池序列号, 槽 - 1))
    控件_设置文本(状态栏, "槽" + 到文本(槽) + " 已排队接通（队列 " + 到文本(数组_取成员数(打开队列)) + " 台）")
  结束

  // 接收全部设备：指定序列号模式只接那一台；否则把当前设备列表里可接的全部入池入队。
  空 接收全部()
    局部 文本型 清单 = ""
    局部 文本型 行数组[]
    局部 文本型 字段[]
    局部 整数型 行数 = 0
    局部 整数型 字段数 = 0
    局部 整数型 行 = 0
    局部 整数型 排队 = 0
    局部 整数型 槽 = 0
    局部 文本型 行文本 = ""
    局部 文本型 序列号 = ""
    局部 文本型 产品 = ""
    局部 逻辑型 可接 = 假
    自动接入开 = 真
    如果 (指定序列号 <> "")
      群控库.入池(指定序列号, "")
      群控库.入队(指定序列号)
      控件_设置文本(状态栏, "已排队接通指定设备 " + 指定序列号)
      指定序列号 = ""
      返回()
    如果结束
    清单 = AOA_取设备列表()
    行数 = 文本_分割(清单, "\n", 行数组, 真)
    计次循环首 (行数, 行)
      行文本 = 数组_取成员(行数组, 行 - 1)
      字段数 = 文本_分割(行文本, "|", 字段, 真)
      如果 (字段数 >= 3)
        序列号 = 数组_取成员(字段, 0)
        产品 = 数组_取成员(字段, 1)
        可接 = 假
        如果 (数组_取成员(字段, 2) = "配件模式")
          如果 (字段数 >= 4)
            如果 (数组_取成员(字段, 3) = "可打开")
              可接 = 真
              // MIUI 配件描述符读不到序列号：产品名占位，模块侧走「唯一空序列号配件」兜底打开
              如果 (序列号 = "")
                序列号 = 产品
              如果结束
            如果结束
          如果结束
        如果结束
        如果 (数组_取成员(字段, 2) = "普通模式")
          如果 (序列号 <> "")
            可接 = 真
          如果结束
        如果结束
        如果 (可接)
          如果 (序列号 <> "")
            槽 = 群控库.池查找(序列号)
            如果 (槽 = 0)
              群控库.入池(序列号, 产品)
            否则
              如果 (数组_取成员(池已开, 槽 - 1) = 假)
                群控库.入池(序列号, 产品)
              如果结束
            如果结束
            // 未入池的入队；已开会话但数据通道未开的（打开成功、通道失败过的）也补队补通道
            如果 (槽 = 0 或 数组_取成员(池通道, 槽 - 1) = 0)
              群控库.入队(序列号)
              排队 = 排队 + 1
            如果结束
          如果结束
        如果结束
      如果结束
    计次循环尾 ()
    控件_设置文本(状态栏, "接收全部：排队 " + 到文本(排队) + " 台（逐台串行接通，普通模式机型每台约数秒）")
  结束

  // ===== 自动接入（插线即用）：泵低频巡检设备列表，新机入池入队，拔线标离线并清重试标记 =====

  逻辑型 已尝试包含(文本型 序列号)
    局部 整数型 总数 = 0
    局部 整数型 序号 = 0
    局部 文本型 已有 = ""
    局部 逻辑型 相等 = 假
    总数 = 数组_取成员数(已尝试序列号)
    计次循环首 (总数, 序号)
      已有 = 数组_取成员(已尝试序列号, 序号 - 1)
      @ { 相等 = (!序列号.empty() && !已有.empty() && _wcsicmp(序列号.c_str(), 已有.c_str()) == 0); }
      如果 (相等)
        返回(真)
      如果结束
    计次循环尾 ()
    返回(假)
  结束

  空 标记已尝试(文本型 序列号)
    如果 (群控库.已尝试包含(序列号) = 假)
      数组_加入成员(已尝试序列号, 序列号)
    如果结束
  结束

  空 清除已尝试(文本型 序列号)
    局部 整数型 总数 = 0
    局部 整数型 序号 = 0
    局部 文本型 已有 = ""
    局部 逻辑型 相等 = 假
    总数 = 数组_取成员数(已尝试序列号)
    计次循环首 (总数, 序号)
      已有 = 数组_取成员(已尝试序列号, 序号 - 1)
      @ { 相等 = (!序列号.empty() && !已有.empty() && _wcsicmp(序列号.c_str(), 已有.c_str()) == 0); }
      如果 (相等)
        数组_删除成员(已尝试序列号, 序号 - 1)
        返回()
      如果结束
    计次循环尾 ()
  结束

  // 泵低频调用（约 2 秒一次）：插线自动接入 + 拔线检测 + 接入障碍计数（调试态/缺驱动）。
  空 自动接入巡检()
    局部 文本型 清单 = ""
    局部 文本型 行数组[]
    局部 文本型 字段[]
    局部 文本型 视在序列号[]
    局部 整数型 行数 = 0
    局部 整数型 字段数 = 0
    局部 整数型 行 = 0
    局部 整数型 槽 = 0
    局部 整数型 总数 = 0
    局部 整数型 见数 = 0
    局部 整数型 见序 = 0
    局部 文本型 行文本 = ""
    局部 文本型 序列号 = ""
    局部 文本型 产品 = ""
    局部 文本型 池串 = ""
    局部 文本型 见串 = ""
    局部 逻辑型 可接 = 假
    局部 逻辑型 命中 = 假
    局部 逻辑型 相等 = 假
    如果 (自动接入开 = 假)
      返回()
    如果结束
    调试态台数 = 0
    缺驱动台数 = 0
    清单 = AOA_取设备列表()
    行数 = 文本_分割(清单, "\n", 行数组, 真)
    计次循环首 (行数, 行)
      行文本 = 数组_取成员(行数组, 行 - 1)
      字段数 = 文本_分割(行文本, "|", 字段, 真)
      如果 (字段数 >= 3)
        序列号 = 数组_取成员(字段, 0)
        产品 = 数组_取成员(字段, 1)
        可接 = 假
        如果 (数组_取成员(字段, 2) = "配件模式")
          如果 (字段数 >= 4)
            如果 (数组_取成员(字段, 3) = "可打开")
              可接 = 真
              如果 (序列号 = "")
                序列号 = 产品
              如果结束
            否则
              // 配件模式但驱动未绑（缺 WinUSB 驱动的全新机器，或被其他查看器实例占用）
              缺驱动台数 = 缺驱动台数 + 1
            如果结束
          如果结束
        如果结束
        如果 (数组_取成员(字段, 2) = "普通模式")
          如果 (序列号 <> "")
            可接 = 真
          否则
            如果 (产品 = "")
              // 普通模式+序列号产品名双空 = USB 调试开启的复合设备（FF48），
              // 免调试链路无法接管——用户视角就是「插了手机但零设备」，必须给提示
              调试态台数 = 调试态台数 + 1
            如果结束
          如果结束
        如果结束
        如果 (可接)
          如果 (序列号 <> "")
            数组_加入成员(视在序列号, 序列号)
            槽 = 群控库.池查找(序列号)
            如果 (槽 = 0)
              群控库.入池(序列号, 产品)
              群控库.入队(序列号)
              群控库.标记已尝试(序列号)
              EdgeView脚本_发送JSON消息(浏览器, "{\"event\":\"notify\",\"text\":\"发现新设备 " + 产品 + "，已排队接通\"}")
            否则
              // 已入池未开会话：自动重试分级——
              // ① 池待重试=真（会话判死/拔线过）→ 立即重接；
              // ② 池错误非空（上次打开失败，如配件绑定 30 秒未完成——驱动随后就绪即成）
              //    → 按池重试跳过节流自动重试（每 8 个巡检≈16 秒一次，防重试风暴）；
              //    45 秒切换超时（机型拒绝切换）已在打开失败时置跳过=-1，永不自动重试。
              // 红线：重插可能快于巡检周期，设备在列表里「从未消失」。
              如果 (数组_取成员(池已开, 槽 - 1) = 假)
                如果 (数组_取成员(池待重试, 槽 - 1))
                  群控库.入队(序列号)
                  文件_追加文本("viewer.log", "槽" + 到文本(槽) + " 待重试自动重接 [" + 序列号 + "] |")
                否则
                  如果 (数组_取成员(池错误, 槽 - 1) <> "")
                    如果 (数组_取成员(池重试跳过, 槽 - 1) > 0)
                      数组_置成员(池重试跳过, 槽 - 1, 数组_取成员(池重试跳过, 槽 - 1) - 1)
                    否则
                      如果 (数组_取成员(池重试跳过, 槽 - 1) = 0)
                        群控库.入队(序列号)
                        文件_追加文本("viewer.log", "槽" + 到文本(槽) + " 失败自动重试 [" + 序列号 + "] |")
                        数组_置成员(池重试跳过, 槽 - 1, 8)
                      如果结束
                    如果结束
                  如果结束
                如果结束
              如果结束
            如果结束
          如果结束
        如果结束
      如果结束
    计次循环尾 ()
    // 拔线检测：未开会话且序列号不在本次列表里的池条目 → 标离线 + 清重试标记（重插自动再试）
    总数 = 群控库.池数量()
    见数 = 数组_取成员数(视在序列号)
    计次循环首 (总数, 槽)
      如果 (数组_取成员(池已开, 槽 - 1) = 假)
        池串 = 数组_取成员(池序列号, 槽 - 1)
        命中 = 假
        计次循环首 (见数, 见序)
          见串 = 数组_取成员(视在序列号, 见序 - 1)
          @ { 相等 = (!池串.empty() && !见串.empty() && _wcsicmp(池串.c_str(), 见串.c_str()) == 0); }
          如果 (相等)
            命中 = 真
          如果结束
        计次循环尾 ()
        如果 (命中 = 假)
          如果 (数组_取成员(池错误, 槽 - 1) <> "USB 已拔出")
            数组_置成员(池错误, 槽 - 1, "USB 已拔出")
            群控库.清除已尝试(池串)
            文件_追加文本("viewer.log", "槽" + 到文本(槽) + " 拔线 [" + 池串 + "] |")
          如果结束
          数组_置成员(池待重试, 槽 - 1, 真)
        如果结束
      如果结束
    计次循环尾 ()
    // 接入障碍上状态栏（页面横幅经状态 JSON 的 debugCount/drvCount 展示，这里兜底原生可见）
    如果 (调试态台数 > 0 或 缺驱动台数 > 0)
      控件_设置文本(状态栏, "接入障碍：USB 调试开启 " + 到文本(调试态台数) + " 台（手机上关闭「USB 调试」后重插）、缺 WinUSB 驱动 " + 到文本(缺驱动台数) + " 台（装随包 driver 驱动），详见「安装指引」")
    如果结束
  结束

  // ===== 泵：每拍由窗口事件 轮询泵 调用一次 =====

  空 泵一拍()
    当前毫秒 = 0
    @ 当前毫秒 = (long long)GetTickCount64();
    群控库.处理打开队列()
    巡检节流 = 巡检节流 + 1
    如果 (巡检节流 >= 128)
      巡检节流 = 0
      群控库.自动接入巡检()
    如果结束
    群控库.轮询预算巡游()
    状态节流 = 状态节流 + 1
    如果 (状态节流 >= 32)
      状态节流 = 0
      EdgeView脚本_发送JSON消息(浏览器, "{\"event\":\"status\",\"data\":" + 群控库.状态JSON() + "}")
    如果结束
  结束

  // 轮询预算巡游：每拍最多排空 16 个通道（空轮询一次约 1ms，预算防止大池子拖死 UI 线程），
  // 泵游标轮转保证每台手机都被持续排水（手机侧发送端在 PC 停止收帧时会阻塞）。
  空 轮询预算巡游()
    局部 整数型 总数 = 0
    局部 整数型 已访 = 0
    局部 整数型 步 = 0
    局部 整数型 槽 = 0
    总数 = 群控库.池数量()
    如果 (总数 < 1)
      返回()
    如果结束
    如果 (泵游标 < 1 或 泵游标 > 总数)
      泵游标 = 1
    如果结束
    计次循环首 (总数, 步)
      槽 = 泵游标 + 步 - 1
      如果 (槽 > 总数)
        槽 = 槽 - 总数
      如果结束
      如果 (数组_取成员(池通道, 槽 - 1) > 0)
        群控库.轮询槽(槽)
        已访 = 已访 + 1
        如果 (已访 >= 16)
          泵游标 = 槽 + 1
          如果 (泵游标 > 总数)
            泵游标 = 1
          如果结束
          返回()
        如果结束
      如果结束
    计次循环尾 ()
    泵游标 = 1
  结束

  // 单槽排水：最多 8 帧/次（爆发帧分摊到后续拍），坏会话交给 池掉线。
  空 轮询槽(整数型 槽)
    局部 长整数型 通道 = 0
    局部 字节集 帧 = 字节集_从文本("")
    局部 整数型 帧长 = 0
    局部 文本型 失败原因 = ""
    局部 整数型 次 = 0
    通道 = 数组_取成员(池通道, 槽 - 1)
    计次循环首 (8, 次)
      帧 = AOA_数据通道收帧(通道, 1)
      帧长 = 字节集_长度(帧)
      如果 (帧长 < 1)
        // 成功与超时都会清空错误通道，非空 = 这条通道真的坏了（设备拔出/重枚举）
        失败原因 = AOA_取错误()
        如果 (失败原因 <> "")
          群控库.池掉线(槽, 失败原因)
        如果结束
        跳出循环
      如果结束
      如果 (字节集_取字节(帧, 0) = 255)
        // JPEG 帧头 FF D8：视频帧；过小的载荷是协议残片，丢弃但算有活动
        如果 (帧长 > 1024)
          群控库.存槽帧(槽, 帧)
        如果结束
      否则
        群控库.处理槽控制JSON(槽, 帧)
      如果结束
    计次循环尾 ()
  结束

  // ===== 帧 =====

  // USB 视频帧落盘：可视槽每帧都写；不可视槽 2 秒一帧节流（几百台并发时磁盘与轮询都扛不住全量）。
  // 排水不计节流——帧计数照加，只省写盘。
  空 存槽帧(整数型 槽, 字节集 帧数据)
    数组_置成员(池帧数, 槽 - 1, 数组_取成员(池帧数, 槽 - 1) + 1)
    当前毫秒 = 0
    @ 当前毫秒 = (long long)GetTickCount64();
    如果 (数组_取成员(池可见, 槽 - 1) = 假)
      如果 (当前毫秒 - 数组_取成员(池上次写盘, 槽 - 1) < 2000)
        返回()
      如果结束
    如果结束
    数组_置成员(池上次写盘, 槽 - 1, 当前毫秒)
    // 帧图一律按 帧基址（exe 目录，创建完毕时定好）绝对路径落盘：
    // CWD 随启动方变化（Bridge 拉起≠手动拉起），相对路径会把帧写散到各处，页面却只认 exe 目录
    如果 (数组_取成员(池用甲帧, 槽 - 1))
      群控库.写帧文件(帧基址 + "/aoa_d" + 到文本(槽) + "_1.jpg", 帧数据)
      数组_置成员(池用甲帧, 槽 - 1, 假)
    否则
      群控库.写帧文件(帧基址 + "/aoa_d" + 到文本(槽) + "_0.jpg", 帧数据)
      数组_置成员(池用甲帧, 槽 - 1, 真)
    如果结束
    数组_置成员(池有新帧, 槽 - 1, 真)
    如果 (数组_取成员(池在传, 槽 - 1) = 假)
      数组_置成员(池在传, 槽 - 1, 真)
      控件_设置文本(状态栏, "槽" + 到文本(槽) + "（" + 数组_取成员(池名称, 槽 - 1) + "）USB 直传中")
    如果结束
  结束

  空 写帧文件(文本型 路径, 字节集 帧数据)
    局部 文件号 号
    号 = 文件_打开(路径, 4, 1)
    如果 (号 > 0)
      文件_写出字节集(号, 帧数据)
      文件_关闭(号)
    如果结束
  结束

  // 双缓冲里「最新完整帧」的文件路径（与页面 flip 位对齐：假→最新在 _1，真→最新在 _0）。
  // 绝对路径 = 帧基址（exe 目录），与页面读帧地址、写盘地址三方一致。
  文本型 取槽帧文件(整数型 槽)
    如果 (数组_取成员(池用甲帧, 槽 - 1))
      返回(帧基址 + "/aoa_d" + 到文本(槽) + "_0.jpg")
    如果结束
    返回(帧基址 + "/aoa_d" + 到文本(槽) + "_1.jpg")
  结束

  // 读整个文件为字节集（上限 4MB，帧 JPEG 与小模板都够用）；打不开返回空字节集。
  字节集 读文件字节集(文本型 路径)
    局部 文件号 号
    局部 字节集 数据 = 字节集_从文本("")
    号 = 文件_打开(路径, 1, 1)
    如果 (号 > 0)
      数据 = 文件_读入字节集(号, 4 * 1024 * 1024)
      文件_关闭(号)
    如果结束
    返回(数据)
  结束

  // 字节集 → 文本（UTF-8 解码，走缓冲区模块；控制 JSON 与回执都是 UTF-8）。
  文本型 字节集转文本(字节集 数据)
    局部 长整数型 缓冲 = 0
    局部 文本型 结果 = ""
    缓冲 = 缓冲区_创建(0)
    缓冲区_写字节集(缓冲, 数据)
    缓冲区_重置读取(缓冲)
    结果 = 缓冲区_读文本(缓冲, -1)
    缓冲区_销毁(缓冲)
    返回(结果)
  结束

  // 数据通道上的控制 JSON：env 心跳（width/height/rotation）与指令回执；
  // screenInfo/screenChanged（v1.4.0 坐标回映射协议）交给坐标映射库认领。
  // 指令回执（{"type":"result","cmd":..,"ok":..,"error":..}）必须上屏：launchApp 被
  // 系统拦截（BAL/MIUI 后台弹出界面）时手机端会回中文错误，静默丢弃=用户端黑洞。
  空 处理槽控制JSON(整数型 槽, 字节集 帧)
    局部 文本型 文本 = ""
    局部 整数型 新宽 = 0
    局部 整数型 新高 = 0
    局部 整数型 新旋转 = -1
    局部 文本型 回执类型 = ""
    局部 文本型 回执命令 = ""
    局部 文本型 回执错误 = ""
    文本 = 群控库.字节集转文本(帧)
    坐标映射.屏幕_处理消息(槽, 文本)
    新宽 = JSON_取整数(文本, "width", 0)
    新高 = JSON_取整数(文本, "height", 0)
    新旋转 = JSON_取整数(文本, "rotation", -1)
    回执类型 = JSON_取文本(文本, "type")
    如果 (回执类型 = "result")
      回执命令 = JSON_取文本(文本, "cmd")
      回执错误 = JSON_取文本(文本, "error")
      // 双引号转单引号再拼 notify JSON（错误文案里出现引号会破坏 JSON 结构）
      回执错误 = 文本_替换(回执错误, "\"", "'")
      文件_追加文本("viewer.log", "槽" + 到文本(槽) + " 回执 [" + 回执命令 + "] " + 群控库.逻辑文本(回执错误 = "") + " " + 回执错误 + " |")
      如果 (回执错误 <> "")
        控件_设置文本(状态栏, "槽" + 到文本(槽) + " 指令「" + 回执命令 + "」失败：" + 回执错误)
        EdgeView脚本_发送JSON消息(浏览器, "{\"event\":\"notify\",\"text\":\"槽" + 到文本(槽) + " 指令「" + 回执命令 + "」失败：" + 回执错误 + "\",\"ok\":false}")
      否则
        // 成功也上屏：否则旧失败提示残留会被误当成本次结果（设置能开但横幅还是小红书旧错的实例）
        控件_设置文本(状态栏, "槽" + 到文本(槽) + " 指令「" + 回执命令 + "」已执行")
        EdgeView脚本_发送JSON消息(浏览器, "{\"event\":\"notify\",\"text\":\"槽" + 到文本(槽) + " 指令「" + 回执命令 + "」已执行成功\",\"ok\":true}")
      如果结束
    如果结束
    // 应用列表（APK 1.4.6 listApps 应答）：原样转发给页面填充启动App下拉
    如果 (回执类型 = "appList")
      EdgeView脚本_发送JSON消息(浏览器, "{\"event\":\"appList\",\"json\":\"" + 文本_替换(文本, "\"", "'") + "\"}")
    如果结束
    如果 (新宽 > 0)
      数组_置成员(池帧宽, 槽 - 1, 新宽)
    如果结束
    如果 (新高 > 0)
      数组_置成员(池帧高, 槽 - 1, 新高)
    如果结束
    如果 (新旋转 >= 0)
      数组_置成员(池旋转, 槽 - 1, 新旋转)
    如果结束
  结束

  // 池条目 USB 自愈：设备拔出/重枚举后模块把会话判死，关掉通道与设备句柄、条目退回
  // 「未连接」（序列号条目保留，页面磁贴不漂移）；拔线巡检会清重试标记，重插自动再接。
  空 池掉线(整数型 槽, 文本型 原因)
    局部 长整数型 通道 = 0
    局部 AOA设备 目标
    通道 = 数组_取成员(池通道, 槽 - 1)
    如果 (通道 > 0)
      AOA_关闭数据通道(通道)
    如果结束
    数组_置成员(池通道, 槽 - 1, 0)
    数组_置成员(池在传, 槽 - 1, 假)
    如果 (数组_取成员(池已开, 槽 - 1))
      目标 = 数组_取成员(池设备, 槽 - 1)
      AOA_关闭设备(目标)
      数组_置成员(池已开, 槽 - 1, 假)
    如果结束
    数组_置成员(池错误, 槽 - 1, 原因)
    // 会话死了：置待重试标志，巡检见到设备在列表里（快速重插未消失）即自动重新入队
    数组_置成员(池待重试, 槽 - 1, 真)
    文件_追加文本("viewer.log", "槽" + 到文本(槽) + " 掉线 " + 原因 + " |")
    控件_设置文本(状态栏, "槽" + 到文本(槽) + " USB 已断开：" + 原因 + "（重插后自动重接）")
  结束

  // ===== 指令与批量动作 =====

  // 给指定槽下发控制指令 JSON（USB 数据通道；通道未开静默丢弃）。
  空 发槽指令(整数型 槽, 文本型 指令JSON)
    局部 长整数型 通道 = 0
    如果 (槽 < 1 或 槽 > 群控库.池数量())
      返回()
    如果结束
    通道 = 数组_取成员(池通道, 槽 - 1)
    如果 (通道 > 0)
      AOA_数据通道发帧(通道, 字节集_从文本(指令JSON))
    如果结束
  结束

  // 批量唤醒：MIUI/鸿蒙熄屏会暂停 MediaProjection，先点亮再投。
  空 批量唤醒()
    局部 整数型 总数 = 0
    局部 整数型 序号 = 0
    局部 长整数型 通道 = 0
    总数 = 群控库.池数量()
    计次循环首 (总数, 序号)
      通道 = 数组_取成员(池通道, 序号 - 1)
      如果 (通道 > 0)
        // 勾选分组作用到全部批量动作：勾选集合非空时只作用于勾选∩已接通
        如果 (群控库.在广播集合(序号))
          AOA_数据通道发帧(通道, 字节集_从文本("{\"cmd\":\"wakeScreen\"}"))
        如果结束
      如果结束
    计次循环尾 ()
  结束

  // 隐藏手势：点状态N = 从该手机屏幕顶部下滑拉出通知栏（放行 MIUI/鸿蒙的
  // 「已拦截 USB 输入设备」提示）。仅该槽设备已接通时有效。
  逻辑型 下拉通知栏(整数型 槽)
    局部 AOA设备 目标
    如果 (槽 < 1 或 槽 > 群控库.池数量())
      返回(假)
    如果结束
    如果 (数组_取成员(池已开, 槽 - 1) = 假)
      返回(假)
    如果结束
    目标 = 数组_取成员(池设备, 槽 - 1)
    返回(AOA_滑动(目标, 16383, 300, 16383, 26000, 350))
  结束

  // 截图：当前最新帧复制为 截图_槽N_时间戳.jpg（存 exe 同目录）。
  空 截取槽画面(整数型 槽)
    局部 文本型 帧文件 = ""
    帧文件 = 群控库.取槽帧文件(槽)
    如果 (帧文件 = "" 或 文件_是否存在(帧文件) = 假)
      返回()
    如果结束
    文件_复制(帧文件, "截图_槽" + 到文本(槽) + "_" + 到文本(截图计数) + ".jpg", 真)
    截图计数 = 截图计数 + 1
  结束

  // ===== 手势（单槽）：按下=手指按下，移动=距离节流后手指移动，抬起=手指抬起 =====

  逻辑型 手势按下(整数型 槽, 整数型 x, 整数型 y)
    局部 长整数型 新触点 = 0
    局部 AOA设备 目标
    如果 (手势槽 <> 0)
      群控库.手势抬起(手势槽)
    如果结束
    如果 (x < 0 或 x > 32767 或 y < 0 或 y > 32767)
      返回(假)
    如果结束
    如果 (槽 < 1 或 槽 > 群控库.池数量())
      返回(假)
    如果结束
    如果 (数组_取成员(池已开, 槽 - 1) = 假)
      控件_设置文本(状态栏, "槽" + 到文本(槽) + "：触控未接通（点磁贴「接通」按钮）")
      返回(假)
    如果结束
    群控库.同步槽旋转(槽)
    目标 = 数组_取成员(池设备, 槽 - 1)
    新触点 = AOA_手指按下(目标, x, y)
    如果 (新触点 = 0)
      控件_设置文本(状态栏, "槽" + 到文本(槽) + " 手势按下失败：" + AOA_取错误())
      返回(假)
    如果结束
    手势槽 = 槽
    手势触点 = 新触点
    手势上次横 = x
    手势上次纵 = y
    返回(真)
  结束

  // 手势移动：曼哈顿距离 ≥500（约屏宽 1.5%）才真正下发，兼顾 USB 吞吐与滑动连续性。
  逻辑型 手势移动(整数型 槽, 整数型 x, 整数型 y)
    局部 整数型 差横 = 0
    局部 整数型 差纵 = 0
    局部 整数型 钳x = 0
    局部 整数型 钳y = 0
    局部 AOA设备 目标
    如果 (手势槽 <> 槽 或 手势触点 < 1)
      返回(假)
    如果结束
    钳x = x
    钳y = y
    如果 (钳x < 0)
      钳x = 0
    如果结束
    如果 (钳x > 32767)
      钳x = 32767
    如果结束
    如果 (钳y < 0)
      钳y = 0
    如果结束
    如果 (钳y > 32767)
      钳y = 32767
    如果结束
    差横 = 钳x - 手势上次横
    如果 (差横 < 0)
      差横 = 0 - 差横
    如果结束
    差纵 = 钳y - 手势上次纵
    如果 (差纵 < 0)
      差纵 = 0 - 差纵
    如果结束
    如果 (差横 + 差纵 < 500)
      返回(真)
    如果结束
    目标 = 数组_取成员(池设备, 槽 - 1)
    AOA_手指移动(目标, 手势触点, 钳x, 钳y)
    手势上次横 = 钳x
    手势上次纵 = 钳y
    返回(真)
  结束

  // 手势抬起：结束触摸并清状态。
  逻辑型 手势抬起(整数型 槽)
    局部 AOA设备 目标
    如果 (手势槽 <> 槽)
      返回(假)
    如果结束
    目标 = 数组_取成员(池设备, 槽 - 1)
    AOA_手指抬起(目标, 手势触点)
    手势槽 = 0
    手势触点 = 0
    返回(真)
  结束

  // 手势进行中收到 Click 一律吞（按下+抬起已构成完整触摸，不能再来一发 AOA_单击）。
  逻辑型 吞槽点击(整数型 槽)
    如果 (手势槽 = 槽)
      返回(真)
    如果结束
    返回(假)
  结束

  // 手机实际方向与上次声明不同步时重新声明（点击与手势共用）。
  空 同步槽旋转(整数型 槽)
    局部 整数型 槽旋转 = 0
    局部 整数型 槽上次 = -1
    局部 AOA设备 目标
    如果 (槽 < 1 或 槽 > 群控库.池数量())
      返回()
    如果结束
    槽旋转 = 数组_取成员(池旋转, 槽 - 1)
    槽上次 = 数组_取成员(池上次旋转, 槽 - 1)
    如果 (槽旋转 <> 槽上次)
      目标 = 数组_取成员(池设备, 槽 - 1)
      AOA_设置屏幕旋转(目标, 槽旋转)
      数组_置成员(池上次旋转, 槽 - 1, 槽旋转)
    如果结束
  结束

  // 用当前 触点横/触点纵 全局值直接向指定槽注入 HID 单击（找图点击等程序化点击共用）。
  逻辑型 注入槽点击(整数型 槽)
    局部 AOA设备 目标
    如果 (槽 < 1 或 槽 > 群控库.池数量())
      返回(假)
    如果结束
    如果 (数组_取成员(池已开, 槽 - 1) = 假)
      控件_设置文本(状态栏, "槽" + 到文本(槽) + "：注入点击需要先接通触控")
      返回(假)
    如果结束
    群控库.同步槽旋转(槽)
    目标 = 数组_取成员(池设备, 槽 - 1)
    如果 (AOA_单击(目标, 触点横, 触点纵))
      返回(真)
    如果结束
    控件_设置文本(状态栏, "槽" + 到文本(槽) + " 注入点击失败：" + AOA_取错误())
    返回(假)
  结束

  // ===== 返回键 / 文本输入（路线图 #3/#4）=====

  // 返回键：经 AOA 多媒体键（Consumer 页 0x224=返回，十进制 548）注入，
  // 替代 APK 未实现的 goBack 指令（磁贴「返回」旧路径发 goBack 会被手机静默忽略）。
  逻辑型 返回键(整数型 槽)
    局部 AOA设备 目标
    如果 (槽 < 1 或 槽 > 群控库.池数量())
      返回(假)
    如果结束
    如果 (数组_取成员(池已开, 槽 - 1) = 假)
      控件_设置文本(状态栏, "槽" + 到文本(槽) + "：触控未接通，点磁贴「接通」")
      返回(假)
    如果结束
    群控库.同步槽旋转(槽)
    目标 = 数组_取成员(池设备, 槽 - 1)
    如果 (AOA_多媒体键(目标, 548))
      控件_设置文本(状态栏, "槽" + 到文本(槽) + " 已发返回键")
      返回(真)
    如果结束
    控件_设置文本(状态栏, "槽" + 到文本(槽) + " 返回键失败：" + AOA_取错误())
    返回(假)
  结束

  // 文本输入：向目标槽（广播全部=真 时向全部已接通槽位）逐字符注入 ASCII 文本，
  // 穿透输入法直达当前聚焦输入框。返回成功台数；单台失败只记日志不打断广播。
  整数型 输入文本到池(整数型 槽, 文本型 内容, 逻辑型 广播全部)
    局部 整数型 总数 = 0
    局部 整数型 序号 = 0
    局部 AOA设备 目标
    局部 整数型 成功台数 = 0
    局部 逻辑型 本台 = 假
    总数 = 群控库.池数量()
    计次循环首 (总数, 序号)
      如果 (数组_取成员(池已开, 序号 - 1))
        本台 = 假
        如果 (广播全部)
          如果 (群控库.在广播集合(序号))
            本台 = 真
          如果结束
        否则
          如果 (序号 = 槽)
            本台 = 真
          如果结束
        如果结束
        如果 (本台)
          目标 = 数组_取成员(池设备, 序号 - 1)
          如果 (AOA_键盘输入(目标, 内容))
            成功台数 = 成功台数 + 1
          否则
            文件_追加文本("viewer.log", "槽" + 到文本(序号) + " 输入文本失败 " + AOA_取错误() + " |")
          如果结束
        如果结束
      如果结束
    计次循环尾 ()
    返回(成功台数)
  结束

  // ===== 录制回放（路线图 #5）：AOA_开始录制 进程级单例 + 按池异步回放 =====

  逻辑型 录制开始()
    如果 (AOA_开始录制("群控剧本.csv") = 假)
      控件_设置文本(状态栏, "录制启动失败：" + AOA_取错误())
      返回(假)
    如果结束
    控件_设置文本(状态栏, "录制中：在磁贴上做操作，所有注入动作会写进 群控剧本.csv（再点一次停止）")
    文件_追加文本("viewer.log", "录制开始 |")
    返回(真)
  结束

  逻辑型 录制停止()
    AOA_停止录制()
    控件_设置文本(状态栏, "录制已停止，剧本存 群控剧本.csv（exe 目录）——点「回放」批量执行")
    文件_追加文本("viewer.log", "录制停止 |")
    返回(真)
  结束

  // 对全部已接通槽位发起同一份剧本的异步回放（每台一个后台任务）。
  整数型 回放到池(文本型 剧本路径, 整数型 倍速, 整数型 循环次数)
    局部 整数型 总数 = 0
    局部 整数型 序号 = 0
    局部 AOA设备 目标
    局部 整数型 启动台数 = 0
    总数 = 群控库.池数量()
    计次循环首 (总数, 序号)
      如果 (数组_取成员(池已开, 序号 - 1))
        如果 (群控库.在广播集合(序号))
          目标 = 数组_取成员(池设备, 序号 - 1)
          如果 (AOA_异步回放(目标, 剧本路径, 倍速, 循环次数))
            启动台数 = 启动台数 + 1
          否则
            文件_追加文本("viewer.log", "槽" + 到文本(序号) + " 回放启动失败 " + AOA_取错误() + " |")
          如果结束
        如果结束
      如果结束
    计次循环尾 ()
    文件_追加文本("viewer.log", "回放启动 " + 到文本(启动台数) + " 台 倍速" + 到文本(倍速) + " 循环" + 到文本(循环次数) + " |")
    返回(启动台数)
  结束

  // 抽样读第一台已接通槽位的回放状态（进度快照；全部完成/失败时返回 假）。
  逻辑型 回放进行中(文本型 结果文本)
    局部 整数型 总数 = 0
    局部 整数型 序号 = 0
    局部 AOA设备 目标
    局部 文本型 状态 = ""
    结果文本 = ""
    总数 = 群控库.池数量()
    计次循环首 (总数, 序号)
      如果 (数组_取成员(池已开, 序号 - 1))
        目标 = 数组_取成员(池设备, 序号 - 1)
        状态 = AOA_取回放状态(目标)
        如果 (状态 <> "")
          如果 (结果文本 = "")
            结果文本 = 状态
          如果结束
          // 还有未结束的任务 → 进行中
          如果 (文本_是否包含(状态, "回放中"))
            返回(真)
          如果结束
        如果结束
      如果结束
    计次循环尾 ()
    返回(假)
  结束

  // ===== 同步操控（群控广播）：手势三段广播到已接通触控的槽位 =====
  // 红线：广播不经 手势按下/手势抬起（单组 手势槽/手势触点 会被多指互踩），每槽独立触点 ID。
  // 目标集合：页面勾选集合（syncSet）非空时只广播勾选槽位，否则广播全部已接通（勾选已设置=假）。

  // 槽号是否在当前广播目标集合内（勾选未设置=全部；已设置=只看 池勾选）。
  逻辑型 在广播集合(整数型 槽)
    如果 (勾选已设置 = 假)
      返回(真)
    如果结束
    如果 (槽 < 1 或 槽 > 群控库.池数量())
      返回(假)
    如果结束
    返回(数组_取成员(池勾选, 槽 - 1))
  结束

  空 广播按下(整数型 x, 整数型 y)
    局部 整数型 总数 = 0
    局部 整数型 序号 = 0
    局部 AOA设备 目标
    局部 长整数型 触点 = 0
    总数 = 群控库.池数量()
    计次循环首 (总数, 序号)
      如果 (数组_取成员(池已开, 序号 - 1))
        如果 (群控库.在广播集合(序号))
          目标 = 数组_取成员(池设备, 序号 - 1)
          触点 = AOA_手指按下(目标, x, y)
          数组_置成员(广播触点, 序号 - 1, 触点)
        如果结束
      如果结束
    计次循环尾 ()
  结束

  空 广播移动(整数型 x, 整数型 y)
    局部 整数型 总数 = 0
    局部 整数型 序号 = 0
    局部 AOA设备 目标
    总数 = 群控库.池数量()
    计次循环首 (总数, 序号)
      如果 (数组_取成员(广播触点, 序号 - 1) > 0)
        如果 (群控库.在广播集合(序号))
          目标 = 数组_取成员(池设备, 序号 - 1)
          AOA_手指移动(目标, 数组_取成员(广播触点, 序号 - 1), x, y)
        如果结束
      如果结束
    计次循环尾 ()
  结束

  空 广播抬起()
    局部 整数型 总数 = 0
    局部 整数型 序号 = 0
    局部 AOA设备 目标
    总数 = 群控库.池数量()
    计次循环首 (总数, 序号)
      如果 (数组_取成员(广播触点, 序号 - 1) > 0)
        目标 = 数组_取成员(池设备, 序号 - 1)
        AOA_手指抬起(目标, 数组_取成员(广播触点, 序号 - 1))
        数组_置成员(广播触点, 序号 - 1, 0)
      如果结束
    计次循环尾 ()
  结束

  // ===== WebUI 状态 =====

  // 全池状态 JSON：页面按 slot 增量建磁贴、就地刷新文本/徽章/flip。
  文本型 状态JSON()
    局部 文本型 JSON = ""
    局部 整数型 总数 = 0
    局部 整数型 序号 = 0
    局部 文本型 名称 = ""
    局部 文本型 序列号 = ""
    局部 文本型 错误 = ""
    总数 = 群控库.池数量()
    JSON = "{\"queue\":" + 到文本(数组_取成员数(打开队列)) + ",\"auto\":" + 群控库.逻辑文本(自动接入开) + ",\"debugCount\":" + 到文本(调试态台数) + ",\"drvCount\":" + 到文本(缺驱动台数) + ",\"slots\":["
    计次循环首 (总数, 序号)
      名称 = 文本_替换(数组_取成员(池名称, 序号 - 1), "\"", "'")
      序列号 = 文本_替换(数组_取成员(池序列号, 序号 - 1), "\"", "'")
      错误 = 文本_替换(数组_取成员(池错误, 序号 - 1), "\"", "'")
      如果 (序号 > 1)
        JSON = JSON + ","
      如果结束
      JSON = JSON + "{\"slot\":" + 到文本(序号) + ",\"name\":\"" + 名称 + "\",\"sn\":\"" + 序列号 + "\",\"usb\":" + 群控库.逻辑文本(数组_取成员(池通道, 序号 - 1) > 0) + ",\"frames\":" + 到文本(数组_取成员(池帧数, 序号 - 1)) + ",\"w\":" + 到文本(数组_取成员(池帧宽, 序号 - 1)) + ",\"h\":" + 到文本(数组_取成员(池帧高, 序号 - 1)) + ",\"rot\":" + 到文本(数组_取成员(池旋转, 序号 - 1)) + ",\"flip\":" + 群控库.逻辑文本(数组_取成员(池用甲帧, 序号 - 1)) + ",\"err\":\"" + 错误 + "\"}"
    计次循环尾 ()
    JSON = JSON + "]}"
    返回(JSON)
  结束

  文本型 逻辑文本(逻辑型 值)
    如果 (值)
      返回("true")
    如果结束
    返回("false")
  结束

  // 全部断开：关闭所有通道与设备、清空队列与重试标记并挂起自动接入
  //（否则在投的手机会被巡检立刻重新接回，「断开」变成假动作）；点「接收全部」/磁贴「接通」恢复。
  空 断开全部()
    局部 整数型 总数 = 0
    局部 整数型 序号 = 0
    局部 长整数型 通道 = 0
    局部 AOA设备 目标
    总数 = 群控库.池数量()
    计次循环首 (总数, 序号)
      通道 = 数组_取成员(池通道, 序号 - 1)
      如果 (通道 > 0)
        AOA_关闭数据通道(通道)
        数组_置成员(池通道, 序号 - 1, 0)
      如果结束
      数组_置成员(池在传, 序号 - 1, 假)
      数组_置成员(池待重试, 序号 - 1, 假)
      数组_置成员(池重试跳过, 序号 - 1, 0)
      如果 (数组_取成员(池已开, 序号 - 1))
        目标 = 数组_取成员(池设备, 序号 - 1)
        AOA_关闭设备(目标)
        数组_置成员(池已开, 序号 - 1, 假)
      如果结束
    计次循环尾 ()
    数组_清空(打开队列)
    数组_清空(已尝试序列号)
    自动接入开 = 假
    控件_设置文本(状态栏, "已全部断开；自动接入已挂起，点「接收全部」恢复")
    文件_追加文本("viewer.log", "全部断开 |")
  结束

结束功能库
