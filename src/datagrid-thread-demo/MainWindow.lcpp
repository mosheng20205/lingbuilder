包 数据表格多线程示例
使用 Win32窗口基础模块
使用 Win32高级控件模块
使用 多线程模块
使用 文本处理模块
使用 数组操作模块

// 演示要点：
// 1. 工作线程只做耗时模拟并通过 线程_报告进度 上报，绝不直接调用 表格_* 命令；
// 2. 进度处理器与完成处理器由线程模块封送回界面线程执行，在这里写表格才安全；
// 3. 选择框（checkbox）列支持 表格_取勾选行数 / 表格_取勾选行键 / 表格_删除勾选行 批量能力。
类 MainWindow : 公开 窗体
    逻辑型 任务进行中 = 假
    整数型 下一个行号 = 31
    线程任务 当前任务

    事件 _MainWindow_创建完毕()
        表格_设置进度范围(任务表格, "progress", 0, 100, 真)
        表格_开始批量更新(任务表格)
        局部 整数型 i = 0
        计次循环首 (30, i)
            表格_添加行(任务表格, "row-" + 到文本(i), "0\t任务-" + 到文本(i) + "\t0\t等待中")
        计次循环尾 ()
        表格_结束批量更新(任务表格)
        控件_设置文本(状态行, "状态：就绪，共 30 行演示数据。点击「启动多线程任务」开始。")
        控件_设置文本(勾选信息, "勾选：0 行")
    结束

    事件 _启动任务按钮_被单击()
        如果 (任务进行中)
            控件_设置文本(状态行, "状态：已有任务在进行中，请等它完成。")
            返回
        如果结束
        任务进行中 = 真
        控件_设置文本(状态行, "状态：工作线程已启动，逐行模拟耗时任务；进度合并后回界面线程写入表格。")
        当前任务 = 线程_提交进度(&模拟行任务, &行进度回写, &全部完成, 30, 120)
    结束

    事件 _勾选演示行按钮_被单击()
        表格_置逻辑(任务表格, "row-1", "select", 真)
        表格_置逻辑(任务表格, "row-2", "select", 真)
        表格_置逻辑(任务表格, "row-3", "select", 真)
        更新勾选信息()
        控件_设置文本(状态行, "状态：已勾选 row-1、row-2、row-3，可点「删除勾选行」体验批量删除。")
    结束

    事件 _全选按钮_被单击()
        局部 整数型 i = 0
        计次循环首 (表格_取行数(任务表格), i)
            表格_置逻辑(任务表格, 表格_取显示行键(任务表格, i - 1), "select", 真)
        计次循环尾 ()
        更新勾选信息()
    结束

    事件 _全不选按钮_被单击()
        局部 整数型 i = 0
        计次循环首 (表格_取行数(任务表格), i)
            表格_置逻辑(任务表格, 表格_取显示行键(任务表格, i - 1), "select", 假)
        计次循环尾 ()
        更新勾选信息()
    结束

    事件 _删除勾选行按钮_被单击()
        局部 整数型 勾选数 = 0
        局部 文本型 首个键 = ""
        勾选数 = 表格_取勾选行数(任务表格, "select")
        如果 (勾选数 == 0)
            控件_设置文本(状态行, "状态：当前没有勾选行，先勾选再删除。")
            返回
        如果结束
        首个键 = 表格_取勾选行键(任务表格, "select", 0)
        表格_删除勾选行(任务表格, "select")
        更新勾选信息()
        控件_设置文本(状态行, "状态：已批量删除 " + 到文本(勾选数) + " 行（首个：" + 首个键 + "），剩余 " + 到文本(表格_取行数(任务表格)) + " 行。")
    结束

    事件 _追加行按钮_被单击()
        表格_开始批量更新(任务表格)
        局部 整数型 i = 0
        计次循环首 (10, i)
            表格_添加行(任务表格, "row-" + 到文本(下一个行号), "0\t任务-" + 到文本(下一个行号) + "\t0\t等待中")
            下一个行号 = 下一个行号 + 1
        计次循环尾 ()
        表格_结束批量更新(任务表格)
        控件_设置文本(状态行, "状态：已追加 10 行，当前 " + 到文本(表格_取行数(任务表格)) + " 行。")
    结束

    事件 _任务表格_选择框被改变()
        更新勾选信息()
    结束

    // 工作线程：只模拟耗时并上报进度，说明文本用 "行键|行进度" 编码，绝不触碰表格。
    空 模拟行任务(整数型 行数, 整数型 每行毫秒)
        局部 整数型 i = 0
        局部 整数型 步 = 0
        局部 文本型 行键 = ""
        计次循环首 (行数, i)
            如果 (线程_是否请求取消(线程_取当前任务()))
                返回
            如果结束
            行键 = "row-" + 到文本(i)
            计次循环首 (5, 步)
                线程_报告进度(步 * 20, 行键 + "|" + 到文本(步 * 20))
                如果 (线程_协作等待(每行毫秒 / 5) == 假)
                    返回
                如果结束
            计次循环尾 ()
            线程_报告进度(100, 行键 + "|100")
        计次循环尾 ()
    结束

    // 进度处理器：线程模块封送回界面线程执行，这里写表格、写标签都安全。
    空 行进度回写(线程任务 任务, 整数型 百分比, 文本型 说明)
        局部 文本型 分段[]
        局部 整数型 段数 = 0
        局部 文本型 行键 = ""
        局部 小数型 行进度 = 0
        文本_分割(说明, "|", 分段, 真)
        段数 = 数组_取成员数(分段)
        如果 (段数 != 2)
            返回
        如果结束
        行键 = 数组_取成员(分段, 1)
        行进度 = 到整数(数组_取成员(分段, 2))
        表格_置进度(任务表格, 行键, "progress", 行进度)
        表格_置文本(任务表格, 行键, "status", "处理中")
        控件_设置文本(状态行, "状态：总体 " + 到文本(百分比) + "%，正在处理 " + 行键 + "（" + 到文本(行进度) + "%）。")
    结束

    // 完成处理器：同样在界面线程执行，整批刷新状态。
    空 全部完成(线程任务 任务)
        局部 整数型 i = 0
        局部 文本型 行键 = ""
        计次循环首 (表格_取行数(任务表格), i)
            行键 = 表格_取显示行键(任务表格, i - 1)
            表格_设置进度状态(任务表格, 行键, "progress", "success")
            表格_置文本(任务表格, 行键, "status", "已完成")
        计次循环尾 ()
        任务进行中 = 假
        控件_设置文本(状态行, "状态：全部完成！工作线程只计算与上报，所有表格写入都发生在界面线程。")
    结束

    空 更新勾选信息()
        控件_设置文本(勾选信息, "勾选：" + 到文本(表格_取勾选行数(任务表格, "select")) + " 行")
    结束
结束类
