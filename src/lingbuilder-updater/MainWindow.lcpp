包 灵码更新助手
使用 Win32窗口基础模块
使用 HTTP客户端模块
使用 Aria2下载模块
使用 JSON数据模块
使用 系统外壳模块
使用 文本处理模块
使用 路径处理模块
使用 文件目录模块
使用 内嵌资源模块

// 灵码更新助手：读取本机灵码 IDE 注册表版本，与官网 latest-version 接口比对；
// 有新版本时用 aria2 16 连接分段下载安装包，SHA-256 校验通过后拉起安装程序。
// 红线：带初始化的局部变量会被生成器提升到方法最前，因此一律「先声明（字面量初值）、后赋值」。
类 MainWindow
    HTTP客户端 版本客户端 = 0
    文本型 最新版本 = ""
    文本型 下载地址 = ""
    文本型 预期摘要 = ""
    文本型 安装包文件 = ""
    文本型 保存目录 = ""
    Aria2任务 下载任务 = 0
    逻辑型 下载中 = 假
    逻辑型 待安装 = 假
    逻辑型 引擎就绪 = 假

    事件 创建完毕()
        部署下载引擎()
        控件_设置数值(下载进度条, 0)
        控件_设置启用(下载按钮, 假)
        更新本机版本显示()
        开始检查更新()
    结束

    // 把内嵌在 exe 资源里的 aria2c.exe 释放并部署到程序目录，实现单 exe 分发。
    空 部署下载引擎()
        引擎就绪 = 假
        局部 文本型 释放路径 = ""
        释放路径 = 资源_释放到临时目录("aria2c.exe")
        如果 (释放路径 == "")
            调试输出(格式化文本("内嵌下载引擎释放失败：{}", 资源_取错误信息()))
            返回()
        如果结束
        局部 文本型 目标路径 = ""
        目标路径 = 路径_合并(系统_取运行目录(), "aria2c.exe")
        局部 逻辑型 已复制 = 假
        已复制 = 文件_复制(释放路径, 目标路径, 真)
        如果 (已复制 == 假)
            调试输出("下载引擎部署到程序目录失败（目录可能只读）。")
            返回()
        如果结束
        引擎就绪 = 真
    结束

    空 更新本机版本显示()
        局部 文本型 本机版本 = ""
        本机版本 = 更新工具.读安装版本()
        如果 (本机版本 == "")
            控件_设置文本(本机版本标签, "本机未检测到已安装的灵码 IDE，可直接下载最新完整安装包。")
        否则
            控件_设置文本(本机版本标签, 格式化文本("本机已安装版本：{}", 本机版本))
        如果结束
    结束

    空 开始检查更新()
        控件_设置文本(状态标签, "正在连接官网查询最新版本……")
        控件_设置启用(下载按钮, 假)
        释放版本客户端()
        版本客户端 = HTTP客户端_创建客户端()
        如果 (版本客户端 == 0)
            控件_设置文本(状态标签, "网络组件初始化失败，请重启本工具重试。")
            返回()
        如果结束
        HTTP客户端_设置超时(版本客户端, 10000, 15000, 30000, 30000)
        HTTP客户端_GET异步(版本客户端, "https://api.lingbuilder.com/v1/site/latest-version?platform=Windows&architecture=x64&channel=stable", &检查完成)
    结束

    空 检查完成()
        局部 HTTP客户端请求 请求
        请求 = HTTP客户端_取当前请求()
        如果 (请求 == 0)
            返回()
        如果结束
        局部 逻辑型 成功 = 假
        成功 = HTTP客户端_请求是否成功(请求)
        如果 (成功 == 假)
            控件_设置文本(状态标签, 格式化文本("检查更新失败：{}。可点击「打开官网」手动下载。", HTTP客户端_取请求错误(请求)))
            释放版本客户端()
            返回()
        如果结束
        局部 文本型 响应 = ""
        响应 = HTTP客户端_取响应文本编码(请求, "auto")
        释放版本客户端()
        局部 逻辑型 可用 = 假
        可用 = JSON_取逻辑(响应, "available", 假)
        局部 文本型 线上版本 = ""
        线上版本 = JSON_取文本(响应, "version")
        局部 文本型 地址 = ""
        地址 = JSON_取文本(响应, "downloadUrl")
        局部 文本型 摘要 = ""
        摘要 = JSON_取文本(响应, "sha256")
        局部 文本型 大小 = ""
        大小 = JSON_取文本(响应, "fileSize")
        如果 (可用 == 假 或 线上版本 == "" 或 地址 == "")
            控件_设置文本(状态标签, "官网暂时没有可用的版本信息，请稍后重试。")
            返回()
        如果结束
        最新版本 = 线上版本
        下载地址 = 地址
        预期摘要 = 摘要
        安装包文件 = 格式化文本("LingBuilder-{}-x64.exe", 线上版本)
        保存目录 = 系统_取临时目录() + "LingBuilderUpdate"
        控件_设置文本(最新版本标签, 格式化文本("官网最新版本：{}（安装包约 {}）", 线上版本, 大小))
        局部 文本型 本机版本 = ""
        本机版本 = 更新工具.读安装版本()
        如果 (本机版本 == "")
            控件_设置文本(状态标签, 格式化文本("未检测到已安装的灵码 IDE，可下载 {} 完整安装包。", 线上版本))
            控件_设置启用(下载按钮, 真)
            返回()
        如果结束
        局部 整数型 比较 = 0
        比较 = 更新工具.比较版本(线上版本, 本机版本)
        如果 (比较 > 0)
            控件_设置文本(状态标签, 格式化文本("发现新版本 {}（当前 {}），点击「下载最新版」开始升级。", 线上版本, 本机版本))
            控件_设置启用(下载按钮, 真)
        否则
            控件_设置文本(状态标签, 格式化文本("本机版本 {} 已是最新，无需更新。", 本机版本))
        如果结束
    结束

    空 释放版本客户端()
        如果 (版本客户端 != 0)
            HTTP客户端_销毁客户端(版本客户端)
            版本客户端 = 0
        如果结束
    结束

    事件 _下载按钮_被单击()
        如果 (待安装)
            启动安装()
            返回()
        如果结束
        如果 (下载地址 == "" 或 下载中)
            返回()
        如果结束
        如果 (引擎就绪 == 假)
            部署下载引擎()
        如果结束
        如果 (引擎就绪 == 假)
            信息框("下载引擎（aria2c.exe）未能部署到程序目录，请把本程序放到可写目录（如桌面或下载文件夹）后重试。", 48, "灵码更新助手")
            返回()
        如果结束
        下载中 = 真
        控件_设置启用(下载按钮, 假)
        控件_设置数值(下载进度条, 0)
        控件_设置文本(状态标签, 格式化文本("正在以 16 连接分段下载 {}（中断可断点续传）……", 安装包文件))
        下载任务 = Aria2_下载(下载地址, 保存目录, 安装包文件, 16, 8, &下载进度)
        如果 (下载任务 == 0)
            下载中 = 假
            控件_设置文本(状态标签, "下载任务创建失败：请确认 aria2c.exe 与本程序位于同一目录后重试。")
            控件_设置启用(下载按钮, 真)
        如果结束
    结束

    空 下载进度(Aria2任务 任务, 整数型 进度, 长整数型 已下载字节, 长整数型 总字节, 长整数型 速度字节每秒, 文本型 状态)
        如果 (任务 != 下载任务)
            返回()
        如果结束
        如果 (状态 == "已完成")
            下载中 = 假
            校验安装包()
            返回()
        如果结束
        如果 (状态 == "已失败" 或 状态 == "已停止")
            下载中 = 假
            控件_设置文本(状态标签, 格式化文本("下载中断：{}。可再次点击「下载最新版」断点续传。", Aria2_取错误(任务)))
            控件_设置启用(下载按钮, 真)
            返回()
        如果结束
        控件_设置数值(下载进度条, 进度)
        控件_设置文本(状态标签, 格式化文本("下载中：{}% · {} 字节/秒 · 已下载 {} / {} 字节", 进度, 速度字节每秒, 已下载字节, 总字节))
    结束

    空 校验安装包()
        局部 文本型 完整路径 = ""
        完整路径 = 路径_合并(保存目录, 安装包文件)
        局部 文本型 实际摘要 = ""
        实际摘要 = 文本_转小写(更新工具.文件SHA256(完整路径))
        如果 (预期摘要 == "")
            待安装 = 真
            控件_设置数值(下载进度条, 100)
            控件_设置文本(状态标签, "下载完成（官网未提供校验值）。点击「启动安装程序」立即安装。")
            控件_设置文本(下载按钮, "启动安装程序")
            控件_设置启用(下载按钮, 真)
            返回()
        如果结束
        如果 (实际摘要 == 预期摘要)
            待安装 = 真
            控件_设置数值(下载进度条, 100)
            控件_设置文本(状态标签, "SHA-256 校验通过！点击「启动安装程序」立即安装。")
            控件_设置文本(下载按钮, "启动安装程序")
            控件_设置启用(下载按钮, 真)
            返回()
        如果结束
        控件_设置文本(状态标签, "校验失败：安装包不完整或与官网不一致，请重新下载。")
        控件_设置启用(下载按钮, 真)
    结束

    空 启动安装()
        局部 文本型 完整路径 = ""
        完整路径 = 路径_合并(保存目录, 安装包文件)
        局部 逻辑型 已启动 = 假
        已启动 = 系统_打开(完整路径)
        如果 (已启动)
            控件_设置文本(状态标签, "安装程序已启动，本工具即将退出。")
            结束()
        否则
            信息框("安装程序启动失败，请到临时目录 LingBuilderUpdate 手动运行安装包。", 48, "灵码更新助手")
        如果结束
    结束

    事件 _官网按钮_被单击()
        系统_打开("https://lingbuilder.com/downloads")
    结束

    事件 _文档中心按钮_被单击()
        系统_打开("https://lingbuilder.com/docs/")
    结束

    事件 _视频教程按钮_被单击()
        系统_打开("https://lingbuilder.com/docs/guide/videos/")
    结束

    事件 _更新记录按钮_被单击()
        系统_打开("https://lingbuilder.com/updates")
    结束
结束类
