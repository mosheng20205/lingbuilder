类 MainWindow
    // 图色识别演示：选一张目标大图 + 一张小模板图，实时显示找图/找色耗时（毫秒）与命中坐标。
    // 识图命令同步执行，正常图片毫秒级返回；计时用 @ 行直调 Win32 GetTickCount64。
    文本型 目标图片路径 = ""
    文本型 模板图片路径 = ""

    事件 _MainWindow_创建完毕()
        控件_设置文本(结果区, "就绪：请先分别选择目标图片与模板图片，再点「找图 / 找全部 / 找色」。每次识别都会显示耗时（毫秒）与命中坐标。")
    结束

    事件 _选目标按钮_被单击()
        文件对话框_打开(文件对话框1)
    结束

    事件 _选模板按钮_被单击()
        文件对话框_打开(文件对话框2)
    结束

    事件 _文件对话框1_文件已选择()
        如果 (文件对话框_取文件数量(文件对话框1) > 0)
            目标图片路径 = 文件对话框_取文件(文件对话框1, 0)
            控件_设置文本(目标路径框, 目标图片路径)
            控件_设置图片(目标预览, 目标图片路径)
            追加结果("目标图片已选择：" + 目标图片路径)
        如果结束
    结束

    事件 _文件对话框1_已取消()
        追加结果("已取消选择目标图片。")
    结束

    事件 _文件对话框2_文件已选择()
        如果 (文件对话框_取文件数量(文件对话框2) > 0)
            模板图片路径 = 文件对话框_取文件(文件对话框2, 0)
            控件_设置文本(模板路径框, 模板图片路径)
            控件_设置图片(模板预览, 模板图片路径)
            追加结果("模板图片已选择：" + 模板图片路径)
        如果结束
    结束

    事件 _文件对话框2_已取消()
        追加结果("已取消选择模板图片。")
    结束

    事件 _找图按钮_被单击()
        局部 文本型 目标路径
        局部 文本型 模板路径
        局部 整数型 容差
        局部 长整数型 开始
        局部 长整数型 耗时
        局部 逻辑型 命中
        局部 整数型 命中横
        局部 整数型 命中纵
        局部 整数型 模板宽
        局部 整数型 模板高
        目标路径 = 目标图片路径
        模板路径 = 模板图片路径
        如果 (目标路径 = "")
            追加结果("找图：请先选择目标图片。")
            返回()
        如果结束
        如果 (模板路径 = "")
            追加结果("找图：请先选择模板图片。")
            返回()
        如果结束
        容差 = 读容差()
        @ 开始 = (long long)GetTickCount64();
        命中 = 识图_模板匹配(目标路径, 模板路径, 容差)
        @ 耗时 = (long long)GetTickCount64() - 开始;
        模板宽 = 图像_取宽度(模板路径)
        模板高 = 图像_取高度(模板路径)
        如果 (命中)
            命中横 = 识图_取结果横坐标()
            命中纵 = 识图_取结果纵坐标()
            追加结果("找图命中：耗时 " + 到文本(耗时) + " 毫秒，左上角 (" + 到文本(命中横) + ", " + 到文本(命中纵) + ")，模板中心 (" + 到文本(命中横 + 模板宽 / 2) + ", " + 到文本(命中纵 + 模板高 / 2) + ")——模拟点击请用中心坐标")
        否则
            追加结果("找图未命中：耗时 " + 到文本(耗时) + " 毫秒，容差 " + 到文本(容差))
        如果结束
    结束

    事件 _找全部按钮_被单击()
        局部 文本型 目标路径
        局部 文本型 模板路径
        局部 整数型 容差
        局部 长整数型 开始
        局部 长整数型 耗时
        局部 整数型 命中数量
        目标路径 = 目标图片路径
        模板路径 = 模板图片路径
        如果 (目标路径 = "")
            追加结果("找全部：请先选择目标图片。")
            返回()
        如果结束
        如果 (模板路径 = "")
            追加结果("找全部：请先选择模板图片。")
            返回()
        如果结束
        容差 = 读容差()
        @ 开始 = (long long)GetTickCount64();
        命中数量 = 识图_模板匹配全部(目标路径, 模板路径, 容差, 0, 0, 0, 0, 0, 32)
        @ 耗时 = (long long)GetTickCount64() - 开始;
        如果 (命中数量 > 0)
            追加结果("找全部：命中 " + 到文本(命中数量) + " 处，耗时 " + 到文本(耗时) + " 毫秒")
            列出全部命中(命中数量)
        否则
            追加结果("找全部：命中 0 处，耗时 " + 到文本(耗时) + " 毫秒")
        如果结束
    结束

    事件 _找色按钮_被单击()
        局部 文本型 目标路径
        局部 整数型 容差
        局部 整数型 红色分量
        局部 整数型 绿色分量
        局部 整数型 蓝色分量
        局部 长整数型 透明倍数
        局部 长整数型 颜色值
        局部 长整数型 开始
        局部 长整数型 耗时
        局部 逻辑型 命中
        目标路径 = 目标图片路径
        如果 (目标路径 = "")
            追加结果("找色：请先选择目标图片。")
            返回()
        如果结束
        红色分量 = 到整数(控件_取文本(红色框))
        绿色分量 = 到整数(控件_取文本(绿色框))
        蓝色分量 = 到整数(控件_取文本(蓝色框))
        透明倍数 = 16777216
        颜色值 = 透明倍数 * 255 + 红色分量 * 65536 + 绿色分量 * 256 + 蓝色分量
        容差 = 读容差()
        @ 开始 = (long long)GetTickCount64();
        命中 = 识图_查找颜色(目标路径, 颜色值, 容差)
        @ 耗时 = (long long)GetTickCount64() - 开始;
        如果 (命中)
            追加结果("找色命中：ARGB " + 到文本(颜色值) + "（R=" + 到文本(红色分量) + " G=" + 到文本(绿色分量) + " B=" + 到文本(蓝色分量) + "），耗时 " + 到文本(耗时) + " 毫秒，坐标 (" + 到文本(识图_取结果横坐标()) + ", " + 到文本(识图_取结果纵坐标()) + ")")
        否则
            追加结果("找色未命中：ARGB " + 到文本(颜色值) + "，耗时 " + 到文本(耗时) + " 毫秒")
        如果结束
    结束

    事件 _清空按钮_被单击()
        控件_设置文本(结果区, "")
    结束

    整数型 读容差()
        局部 整数型 数值
        数值 = 到整数(控件_取文本(容差框))
        如果 (数值 < 0)
            数值 = 0
        如果结束
        如果 (数值 > 255)
            数值 = 255
        如果结束
        返回(数值)
    结束

    空 列出全部命中(整数型 命中数量)
        局部 整数型 序号
        计次循环首 (命中数量, 序号)
            追加结果("    第 " + 到文本(序号) + " 处左上角 (" + 到文本(识图_取第N横坐标(序号)) + ", " + 到文本(识图_取第N纵坐标(序号)) + ")")
        计次循环尾
    结束

    空 追加结果(文本型 新行)
        局部 文本型 当前文本
        当前文本 = 控件_取文本(结果区)
        控件_设置文本(结果区, 当前文本 + 新行 + "\n")
    结束
结束类
