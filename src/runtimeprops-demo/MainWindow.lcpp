类 MainWindow
    事件 _MainWindow_创建完毕()
        // 运行期属性命令
        控件_设置只读(结果框, 真)
        控件_设置文本(结果框, "只读结果框：由代码写入")
        控件_设置密码输入(密码框, 真)
        控件_设置提示文字(搜索框, "输入关键字...")
        控件_设置数值范围(进度条1, 0, 1000)
        控件_设置数值(进度条1, 600)
        控件_设置不确定进度(进度条1, 真)
        控件_设置表项高度(列表框1, 32)
        // 列表项目操作
        局部 整数型 第二项 = 控件_插入项目(列表框1, 0, "甲")
        控件_插入项目(列表框1, -1, "丙")
        控件_设置选择项(列表框1, 1)
        控件_修改项目(列表框1, 1, "乙(选中态改写)")
        调试输出("项目数", 控件_取项目数量(列表框1))
        调试输出("第2项", 控件_取项目文本(列表框1, 1))
        调试输出("插入位置", 第二项)
        控件_删除项目(列表框1, 0)
        调试输出("删除后项目数", 控件_取项目数量(列表框1))
        // 复位：验证假值方向也编译通过
        控件_设置不确定进度(进度条1, 假)
        控件_设置密码输入(密码框, 假)
        控件_设置只读(结果框, 假)
    结束
结束类
