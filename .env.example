DATABASE_URL="postgresql://lingbuilder:lingbuilder-dev@127.0.0.1:54329/lingbuilder?schema=public"
REDIS_URL="redis://127.0.0.1:6389"
CLOUD_API_PORT="17900"
CLOUD_API_HOST="127.0.0.1"
CLOUD_API_ORIGIN="http://127.0.0.1:17900"
ADMIN_ORIGIN="http://127.0.0.1:17901"
JWT_PRIVATE_KEY="replace-with-an-ed25519-or-rsa-private-key"
JWT_PUBLIC_KEY="replace-with-the-matching-public-key"
TOKEN_HASH_SECRET="replace-with-at-least-32-random-bytes"
SECRET_VAULT_KEY="replace-with-32-byte-base64-key"
SMTP_HOST="127.0.0.1"
SMTP_PORT="10259"
SMTP_FROM="LingBuilder <noreply@lingbuilder.local>"
SIGNUP_GIFT_POINTS="10000"
LINGBUILDER_RULEBOOK_PATH="./LingBuilder AI 规则手册.md"

# 正式收费模块：生产环境必须使用稳定 Ed25519 密钥与持久化私有存储。
MODULE_PERMIT_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\\nreplace-with-ed25519-private-key\\n-----END PRIVATE KEY-----"
MODULE_PERMIT_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----\\nreplace-with-matching-ed25519-public-key\\n-----END PUBLIC KEY-----"
MODULE_ARTIFACT_STORAGE_DIR="./.lingbuilder/cloud-artifacts"

