类 MainWindow
    文本型 名字
    事件 _MainWindow_创建完毕()
        调试输出("窗口创建完毕")
    结束

    事件 _按钮1_被单击()
        // 信息框("新按钮", 64, "事件触发")
        // 调试输出("按钮1被单击")
        名字 = 控件_取文本(编辑框1)
        如果 (名字 = "")
            信息框("请输入你的名字", 64, "提示")
        否则
            // 控件_设置文本(标签1, "您好" + 名字 + "，欢迎来到lingbuilder！")
            控件_设置文本(标签1, 格式化文本("您好：【{}】，欢迎来到lingbuilder", 名字))

        如果结束
    结束
结束类
