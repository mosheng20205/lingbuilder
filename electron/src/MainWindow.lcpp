包 LingBuilder
使用 Win32窗口
使用 标准控件

类 MainWindow : 公开 窗体
公开:
    文本型 关联设计文件 = "MainWindow.xml"

    构造()
        调试输出("GameClient主窗口初始化完毕，Win32 渲染正常。")
    结束

    事件 _MainWindow_创建完毕()
        调试输出("已载入 MainWindow.xml 关联布局。😘❤😍")
        表格_添加行(数据表格1, "角色A", "角色A\t在线")
        表格_添加行(数据表格1, "角色B", "角色B\t离线")
        表格_添加行(数据表格1, "角色C", "角色C\t在线")
        表格_添加行(数据表格1, "角色D", "角色D\t在线")
        表格_添加行(数据表格1, "角色E", "角色E\t离线")
        调试输出("数据表格1 已载入示例数据")
    结束

    事件 _按钮1_被单击()
        调试输出("按钮1 被单击")
        信息框("按钮1 被单击", 64, "提示")
    结束

    事件 _按钮2_被单击()
        调试输出("按钮2 被单击")
        信息框("按钮2 被单击", 64, "提示")
    结束

    事件 _按钮3_被单击()
        调试输出("按钮3 被单击")
        信息框("按钮3 被单击", 64, "提示")
    结束

    事件 _列表框1_选择项被改变()
        调试输出("列表框1 选择项被改变")
    结束

    事件 _数据表格1_单元格被单击()
        调试输出("数据表格1 单元格被单击")
    结束

    事件 _分组框1_被单击()
        调试输出("分组框1 被单击")
    结束
结束类
