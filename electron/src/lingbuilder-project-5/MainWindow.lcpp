类 MainWindow
    事件 _MainWindow_创建完毕()
        调试输出("窗口创建完毕")
    结束

    事件 _按钮1_被单击()
        // 信息框("一键处理按钮", 64, "事件触发")
        局部 文本型 文本值 = 文本_删首尾空白(控件_取文本(编辑框1))
        调试输出("wbz", 文本值)
        控件_设置文本(标签2, 到文本(文本_取长度(文本值)))//1
        控件_设置文本(标签3, 文本_取左边(文本值, 5))//222//1313
        控件_设置文本(标签4, 文本_替换(文本值, "你", "您"))//333
    结束
结束类
