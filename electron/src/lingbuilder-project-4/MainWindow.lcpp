类 MainWindow
    文本型 账号
    文本型 密码
    事件 _MainWindow_创建完毕()
        调试输出("窗口创建完毕")
    结束

    事件 _登录按钮_被单击()
        // 信息框("登录", 64, "事件触发")
        // 调试输出("登录按钮被单击")
        账号 = 控件_取文本(账号编辑框)
        密码 = 控件_取文本(密码编辑框)
        调试输出(账号, 密码)
        如果 (账号 = "")
            信息框("账号不能为空", 64, "提示")
        否则
            如果 (密码 = "")
                信息框("密码不能为空", 64, "提示")
            否则
                // 账号密码都不为空，判断账号密码是否正确
                如果 (账号 = "lingbuilder")
                    如果 (密码 = "123456")
                        // 账号和密码都是输入对的
                        控件_设置文本(状态标签, "登录成功，欢迎回来 lingbuilder！")
                    否则
                        信息框("密码不对", 64, "提示")
                    如果结束
                否则
                    信息框("账号不对", 64, "提示")
                如果结束
            如果结束
        如果结束
    结束
结束类
