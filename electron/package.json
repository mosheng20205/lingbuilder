    "npmRebuild": false,
    "beforePack": "scripts/verify-cef3-before-pack.cjs",
    "afterPack": "scripts/verify-cef3-after-pack.cjs",
    "asarUnpack": [
      "node_modules/node-pty/**/*"
    ],
    "fileAssociations": [
      {
        "ext": "lbsln",
        "name": "LingBuilder 解决方案",
        "role": "Editor"
      },
      {
        "ext": "lingbuilder",
        "name": "LingBuilder 工作区",
        "role": "Editor"
      },
      {
        "ext": "lbworkspace",
        "name": "LingBuilder 工作区",
        "role": "Editor"
      },
      {
        "ext": "lcpp",
        "name": "LingBuilder 中文源文件",
        "role": "Editor"
      },
      {
        "ext": "lcpppkg",
        "name": "LingBuilder LCPP 源码包",
        "role": "Editor"
      },
      {
        "ext": "lbmod",
        "name": "LingBuilder 模块包",
        "role": "Editor"
      }
    ],
    "artifactName": "LingBuilder-${version}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraFiles": [
      {
        "from": "installer/lingbuilder.cmd",
        "to": "lingbuilder.cmd"
      }
    ],
    "extraResources": [
      {
        "from": "third_party/aria2/aria2c.exe",
        "to": "third_party/aria2/aria2c.exe"
      },
      {
        "from": "third_party/aria2/COPYING",
        "to": "third_party/aria2/COPYING"
      },
      {
        "from": "third_party/aria2/NOTICE.md",
        "to": "third_party/aria2/NOTICE.md"
      },
      {
        "from": "third_party/sqlite/x64/sqlite3.dll",
        "to": "third_party/sqlite/x64/sqlite3.dll"
      },
      {
        "from": "third_party/sqlite/x86/sqlite3.dll",
        "to": "third_party/sqlite/x86/sqlite3.dll"
      },
      {
        "from": "third_party/sqlite/NOTICE.md",
        "to": "third_party/sqlite/NOTICE.md"
      },
      {
        "from": "third_party/mariadb/x64/libmariadb.dll",
        "to": "third_party/mariadb/x64/libmariadb.dll"
      },
      {
        "from": "third_party/mariadb/x86/libmariadb.dll",
        "to": "third_party/mariadb/x86/libmariadb.dll"
      },
      {
        "from": "third_party/mariadb/NOTICE.md",
        "to": "third_party/mariadb/NOTICE.md"
      },
      {
        "from": "third_party/mariadb/COPYING.LIB",
        "to": "third_party/mariadb/COPYING.LIB"
      },
      {
        "from": "third_party/excel",
        "to": "third_party/excel"
      },
      {
        "from": "third_party/webview2",
        "to": "third_party/webview2",
        "filter": [
          "microsoft.web.webview2/**/*",
          "README.md"
        ]
      },
      {
        "from": "../examples/module-demos",
        "to": "module-demos",
        "filter": [
          "**/*",
          "!**/模块命令清单.json",
          "!**/README.md"
        ]
      },
      {
        "from": "../image/lingbuilder-ide-icon-v2.ico",
        "to": "assets/lingbuilder-window.ico"
      },
      {
        "from": "installer/update-user-path.ps1",
        "to": "installer/update-user-path.ps1"
      },
      {
        "from": "skill-kit",
        "to": "skill-kit",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../.lingbuilder/modules",
        "to": "default-workspace/.lingbuilder/modules",
        "filter": [
          "**/*",
          "!lingbuilder.cef3.sdk",
          "!lingbuilder.cef3.sdk/**/*",
          "!lingbuilder.fbro.sdk",
          "!lingbuilder.fbro.sdk/**/*",
          "!lingbuilder.cef3.sdk/sdk",
          "!lingbuilder.cef3.sdk/sdk/**/*",
          "!lingbuilder.fbro.sdk/sdk",
          "!lingbuilder.fbro.sdk/sdk/**/*"
        ]
      },
