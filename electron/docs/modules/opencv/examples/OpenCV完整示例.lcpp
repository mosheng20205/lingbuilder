包 OpenCV图像处理完整示例
使用 Win32窗口基础模块
使用 OpenCV图像处理模块

类 MainWindow : 公开 窗口
    事件 _MainWindow_创建完毕()
        调试输出(OpenCV_取版本())

        // 可以先用现有截图模块把自有或已授权画面保存为 PNG，再把路径交给 OpenCV。
        局部 长整数型 背景图 = OpenCV_加载图像("图像/背景截图.png", "彩色")
        局部 长整数型 滑块图 = OpenCV_加载图像("图像/滑块截图.png", "彩色")
        如果 (背景图 == 0)
            调试输出(OpenCV_取错误())
            返回
        如果结束

        局部 长整数型 灰度图 = OpenCV_灰度化(背景图)
        局部 长整数型 边缘图 = OpenCV_Canny边缘(灰度图, 50, 150)
        OpenCV_保存图像(边缘图, "输出/背景边缘.png", 95)

        // 单缺口：候选数量传 1。
        局部 长整数型 单缺口结果 = OpenCV_分析缺口(背景图, 滑块图, 1, "{}")
        如果 (单缺口结果 != 0 且 OpenCV结果_取数量(单缺口结果) > 0)
            调试输出(OpenCV结果_取横坐标(单缺口结果, 0))
            调试输出(OpenCV结果_取中心横坐标(单缺口结果, 0))
            调试输出(OpenCV结果_取置信度(单缺口结果, 0))
            OpenCV结果_保存标注图(单缺口结果, "输出/单缺口标注.png", 95)
        否则
            调试输出(OpenCV_取错误())
        如果结束

        // 双缺口：候选数量传 2；坐标仍相对原始背景图。
        局部 文本型 双缺口配置 = "{\"mode\":\"auto\",\"minWidth\":10,\"minHeight\":10,\"minScore\":0.45,\"minSeparation\":20,\"nmsIou\":0.3}"
        局部 长整数型 双缺口结果 = OpenCV_分析缺口(背景图, 滑块图, 2, 双缺口配置)
        如果 (双缺口结果 != 0)
            调试输出(OpenCV结果_取JSON(双缺口结果))
            OpenCV结果_保存标注图(双缺口结果, "输出/双缺口标注.png", 95)
        否则
            调试输出(OpenCV_取错误())
        如果结束

        OpenCV结果_释放(双缺口结果)
        OpenCV结果_释放(单缺口结果)
        OpenCV_释放图像(边缘图)
        OpenCV_释放图像(灰度图)
        OpenCV_释放图像(滑块图)
        OpenCV_释放图像(背景图)
    结束
结束类
