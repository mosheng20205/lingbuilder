// 二维码模块示例：识别本地图片中的二维码 → 取文本 → 释放
// 事件：按钮_识别二维码_被单击

局部 二维码识别结果 结果 = 二维码_识别PNG("二维码/lingbuilder.png")
如果 结果 != 0
    调试输出("识别到：" + 二维码_识别取文本(结果))
    调试输出("版本=" + 到文本(二维码_识别取版本(结果)) + " 掩码=" + 到文本(二维码_识别取掩码(结果)) + " 级别=" + 二维码_识别取纠错级别(结果) + " 模式=" + 二维码_识别取模式(结果))
    调试输出("修复码字数=" + 到文本(二维码_识别取修复码字数(结果)) + " 定位点数=" + 到文本(二维码_识别取定位点数(结果)))
    ' 外接四边形左上角（可在画板上画框标注）
    调试输出("左上角=(" + 到文本(二维码_识别取角点横坐标(结果, 0, 0)) + "," + 到文本(二维码_识别取角点纵坐标(结果, 0, 0)) + ")")
    二维码_识别释放(结果)
否则
    调试输出("识别失败：" + 二维码_识别取错误())
结束
