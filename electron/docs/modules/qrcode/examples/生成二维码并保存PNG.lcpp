// 二维码模块示例：生成 → 保存 PNG → 显示到图片框 → 释放
// 事件：按钮_生成二维码_被单击

局部 文本型 待编码内容 = "https://lingbuilder.com"
局部 二维码句柄 码 = 二维码_生成(待编码内容, "M", 8, 4)
如果 码 != 0
    ' 4278190080 = 0xFF000000 黑；4294967295 = 0xFFFFFFFF 白
    如果 二维码_保存PNG(码, "二维码/lingbuilder.png", 4278190080, 4294967295)
        ' 图片框显示刚保存的 PNG（图片框支持项目内相对路径）
        控件_设置图片(二维码图片框, "二维码/lingbuilder.png")
        调试输出("生成成功：版本=" + 到文本(二维码_取版本号(码)) + " 掩码=" + 到文本(二维码_取掩码(码)) + " 模块数=" + 到文本(二维码_取模块数(码)))
    否则
        调试输出("保存失败：" + 二维码_取错误())
    结束
    二维码_释放(码)
否则
    调试输出("生成失败：" + 二维码_取错误())
结束
