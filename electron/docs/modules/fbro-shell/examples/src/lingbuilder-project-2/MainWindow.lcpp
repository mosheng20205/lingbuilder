类 MainWindow
    事件 创建完毕()
        调试输出("窗口创建完毕")
    结束

    事件 _MainWindow_创建完毕()
        调试输出("MainWindow创建完毕")
    结束

    事件 _按钮1_被单击()
        // 信息框("新按钮", 64, "事件触发")
        局部 整数型 次数
        局部 整数型 计次变量
        调试输出("按钮1被单击")
        次数=100
        计次循环首 (次数, 计次变量)
            调试输出(次数,计次变量)
        计次循环尾 ()
    结束

    事件 _按钮2_被单击()
        // 信息框("新按钮", 64, "事件触发")
        调试输出("按钮2被单击")
        局部 文本型 局部变量 = "12234"
        如果 (局部变量 = "12234")
            调试输出("1")
        否则
            调试输出("2")
        如果结束
    结束
结束类