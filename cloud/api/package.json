{
  "name": "@lingbuilder/cloud-api",
  "private": true,
  "version": "0.6.1",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --env-file-if-exists=../../.env.local --import tsx --watch src/main.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=../../.env --env-file-if-exists=../../.env.local dist/main.js",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "prisma:generate": "node --env-file-if-exists=../../.env --env-file-if-exists=../../.env.local ../../node_modules/prisma/build/index.js generate",
    "prisma:migrate": "node --env-file-if-exists=../../.env --env-file-if-exists=../../.env.local ../../node_modules/prisma/build/index.js migrate dev",
    "admin:bootstrap": "node --env-file-if-exists=../../.env --env-file-if-exists=../../.env.local --import tsx src/scripts/bootstrap-admin.ts"
  },
  "dependencies": {
    "@lingbuilder/contracts": "0.6.1",
    "@nestjs/common": "^11.1.5",
    "@nestjs/core": "^11.1.5",
    "@nestjs/jwt": "^11.0.1",
    "@nestjs/platform-express": "^11.1.5",
    "@nestjs/swagger": "^11.2.0",
    "@prisma/client": "^6.12.0",
    "argon2": "^0.41.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "ioredis": "^5.6.1",
    "nodemailer": "^7.0.5",
    "otplib": "^12.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^6.4.17",
    "prisma": "^6.12.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
