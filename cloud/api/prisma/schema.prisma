generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DELETED
}

enum AdminRole {
  SUPER_ADMIN
  OPERATOR
  SUPPORT
  AUDITOR
}

enum LedgerKind {
  SIGNUP_GIFT
  ADMIN_ADJUSTMENT
  RECHARGE
  RESERVE
  RELEASE
  CHARGE
  REFUND
}

enum AiRequestStatus {
  RESERVED
  STREAMING
  COMPLETED
  FAILED
  CANCELLED
}

enum ProviderKind {
  OPENAI_COMPATIBLE
  ANTHROPIC
  GEMINI
}

enum PromotionKind {
  SIGNUP_GIFT
  FREE_WINDOW
}

enum ModuleOfferKind {
  PERPETUAL
  FIXED_TERM
}

enum ModuleOrderStatus {
  PENDING
  PAID
  EXPIRED
  CANCELLED
  REFUNDED
}

enum ModulePaymentProvider {
  WECHAT
  ALIPAY
  MANUAL
}

enum ModuleEntitlementSource {
  PURCHASE
  ADMIN_GRANT
  COMPENSATION
}

model User {
  id                 String                   @id @default(uuid())
  email              String                   @unique
  passwordHash       String
  status             UserStatus               @default(PENDING)
  emailVerifiedAt    DateTime?
  mustChangePassword Boolean                  @default(false)
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  sessions           AuthSession[]
  verificationTokens EmailVerificationToken[]
  resetTokens        PasswordResetToken[]
  creditAccount      CreditAccount?
  ledgerEntries      CreditLedger[]
  aiRequests         AiRequest[]
  promotionGrants    PromotionGrant[]
  freeUsages         FreeUsage[]
  adminMembership    AdminMembership?
  moduleOrders       ModuleOrder[]
  moduleEntitlements ModuleEntitlement[]
  moduleAccessAudits ModuleAccessAudit[]
  rechargeOrders     CreditRechargeOrder[]
  betaProgramMember  BetaProgramMember?
  betaProgramApplication BetaProgramApplication?
}

model ModuleProduct {
  id            String              @id @default(uuid())
  moduleId      String              @unique
  name          String
  description   String              @default("")
  listed        Boolean             @default(false)
  enabled       Boolean             @default(true)
  policyVersion Int                 @default(1)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  offers        ModuleOffer[]
  orders        ModuleOrder[]
  entitlements  ModuleEntitlement[]
  freeWindows   ModuleFreeWindow[]
  accessAudits  ModuleAccessAudit[]
  artifacts     ModuleArtifact[]
}

model ModuleArtifact {
  id                String        @id @default(uuid())
  productId         String
  version           String
  arch              String        @default("any")
  fileName          String
  storageKey        String        @unique
  sha256            String
  sizeBytes         BigInt
  signature         String
  keyId             String
  minimumIdeVersion String?
  enabled           Boolean       @default(true)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  product           ModuleProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, version, arch])
  @@index([productId, enabled, createdAt])
}

model ModuleOffer {
  id           String          @id @default(uuid())
  productId    String
  name         String
  kind         ModuleOfferKind
  priceMinor   BigInt
  currency     String          @default("CNY")
  durationDays Int?
  enabled      Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  product      ModuleProduct   @relation(fields: [productId], references: [id], onDelete: Cascade)
  orders       ModuleOrder[]

  @@index([productId, enabled])
}

model ModuleOrder {
  id                String                @id @default(uuid())
  userId            String
  productId         String
  offerId           String
  idempotencyKey    String
  provider          ModulePaymentProvider
  providerOrderId   String?
  status            ModuleOrderStatus     @default(PENDING)
  amountMinor       BigInt
  currency          String
  offerKind         ModuleOfferKind
  durationDays      Int?
  paymentUrl        String?
  paidAt            DateTime?
  expiresAt         DateTime
  refundedAt        DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  product           ModuleProduct         @relation(fields: [productId], references: [id], onDelete: Restrict)
  offer             ModuleOffer           @relation(fields: [offerId], references: [id], onDelete: Restrict)
  entitlement       ModuleEntitlement?

  @@unique([userId, idempotencyKey])
  @@unique([provider, providerOrderId])
  @@index([userId, createdAt])
}

model ModuleEntitlement {
  id          String                  @id @default(uuid())
  userId      String
  productId   String
  orderId     String?                 @unique
  source      ModuleEntitlementSource
  startsAt    DateTime                @default(now())
  endsAt      DateTime?
  revokedAt   DateTime?
  reason      String                  @default("")
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  user        User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product     ModuleProduct           @relation(fields: [productId], references: [id], onDelete: Cascade)
  order       ModuleOrder?            @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([userId, productId, startsAt, endsAt])
}

model ModuleFreeWindow {
  id          String        @id @default(uuid())
  productId   String
  name        String
  startsAt    DateTime
  endsAt      DateTime
  timezone    String        @default("Asia/Shanghai")
  enabled     Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  product     ModuleProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, enabled, startsAt, endsAt])
}

model PaymentWebhookEvent {
  id         String                @id @default(uuid())
  provider   ModulePaymentProvider
  eventId    String
  orderId    String?
  eventType  String
  payloadHash String
  processedAt DateTime             @default(now())

  @@unique([provider, eventId])
}

enum RechargeStatus {
  PENDING
  PAID
  EXPIRED
  CANCELLED
  REFUNDED
}

model CreditRechargeOrder {
  id              String                @id @default(uuid())
  userId          String
  idempotencyKey  String
  provider        ModulePaymentProvider
  providerOrderId String?
  status          RechargeStatus        @default(PENDING)
  amountMinor     BigInt
  currency        String                @default("CNY")
  points          BigInt
  packageName     String
  paymentUrl      String?
  paymentForm     String?
  paidAt          DateTime?
  expiresAt       DateTime
  refundedAt      DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
}

model ModuleAccessAudit {
  id        String        @id @default(uuid())
  userId    String
  productId String
  moduleId  String
  action    String
  allowed   Boolean
  source    String?
  reason    String?
  createdAt DateTime      @default(now())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   ModuleProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([userId, moduleId, createdAt])
}

model AuthSession {
  id               String    @id @default(uuid())
  userId           String
  familyId         String
  refreshTokenHash String    @unique
  deviceName       String
  ipAddress        String?
  userAgent        String?
  expiresAt        DateTime
  rotatedAt        DateTime?
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, familyId])
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DeviceCode {
  id              String    @id @default(uuid())
  deviceCodeHash  String    @unique
  userCode        String    @unique
  userId          String?
  deviceName      String
  expiresAt       DateTime
  intervalSeconds Int       @default(5)
  approvedAt      DateTime?
  consumedAt      DateTime?
  createdAt       DateTime  @default(now())

  @@index([userCode, expiresAt])
}

model AdminMembership {
  userId             String    @id
  role               AdminRole
  mfaSecretEncrypted String?
  mfaEnabledAt       DateTime?
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CreditAccount {
  userId          String   @id
  available       BigInt   @default(0)
  reserved        BigInt   @default(0)
  lifetimeGranted BigInt   @default(0)
  lifetimeSpent   BigInt   @default(0)
  version         Int      @default(0)
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CreditLedger {
  id             String     @id @default(uuid())
  userId         String
  kind           LedgerKind
  availableDelta BigInt
  reservedDelta  BigInt
  balanceAfter   BigInt
  requestId      String?
  promotionId    String?
  actorUserId    String?
  reason         String
  createdAt      DateTime   @default(now())
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([requestId, kind])
  @@index([userId, createdAt])
}

model AiRequest {
  id                 String          @id @default(uuid())
  userId             String
  idempotencyKey     String
  operation          String
  modelAlias         String
  routeVersion       Int
  status             AiRequestStatus @default(RESERVED)
  reservedPoints     BigInt
  listPricePoints    BigInt          @default(0)
  chargedPoints      BigInt          @default(0)
  inputTokens        Int             @default(0)
  cachedInputTokens  Int             @default(0)
  outputTokens       Int             @default(0)
  usageEstimated     Boolean         @default(false)
  providerCostMicros BigInt          @default(0)
  freePromotionId    String?
  errorCode          String?
  startedAt          DateTime        @default(now())
  finishedAt         DateTime?
  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, idempotencyKey])
  @@index([userId, startedAt])
}

model ProviderChannel {
  id               String       @id @default(uuid())
  name             String       @unique
  kind             ProviderKind
  baseUrl          String
  encryptedSecret  String
  enabled          Boolean      @default(true)
  timeoutMs        Int          @default(30000)
  maxConcurrency   Int          @default(20)
  failureCount     Int          @default(0)
  circuitOpenUntil DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  routes           ModelRoute[]
}

model LogicalModel {
  alias                       String       @id
  displayName                 String
  description                 String       @default("")
  contextWindow               Int
  maxOutputTokens             Int
  inputPointsPerMillion       BigInt
  cachedInputPointsPerMillion BigInt
  outputPointsPerMillion      BigInt
  peakInputPointsPerMillion       BigInt?
  peakCachedInputPointsPerMillion BigInt?
  peakOutputPointsPerMillion      BigInt?
  peakWindowsJson             Json?
  enabled                     Boolean      @default(true)
  etagVersion                 Int          @default(1)
  routes                      ModelRoute[]
}

model ModelRoute {
  id                         String          @id @default(uuid())
  alias                      String
  providerId                 String
  upstreamModel              String
  version                    Int
  priority                   Int             @default(100)
  weight                     Int             @default(100)
  enabled                    Boolean         @default(true)
  retryCount                 Int             @default(1)
  costInputMicrosPerMillion  BigInt          @default(0)
  costOutputMicrosPerMillion BigInt          @default(0)
  createdAt                  DateTime        @default(now())
  model                      LogicalModel    @relation(fields: [alias], references: [alias], onDelete: Cascade)
  provider                   ProviderChannel @relation(fields: [providerId], references: [id], onDelete: Restrict)

  @@unique([alias, version, providerId])
  @@index([alias, enabled, priority])
}

model PromotionPolicy {
  id                  String           @id @default(uuid())
  name                String
  kind                PromotionKind
  startsAt            DateTime
  endsAt              DateTime
  timezone            String           @default("Asia/Shanghai")
  giftPoints          BigInt?
  perUserListPriceCap BigInt?
  perUserRequestCap   Int?
  modelAliases        String[]
  enabled             Boolean          @default(true)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  grants              PromotionGrant[]
  freeUsages          FreeUsage[]
}

model PromotionGrant {
  id          String          @id @default(uuid())
  promotionId String
  userId      String
  points      BigInt
  createdAt   DateTime        @default(now())
  promotion   PromotionPolicy @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([promotionId, userId])
}

model FreeUsage {
  id              String          @id @default(uuid())
  promotionId     String
  userId          String
  usageDate       String
  requestCount    Int             @default(0)
  listPricePoints BigInt          @default(0)
  promotion       PromotionPolicy @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([promotionId, userId, usageDate])
}

model AdminAuditLog {
  id          String   @id @default(uuid())
  actorUserId String
  action      String
  targetType  String
  targetId    String?
  requestId   String
  ipAddress   String?
  details     Json?
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

model WebsiteDownloadRelease {
  id                  String                  @id @default(uuid())
  version             String
  channel             String                  @default("stable")
  platform            String                  @default("Windows")
  architecture        String                  @default("x64")
  title               String
  summary             String                  @default("")
  releaseNotes        String                  @default("")
  minimumRequirements String                  @default("")
  fileSize            String                  @default("")
  sha256              String                  @default("")
  publicationStatus   String                  @default("DRAFT")
  publishedAt         DateTime?
  sortOrder           Int                     @default(0)
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  mirrors             WebsiteDownloadMirror[]

  @@unique([version, channel, platform, architecture])
  @@index([publicationStatus, sortOrder, publishedAt])
}

model WebsiteDownloadMirror {
  id          String                 @id @default(uuid())
  releaseId   String
  provider    String
  label       String
  url         String
  accessCode  String                 @default("")
  enabled     Boolean                @default(true)
  sortOrder   Int                    @default(0)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  release     WebsiteDownloadRelease @relation(fields: [releaseId], references: [id], onDelete: Cascade)

  @@unique([releaseId, provider])
  @@index([releaseId, enabled, sortOrder])
}

model WebsiteCommandReference {
  id                String   @id @default(uuid())
  stableKey         String   @unique
  name              String
  aliases           String[] @default([])
  summary           String   @default("")
  kind              String   @default("COMMAND")
  category          String   @default("其他")
  moduleId          String?
  moduleName        String?
  signature         String
  returnType        String   @default("void")
  returnDescription String   @default("")
  parameters        Json
  examples          Json
  supportedBackends String[] @default([])
  minimumVersion    String   @default("")
  lifecycle         String   @default("AVAILABLE")
  source            String   @default("manual")
  sourceVersion     String   @default("")
  publicationStatus String   @default("DRAFT")
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([publicationStatus, kind, category])
  @@index([moduleId, lifecycle])
  @@index([name])
}

model WebsiteGuideArticle {
  id                String   @id @default(uuid())
  slug              String   @unique
  title             String
  summary           String   @default("")
  kind              String
  category          String   @default("")
  bodyMarkdown      String
  coverImageUrl     String   @default("")
  tags              String[] @default([])
  minimumVersion    String   @default("")
  publicationStatus String   @default("DRAFT")
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([kind, publicationStatus, sortOrder])
}

model WebsiteDemoProject {
  id                 String   @id @default(uuid())
  slug               String   @unique
  title              String
  summary            String
  category           String
  difficulty         String   @default("入门")
  lingBuilderVersion String   @default("")
  modules            String[] @default([])
  prerequisites      String   @default("")
  sourceLinks        Json
  screenshotUrl      String   @default("")
  videoUrl           String   @default("")
  license            String   @default("")
  publicationStatus  String   @default("DRAFT")
  sortOrder          Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([publicationStatus, category, sortOrder])
}

model WebsiteCommunityGroup {
  id          String   @id @default(uuid())
  name        String
  qqNumber    String   @unique
  groupType   String   @default("官方交流群")
  joinUrl     String   @default("")
  qrCodeUrl   String   @default("")
  description String   @default("")
  statusText  String   @default("开放加入")
  enabled     Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([enabled, sortOrder])
}

// 官网赞助列表：一条记录代表一笔赞助，公开展示赞助人 QQ 号与金额，按赞助时间先后排序。
model WebsiteSponsor {
  id          String   @id @default(uuid())
  qqNumber    String
  amountCents Int
  sponsoredAt DateTime
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([enabled, sponsoredAt])
}

// 官网「更新记录」页：按日期一条记录，itemsJson 为 [{category, text}] 的 JSON 数组文本。
// 内容由 sync-website-updates 脚本从仓库 更新记录/ 目录筛选改写后整量同步，不在管理后台维护。
model WebsiteUpdateEntry {
  id        String   @id @default(uuid())
  date      String   @unique
  itemsJson String   @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SdkCatalogRelease {
  id        String   @id @default(cuid())
  sequence  Int      @unique
  payload   String
  keyId     String
  signature String
  note      String?
  createdBy String
  createdAt DateTime @default(now())
}

// 灵码 Skill 清单：整条 payload 由生产 Ed25519 签名，sequence 单调递增防回滚。
// 正文（SKILL.md 等）不进开源仓，只由这里签名下发；IDE 联网取最新，取不到回退包内快照。
model SkillCatalogRelease {
  id        String   @id @default(cuid())
  sequence  Int      @unique
  payload   String
  keyId     String
  signature String
  note      String?
  createdBy String
  createdAt DateTime @default(now())
}

// 体验计划名单：一个账号一条记录，决定该账号登录的客户端能否收到 preview 渠道更新。
model BetaProgramMember {
  id             String    @id @default(uuid())
  userId         String    @unique
  status         String    @default("ACTIVE")
  groupTag       String    @default("")
  validUntil     DateTime?
  note           String    @default("")
  addedByAdminId String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
}

// 体验计划自助报名：通过审核后创建/激活 BetaProgramMember，拒绝理由留痕。
model BetaProgramApplication {
  id               String    @id @default(uuid())
  userId           String    @unique
  message          String    @default("")
  status           String    @default("PENDING")
  reviewedByAdminId String?
  reviewedAt       DateTime?
  rejectReason     String    @default("")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
}

// 全局开关键值表：体验计划暂停推送等运营开关，值统一存字符串。
model SystemFlag {
  key              String   @id
  value            String
  updatedByAdminId String?
  updatedAt        DateTime @updatedAt
}
