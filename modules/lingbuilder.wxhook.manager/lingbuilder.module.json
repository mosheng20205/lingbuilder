{
  "schemaVersion": 2,
  "id": "lingbuilder.wxhook.manager",
  "name": "微信 4.1.10.27 多开管理模块",
  "version": "1.0.1",
  "category": "系统",
  "description": "通过本机 WxHook Manager Host 启动微信 4.1.10.27，并实时展示多个登录实例的 wxid、昵称和头像。",
  "author": "LingBuilder",
  "license": "MIT",
  "minLingBuilderVersion": "0.2.9",
  "tags": ["微信", "多开", "登录信息", "WinHTTP", "Windows"],
  "contributes": {
    "commands": [
      {
        "name": "微信多开_绑定监控界面",
        "signature": "微信多开_绑定监控界面(实例列表, 状态栏, 日志列表)",
        "description": "绑定当前窗口控件并启动后台监控；列表会实时显示非 stopped 微信实例及头像。",
        "insertText": "微信多开_绑定监控界面($1, $2, $3)",
        "returnType": "逻辑型",
        "returnDescription": "成功启动监控返回真，控件无效或无法创建监控线程时返回假。"
      },
      {
        "name": "微信多开_启动微信",
        "signature": "微信多开_启动微信(微信路径)",
        "description": "通过受管 Host 启动一个微信 4.1.10.27 实例；空路径使用安装目录自动检测。",
        "insertText": "微信多开_启动微信(\"$1\")",
        "returnType": "逻辑型",
        "returnDescription": "Host 接受并确认新进程存活时返回真。"
      },
      {
        "name": "微信多开_立即刷新",
        "signature": "微信多开_立即刷新()",
        "description": "唤醒后台监控并立即读取最新实例与登录资料。",
        "insertText": "微信多开_立即刷新()",
        "returnType": "逻辑型",
        "returnDescription": "监控已绑定时返回真。"
      },
      {
        "name": "微信多开_停止监控",
        "signature": "微信多开_停止监控()",
        "description": "停止后台轮询并释放列表图像资源；窗口销毁时也会自动清理。",
        "insertText": "微信多开_停止监控()",
        "returnType": "空"
      },
      {
        "name": "微信多开_取实例数量",
        "signature": "微信多开_取实例数量()",
        "description": "返回最近一次刷新得到的非 stopped 微信实例数量。",
        "insertText": "微信多开_取实例数量()",
        "returnType": "整数型",
        "returnDescription": "返回零或正整数。"
      },
      {
        "name": "微信多开_取登录数量",
        "signature": "微信多开_取登录数量()",
        "description": "返回最近一次刷新中已确认登录的实例数量。",
        "insertText": "微信多开_取登录数量()",
        "returnType": "整数型",
        "returnDescription": "返回零或正整数。"
      },
      {
        "name": "微信多开_取错误",
        "signature": "微信多开_取错误()",
        "description": "返回最近一次服务启动、HTTP 请求或资料解析错误。",
        "insertText": "微信多开_取错误()",
        "returnType": "文本型",
        "returnDescription": "没有错误时返回空文本。"
      }
    ],
    "docs": [
      { "title": "微信 4.1.10.27 多开管理模块说明", "path": "docs/README.md" }
    ],
    "examples": [
      { "title": "窗口监控示例", "path": "examples/窗口监控.lcpp" }
    ]
  },
  "targets": [
    {
      "id": "windows-msvc-win32",
      "platform": "windows",
      "arch": "win32",
      "toolchain": "msvc",
      "includeDirs": ["include", "third_party"],
      "headers": ["include/wxhook_manager_bridge.h", "third_party/nlohmann/json.hpp"],
      "sources": ["src/wxhook_manager_bridge.cpp"],
      "runtimeFiles": [
        "runtime/appsettings.json",
        "runtime/e_sqlite3.dll",
        "runtime/Microsoft.Data.Sqlite.dll",
        "runtime/release-manifest.json",
        "runtime/SQLitePCLRaw.batteries_v2.dll",
        "runtime/SQLitePCLRaw.core.dll",
        "runtime/SQLitePCLRaw.provider.e_sqlite3.dll",
        "runtime/WxHook.Agent.dll",
        "runtime/WxHook.Contracts.dll",
        "runtime/WxHook.Manager.Host.deps.json",
        "runtime/WxHook.Manager.Host.dll",
        "runtime/WxHook.Manager.Host.exe",
        "runtime/WxHook.Manager.Host.runtimeconfig.json",
        "runtime/WxHook.Manager.Host.staticwebassets.endpoints.json"
      ],
      "defines": ["LINGBUILDER_WXHOOK_MANAGER_MODULE"],
      "compileOptions": ["/std:c++17", "/utf-8"]
    },
    {
      "id": "windows-msvc-x64",
      "platform": "windows",
      "arch": "x64",
      "toolchain": "msvc",
      "includeDirs": ["include", "third_party"],
      "headers": ["include/wxhook_manager_bridge.h", "third_party/nlohmann/json.hpp"],
      "sources": ["src/wxhook_manager_bridge.cpp"],
      "runtimeFiles": [
        "runtime/appsettings.json",
        "runtime/e_sqlite3.dll",
        "runtime/Microsoft.Data.Sqlite.dll",
        "runtime/release-manifest.json",
        "runtime/SQLitePCLRaw.batteries_v2.dll",
        "runtime/SQLitePCLRaw.core.dll",
        "runtime/SQLitePCLRaw.provider.e_sqlite3.dll",
        "runtime/WxHook.Agent.dll",
        "runtime/WxHook.Contracts.dll",
        "runtime/WxHook.Manager.Host.deps.json",
        "runtime/WxHook.Manager.Host.dll",
        "runtime/WxHook.Manager.Host.exe",
        "runtime/WxHook.Manager.Host.runtimeconfig.json",
        "runtime/WxHook.Manager.Host.staticwebassets.endpoints.json"
      ],
      "defines": ["LINGBUILDER_WXHOOK_MANAGER_MODULE"],
      "compileOptions": ["/std:c++17", "/utf-8"]
    }
  ],
  "bindings": {
    "commands": [
      {
        "command": "微信多开_绑定监控界面",
        "runtimeName": "LB_WxMore_BindMonitor",
        "parameters": [
          {
            "name": "实例列表",
            "type": "controlRef",
            "description": "显示头像、PID、状态、wxid、昵称和头像地址的列表视图。",
            "controlTypes": ["ListView"],
            "controlKinds": ["visual"],
            "scope": "currentWindow",
            "runtimeRepresentation": "nativeHandle"
          },
          {
            "name": "状态栏",
            "type": "controlRef",
            "description": "显示 Host 连接状态和实例计数的文本控件。",
            "controlTypes": ["Label"],
            "controlKinds": ["visual"],
            "scope": "currentWindow",
            "runtimeRepresentation": "nativeHandle"
          },
          {
            "name": "日志列表",
            "type": "controlRef",
            "description": "追加启动、连接、刷新及错误记录的列表框。",
            "controlTypes": ["ListBox"],
            "controlKinds": ["visual"],
            "scope": "currentWindow",
            "runtimeRepresentation": "nativeHandle"
          }
        ],
        "returnType": "bool"
      },
      {
        "command": "微信多开_启动微信",
        "runtimeName": "LB_WxMore_StartWeixin",
        "parameters": [
          { "name": "微信路径", "type": "wideString", "description": "Weixin.exe 完整路径；空文本时由 Host 自动查找。" }
        ],
        "returnType": "bool",
        "encoding": "wide"
      },
      {
        "command": "微信多开_立即刷新",
        "runtimeName": "LB_WxMore_RefreshNow",
        "parameters": [],
        "returnType": "bool"
      },
      {
        "command": "微信多开_停止监控",
        "runtimeName": "LB_WxMore_StopMonitor",
        "parameters": [],
        "returnType": "void"
      },
      {
        "command": "微信多开_取实例数量",
        "runtimeName": "LB_WxMore_InstanceCount",
        "parameters": [],
        "returnType": "int"
      },
      {
        "command": "微信多开_取登录数量",
        "runtimeName": "LB_WxMore_LoggedInCount",
        "parameters": [],
        "returnType": "int"
      },
      {
        "command": "微信多开_取错误",
        "runtimeName": "LB_WxMore_LastError",
        "parameters": [],
        "returnType": "wideString",
        "encoding": "wide"
      }
    ]
  }
}
