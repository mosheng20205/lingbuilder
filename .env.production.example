NODE_ENV=production
POSTGRES_PASSWORD=GENERATE_A_LONG_RANDOM_PASSWORD
CLOUD_API_HOST=0.0.0.0
CLOUD_API_PORT=17900
CLOUD_API_ORIGIN=https://api.lingbuilder.com
ADMIN_ORIGIN=https://lingbuilder.com
CORS_ORIGINS=https://lingbuilder.com,https://www.lingbuilder.com
DATABASE_URL=postgresql://lingbuilder:CHANGE_ME@postgres:5432/lingbuilder?schema=public
REDIS_URL=redis://redis:6379
JWT_PRIVATE_KEY=GENERATE_A_LONG_RANDOM_SECRET
JWT_PUBLIC_KEY=GENERATE_MATCHING_PUBLIC_KEY
TOKEN_HASH_SECRET=GENERATE_AT_LEAST_32_RANDOM_BYTES
SECRET_VAULT_KEY=GENERATE_32_BYTE_BASE64_KEY
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=noreply@example.com
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM=LingBuilder <noreply@example.com>
SIGNUP_GIFT_POINTS=10000
LINGBUILDER_RULEBOOK_PATH=/app/LingBuilder AI 规则手册.md
MODULE_PERMIT_PRIVATE_KEY_PEM=CHANGE_ME
MODULE_PERMIT_PUBLIC_KEY_PEM=CHANGE_ME
MODULE_ARTIFACT_STORAGE_DIR=/var/lib/lingbuilder/artifacts
# 未开通微信/支付宝商户前设为 false；付费下单将明确不可用，不会伪造支付。
PAYMENTS_ENABLED=true
